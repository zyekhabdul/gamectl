# --- [MODULE] src/core/10_utils.sh ---
# Resolve GBE template file based on platform and architecture
get_gbe_template() {
    local platform="${1:-linux}" # "linux" or "windows"
    local arch="${2:-x64}"       # "x64" or "x86"
    local p=""
    if [ "$platform" = "windows" ]; then
        if [ "$arch" = "x64" ]; then
            for p in "${GAMECTL_GBE_WIN_X64:-}" \
                     "$HOME/.local/share/gbe-fork/windows/release/regular/x64/steam_api64.dll" \
                     "$HOME/.local/share/gbe-fork/windows/regular/x64/steam_api64.dll" \
                     "$HOME/.local/share/gbe-fork/regular/x64/steam_api64.dll" \
                     "$HOME/.local/share/gbe-fork/windows/release/experimental/x64/steam_api64.dll"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        else
            for p in "${GAMECTL_GBE_WIN_X86:-}" \
                     "$HOME/.local/share/gbe-fork/windows/release/regular/x86/steam_api.dll" \
                     "$HOME/.local/share/gbe-fork/windows/regular/x86/steam_api.dll" \
                     "$HOME/.local/share/gbe-fork/regular/x86/steam_api.dll" \
                     "$HOME/.local/share/gbe-fork/windows/release/experimental/x86/steam_api.dll"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        fi
    else
        if [ "$arch" = "x64" ]; then
            for p in "${GAMECTL_GBE_X64:-}" \
                     "$HOME/.local/share/gbe-fork/regular/x64/libsteam_api.so" \
                     "$HOME/.local/share/gbe-fork/experimental/x64/libsteam_api.so"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        else
            for p in "${GAMECTL_GBE_X86:-}" \
                     "$HOME/.local/share/gbe-fork/regular/x86/libsteam_api.so" \
                     "$HOME/.local/share/gbe-fork/experimental/x86/libsteam_api.so"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        fi
    fi
    return 1
}

# Auto-download and provision Goldberg Emulator (GBE Fork) templates into destination
setup_gbe_templates() {
    local auto_yes=false
    local force=false
    local linux_only=false
    local win_only=false
    local dry_run=false
    local src_linux=""
    local src_win=""
    local dest_dir="${GAMECTL_GBE_DIR:-$HOME/.local/share/gbe-fork}"

    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes) auto_yes=true ;;
            -f|--force) force=true ;;
            --dry-run) dry_run=true ;;
            --linux-only) linux_only=true ;;
            --win-only) win_only=true ;;
            --source-linux) shift; src_linux="${1:-}" ;;
            --source-linux=*) src_linux="${1#--source-linux=}" ;;
            --source-win) shift; src_win="${1:-}" ;;
            --source-win=*) src_win="${1#--source-win=}" ;;
            --dest) shift; dest_dir="${1:-}" ;;
            --dest=*) dest_dir="${1#--dest=}" ;;
            -h|--help)
                cat <<EOF
Usage: gamectl setup-gbe [options]

Auto-download & provision Goldberg Emulator templates into ~/.local/share/gbe-fork/

Options:
  -y, --yes          Non-interactive mode, skip confirmations
  -f, --force        Overwrite existing templates
  --linux-only       Install only Linux templates (.so)
  --win-only         Install only Windows templates (.dll)
  --dry-run          Test execution without downloading or modifying filesystem
  --source-linux     Custom file or URL for Linux tarball (emu-linux-release.tar.bz2)
  --source-win       Custom file or URL for Windows 7z (emu-win-release-vs22.7z)
  --dest <dir>       Target GBE directory (default: ~/.local/share/gbe-fork)
EOF
                return 0
                ;;
            *)
                echo "[WARN] Unknown argument: $1" >&2
                ;;
        esac
        shift || true
    done

    echo "=========================================="
    echo " GOLDBERG EMULATOR PROVISIONING (GBE Fork)"
    echo " Target Dir : $dest_dir"
    echo " Mode       : $([ "$linux_only" = true ] && echo "Linux Only" || ([ "$win_only" = true ] && echo "Windows Only" || echo "Dual Platform (Linux + Windows)"))"
    echo "=========================================="

    if [ "$dry_run" = true ]; then
        echo "[DRY-RUN] Target destination verified: $dest_dir"
        return 0
    fi

    local has_lin_x64=false has_lin_x86=false has_win_x64=false has_win_x86=false
    [ -f "$dest_dir/regular/x64/libsteam_api.so" ] || [ -f "$dest_dir/experimental/x64/libsteam_api.so" ] && has_lin_x64=true
    [ -f "$dest_dir/regular/x86/libsteam_api.so" ] || [ -f "$dest_dir/experimental/x86/libsteam_api.so" ] && has_lin_x86=true
    [ -f "$dest_dir/windows/release/regular/x64/steam_api64.dll" ] || [ -f "$dest_dir/regular/x64/steam_api64.dll" ] || [ -f "$dest_dir/windows/regular/x64/steam_api64.dll" ] && has_win_x64=true
    [ -f "$dest_dir/windows/release/regular/x86/steam_api.dll" ] || [ -f "$dest_dir/regular/x86/steam_api.dll" ] || [ -f "$dest_dir/windows/regular/x86/steam_api.dll" ] && has_win_x86=true

    if [ "$force" = false ]; then
        if [ "$linux_only" = true ] && [ "$has_lin_x64" = true ] && [ "$has_lin_x86" = true ]; then
            echo "[PASS] Linux GBE Fork templates already provisioned in $dest_dir."
            return 0
        elif [ "$win_only" = true ] && [ "$has_win_x64" = true ] && [ "$has_win_x86" = true ]; then
            echo "[PASS] Windows GBE Fork templates already provisioned in $dest_dir."
            return 0
        elif [ "$linux_only" = false ] && [ "$win_only" = false ] && [ "$has_lin_x64" = true ] && [ "$has_lin_x86" = true ] && [ "$has_win_x64" = true ] && [ "$has_win_x86" = true ]; then
            echo "[PASS] All GBE Fork templates already provisioned in $dest_dir."
            return 0
        fi
    fi

    mkdir -p "$dest_dir"

    local tmp_work=""
    tmp_work=$(mktemp -d "${TMPDIR:-/tmp}/gamectl_gbe_setup_XXXXXX")
    trap 'rm -rf "${tmp_work:-}" 2>/dev/null || true' RETURN

    # 1. Linux Templates
    if [ "$win_only" = false ]; then
        echo "[INFO] Provisioning Linux GBE templates..."
        local lin_archive="$tmp_work/emu-linux.tar.bz2"
        local lin_url="${src_linux:-https://github.com/Detanup01/gbe_fork/releases/latest/download/emu-linux-release.tar.bz2}"

        if [ -f "$lin_url" ]; then
            cp -f "$lin_url" "$lin_archive"
        else
            echo "[INFO] Downloading Linux archive from: $lin_url"
            if ! curl -sL --connect-timeout 8 --max-time 60 "$lin_url" -o "$lin_archive"; then
                echo "[ERROR] Failed to download Linux GBE archive from $lin_url" >&2
                return 1
            fi
        fi

        if [ -f "$lin_archive" ] && [ -s "$lin_archive" ]; then
            mkdir -p "$tmp_work/linux_extract"
            if tar -xjf "$lin_archive" -C "$tmp_work/linux_extract" 2>/dev/null || tar -xf "$lin_archive" -C "$tmp_work/linux_extract" 2>/dev/null; then
                local src_root="$tmp_work/linux_extract"
                [ -d "$src_root/release" ] && src_root="$src_root/release"
                mkdir -p "$dest_dir/regular/x64" "$dest_dir/regular/x86" "$dest_dir/experimental/x64" "$dest_dir/experimental/x86"
                [ -f "$src_root/regular/x64/libsteam_api.so" ] && cp -f "$src_root/regular/x64/libsteam_api.so" "$dest_dir/regular/x64/"
                [ -f "$src_root/regular/x86/libsteam_api.so" ] && cp -f "$src_root/regular/x86/libsteam_api.so" "$dest_dir/regular/x86/"
                [ -f "$src_root/experimental/x64/libsteam_api.so" ] && cp -f "$src_root/experimental/x64/libsteam_api.so" "$dest_dir/experimental/x64/"
                [ -f "$src_root/experimental/x86/libsteam_api.so" ] && cp -f "$src_root/experimental/x86/libsteam_api.so" "$dest_dir/experimental/x86/"
                echo "[PASS] Linux GBE templates provisioned (x64 & x86)."
            else
                echo "[ERROR] Failed to extract Linux GBE archive." >&2
                return 1
            fi
        fi
    fi

    # 2. Windows Templates
    if [ "$linux_only" = false ]; then
        echo "[INFO] Provisioning Windows GBE templates..."
        local win_archive="$tmp_work/emu-win.7z"
        local win_url="${src_win:-https://github.com/Detanup01/gbe_fork/releases/latest/download/emu-win-release-vs22.7z}"

        local has_7z=false
        local cmd_7z=""
        for c in 7z 7za 7zr; do
            if command -v "$c" >/dev/null 2>&1; then
                has_7z=true
                cmd_7z="$c"
                break
            fi
        done

        if [ "$has_7z" = false ]; then
            echo "[WARN] 7z decompression utility not found. Install 7zip or p7zip-full to unpack Windows templates." >&2
            echo "       Skipping Windows template extraction. Linux templates remain functional." >&2
        else
            if [ -f "$win_url" ]; then
                cp -f "$win_url" "$win_archive"
            else
                echo "[INFO] Downloading Windows archive from: $win_url"
                if ! curl -sL --connect-timeout 8 --max-time 60 "$win_url" -o "$win_archive"; then
                    echo "[WARN] Failed to download Windows GBE archive from $win_url" >&2
                fi
            fi

            if [ -f "$win_archive" ] && [ -s "$win_archive" ]; then
                mkdir -p "$tmp_work/win_extract"
                if "$cmd_7z" x -y -o"$tmp_work/win_extract" "$win_archive" >/dev/null 2>&1; then
                    local w_root="$tmp_work/win_extract"
                    [ -d "$w_root/release" ] && w_root="$w_root/release"
                    mkdir -p "$dest_dir/windows/release/regular/x64" "$dest_dir/windows/release/regular/x86" \
                             "$dest_dir/regular/x64" "$dest_dir/regular/x86"
                    if [ -f "$w_root/regular/x64/steam_api64.dll" ]; then
                        cp -f "$w_root/regular/x64/steam_api64.dll" "$dest_dir/windows/release/regular/x64/"
                        cp -f "$w_root/regular/x64/steam_api64.dll" "$dest_dir/regular/x64/"
                    fi
                    if [ -f "$w_root/regular/x86/steam_api.dll" ]; then
                        cp -f "$w_root/regular/x86/steam_api.dll" "$dest_dir/windows/release/regular/x86/"
                        cp -f "$w_root/regular/x86/steam_api.dll" "$dest_dir/regular/x86/"
                    fi
                    echo "[PASS] Windows GBE templates provisioned (x64 & x86)."
                else
                    echo "[WARN] Failed to extract Windows GBE archive." >&2
                fi
            fi
        fi
    fi

    echo "[VERIFIED] GBE Fork template provisioning completed in $dest_dir."
    rm -rf "${tmp_work:-}" 2>/dev/null || true
    trap - RETURN
    return 0
}

# Resolve remote sync host (optional)
get_remote_host() {
    local host="${GAMECTL_REMOTE_HOST:-${GAMECTL_COMPANION_HOST:-${GAMECTL_SYNC_HOST:-${GAMECTL_TUF_HOST:-}}}}"
    if [ -z "$host" ] && [ -f "$HOME/.config/gamectl/remote_host" ]; then
        host=$(head -n 1 "$HOME/.config/gamectl/remote_host" | tr -d '[:space:]')
    fi
    echo "$host"
}

# Pre-flight cleanup of orphaned sockets, locks, and stale download staging directories
clean_stale_locks() {
    local run_dir
    run_dir="$(get_runtime_dir)"
    rm -f /tmp/steam_chrome_shmem_* /tmp/steam_chrome_overlay_* 2>/dev/null || true
    rm -f "$run_dir"/steam_chrome_* 2>/dev/null || true
    rm -f "$HOME/.config/SLSsteam/cache/.picsbuffer.lock" 2>/dev/null || true

    # Self-healing cleanup of orphaned standalone download staging directories
    local st_dir
    shopt -s nullglob
    for st_dir in "$run_dir"/depot_dl_*; do
        if [ -d "$st_dir" ]; then
            local st_pid="${st_dir##*_}"
            if ! [[ "$st_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$st_pid" 2>/dev/null; then
                rm -rf "$st_dir" 2>/dev/null || true
            fi
        fi
    done
    shopt -u nullglob
}

# Invalidate ephemeral library scanner cache
invalidate_scan_cache() {
    local cache_dir
    cache_dir="$(get_runtime_dir)"
    rm -f "$cache_dir/scancache.tab" "$cache_dir/scancache.tab.tmp" 2>/dev/null || true
}

# Flush pending keyboard input to prevent ghost keypress propagation across TUI views
flush_tty_input() {
    if [ -t 0 ] || [ -r /dev/tty ]; then
        while read -r -t 0.05 -n 10000 _ < /dev/tty 2>/dev/null || read -r -t 0.05 -n 10000 _ 2>/dev/null; do
            :
        done
    fi
    return 0
}

# Terminal Screen Lifecycle Management (Alternate Screen Buffer)
GAMECTL_IN_ALT_SCREEN=0

enter_tui_screen() {
    if [ -t 1 ] && [ "${TERM:-}" != "dumb" ] && [ "${GAMECTL_IN_ALT_SCREEN:-0}" -eq 0 ]; then
        tput smcup 2>/dev/null || printf '\033[?1049h'
        GAMECTL_IN_ALT_SCREEN=1
        trap 'trap - EXIT INT TERM; exit_tui_screen; exit' EXIT INT TERM
    fi
    return 0
}

exit_tui_screen() {
    if [ -t 1 ] && [ "${GAMECTL_IN_ALT_SCREEN:-0}" -eq 1 ]; then
        tput rmcup 2>/dev/null || printf '\033[?1049l'
        GAMECTL_IN_ALT_SCREEN=0
    fi
    return 0
}

# Clean FZF Modal Notification Dialog (Zero-Flicker)
tui_modal_notice() {
    local title="${1:-Notice}"
    local msg="${2:-}"
    local height="${3:-25%}"

    if [ ! -t 1 ] || ! command -v fzf >/dev/null 2>&1; then
        log_msg "INFO" "UI" "[$title] $msg"
        return 0
    fi

    printf "%b\n" "$msg" | fzf \
        --border-label="  ╢ $title ╟  " \
        --border-label-pos=2 \
        --header="NOTICE (Enter or Esc: Dismiss)" \
        --prompt="> " \
        --height="$height" \
        --reverse 2>/dev/null || true
    return 0
}

# Canonical user-isolated runtime directory (0700 permissions)
get_runtime_dir() {
    local run_uid="${UID:-$(id -u 2>/dev/null || echo 1000)}"
    local run_dir="${XDG_RUNTIME_DIR:-/tmp/gamectl-$run_uid}"
    mkdir -p -m 700 "$run_dir" 2>/dev/null || true
    echo "$run_dir"
}

# Canonical POSIX-compliant ANSI escape sequence stripper
strip_ansi() {
    printf "%s" "${1:-}" | sed -E $'s/\033\\[[0-9;]*[a-zA-Z]//g'
}

# Centralized Runtime Logger (user-isolated, rolling buffer max 1000 lines)
get_runtime_log_file() {
    local run_dir
    run_dir="$(get_runtime_dir)"
    echo "$run_dir/gamectl.log"
}

log_msg() {
    local level="${1:-INFO}"
    local comp="${2:-CORE}"
    shift 2 || true
    local msg="$*"

    local log_file
    log_file="$(get_runtime_log_file)"

    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date)
    printf "[%s] [%-5s] [%-10s] %s\n" "$ts" "${level^^}" "${comp^^}" "$msg" >> "$log_file" 2>/dev/null || true

    # Rolling buffer cap: keep last 1000 lines if log file exceeds ~120KB
    local sz=0
    sz=$(stat -c%s "$log_file" 2>/dev/null || echo 0)
    if [ "$sz" -gt 120000 ]; then
        local tmp_log="$log_file.tmp.$$"
        tail -n 1000 "$log_file" > "$tmp_log" 2>/dev/null && mv -f "$tmp_log" "$log_file" 2>/dev/null || rm -f "$tmp_log" 2>/dev/null || true
    fi
    return 0
}

log_info() { log_msg "INFO" "$@"; }
log_warn() { log_msg "WARN" "$@"; }
log_error() { log_msg "ERROR" "$@"; }

# Ephemeral cache tier for JSON APIs (Steam Store & ProtonDB) with TTL
fetch_cached_json() {
    local url="${1:-}"
    local cache_key="${2:-}"
    local ttl="${3:-3600}"

    if [ -z "$url" ] || [ -z "$cache_key" ]; then
        return 1
    fi

    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gamectl"
    mkdir -p "$cache_dir" 2>/dev/null || true

    local safe_key
    safe_key=$(echo "$cache_key" | tr -cd '[:alnum:]_-')
    local cache_file="$cache_dir/${safe_key}.json"

    local now
    now=$(date +%s)

    # 1. Check existing cache validity against TTL
    if [ -f "$cache_file" ]; then
        local mtime
        mtime=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0)
        local age=$(( now - mtime ))
        if [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ] && [ -s "$cache_file" ]; then
            cat "$cache_file"
            return 0
        fi
    fi

    # 2. Fetch fresh content with timeout and atomic replacement
    local tmp_file="${cache_file}.tmp.$$"
    local fetched
    fetched=$(curl -s --connect-timeout 2 --max-time 4 "$url" 2>/dev/null || true)

    if [ -n "$fetched" ] && [ "$fetched" != "null" ]; then
        # Ensure it contains valid JSON before caching
        if echo "$fetched" | jq . >/dev/null 2>&1; then
            echo "$fetched" > "$tmp_file" 2>/dev/null && mv -f "$tmp_file" "$cache_file" 2>/dev/null || rm -f "$tmp_file" 2>/dev/null
            echo "$fetched"
            return 0
        fi
    fi
    rm -f "$tmp_file" 2>/dev/null || true

    # 3. Fallback to stale cache if network/API failed
    if [ -s "$cache_file" ]; then
        cat "$cache_file"
        return 0
    fi

    return 1
}

# Auto-backup savegame (Rolling 3 snapshots)
backup_save() {
    local game_dir="$1"
    local is_quiet="${2:-false}"
    local save_dir="$game_dir/saves"
    if [ -d "$save_dir" ]; then
        local snap_dir="$game_dir/.save_snapshots"
        mkdir -p "$snap_dir"
        [ -d "$snap_dir/slot2" ] && rm -rf "$snap_dir/slot3" && mv "$snap_dir/slot2" "$snap_dir/slot3"
        [ -d "$snap_dir/slot1" ] && mv "$snap_dir/slot1" "$snap_dir/slot2"
        cp -a "$save_dir" "$snap_dir/slot1"
        echo "[INFO] Save snapshot created successfully in slot1 ($snap_dir/slot1)"
        log_msg "INFO" "SAVE" "Save snapshot created in slot1 for $(basename "$game_dir")"
    else
        if [ "$is_quiet" = true ]; then
            return 0
        fi
        echo "[WARN] Portable saves directory ($save_dir) not found." >&2
        log_msg "WARN" "SAVE" "Portable saves directory ($save_dir) not found"
        echo "       Game has not been injected with GBE Fork or lacks an isolated save directory." >&2
        echo "       Press <CTRL-I> first to enable portable saves." >&2
        return 1
    fi
}

# Restore savegame snapshot from recovery slot (slot1, slot2, or slot3)
restore_save() {
    local game_dir="$1"
    local slot="${2:-1}"
    local is_quiet="${3:-false}"

    if [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] Target game directory not found: ${game_dir:-<empty>}" >&2
        return 1
    fi

    local snap_dir="$game_dir/.save_snapshots"
    if [ ! -d "$snap_dir" ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] No savegame snapshots directory found in: $game_dir" >&2
        return 1
    fi

    # Normalize slot notation: "1", "slot1", "2", "slot2", etc.
    slot="${slot#slot}"
    case "$slot" in
        1|2|3) ;;
        *)
            [ "$is_quiet" = true ] || echo "[ERROR] Invalid recovery slot: use 1, 2, or 3." >&2
            return 1
            ;;
    esac
    local target_slot="$snap_dir/slot${slot}"

    if [ ! -d "$target_slot" ]; then
        if [ "$is_quiet" != true ]; then
            echo "[ERROR] Recovery snapshot slot $slot not found in: $snap_dir" >&2
            echo "        Available slots:" >&2
            for s in "$snap_dir"/slot*; do
                [ -d "$s" ] && echo "        - $(basename "$s")" >&2
            done
        fi
        return 1
    fi

    local save_dir="$game_dir/saves"
    # Safety stash: backup current saves if directory exists and is not empty
    if [ -d "$save_dir" ] && [ -n "$(find "$save_dir" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
        local stash_dir="$snap_dir/.pre_restore_stash"
        rm -rf "$stash_dir" 2>/dev/null || true
        mkdir -p "$stash_dir"
        cp -a "$save_dir/." "$stash_dir/" 2>/dev/null || true
    fi

    mkdir -p "$save_dir"
    rm -rf "${save_dir:?}"/* "${save_dir:?}"/.[!.]* 2>/dev/null || true
    cp -a "$target_slot/." "$save_dir/" 2>/dev/null || true

    [ "$is_quiet" = true ] || echo "[VERIFIED] Savegame restored successfully from slot${slot} ($target_slot -> $save_dir)"
    log_msg "INFO" "SAVE" "Savegame restored from slot${slot} for $(basename "$game_dir")"
    return 0
}

# Dynamic executable finder for game directory
find_game_binary() {
    local dir="$1"
    local base
    base=$(basename "$dir")
    local clean_base="${base// /}"
    local lower_base="${base,,}"
    local lower_clean="${clean_base,,}"

    # Priority 1: Common launch scripts or matching names
    local candidates=(
        "start.sh" "run.sh" "launch.sh" "start" "run"
        "$base" "$clean_base" "$lower_base" "$lower_clean"
    )
    for c in "${candidates[@]}"; do
        if [ -x "$dir/$c" ] && [ ! -d "$dir/$c" ]; then
            echo "$c"
            return 0
        fi
    done

    # Priority 2: Any root executable file excluding assets/libs/runtime dumps
    local f fname
    for f in "$dir"/*; do
        if [ -x "$f" ] && [ ! -d "$f" ]; then
            fname=$(basename "$f")
            case "$fname" in
                *.so|*.so.*|*.dll|*.dylib|installscript.vdf|*.png|*.bmp|*.txt|*.pkg|createdump|monoconfig|monomachineconfig)
                    continue
                    ;;
                *)
                    echo "$fname"
                    return 0
                    ;;
            esac
        fi
    done

    # Priority 3: Windows executables matching title/folder name
    local win_candidates=(
        "$base.exe" "$clean_base.exe" "$lower_base.exe" "$lower_clean.exe"
    )
    for c in "${win_candidates[@]}"; do
        if [ -f "$dir/$c" ] && [ ! -d "$dir/$c" ]; then
            chmod +x "$dir/$c" 2>/dev/null || true
            echo "$c"
            return 0
        fi
    done

    # Priority 4: Any root .exe excluding setup/redist/crash handlers
    for f in "$dir"/*.exe "$dir"/*.EXE; do
        [ -f "$f" ] || continue
        fname=$(basename "$f")
        case "$fname" in
            UnityCrashHandler*|*unins*|*setup*|*installer*|*redist*|DXSETUP*|vcredist*|dotnet*|vc_redist*|*CrashReport*)
                continue
                ;;
            *)
                chmod +x "$f" 2>/dev/null || true
                echo "$fname"
                return 0
                ;;
        esac
    done

    # Priority 5: Subdirectory .exe in standard game binary folders
    for sub in "bin" "bin/x64" "bin/Win64" "Binaries/Win64" "Binaries/Win32" "x64"; do
        if [ -d "$dir/$sub" ]; then
            for f in "$dir/$sub"/*.exe "$dir/$sub"/*.EXE; do
                [ -f "$f" ] || continue
                fname=$(basename "$f")
                case "$fname" in
                    UnityCrashHandler*|*unins*|*setup*|*installer*|*redist*|DXSETUP*|vcredist*|dotnet*|vc_redist*|*CrashReport*)
                        continue
                        ;;
                    *)
                        chmod +x "$f" 2>/dev/null || true
                        echo "$sub/$fname"
                        return 0
                        ;;
                esac
            done
        fi
    done

    return 1
}

# Resolve sovereign library path prioritizing explicit arg, env, config, and default $HOME/Games
resolve_standalone_library_dir() {
    local safe_title="${1:-}"
    local explicit_dir="${2:-}"

    local base_dir=""
    if [ -n "$explicit_dir" ]; then
        base_dir="$explicit_dir"
    elif [ -n "${GAMECTL_LIBRARY_DIR:-}" ]; then
        base_dir="$GAMECTL_LIBRARY_DIR"
    elif [ -f "$HOME/.config/gamectl/library_dir" ]; then
        local cfg_dir
        cfg_dir=$(head -n 1 "$HOME/.config/gamectl/library_dir" 2>/dev/null | tr -d '\r\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if [ -n "$cfg_dir" ]; then
            base_dir="${cfg_dir/#\~/$HOME}"
        fi
    fi

    if [ -z "$base_dir" ]; then
        base_dir="$HOME/Games"
    fi

    if [ -n "$safe_title" ]; then
        echo "$base_dir/$safe_title"
    else
        echo "$base_dir"
    fi
}

# Detect SteamStub DRM wrapper in Linux ELF (.bind section) or Windows PE
detect_steamstub_drm() {
    local bin_path="$1"
    [ -f "$bin_path" ] || return 1

    # Check 1: Linux ELF .bind section (readelf or strings)
    if command -v readelf >/dev/null 2>&1; then
        if readelf -S "$bin_path" 2>/dev/null | grep -Eq '(\.bind|[[:space:]]\.bind[[:space:]])'; then
            return 0
        fi
    fi

    # Check 2: Strings heuristic for SteamStub / SteamDRM markers
    if command -v strings >/dev/null 2>&1; then
        if strings -n 6 "$bin_path" 2>/dev/null | head -n 500 | grep -Eq '(SteamDRM|\.bind|SteamStub)'; then
            return 0
        fi
    fi

    return 1
}

# Distinguish SteamStub type (windows_pe, linux_elf, or unknown)
detect_steamstub_type() {
    local bin_path="$1"
    [ -f "$bin_path" ] || return 1
    if ! detect_steamstub_drm "$bin_path"; then
        return 1
    fi
    local btype
    btype=$(file -b "$bin_path" 2>/dev/null || echo "")
    if echo "$btype" | grep -qi -E "PE32|MS Windows"; then
        echo "windows_pe"
    elif case "$bin_path" in *.exe|*.EXE) true ;; *) false ;; esac; then
        echo "windows_pe"
    elif echo "$btype" | grep -qi "ELF"; then
        echo "linux_elf"
    else
        echo "unknown"
    fi
    return 0
}

# Resolve candidate unpacked binary for Windows PE SteamStub
resolve_unpacked_binary() {
    local gdir="$1"
    local gbin="$2"
    [ -d "$gdir" ] || return 1
    [ -n "$gbin" ] || return 1

    local base_no_ext="${gbin%.*}"
    local cand
    for cand in "${base_no_ext}.unpacked.exe" \
                "${base_no_ext}_unpacked.exe" \
                "${base_no_ext}-unpacked.exe" \
                "${gbin}.unpacked.exe" \
                "${gbin}.unpacked"; do
        if [ -f "$gdir/$cand" ]; then
            echo "$cand"
            return 0
        fi
    done
    return 1
}

# Find Steamless CLI executable on system
find_steamless_cli() {
    local cand
    for cand in "${GAMECTL_STEAMLESS_PATH:-}" \
                "$(command -v steamless 2>/dev/null || true)" \
                "$(command -v Steamless.CLI.exe 2>/dev/null || true)" \
                "$HOME/.local/share/steamless/Steamless.CLI.exe" \
                "$HOME/.local/share/steamless/Steamless.exe" \
                "$HOME/.config/gamectl/tools/Steamless.CLI.exe"; do
        if [ -n "$cand" ] && [ -f "$cand" ]; then
            echo "$cand"
            return 0
        fi
    done
    return 1
}

# Unpack Windows PE SteamStub binary via Steamless CLI
unpack_steamstub_pe() {
    local target_exe="$1"
    local runner_bin="${2:-}"
    local pfx_dir="${3:-}"
    [ -f "$target_exe" ] || return 1

    local gdir
    gdir="$(dirname "$target_exe")"
    local gbin
    gbin="$(basename "$target_exe")"

    # If already unpacked, nothing to do
    if resolve_unpacked_binary "$gdir" "$gbin" >/dev/null 2>&1; then
        return 0
    fi

    local steamless_bin
    steamless_bin=$(find_steamless_cli 2>/dev/null || true)
    if [ -z "$steamless_bin" ]; then
        return 1
    fi

    echo "  ${UI_CYAN}[INFO] Invoking Steamless CLI: $steamless_bin on $gbin...${UI_RST}"
    local unpack_rc=0
    if [ -x "$steamless_bin" ] && ! echo "$steamless_bin" | grep -qi '\.exe$'; then
        "$steamless_bin" "$target_exe" >/dev/null 2>&1 || unpack_rc=$?
    elif command -v mono >/dev/null 2>&1; then
        mono "$steamless_bin" "$target_exe" >/dev/null 2>&1 || unpack_rc=$?
    elif command -v dotnet >/dev/null 2>&1; then
        dotnet "$steamless_bin" "$target_exe" >/dev/null 2>&1 || unpack_rc=$?
    elif [ -n "$runner_bin" ] && [ -x "$runner_bin" ]; then
        WINEPREFIX="${pfx_dir:-$gdir/pfx}" "$runner_bin" "$steamless_bin" "$target_exe" >/dev/null 2>&1 || unpack_rc=$?
    elif command -v wine >/dev/null 2>&1; then
        WINEPREFIX="${pfx_dir:-$gdir/pfx}" wine "$steamless_bin" "$target_exe" >/dev/null 2>&1 || unpack_rc=$?
    else
        return 1
    fi

    # Check if unpacked binary was produced
    if resolve_unpacked_binary "$gdir" "$gbin" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

# Setup sovereign Steam interceptor scripts in target directory
setup_steam_interceptor() {
    local target_dir="${1:-$(get_runtime_dir)/interceptor}"
    mkdir -p -m 700 "$target_dir" 2>/dev/null || mkdir -p "$target_dir"
    cat << 'EOF_INTERCEPTOR' > "$target_dir/steam"
# Sovereign Steam Interceptor: traps and silences unshielded Steam Client calls
target_appid=""
for arg in "$@"; do
    case "$arg" in
        steam://run/*)
            target_appid="${arg##steam://run/}"
            target_appid="${target_appid%%/*}"
            ;;
    esac
done
if [ -n "$target_appid" ]; then
    echo "[gamectl interceptor] Blocked unsolicited Steam Client launch (steam://run/$target_appid)" >&2
else
    echo "[gamectl interceptor] Blocked unsolicited Steam Client launch ($*)" >&2
fi
exit 0
EOF_INTERCEPTOR
    chmod +x "$target_dir/steam" 2>/dev/null || true
    cp -f "$target_dir/steam" "$target_dir/steam.sh" 2>/dev/null || true
    return 0
}

# Forensic diagnostics report for SteamStub DRM inspection
diagnose_steamstub() {
    local bin_path="$1"
    if [ ! -f "$bin_path" ]; then
        echo "[ERROR] File not found: $bin_path" >&2
        return 1
    fi

    local b_name
    b_name="$(basename "$bin_path")"
    local b_dir
    b_dir="$(dirname "$bin_path")"
    local b_type
    b_type=$(file -b "$bin_path" 2>/dev/null || echo "Unknown")

    echo "╭─ STEAMSTUB FORENSIC DIAGNOSTICS ────────────────────────────╮"
    echo "│ Target Binary : $b_name"
    echo "│ Full Path     : $bin_path"
    echo "│ Architecture  : $b_type"

    local is_stub=false
    local stub_type="none"

    if detect_steamstub_drm "$bin_path"; then
        is_stub=true
        stub_type=$(detect_steamstub_type "$bin_path" 2>/dev/null || echo "unknown")
    fi

    if [ "$is_stub" = true ]; then
        if [ "$stub_type" = "windows_pe" ]; then
            echo "│ DRM Status    : ${UI_AMBER}[DETECTED] Windows PE SteamStub DRM${UI_RST}"
            local up_bin
            up_bin=$(resolve_unpacked_binary "$b_dir" "$b_name" 2>/dev/null || true)
            if [ -n "$up_bin" ]; then
                echo "│ Unpack Status : ${UI_GREEN}[READY] Unpacked counterpart found: $up_bin${UI_RST}"
                echo "│ Remediation   : launch_game will automatically execute $up_bin"
            else
                echo "│ Unpack Status : ${UI_AMBER}[PENDING] No unpacked binary found${UI_RST}"
                local s_cli
                s_cli=$(find_steamless_cli 2>/dev/null || true)
                if [ -n "$s_cli" ]; then
                    echo "│ Steamless CLI : ${UI_GREEN}[AVAILABLE] $s_cli${UI_RST}"
                    echo "│ Action        : Run 'gamectl unpack-stub \"$bin_path\"'"
                else
                    echo "│ Steamless CLI : ${UI_AMBER}[NOT FOUND] Place Steamless in ~/.local/share/steamless/${UI_RST}"
                    echo "│ Remediation   : Unpack $b_name with Steamless or provide ${b_name%.*}.unpacked.exe"
                fi
            fi
        elif [ "$stub_type" = "linux_elf" ]; then
            echo "│ DRM Status    : ${UI_AMBER}[DETECTED] Linux ELF SteamStub (.bind section)${UI_RST}"
            echo "│ Interceptor   : ${UI_GREEN}[ACTIVE] Sovereign steam.sh trap prevents Steam Client launch${UI_RST}"
            local cand_win
            cand_win=$(find "$b_dir" -maxdepth 2 -iname "*.exe" 2>/dev/null | head -n 1 || true)
            if [ -n "$cand_win" ]; then
                echo "│ Runner Option : Windows executable found ($(basename "$cand_win")). Can run via Proton with Steamless."
            else
                echo "│ Runner Option : Pure Linux native. Runs with sovereign interceptor trapping steam.sh calls."
            fi
        else
            echo "│ DRM Status    : ${UI_AMBER}[DETECTED] SteamStub / SteamDRM markers found${UI_RST}"
        fi
    else
        echo "│ DRM Status    : ${UI_GREEN}[CLEAN] No SteamStub DRM markers detected${UI_RST}"
    fi
    echo "╰─────────────────────────────────────────────────────────────╯"

    [ "$is_stub" = true ] && return 0 || return 1
}

# CLI subcommand handler for unpacking SteamStub Windows PE binaries
cli_unpack_stub() {
    local target="$1"
    if [ ! -f "$target" ]; then
        echo "[ERROR] Target file not found: $target" >&2
        return 1
    fi
    local up_res
    up_res=$(resolve_unpacked_binary "$(dirname "$target")" "$(basename "$target")" 2>/dev/null || true)
    if [ -n "$up_res" ]; then
        echo "[VERIFIED] Binary is already unpacked: $up_res"
        return 0
    fi
    echo "[INFO] Attempting to unpack $target via Steamless CLI..."
    if unpack_steamstub_pe "$target"; then
        up_res=$(resolve_unpacked_binary "$(dirname "$target")" "$(basename "$target")" 2>/dev/null || true)
        echo "[SUCCESS] Binary successfully unpacked: $up_res"
        return 0
    else
        echo "[ERROR] Failed to unpack binary. Ensure Steamless CLI is installed or run under Wine." >&2
        return 1
    fi
}

# --- [MODULE] src/steam/20_discovery.sh ---

# Discover active Steam root directory across standard, custom, Flatpak, and Snap installations
get_steam_root() {
    if [ -n "${STEAM_ROOT:-}" ] && [ -d "$STEAM_ROOT" ]; then
        echo "$STEAM_ROOT"
        return 0
    fi

    local candidate
    for candidate in \
        "$HOME/.local/share/Steam" \
        "$HOME/.steam/steam" \
        "$HOME/.steam/root" \
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam" \
        "$HOME/snap/steam/common/.local/share/Steam"; do
        if [ -d "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    return 1
}

# Discover active primary steamapps directory
get_steam_primary_apps() {
    local s_root
    s_root="$(get_steam_root 2>/dev/null || true)"
    if [ -n "$s_root" ] && [ -d "$s_root/steamapps" ]; then
        echo "$s_root/steamapps"
        return 0
    fi

    local first_lib
    first_lib="$(get_steam_libraries 2>/dev/null | head -n 1 || true)"
    if [ -n "$first_lib" ] && [ -d "$first_lib" ]; then
        echo "$first_lib"
        return 0
    fi

    echo "$HOME/.local/share/Steam/steamapps"
}

# Discover active SLSsteam configuration directory
get_sls_root() {
    local xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
    echo "$xdg/SLSsteam"
}

# Discover active SLSsteam manifests storage directory
get_sls_manifests_dir() {
    local sls_root
    sls_root="$(get_sls_root)"
    echo "$sls_root/manifests"
}

# Discover active Steam stplug-in Lua directory
get_steam_stplug_in_dir() {
    local s_root
    s_root="$(get_steam_root 2>/dev/null || echo "$HOME/.local/share/Steam")"
    echo "$s_root/config/stplug-in"
}

# Discover active Steam depotcache directory
get_steam_depotcache_dir() {
    local s_root
    s_root="$(get_steam_root 2>/dev/null || echo "$HOME/.local/share/Steam")"
    echo "$s_root/depotcache"
}

# Discover all configured Steam library paths with deduplication
get_steam_libraries() {
    declare -A seen_libs=()
    local candidate_roots=(
        "${STEAM_ROOT:-}"
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.steam/root"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
        "$HOME/snap/steam/common/.local/share/Steam"
    )

    for root in "${candidate_roots[@]}"; do
        [ -n "$root" ] && [ -d "$root" ] || continue

        local primary="$root/steamapps"
        if [ -d "$primary" ]; then
            local real_primary
            real_primary="$(realpath "$primary" 2>/dev/null || echo "$primary")"
            if [ -z "${seen_libs["$real_primary"]:-}" ]; then
                seen_libs["$real_primary"]=1
                echo "$primary"
            fi
        fi

        # Check libraryfolders.vdf
        local vdf_candidates=(
            "$root/steamapps/libraryfolders.vdf"
            "$root/config/libraryfolders.vdf"
        )
        for vdf in "${vdf_candidates[@]}"; do
            [ -f "$vdf" ] || continue
            local line p_path
            while read -r line; do
                p_path=$(echo "$line" | sed -E 's/.*"path"[[:space:]]+"([^"]+)".*/\1\/steamapps/')
                if [ -d "$p_path" ]; then
                    local real_p
                    real_p="$(realpath "$p_path" 2>/dev/null || echo "$p_path")"
                    if [ -z "${seen_libs["$real_p"]:-}" ]; then
                        seen_libs["$real_p"]=1
                        echo "$p_path"
                    fi
                fi
            done < <(grep -E '^\s*"path"' "$vdf" 2>/dev/null || true)
        done
    done
}

# Scan installed games dynamically in standard & custom paths
scan_installed_games() {
    local is_formatted=false
    local force_refresh=false

    for arg in "$@"; do
        case "$arg" in
            --formatted|-f) is_formatted=true ;;
            --refresh|--no-cache|-r) force_refresh=true ;;
        esac
    done

    local cache_dir
    cache_dir="$(get_runtime_dir)"
    local cache_file="$cache_dir/scancache.tab"

    # Fast-path: Check cache validity (TTL: 60s, invalidated if candidate library directories are newer)
    local use_cached=false
    if [ "$force_refresh" = false ] && [ -f "$cache_file" ]; then
        local now mtime
        now=$(date +%s)
        mtime=$(stat -c%Y "$cache_file" 2>/dev/null || echo 0)
        if [ $((now - mtime)) -lt 60 ]; then
            use_cached=true
            local lib_check
            for lib_check in "$HOME/Games" "$HOME/.local/share/Steam/steamapps" "$HOME/.local/share/lutris/games"; do
                if [ -d "$lib_check" ] && [ "$lib_check" -nt "$cache_file" ]; then
                    use_cached=false
                    break
                fi
            done
        fi
    fi

    if [ "$use_cached" = false ]; then
        : > "$cache_file.tmp"
        declare -A seen_dirs=()

        # 1. Scan Steam Libraries
        local steam_lib
        local re_appid='"appid"[[:space:]]+"([0-9]+)"'
        local re_name='"name"[[:space:]]+"([^"]+)"'
        local re_installdir='"installdir"[[:space:]]+"([^"]+)"'
        while read -r steam_lib; do
            [ -d "$steam_lib" ] || continue
            for acf in "$steam_lib"/appmanifest_*.acf; do
                [ -f "$acf" ] || continue

                # Single-pass regex parse of ACF manifest without subshell forks
                local appid="" name="" installdir=""
                while IFS= read -r acf_line; do
                    if [[ "$acf_line" =~ $re_appid ]]; then
                        appid="${BASH_REMATCH[1]}"
                    elif [[ "$acf_line" =~ $re_name ]]; then
                        name="${BASH_REMATCH[1]}"
                    elif [[ "$acf_line" =~ $re_installdir ]]; then
                        installdir="${BASH_REMATCH[1]}"
                    fi
                    [ -n "$appid" ] && [ -n "$name" ] && [ -n "$installdir" ] && break
                done < "$acf"

                # Filter out Proton, Steam Linux Runtimes, and tools
                [[ "$name" =~ ^(Steam Linux Runtime|Proton|Steamworks) ]] && continue
                [ -z "$installdir" ] && continue

                local gdir="$steam_lib/common/$installdir"
                [ -d "$gdir" ] || continue
                [[ -v seen_dirs["$gdir"] ]] && continue
                seen_dirs["$gdir"]=1

                local gbin
                gbin=$(find_game_binary "$gdir") || continue
                [ -z "$gbin" ] && continue

                local is_win_bin=false
                case "$gbin" in
                    *.exe|*.EXE) is_win_bin=true ;;
                esac

                local status="STANDALONE"
                local api_file=""
                if [ "$is_win_bin" = true ]; then
                    if [ -f "$gdir/steam_api64.dll" ]; then
                        api_file="$gdir/steam_api64.dll"
                    elif [ -f "$gdir/steam_api.dll" ]; then
                        api_file="$gdir/steam_api.dll"
                    elif [ -f "$gdir/libsteam_api.so" ]; then
                        api_file="$gdir/libsteam_api.so"
                    elif [ -f "$gdir/lib64/libsteam_api.so" ]; then
                        api_file="$gdir/lib64/libsteam_api.so"
                    else
                        api_file=$(find "$gdir" -maxdepth 3 \( -name "steam_api64.dll" -o -name "steam_api.dll" -o -name "libsteam_api.so" \) 2>/dev/null | head -n 1)
                    fi
                else
                    if [ -f "$gdir/libsteam_api.so" ]; then
                        api_file="$gdir/libsteam_api.so"
                    elif [ -f "$gdir/lib64/libsteam_api.so" ]; then
                        api_file="$gdir/lib64/libsteam_api.so"
                    elif [ -f "$gdir/steam_api64.dll" ]; then
                        api_file="$gdir/steam_api64.dll"
                    elif [ -f "$gdir/steam_api.dll" ]; then
                        api_file="$gdir/steam_api.dll"
                    else
                        api_file=$(find "$gdir" -maxdepth 3 \( -name "libsteam_api.so" -o -name "steam_api64.dll" -o -name "steam_api.dll" \) 2>/dev/null | head -n 1)
                    fi
                fi

                if [ -n "$api_file" ]; then
                    local sz
                    sz=$(stat -c%s "$api_file" 2>/dev/null || echo 0)
                    if [ "$sz" -gt 7000000 ]; then
                        status="GBE_FORK"
                    else
                        case "$api_file" in
                            *.dll) status="VALVE_DLL" ;;
                            *)     status="VALVE_SO" ;;
                        esac
                    fi
                fi

                [ -z "$appid" ] && appid="STANDALONE"
                printf "%s\t%s\t%s\t%s\t%s\n" "$appid" "$name" "$status" "$gdir" "$gbin" >> "$cache_file.tmp"
            done
        done < <(get_steam_libraries)

        # 2. Scan Custom & Standalone Directories
        local custom_search_dirs=(
            "$HOME/Games"
            "$HOME/.local/share/lutris/games"
        )

        # Allow extending library directories via ~/.config/gamectl/libraries or env
        if [ -f "$HOME/.config/gamectl/library_dir" ]; then
            local p_lib
            p_lib=$(head -n 1 "$HOME/.config/gamectl/library_dir" 2>/dev/null | tr -d '\r\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            [ -n "$p_lib" ] && custom_search_dirs+=("${p_lib/#\~/$HOME}")
        fi
        if [ -f "$HOME/.config/gamectl/libraries" ]; then
            while IFS= read -r line || [ -n "$line" ]; do
                line="${line#"${line%%[![:space:]]*}"}" # trim leading
                line="${line%"${line##*[![:space:]]}"}" # trim trailing
                [ -z "$line" ] && continue
                [[ "$line" =~ ^# ]] && continue
                custom_search_dirs+=("${line/#\~/$HOME}")
            done < "$HOME/.config/gamectl/libraries"
        fi

        if [ -n "${GAMECTL_LIBRARY_DIR:-}" ]; then
            custom_search_dirs+=("${GAMECTL_LIBRARY_DIR/#\~/$HOME}")
        fi
        if [ -n "${GAMECTL_LIBRARY_DIRS:-}" ]; then
            IFS=":" read -r -a extra_dirs <<< "$GAMECTL_LIBRARY_DIRS"
            custom_search_dirs+=("${extra_dirs[@]}")
        fi

        for base_dir in "${custom_search_dirs[@]}"; do
            [ -d "$base_dir" ] || continue
            for gdir in "$base_dir"/*; do
                [ -d "$gdir" ] || continue
                [[ -v seen_dirs["$gdir"] ]] && continue
                seen_dirs["$gdir"]=1

                local folder_name="${gdir##*/}"
                [[ "$folder_name" =~ ^\. ]] && continue

                local gbin
                gbin=$(find_game_binary "$gdir") || continue
                [ -z "$gbin" ] && continue

                local appid="STANDALONE"
                if [ -f "$gdir/steam_appid.txt" ]; then
                    local raw_id=""
                    read -r raw_id < "$gdir/steam_appid.txt" 2>/dev/null || true
                    appid="${raw_id//[!0-9]/}"
                    [ -z "$appid" ] && appid="STANDALONE"
                elif [ -f "$gdir/.gamectl_appid" ]; then
                    local raw_id=""
                    read -r raw_id < "$gdir/.gamectl_appid" 2>/dev/null || true
                    appid="${raw_id//[!0-9]/}"
                    [ -z "$appid" ] && appid="STANDALONE"
                fi

                local title="$folder_name"
                if [ -f "$gdir/.gamectl_title" ]; then
                    read -r title < "$gdir/.gamectl_title" 2>/dev/null || title="$folder_name"
                fi

                local is_win_bin=false
                case "$gbin" in
                    *.exe|*.EXE) is_win_bin=true ;;
                esac

                local status="STANDALONE"
                local api_file=""
                if [ "$is_win_bin" = true ]; then
                    if [ -f "$gdir/steam_api64.dll" ]; then
                        api_file="$gdir/steam_api64.dll"
                    elif [ -f "$gdir/steam_api.dll" ]; then
                        api_file="$gdir/steam_api.dll"
                    elif [ -f "$gdir/libsteam_api.so" ]; then
                        api_file="$gdir/libsteam_api.so"
                    elif [ -f "$gdir/lib64/libsteam_api.so" ]; then
                        api_file="$gdir/lib64/libsteam_api.so"
                    else
                        api_file=$(find "$gdir" -maxdepth 3 \( -name "steam_api64.dll" -o -name "steam_api.dll" -o -name "libsteam_api.so" \) 2>/dev/null | head -n 1)
                    fi
                else
                    if [ -f "$gdir/libsteam_api.so" ]; then
                        api_file="$gdir/libsteam_api.so"
                    elif [ -f "$gdir/lib64/libsteam_api.so" ]; then
                        api_file="$gdir/lib64/libsteam_api.so"
                    elif [ -f "$gdir/steam_api64.dll" ]; then
                        api_file="$gdir/steam_api64.dll"
                    elif [ -f "$gdir/steam_api.dll" ]; then
                        api_file="$gdir/steam_api.dll"
                    else
                        api_file=$(find "$gdir" -maxdepth 3 \( -name "libsteam_api.so" -o -name "steam_api64.dll" -o -name "steam_api.dll" \) 2>/dev/null | head -n 1)
                    fi
                fi

                if [ -n "$api_file" ]; then
                    local sz
                    sz=$(stat -c%s "$api_file" 2>/dev/null || echo 0)
                    if [ "$sz" -gt 7000000 ]; then
                        status="GBE_FORK"
                    else
                        case "$api_file" in
                            *.dll) status="VALVE_DLL" ;;
                            *)     status="VALVE_SO" ;;
                        esac
                    fi
                fi

                printf "%s\t%s\t%s\t%s\t%s\n" "$appid" "$title" "$status" "$gdir" "$gbin" >> "$cache_file.tmp"
            done
        done
        mv -f "$cache_file.tmp" "$cache_file"
    fi

    # Render formatted or raw tab entries
    if [ "$is_formatted" = true ]; then
        while IFS=$'\t' read -r c_appid c_title c_status c_gdir c_gbin; do
            [ -z "$c_gdir" ] && continue
            local c_badge=""
            case "$c_status" in
                *GBE_FORK*)   c_badge="${UI_GREEN}[GBE_FORK]  ${UI_RST}" ;;
                *VALVE_SO*)   c_badge="${UI_AMBER}[VALVE_SO]  ${UI_RST}" ;;
                *VALVE_DLL*)  c_badge="${UI_CYAN}[VALVE_DLL] ${UI_RST}" ;;
                *)            c_badge="${UI_ICE}[STANDALONE]${UI_RST}" ;;
            esac
            printf "%b\t%b\t%b\t%s\t%s\n" "${UI_DIM}${c_appid}${UI_RST}" "${UI_BOLD}${c_title}${UI_RST}" "$c_badge" "$c_gdir" "$c_gbin"
        done < "$cache_file"
    else
        while IFS=$'\t' read -r c_appid c_title c_status c_gdir c_gbin; do
            [ -z "$c_gdir" ] && continue
            local clean_stat="$c_status"
            [[ "$clean_stat" != \[*\] ]] && clean_stat="[$clean_stat]"
            printf "%-8s\t%-22s\t%-12s\t%s\t%s\n" "$c_appid" "$c_title" "$clean_stat" "$c_gdir" "$c_gbin"
        done < "$cache_file"
    fi
}

# Generate FreeDesktop .desktop application shortcut (Chunk 5)
create_desktop_entry() {
    local game_dir="${1:-}"
    local title="${2:-}"

    if [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        echo "[ERROR] Game directory not found or invalid: $game_dir" >&2
        echo "Usage: gamectl make-desktop <game_dir> [title]" >&2
        return 1
    fi

    game_dir="$(cd "$game_dir" 2>/dev/null && pwd || echo "$game_dir")"

    # Attempt to resolve title if not supplied
    if [ -z "$title" ]; then
        local base_dir
        base_dir="$(basename "$game_dir")"
        local parent_apps
        parent_apps="$(dirname "$game_dir")"
        if [ "$(basename "$parent_apps")" = "common" ]; then
            local steamapps_dir
            steamapps_dir="$(dirname "$parent_apps")"
            local acf
            for acf in "$steamapps_dir"/appmanifest_*.acf; do
                [ -f "$acf" ] || continue
                local installdir
                installdir=$(grep -E '^\s*"installdir"' "$acf" | head -n 1 | sed -E 's/.*"installdir"[[:space:]]+"([^"]+)".*/\1/')
                if [ "$installdir" = "$base_dir" ]; then
                    title=$(grep -E '^\s*"name"' "$acf" | head -n 1 | sed -E 's/.*"name"[[:space:]]+"([^"]+)".*/\1/')
                    break
                fi
            done
        fi
        [ -z "$title" ] && title="$base_dir"
    fi

    # Locate game binary
    local gbin
    gbin="$(find_game_binary "$game_dir" 2>/dev/null || true)"
    if [ -z "$gbin" ]; then
        echo "[WARN] Game executable binary not detected automatically in $game_dir" >&2
    fi

    # Locate game icon (prefer icon.png, icon.ico, logo.png, or any png/ico)
    local icon_path="applications-games"
    local found_icon=""
    for candidate in "icon.png" "icon.ico" "logo.png" "app.png" "banner.png"; do
        if [ -f "$game_dir/$candidate" ]; then
            found_icon="$game_dir/$candidate"
            break
        fi
    done
    if [ -z "$found_icon" ]; then
        found_icon=$(find "$game_dir" -maxdepth 2 \( -name "*.ico" -o -name "*.png" \) 2>/dev/null | head -n 1 || true)
    fi
    [ -n "$found_icon" ] && icon_path="$found_icon"

    # Resolve gamectl binary
    local gamectl_bin
    gamectl_bin="$(command -v gamectl 2>/dev/null || true)"
    if [ -z "$gamectl_bin" ]; then
        if [ -x "$HOME/.local/bin/gamectl" ]; then
            gamectl_bin="$HOME/.local/bin/gamectl"
        elif [ -x "/usr/local/bin/gamectl" ]; then
            gamectl_bin="/usr/local/bin/gamectl"
        else
            gamectl_bin="gamectl"
        fi
    fi

    # Sanitize title for desktop entry file name
    local safe_title
    safe_title=$(echo "$title" | tr -dc '[:alnum:]_-' | tr '[:upper:]' '[:lower:]')
    [ -z "$safe_title" ] && safe_title="game"

    local desk_dir="$HOME/.local/share/applications"
    mkdir -p "$desk_dir"
    local desk_file="$desk_dir/gamectl-${safe_title}.desktop"

    cat <<EOF > "$desk_file"
[Desktop Entry]
Type=Application
Name=$title
Comment=Launched via gamectl
Exec=$gamectl_bin launch "$game_dir" --hud
Icon=$icon_path
Terminal=false
Categories=Game;
Path=$game_dir
StartupNotify=true
EOF

    chmod +x "$desk_file"
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$desk_dir" 2>/dev/null || true
    fi

    echo "[VERIFIED] Desktop entry created successfully: $desk_file"
    echo "[INFO] Title    : $title"
    echo "[INFO] Exec     : $gamectl_bin launch \"$game_dir\" --hud"
    echo "[INFO] Icon     : $icon_path"
    return 0
}

# Resolve active Steam user grid directory (~/.local/share/Steam/userdata/<account_id>/config/grid)
get_steam_grid_dir() {
    if [ -n "${GAMECTL_GRID_DIR:-}" ]; then
        echo "$GAMECTL_GRID_DIR"
        return 0
    fi

    local s_roots=(
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.steam/root"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
        "$HOME/snap/steam/common/.local/share/Steam"
    )
    for s_root in "${s_roots[@]}"; do
        if [ -d "$s_root/userdata" ]; then
            for udir in "$s_root/userdata"/*; do
                [ -d "$udir" ] || continue
                local u_id
                u_id=$(basename "$udir")
                if [[ "$u_id" =~ ^[0-9]+$ ]] && [ "$u_id" -gt 0 ] 2>/dev/null; then
                    echo "$udir/config/grid"
                    return 0
                fi
            done
        fi
    done

    # Fallback to default
    echo "$HOME/.local/share/Steam/userdata/0/config/grid"
}

# Fetch official artwork (portrait, banner, hero, logo) from Steam CDN
fetch_steam_artwork() {
    local target="${1:-}"
    local appid="${2:-}"

    if [ -z "$target" ]; then
        echo "Usage: gamectl fetch-art <game_dir|appid> [appid]" >&2
        return 1
    fi

    local game_dir=""
    if [[ "$target" =~ ^[0-9]+$ ]] && [ -z "$appid" ]; then
        appid="$target"
    elif [ -d "$target" ]; then
        game_dir="$target"
    elif [ -f "$target" ]; then
        game_dir="$(dirname "$target")"
    fi

    # Resolve AppID from directory if not explicitly provided
    if [ -z "$appid" ] && [ -n "$game_dir" ]; then
        if [ -f "$game_dir/steam_appid.txt" ]; then
            appid=$(grep -oE '^[0-9]+' "$game_dir/steam_appid.txt" 2>/dev/null | head -n 1 || true)
        elif [ -f "$game_dir/steam_settings/steam_appid.txt" ]; then
            appid=$(grep -oE '^[0-9]+' "$game_dir/steam_settings/steam_appid.txt" 2>/dev/null | head -n 1 || true)
        fi
    fi

    if [ -z "$appid" ]; then
        echo "[ERROR] Cannot resolve Steam AppID for target: $target" >&2
        echo "        Provide a numeric AppID: gamectl fetch-art <dir> <appid>" >&2
        return 1
    fi

    local grid_dir
    grid_dir=$(get_steam_grid_dir)
    mkdir -p "$grid_dir"

    # Identify target shortcut and artwork IDs
    local target_ids=("$appid")
    if [ -n "$game_dir" ]; then
        local g_bin
        g_bin=$(find_game_binary "$game_dir" 2>/dev/null || true)
        local g_title
        g_title=$(basename "$game_dir")
        if [ -n "$g_bin" ]; then
            local sc_id
            sc_id=$(python3 -c "import binascii, sys; p = sys.argv[1]; t = sys.argv[2]; print((binascii.crc32((p + t).encode('utf-8')) | 0x80000000))" "$game_dir/$g_bin" "$g_title" 2>/dev/null || true)
            if [ -n "$sc_id" ] && [ "$sc_id" != "$appid" ]; then
                target_ids+=("$sc_id")
            fi
        fi
    fi

    echo "[INFO] Fetching Steam artwork for AppID: $appid"
    echo "[INFO] Destination Steam grid directory: $grid_dir"

    local tmp_dir
    tmp_dir=$(mktemp -d)
    local downloaded_count=0

    # Helper function to download and convert image to PNG
    _download_asset() {
        local asset_type="$1"
        local asset_suffix="$2"
        shift 2
        local urls=("$@")

        local tmp_file="$tmp_dir/${asset_type// /_}.raw"
        rm -f "$tmp_file"

        local url
        for url in "${urls[@]}"; do
            if curl -fsSL --connect-timeout 5 --max-time 15 "$url" -o "$tmp_file" 2>/dev/null && [ -s "$tmp_file" ]; then
                break
            fi
        done

        if [ ! -s "$tmp_file" ]; then
            echo "    • $(printf '%-18s' "$asset_type") : [WARN] Not available on CDN"
            return 1
        fi

        local tid
        for tid in "${target_ids[@]}"; do
            local dest_png="$grid_dir/${tid}${asset_suffix}.png"
            if command -v magick >/dev/null 2>&1; then
                magick "$tmp_file" "$dest_png" 2>/dev/null || cp "$tmp_file" "$dest_png"
            elif command -v convert >/dev/null 2>&1; then
                convert "$tmp_file" "$dest_png" 2>/dev/null || cp "$tmp_file" "$dest_png"
            elif command -v ffmpeg >/dev/null 2>&1; then
                ffmpeg -v error -y -i "$tmp_file" "$dest_png" 2>/dev/null || cp "$tmp_file" "$dest_png"
            else
                cp "$tmp_file" "$dest_png"
            fi
        done

        echo "    • $(printf '%-18s' "$asset_type") : [VERIFIED] Saved as <id>${asset_suffix}.png"
        downloaded_count=$((downloaded_count + 1))
        return 0
    }

    # 1. Portrait capsule (600x900) -> <shortcut_id>p.png
    _download_asset "Portrait Capsule" "p" \
        "https://cdn.akamai.steamstatic.com/steam/apps/$appid/library_600x900_2x.jpg" \
        "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/$appid/library_600x900_2x.jpg" \
        "https://cdn.cloudflare.steamstatic.com/steam/apps/$appid/library_600x900_2x.jpg" \
        "https://cdn.akamai.steamstatic.com/steam/apps/$appid/library_600x900.jpg" || true

    # 2. Horizontal banner (920x430 or 460x215) -> <shortcut_id>.png
    _download_asset "Horizontal Banner" "" \
        "https://cdn.akamai.steamstatic.com/steam/apps/$appid/header.jpg" \
        "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/$appid/header.jpg" \
        "https://cdn.cloudflare.steamstatic.com/steam/apps/$appid/header.jpg" || true

    # 3. Hero background (1920x620) -> <shortcut_id>_hero.png
    _download_asset "Hero Background" "_hero" \
        "https://cdn.akamai.steamstatic.com/steam/apps/$appid/library_hero.jpg" \
        "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/$appid/library_hero.jpg" \
        "https://cdn.cloudflare.steamstatic.com/steam/apps/$appid/library_hero.jpg" || true

    # 4. Logo transparent overlay -> <shortcut_id>_logo.png
    _download_asset "Logo Overlay" "_logo" \
        "https://cdn.akamai.steamstatic.com/steam/apps/$appid/logo.png" \
        "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/$appid/logo.png" \
        "https://cdn.cloudflare.steamstatic.com/steam/apps/$appid/logo.png" || true

    rm -rf "$tmp_dir"

    if [ "$downloaded_count" -gt 0 ]; then
        echo "[VERIFIED] Successfully fetched $downloaded_count artwork asset(s) for AppID: $appid"
        return 0
    else
        echo "[ERROR] Failed to fetch any artwork assets for AppID: $appid" >&2
        return 1
    fi
}

# Resolve active Steam user shortcuts.vdf path (~/.local/share/Steam/userdata/<account_id>/config/shortcuts.vdf)
get_steam_shortcuts_vdf() {
    if [ -n "${GAMECTL_SHORTCUTS_VDF:-}" ]; then
        echo "$GAMECTL_SHORTCUTS_VDF"
        return 0
    fi

    local s_roots=(
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.steam/root"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
        "$HOME/snap/steam/common/.local/share/Steam"
    )
    for s_root in "${s_roots[@]}"; do
        if [ -d "$s_root/userdata" ]; then
            for udir in "$s_root/userdata"/*; do
                [ -d "$udir" ] || continue
                local u_id
                u_id=$(basename "$udir")
                if [[ "$u_id" =~ ^[0-9]+$ ]] && [ "$u_id" -gt 0 ] 2>/dev/null; then
                    echo "$udir/config/shortcuts.vdf"
                    return 0
                fi
            done
        fi
    done

    # Default fallback
    echo "$HOME/.local/share/Steam/userdata/0/config/shortcuts.vdf"
}

# Check if Steam client process is actively running and warn about memory lock
check_steam_active() {
    local context="${1:-Steam operations}"
    if pgrep -x steam >/dev/null 2>&1; then
        echo "[WARN] Steam client is currently running! $context while Steam is active may cause file lock conflicts or get overwritten upon client exit." >&2
        echo "[WARN] Recommendation: Exit Steam or restart it after this operation to reload shortcuts and manifests cleanly." >&2
        return 0
    fi
    return 1
}

# Add or update a non-Steam shortcut in Steam Deck Game Mode (binary shortcuts.vdf)
add_steam_shortcut() {
    local game_dir="${1:-}"
    local title="${2:-}"

    if [ -z "$game_dir" ]; then
        echo "Usage: gamectl add-to-steam <game_dir> [title]" >&2
        return 1
    fi

    if [ ! -d "$game_dir" ]; then
        echo "[ERROR] Game directory does not exist: $game_dir" >&2
        return 1
    fi

    # Guard against concurrent Steam client memory lock on shortcuts.vdf
    check_steam_active "Registering non-Steam shortcut in shortcuts.vdf" || true

    game_dir="$(cd "$game_dir" && pwd)"

    if [ -z "$title" ]; then
        title="$(basename "$game_dir")"
    fi

    # Locate game icon
    local icon_path=""
    for candidate in "icon.png" "icon.ico" "logo.png" "app.png" "banner.png"; do
        if [ -f "$game_dir/$candidate" ]; then
            icon_path="$game_dir/$candidate"
            break
        fi
    done
    if [ -z "$icon_path" ]; then
        icon_path=$(find "$game_dir" -maxdepth 2 \( -name "*.ico" -o -name "*.png" \) 2>/dev/null | head -n 1 || true)
    fi

    # Resolve gamectl binary
    local gamectl_bin
    gamectl_bin="$(command -v gamectl 2>/dev/null || true)"
    if [ -z "$gamectl_bin" ]; then
        if [ -x "$HOME/.local/bin/gamectl" ]; then
            gamectl_bin="$HOME/.local/bin/gamectl"
        elif [ -x "/usr/local/bin/gamectl" ]; then
            gamectl_bin="/usr/local/bin/gamectl"
        elif [ -x "${REPO_ROOT:-}/bin/gamectl" ]; then
            gamectl_bin="${REPO_ROOT:-}/bin/gamectl"
        else
            gamectl_bin="gamectl"
        fi
    fi

    local shortcuts_file
    shortcuts_file="$(get_steam_shortcuts_vdf)"
    local vdf_dir
    vdf_dir="$(dirname "$shortcuts_file")"
    mkdir -p "$vdf_dir"

    # Create atomic backup if file already exists
    if [ -f "$shortcuts_file" ]; then
        cp -f "$shortcuts_file" "${shortcuts_file}.bak"
    fi

    python3 - "$shortcuts_file" "$title" "$game_dir" "$gamectl_bin" "$icon_path" << 'PYEOF'
import sys, os, struct, binascii

shortcuts_path = sys.argv[1]
title = sys.argv[2]
game_dir = os.path.abspath(sys.argv[3])
gamectl_bin = sys.argv[4]
icon_path = sys.argv[5]

exe_field = f'"{gamectl_bin}"'
startdir_field = f'"{game_dir}"'
launch_opts = f'launch "{game_dir}" --hud'

raw_crc = (binascii.crc32((exe_field + title).encode('utf-8')) | 0x80000000) & 0xffffffff
signed_appid = struct.unpack('<i', struct.pack('<I', raw_crc))[0]

def parse_binary_vdf(data):
    pos = 0
    def read_str():
        nonlocal pos
        end = data.find(b'\x00', pos)
        if end == -1: return ''
        s = data[pos:end].decode('utf-8', errors='replace')
        pos = end + 1
        return s
    def parse_map():
        nonlocal pos
        res = {}
        while pos < len(data):
            b = data[pos]
            pos += 1
            if b == 8: break
            key = read_str()
            if b == 0: res[key] = parse_map()
            elif b == 1: res[key] = read_str()
            elif b == 2:
                if pos + 4 <= len(data):
                    val = struct.unpack('<i', data[pos:pos+4])[0]
                    pos += 4
                    res[key] = val
        return res
    if data.startswith(b'\x00shortcuts\x00'):
        pos = len(b'\x00shortcuts\x00')
        root = parse_map()
        shortcuts = []
        for k in sorted(root.keys(), key=lambda x: int(x) if x.isdigit() else 9999):
            if isinstance(root[k], dict): shortcuts.append(root[k])
        return shortcuts
    return []

def serialize_shortcuts(shortcuts):
    buf = bytearray(b'\x00shortcuts\x00')
    for idx, s in enumerate(shortcuts):
        buf.append(0)
        buf.extend(str(idx).encode('utf-8') + b'\x00')
        for k, v in s.items():
            if isinstance(v, int):
                buf.append(2)
                buf.extend(k.encode('utf-8') + b'\x00')
                buf.extend(struct.pack('<i', v))
            elif isinstance(v, str):
                buf.append(1)
                buf.extend(k.encode('utf-8') + b'\x00')
                buf.extend(v.encode('utf-8') + b'\x00')
            elif isinstance(v, dict):
                buf.append(0)
                buf.extend(k.encode('utf-8') + b'\x00')
                for tk, tv in v.items():
                    buf.append(1)
                    buf.extend(str(tk).encode('utf-8') + b'\x00')
                    buf.extend(str(tv).encode('utf-8') + b'\x00')
                buf.append(8)
        buf.append(8)
    buf.append(8)
    buf.append(8)
    return bytes(buf)

shortcuts = []
if os.path.exists(shortcuts_path):
    try:
        with open(shortcuts_path, 'rb') as f:
            shortcuts = parse_binary_vdf(f.read())
    except Exception:
        shortcuts = []

existing_idx = -1
for i, sc in enumerate(shortcuts):
    if sc.get('AppName') == title or sc.get('StartDir', '').strip('"') == game_dir:
        existing_idx = i
        break

new_entry = {
    'appid': signed_appid,
    'AppName': title,
    'Exe': exe_field,
    'StartDir': startdir_field,
    'icon': icon_path,
    'ShortcutPath': '',
    'LaunchOptions': launch_opts,
    'IsHidden': 0,
    'AllowDesktopConfig': 1,
    'AllowOverlay': 1,
    'OpenVR': 0,
    'Devkit': 0,
    'DevkitGameID': '',
    'DevkitOverrideAppID': 0,
    'LastPlayTime': 0,
    'FlatpakAppID': '',
    'tags': {}
}

if existing_idx >= 0:
    shortcuts[existing_idx] = new_entry
    action = "updated"
else:
    shortcuts.append(new_entry)
    action = "registered"

out_data = serialize_shortcuts(shortcuts)
tmp_path = shortcuts_path + f'.tmp.{os.getpid()}'
with open(tmp_path, 'wb') as f:
    f.write(out_data)
os.replace(tmp_path, shortcuts_path)

print(f'[VERIFIED] Steam shortcut {action} successfully: {title}')
print(f'[INFO] Target 32-bit AppID : {raw_crc}')
print(f'[INFO] Shortcuts file      : {shortcuts_path}')
print(f'[INFO] Launch Options      : {launch_opts}')
PYEOF

    # Optionally attempt artwork synchronization if an AppID is available
    if [ -f "$game_dir/steam_appid.txt" ] || [ -f "$game_dir/steam_settings/steam_appid.txt" ]; then
        fetch_steam_artwork "$game_dir" >/dev/null 2>&1 || true
    fi

    return 0
}


# --- [MODULE] src/steam/25_identity.sh ---
# Generate a valid 17-digit SteamID64 for individual accounts (76561197960265728 + 31-bit random int)
generate_steamid64() {
    local base=76561197960265728
    local rand=""
    if [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
        local raw
        raw=$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d ' ')
        if [ -n "$raw" ] && [ "$raw" -gt 0 ] 2>/dev/null; then
            rand=$(( raw % 2000000000 + 100000 ))
        fi
    fi
    if [ -z "$rand" ]; then
        local r1=$(( (RANDOM << 16) | RANDOM ))
        rand=$(( (r1 & 0x7FFFFFFF) % 2000000000 + 100000 ))
    fi
    echo $(( base + rand ))
}

# Hierarchical SteamID64 resolver (Env -> Persona -> Steam client active user -> random SteamID64)
resolve_active_steamid() {
    # Priority 1: Environment override
    if [ -n "${GAMECTL_STEAMID:-}" ] && [[ "$GAMECTL_STEAMID" =~ ^7656119[0-9]{10}$ ]]; then
        echo "$GAMECTL_STEAMID"
        return 0
    fi

    # Priority 2: Global persona configuration
    if [ -f "$HOME/.config/gamectl/persona" ]; then
        local p_id
        p_id=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r[:space:]')
        if [ -n "$p_id" ] && [[ "$p_id" =~ ^7656119[0-9]{10}$ ]]; then
            echo "$p_id"
            return 0
        fi
    fi

    # Priority 3: Active Steam client login
    local s_roots=(
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.steam/root"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
        "$HOME/snap/steam/common/.local/share/Steam"
    )
    for s_root in "${s_roots[@]}"; do
        local vdf="$s_root/config/loginusers.vdf"
        if [ -f "$vdf" ]; then
            local sid
            sid=$(grep -E '^[[:space:]]*"7656119[0-9]{10}"' "$vdf" 2>/dev/null | head -n 1 | tr -dc '0-9')
            if [ -n "$sid" ] && [ ${#sid} -eq 17 ]; then
                echo "$sid"
                return 0
            fi
        fi

        if [ -d "$s_root/userdata" ]; then
            local udir
            for udir in "$s_root/userdata"/*; do
                [ -d "$udir" ] || continue
                local u_id
                u_id=$(basename "$udir")
                if [[ "$u_id" =~ ^[0-9]+$ ]] && [ "$u_id" -gt 0 ] 2>/dev/null; then
                    local sid64=$(( 76561197960265728 + u_id ))
                    if [[ "$sid64" =~ ^7656119[0-9]{10}$ ]]; then
                        echo "$sid64"
                        return 0
                    fi
                fi
            done
        fi
    done

    # Priority 4: Dynamic random SteamID64
    generate_steamid64
}

# Resolve game LAN persona (account_name, account_steamid, language)
get_game_persona() {
    local gdir="$1"
    local p_name=""
    local p_id=""
    local p_lang="english"

    if [ -f "$gdir/steam_settings/configs.user.ini" ]; then
        p_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$gdir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        p_id=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$gdir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        p_lang=$(grep -E '^[[:space:]]*language[[:space:]]*=' "$gdir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*language[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi

    if [ -z "$p_name" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        p_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    if [ -z "$p_id" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        p_id=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi

    [ -z "$p_name" ] && p_name="${USER:-Player}"
    [ -z "$p_id" ] && p_id=$(resolve_active_steamid)
    [ -z "$p_lang" ] && p_lang="english"

    echo "$p_name|$p_id|$p_lang"
}


# Set LAN Player Name, SteamID, and broadcast IPs for GBE Fork co-op
set_id() {
    local player_name="${1:-}"
    shift || true

    if [ -z "$player_name" ]; then
        echo "Usage: gamectl set-id <player_name> [steamid] [target_dir] [--broadcast <ip>] [--global]" >&2
        return 1
    fi

    local steamid=""
    local target_dir=""
    local broadcast_ips=()
    local save_global=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --global)
                save_global=true
                shift
                ;;
            --broadcast)
                if [ -n "${2:-}" ]; then
                    broadcast_ips+=("$2")
                    shift 2
                else
                    shift
                fi
                ;;
            --broadcast=*)
                broadcast_ips+=("${1#*=}")
                shift
                ;;
            *)
                if [ -z "$steamid" ] && { [[ "$1" =~ ^7656119[0-9]{10}$ ]] || [ "$1" = "auto" ] || [ "$1" = "random" ]; }; then
                    if [ "$1" = "auto" ] || [ "$1" = "random" ]; then
                        steamid=$(generate_steamid64)
                    else
                        steamid="$1"
                    fi
                elif [ -z "$target_dir" ] && [ -d "$1" ]; then
                    target_dir="$1"
                elif [ -z "$steamid" ] && [[ "$1" =~ ^[0-9]+$ ]] && [ ${#1} -eq 17 ]; then
                    steamid="$1"
                else
                    if [ -z "$target_dir" ]; then
                        target_dir="$1"
                    fi
                fi
                shift
                ;;
        esac
    done

    # Generate steamid if still empty
    if [ -z "$steamid" ]; then
        steamid=$(generate_steamid64)
    fi

    # Determine target directory
    if [ -z "$target_dir" ]; then
        if [ -d "./steam_settings" ] || [ -f "./steam_appid.txt" ]; then
            target_dir="."
        else
            save_global=true
        fi
    fi

    # Save to global config if requested or if no game directory identified
    if [ "$save_global" = true ]; then
        mkdir -p "$HOME/.config/gamectl"
        cat <<EOF > "$HOME/.config/gamectl/persona"
# gamectl global persona
account_name=$player_name
account_steamid=$steamid
language=english
EOF
        echo "[INFO] Global persona saved to ~/.config/gamectl/persona ($player_name | $steamid)"
    fi

    if [ -n "$target_dir" ] && [ -d "$target_dir" ]; then
        target_dir="$(cd "$target_dir" && pwd)"
        mkdir -p "$target_dir/steam_settings"

        local ini_file="$target_dir/steam_settings/configs.user.ini"
        if [ -f "$ini_file" ]; then
            if grep -q -E '^[[:space:]]*account_name[[:space:]]*=' "$ini_file"; then
                sed -i -E "s/^[[:space:]]*account_name[[:space:]]*=.*/account_name=$player_name/" "$ini_file"
            else
                echo "account_name=$player_name" >> "$ini_file"
            fi
            if grep -q -E '^[[:space:]]*account_steamid[[:space:]]*=' "$ini_file"; then
                sed -i -E "s/^[[:space:]]*account_steamid[[:space:]]*=.*/account_steamid=$steamid/" "$ini_file"
            else
                echo "account_steamid=$steamid" >> "$ini_file"
            fi
        else
            cat <<EOF > "$ini_file"
[user::general]
account_name=$player_name
account_steamid=$steamid
language=english

[user::saves]
local_save_path=./saves
EOF
        fi

        # Handle custom_broadcasts.txt
        local bc_file="$target_dir/steam_settings/custom_broadcasts.txt"
        if [ ! -f "$bc_file" ]; then
            cat <<EOF > "$bc_file"
# GBE Fork LAN Custom Broadcast IP list
# Add peer IPs or broadcast subnets (one IP per line)
127.0.0.1
255.255.255.255
EOF
        fi

        if [ ${#broadcast_ips[@]} -gt 0 ]; then
            for ip in "${broadcast_ips[@]}"; do
                IFS=',' read -ra split_ips <<< "$ip"
                for s_ip in "${split_ips[@]}"; do
                    s_ip=$(echo "$s_ip" | tr -d ' ')
                    [ -z "$s_ip" ] && continue
                    if ! grep -q -F "$s_ip" "$bc_file" 2>/dev/null; then
                        echo "$s_ip" >> "$bc_file"
                        echo "[INFO] Added broadcast IP: $s_ip"
                    fi
                done
            done
        fi

        # Ensure symlinks to subfolders if shim exists in subdirectory
        for shim_candidate in "$target_dir"/*/*.dll "$target_dir"/*/*/*.dll "$target_dir"/*/*.so "$target_dir"/*/*/*.so; do
            if [ -f "$shim_candidate" ]; then
                local s_dir
                s_dir="$(dirname "$shim_candidate")"
                if [ "$s_dir" != "$target_dir" ] && [ -d "$s_dir" ]; then
                    ln -sfn "$target_dir/steam_settings" "$s_dir/steam_settings" 2>/dev/null || true
                fi
            fi
        done

        echo "[VERIFIED] Game LAN identity updated in $target_dir:"
        echo "           Player Name : $player_name"
        echo "           SteamID64   : $steamid"
        echo "           Config File : $ini_file"
        local is_gbe_check=false
        for api_c in "$target_dir/libsteam_api.so" "$target_dir/lib64/libsteam_api.so" "$target_dir/steam_api64.dll" "$target_dir/steam_api.dll"; do
            if [ -f "$api_c" ]; then
                local sz
                sz=$(stat -c%s "$api_c" 2>/dev/null || echo 0)
                [ "$sz" -gt 7000000 ] && is_gbe_check=true && break
            fi
        done
        if [ "$is_gbe_check" = false ]; then
            echo "           Note        : Game is not injected with GBE Fork yet. Press <CTRL-I> to enable."
        fi
    fi
}

# Interactive TUI configurator for LAN persona & SteamID
set_id_interactive() {
    local target_dir="${1:-}"
    local title="${2:-}"
    if [ -z "$target_dir" ] || [ ! -d "$target_dir" ]; then
        echo "[ERROR] Invalid game directory: $target_dir" >&2
        return 1
    fi
    target_dir="$(cd "$target_dir" && pwd)"
    [ -z "$title" ] && title="$(basename "$target_dir")"

    local p_info
    p_info=$(get_game_persona "$target_dir")
    local cur_name cur_id cur_lang
    cur_name=$(echo "$p_info" | cut -d'|' -f1)
    cur_id=$(echo "$p_info" | cut -d'|' -f2)
    cur_lang=$(echo "$p_info" | cut -d'|' -f3)

    local is_gbe=false
    local api_cand
    for api_cand in "$target_dir/libsteam_api.so" "$target_dir/lib64/libsteam_api.so" "$target_dir/steam_api64.dll" "$target_dir/steam_api.dll"; do
        if [ -f "$api_cand" ]; then
            local sz
            sz=$(stat -c%s "$api_cand" 2>/dev/null || echo 0)
            if [ "$sz" -gt 7000000 ]; then
                is_gbe=true
                break
            fi
        fi
    done
    if [ "$is_gbe" = false ]; then
        local deep_api
        deep_api=$(find "$target_dir" -maxdepth 3 \( -name "libsteam_api.so" -o -name "steam_api64.dll" -o -name "steam_api.dll" \) 2>/dev/null | head -n 1)
        if [ -n "$deep_api" ]; then
            local sz
            sz=$(stat -c%s "$deep_api" 2>/dev/null || echo 0)
            [ "$sz" -gt 7000000 ] && is_gbe=true
        fi
    fi

    echo
    echo "${UI_BOX}╭─ CONFIGURE LAN IDENTITY & STEAMID (GBE FORK) ───────────────╮${UI_RST}"
    echo "│ ${UI_CYAN}Target Game  ${UI_RST}: ${UI_BOLD}$title${UI_RST}"
    echo "│ ${UI_CYAN}Directory    ${UI_RST}: ${UI_DIM}$target_dir${UI_RST}"
    echo "│ ${UI_CYAN}Player Name  ${UI_RST}: ${UI_BOLD}${cur_name:-[Unset]}${UI_RST}"
    echo "│ ${UI_CYAN}SteamID64    ${UI_RST}: ${UI_BOLD}${cur_id:-[Unset]}${UI_RST}"
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"

    if [ "$is_gbe" = false ]; then
        echo "  ${UI_AMBER}[NOTE] This game is not injected with GBE Fork yet.${UI_RST}"
        echo "         Persona will be saved to steam_settings/configs.user.ini"
        echo "         and activates automatically once injected (<CTRL-I>)."
        echo
    fi

    flush_tty_input
    local in_name_raw rc=0
    in_name_raw=$(: | fzf \
        --print-query \
        --border-label="  ╢ LAN Persona :: Player Name ╟  " \
        --border-label-pos=2 \
        --header="Enter Player Name (Current: ${cur_name:-Player} │ Enter: Next │ Esc: Cancel)" \
        --prompt="Player Name > " \
        --height=20% \
        --reverse 2>/dev/null) || rc=$?
    [ "$rc" -eq 130 ] && return 0
    local in_name
    in_name=$(echo "$in_name_raw" | head -n 1 | tr -d '\r\n')
    [ -z "$in_name" ] && in_name="$cur_name"
    [ -z "$in_name" ] && in_name="${USER:-Player}"

    flush_tty_input
    local suggested_id
    suggested_id=$(generate_steamid64)
    local in_id_raw
    in_id_raw=$(: | fzf \
        --print-query \
        --border-label="  ╢ LAN Persona :: SteamID64 ╟  " \
        --border-label-pos=2 \
        --header="Enter SteamID64, 'gen' for random ID, or leave blank (Current: ${cur_id:-$suggested_id})" \
        --prompt="SteamID64 > " \
        --height=20% \
        --reverse 2>/dev/null) || rc=$?
    [ "$rc" -eq 130 ] && return 0
    local in_id
    in_id=$(echo "$in_id_raw" | head -n 1 | tr -d '[:space:]')
    [ -z "$in_id" ] && in_id="${cur_id:-$suggested_id}"
    if [ "$in_id" = "random" ] || [ "$in_id" = "auto" ] || [ "$in_id" = "gen" ]; then
        in_id=$(generate_steamid64)
    fi

    flush_tty_input
    local in_bc_raw
    in_bc_raw=$(: | fzf \
        --print-query \
        --border-label="  ╢ LAN Custom Broadcast Peer IP (Optional) ╟  " \
        --border-label-pos=2 \
        --header="Enter friend's LAN IP (e.g. 192.168.1.50) or leave blank (Enter: Next │ Esc: Skip)" \
        --prompt="Peer IP > " \
        --height=20% \
        --reverse 2>/dev/null) || true
    local in_bc
    in_bc=$(echo "$in_bc_raw" | head -n 1 | tr -d '[:space:]')

    local glob_entries
    glob_entries=$(cat <<EOF
no	No, apply to this game only	Keep global defaults untouched
yes	Yes, also save as global persona	Update ~/.config/gamectl/persona
EOF
)
    flush_tty_input
    local glob_sel
    glob_sel=$(echo "$glob_entries" | fzf \
        --delimiter=$'\t' \
        --with-nth=2,3 \
        --border-label="  ╢ Global Persona Sync ╟  " \
        --border-label-pos=2 \
        --header="Also save this persona as global default for future games?" \
        --prompt="Save Global > " \
        --height=25% \
        --reverse 2>/dev/null) || true

    local extra_args=()
    [ -n "$in_bc" ] && extra_args+=(--broadcast "$in_bc")
    if echo "$glob_sel" | grep -q '^yes'; then
        extra_args+=(--global)
    fi

    set_id "$in_name" "$in_id" "$target_dir" "${extra_args[@]}"
    log_msg "INFO" "PERSONA" "Configured LAN identity for $title: $in_name ($in_id)"
}


# --- [MODULE] src/steam/30_downloader.sh ---
if ! declare -F strip_ansi >/dev/null 2>&1; then
    strip_ansi() {
        printf "%s" "${1:-}" | sed -E $'s/\033\\[[0-9;]*[a-zA-Z]//g'
    }
fi

if ! declare -F get_runtime_dir >/dev/null 2>&1; then
    get_runtime_dir() {
        local run_uid="${UID:-$(id -u 2>/dev/null || echo 1000)}"
        local run_dir="${XDG_RUNTIME_DIR:-/tmp/gamectl-$UID}"
        mkdir -p -m 700 "$run_dir" 2>/dev/null || true
        echo "$run_dir"
    }
fi

if ! declare -F fetch_cached_json >/dev/null 2>&1; then
    fetch_cached_json() {
        local url="${1:-}" cache_key="${2:-}" ttl="${3:-3600}"
        [ -z "$url" ] || [ -z "$cache_key" ] && return 1
        local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gamectl"
        mkdir -p "$cache_dir" 2>/dev/null || true
        local safe_key
        safe_key=$(echo "$cache_key" | tr -cd '[:alnum:]_-')
        local cache_file="$cache_dir/${safe_key}.json"
        local now
        now=$(date +%s)
        if [ -f "$cache_file" ]; then
            local mtime
            mtime=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0)
            local age=$(( now - mtime ))
            if [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ] && [ -s "$cache_file" ]; then
                cat "$cache_file"
                return 0
            fi
        fi
        local tmp_file="${cache_file}.tmp.$$"
        local fetched
        fetched=$(curl -s --connect-timeout 2 --max-time 4 "$url" 2>/dev/null || true)
        if [ -n "$fetched" ] && [ "$fetched" != "null" ]; then
            if echo "$fetched" | jq . >/dev/null 2>&1; then
                echo "$fetched" > "$tmp_file" 2>/dev/null && mv -f "$tmp_file" "$cache_file" 2>/dev/null || rm -f "$tmp_file" 2>/dev/null
                echo "$fetched"
                return 0
            fi
        fi
        rm -f "$tmp_file" 2>/dev/null || true
        [ -s "$cache_file" ] && { cat "$cache_file"; return 0; }
        return 1
    }
fi

# Fetch and generate steam_settings/DLC.txt for GBE Fork
fetch_dlc() {
    local target_dir="$1"
    local appid="${2:-}"

    if [ ! -d "$target_dir" ]; then
        echo "[ERROR] Target directory not found: $target_dir" >&2
        return 1
    fi

    target_dir="$(cd "$target_dir" && pwd)"

    # Resolve AppID if not provided
    if [ -z "$appid" ]; then
        if [ -f "$target_dir/steam_appid.txt" ]; then
            appid=$(tr -dc '0-9' < "$target_dir/steam_appid.txt")
        fi
    fi

    if [ -z "$appid" ] || [ "$appid" = "STANDALONE" ]; then
        echo "[WARN] Numeric AppID not found. Skipping DLC.txt generation."
        return 0
    fi

    echo "[INFO] Fetching DLC list for AppID $appid from Steam API..."
    local dlc_file="$target_dir/steam_settings/DLC.txt"
    mkdir -p "$target_dir/steam_settings"

    # Primary: dlcforapp endpoint (names & IDs in single call, disk-cached 3600s)
    local dlc_data=""
    dlc_data=$(fetch_cached_json "https://store.steampowered.com/api/dlcforapp/?appid=${appid}" "steam_dlc_${appid}" 3600 2>/dev/null | jq -r '.dlc[]? | "\(.id)=\(.name)"' 2>/dev/null || true)

    # Fallback: appdetails basic,dlc (disk-cached 3600s)
    if [ -z "$dlc_data" ]; then
        local dlc_ids
        dlc_ids=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=basic,dlc" "steam_basic_dlc_${appid}" 3600 2>/dev/null | jq -r ".\"${appid}\".data.dlc[]?" 2>/dev/null || true)
        if [ -n "$dlc_ids" ]; then
            dlc_data=""
            while read -r did; do
                [ -n "$did" ] && dlc_data+="${did}=DLC_${did}"$'\n'
            done <<< "$dlc_ids"
        fi
    fi

    # Fallback 2: Offline local Lua manifest harvesting
    if [ -z "$dlc_data" ]; then
        local lua_candidates=()
        [ -f "$target_dir/${appid}.lua" ] && lua_candidates+=("$target_dir/${appid}.lua")
        shopt -s nullglob globstar
        for f in "$target_dir"/**/"${appid}.lua" "$target_dir"/**/*.lua "$target_dir"/*.lua; do [ -f "$f" ] && lua_candidates+=("$f"); done
        shopt -u nullglob globstar
        local stplug_dir
        stplug_dir="$(get_steam_stplug_in_dir 2>/dev/null || echo "$HOME/.local/share/Steam/config/stplug-in")"
        [ -f "$stplug_dir/${appid}.lua" ] && lua_candidates+=("$stplug_dir/${appid}.lua")
        [ -f "$HOME/.config/SLSsteam/manifests/${appid}.lua" ] && lua_candidates+=("$HOME/.config/SLSsteam/manifests/${appid}.lua")
        local run_dir
        run_dir="$(get_runtime_dir)"
        [ -f "$run_dir/${appid}.lua" ] && lua_candidates+=("$run_dir/${appid}.lua")

        declare -A seen_dlc=()
        for cand_lua in "${lua_candidates[@]}"; do
            [ -f "$cand_lua" ] || continue
            while read -r parsed_id; do
                [ -n "$parsed_id" ] || continue
                [ "$parsed_id" = "$appid" ] && continue
                [[ -v seen_dlc["$parsed_id"] ]] && continue
                seen_dlc["$parsed_id"]=1
                dlc_data+="${parsed_id}=DLC_${parsed_id}"$'\n'
            done < <(grep -E 'addappid[[:space:]]*\([[:space:]]*[0-9]+' "$cand_lua" 2>/dev/null | sed -E 's/.*addappid[[:space:]]*\([[:space:]]*([0-9]+).*/\1/')
        done
        if [ -n "$dlc_data" ]; then
            echo "[INFO] Offline fallback: Discovered $(( ${#seen_dlc[@]} )) DLC(s) from local Lua manifests."
        fi
    fi

    if [ -n "$dlc_data" ]; then
        echo -n "$dlc_data" > "$dlc_file"
        # Ensure trailing newline
        [ -s "$dlc_file" ] && echo "" >> "$dlc_file"
        local count
        count=$(grep -c "=" "$dlc_file" || echo 0)
        echo "[VERIFIED] Successfully wrote $count DLC(s) to: $dlc_file"
    else
        touch "$dlc_file"
        echo "[INFO] No DLC found in Steam API. Created empty file: $dlc_file"
    fi
}

# Verify Valve manifest payload magic signature (0xd017f671)
manifest_has_payload_magic() {
    local m_file="$1"
    [ -f "$m_file" ] || return 1
    local sig
    sig=$(od -An -tx1 -N4 "$m_file" 2>/dev/null | tr -d " \n")
    [ "$sig" = "d017f671" ]
}

# Validate downloaded manifest ZIP archive for safety and payload contents
validate_manifest_zip() {
    local z_file="$1"
    local appid="${2:-}"
    [ -f "$z_file" ] || return 1
    unzip -tq "$z_file" >/dev/null 2>&1 || return 1

    local entries
    entries=$(unzip -Z1 "$z_file" 2>/dev/null) || return 1
    [ -n "$entries" ] || return 1

    # Security: Path traversal & absolute path rejection
    if echo "$entries" | grep -Eq '(^/|^[A-Za-z]:|(^|[/\\])\.\.([/\\]|$)|\\)'; then
        echo "[ERROR] Manifest zip contains unsafe paths (path traversal rejected)." >&2
        return 1
    fi

    # Content check: must contain at least one .manifest or .lua file
    if ! echo "$entries" | grep -Eq '(\.manifest|\.lua)$'; then
        echo "[ERROR] Manifest zip does not contain any .manifest or .lua files." >&2
        return 1
    fi

    # Payload magic audit on contained manifests
    local run_dir
    run_dir="$(get_runtime_dir)"
    local audit_tmp="$run_dir/manifest_audit_$$"
    mkdir -p -m 700 "$audit_tmp"
    local has_valid_manifest=0

    # Extract only .manifest files to temporary audit sandbox
    unzip -q -j "$z_file" "*.manifest" -d "$audit_tmp" 2>/dev/null || true
    for mf in "$audit_tmp"/*.manifest; do
        [ -f "$mf" ] || continue
        if manifest_has_payload_magic "$mf"; then
            has_valid_manifest=1
            break
        fi
    done
    rm -rf "$audit_tmp"

    # If no .manifest was found or .lua only, check if .lua has addappid
    if [ "$has_valid_manifest" -eq 0 ]; then
        if echo "$entries" | grep -Eq '\.lua$'; then
            has_valid_manifest=1
        fi
    fi

    [ "$has_valid_manifest" -eq 1 ]
}

# Check if file is a valid Lua manifest / stplugin payload
is_valid_lua_manifest() {
    local lua_file="$1"
    local appid="${2:-}"
    [ -f "$lua_file" ] || return 1
    local sz
    sz=$(stat -c %s "$lua_file" 2>/dev/null || wc -c < "$lua_file" 2>/dev/null || echo 0)
    [ "$sz" -gt 0 ] && [ "$sz" -le 16777216 ] || return 1

    local clean
    clean=$(sed 's/--.*$//' "$lua_file" 2>/dev/null || true)
    if [ -n "$appid" ]; then
        echo "$clean" | grep -Eq "^[[:space:]]*addappid[[:space:]]*\([[:space:]]*${appid}([[:space:]]*\)|[[:space:]]*,)" || \
        echo "$clean" | grep -Eq "^[[:space:]]*addappid[[:space:]]*\("
    else
        echo "$clean" | grep -Eq "^[[:space:]]*addappid[[:space:]]*\("
    fi
}

# Acquire or auto-refresh LuaTools bearer access token
get_valid_luatools_token() {
    local lumen_auth="${XDG_DATA_HOME:-$HOME/.local/share}/Lumen/luatools/backend/data/lua_tools_auth.json"
    local cfg_auth="$HOME/.config/gamectl/lua_tools_auth.json"
    local target_auth=""

    if [ -f "$cfg_auth" ]; then
        target_auth="$cfg_auth"
    elif [ -f "$lumen_auth" ]; then
        target_auth="$lumen_auth"
        # Seed into ~/.config/gamectl for standalone sovereign operation
        mkdir -p "$HOME/.config/gamectl"
        cp -f "$lumen_auth" "$cfg_auth" 2>/dev/null || true
        chmod 600 "$cfg_auth" 2>/dev/null || true
        target_auth="$cfg_auth"
    fi

    [ -n "$target_auth" ] && [ -f "$target_auth" ] || return 1

    local access_token refresh_token expires_at now
    access_token=$(jq -r '.access_token // empty' "$target_auth" 2>/dev/null || true)
    refresh_token=$(jq -r '.refresh_token // empty' "$target_auth" 2>/dev/null || true)
    expires_at=$(jq -r '.expires_at // 0' "$target_auth" 2>/dev/null || echo 0)
    now=$(date +%s)

    # Return valid cached token if at least 60 seconds remain before expiration
    if [ -n "$access_token" ] && [ "$((expires_at - now))" -gt 60 ]; then
        printf "%s" "$access_token"
        return 0
    fi

    # Trigger token auto-refresh via Supabase auth endpoint
    if [ -n "$refresh_token" ]; then
        local supabase_key="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3NzYwMzkzNzYsImV4cCI6MTg5MzQ1NjAwMCwicm9sZSI6ImFub24iLCJpc3MiOiJzdXBhYmFzZSJ9.f_-K38u3odjltP-g_67FVmG32Vg-_-k-lNBvIaVUVBM"
        local refresh_resp
        refresh_resp=$(curl -sSL --connect-timeout 5 --max-time 15 \
            -X POST "https://db.lua.tools/auth/v1/token?grant_type=refresh_token" \
            -H "Content-Type: application/json" \
            -H "apikey: $supabase_key" \
            -H "User-Agent: discord(dot)gg/luatools" \
            -d "{\"refresh_token\":\"$refresh_token\"}" 2>/dev/null || true)

        local new_token new_expires_in new_refresh
        new_token=$(echo "$refresh_resp" | jq -r '.access_token // empty' 2>/dev/null || true)
        new_expires_in=$(echo "$refresh_resp" | jq -r '.expires_in // 3600' 2>/dev/null || echo 3600)
        new_refresh=$(echo "$refresh_resp" | jq -r '.refresh_token // empty' 2>/dev/null || true)

        if [ -n "$new_token" ]; then
            local new_expires_at=$((now + new_expires_in))
            [ -z "$new_refresh" ] && new_refresh="$refresh_token"

            local tmp_json="${target_auth}.tmp.$$"
            jq --arg at "$new_token" \
               --arg rt "$new_refresh" \
               --argjson exp "$new_expires_at" \
               '.access_token = $at | .refresh_token = $rt | .expires_at = $exp' \
               "$target_auth" > "$tmp_json" 2>/dev/null && mv -f "$tmp_json" "$target_auth"
            chmod 600 "$target_auth" 2>/dev/null || true

            # Also synchronize back to Lumen backend auth file if present
            if [ -f "$lumen_auth" ] && [ "$target_auth" != "$lumen_auth" ]; then
                cp -f "$target_auth" "$lumen_auth" 2>/dev/null || true
                chmod 600 "$lumen_auth" 2>/dev/null || true
            fi

            printf "%s" "$new_token"
            return 0
        fi
    fi

    # Fallback to existing access_token if network refresh fails
    if [ -n "$access_token" ]; then
        printf "%s" "$access_token"
        return 0
    fi

    return 1
}

# Authenticate or import standalone LuaTools session
login_luatools() {
    local input="${1:-}"
    local cfg_auth="$HOME/.config/gamectl/lua_tools_auth.json"
    mkdir -p "$HOME/.config/gamectl"

    if [ -z "$input" ]; then
        echo "Usage: gamectl login-luatools <6-character-code | refresh_token | session.json>"
        echo "Tip: Generate a 6-character code at https://lua.tools/ or Discord bot (/login)"
        return 1
    fi

    local supabase_key="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3NzYwMzkzNzYsImV4cCI6MTg5MzQ1NjAwMCwicm9sZSI6ImFub24iLCJpc3MiOiJzdXBhYmFzZSJ9.f_-K38u3odjltP-g_67FVmG32Vg-_-k-lNBvIaVUVBM"
    local now
    now=$(date +%s)

    # Mode 1: 6-Character Redeem Code (e.g. A1B2C3)
    if [[ "$input" =~ ^[A-Za-z0-9]{6}$ ]]; then
        local code="${input^^}"
        echo "[INFO] Redeeming 6-character code '$code' at lua.tools API..."
        local redeem_resp
        redeem_resp=$(curl -sSL --connect-timeout 5 --max-time 15 \
            -X POST "https://lua.tools/api/auth/code/redeem" \
            -H "Content-Type: application/json" \
            -H "User-Agent: discord(dot)gg/luatools" \
            -d "{"code":"$code"}" 2>/dev/null || true)

        local token_hash
        token_hash=$(echo "$redeem_resp" | jq -r '.token // empty' 2>/dev/null || true)
        if [ -z "$token_hash" ]; then
            echo "[ERROR] Failed to redeem code: $(echo "$redeem_resp" | jq -r '.error // "Unknown error"' 2>/dev/null || echo "$redeem_resp")" >&2
            return 1
        fi

        echo "[INFO] Verifying authentication token with Supabase..."
        local verify_resp
        verify_resp=$(curl -sSL --connect-timeout 5 --max-time 15 \
            -X POST "https://db.lua.tools/auth/v1/verify" \
            -H "Content-Type: application/json" \
            -H "apikey: $supabase_key" \
            -H "User-Agent: discord(dot)gg/luatools" \
            -d "{"type":"magiclink","token_hash":"$token_hash"}" 2>/dev/null || true)

        local access_token refresh_token expires_in
        access_token=$(echo "$verify_resp" | jq -r '.access_token // empty' 2>/dev/null || true)
        refresh_token=$(echo "$verify_resp" | jq -r '.refresh_token // empty' 2>/dev/null || true)
        expires_in=$(echo "$verify_resp" | jq -r '.expires_in // 3600' 2>/dev/null || echo 3600)

        if [ -n "$access_token" ] && [ -n "$refresh_token" ]; then
            local expires_at=$((now + expires_in))
            echo "$verify_resp" | jq --argjson exp "$expires_at" '.expires_at = $exp' > "$cfg_auth"
            chmod 600 "$cfg_auth"
            local user_name
            user_name=$(echo "$verify_resp" | jq -r '.user.user_metadata.custom_claims.global_name // .user.user_metadata.full_name // .user.email // "User"' 2>/dev/null || echo "User")
            echo "[VERIFIED] Successfully authenticated as $user_name. Sesi disimpan di $cfg_auth"
            return 0
        else
            echo "[ERROR] Verification failed: $(echo "$verify_resp" | jq -r '.error_description // .message // "Invalid session response"')" >&2
            return 1
        fi

    # Mode 2: Existing JSON session file (e.g. from Lumen or backup)
    elif [ -f "$input" ]; then
        if jq -e '.refresh_token' "$input" >/dev/null 2>&1; then
            cp -f "$input" "$cfg_auth"
            chmod 600 "$cfg_auth"
            echo "[VERIFIED] Imported session file from $input -> $cfg_auth"
            get_valid_luatools_token >/dev/null 2>&1 || true
            return 0
        else
            echo "[ERROR] File does not contain a valid .refresh_token JSON field." >&2
            return 1
        fi

    # Mode 3: Raw refresh_token or JWT string
    else
        echo "[INFO] Attempting refresh exchange using provided raw token..."
        local refresh_resp
        refresh_resp=$(curl -sSL --connect-timeout 5 --max-time 15 \
            -X POST "https://db.lua.tools/auth/v1/token?grant_type=refresh_token" \
            -H "Content-Type: application/json" \
            -H "apikey: $supabase_key" \
            -H "User-Agent: discord(dot)gg/luatools" \
            -d "{"refresh_token":"$input"}" 2>/dev/null || true)

        local access_token new_refresh expires_in
        access_token=$(echo "$refresh_resp" | jq -r '.access_token // empty' 2>/dev/null || true)
        new_refresh=$(echo "$refresh_resp" | jq -r '.refresh_token // empty' 2>/dev/null || echo "$input")
        expires_in=$(echo "$refresh_resp" | jq -r '.expires_in // 3600' 2>/dev/null || echo 3600)

        if [ -n "$access_token" ]; then
            local expires_at=$((now + expires_in))
            echo "$refresh_resp" | jq --argjson exp "$expires_at" --arg rt "$new_refresh" '.expires_at = $exp | .refresh_token = $rt' > "$cfg_auth"
            chmod 600 "$cfg_auth"
            echo "[VERIFIED] Successfully authenticated via token. Sesi disimpan di $cfg_auth"
            return 0
        else
            echo "[ERROR] Token exchange failed: $(echo "$refresh_resp" | jq -r '.error_description // .error // "Invalid token"')" >&2
            return 1
        fi
    fi
}

# Display LuaTools authentication session status
luatools_status() {
    local cfg_auth="$HOME/.config/gamectl/lua_tools_auth.json"
    local lumen_auth="${XDG_DATA_HOME:-$HOME/.local/share}/Lumen/luatools/backend/data/lua_tools_auth.json"
    local target_auth=""

    if [ -f "$cfg_auth" ]; then target_auth="$cfg_auth"; elif [ -f "$lumen_auth" ]; then target_auth="$lumen_auth"; fi

    if [ -n "$target_auth" ] && [ -f "$target_auth" ]; then
        local user_name expires_at now remaining
        user_name=$(jq -r '.user.user_metadata.custom_claims.global_name // .user.user_metadata.full_name // .user.email // "Authenticated User"' "$target_auth" 2>/dev/null || echo "Authenticated User")
        expires_at=$(jq -r '.expires_at // 0' "$target_auth" 2>/dev/null || echo 0)
        now=$(date +%s)
        remaining=$((expires_at - now))
        echo "[STATUS] LuaTools Session: ACTIVE (${target_auth})"
        echo "  • User     : $user_name"
        if [ "$remaining" -gt 0 ]; then
            echo "  • Lifetime : Token valid ($((remaining / 60)) min remaining, auto-refreshed by gamectl)"
        else
            echo "  • Lifetime : Expired (will auto-refresh on next download)"
        fi
    else
        echo "[STATUS] LuaTools Session: NOT CONFIGURED"
        echo "  • Public providers (Ryuu, Sushi) are ACTIVE (Zero login required)."
        echo "  • To unlock LuaTools provider: gamectl login-luatools <6-character-code | token>"
    fi
}

# Multi-Provider Manifest & Key Harvester
fetch_manifest() {
    local appid="$1"
    local dest_file="${2:-}"
    local pref_source="${3:-auto}"

    # Strip any ANSI escape sequences
    appid=$(strip_ansi "$appid" | tr -dc "0-9")
    if [ -z "$appid" ]; then
        echo "[ERROR] fetch_manifest: Invalid numeric AppID." >&2
        return 1
    fi

    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gamectl/manifests"
    mkdir -p -m 700 "$cache_dir"
    local cached_zip="$cache_dir/${appid}.zip"

    # 1. Check valid persistent cache
    if [ -f "$cached_zip" ] && validate_manifest_zip "$cached_zip" "$appid"; then
        echo "[INFO] Using cached manifest archive: $cached_zip" >&2
        if [ -n "$dest_file" ]; then
            cp -f "$cached_zip" "$dest_file"
            echo "$dest_file"
        else
            echo "$cached_zip"
        fi
        return 0
    fi

    # 2. Check local repository stash (~/.local/share/gamectl/manifests/)
    local stash_zip="$HOME/.local/share/gamectl/manifests/${appid}.zip"
    if [ -f "$stash_zip" ] && validate_manifest_zip "$stash_zip" "$appid"; then
        echo "[INFO] Using local stash manifest archive: $stash_zip" >&2
        cp -f "$stash_zip" "$cached_zip"
        if [ -n "$dest_file" ]; then
            cp -f "$stash_zip" "$dest_file"
            echo "$dest_file"
        else
            echo "$stash_zip"
        fi
        return 0
    fi

    echo "[INFO] Harvesting manifest archive for AppID $appid across multi-provider network..." >&2

    local run_dir
    run_dir="$(get_runtime_dir)"
    local dl_tmp="$run_dir/fetch_manifest_${appid}_$$.zip"
    rm -f "$dl_tmp"

    declare -a src_names src_urls src_headers
    local src_count=0

    # Source 1: ManifestHub (Official GitHub archive per AppID branch)
    src_names[src_count]="ManifestHub"
    src_urls[src_count]="https://codeload.github.com/steamtoolsapp/ManifestHub/zip/refs/heads/${appid}"
    src_headers[src_count]=""
    src_count=$((src_count + 1))

    # Source 2: Ryuu direct mirror
    src_names[src_count]="Ryuu"
    src_urls[src_count]="http://167.235.229.108/${appid}"
    src_headers[src_count]=""
    src_count=$((src_count + 1))

    # Source 3: Sushi GitHub repository (alt)
    src_names[src_count]="Sushi"
    src_urls[src_count]="https://raw.githubusercontent.com/sushi-dev55-alt/sushitools-games-repo-alt/refs/heads/main/${appid}.zip"
    src_headers[src_count]=""
    src_count=$((src_count + 1))

    # Source 4: Sushi GitHub repository (main)
    src_names[src_count]="SushiMain"
    src_urls[src_count]="https://raw.githubusercontent.com/sushi-dev55/sushitools-games-repo/main/${appid}.zip"
    src_headers[src_count]=""
    src_count=$((src_count + 1))

    # Source 5: Lua.tools managed API (if auth session exists)
    local token
    token=$(get_valid_luatools_token 2>/dev/null || true)
    if [ -n "$token" ]; then
        src_names[src_count]="LuaTools"
        src_urls[src_count]="https://lua.tools/api/manifest/download?appid=${appid}&source=Luie"
        src_headers[src_count]="Authorization: Bearer $token"
        src_count=$((src_count + 1))
    fi

    local found=0
    for ((i=0; i<src_count; i++)); do
        local name="${src_names[i]}"
        local url="${src_urls[i]}"
        local hdr="${src_headers[i]}"

        if [ "$pref_source" != "auto" ] && [ "${pref_source,,}" != "${name,,}" ]; then
            continue
        fi

        echo "[INFO] Querying provider: $name ($url)..." >&2
        local curl_args=("-sSL" "--connect-timeout" "5" "--max-time" "25" "-A" "discord(dot)gg/luatools" "-o" "$dl_tmp" "-w" "%{http_code}")
        if [ -n "$hdr" ]; then
            curl_args+=("-H" "$hdr")
        fi

        local http_code
        http_code=$(curl "${curl_args[@]}" "$url" 2>/dev/null || echo "000")

        if [ "$http_code" = "200" ] && [ -s "$dl_tmp" ]; then
            # Format adaptation: If payload is a raw Lua script, encapsulate into standardized ZIP
            if ! unzip -tq "$dl_tmp" >/dev/null 2>&1 && is_valid_lua_manifest "$dl_tmp" "$appid"; then
                local stage_lua="$run_dir/${appid}.lua"
                cp -f "$dl_tmp" "$stage_lua"
                local zip_tmp="$run_dir/wrap_${appid}_$$.zip"
                (cd "$run_dir" && zip -q -0 "$zip_tmp" "${appid}.lua") 2>/dev/null || true
                rm -f "$stage_lua"
                if [ -f "$zip_tmp" ]; then
                    mv -f "$zip_tmp" "$dl_tmp"
                fi
            fi

            if validate_manifest_zip "$dl_tmp" "$appid"; then
                echo "[VERIFIED] Manifest archive acquired from $name." >&2
                cp -f "$dl_tmp" "$cached_zip"
                if [ -n "$dest_file" ]; then
                    cp -f "$dl_tmp" "$dest_file"
                    echo "$dest_file"
                else
                    echo "$cached_zip"
                fi
                found=1
                rm -f "$dl_tmp"
                break
            else
                echo "[WARN] Provider $name returned corrupt or invalid manifest zip." >&2
                rm -f "$dl_tmp"
            fi
        else
            echo "[INFO] Provider $name returned HTTP $http_code." >&2
            rm -f "$dl_tmp"
        fi
    done

    if [ "$found" -eq 1 ]; then
        return 0
    else
        echo "[ERROR] Manifest archive for AppID $appid not found across available providers." >&2
        return 1
    fi
}

# Harvest and integrate additional DLC manifest archives for an AppID into stage directory
harvest_dlc_manifests() {
    local base_appid="$1"
    local stage_dir="$2"
    local source="${3:-auto}"
    [ -d "$stage_dir" ] || return 0

    local lua_file="$stage_dir/${base_appid}.lua"
    if [ ! -f "$lua_file" ]; then
        shopt -s nullglob globstar
        local found_luas=("$stage_dir"/**/"${base_appid}.lua" "$stage_dir"/**/*.lua "$stage_dir"/*.lua)
        shopt -u nullglob globstar
        [ ${#found_luas[@]} -gt 0 ] && lua_file="${found_luas[0]}"
    fi
    [ -f "$lua_file" ] || return 0

    # Discover candidate DLC AppIDs from addappid(<id>)
    local dlc_appids=()
    while read -r cand_id; do
        [ -n "$cand_id" ] || continue
        [ "$cand_id" = "$base_appid" ] && continue
        dlc_appids+=("$cand_id")
    done < <(grep -E '^[[:space:]]*addappid\([[:space:]]*[0-9]+[[:space:]]*\)' "$lua_file" 2>/dev/null | sed -E 's/.*addappid\([[:space:]]*([0-9]+).*/\1/')

    if [ ${#dlc_appids[@]} -eq 0 ]; then
        return 0
    fi

    echo "[INFO] Discovered ${#dlc_appids[@]} candidate DLC AppID(s) in Lua manifest: ${dlc_appids[*]}" >&2

    local harvested=0
    for dlc_id in "${dlc_appids[@]}"; do
        # Avoid re-harvesting if already staged
        shopt -s nullglob globstar
        local existing_dlc_lua=("$stage_dir"/**/"${dlc_id}.lua" "$stage_dir"/*"${dlc_id}.lua")
        shopt -u nullglob globstar
        if [ ${#existing_dlc_lua[@]} -gt 0 ]; then
            continue
        fi

        local dlc_zip
        dlc_zip=$(fetch_manifest "$dlc_id" "" "$source" 2>/dev/null || true)
        if [ -n "$dlc_zip" ] && [ -f "$dlc_zip" ] && validate_manifest_zip "$dlc_zip" "$dlc_id"; then
            if unzip -qo "$dlc_zip" -d "$stage_dir" 2>/dev/null; then
                echo "  [INFO] Successfully integrated DLC manifest archive: AppID $dlc_id" >&2
                harvested=$((harvested + 1))
            fi
        fi
    done

    if [ "$harvested" -gt 0 ]; then
        echo "[VERIFIED] Integrated $harvested additional DLC manifest archive(s) into stage directory." >&2
    fi
    return 0
}

# Deploy manifest archive into SLSsteam manifests, stplug-in Lua, and config.yaml
deploy_sls_manifest() {
    local appid="$1"
    local manifest_zip="${2:-}"
    local title="${3:-}"
    local source="${4:-auto}"

    # Strip ANSI escape sequences
    appid=$(strip_ansi "$appid" | tr -dc "0-9")
    title=$(strip_ansi "$title")

    if [ -z "$appid" ]; then
        echo "[ERROR] deploy_sls_manifest: Invalid numeric AppID." >&2
        return 1
    fi

    # 1. Acquire manifest archive if not provided
    if [ -z "$manifest_zip" ] || [ ! -f "$manifest_zip" ]; then
        echo "[INFO] Manifest archive not provided. Attempting automatic harvest (source: $source)..." >&2
        manifest_zip=$(fetch_manifest "$appid" "" "$source" 2>/dev/null || true)
        if [ -z "$manifest_zip" ] || [ ! -f "$manifest_zip" ]; then
            echo "[ERROR] Could not acquire manifest archive for AppID $appid." >&2
            return 1
        fi
    fi

    if ! validate_manifest_zip "$manifest_zip" "$appid"; then
        echo "[ERROR] Manifest zip validation failed: $manifest_zip" >&2
        return 1
    fi

    local run_dir
    run_dir="$(get_runtime_dir)"
    local stage_dir="$run_dir/sls_deploy_${appid}_$$"
    mkdir -p -m 700 "$stage_dir"
    trap 'rm -rf "$stage_dir" 2>/dev/null || true' RETURN

    if ! unzip -q "$manifest_zip" -d "$stage_dir" 2>/dev/null; then
        echo "[ERROR] Failed to unpack manifest archive: $manifest_zip" >&2
        return 1
    fi

    local sls_mf_dir
    sls_mf_dir="$(get_sls_manifests_dir 2>/dev/null || echo "$HOME/.config/SLSsteam/manifests")"
    local steam_depot_dir
    steam_depot_dir="$(get_steam_depotcache_dir 2>/dev/null || echo "$HOME/.local/share/Steam/depotcache")"
    local stplug_dir
    stplug_dir="$(get_steam_stplug_in_dir 2>/dev/null || echo "$HOME/.local/share/Steam/config/stplug-in")"

    mkdir -p -m 700 "$sls_mf_dir" "$steam_depot_dir" "$stplug_dir"

    local manifest_count=0
    declare -A pinned_depots=()

    # 2. Process and deploy binary manifests
    shopt -s nullglob globstar
    local mf_files=("$stage_dir"/**/*.manifest "$stage_dir"/*.manifest)
    declare -A seen_mf=()
    for mf in "${mf_files[@]}"; do
        [ -f "$mf" ] || continue
        local mf_name
        mf_name="$(basename "$mf")"
        [[ -v seen_mf["$mf_name"] ]] && continue
        seen_mf["$mf_name"]=1

        if manifest_has_payload_magic "$mf"; then
            cp -f "$mf" "$sls_mf_dir/$mf_name"
            chmod 600 "$sls_mf_dir/$mf_name"

            # Mirror to Steam internal depotcache
            cp -f "$mf" "$steam_depot_dir/$mf_name"
            chmod 600 "$steam_depot_dir/$mf_name"

            # Parse depot and GID from <depot>_<gid>.manifest
            if [[ "$mf_name" =~ ^([0-9]+)_([0-9]+)\.manifest$ ]]; then
                local depot_id="${BASH_REMATCH[1]}"
                local gid="${BASH_REMATCH[2]}"
                echo "$gid" > "$sls_mf_dir/.preferred_${depot_id}"
                chmod 600 "$sls_mf_dir/.preferred_${depot_id}"
                pinned_depots["$depot_id"]="$gid"
            fi
            manifest_count=$((manifest_count + 1))
        fi
    done
    shopt -u nullglob globstar

    # 3. Extract or synthesize stplug-in Lua script
    local target_lua="$stplug_dir/${appid}.lua"
    local staged_lua=""
    if [ -f "$stage_dir/${appid}.lua" ]; then
        staged_lua="$stage_dir/${appid}.lua"
    else
        shopt -s nullglob globstar
        local app_luas=("$stage_dir"/**/"${appid}.lua")
        if [ "${#app_luas[@]}" -gt 0 ]; then
            staged_lua="${app_luas[0]}"
        else
            local candidate_luas=("$stage_dir"/**/*.lua "$stage_dir"/*.lua)
            if [ "${#candidate_luas[@]}" -eq 1 ]; then
                staged_lua="${candidate_luas[0]}"
            fi
        fi
        shopt -u nullglob globstar
    fi

    if [ -n "$staged_lua" ] && [ -f "$staged_lua" ]; then
        cp -f "$staged_lua" "$target_lua"
        if ! grep -Eq "^[[:space:]]*addappid[[:space:]]*\([[:space:]]*${appid}[[:space:]]*\)" "$target_lua"; then
            sed -i "1i addappid(${appid})" "$target_lua"
        fi
        chmod 600 "$target_lua"
        echo "[VERIFIED] Stplug-in Lua deployed from archive: $target_lua" >&2
    else
        echo "[INFO] Synthesizing stplug-in Lua script for AppID $appid..." >&2
        local synth_lua="addappid($appid)\n"
        for d_id in "${!pinned_depots[@]}"; do
            synth_lua+="addappid($d_id)\n"
        done
        printf "%b" "$synth_lua" > "$target_lua"
        chmod 600 "$target_lua"
        echo "[VERIFIED] Synthesized stplug-in Lua: $target_lua" >&2
    fi

    # 4. Synchronize entitlement in SLSsteam config.yaml (skipping ACF creation)
    sync_steam "$appid" "$title" "--no-acf"

    echo "[VERIFIED] SLSsteam deployment complete for AppID $appid ($manifest_count manifest(s) linked)." >&2
    return 0
}

# Resolve path to standalone Steam CDN depot downloader binary (gamectl-depot-dl)
resolve_depot_dl_bin() {
    if [ -n "${GAMECTL_DEPOT_DL_BIN:-}" ] && [ -x "$GAMECTL_DEPOT_DL_BIN" ]; then
        echo "$GAMECTL_DEPOT_DL_BIN"
        return 0
    fi
    local candidate
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd 2>/dev/null || echo "")"
    for candidate in \
        "$script_dir/gamectl-depot-dl" \
        "$script_dir/../../bin/gamectl-depot-dl" \
        "$script_dir/../bin/gamectl-depot-dl" \
        "$script_dir/bin/gamectl-depot-dl" \
        "$HOME/.local/bin/gamectl-depot-dl" \
        "/usr/local/bin/gamectl-depot-dl" \
        "/usr/bin/gamectl-depot-dl"; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    if command -v gamectl-depot-dl >/dev/null 2>&1; then
        command -v gamectl-depot-dl
        return 0
    fi
    return 1
}

# Ensure Steam CDN depot downloader runtime is available
ensure_downloader() {
    if resolve_depot_dl_bin >/dev/null 2>&1; then
        return 0
    fi
    echo "[WARN] Standalone depot downloader binary (gamectl-depot-dl) not found." >&2
    return 1
}

# Resolve optimal destination directory based on configured libraries and available disk space
resolve_target_library_dir() {
    local safe_title="${1:-game}"
    local candidate_dirs=()

    # 0. Primary sovereign library override
    if [ -n "${GAMECTL_LIBRARY_DIR:-}" ]; then
        candidate_dirs+=("$GAMECTL_LIBRARY_DIR")
    elif [ -f "$HOME/.config/gamectl/library_dir" ]; then
        local p_lib
        p_lib=$(head -n 1 "$HOME/.config/gamectl/library_dir" 2>/dev/null | tr -d '\r\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -n "$p_lib" ] && candidate_dirs+=("${p_lib/#\~/$HOME}")
    fi

    # 1. Custom libraries from config
    local cfg_libs="$HOME/.config/gamectl/libraries"
    if [ -f "$cfg_libs" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line#"${line%%[![:space:]]*}"}" # trim leading
            line="${line%"${line##*[![:space:]]}"}" # trim trailing
            [ -z "$line" ] && continue
            [[ "$line" =~ ^# ]] && continue
            candidate_dirs+=("${line/#\~/$HOME}")
        done < "$cfg_libs"
    fi

    # 2. Extra libraries from environment
    if [ -n "${GAMECTL_LIBRARY_DIRS:-}" ]; then
        local extra_dirs=()
        IFS=":" read -r -a extra_dirs <<< "$GAMECTL_LIBRARY_DIRS"
        candidate_dirs+=("${extra_dirs[@]}")
    fi

    # 3. Default fallback directory
    candidate_dirs+=("$HOME/Games")

    local best_dir="$HOME/Games"
    local max_free=0
    declare -A seen_candidates=()

    for d in "${candidate_dirs[@]}"; do
        [ -n "$d" ] || continue
        [[ -v seen_candidates["$d"] ]] && continue
        seen_candidates["$d"]=1

        # If dir doesn't exist yet, probe parent dir
        local probe_target="$d"
        while [ ! -d "$probe_target" ] && [ "$probe_target" != "/" ] && [ "$probe_target" != "." ]; do
            probe_target="$(dirname "$probe_target")"
        done

        if [ -d "$probe_target" ]; then
            local free_space
            free_space=$(df -PB 1M "$probe_target" 2>/dev/null | awk 'NR==2 {print $4}' || echo "0")
            if [[ "$free_space" =~ ^[0-9]+$ ]] && [ "$free_space" -gt "$max_free" ]; then
                max_free="$free_space"
                best_dir="$d"
            fi
        fi
    done

    echo "$best_dir/$safe_title"
}

# Detect primary OS platform for AppID via Steam API (returns "windows" or "linux")
detect_app_platform_os() {
    local appid="${1:-}"
    [ -z "$appid" ] && echo "linux" && return 0

    local det_json
    det_json=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=platforms" "steam_platforms_${appid}" 3600 2>/dev/null || true)
    local is_linux is_win
    is_linux=$(echo "$det_json" | jq -r ".\"${appid}\".data.platforms.linux // false" 2>/dev/null || echo "false")
    is_win=$(echo "$det_json" | jq -r ".\"${appid}\".data.platforms.windows // false" 2>/dev/null || echo "false")
    if [ "$is_linux" != "true" ] && [ "$is_win" = "true" ]; then
        echo "windows"
    else
        echo "linux"
    fi
}

# Trigger Steam client native installation for AppID via URI protocol
trigger_steam_install() {
    local appid="$1"
    local uri="steam://install/${appid}"

    if [ -n "${GAMECTL_MOCK_STEAM_TRIGGER:-}" ]; then
        echo "[VERIFIED] Triggered Steam installation for AppID $appid (Mocked URI: $uri)."
        return 0
    fi

    if command -v steam >/dev/null 2>&1; then
        if pgrep -x steam >/dev/null 2>&1; then
            echo "[INFO] Steam client is running. Dispatching install command..."
            steam "$uri" >/dev/null 2>&1 &
            echo "[VERIFIED] Dispatched '$uri' to running Steam client."
        else
            echo "[INFO] Steam client is not running. Starting Steam client in background..."
            steam -silent "$uri" >/dev/null 2>&1 &
            echo "[VERIFIED] Launched Steam silently with install intent ($uri)."
        fi
    elif command -v flatpak >/dev/null 2>&1 && flatpak info com.valvesoftware.Steam >/dev/null 2>&1; then
        if pgrep -f com.valvesoftware.Steam >/dev/null 2>&1 || pgrep -x steam >/dev/null 2>&1; then
            echo "[INFO] Steam (Flatpak) is running. Dispatching install command..."
            flatpak run com.valvesoftware.Steam "$uri" >/dev/null 2>&1 &
            echo "[VERIFIED] Dispatched '$uri' to running Steam Flatpak client."
        else
            echo "[INFO] Steam (Flatpak) is not running. Starting Flatpak Steam in background..."
            flatpak run com.valvesoftware.Steam -silent "$uri" >/dev/null 2>&1 &
            echo "[VERIFIED] Launched Steam Flatpak silently with install intent ($uri)."
        fi
    else
        echo "[WARN] Steam executable not found on system PATH." >&2
        echo "[INFO] You can start the download manually by opening: $uri" >&2
    fi
    echo "[INFO] Monitor download progress with: gamectl downloads"
    return 0
}

# Steam Native Game Downloader & Provisioner (SLSsteam-Moon & Standalone CDN Engine)
download_game() {
    local appid="${1:-}"
    # Strip ANSI escape sequences & non-digits
    appid=$(strip_ansi "$appid" | tr -dc "0-9")
    if [ -z "$appid" ]; then
        echo "Usage: gamectl download <appid> [target_dir] [title] [--source <auto|manifesthub|ryuu|sushi|luatools>] [--raw|--inject-only|--all|--standalone|--sls]" >&2
        return 1
    fi
    shift

    local target_dir=""
    local title=""
    local action="all"          # "all", "inject", "raw"
    local source="auto"         # "auto", "ryuu", "sushi", "luatools"
    local engine="standalone"   # Default to Pure Standalone CDN engine (Zero Steam Client)
    local is_strict_standalone=false
    [ "${GAMECTL_HEADLESS:-0}" = "1" ] && is_strict_standalone=true

    while [ $# -gt 0 ]; do
        case "$1" in
            --engine)
                shift
                case "${1:-}" in
                    depot)
                        echo "[WARN] DepotDownloader is deprecated and removed. Routing to native Steam CDN engine." >&2
                        ;;
                    steam|sls)
                        engine="sls"
                        is_strict_standalone=false
                        ;;
                    standalone|direct)
                        engine="standalone"
                        is_strict_standalone=true
                        ;;
                esac
                ;;
            --engine=*)
                local eng_val="${1#--engine=}"
                case "$eng_val" in
                    depot)
                        echo "[WARN] DepotDownloader is deprecated and removed. Routing to native Steam CDN engine." >&2
                        ;;
                    steam|sls)
                        engine="sls"
                        is_strict_standalone=false
                        ;;
                    standalone|direct)
                        engine="standalone"
                        is_strict_standalone=true
                        ;;
                esac
                ;;
            --sls|--steam)
                engine="sls"
                is_strict_standalone=false
                ;;
            --direct|--no-steam|--standalone|--headless)
                engine="standalone"
                is_strict_standalone=true
                ;;
            --source)
                shift
                source="${1:-auto}"
                ;;
            --source=*)
                source="${1#--source=}"
                ;;
            --raw|--download-only|--no-inject)
                action="raw"
                ;;
            --inject-only|--no-sync)
                action="inject"
                ;;
            --all)
                action="all"
                ;;
            --foreground|-f|foreground|--background|-b|background)
                # Preserved for CLI flag backwards-compatibility
                ;;
            --os|--os=*)
                [ "$1" = "--os" ] && shift
                ;;
            *)
                if [ -z "$target_dir" ]; then
                    target_dir="$1"
                elif [ -z "$title" ]; then
                    title="$1"
                fi
                ;;
        esac
        shift
    done

    if [ -z "$title" ]; then
        title=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=basic" "steam_basic_${appid}" 3600 2>/dev/null | jq -r ".\"${appid}\".data.name // empty" 2>/dev/null || true)
        [ -z "$title" ] && title="AppID_${appid}"
    fi

    log_msg "INFO" "DOWNLOAD" "Starting download for $title (AppID: $appid, Action: $action, Source: $source)"

    # Auto-resolve engine preference
    if [ "$engine" = "auto" ]; then
        if [ "$action" = "inject" ]; then
            engine="sls"
        elif resolve_depot_dl_bin >/dev/null 2>&1; then
            engine="standalone"
        else
            engine="sls"
        fi
    fi

    # Verify standalone binary availability with graceful fallback
    if [ "$engine" = "standalone" ]; then
        local dl_bin
        dl_bin="$(resolve_depot_dl_bin 2>/dev/null || true)"
        if [ -z "$dl_bin" ] || [ ! -x "$dl_bin" ]; then
            if [ "$is_strict_standalone" = true ]; then
                echo "[ERROR] Standalone downloader binary (gamectl-depot-dl) not found." >&2
                echo "[ERROR] Compile it via 'make build-depot-dl' or run 'gamectl setup-gbe'." >&2
                log_msg "ERROR" "DOWNLOAD" "Standalone downloader binary not found in strict standalone mode"
                return 1
            fi
            echo "[WARN] Standalone downloader binary (gamectl-depot-dl) not found. Falling back to SLSsteam engine." >&2
            engine="sls"
        fi
    fi

    # Route 1: Standalone Native Steam CDN Engine (Zero Steam Client required)
    if [ "$engine" = "standalone" ]; then
        local manifest_zip
        echo "[INFO] Manifest archive not provided. Attempting automatic harvest (source: $source)..." >&2
        manifest_zip=$(fetch_manifest "$appid" "" "$source" 2>/dev/null || true)
        if [ -z "$manifest_zip" ] || [ ! -f "$manifest_zip" ]; then
            echo "[ERROR] Manifest archive for AppID $appid could not be acquired across providers." >&2
            return 1
        fi

        if ! validate_manifest_zip "$manifest_zip" "$appid"; then
            echo "[ERROR] Manifest zip validation failed: $manifest_zip" >&2
            return 1
        fi

        local run_dir
        run_dir="$(get_runtime_dir)"
        local stage_dir="$run_dir/depot_dl_${appid}_${BASHPID:-$$}"
        mkdir -p -m 700 "$stage_dir"
        trap 'rm -rf "$stage_dir" 2>/dev/null || true' RETURN

        if ! unzip -q "$manifest_zip" -d "$stage_dir" 2>/dev/null; then
            echo "[ERROR] Failed to unpack manifest archive: $manifest_zip" >&2
            return 1
        fi

        # Integrate any physical DLC manifest archives
        harvest_dlc_manifests "$appid" "$stage_dir" "$source" 2>/dev/null || true

        declare -A depot_keys=()
        shopt -s nullglob globstar
        local cand_luas=("$stage_dir"/**/*.lua "$stage_dir"/*.lua)
        shopt -u nullglob globstar
        local re_key='addappid\([[:space:]]*([0-9]+)[[:space:]]*,[[:space:]]*[0-9]+[[:space:]]*,[[:space:]]*['\''"]([0-9a-fA-F]{64})['\''"]'
        declare -A seen_lua=()
        for clua in "${cand_luas[@]}"; do
            [ -f "$clua" ] || continue
            [[ -v seen_lua["$clua"] ]] && continue
            seen_lua["$clua"]=1
            while IFS= read -r line || [ -n "$line" ]; do
                if [[ "$line" =~ $re_key ]]; then
                    depot_keys["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
                fi
            done < "$clua"
        done

        local depot_args=()
        shopt -s nullglob globstar
        local mf_files=("$stage_dir"/**/*.manifest "$stage_dir"/*.manifest)
        declare -A seen_mf=()
        for mf in "${mf_files[@]}"; do
            [ -f "$mf" ] || continue
            local mf_name="$(basename "$mf")"
            [[ -v seen_mf["$mf_name"] ]] && continue
            seen_mf["$mf_name"]=1

            if manifest_has_payload_magic "$mf"; then
                if [[ "$mf_name" =~ ^([0-9]+)_([0-9]+)\.manifest$ ]]; then
                    local did="${BASH_REMATCH[1]}"
                    local key="${depot_keys["$did"]:-}"
                    if [ -n "$key" ]; then
                        depot_args+=(--depot "$mf:$key")
                    else
                        echo "[WARN] No AES decryption key found for depot $did ($mf_name). Skipping." >&2
                    fi
                fi
            fi
        done
        shopt -u nullglob globstar

        if [ "${#depot_args[@]}" -eq 0 ]; then
            if [ "$is_strict_standalone" = true ]; then
                echo "[ERROR] Strict standalone mode: No encrypted manifests with valid AES keys found for AppID $appid." >&2
                echo "[ERROR] Cannot fallback to Steam Client/SLSsteam in standalone mode (ADR-022)." >&2
                log_msg "ERROR" "DOWNLOAD" "No valid AES depot keys found for AppID $appid in strict standalone mode"
                return 1
            fi
            echo "[WARN] No encrypted manifests with valid AES keys found. Falling back to SLSsteam engine." >&2
            engine="sls"
        else
            if [ -z "$target_dir" ]; then
                target_dir="$(resolve_standalone_library_dir "$title")"
            fi
            mkdir -p "$target_dir"

            echo "=========================================="
            echo " STEAM STANDALONE CDN ENGINE (gamectl-depot-dl)"
            echo "=========================================="
            echo " AppID      : $appid"
            echo " Title      : $title"
            echo " Target Dir : $target_dir"
            echo " Depots     : $(( ${#depot_args[@]} / 2 ))"
            echo " Engine     : Native Rust Standalone (Zero Steam Client)"
            echo "=========================================="

            local cur_pid="${BASHPID:-$$}"
            cat <<EOF > "$stage_dir/status.info"
APPID=$appid
TITLE=$title
TARGET_DIR=$target_dir
PID=$cur_pid
START_TIME=$(date +%s)
LOG_FILE=$stage_dir/download.log
ENGINE=standalone
STATUS=DOWNLOADING
EOF

            local dl_bin dl_log="$stage_dir/download.log" dl_rc=0
            dl_bin="$(resolve_depot_dl_bin)"
            "$dl_bin" --app "$appid" --dir "$target_dir" "${depot_args[@]}" 2>&1 | tee "$dl_log" || dl_rc=${PIPESTATUS[0]}
            if [ "$dl_rc" -ne 0 ]; then
                echo "STATUS=FAILED" >> "$stage_dir/status.info"
                echo "[ERROR] Standalone CDN download failed (exit code $dl_rc)." >&2
                return 1
            fi
            echo "STATUS=COMPLETED" >> "$stage_dir/status.info"

            # Preserve staged lua manifests in target_dir for offline DLC discovery
            shopt -s nullglob globstar
            for l in "$stage_dir"/**/*.lua "$stage_dir"/*.lua; do
                [ -f "$l" ] && cp -f "$l" "$target_dir/" 2>/dev/null || true
            done
            shopt -u nullglob globstar

            if [ "$action" != "raw" ]; then
                fetch_dlc "$target_dir" "$appid" 2>/dev/null || true
                inject_game "$target_dir" "$appid" --no-sync 2>/dev/null || true
            fi

            invalidate_scan_cache
            echo "[SUCCESS] Standalone download & provisioning complete for $title ($appid) in $target_dir."
            log_msg "INFO" "DOWNLOAD" "Standalone download & provisioning complete for $title ($appid) in $target_dir"
            return 0
        fi
    fi

    # Route 2: SLSsteam Native Content Engine (Steam Client URI install)
    echo "=========================================="
    echo " STEAM NATIVE CONTENT ENGINE (SLSsteam-Moon)"
    echo "=========================================="
    echo " AppID      : $appid"
    echo " Title      : $title"
    echo " Engine     : SLSsteam (Valve High-Speed CDN)"
    echo " Source     : $source"
    echo " Mode       : $action"
    echo "=========================================="

    if deploy_sls_manifest "$appid" "" "$title" "$source"; then
        invalidate_scan_cache
        echo "[SUCCESS] SLSsteam manifests and stplug-in keys provisioned for $title ($appid)."
        log_msg "INFO" "DOWNLOAD" "SLSsteam manifests and stplug-in keys provisioned for $title ($appid)"
        if [ "$action" != "inject" ]; then
            trigger_steam_install "$appid"
        fi
        return 0
    else
        echo "[ERROR] Manifest archive and keys for AppID $appid could not be acquired across providers." >&2
        log_msg "ERROR" "DOWNLOAD" "Manifest archive and keys for AppID $appid could not be acquired across providers"
        return 1
    fi
}
# Locate appmanifest_<appid>.acf across primary and secondary libraries
find_app_acf() {
    local appid="$1"
    [ -z "$appid" ] && return 1

    local primary_apps
    primary_apps="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"
    if [ -f "$primary_apps/appmanifest_${appid}.acf" ]; then
        echo "$primary_apps/appmanifest_${appid}.acf"
        return 0
    fi

    local lib
    while IFS= read -r lib; do
        [ -d "$lib" ] || continue
        if [ -f "$lib/appmanifest_${appid}.acf" ]; then
            echo "$lib/appmanifest_${appid}.acf"
            return 0
        fi
        if [ -f "$lib/steamapps/appmanifest_${appid}.acf" ]; then
            echo "$lib/steamapps/appmanifest_${appid}.acf"
            return 0
        fi
    done < <(get_steam_libraries 2>/dev/null || true)

    return 1
}

# Format byte integer into readable B, KB, MB, GB representation
format_bytes() {
    local b="${1:-0}"
    if [ "$b" -ge 1073741824 ] 2>/dev/null; then
        local gb=$(( b / 1073741824 ))
        local rem=$(( (b % 1073741824) / 104857600 ))
        echo "${gb}.${rem} GB"
    elif [ "$b" -ge 1048576 ] 2>/dev/null; then
        local mb=$(( b / 1048576 ))
        echo "${mb} MB"
    elif [ "$b" -ge 1024 ] 2>/dev/null; then
        local kb=$(( b / 1024 ))
        echo "${kb} KB"
    else
        echo "${b} B"
    fi
}

# Parse Steam appmanifest ACF file for download progress, state, and byte metrics
parse_acf_download_state() {
    local target="$1"
    local acf_file=""
    local appid=""

    if [ -f "$target" ]; then
        acf_file="$target"
    else
        appid=$(strip_ansi "$target" | tr -dc "0-9")
        [ -z "$appid" ] && return 1
        acf_file=$(find_app_acf "$appid" 2>/dev/null || true)
    fi

    if [ -z "$acf_file" ] || [ ! -f "$acf_file" ]; then
        return 1
    fi

    local name="" state_flags="0" bytes_dl="0" bytes_total="0" installdir=""
    local re_appid='^[[:space:]]*"appid"[[:space:]]+"([0-9]+)"'
    local re_name='^[[:space:]]*"name"[[:space:]]+"([^"]+)"'
    local re_flags='^[[:space:]]*"StateFlags"[[:space:]]+"([0-9]+)"'
    local re_bytes_dl='^[[:space:]]*"BytesDownloaded"[[:space:]]+"([0-9]+)"'
    local re_bytes_total='^[[:space:]]*"BytesToDownload"[[:space:]]+"([0-9]+)"'
    local re_installdir='^[[:space:]]*"installdir"[[:space:]]+"([^"]+)"'

    while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" =~ $re_appid ]] && [ -z "$appid" ]; then
            appid="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ $re_name ]] && [ -z "$name" ]; then
            name="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ $re_flags ]]; then
            state_flags="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ $re_bytes_dl ]]; then
            bytes_dl="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ $re_bytes_total ]]; then
            bytes_total="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ $re_installdir ]] && [ -z "$installdir" ]; then
            installdir="${BASH_REMATCH[1]}"
        fi
    done < "$acf_file"

    [ -z "$appid" ] && return 1

    local status_str="[UNKNOWN]"
    if [ "$state_flags" -eq 4 ]; then
        status_str="[INSTALLED]"
    elif [ "$state_flags" -eq 512 ] || [ "$state_flags" -eq 514 ] || (( (state_flags & 512) != 0 )); then
        status_str="[PAUSED]"
    elif [ "$state_flags" -eq 1024 ] || [ "$state_flags" -eq 1026 ] || (( (state_flags & 1024) != 0 )); then
        status_str="[DOWNLOADING]"
    elif [ "$state_flags" -eq 2 ] || (( (state_flags & 2) != 0 )); then
        status_str="[UPDATE REQUIRED]"
    fi

    local pct="0%"
    if [ "$bytes_total" -gt 0 ] 2>/dev/null; then
        local calc_pct=$(( (bytes_dl * 100) / bytes_total ))
        [ "$calc_pct" -gt 100 ] && calc_pct=100
        pct="${calc_pct}%"
    elif [ "$state_flags" -eq 4 ]; then
        pct="100%"
    fi

    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
        "$appid" "$name" "$status_str" "$pct" "$bytes_dl" "$bytes_total" "$state_flags" "$installdir" "$acf_file"
}

# List active and recent downloads
list_downloads() {
    echo "=========================================="
    echo " GAMECTL DOWNLOAD STATUS (Unified Engine)"
    echo "=========================================="
    local count=0

    # Inspect Steam Native ACF downloads
    local steam_apps
    steam_apps="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"
    shopt -s nullglob
    local acf_files=("$steam_apps"/appmanifest_*.acf)
    shopt -u nullglob

    for acf in "${acf_files[@]}"; do
        local state_data
        state_data=$(parse_acf_download_state "$acf" 2>/dev/null || true)
        [ -z "$state_data" ] && continue

        local a_id a_title a_status a_pct a_dl a_total a_flags a_dir a_path
        IFS=$'\t' read -r a_id a_title a_status a_pct a_dl a_total a_flags a_dir a_path <<< "$state_data"

        # Only display active downloads or paused/updating apps in download status
        if [ "$a_status" = "[DOWNLOADING]" ] || [ "$a_status" = "[PAUSED]" ] || [ "$a_status" = "[UPDATE REQUIRED]" ]; then
            count=$((count + 1))
            local dl_fmt tot_fmt
            dl_fmt=$(format_bytes "$a_dl")
            tot_fmt=$(format_bytes "$a_total")
            echo "$a_status AppID: $a_id | $a_title | Progress: $a_pct ($dl_fmt / $tot_fmt) [Steam Engine]"
            echo "------------------------------------------"
        fi
    done

    # Inspect Standalone CDN downloads
    local run_dir
    run_dir="$(get_runtime_dir)"
    shopt -s nullglob
    for st_dir in "$run_dir"/depot_dl_*; do
        [ -d "$st_dir" ] || continue
        local base_st="${st_dir##*/}"
        local st_pid="${base_st##*_}"
        local rest_st="${base_st#depot_dl_}"
        local st_appid="${rest_st%_*}"
        [ -z "$st_appid" ] || [ -z "$st_pid" ] && continue

        # Self-healing: purge orphaned staging dir if downloader process is dead
        if ! [[ "$st_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$st_pid" 2>/dev/null; then
            rm -rf "$st_dir" 2>/dev/null || true
            continue
        fi

        local st_info="$st_dir/status.info"
        local st_title="Native CDN Download"
        local st_log="$st_dir/download.log"
        if [ -f "$st_info" ]; then
            local info_title info_log
            info_title=$(grep -E '^TITLE=' "$st_info" | cut -d= -f2- || true)
            info_log=$(grep -E '^LOG_FILE=' "$st_info" | cut -d= -f2- || true)
            [ -n "$info_title" ] && st_title="$info_title"
            [ -n "$info_log" ] && [ -f "$info_log" ] && st_log="$info_log"
        fi

        local prog_data st_pct st_bytes st_state
        prog_data=$(get_depot_dl_progress "$st_log" "$st_pid")
        IFS=$'\t' read -r st_pct st_bytes st_state <<< "$prog_data"

        count=$((count + 1))
        local dl_label="Engine: Standalone CDN"
        if [ -n "$st_bytes" ] && [ "$st_bytes" != "0 MB / 0 MB" ]; then
            echo "$st_state AppID: $st_appid | $st_title | Progress: $st_pct ($st_bytes) | $dl_label"
        else
            echo "$st_state AppID: $st_appid | $st_title | Progress: $st_pct | $dl_label"
        fi
        echo "------------------------------------------"
    done
    shopt -u nullglob

    if [ $count -eq 0 ]; then
        echo "[INFO] No active download tasks in Steam or Standalone engine."
    fi
}

# Helper: Parse structured download telemetry from depot-dl logs
get_depot_dl_progress() {
    local log_file="$1"
    local pid="${2:-}"

    if [ ! -f "$log_file" ]; then
        printf "0%%\t0 MB / 0 MB\t[STARTING]\n"
        return 0
    fi

    local parsed
    parsed=$(awk '
    /^\[DEPOT_START\]/ {
        for (i=1; i<=NF; i++) {
            if ($i ~ /^\([0-9.]+$/) {
                tot += substr($i, 2);
            }
        }
    }
    /^\[PROGRESS\] Transferred:/ {
        dl = $3;
    }
    /^\[SUCCESS\]/ {
        done = 1;
    }
    /^\[ERROR\]/ {
        err = 1;
    }
    END {
        if (done) {
            printf "100%%\t%.2f MB / %.2f MB\t[COMPLETED]\n", dl ? dl : tot, tot ? tot : dl;
        } else if (err && !dl) {
            printf "0%%\t0 MB / 0 MB\t[FAILED]\n";
        } else if (tot > 0 && dl > 0) {
            pct = int((dl / tot) * 100);
            if (pct > 100) pct = 100;
            printf "%d%%\t%.2f MB / %.2f MB\t[DOWNLOADING]\n", pct, dl, tot;
        } else if (tot > 0) {
            printf "0%%\t0 MB / %.2f MB\t[STARTING]\n", tot;
        } else if (dl > 0) {
            printf "0%%\t%.2f MB transferred\t[DOWNLOADING]\n", dl;
        } else {
            printf "0%%\t0 MB / 0 MB\t[STARTING]\n";
        }
    }' "$log_file")

    local pct bytes_info state_label
    IFS=$'\t' read -r pct bytes_info state_label <<< "$parsed"

    # Check process state for SIGSTOP pause
    if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
        local proc_state
        proc_state=$(awk '/^State:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true)
        if [[ "$proc_state" =~ ^[Tt] ]]; then
            state_label="[PAUSED]"
        fi
    fi

    printf "%s\t%s\t%s\n" "$pct" "$bytes_info" "$state_label"
}

# Dedicated Download Telemetry & ACF Preview Handler
preview_download() {
    local appid="${1:-}"
    local engine="${2:-}"
    local ref_path="${3:-}"

    appid=$(strip_ansi "$appid" | tr -d '[:space:]')
    engine=$(strip_ansi "$engine" | tr -d '[:space:]')
    ref_path=$(strip_ansi "$ref_path" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    if [ -z "$appid" ] || [ "$appid" = "0" ] || [ -z "$ref_path" ]; then
        printf "%s╭─ DOWNLOAD TELEMETRY MONITOR ────────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        printf "│ %sNo Active Download Selected%s\n" "${UI_DIM}" "${UI_RST}"
        printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
        printf "  %sNo active download telemetry or reference available in queue.%s\n" "${UI_DIM}" "${UI_RST}"
        return 0
    fi

    if [ -d "$ref_path" ]; then
        # Standalone Staging Directory
        local title="Unknown Title" target_dir="Not configured" pid="Unknown" start_time="" log_file="$ref_path/download.log" status="DOWNLOADING"
        if [ -f "$ref_path/status.info" ]; then
            local k v
            while IFS='=' read -r k v || [ -n "$k" ]; do
                case "$k" in
                    TITLE) title="$v" ;;
                    TARGET_DIR) target_dir="$v" ;;
                    PID) pid="$v" ;;
                    START_TIME) start_time="$v" ;;
                    LOG_FILE) [ -n "$v" ] && log_file="$v" ;;
                    STATUS) status="$v" ;;
                esac
            done < "$ref_path/status.info"
        fi

        local pid_status="${UI_RED}[TERMINATED]${UI_RST}"
        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
            local p_stat
            p_stat=$(awk '/^State:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true)
            if [[ "$p_stat" =~ ^[Tt] ]]; then
                pid_status="${UI_PURPLE}[PAUSED (SIGSTOP)]${UI_RST}"
            else
                pid_status="${UI_GREEN}[RUNNING (PID $pid)]${UI_RST}"
            fi
        fi

        local elapsed_str="N/A"
        if [ -n "$start_time" ] && [[ "$start_time" =~ ^[0-9]+$ ]]; then
            local now_ts elapsed
            now_ts=$(date +%s)
            elapsed=$(( now_ts - start_time ))
            if [ "$elapsed" -ge 0 ]; then
                local mins=$(( elapsed / 60 ))
                local secs=$(( elapsed % 60 ))
                elapsed_str="${mins}m ${secs}s"
            fi
        fi

        local prog_data st_pct st_bytes st_state
        prog_data=$(get_depot_dl_progress "$log_file" "$pid")
        IFS=$'\t' read -r st_pct st_bytes st_state <<< "$prog_data"

        printf "%s╭─ STANDALONE CDN DOWNLOAD TELEMETRY ────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        printf "│ %s%s%s %s(AppID: %s)%s\n" "${UI_BOLD}" "$title" "${UI_RST}" "${UI_DIM}" "$appid" "${UI_RST}"
        printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
        printf "  %sEngine%s        : %s\n" "${UI_CYAN}" "${UI_RST}" "Native Rust gamectl-depot-dl (Valve CDN)"
        printf "  %sProcess State%s : %s\n" "${UI_CYAN}" "${UI_RST}" "$pid_status"
        printf "  %sProgress%s      : %s%s%s (%s)\n" "${UI_CYAN}" "${UI_RST}" "${UI_BOLD}" "$st_pct" "${UI_RST}" "$st_bytes"
        printf "  %sElapsed Time%s  : %s\n" "${UI_CYAN}" "${UI_RST}" "$elapsed_str"
        printf "  %sTarget Dir%s    : %s\n" "${UI_CYAN}" "${UI_RST}" "$target_dir"
        printf "  %sStaging Dir%s   : %s\n" "${UI_CYAN}" "${UI_RST}" "$ref_path"
        printf "\n"
        printf "%s╭─ RECENT DOWNLOAD LOG (tail -n 12) ──────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        if [ -f "$log_file" ]; then
            tail -n 12 "$log_file"
        else
            printf "%s(No log file generated yet)%s\n" "${UI_DIM}" "${UI_RST}"
        fi
        return 0
    fi

    if [ -f "$ref_path" ]; then
        # Steam ACF Manifest
        local state_data
        state_data=$(parse_acf_download_state "$ref_path" 2>/dev/null || true)
        if [ -n "$state_data" ]; then
            local a_id a_name a_status a_pct a_dl a_tot a_flags a_dir a_path
            IFS=$'\t' read -r a_id a_name a_status a_pct a_dl a_tot a_flags a_dir a_path <<< "$state_data"
            local dl_fmt tot_fmt
            dl_fmt=$(format_bytes "$a_dl")
            tot_fmt=$(format_bytes "$a_tot")
            local install_path="$(dirname "$ref_path")/common/$a_dir"

            printf "%s╭─ STEAM CLIENT DOWNLOAD TELEMETRY ───────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
            printf "│ %s%s%s %s(AppID: %s)%s\n" "${UI_BOLD}" "$a_name" "${UI_RST}" "${UI_DIM}" "$a_id" "${UI_RST}"
            printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
            printf "  %sEngine%s        : %s\n" "${UI_CYAN}" "${UI_RST}" "Steam Client (ACF Manifest Engine)"
            printf "  %sStatus%s        : %s\n" "${UI_CYAN}" "${UI_RST}" "$a_status"
            printf "  %sProgress%s      : %s%s%s (%s / %s)\n" "${UI_CYAN}" "${UI_RST}" "${UI_BOLD}" "$a_pct" "${UI_RST}" "$dl_fmt" "$tot_fmt"
            printf "  %sStateFlags%s    : %s\n" "${UI_CYAN}" "${UI_RST}" "$a_flags"
            printf "  %sInstall Dir%s   : %s\n" "${UI_CYAN}" "${UI_RST}" "$install_path"
            printf "  %sManifest File%s : %s\n" "${UI_CYAN}" "${UI_RST}" "$ref_path"
            printf "\n"
            printf "%s╭─ MANIFEST CONFIGURATION (VDF) ──────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
            grep -E '"(appid|name|StateFlags|BytesDownloaded|BytesToDownload|installdir|buildid|LastOwner)"' "$ref_path" 2>/dev/null || true
            return 0
        fi
    fi

    printf "%s╭─ DOWNLOAD TELEMETRY MONITOR ────────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
    printf "│ %sReference: %s%s\n" "${UI_DIM}" "$ref_path" "${UI_RST}"
    printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
    printf "  No active download telemetry or reference available for this target.\n"
}

# Interactive Download Monitor TUI
list_downloads_interactive() {
    local run_dir
    run_dir="$(get_runtime_dir)"
    while true; do
        local entries=""
        local total_items=0

        # Scan Steam ACF entries
        local steam_apps
        steam_apps="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"
        shopt -s nullglob
        local acf_files=("$steam_apps"/appmanifest_*.acf)
        shopt -u nullglob

        for acf in "${acf_files[@]}"; do
            local state_data
            state_data=$(parse_acf_download_state "$acf" 2>/dev/null || true)
            [ -z "$state_data" ] && continue

            local a_id a_title a_status a_pct a_dl a_total a_flags a_dir a_path
            IFS=$'\t' read -r a_id a_title a_status a_pct a_dl a_total a_flags a_dir a_path <<< "$state_data"

            if [ "$a_status" = "[DOWNLOADING]" ] || [ "$a_status" = "[PAUSED]" ] || [ "$a_status" = "[UPDATE REQUIRED]" ] || [ "$a_status" = "[INSTALLED]" ]; then
                local ui_status="${UI_ICE}${a_status}${UI_RST}"
                [ "$a_status" = "[DOWNLOADING]" ] && ui_status="${UI_GREEN}[DOWNLOADING ${a_pct}]${UI_RST}"
                [ "$a_status" = "[PAUSED]" ] && ui_status="${UI_PURPLE}[PAUSED ${a_pct}]${UI_RST}"
                [ "$a_status" = "[INSTALLED]" ] && ui_status="${UI_CYAN}[INSTALLED]${UI_RST}"

                local dl_fmt tot_fmt
                dl_fmt=$(format_bytes "$a_dl")
                tot_fmt=$(format_bytes "$a_total")
                local detail="${a_title} (${dl_fmt}/${tot_fmt})"
                entries+="${a_id}\tSteam\t${ui_status}\t${a_pct}\t${detail}\t${a_path}\n"
                total_items=$((total_items + 1))
            fi
        done

        shopt -s nullglob
        for st_dir in "$run_dir"/depot_dl_*; do
            [ -d "$st_dir" ] || continue
            local base_st="${st_dir##*/}"
            local st_pid="${base_st##*_}"
            local rest_st="${base_st#depot_dl_}"
            local st_appid="${rest_st%_*}"
            [ -z "$st_appid" ] || [ -z "$st_pid" ] && continue

            # Self-healing: purge orphaned staging dir if downloader process is dead
            if ! [[ "$st_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$st_pid" 2>/dev/null; then
                rm -rf "$st_dir" 2>/dev/null || true
                continue
            fi

            local st_info="$st_dir/status.info"
            local st_title="Native CDN Download"
            local st_log="$st_dir/download.log"
            if [ -f "$st_info" ]; then
                local info_title info_log
                info_title=$(grep -E '^TITLE=' "$st_info" | cut -d= -f2- || true)
                info_log=$(grep -E '^LOG_FILE=' "$st_info" | cut -d= -f2- || true)
                [ -n "$info_title" ] && st_title="$info_title"
                [ -n "$info_log" ] && [ -f "$info_log" ] && st_log="$info_log"
            fi

            local prog_data st_pct st_bytes st_state
            prog_data=$(get_depot_dl_progress "$st_log" "$st_pid")
            IFS=$'\t' read -r st_pct st_bytes st_state <<< "$prog_data"

            local st_ui="${UI_GREEN}[DOWNLOADING ${st_pct}]${UI_RST}"
            if [ "$st_state" = "[PAUSED]" ]; then
                st_ui="${UI_PURPLE}[PAUSED ${st_pct}]${UI_RST}"
            elif [ "$st_state" = "[COMPLETED]" ]; then
                st_ui="${UI_CYAN}[COMPLETED]${UI_RST}"
            elif [ "$st_state" = "[FAILED]" ]; then
                st_ui="${UI_RED}[FAILED]${UI_RST}"
            elif [ "$st_state" = "[STARTING]" ]; then
                st_ui="${UI_ICE}[STARTING]${UI_RST}"
            fi

            local st_detail="${st_title} (${st_bytes}, PID: ${st_pid})"
            entries+="${st_appid}\tStandalone\t${st_ui}\t${st_pct}\t${st_detail}\t${st_dir}\n"
            total_items=$((total_items + 1))
        done
        shopt -u nullglob

        if [ "$total_items" -eq 0 ]; then
            entries+="0\tInfo\t${UI_DIM}[NO ACTIVE DOWNLOADS]${UI_RST}\t0%\tNo active downloads found in Steam or Standalone engine. Press Esc to return.\t\n"
        fi

        flush_tty_input
        local fzf_out fzf_rc=0
        fzf_out=$(printf "%b" "$entries" | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2,3,5 \
            --expect=ctrl-k \
            --border-label="  ╢ gamectl :: Download Manager ╟  " \
            --border-label-pos=2 \
            --header="DOWNLOADS (Enter: Actions │ Ctrl-K: Pause │ Esc: Back)" \
            --prompt="Downloads > " \
            --preview="$SELF_BIN --preview-download {1} {2} {6}" \
            --preview-window=right:60%:border-rounded:wrap \
        ) || fzf_rc=$?

        [ "$fzf_rc" -eq 130 ] && break
        [ -z "$fzf_out" ] && continue

        local trigger_key selection
        trigger_key=$(echo "$fzf_out" | head -n 1)
        selection=$(echo "$fzf_out" | sed -n '2p')

        [ -z "$selection" ] && continue

        local sel_appid sel_engine sel_status sel_pct sel_title sel_ref
        sel_appid=$(echo "$selection" | awk -F'\t' '{print $1}')
        sel_engine=$(echo "$selection" | awk -F'\t' '{print $2}')
        sel_status=$(echo "$selection" | awk -F'\t' '{print $3}')
        sel_pct=$(echo "$selection" | awk -F'\t' '{print $4}')
        sel_title=$(echo "$selection" | awk -F'\t' '{print $5}')
        sel_ref=$(echo "$selection" | awk -F'\t' '{print $6}')

        [ "$sel_appid" = "0" ] && break

        if [ "$trigger_key" = "ctrl-k" ]; then
            if [ "$sel_engine" = "Standalone" ]; then
                local t_pid="${sel_ref##*_}"
                if [[ "$t_pid" =~ ^[0-9]+$ ]] && kill -0 "$t_pid" 2>/dev/null; then
                    kill -STOP "$t_pid" 2>/dev/null || true
                    log_msg "INFO" "DOWNLOAD" "Paused standalone download PID $t_pid (AppID: $sel_appid) via SIGSTOP"
                    tui_modal_notice "Standalone Download Paused" "Dispatched SIGSTOP to process PID: $t_pid (AppID: $sel_appid).\nUse Action Menu to resume or terminate."
                else
                    tui_modal_notice "Pause Standalone" "Downloader process (PID: $t_pid) is no longer active."
                fi
            elif command -v steam >/dev/null 2>&1; then
                steam "steam://pause/$sel_appid" >/dev/null 2>&1 &
                log_msg "INFO" "DOWNLOAD" "Paused download for AppID $sel_appid"
                tui_modal_notice "Download Paused" "Dispatched pause signal to Steam Client for AppID: $sel_appid"
            else
                tui_modal_notice "Pause Unsupported" "Steam client CLI is not available in PATH."
            fi
            continue
        fi

        local action_entries
        if [ "$sel_engine" = "Standalone" ]; then
            local t_pid="${sel_ref##*_}"
            action_entries=$(cat <<EOF
1	Pause Standalone Download (SIGSTOP)	Suspend process PID $t_pid
2	Resume Standalone Download (SIGCONT)	Continue process PID $t_pid
3	Terminate Standalone Download (SIGTERM)	Kill process PID $t_pid
4	Inject Standalone GBE Fork LAN Runtime	Deploy Goldberg emulator
5	Return to Download List	Back
EOF
)
        else
            action_entries=$(cat <<EOF
1	Pause Steam Client Download	steam://pause/$sel_appid
2	Resume Steam Client Download	steam://resume/$sel_appid
3	Inject Standalone GBE Fork LAN Runtime	Deploy Goldberg emulator
4	Return to Download List	Back
EOF
)
        fi
        flush_tty_input
        local act_sel act_rc=0
        act_sel=$(echo "$action_entries" | fzf \
            --delimiter=$'\t' \
            --with-nth=2,3 \
            --border-label="  ╢ Actions: AppID $sel_appid ($sel_engine) ╟  " \
            --border-label-pos=2 \
            --header="DOWNLOAD ACTIONS (Enter: Execute │ Esc: Return)" \
            --prompt="Action > " \
            --height=35% \
            --reverse 2>/dev/null) || act_rc=$?

        [ "$act_rc" -eq 130 ] && continue
        [ -z "$act_sel" ] && continue

        local dl_opt
        dl_opt=$(echo "$act_sel" | cut -f1 | tr -d '[:space:]')

        case "$dl_opt" in
            1)
                if [ "$sel_engine" = "Standalone" ]; then
                    local t_pid="${sel_ref##*_}"
                    if [[ "$t_pid" =~ ^[0-9]+$ ]] && kill -0 "$t_pid" 2>/dev/null; then
                        kill -STOP "$t_pid" 2>/dev/null || true
                        log_msg "INFO" "DOWNLOAD" "Paused standalone download PID $t_pid (AppID: $sel_appid) via SIGSTOP"
                        tui_modal_notice "Download Paused" "Sent SIGSTOP to standalone downloader PID $t_pid."
                    fi
                elif command -v steam >/dev/null 2>&1; then
                    steam "steam://pause/$sel_appid" >/dev/null 2>&1 &
                    log_msg "INFO" "DOWNLOAD" "Paused download for AppID $sel_appid"
                fi
                ;;
            2)
                if [ "$sel_engine" = "Standalone" ]; then
                    local t_pid="${sel_ref##*_}"
                    if [[ "$t_pid" =~ ^[0-9]+$ ]] && kill -0 "$t_pid" 2>/dev/null; then
                        kill -CONT "$t_pid" 2>/dev/null || true
                        log_msg "INFO" "DOWNLOAD" "Resumed standalone download PID $t_pid (AppID: $sel_appid) via SIGCONT"
                        tui_modal_notice "Download Resumed" "Sent SIGCONT to standalone downloader PID $t_pid."
                    fi
                elif command -v steam >/dev/null 2>&1; then
                    steam "steam://resume/$sel_appid" >/dev/null 2>&1 &
                    log_msg "INFO" "DOWNLOAD" "Resumed download for AppID $sel_appid"
                fi
                ;;
            3)
                if [ "$sel_engine" = "Standalone" ]; then
                    local t_pid="${sel_ref##*_}"
                    if [[ "$t_pid" =~ ^[0-9]+$ ]] && kill -0 "$t_pid" 2>/dev/null; then
                        kill -TERM "$t_pid" 2>/dev/null || true
                        rm -rf "$sel_ref" 2>/dev/null || true
                        log_msg "WARN" "DOWNLOAD" "Terminated standalone download PID $t_pid (AppID: $sel_appid) via SIGTERM"
                        tui_modal_notice "Download Terminated" "Sent SIGTERM to standalone downloader PID $t_pid and purged staging."
                    fi
                else
                    local g_dir=""
                    if [ -f "$sel_ref" ]; then
                        local i_dir
                        i_dir=$(grep -m1 '"installdir"' "$sel_ref" 2>/dev/null | awk -F'"' '{print $4}')
                        if [ -n "$i_dir" ]; then
                            g_dir="$(dirname "$sel_ref")/common/$i_dir"
                        fi
                    fi
                    if [ -n "$g_dir" ] && [ -d "$g_dir" ]; then
                        log_msg "INFO" "DOWNLOAD" "Injecting GBE Fork LAN runtime into: $g_dir"
                        "$SELF_BIN" inject "$g_dir" "$sel_appid"
                        tui_modal_notice "GBE Runtime Injected" "Goldberg emulator LAN runtime successfully injected into:\n$g_dir"
                    else
                        tui_modal_notice "Target Not Found" "Steam common game directory not found:\n$g_dir"
                    fi
                fi
                ;;
            4)
                if [ "$sel_engine" = "Standalone" ]; then
                    local g_dir=""
                    if [ -f "$sel_ref/status.info" ]; then
                        g_dir=$(grep -E '^TARGET_DIR=' "$sel_ref/status.info" | cut -d= -f2-)
                    fi
                    if [ -z "$g_dir" ] || [ ! -d "$g_dir" ]; then
                        local st_title=""
                        [ -f "$sel_ref/status.info" ] && st_title=$(grep -E '^TITLE=' "$sel_ref/status.info" | cut -d= -f2-)
                        if [ -n "$st_title" ]; then
                            g_dir="$(resolve_standalone_library_dir "$st_title")"
                        fi
                    fi
                    if [ -n "$g_dir" ] && [ -d "$g_dir" ]; then
                        log_msg "INFO" "DOWNLOAD" "Injecting GBE Fork LAN runtime into target dir: $g_dir"
                        "$SELF_BIN" inject "$g_dir" "$sel_appid"
                        tui_modal_notice "GBE Runtime Injected" "Goldberg emulator LAN runtime successfully injected into:\n$g_dir"
                    else
                        tui_modal_notice "Target Not Found" "Target installation directory not found or not yet created:\n$g_dir"
                    fi
                else
                    continue
                fi
                ;;
            *)
                continue
                ;;
        esac
    done
}
# Dual-Mode Steam Client & SLSsteam Full DLC Sync
sync_steam() {
    local appid="$1"
    local title="${2:-}"
    local game_dir="${3:-}"

    # Strip ANSI escape sequences
    appid=$(strip_ansi "$appid" | tr -dc '0-9')
    title=$(strip_ansi "$title")

    if [ -z "$appid" ] || [ "$appid" = "STANDALONE" ]; then
        echo "[WARN] Invalid numeric AppID. Skipping Steam synchronization." >&2
        return 0
    fi

    if [ -z "$title" ]; then
        title="AppID_${appid}"
    fi

    local safe_title
    safe_title=$(echo "$title" | tr -cd '[:alnum:] _-')
    [ -z "$safe_title" ] && safe_title="$appid"

    echo "[INFO] Synchronizing Steam Client & SLSsteam for: $title ($appid)..."

    # 1. Fetch DLC mapping via Steam API (disk-cached 3600s)
    local dlc_json
    dlc_json=$(fetch_cached_json "https://store.steampowered.com/api/dlcforapp/?appid=${appid}" "steam_dlc_${appid}" 3600 2>/dev/null || echo "{}")
    [ -z "$dlc_json" ] && dlc_json="{}"

    # 2. Update ~/.config/SLSsteam/config.yaml using ruamel.yaml
    local sls_cfg="$(get_sls_root 2>/dev/null || echo "$HOME/.config/SLSsteam")/config.yaml"
    if [ -f "$sls_cfg" ]; then
        python3 -c "
import sys, json

cfg_path = sys.argv[1]
appid = int(sys.argv[2])
dlc_raw = sys.argv[3]

has_ruamel = False
try:
    from ruamel.yaml import YAML
    yaml_engine = YAML()
    yaml_engine.preserve_quotes = True
    has_ruamel = True
except Exception:
    try:
        import yaml as pyyaml
    except Exception:
        print('[ERROR] No YAML library found in Python (ruamel.yaml or pyyaml)', file=sys.stderr)
        sys.exit(1)

try:
    with open(cfg_path, 'r') as f:
        if has_ruamel:
            data = yaml_engine.load(f) or {}
        else:
            data = pyyaml.safe_load(f) or {}

    if 'AppIds' not in data or data['AppIds'] is None:
        data['AppIds'] = []
    if appid not in data['AppIds']:
        data['AppIds'].append(appid)

    if 'AdditionalApps' not in data or data['AdditionalApps'] is None:
        data['AdditionalApps'] = []
    if appid not in data['AdditionalApps']:
        data['AdditionalApps'].append(appid)

    dlc_obj = json.loads(dlc_raw)
    dlc_list = dlc_obj.get('dlc', [])
    if dlc_list:
        if 'DlcData' not in data or data['DlcData'] is None:
            data['DlcData'] = {}
        if appid not in data['DlcData'] or data['DlcData'][appid] is None:
            data['DlcData'][appid] = {}
        for item in dlc_list:
            d_id = int(item['id'])
            d_name = item.get('name', f'DLC {d_id}')
            data['DlcData'][appid][d_id] = d_name

    with open(cfg_path, 'w') as f:
        if has_ruamel:
            yaml_engine.dump(data, f)
        else:
            pyyaml.dump(data, f, default_flow_style=False, sort_keys=False)
    engine_name = 'ruamel.yaml' if has_ruamel else 'pyyaml (fallback)'
    print(f'[VERIFIED] SLSsteam config.yaml: AppID {appid} and {len(dlc_list)} DLC(s) registered ({engine_name}).')
except Exception as e:
    print(f'[WARN] SLSsteam config sync notice: {e}', file=sys.stderr)
" "$sls_cfg" "$appid" "$dlc_json" 2>/dev/null || true
    fi

    # 2b. Guarantee stplug-in Lua script has addappid($appid) entitlement
    local stplug_dir
    stplug_dir="$(get_steam_stplug_in_dir 2>/dev/null || echo "$HOME/.local/share/Steam/config/stplug-in")"
    if [ -d "$stplug_dir" ]; then
        local target_lua="$stplug_dir/${appid}.lua"
        if [ -f "$target_lua" ]; then
            if ! grep -Eq "^[[:space:]]*addappid[[:space:]]*\([[:space:]]*${appid}[[:space:]]*\)" "$target_lua"; then
                sed -i "1i addappid(${appid})" "$target_lua"
            fi
        else
            printf "addappid(%s)\n" "$appid" > "$target_lua"
            chmod 600 "$target_lua"
        fi
    fi

    # 3. Create appmanifest_<appid>.acf in Steam steamapps (unless --no-acf requested)
    if [ "${game_dir:-}" = "--no-acf" ] || [ "${4:-}" = "--no-acf" ]; then
        return 0
    fi

    local steam_apps
    steam_apps="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"
    if [ ! -d "$steam_apps" ]; then
        echo "  ${UI_AMBER}[NOTE] Steam steamapps directory not found at $steam_apps.${UI_RST}"
        echo "  ${UI_DIM}Physical ACF manifest deferred.${UI_RST}"
        log_msg "INFO" "STEAM" "Steam steamapps directory not found at $steam_apps; ACF creation deferred"
        invalidate_scan_cache
        return 2
    fi

    # Guard against concurrent Steam client memory lock on manifests
    check_steam_active "Writing appmanifest_${appid}.acf" || true

    local resolved_dir="$game_dir"
    if [ -z "$resolved_dir" ]; then
        if [ -d "$steam_apps/common/$safe_title" ] && [ -n "$(find "$steam_apps/common/$safe_title" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
            resolved_dir="$steam_apps/common/$safe_title"
        elif [ -d "$steam_apps/common/$title" ] && [ -n "$(find "$steam_apps/common/$title" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
            resolved_dir="$steam_apps/common/$title"
        fi
    fi

    # Cross-Library physical file discovery across all active game libraries
    if [ -z "$resolved_dir" ]; then
        local sc_id sc_name sc_st sc_dir sc_bin
        local clean_target="${title,,}"
        while IFS=$'\t' read -r sc_id sc_name sc_st sc_dir sc_bin; do
            sc_id="${sc_id//[[:space:]]/}"
            sc_dir="${sc_dir//$'\r'/}"
            if [ -n "$sc_id" ] && [ "$sc_id" = "$appid" ] && [ -d "$sc_dir" ] && [ -n "$(find "$sc_dir" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
                resolved_dir="$sc_dir"
                break
            fi
            local cur_clean="${sc_name,,}"
            cur_clean="${cur_clean#"${cur_clean%%[![:space:]]*}"}"
            cur_clean="${cur_clean%"${cur_clean##*[![:space:]]}"}"
            if [ -n "$cur_clean" ] && [ "$cur_clean" = "$clean_target" ] && [ -d "$sc_dir" ] && [ -n "$(find "$sc_dir" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
                resolved_dir="$sc_dir"
                break
            fi
        done < <(scan_installed_games 2>/dev/null || true)
    fi

    # Ghost ACF Defense: do not generate empty 1GB dummy ACF if files do not exist physically
    if [ -n "$resolved_dir" ] && [ -d "$resolved_dir" ]; then
        local acf_file="$steam_apps/appmanifest_${appid}.acf"
        local install_name="$(basename "$resolved_dir")"
        local size_bytes
        size_bytes=$(du -sb "$resolved_dir" 2>/dev/null | awk '{print $1}')
        [ -z "$size_bytes" ] || [ "$size_bytes" -le 0 ] && size_bytes=1000000000
        local steamid
        steamid=$(resolve_active_steamid)

        cat <<ACF > "$acf_file"
"AppState"
{
	"appid"		"$appid"
	"Universe"		"1"
	"name"		"$safe_title"
	"StateFlags"		"4"
	"installdir"		"$install_name"
	"LastUpdated"		"$(date +%s)"
	"SizeOnDisk"		"$size_bytes"
	"buildid"		"1"
	"LastOwner"		"$steamid"
	"UserConfig"
	{
		"language"		"english"
	}
	"MountedConfig"
	{
		"language"		"english"
	}
}
ACF
        mkdir -p "$steam_apps/common"
        local common_target="$steam_apps/common/$install_name"
        if [ "$resolved_dir" != "$common_target" ] && [ ! -e "$common_target" ]; then
            ln -sf "$resolved_dir" "$common_target"
            echo "[INFO] Created common symlink: $common_target -> $resolved_dir"
        fi
        echo "[VERIFIED] appmanifest_${appid}.acf registered (Status: Installed in Steam, Size: $size_bytes bytes)."
        log_msg "INFO" "STEAM" "Registered physical ACF manifest for $title ($appid) in $common_target"
        invalidate_scan_cache
        return 0
    else
        echo "  ${UI_AMBER}[NOTE] No physical game files detected across libraries for AppID $appid.${UI_RST}"
        echo "  ${UI_DIM}Entitlement registered in SLSsteam. Physical ACF manifest deferred (game files not installed).${UI_RST}"
        log_msg "INFO" "STEAM" "SLSsteam entitlement registered for $title ($appid); ACF creation deferred"
        invalidate_scan_cache
        return 2
    fi
    invalidate_scan_cache
}

# Entitle game and adopt assets in official Steam client without downloading
unlock_game() {
    local appid="${1:-}"
    local title="${2:-}"
    local game_dir="${3:-}"

    if [ -z "$appid" ]; then
        echo "Usage: gamectl entitle <appid> [title] [game_dir] (aliases: unlock, adopt-steam)" >&2
        return 1
    fi

    if [ -z "$title" ]; then
        echo "[INFO] Fetching game title for AppID $appid from Steam Store API..."
        title=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=basic" "steam_basic_${appid}" 3600 2>/dev/null | jq -r ".\"${appid}\".data.name // empty" 2>/dev/null || true)
        [ -z "$title" ] && title="AppID_${appid}"
    fi

    echo "${UI_BOX}╭─ STEAM ENTITLEMENT & ACF ADOPTION ENGINE ───────────────────╮${UI_RST}"
    echo "│ ${UI_CYAN}Target Game${UI_RST}: ${UI_BOLD}$title${UI_RST} ${UI_DIM}(AppID: $appid)${UI_RST}"
    echo "│ ${UI_DIM}Adopts local files across libraries, Steam Input & Vulkan shaders${UI_RST}"
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"

    local sync_rc=0
    sync_steam "$appid" "$title" "$game_dir" || sync_rc=$?
    invalidate_scan_cache

    if [ "$sync_rc" -eq 0 ]; then
        echo "  ${UI_GREEN}[SUCCESS] Game '$title' ($appid) entitled in Steam Client with Full DLC & ACF manifest.${UI_RST}"
        return 0
    elif [ "$sync_rc" -eq 2 ]; then
        echo "  ${UI_AMBER}[DEFERRED] Entitlement registered in SLSsteam. Physical ACF manifest deferred (game files not installed).${UI_RST}"
        return 0
    else
        echo "  ${UI_RED}[WARN] Steam synchronization encountered a notice (Exit: $sync_rc).${UI_RST}"
        return "$sync_rc"
    fi
}

# Aliases for entitlement engine
entitle_game() { unlock_game "$@"; }
adopt_steam() { unlock_game "$@"; }

# Interactive Steam ACF Adoption & Asset Manager Wizard (Dual Input: Title or AppID)
unlock_interactive() {
    flush_tty_input
    local u_input_raw="" fzf_rc=0
    u_input_raw=$(: | fzf \
        --print-query \
        --border-label="  ╢ Steam ACF Adoption & Asset Manager ╟  " \
        --border-label-pos=2 \
        --header="Enter game title or numeric AppID (Enter: Adopt │ Esc: Cancel)" \
        --prompt="Game Title or ID > " \
        --height=20% \
        --reverse 2>/dev/null) || fzf_rc=$?

    # Only abort if user cancelled via ESC or Ctrl-C (exit status 130)
    [ "$fzf_rc" -eq 130 ] && return 0

    local u_input
    u_input=$(echo "$u_input_raw" | head -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ -z "$u_input" ] && return 0

    local u_appid=""
    local u_title=""

    if [[ "$u_input" =~ ^[0-9]+$ ]]; then
        u_appid="$u_input"
        log_msg "INFO" "ADOPT" "Fetching title from Steam Store API for AppID $u_appid..."
        u_title=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${u_appid}&filters=basic" "steam_basic_${u_appid}" 3600 2>/dev/null | jq -r ".\"${u_appid}\".data.name // empty" 2>/dev/null || true)
        [ -z "$u_title" ] && u_title="AppID_${u_appid}"
    else
        log_msg "INFO" "ADOPT" "Searching Steam Store API for title: '$u_input'..."
        local encoded_query
        encoded_query=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$u_input" 2>/dev/null || echo "$u_input")
        local raw_results
        raw_results=$(curl -s --connect-timeout 5 "https://store.steampowered.com/api/storesearch/?term=${encoded_query}&l=english&cc=US" 2>/dev/null)
        local search_items
        search_items=$(echo "$raw_results" | jq -r '.items[]? | "\(.id)\t\(.name)"' 2>/dev/null || true)

        if [ -z "$search_items" ]; then
            log_msg "WARN" "ADOPT" "Game title '$u_input' not found on Steam Store API"
            tui_modal_notice "Game Not Found" "Game title '$u_input' was not found on Steam Store.\nPlease verify title or provide numeric AppID."
            return 1
        fi

        local sel_item fzf_sel_rc=0
        sel_item=$(echo "$search_items" | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2 \
            --border-label="  ╢ Steam Store Search :: Pick Target Game ╟  " \
            --border-label-pos=2 \
            --header="SELECT GAME FOR ACF ADOPTION (Enter: Select │ Esc: Cancel)" \
            --prompt="Adopt Game > " \
            --preview="echo -e '\033[38;5;60m╭─ SELECTED STORE GAME ──────────────────────────────╮\033[0m\n  AppID : \033[1m{1}\033[0m\n  Title : \033[1m{2}\033[0m\n\033[38;5;60m╰────────────────────────────────────────────────────╯\033[0m'" \
            --preview-window=down:30%:border-rounded \
            --height=50% \
            --reverse 2>/dev/null) || fzf_sel_rc=$?

        [ "$fzf_sel_rc" -eq 130 ] && return 0
        [ -z "$sel_item" ] && return 0

        u_appid=$(echo "$sel_item" | awk -F'\t' '{print $1}')
        u_title=$(echo "$sel_item" | awk -F'\t' '{print $2}')
    fi

    [ -z "$u_appid" ] && return 0

    # Check for physical game files across all active libraries
    local existing_dir=""
    local sc_id sc_name sc_st sc_dir sc_bin
    local clean_target="${u_title,,}"
    while IFS=$'\t' read -r sc_id sc_name sc_st sc_dir sc_bin; do
        sc_id="${sc_id//[[:space:]]/}"
        sc_dir="${sc_dir//$'\r'/}"
        if [ -n "$sc_id" ] && [ "$sc_id" = "$u_appid" ] && [ -d "$sc_dir" ] && [ -n "$(find "$sc_dir" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
            existing_dir="$sc_dir"
            break
        fi
        local cur_clean="${sc_name,,}"
        cur_clean="${cur_clean#"${cur_clean%%[![:space:]]*}"}"
        cur_clean="${cur_clean%"${cur_clean##*[![:space:]]}"}"
        if [ -n "$cur_clean" ] && [ "$cur_clean" = "$clean_target" ] && [ -d "$sc_dir" ] && [ -n "$(find "$sc_dir" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
            existing_dir="$sc_dir"
            break
        fi
    done < <(scan_installed_games 2>/dev/null || true)

    if [ -n "$existing_dir" ]; then
        log_msg "INFO" "ADOPT" "Discovered physical install across libraries: $existing_dir"
        local adopt_out
        adopt_out=$(unlock_game "$u_appid" "$u_title" "$existing_dir")
        local clean_notice
        clean_notice=$(echo "$adopt_out" | grep -E '\[SUCCESS\]|\[DEFERRED\]|\[WARN\]' | sed 's/\x1b\[[0-9;]*m//g' | sed 's/^[[:space:]]*//')
        [ -z "$clean_notice" ] && clean_notice="Physical ACF adoption complete for $u_title ($u_appid)."
        tui_modal_notice "Steam ACF Adoption" "$clean_notice\n\nGame Location: $existing_dir" "30%"
        return 0
    fi

    # Auto-Download Bridge: files are not installed in any active library
    local bridge_options
    bridge_options=$(cat <<EOF
1	[Download Standalone] Unduh via Standalone CDN (gamectl-depot-dl) & Auto-provision ACF + GBE
2	[Steam Native Install] Daftarkan SLSsteam entitlement & picu Steam Client (steam://install/$u_appid)
3	[Cancel] Batalkan dan kembali ke Dashboard
EOF
)
    local bridge_sel="" b_rc=0
    bridge_sel=$(echo "$bridge_options" | fzf \
        --delimiter=$'\t' \
        --with-nth=2 \
        --border-label="  ╢ Physical Game Files Absent: $u_title ($u_appid) ╟  " \
        --border-label-pos=2 \
        --header="PHYSICAL FILES NOT FOUND (Enter: Select │ Esc: Return)" \
        --prompt="Action > " \
        --height=35% \
        --reverse 2>/dev/null) || b_rc=$?

    [ "$b_rc" -eq 130 ] && return 0
    local b_opt
    b_opt=$(echo "$bridge_sel" | awk -F'\t' '{print $1}')

    case "$b_opt" in
        1)
            local dest_dir target_os
            dest_dir="$(resolve_target_library_dir "$u_title")"
            target_os="$(detect_app_platform_os "$u_appid")"
            log_msg "INFO" "ADOPT" "Bridging uninstalled AppID $u_appid to standalone depot download"
            download_game "$u_appid" "$dest_dir" "$u_title" --all --os "$target_os"
            ;;
        2)
            sync_steam "$u_appid" "$u_title" "--no-acf"
            if command -v steam >/dev/null 2>&1; then
                steam "steam://install/$u_appid" >/dev/null 2>&1 &
                log_msg "INFO" "ADOPT" "Triggered steam://install/$u_appid native install intent"
                tui_modal_notice "Steam Client Intent" "Entitlement registered in SLSsteam.\nPushed steam://install/$u_appid to Steam Client." "25%"
            else
                tui_modal_notice "Steam Entitlement Registered" "Entitlement registered in SLSsteam.\nSteam Client executable not found in PATH." "25%"
            fi
            ;;
        *)
            return 0
            ;;
    esac
}

entitle_interactive() { unlock_interactive "$@"; }


# --- [MODULE] src/steam/35_fixes.sh ---
# ==============================================================================
# gamectl - Automated Game Fix & Online-Fix Harvester & Steam Lifecycle Engine
# Integrates LuaTools Fix API, Cloudflare R2 Presigned Downloads, Safe Extraction,
# Atomic Revert Snapshots, Proton Compatibility Guards, & Graceful Steam Reload.
# ==============================================================================

# Query community & Online-Fix bypasses for a given AppID
# Public unauthenticated endpoint: https://lua.tools/api/denuvo/fixes?appid=<appid>
check_game_fixes() {
    local appid="${1:-}"
    if [ -z "$appid" ] || ! [[ "$appid" =~ ^[0-9]+$ ]]; then
        echo "[ERROR] Invalid or missing Steam AppID: '$appid'" >&2
        echo "Usage: gamectl fix-check <appid>" >&2
        return 1
    fi

    echo "[INFO] Querying available fixes and bypasses for AppID: $appid..."

    local api_url="https://lua.tools/api/denuvo/fixes?appid=${appid}"
    local json_out
    json_out=$(curl -sSL --connect-timeout 5 --max-time 15 -A "discord(dot)gg/luatools" "$api_url" 2>/dev/null || true)

    if [ -z "$json_out" ]; then
        echo "[WARN] Could not reach LuaTools fix catalog for AppID $appid." >&2
        return 1
    fi

    # Check for empty response or 'No fixes found'
    if echo "$json_out" | grep -q '"No fixes found"'; then
        echo "[INFO] No community fixes or bypasses registered for AppID: $appid."
        return 0
    fi

    python3 -c '
import sys, json

try:
    data = json.loads(sys.argv[1])
except Exception as e:
    print("[ERROR] Failed to parse API response JSON:", e)
    sys.exit(1)

app_name = data.get("name", "Unknown Game")
appid = data.get("appid", sys.argv[2])
fixes = data.get("fixes", [])

if not fixes:
    print("[INFO] No community fixes or bypasses found for:", app_name, f"(AppID: {appid})")
    sys.exit(0)

print("==============================================================================")
print(f" GAMECTL FIX CATALOG: {app_name} (AppID: {appid})")
print(f" Available Fixes: {len(fixes)}")
print("==============================================================================")

for idx, fix in enumerate(fixes, 1):
    fix_id = fix.get("id", "unknown")
    title = fix.get("title", "Fix")
    filename = fix.get("fixFilename", "N/A")
    tags = [t.get("name", "") for t in fix.get("tags", []) if isinstance(t, dict)]
    tag_str = ", ".join(tags) if tags else "generic"
    has_fix = "[READY]" if fix.get("hasFix") else "[PENDING]"
    
    print(f" [{idx}] {has_fix} Title: {title}")
    print(f"     • Fix ID  : {fix_id}")
    print(f"     • Archive : {filename}")
    print(f"     • Tags    : {tag_str}")
    desc = fix.get("description", "").strip()
    if desc:
        print(f"     • Notes   : {desc}")
print("==============================================================================")
' "$json_out" "$appid"
}

# Resolve target game directory from AppID or path argument
resolve_game_install_dir() {
    local target="${1:-}"
    [ -z "$target" ] && return 1

    # If it is already an existing directory, resolve absolute path
    if [ -d "$target" ]; then
        (cd "$target" && pwd)
        return 0
    fi

    # If it is numeric AppID, inspect Steam libraries via appmanifest_<appid>.acf
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        local acf_file
        acf_file=$(find_app_acf "$target" 2>/dev/null || true)
        if [ -n "$acf_file" ] && [ -f "$acf_file" ]; then
            local state_data
            state_data=$(parse_acf_download_state "$acf_file" 2>/dev/null || true)
            if [ -n "$state_data" ]; then
                local installdir
                installdir=$(echo "$state_data" | cut -f 8)
                if [ -n "$installdir" ]; then
                    local cand_dir="$(dirname "$acf_file")/common/$installdir"
                    if [ -d "$cand_dir" ]; then
                        echo "$cand_dir"
                        return 0
                    fi
                fi
            fi
        fi

        # Fallback: Search inside all known library common directories
        local lib
        while IFS= read -r lib; do
            [ -d "$lib" ] || continue
            local common_dir="$lib"
            [ "$(basename "$lib")" != "common" ] && common_dir="$lib/common"
            [ -d "$common_dir" ] || common_dir="$(dirname "$lib")/common"
            [ -d "$common_dir" ] || continue

            # Search directory with matching appid or title
            local match
            match=$(find "$common_dir" -maxdepth 2 -type f \( -name "steam_appid.txt" -o -name "OnlineFix.ini" \) -exec grep -l "^$target$" {} + 2>/dev/null | head -n 1)
            if [ -n "$match" ]; then
                dirname "$match"
                return 0
            fi
        done < <(get_steam_libraries 2>/dev/null || true)
    fi

    return 1
}

# Audit Proton compatibility in config.vdf for Windows DLL fixes
audit_proton_compatibility() {
    local appid="$1"
    [ -z "$appid" ] && return 0

    local config_vdf=""
    for cand in "$HOME/.local/share/Steam/config/config.vdf" "$HOME/.steam/steam/config/config.vdf"; do
        if [ -f "$cand" ]; then
            config_vdf="$cand"
            break
        fi
    done

    [ -z "$config_vdf" ] && return 0

    local has_mapping=0
    if grep -E -A 5 "\"${appid}\"[[:space:]]*\{" "$config_vdf" 2>/dev/null | grep -q -E '"[Nn]ame"'; then
        has_mapping=1
    fi

    if [ "$has_mapping" -eq 0 ]; then
        echo "  [WARN] AppID $appid does not have an explicit Steam Play (Proton) compatibility tool set."
        echo "         If this game has native Linux binaries, Windows DLL fixes will NOT load."
        echo "         -> In Steam: Game Properties -> Compatibility -> Check 'Force the use of a specific Steam Play compatibility tool'."
    fi
}

# Detect custom crack launcher executable shipped by fix payload
detect_fix_custom_launcher() {
    local gdir="$1"
    [ -z "$gdir" ] || [ ! -d "$gdir" ] && return 0

    local custom_launcher
    custom_launcher=$(find "$gdir" -maxdepth 2 -type f \( \
        -iname "Launcher.exe" -o -iname "*_launcher.exe" -o -iname "launcher_*.exe" \
    \) ! -iname "UnityCrashHandler*.exe" ! -iname "crash*.exe" 2>/dev/null | head -n 1)

    if [ -n "$custom_launcher" ]; then
        local rel_launcher
        rel_launcher="$(basename "$custom_launcher")"
        echo "  [INFO] Custom crack launcher detected: $rel_launcher"
        echo "         If launching via Steam Client, set Launch Options in Steam Properties:"
        echo "         bash -c 'cmd=(%command%); cmd[-1]=\"\$PWD/$rel_launcher\"; \"\${cmd[@]}\"'"
    fi
}

# Download, verify, and safely extract game fix
install_game_fix() {
    local appid=""
    local target_dir=""
    local fix_type="online"
    local explicit_fix_id=""
    local auto_yes=false
    local should_restart=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --type)
                fix_type="${2:-online}"
                shift 2 || true
                ;;
            --fix-id)
                explicit_fix_id="${2:-}"
                shift 2 || true
                ;;
            -y|--yes)
                auto_yes=true
                shift
                ;;
            --restart)
                should_restart=true
                shift
                ;;
            *)
                if [ -z "$appid" ]; then
                    appid="$1"
                elif [ -z "$target_dir" ]; then
                    target_dir="$1"
                fi
                shift
                ;;
        esac
    done

    if [ -z "$appid" ] || ! [[ "$appid" =~ ^[0-9]+$ ]]; then
        echo "[ERROR] Invalid or missing Steam AppID: '$appid'" >&2
        echo "Usage: gamectl fix-install <appid> [game_dir] [--type online|generic|voices38|all] [--fix-id <id>] [--yes|-y] [--restart]" >&2
        return 1
    fi

    # 1. Resolve Target Game Directory
    local resolved_dir=""
    if [ -n "$target_dir" ] && [ -d "$target_dir" ]; then
        resolved_dir="$(cd "$target_dir" && pwd)"
    else
        resolved_dir=$(resolve_game_install_dir "$appid" 2>/dev/null || true)
    fi

    if [ -z "$resolved_dir" ] || [ ! -d "$resolved_dir" ]; then
        echo "[ERROR] Could not resolve game installation directory for AppID $appid." >&2
        echo "       Please provide the target directory explicitly:" >&2
        echo "       gamectl fix-install $appid /path/to/game_directory" >&2
        return 1
    fi
    echo "[INFO] Target installation directory: $resolved_dir"

    # 2. Query available fixes
    local api_url="https://lua.tools/api/denuvo/fixes?appid=${appid}"
    local json_out
    json_out=$(curl -sSL --connect-timeout 5 --max-time 15 -A "discord(dot)gg/luatools" "$api_url" 2>/dev/null || true)

    if [ -z "$json_out" ] || echo "$json_out" | grep -q '"No fixes found"'; then
        echo "[ERROR] No fixes available in catalog for AppID: $appid." >&2
        return 1
    fi

    # 3. Select target fix ID using Python selector
    local chosen_fix_json
    chosen_fix_json=$(python3 -c '
import sys, json

try:
    data = json.loads(sys.argv[1])
except Exception:
    sys.exit(1)

fixes = data.get("fixes", [])
if not fixes:
    sys.exit(1)

explicit_id = sys.argv[2]
pref_type = sys.argv[3].lower()

chosen = None

if explicit_id:
    for f in fixes:
        if f.get("id") == explicit_id:
            chosen = f
            break

if not chosen:
    ranked = []
    for f in fixes:
        if not f.get("hasFix"):
            continue
        tags = [t.get("slug", "").lower() for t in f.get("tags", []) if isinstance(t, dict)]
        title = f.get("title", "").lower()
        score = 100
        if "online-fix" in tags or "online fix" in title or "onlinefix" in title:
            score = 10 if pref_type == "online" else 50
        elif "voices38-crack" in tags or "voices38" in title:
            score = 20 if pref_type == "voices38" else 60
        elif "generic" in tags or "bypass" in title:
            score = 30 if pref_type == "generic" else 70
        ranked.append((score, f))
    
    if ranked:
        ranked.sort(key=lambda x: x[0])
        chosen = ranked[0][1]
    elif fixes:
        chosen = fixes[0]

if chosen:
    print(json.dumps(chosen))
' "$json_out" "$explicit_fix_id" "$fix_type")

    if [ -z "$chosen_fix_json" ]; then
        echo "[ERROR] Could not select a valid fix for AppID $appid." >&2
        return 1
    fi

    local fix_id fix_title fix_filename
    fix_id=$(echo "$chosen_fix_json" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("id", ""))')
    fix_title=$(echo "$chosen_fix_json" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("title", ""))')
    fix_filename=$(echo "$chosen_fix_json" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("fixFilename", ""))')

    echo "[INFO] Selected Fix:"
    echo "  • Fix ID   : $fix_id"
    echo "  • Title    : $fix_title"
    echo "  • Filename : $fix_filename"

    # 4. Authenticate via LuaTools token resolver
    local token
    token=$(get_valid_luatools_token 2>/dev/null || true)
    if [ -z "$token" ]; then
        echo "[ERROR] Downloading fix archives requires an active LuaTools account session." >&2
        echo "       Run: gamectl login-luatools <6-character-code | refresh_token | session.json>" >&2
        return 1
    fi

    # 5. Resolve presigned Cloudflare R2 download URL
    echo "[INFO] Resolving secure presigned download link..."
    local encoded_fix_id
    encoded_fix_id=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$fix_id")
    local dl_api="https://lua.tools/api/denuvo/download?fix=${encoded_fix_id}&slot=fix"
    local dl_resp
    dl_resp=$(curl -sSL --connect-timeout 8 --max-time 20 \
        -H "Authorization: Bearer $token" \
        -H "User-Agent: discord(dot)gg/luatools" \
        "$dl_api" 2>/dev/null || true)

    local signed_url
    signed_url=$(echo "$dl_resp" | python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    print(data.get("url", ""))
except Exception:
    pass
')

    if [ -z "$signed_url" ] || ! [[ "$signed_url" =~ ^https:// ]]; then
        echo "[ERROR] Failed to obtain presigned download link from LuaTools API." >&2
        echo "       Response: $dl_resp" >&2
        return 1
    fi

    # 6. Download archive to temporary file
    local tmp_zip
    tmp_zip=$(mktemp "${TMPDIR:-/tmp}/gamectl_fix_${appid}_XXXXXX.zip")
    echo "[INFO] Downloading fix archive payload..."
    if ! curl -sSL --connect-timeout 10 --max-time 180 \
        -A "discord(dot)gg/luatools" \
        -o "$tmp_zip" "$signed_url"; then
        rm -f "$tmp_zip"
        echo "[ERROR] Download failed from storage backend." >&2
        return 1
    fi

    if [ ! -s "$tmp_zip" ] || ! unzip -tq "$tmp_zip" >/dev/null 2>&1; then
        rm -f "$tmp_zip"
        echo "[ERROR] Downloaded archive is corrupt or not a valid ZIP file." >&2
        return 1
    fi

    # 7. Zip-Slip Security Audit
    if unzip -Z1 "$tmp_zip" 2>/dev/null | grep -E '(^/|^\.\./|/\.\./|^\.\.\\|\\\.\.\\)' >/dev/null 2>&1; then
        rm -f "$tmp_zip"
        echo "[ERROR] Security violation: Zip slip path traversal detected in archive payload!" >&2
        return 1
    fi
    echo "[VERIFIED] Archive payload integrity & security audit passed."

    # 8. Create Atomic Backup Snapshot Before Overwriting
    local ts
    ts="$(date +%Y%m%d_%H%M%S)"
    local backup_dir="$resolved_dir/.gamectl_fix_backup/$ts"
    local backup_files_dir="$backup_dir/backup_files"
    mkdir -p "$backup_files_dir"

    local zip_files
    zip_files=$(unzip -Z1 "$tmp_zip" 2>/dev/null || true)
    local backed_up_count=0

    # Save list of all files extracted by this fix
    echo "$zip_files" > "$backup_dir/installed_files.txt"

    while IFS= read -r f; do
        [ -z "$f" ] && continue
        if [ -f "$resolved_dir/$f" ]; then
            mkdir -p "$(dirname "$backup_files_dir/$f")"
            cp -p "$resolved_dir/$f" "$backup_files_dir/$f"
            backed_up_count=$((backed_up_count + 1))
        fi
    done <<< "$zip_files"

    cat <<META > "$resolved_dir/.gamectl_fix_backup/latest.json"
{
  "timestamp": "$ts",
  "appid": "$appid",
  "fix_id": "$fix_id",
  "fix_title": "$fix_title",
  "backed_up_count": $backed_up_count
}
META
    echo "[VERIFIED] Created pre-install snapshot: $backed_up_count original file(s) saved to .gamectl_fix_backup/$ts"

    # 9. Extract Payload into Target Game Directory
    echo "[INFO] Extracting fix payload into: $resolved_dir..."
    unzip -q -o "$tmp_zip" -d "$resolved_dir"
    rm -f "$tmp_zip"

    # 10. Audit Proton Compatibility & Custom Launcher Redirection
    audit_proton_compatibility "$appid"
    detect_fix_custom_launcher "$resolved_dir"

    # 11. Chain Auto-Execute: setup_onlinefix
    echo "[INFO] Running automated P2P compatibility and Spacewar entitlement setup..."
    setup_onlinefix "$resolved_dir" --yes || true

    echo "=============================================================================="
    invalidate_scan_cache
    echo " [SUCCESS] Fix successfully deployed for: $(basename "$resolved_dir")"
    echo "           To revert changes at any time: gamectl fix-revert \"$resolved_dir\""
    echo "=============================================================================="

    # 12. Optional Graceful Steam Restart
    if [ "$should_restart" = true ]; then
        restart_steam_client
    fi

    return 0
}

# Revert deployed game fix and restore original files from backup snapshot
revert_game_fix() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo "Usage: gamectl fix-revert <game_dir|appid> [--dry-run]" >&2
        return 1
    fi

    local is_dry_run=false
    for arg in "$@"; do
        if [ "$arg" = "--dry-run" ] || [ "$arg" = "-n" ]; then
            is_dry_run=true
        fi
    done

    local resolved_dir
    resolved_dir=$(resolve_game_install_dir "$target" 2>/dev/null || true)
    if [ -z "$resolved_dir" ] || [ ! -d "$resolved_dir" ]; then
        echo "[ERROR] Game directory not found for: '$target'" >&2
        return 1
    fi

    local backup_root="$resolved_dir/.gamectl_fix_backup"
    if [ ! -d "$backup_root" ]; then
        echo "[ERROR] No backup snapshots found in: $backup_root" >&2
        return 1
    fi

    # Find the most recent timestamp directory
    local latest_snap
    latest_snap=$(find "$backup_root" -mindepth 1 -maxdepth 1 -type d ! -name "latest.json" | sort -r | head -n 1)

    if [ -z "$latest_snap" ] || [ ! -d "$latest_snap" ]; then
        echo "[ERROR] No valid snapshot directory found in $backup_root." >&2
        return 1
    fi

    local backup_files_dir="$latest_snap/backup_files"
    local installed_list="$latest_snap/installed_files.txt"

    if [ "$is_dry_run" = true ]; then
        echo "[INFO] [DRY-RUN] Simulating game fix revert using snapshot: $(basename "$latest_snap")"
        if [ -f "$installed_list" ]; then
            while IFS= read -r f; do
                [ -z "$f" ] && continue
                [ "${f: -1}" = "/" ] && continue
                if [ -f "$backup_files_dir/$f" ]; then
                    echo "  • [RESTORE] $f (original file from backup)"
                elif [ -f "$resolved_dir/$f" ]; then
                    echo "  • [PURGE] $f (fix-introduced artifact)"
                fi
            done < "$installed_list"
        elif [ -d "$backup_files_dir" ]; then
            (
                cd "$backup_files_dir"
                find . -type f | while read -r f; do
                    echo "  • [RESTORE] ${f#./} (original file from backup)"
                done
            )
        fi
        echo "[INFO] [DRY-RUN] Game fix revert simulated successfully (no files modified)."
        return 0
    fi

    echo "[INFO] Reverting game fix using snapshot: $(basename "$latest_snap")..."

    if [ -f "$installed_list" ]; then
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            # If the path was a directory entry in zip, skip file removal
            [ "${f: -1}" = "/" ] && continue

            if [ -f "$backup_files_dir/$f" ]; then
                # Restore original file that was replaced
                mkdir -p "$(dirname "$resolved_dir/$f")"
                cp -p "$backup_files_dir/$f" "$resolved_dir/$f"
            elif [ -f "$resolved_dir/$f" ]; then
                # File was newly introduced by the fix, remove it
                rm -f "$resolved_dir/$f"
            fi
        done < "$installed_list"
    elif [ -d "$backup_files_dir" ]; then
        (
            cd "$backup_files_dir"
            find . -type f -exec cp -pv {} "$resolved_dir/{}" \;
        )
    fi

    invalidate_scan_cache
    echo "[VERIFIED] Game fix reverted. Pristine files restored and fix artifacts purged."
    return 0
}

# Graceful Steam Client restart engine with SLSsteam wrapper preservation
restart_steam_client() {
    echo "[INFO] Initiating graceful Steam Client reload..."

    # Check if Steam process is active
    if ! pgrep -x steam >/dev/null 2>&1; then
        echo "[INFO] Steam Client is not currently running. No restart needed."
        return 0
    fi

    # Check for Game Mode supervisor (Steam Deck)
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl --user is-active --quiet steam-launcher.service 2>/dev/null; then
            echo "[INFO] Detected Game Mode systemd unit: steam-launcher.service. Restarting..."
            systemctl --user restart steam-launcher.service
            echo "[VERIFIED] Steam launcher service restarted."
            return 0
        fi
        local gs_unit
        gs_unit="$(systemctl --user list-units --type=service --state=active --plain --no-legend 'gamescope-session*' 2>/dev/null | awk '{print $1}' | head -n 1)"
        if [ -n "$gs_unit" ]; then
            echo "[INFO] Detected Game Mode gamescope session unit: $gs_unit. Restarting..."
            systemctl --user restart "$gs_unit"
            echo "[VERIFIED] Gamescope session unit restarted."
            return 0
        fi
    fi

    # Desktop Session: Resolve SLSsteam launcher wrapper
    local launcher="$HOME/.local/share/SLSsteam/path/steam"
    if [ ! -x "$launcher" ]; then
        launcher="$(command -v steam 2>/dev/null || echo "")"
    fi

    # Flush disk writes
    sync

    # Request graceful shutdown via SIGTERM
    pkill -TERM -x steam >/dev/null 2>&1 || true

    # Wait up to 10 seconds for clean exit
    local terminated=false
    for _ in {1..50}; do
        if ! pgrep -x steam >/dev/null 2>&1; then
            terminated=true
            break
        fi
        sleep 0.2
    done

    # Escalate to SIGKILL if still hanging
    if [ "$terminated" = false ]; then
        echo "[WARN] Steam did not exit within grace period. Escalating to SIGKILL..."
        pkill -KILL -x steam >/dev/null 2>&1 || true
    fi

    # Clean residual child processes
    pkill -KILL -f 'steamwebhelper' >/dev/null 2>&1 || true
    sleep 1

    # Relaunch launcher in detached background session
    if [ -n "$launcher" ] && [ -x "$launcher" ]; then
        echo "[INFO] Relaunching Steam via: $launcher"
        nohup "$launcher" </dev/null >/dev/null 2>&1 &
        echo "[VERIFIED] Steam client successfully restarted."
    else
        echo "[WARN] Could not find executable Steam launcher binary to relaunch."
    fi

    return 0
}

# --- [MODULE] src/runners/40_wrappers.sh ---
# Detect P2P multiplayer compatibility hooks, mod loaders, and custom DLL overrides for a game directory
detect_dll_overrides() {
    local gdir="${1:-}"
    [ -n "$gdir" ] && [ -d "$gdir" ] || return 0

    local has_onlinefix=0
    local has_bepinex=0
    local has_ue4ss=0
    local has_reframework=0
    local has_reshade=0
    local custom_overrides=""

    # 1. Check custom declarative .dll_overrides file
    if [ -f "$gdir/.dll_overrides" ]; then
        custom_overrides=$(grep -v -E '^[[:space:]]*(#|$)' "$gdir/.dll_overrides" 2>/dev/null | tr '\n' ';' || true)
    fi

    # 2. Scan root and subdirectories (up to depth 3) excluding runtime/save folders
    local found_signatures
    found_signatures=$(find "$gdir" -maxdepth 3 \( \
        -name "pfx" -o -name ".git" -o -name ".save_snapshots" -o -name "saves" \
    \) -prune -o \( \
        -iname "OnlineFix64.dll" -o -iname "OnlineFix.dll" -o -iname "dnet.dll" -o \
        -iname "SteamOverlay64.dll" -o -iname "winmm.dll" -o -iname "version.dll" -o \
        -iname "BepInEx" -o -iname "doorstop_config.ini" -o -iname "winhttp.dll" -o \
        -iname "ue4ss" -o -iname "UE4SS.dll" -o -iname "dwmapi.dll" -o \
        -iname "dinput8.dll" -o \
        -iname "ReShade.ini" -o -iname "dxgi.dll" \
    \) -print 2>/dev/null || true)

    if [ -n "$found_signatures" ]; then
        while IFS= read -r item; do
            [ -z "$item" ] && continue
            local base
            base=$(basename "$item")
            case "${base,,}" in
                onlinefix64.dll|onlinefix.dll|dnet.dll|steamoverlay64.dll|winmm.dll|version.dll)
                    has_onlinefix=1 ;;
                bepinex|doorstop_config.ini|winhttp.dll)
                    has_bepinex=1 ;;
                ue4ss|ue4ss.dll|dwmapi.dll)
                    has_ue4ss=1 ;;
                dinput8.dll)
                    has_reframework=1 ;;
                reshade.ini|dxgi.dll)
                    has_reshade=1 ;;
            esac
        done <<< "$found_signatures"
    fi

    # Return empty string if no mod/OnlineFix signatures or custom overrides found
    if [ "$has_onlinefix" -eq 0 ] && [ "$has_bepinex" -eq 0 ] && \
       [ "$has_ue4ss" -eq 0 ] && [ "$has_reframework" -eq 0 ] && \
       [ "$has_reshade" -eq 0 ] && [ -z "$custom_overrides" ]; then
        return 0
    fi

    local detected_tokens=""
    if [ "$has_onlinefix" -eq 1 ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}onlinefix=n;onlinefix64=n;steamoverlay64=n;dnet=n;winmm=n,b;version=n,b;steam_api64=n;steam_api=n"
    fi
    if [ "$has_bepinex" -eq 1 ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}winhttp=n,b"
    fi
    if [ "$has_ue4ss" -eq 1 ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}dwmapi=n,b"
    fi
    if [ "$has_reframework" -eq 1 ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}dinput8=n,b"
    fi
    if [ "$has_reshade" -eq 1 ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}dxgi=n,b"
    fi
    if [ -n "$custom_overrides" ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}${custom_overrides}"
    fi

    local user_env_overrides="${2:-${WINEDLLOVERRIDES:-}}"
    declare -A seen=()
    declare -A values=()
    local ordered_keys=()

    # 1. Process user environment overrides first to preserve user precedence
    if [ -n "$user_env_overrides" ]; then
        local u_arr=()
        IFS=';' read -r -a u_arr <<< "$user_env_overrides"
        for item in "${u_arr[@]}"; do
            [ -z "$item" ] && continue
            local k="${item%%=*}"
            local v="${item#*=}"
            [ "$item" = "$k" ] && v="n"
            k=$(echo "$k" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
            v=$(echo "$v" | tr -d '[:space:]')
            [ -z "$k" ] && continue
            if [ -z "${seen["$k"]:-}" ]; then
                seen["$k"]=1
                ordered_keys+=("$k")
                values["$k"]="$v"
            fi
        done
    fi

    # 2. Process detected mod tokens (add only if not overridden by user)
    local d_arr=()
    IFS=';' read -r -a d_arr <<< "$detected_tokens"
    for item in "${d_arr[@]}"; do
        [ -z "$item" ] && continue
        local k="${item%%=*}"
        local v="${item#*=}"
        [ "$item" = "$k" ] && v="n"
        k=$(echo "$k" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
        v=$(echo "$v" | tr -d '[:space:]')
        [ -z "$k" ] && continue
        if [ -z "${seen["$k"]:-}" ]; then
            seen["$k"]=1
            ordered_keys+=("$k")
            values["$k"]="$v"
        fi
    done

    # 3. Format normalized semicolon-separated output
    local result=""
    for k in "${ordered_keys[@]}"; do
        local entry="${k}=${values["$k"]}"
        result="${result:+${result};}${entry}"
    done
    echo "$result"
}

# Discover runner for Windows games (priority: umu-run -> GE-Proton / Proton Steam -> wine)
find_runner() {
    local target_dir="${1:-}"

    # Priority 0: Per-game runner override or environment override
    if [ -n "$target_dir" ] && [ -f "$target_dir/.runner" ]; then
        local g_runner
        g_runner=$(head -n 1 "$target_dir/.runner" | tr -d '[:space:]')
        if [ -n "$g_runner" ] && { [ -x "$g_runner" ] || command -v "$g_runner" >/dev/null 2>&1; }; then
            echo "$g_runner"
            return 0
        fi
    fi
    if [ -n "${GAMECTL_RUNNER:-}" ]; then
        if [ -x "$GAMECTL_RUNNER" ] || command -v "$GAMECTL_RUNNER" >/dev/null 2>&1; then
            echo "$GAMECTL_RUNNER"
            return 0
        fi
    fi
    if [ -f "$HOME/.config/gamectl/runner" ]; then
        local user_runner
        user_runner=$(head -n 1 "$HOME/.config/gamectl/runner" | tr -d '[:space:]')
        if [ -n "$user_runner" ] && { [ -x "$user_runner" ] || command -v "$user_runner" >/dev/null 2>&1; }; then
            echo "$user_runner"
            return 0
        fi
    fi

    # Priority 1: umu-run
    if command -v umu-run >/dev/null 2>&1; then
        echo "umu-run"
        return 0
    fi

    # Priority 2: GE-Proton / Proton in Steam compatibilitytools.d or common
    local s_dyn_root
    s_dyn_root="$(get_steam_root 2>/dev/null || true)"
    local compat_dirs=(
        "$s_dyn_root/compatibilitytools.d"
        "$HOME/.local/share/Steam/compatibilitytools.d"
        "$HOME/.steam/root/compatibilitytools.d"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d"
    )
    for cdir in "${compat_dirs[@]}"; do
        [ -d "$cdir" ] || continue
        local p
        while read -r p; do
            [ -z "$p" ] && continue
            if [ -x "$p/proton" ]; then
                echo "$p/proton"
                return 0
            fi
        done < <(find "$cdir" -mindepth 1 -maxdepth 1 -type d -name "*Proton*" 2>/dev/null | sort -Vr)
    done

    # Check Proton in Steam common libraries
    local steam_lib
    while read -r steam_lib; do
        [ -d "$steam_lib/common" ] || continue
        local p
        while read -r p; do
            [ -z "$p" ] && continue
            if [ -x "$p/proton" ]; then
                echo "$p/proton"
                return 0
            fi
        done < <(find "$steam_lib/common" -mindepth 1 -maxdepth 1 -type d -name "Proton*" 2>/dev/null | sort -Vr)
    done < <(get_steam_libraries 2>/dev/null || true)

    # Priority 3: System Wine
    if command -v wine64 >/dev/null 2>&1; then
        echo "wine64"
        return 0
    elif command -v wine >/dev/null 2>&1; then
        echo "wine"
        return 0
    fi

    # Priority 4: Internal wine binary inside GE-Proton files/bin
    for cdir in "${compat_dirs[@]}"; do
        [ -d "$cdir" ] || continue
        local w
        w=$(find "$cdir" -type f \( -name "wine64" -o -name "wine" \) 2>/dev/null | head -n 1)
        if [ -n "$w" ] && [ -x "$w" ]; then
            echo "$w"
            return 0
        fi
    done

    return 1
}

# Resolve wineserver binary matching active runner or system/Proton installation
get_wineserver_bin() {
    local runner="${1:-}"

    # 1. If runner points directly to a Proton executable or runner string contains proton
    if [ -n "$runner" ]; then
        if [[ "$runner" =~ proton ]] || [ -f "$runner" ]; then
            local p_base
            p_base="$(dirname "$runner")"
            for sub in "files/bin/wineserver" "dist/bin/wineserver" "bin/wineserver"; do
                if [ -x "$p_base/$sub" ]; then
                    echo "$p_base/$sub"
                    return 0
                fi
            done
        fi
    fi

    # 2. Check system PATH for wineserver
    if command -v wineserver >/dev/null 2>&1; then
        command -v wineserver
        return 0
    fi

    # 3. Fallback: Search Steam compatibility tools for highest GE-Proton wineserver
    local s_dyn_root
    s_dyn_root="$(get_steam_root 2>/dev/null || true)"
    local compat_dirs=(
        "$s_dyn_root/compatibilitytools.d"
        "$HOME/.local/share/Steam/compatibilitytools.d"
        "$HOME/.steam/root/compatibilitytools.d"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d"
    )
    for cdir in "${compat_dirs[@]}"; do
        [ -n "$cdir" ] && [ -d "$cdir" ] || continue
        local p
        while read -r p; do
            [ -z "$p" ] && continue
            for sub in "files/bin/wineserver" "dist/bin/wineserver" "bin/wineserver"; do
                if [ -x "$p/$sub" ]; then
                    echo "$p/$sub"
                    return 0
                fi
            done
        done < <(find "$cdir" -mindepth 1 -maxdepth 1 -type d -name "*Proton*" 2>/dev/null | sort -Vr)
    done

    # 4. Check system wine64 / wine adjacent wineserver
    for w in "$(command -v wine64 2>/dev/null || true)" "$(command -v wine 2>/dev/null || true)"; do
        [ -n "$w" ] || continue
        local w_dir
        w_dir="$(dirname "$w")"
        if [ -x "$w_dir/wineserver" ]; then
            echo "$w_dir/wineserver"
            return 0
        fi
    done

    return 1
}

# Resolve active Steam compatibility tools directory
get_compat_dir() {
    local s_dyn_root
    s_dyn_root="$(get_steam_root 2>/dev/null || true)"
    if [ -n "$s_dyn_root" ] && [ -d "$s_dyn_root" ]; then
        echo "$s_dyn_root/compatibilitytools.d"
    elif [ -d "$HOME/.steam/root" ]; then
        echo "$HOME/.steam/root/compatibilitytools.d"
    else
        echo "$HOME/.local/share/Steam/compatibilitytools.d"
    fi
}

# List local and latest upstream GE-Proton releases
proton_list() {
    local s_dyn_root
    s_dyn_root="$(get_steam_root 2>/dev/null || true)"
    local compat_dirs=(
        "$s_dyn_root/compatibilitytools.d"
        "$HOME/.local/share/Steam/compatibilitytools.d"
        "$HOME/.steam/root/compatibilitytools.d"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d"
    )

    declare -A local_installs=()
    for cdir in "${compat_dirs[@]}"; do
        [ -n "$cdir" ] && [ -d "$cdir" ] || continue
        for d in "$cdir"/*; do
            [ -d "$d" ] || continue
            local t_name
            t_name=$(basename "$d")
            local_installs["$t_name"]="$d"
        done
    done

    echo "${UI_BOX}╭─ GE-PROTON RELEASE MANAGER (HEADLESS) ───────────────────────╮${UI_RST}"
    echo "│ ${UI_CYAN}Target Path${UI_RST}: $(get_compat_dir)"
    echo "│ ${UI_CYAN}Installed  ${UI_RST}: ${#local_installs[@]} version(s) detected locally"
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"

    # 1. Show local versions
    echo
    echo "  ${UI_PURPLE}[LOCAL VERSIONS]${UI_RST}"
    if [ ${#local_installs[@]} -gt 0 ]; then
        for v in "${!local_installs[@]}"; do
            local v_path="${local_installs["$v"]}"
            local v_sz
            v_sz=$(du -sh "$v_path" 2>/dev/null | awk '{print $1}')
            echo "    • ${UI_BOLD}$(printf '%-22s' "$v")${UI_RST} : ${UI_GREEN}[INSTALLED]${UI_RST} ${UI_DIM}(Size: $v_sz | $v_path)${UI_RST}"
        done
    else
        echo "    ${UI_DIM}(No GE-Proton versions installed in compatibilitytools.d/)${UI_RST}"
    fi

    # 2. Query GitHub Releases upstream
    echo
    echo "  ${UI_PURPLE}[UPSTREAM RELEASES (GitHub: GloriousEggroll/proton-ge-custom)]${UI_RST}"
    local arch_pat="x86_64\\.tar\\.gz$"
    case "$(uname -m 2>/dev/null || echo "x86_64")" in
        aarch64|arm64) arch_pat="aarch64\\.tar\\.gz$" ;;
        *) arch_pat="x86_64\\.tar\\.gz$" ;;
    esac

    local raw_json=""
    raw_json=$(curl -s --connect-timeout 5 --max-time 10 "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases?per_page=5" 2>/dev/null || echo "")

    local parsed_releases=""
    if [ -n "$raw_json" ] && echo "$raw_json" | jq -e 'if type=="array" then true else false end' >/dev/null 2>&1; then
        parsed_releases=$(echo "$raw_json" | jq -r --arg pat "$arch_pat" '
            .[] | {
                tag: .tag_name,
                asset: ([.assets[] | select(.name | test($pat))] | first)
            } | select(.asset != null) | [
                .tag,
                .asset.name,
                ((.asset.size // 0) / 1048576 | floor | tostring + " MB"),
                .asset.browser_download_url
            ] | @tsv
        ' 2>/dev/null || true)
    fi

    if [ -n "$parsed_releases" ]; then
        local idx=0
        while IFS=$'\t' read -r r_tag r_asset r_size r_url; do
            [ -z "$r_tag" ] && continue
            idx=$((idx + 1))
            local status_badge="${UI_CYAN}[AVAILABLE]${UI_RST}"
            [ -n "${local_installs["$r_tag"]:-}" ] && status_badge="${UI_GREEN}[INSTALLED]${UI_RST}"
            [ "$idx" -eq 1 ] && status_badge="${status_badge} ${UI_AMBER}(Latest)${UI_RST}"
            echo "    • ${UI_BOLD}$(printf '%-22s' "$r_tag")${UI_RST} : $status_badge ${UI_DIM}(Download Size: $r_size)${UI_RST}"
        done <<< "$parsed_releases"
        echo
        echo "  ${UI_DIM}Install command: gamectl proton-install [tag|latest]${UI_RST}"
    else
        echo "    ${UI_AMBER}[WARN]${UI_RST} ${UI_DIM}Unable to fetch upstream release list (Offline or GitHub API rate-limited).${UI_RST}"
        echo "    ${UI_DIM}You can still install directly via: gamectl proton-install <tag_name>${UI_RST}"
    fi
    echo
}

# Headless GE-Proton installer
proton_install() {
    local target_tag="${1:-latest}"
    local auto_yes=false
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes) auto_yes=true; shift ;;
            *) shift ;;
        esac
    done

    local compat_dir
    compat_dir="$(get_compat_dir)"
    mkdir -p "$compat_dir"

    local arch_suffix="x86_64"
    case "$(uname -m 2>/dev/null || echo "x86_64")" in
        aarch64|arm64) arch_suffix="aarch64" ;;
        *) arch_suffix="x86_64" ;;
    esac

    echo "[INFO] Preparing GE-Proton installation ($target_tag) for architecture $arch_suffix..."

    local resolved_tag=""
    local download_url=""

    if [ "$target_tag" = "latest" ]; then
        local latest_json
        latest_json=$(curl -s --connect-timeout 5 --max-time 10 "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest" 2>/dev/null || echo "")
        if [ -n "$latest_json" ] && echo "$latest_json" | jq -e '.tag_name' >/dev/null 2>&1; then
            resolved_tag=$(echo "$latest_json" | jq -r '.tag_name')
            local pat="${arch_suffix}\\.tar\\.gz$"
            download_url=$(echo "$latest_json" | jq -r --arg pat "$pat" '
                [.assets[] | select(.name | test($pat))] | first | .browser_download_url
            ' 2>/dev/null || echo "")
        fi
        if [ -z "$resolved_tag" ] || [ -z "$download_url" ] || [ "$download_url" = "null" ]; then
            echo "[ERROR] Failed to obtain latest release URL from GitHub API." >&2
            echo "        Specify target tag explicitly: gamectl proton-install <tag_name>" >&2
            return 1
        fi
    else
        resolved_tag="$target_tag"
        local tag_json
        tag_json=$(curl -s --connect-timeout 5 --max-time 10 "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/tags/${resolved_tag}" 2>/dev/null || echo "")
        if [ -n "$tag_json" ] && echo "$tag_json" | jq -e '.tag_name' >/dev/null 2>&1; then
            local pat="${arch_suffix}\\.tar\\.gz$"
            download_url=$(echo "$tag_json" | jq -r --arg pat "$pat" '
                [.assets[] | select(.name | test($pat))] | first | .browser_download_url
            ' 2>/dev/null || echo "")
        fi
        if [ -z "$download_url" ] || [ "$download_url" = "null" ]; then
            # Direct asset fallback pattern
            download_url="https://github.com/GloriousEggroll/proton-ge-custom/releases/download/${resolved_tag}/${resolved_tag}-${arch_suffix}.tar.gz"
        fi
    fi

    echo "[INFO] Target version : $resolved_tag"
    echo "[INFO] Download URL   : $download_url"
    echo "[INFO] Target Dir     : $compat_dir/"

    if [ -d "$compat_dir/$resolved_tag" ] && [ "$auto_yes" = false ]; then
        if [ -t 0 ]; then
            echo -n "[WARN] Directory $resolved_tag already exists. Overwrite installation? [y/N]: "
            local confirm=""
            read -t 10 -r confirm || confirm="n"
            if [[ ! "$confirm" =~ ^[yY] ]]; then
                echo "[INFO] Installation canceled."
                return 0
            fi
        fi
    fi

    echo "[INFO] Downloading and streaming tarball extraction..."
    if curl -# -fL "$download_url" | tar -xz -C "$compat_dir/"; then
        local installed_folder="$compat_dir/$resolved_tag"
        if [ ! -d "$installed_folder" ]; then
            installed_folder=$(find "$compat_dir" -mindepth 1 -maxdepth 1 -type d -name "*${resolved_tag}*" 2>/dev/null | head -n 1)
        fi
        if [ -n "$installed_folder" ] && [ -f "$installed_folder/compatibilitytool.vdf" ]; then
            [ -f "$installed_folder/proton" ] && chmod +x "$installed_folder/proton"
            echo "[VERIFIED] GE-Proton $resolved_tag installed successfully in: $installed_folder"
            return 0
        else
            echo "[ERROR] Extraction completed but compatibilitytool.vdf not found in $installed_folder." >&2
            return 1
        fi
    else
        echo "[ERROR] Failed to download or extract $resolved_tag from $download_url" >&2
        return 1
    fi
}

# Safely remove an installed GE-Proton version
proton_remove() {
    local tag="${1:-}"
    local auto_yes=false
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes) auto_yes=true; shift ;;
            *) shift ;;
        esac
    done

    if [ -z "$tag" ]; then
        echo "Usage: gamectl proton-remove <tag> [-y|--yes]" >&2
        return 1
    fi

    # Path traversal protection
    if [[ "$tag" =~ (\.\.|\/|\\) ]]; then
        echo "[ERROR] Invalid tag (path traversal sequence detected): $tag" >&2
        return 1
    fi

    local s_dyn_root
    s_dyn_root="$(get_steam_root 2>/dev/null || true)"
    local compat_dirs=(
        "$s_dyn_root/compatibilitytools.d"
        "$HOME/.local/share/Steam/compatibilitytools.d"
        "$HOME/.steam/root/compatibilitytools.d"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d"
    )

    local target_dir=""
    for cdir in "${compat_dirs[@]}"; do
        [ -n "$cdir" ] && [ -d "$cdir" ] || continue
        if [ -d "$cdir/$tag" ]; then
            target_dir="$cdir/$tag"
            break
        fi
    done

    if [ -z "$target_dir" ] || [ ! -d "$target_dir" ]; then
        echo "[ERROR] GE-Proton version '$tag' not found in compatibilitytools.d/" >&2
        return 1
    fi

    # Canonical path traversal assertion
    local real_target
    real_target="$(realpath "$target_dir" 2>/dev/null || echo "")"
    if [[ "$real_target" != *"compatibilitytools.d"* ]]; then
        echo "[ERROR] Path traversal guard failed for: $target_dir" >&2
        return 1
    fi

    local sz
    sz=$(du -sh "$target_dir" 2>/dev/null | awk '{print $1}')

    if [ "$auto_yes" = false ] && [ -t 0 ]; then
        echo -n "Delete GE-Proton directory '$tag' (Size: $sz)? [y/N]: "
        local confirm=""
        read -t 10 -r confirm || confirm="n"
        echo
        if [[ ! "$confirm" =~ ^[yY] ]]; then
            echo "[INFO] Removal of $tag canceled."
            return 0
        fi
    fi

    rm -rf "$target_dir"
    echo "[VERIFIED] GE-Proton '$tag' removed successfully ($sz disk space freed)."
    return 0
}

# Wine Prefix Swiss Army Knife & Wineserver Lifecycle Guard (Chunk 4)
manage_prefix() {
    local game_dir="${1:-}"
    local action="${2:-}"
    shift 2 2>/dev/null || shift $# 2>/dev/null || true

    if [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        echo "[ERROR] Game directory not found or invalid: $game_dir" >&2
        echo "Usage: gamectl pfx <game_dir> [winecfg|regedit|cmd|shell|kill|clean|winetricks] [args...]" >&2
        return 1
    fi

    # Canonicalize game_dir path
    game_dir="$(cd "$game_dir" 2>/dev/null && pwd || echo "$game_dir")"
    local pfx_dir="$game_dir/pfx"
    local runner_bin
    runner_bin="$(find_runner "$game_dir" 2>/dev/null || true)"
    [ -z "$runner_bin" ] && runner_bin="wine"

    # AppID resolution
    local appid="0"
    if [ -f "$game_dir/steam_appid.txt" ]; then
        appid=$(tr -dc '0-9' < "$game_dir/steam_appid.txt")
        [ -z "$appid" ] && appid="0"
    fi

    # Wineserver resolution
    local ws_bin
    ws_bin="$(get_wineserver_bin "$runner_bin" 2>/dev/null || echo "")"

    # Interactive menu if action is empty and stdin is terminal
    if [ -z "$action" ]; then
        if [ -t 0 ]; then
            if command -v fzf >/dev/null 2>&1; then
                flush_tty_input
                local game_name
                game_name="$(basename "$game_dir")"
                local pfx_status="[NOT FOUND]"
                local pfx_color="\033[38;5;203m"
                local pfx_size="0 B"
                if [ -d "$pfx_dir" ]; then
                    pfx_status="[ACTIVE]"
                    pfx_color="\033[38;5;120m"
                    pfx_size="$(du -sh "$pfx_dir" 2>/dev/null | awk '{print $1}' || echo "N/A")"
                fi

                local pfx_palette
                pfx_palette=$(cat <<EOF
winecfg	Wine Configuration	Configure Audio, Graphics, Windows Version & DLL Overrides
regedit	Registry Editor	Windows Registry Editor (regedit.exe)
cmd	Command Prompt	Windows Command Prompt (cmd.exe)
shell	Host Bash Subshell	Spawn bash subshell with active WINEPREFIX & PATH
winetricks	Winetricks Manager	Launch winetricks GUI / Package Manager helper
kill	Kill Wineserver	Terminate locked / hung Wineserver process
clean	Wipe Wine Prefix	Create save snapshot backup & wipe entire pfx directory
EOF
)

                local preview_cmd
                preview_cmd="echo -e '\033[38;5;60m╭─ WINE PREFIX OVERVIEW ──────────────────────────────╮\033[0m\n  Game Title  : \033[1m$game_name\033[0m\n  Directory   : $game_dir\n  Prefix Path : $pfx_dir\n  Active Wine : \033[38;5;111m$runner_bin\033[0m\n  Status      : ${pfx_color}${pfx_status}\033[0m (Size: $pfx_size)\n\033[38;5;60m╰─────────────────────────────────────────────────────╯\033[0m\n\033[38;5;60m╭─ ACTION DETAIL ─────────────────────────────────────╮\033[0m\n  Tool   : \033[1m{1}\033[0m - {2}\n  Desc   : {3}\n\033[38;5;60m╰─────────────────────────────────────────────────────╯\033[0m'"

                local pfx_sel fzf_rc=0
                pfx_sel=$(echo "$pfx_palette" | fzf \
                    --delimiter=$'\t' \
                    --with-nth=1,2 \
                    --border-label="  ╢ gamectl :: Wine Prefix Manager :: $game_name ╟  " \
                    --border-label-pos=2 \
                    --header="PREFIX PALETTE (Enter: Execute │ Esc: Return)" \
                    --prompt="Prefix > " \
                    --preview="$preview_cmd" \
                    --preview-window=down:50%:border-rounded:wrap \
                    --height=70% \
                    --reverse 2>/dev/null) || fzf_rc=$?

                [ "$fzf_rc" -eq 130 ] && return 0
                [ -z "$pfx_sel" ] && return 0

                action=$(echo "$pfx_sel" | awk -F'\t' '{print $1}')
            else
                echo "${UI_BOX}╭─ WINE PREFIX SWISS ARMY KNIFE ──────────────────────────────╮${UI_RST}"
                echo "│ ${UI_CYAN}Game Directory${UI_RST} : ${UI_BOLD}$game_dir${UI_RST}"
                echo "│ ${UI_CYAN}Prefix Path   ${UI_RST} : ${UI_BOLD}$pfx_dir${UI_RST}"
                echo "│ ${UI_CYAN}Active Runner ${UI_RST} : ${UI_GREEN}$runner_bin${UI_RST}"
                echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"
                echo "  ${UI_PURPLE}1)${UI_RST} winecfg      ${UI_DIM}(Wine Audio, Graphics & Windows Version Config)${UI_RST}"
                echo "  ${UI_PURPLE}2)${UI_RST} regedit      ${UI_DIM}(Windows Registry Editor)${UI_RST}"
                echo "  ${UI_PURPLE}3)${UI_RST} cmd          ${UI_DIM}(Windows Command Prompt)${UI_RST}"
                echo "  ${UI_PURPLE}4)${UI_RST} shell        ${UI_DIM}(Host Bash Subshell with active WINEPREFIX)${UI_RST}"
                echo "  ${UI_PURPLE}5)${UI_RST} winetricks   ${UI_DIM}(Winetricks GUI / Package Manager)${UI_RST}"
                echo "  ${UI_AMBER}6)${UI_RST} kill         ${UI_DIM}(Terminate locked / hung Wineserver)${UI_RST}"
                echo "  ${UI_RED}7)${UI_RST} clean        ${UI_DIM}(Backup Saves & Wipe Entire Wine Prefix)${UI_RST}"
                echo "  ${UI_CYAN}8)${UI_RST} Exit"
                echo
                local choice=""
                read -t 15 -r -p "Select action [1-8]: " choice || choice="8"
                case "$choice" in
                    1) action="winecfg" ;;
                    2) action="regedit" ;;
                    3) action="cmd" ;;
                    4) action="shell" ;;
                    5) action="winetricks" ;;
                    6) action="kill" ;;
                    7) action="clean" ;;
                    *) echo "[INFO] Operation canceled."; return 0 ;;
                esac
            fi
        else
            echo "Usage: gamectl pfx <game_dir> [winecfg|regedit|cmd|shell|kill|clean|winetricks] [args...]" >&2
            return 1
        fi
    fi

    case "$action" in
        kill)
            echo "[INFO] Sending force termination signal (wineserver -k) to prefix: $pfx_dir"
            if [ -d "$pfx_dir" ]; then
                if [ -n "$ws_bin" ]; then
                    WINEPREFIX="$pfx_dir" "$ws_bin" -k 2>/dev/null || true
                elif command -v wineserver >/dev/null 2>&1; then
                    WINEPREFIX="$pfx_dir" wineserver -k 2>/dev/null || true
                fi
            fi
            echo "[VERIFIED] Wineserver for prefix $pfx_dir has been stopped."
            return 0
            ;;
        clean)
            echo "[INFO] Starting Wine prefix cleanup: $pfx_dir"
            if [ ! -d "$pfx_dir" ]; then
                echo "[INFO] Prefix directory $pfx_dir does not exist, nothing to clean."
                return 0
            fi

            local is_dry_run=false auto_yes=false
            for arg in "$@"; do
                if [ "$arg" = "--dry-run" ] || [ "$arg" = "-n" ]; then
                    is_dry_run=true
                elif [ "$arg" = "-y" ] || [ "$arg" = "--yes" ]; then
                    auto_yes=true
                fi
            done

            if [ "$is_dry_run" = true ]; then
                local pfx_sz="0"
                pfx_sz=$(du -sh "$pfx_dir" 2>/dev/null | cut -f1 || echo "unknown")
                echo "[INFO] [DRY-RUN] Target Wine prefix directory: $pfx_dir (Size: $pfx_sz)"
                echo "[INFO] [DRY-RUN] Would create pre-wipe savegame backup snapshot via backup_save."
                echo "[INFO] [DRY-RUN] Would terminate wineserver process."
                echo "[INFO] [DRY-RUN] Would remove prefix directory: $pfx_dir"
                echo "[INFO] [DRY-RUN] Wine prefix cleanup simulated successfully (no files deleted)."
                return 0
            fi

            # 1. Create save snapshot backup
            backup_save "$game_dir" true || true

            # 2. Kill running wineserver
            if [ -n "$ws_bin" ]; then
                WINEPREFIX="$pfx_dir" "$ws_bin" -k 2>/dev/null || true
            elif command -v wineserver >/dev/null 2>&1; then
                WINEPREFIX="$pfx_dir" wineserver -k 2>/dev/null || true
            fi
            sleep 0.2

            # 3. Confirmation check
            if [ "$auto_yes" = false ] && [ -t 0 ]; then
                echo -n "[WARN] Wipe entire Wine prefix ($pfx_dir)? Registry and Wine configuration will be reset. [y/N]: "
                local confirm=""
                read -t 10 -r confirm || confirm="n"
                echo
                if [[ ! "$confirm" =~ ^[yY] ]]; then
                    echo "[INFO] Prefix cleanup canceled."
                    return 0
                fi
            fi

            # 4. Remove pfx folder safely
            rm -rf "$pfx_dir"
            echo "[VERIFIED] Wine prefix wiped successfully ($pfx_dir removed)."
            return 0
            ;;
        shell)
            echo "[INFO] Spawning interactive bash subshell inside prefix environment: $pfx_dir"
            echo "[INFO] Active environment: WINEPREFIX=$pfx_dir, RUNNER=$runner_bin"
            echo "[INFO] Type 'exit' to return to gamectl."
            (
                export WINEPREFIX="$pfx_dir"
                export GAMECTL_RUNNER="$runner_bin"
                if [[ "$runner_bin" =~ proton ]]; then
                    export STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_CLIENT_INSTALL_PATH:-$(get_steam_root 2>/dev/null || echo "$HOME/.local/share/Steam")}"
                    export STEAM_COMPAT_DATA_PATH="$game_dir"
                    export STEAM_COMPAT_APP_ID="$appid"
                    local p_bin_dir
                    p_bin_dir="$(dirname "$runner_bin")/files/bin"
                    [ -d "$p_bin_dir" ] && export PATH="$p_bin_dir:$PATH"
                fi
                cd "$game_dir" || true
                exec bash -i
            )
            return 0
            ;;
        winecfg|regedit|cmd)
            mkdir -p "$pfx_dir"
            echo "[INFO] Executing $action inside prefix: $pfx_dir (Runner: $runner_bin)..."
            local target_exec="$action"
            [ "$action" = "cmd" ] && target_exec="cmd.exe"

            local s_root
            s_root="$(get_steam_root 2>/dev/null || echo "$HOME/.local/share/Steam")"

            case "$runner_bin" in
                umu-run)
                    WINEPREFIX="$pfx_dir" GAMEID="$appid" umu-run "$target_exec" "$@"
                    ;;
                *proton*)
                    STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_CLIENT_INSTALL_PATH:-$s_root}" \
                    STEAM_COMPAT_DATA_PATH="$game_dir" \
                    STEAM_COMPAT_APP_ID="$appid" \
                    WINEPREFIX="$pfx_dir" \
                    "$runner_bin" run "$target_exec" "$@"
                    ;;
                *)
                    WINEPREFIX="$pfx_dir" "$runner_bin" "$target_exec" "$@"
                    ;;
            esac
            ;;
        winetricks)
            if ! command -v winetricks >/dev/null 2>&1; then
                echo "[ERROR] 'winetricks' binary not found on host system." >&2
                echo "[INFO] Install winetricks via your distribution package manager (e.g. pacman -S winetricks / apt install winetricks)." >&2
                return 1
            fi
            mkdir -p "$pfx_dir"
            echo "[INFO] Launching winetricks inside prefix: $pfx_dir"
            WINEPREFIX="$pfx_dir" winetricks "$@"
            ;;
        *)
            echo "[ERROR] Unknown prefix action: '$action'" >&2
            echo "Supported actions: winecfg, regedit, cmd, shell, kill, clean, winetricks" >&2
            return 1
            ;;
    esac
}

# Check if host GPU is Intel Haswell / 4th Gen Core (prone to Mesa GL threaded asset decompression crashes)
is_haswell_gpu() {
    local gpu_info=""
    if command -v lspci >/dev/null 2>&1; then
        gpu_info=$(lspci 2>/dev/null | grep -E "VGA|3D" || true)
    fi
    if [ -z "$gpu_info" ] && [ -d /sys/bus/pci/devices ]; then
        gpu_info=$(cat /sys/bus/pci/devices/*/uevent 2>/dev/null | grep -E "PCI_ID=" || true)
    fi
    if echo "$gpu_info" | grep -qi -E "Haswell|4th Gen Core"; then
        return 0
    fi
    return 1
}

# Dynamically detect host native display resolution via DRM / Wayland / X11
get_native_resolution() {
    local res=""
    # Priority 1: DRM kernel modes (direct & universal across all compositors/X11)
    for m_file in /sys/class/drm/card*-*/modes; do
        [ -f "$m_file" ] || continue
        local s_file="$(dirname "$m_file")/status"
        if [ -f "$s_file" ] && grep -q "^connected" "$s_file" 2>/dev/null; then
            local line
            line=$(head -n 1 "$m_file" 2>/dev/null | tr -d '[:space:]')
            if [[ "$line" =~ ^[0-9]+x[0-9]+$ ]]; then
                res="$line"
                break
            fi
        fi
    done

    # Priority 2: Hyprland monitor inspection
    if [ -z "$res" ] && command -v hyprctl >/dev/null 2>&1; then
        res=$(hyprctl monitors 2>/dev/null | grep -E '^[[:space:]]*[0-9]+x[0-9]+@' | head -n 1 | sed -E 's/.*([0-9]+x[0-9]+)@.*/\1/' || true)
    fi

    # Priority 3: X11 / Xwayland via xrandr
    if [ -z "$res" ] && command -v xrandr >/dev/null 2>&1; then
        res=$(xrandr --current 2>/dev/null | grep -E '\bconnected\b' | grep -o -E '[0-9]+x[0-9]+\+[0-9]+\+[0-9]+' | head -n 1 | cut -d'+' -f1 || true)
        [ -z "$res" ] && res=$(xrandr --current 2>/dev/null | grep -E '^[[:space:]]+[0-9]+x[0-9]+' | head -n 1 | awk '{print $1}' || true)
    fi

    # Fallback default
    if [[ ! "$res" =~ ^[0-9]+x[0-9]+$ ]]; then
        res="1920x1080"
    fi
    echo "$res"
}

# Dynamically calculate Gamescope display & FSR render arguments based on native resolution
get_default_gamescope_args() {
    local n_res
    n_res=$(get_native_resolution)
    local nw="${n_res%x*}"
    local nh="${n_res#*x}"

    local rw rh
    if [ "$nw" -ge 3840 ] && [ "$nh" -ge 2160 ]; then
        rw=2560; rh=1440
    elif [ "$nw" -ge 2560 ] && [ "$nh" -ge 1440 ]; then
        rw=1920; rh=1080
    elif [ "$nw" -eq 1920 ] && [ "$nh" -eq 1080 ]; then
        rw=1280; rh=720
    elif [ "$nw" -eq 1600 ] && [ "$nh" -eq 900 ]; then
        rw=1280; rh=720
    elif [ "$nw" -eq 1280 ] && [ "$nh" -eq 800 ]; then
        rw=960; rh=600
    else
        rw=$(( (nw * 2 / 3 + 1) / 2 * 2 ))
        rh=$(( (nh * 2 / 3 + 1) / 2 * 2 ))
    fi
    echo "-W $rw -H $rh -w $nw -h $nh -F fsr -f"
}

# Check if systemd user daemon and cgroups v2 scope unit execution is supported
check_systemd_scope_support() {
    if command -v systemd-run >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1; then
        if systemd-run --user --scope --quiet true 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# Detect discrete secondary GPU vendor on hybrid systems (NVIDIA, AMD, Intel Arc)
detect_dgpu_vendor() {
    if [ -n "${GAMECTL_DGPU_VENDOR:-}" ]; then
        echo "$GAMECTL_DGPU_VENDOR"
        return 0
    fi

    local vga_count=0
    local vendors=()

    for dev in /sys/bus/pci/devices/*; do
        [ -f "$dev/class" ] || continue
        local pci_class
        pci_class=$(cat "$dev/class" 2>/dev/null || echo "")
        case "$pci_class" in
            0x0302*|0x030200*)
                # Secondary 3D controller (Optimized for 3D acceleration / dGPU)
                local v_id
                v_id=$(cat "$dev/vendor" 2>/dev/null || echo "")
                case "$v_id" in
                    0x10de) echo "nvidia"; return 0 ;;
                    0x1002) echo "amd"; return 0 ;;
                    0x8086) echo "intel"; return 0 ;;
                esac
                ;;
            0x0300*|0x030000*)
                vga_count=$((vga_count + 1))
                local v_id
                v_id=$(cat "$dev/vendor" 2>/dev/null || echo "")
                vendors+=("$v_id")
                ;;
        esac
    done

    # If multiple display controllers exist without a specific 0x0302 class device
    if [ "$vga_count" -gt 1 ]; then
        for v in "${vendors[@]}"; do
            if [ "$v" = "0x10de" ]; then
                echo "nvidia"
                return 0
            fi
        done
        local has_amd=false has_intel=false amd_count=0
        for v in "${vendors[@]}"; do
            [ "$v" = "0x1002" ] && { has_amd=true; amd_count=$((amd_count + 1)); }
            [ "$v" = "0x8086" ] && has_intel=true
        done
        if [ "$has_amd" = true ] && [ "$has_intel" = true ]; then
            echo "amd"
            return 0
        fi
        if [ "$amd_count" -gt 1 ]; then
            echo "amd"
            return 0
        fi
    fi

    echo "none"
    return 0
}

# Construct rootless Bubblewrap (bwrap) security sandbox argument array
build_sandbox_command() {
    local gdir="$1"
    declare -ga GAMECTL_SANDBOX_PREFIX=()

    if ! command -v bwrap >/dev/null 2>&1; then
        echo "[WARN] bubblewrap (bwrap) not found in PATH. Sandboxing skipped." >&2
        return 1
    fi

    local run_uid="${UID:-$(id -u)}"
    local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$run_uid}"
    local wayland_socket="${WAYLAND_DISPLAY:-wayland-0}"
    local xauth_file="${XAUTHORITY:-$HOME/.Xauthority}"

    GAMECTL_SANDBOX_PREFIX=(
        bwrap
        --ro-bind /usr /usr
        --ro-bind-try /lib /lib
        --ro-bind-try /lib64 /lib64
        --ro-bind-try /bin /bin
        --ro-bind-try /sbin /sbin
        --ro-bind-try /etc /etc
        --proc /proc
        --dev /dev
        --ro-bind /sys /sys
        --tmpfs /tmp
        --ro-bind-try /tmp/.X11-unix /tmp/.X11-unix
        --tmpfs /run
        --tmpfs "/run/user/$run_uid"
        --ro-bind-try "$runtime_dir/wayland-0" "$runtime_dir/wayland-0"
        --ro-bind-try "$runtime_dir/$wayland_socket" "$runtime_dir/$wayland_socket"
        --bind-try "$runtime_dir/pipewire-0" "$runtime_dir/pipewire-0"
        --bind-try "$runtime_dir/pulse" "$runtime_dir/pulse"
        --bind-try "$runtime_dir/gamectl-$run_uid" "$runtime_dir/gamectl-$run_uid"
        --tmpfs "$HOME"
        --ro-bind-try "$xauth_file" "$xauth_file"
        --bind-try "$HOME/.config/gamectl" "$HOME/.config/gamectl"
        --ro-bind-try "$HOME/.local/share/Steam" "$HOME/.local/share/Steam"
        --ro-bind-try "$HOME/.local/share/gbe-fork" "$HOME/.local/share/gbe-fork"
        --ro-bind-try "$HOME/.steam" "$HOME/.steam"
        --bind-try "$HOME/.local/share/vulkan" "$HOME/.local/share/vulkan"
        --bind "$gdir" "$gdir"
        --chdir "$gdir"
        --unshare-user
        --unshare-ipc
        --unshare-pid
        --die-with-parent
    )
    return 0
}

# Resolve and build wrapper prefix command array (gamemoderun, mangohud, gamescope)
build_wrapper_command() {
    local gdir="$1"
    shift || true
    local opt_gamemode="" opt_hud="" opt_gamescope="" opt_fsr="" opt_systemd_scope="" opt_prime="" opt_sandbox="" opt_allow_unshielded=""
    local remaining_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --hud|--mangohud) opt_hud=1; shift ;;
            --no-hud|--no-mangohud) opt_hud=0; shift ;;
            --gamemode) opt_gamemode=1; shift ;;
            --no-gamemode) opt_gamemode=0; shift ;;
            --gamescope) opt_gamescope=1; shift ;;
            --no-gamescope) opt_gamescope=0; shift ;;
            --fsr) opt_fsr=1; opt_gamescope=1; shift ;;
            --no-fsr) opt_fsr=0; shift ;;
            --glthread) opt_glthread=1; shift ;;
            --no-glthread) opt_glthread=0; shift ;;
            --scope|--systemd-scope) opt_systemd_scope=1; shift ;;
            --no-scope|--no-systemd-scope) opt_systemd_scope=0; shift ;;
            --prime) opt_prime=1; shift ;;
            --no-prime) opt_prime=0; shift ;;
            --sandbox) opt_sandbox=1; shift ;;
            --no-sandbox) opt_sandbox=0; shift ;;
            --allow-unshielded) opt_allow_unshielded=1; shift ;;
            --) shift; remaining_args+=("$@"); break ;;
            *) remaining_args+=("$1"); shift ;;
        esac
    done

    # 1. Base defaults
    local use_gm=0 use_hud=0 use_scope=0 use_fsr=0 use_glthread=0 use_systemd_scope="" use_prime=0 use_sandbox=0
    local gscope_args
    gscope_args=$(get_default_gamescope_args)

    # 2. Config file hierarchy: Global (~/.config/gamectl/wrappers) -> Per-game override ($gdir/.wrappers)
    local w_cfgs=("$HOME/.config/gamectl/wrappers")
    [ -n "$gdir" ] && w_cfgs+=("$gdir/.wrappers")
    local w_cfg
    for w_cfg in "${w_cfgs[@]}"; do
        if [ -f "$w_cfg" ]; then
            while IFS='=' read -r k v || [ -n "$k" ]; do
                k="${k//[[:space:]]/}"
                v="${v#"${v%%[![:space:]]*}"}"
                v="${v%"${v##*[![:space:]]}"}"
                v="${v#\"}"
                v="${v%\"}"
                [[ "$k" =~ ^# ]] && continue
                case "$k" in
                    gamemode) use_gm="$v" ;;
                    hud|mangohud) use_hud="$v" ;;
                    gamescope) use_scope="$v" ;;
                    fsr) use_fsr="$v" ;;
                    glthread|mesa_glthread) use_glthread="$v" ;;
                    scope|systemd_scope) use_systemd_scope="$v" ;;
                    prime|dgpu) use_prime="$v" ;;
                    sandbox) use_sandbox="$v" ;;
                    gamescope_args) gscope_args="$v" ;;
                esac
            done < "$w_cfg"
        fi
    done

    # 4. Environment variable overrides
    [ -n "${GAMECTL_GAMEMODE:-}" ] && use_gm="$GAMECTL_GAMEMODE"
    [ -n "${GAMECTL_HUD:-${GAMECTL_MANGOHUD:-}}" ] && use_hud="${GAMECTL_HUD:-$GAMECTL_MANGOHUD}"
    [ -n "${GAMECTL_GAMESCOPE:-}" ] && use_scope="$GAMECTL_GAMESCOPE"
    [ -n "${GAMECTL_FSR:-}" ] && use_fsr="$GAMECTL_FSR"
    [ -n "${GAMECTL_GLTHREAD:-}" ] && use_glthread="$GAMECTL_GLTHREAD"
    [ -n "${GAMECTL_SCOPE:-${GAMECTL_SYSTEMD_SCOPE:-}}" ] && use_systemd_scope="${GAMECTL_SCOPE:-$GAMECTL_SYSTEMD_SCOPE}"
    [ -n "${GAMECTL_PRIME:-}" ] && use_prime="$GAMECTL_PRIME"
    [ -n "${GAMECTL_SANDBOX:-}" ] && use_sandbox="$GAMECTL_SANDBOX"
    [ -n "${GAMECTL_GAMESCOPE_ARGS:-}" ] && gscope_args="$GAMECTL_GAMESCOPE_ARGS"

    # 5. CLI flag overrides
    [ -n "$opt_gamemode" ] && use_gm="$opt_gamemode"
    [ -n "$opt_hud" ] && use_hud="$opt_hud"
    [ -n "$opt_gamescope" ] && use_scope="$opt_gamescope"
    [ -n "$opt_fsr" ] && use_fsr="$opt_fsr"
    [ -n "${opt_glthread:-}" ] && use_glthread="$opt_glthread"
    [ -n "${opt_systemd_scope:-}" ] && use_systemd_scope="$opt_systemd_scope"
    [ -n "$opt_prime" ] && use_prime="$opt_prime"
    [ -n "$opt_sandbox" ] && use_sandbox="$opt_sandbox"

    if [ -z "${use_systemd_scope:-}" ]; then
        if check_systemd_scope_support; then
            use_systemd_scope=1
        else
            use_systemd_scope=0
        fi
    fi

    local dgpu_vendor="none"
    if [ "$use_prime" = "1" ]; then
        dgpu_vendor=$(detect_dgpu_vendor)
        if [ "$dgpu_vendor" = "none" ]; then
            echo "[WARN] PRIME offloading requested (--prime) but no secondary dGPU detected." >&2
        fi
    fi

    declare -ga GAMECTL_SANDBOX_PREFIX=()
    if [ "$use_sandbox" = "1" ]; then
        build_sandbox_command "$gdir" || use_sandbox=0
    fi

    GAMECTL_ACTIVE_GLTHREAD="$use_glthread"
    GAMECTL_ACTIVE_SYSTEMD_SCOPE="$use_systemd_scope"
    GAMECTL_ACTIVE_PRIME="$use_prime"
    GAMECTL_ACTIVE_PRIME_VENDOR="$dgpu_vendor"
    GAMECTL_ACTIVE_SANDBOX="$use_sandbox"
    GAMECTL_ACTIVE_ALLOW_UNSHIELDED="${opt_allow_unshielded:-0}"

    local prefix=()
    if [ "$use_gm" = "1" ]; then
        if command -v gamemoderun >/dev/null 2>&1; then
            prefix+=("gamemoderun")
        else
            echo "[WARN] gamemoderun is enabled but binary not found in PATH." >&2
        fi
    fi

    if [ "$use_hud" = "1" ]; then
        if command -v mangohud >/dev/null 2>&1; then
            prefix+=("mangohud")
        else
            echo "[WARN] mangohud is enabled but binary not found in PATH." >&2
        fi
    fi

    if [ "$use_scope" = "1" ] || [ "$use_fsr" = "1" ]; then
        if command -v gamescope >/dev/null 2>&1; then
            prefix+=("gamescope")
            local active_args="$gscope_args"
            if [ "$use_fsr" = "1" ] && [[ ! "$active_args" =~ (-F|fsr|-U) ]]; then
                active_args="-F fsr $active_args"
            elif [ "$use_fsr" = "0" ]; then
                active_args=$(echo "$active_args" | sed -E 's/-F[[:space:]]+fsr//g' | xargs)
            fi
            if [ -n "$active_args" ]; then
                read -r -a parsed_args <<< "$active_args"
                prefix+=("${parsed_args[@]}")
            fi
            prefix+=("--")
        else
            echo "[WARN] gamescope is enabled but binary not found in PATH." >&2
        fi
    fi

    GAMECTL_WRAPPER_PREFIX=("${prefix[@]}")
    GAMECTL_REMAINING_ARGS=("${remaining_args[@]}")
}

# Interactive wrapper configuration for a game or global defaults
configure_wrappers() {
    local gdir="${1:-}"
    local title="${2:-}"
    local w_file

    if [ -n "$gdir" ] && [ -d "$gdir" ]; then
        [ -z "$title" ] && title="$(basename "$gdir")"
        w_file="$gdir/.wrappers"
    else
        title="Global Default Wrappers"
        mkdir -p "$HOME/.config/gamectl"
        w_file="$HOME/.config/gamectl/wrappers"
    fi

    local gm=0 hud=0 scope=0 fsr=0 glt=0
    local gscope_args
    gscope_args=$(get_default_gamescope_args)
    if [ -f "$HOME/.config/gamectl/wrappers" ]; then
        grep -q "^gamemode=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && gm=1
        grep -q -E "^(hud|mangohud)=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && hud=1
        grep -q "^gamescope=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && scope=1
        grep -q "^fsr=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && fsr=1
        grep -q -E "^(glthread|mesa_glthread)=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && glt=1
        local g_custom
        g_custom=$(grep -E '^[[:space:]]*gamescope_args[[:space:]]*=' "$HOME/.config/gamectl/wrappers" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*gamescope_args[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        [ -n "$g_custom" ] && gscope_args="$g_custom"
    fi
    if [ -f "$w_file" ]; then
        grep -q "^gamemode=1" "$w_file" 2>/dev/null && gm=1
        grep -q "^gamemode=0" "$w_file" 2>/dev/null && gm=0
        grep -q -E "^(hud|mangohud)=1" "$w_file" 2>/dev/null && hud=1
        grep -q -E "^(hud|mangohud)=0" "$w_file" 2>/dev/null && hud=0
        grep -q "^gamescope=1" "$w_file" 2>/dev/null && scope=1
        grep -q "^gamescope=0" "$w_file" 2>/dev/null && scope=0
        grep -q "^fsr=1" "$w_file" 2>/dev/null && fsr=1
        grep -q "^fsr=0" "$w_file" 2>/dev/null && fsr=0
        grep -q -E "^(glthread|mesa_glthread)=1" "$w_file" 2>/dev/null && glt=1
        grep -q -E "^(glthread|mesa_glthread)=0" "$w_file" 2>/dev/null && glt=0
        local w_custom
        w_custom=$(grep -E '^[[:space:]]*gamescope_args[[:space:]]*=' "$w_file" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*gamescope_args[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        [ -n "$w_custom" ] && gscope_args="$w_custom"
    fi

    while true; do
        local b_gm="${UI_DIM}[OFF]${UI_RST}" b_hud="${UI_DIM}[OFF]${UI_RST}"
        local b_scope="${UI_DIM}[OFF]${UI_RST}" b_fsr="${UI_DIM}[OFF]${UI_RST}" b_glt="${UI_DIM}[OFF]${UI_RST}"
        [ "$gm" = 1 ] && b_gm="${UI_GREEN}[ACTIVE]${UI_RST}"
        [ "$hud" = 1 ] && b_hud="${UI_GREEN}[ACTIVE]${UI_RST}"
        [ "$scope" = 1 ] && b_scope="${UI_GREEN}[ACTIVE]${UI_RST}"
        [ "$fsr" = 1 ] && b_fsr="${UI_GREEN}[ACTIVE]${UI_RST}"
        [ "$glt" = 1 ] && b_glt="${UI_GREEN}[ACTIVE]${UI_RST}"

        local h_gm="${UI_DIM}[N/A]${UI_RST}" h_hud="${UI_DIM}[N/A]${UI_RST}" h_scope="${UI_DIM}[N/A]${UI_RST}"
        command -v gamemoderun >/dev/null 2>&1 && h_gm="${UI_GREEN}[READY]${UI_RST}"
        command -v mangohud >/dev/null 2>&1 && h_hud="${UI_GREEN}[READY]${UI_RST}"
        command -v gamescope >/dev/null 2>&1 && h_scope="${UI_GREEN}[READY]${UI_RST}"

        local glt_hint="${UI_DIM}(Opt-in Performance)${UI_RST}"
        is_haswell_gpu && glt_hint="${UI_AMBER}(Intel Haswell: Keep OFF)${UI_RST}"

        local entries
        entries=$(cat <<EOF
1	GameMode (gamemoderun)	$b_gm
2	MangoHud (FPS & Telemetry)	$b_hud
3	Gamescope (Isolated Window)	$b_scope
4	Gamescope FSR Upscaling	$b_fsr
5	Mesa GL Threading (mesa_gl)	$b_glt $glt_hint
6	Preset: Balanced Performance	GameMode + MangoHud
7	Preset: Handheld / FSR	GameMode + MangoHud + Gamescope FSR
8	Reset: Safe Defaults	All Disabled
9	Save & Return	Save configuration
0	Cancel / Discard Changes	Discard changes and return
EOF
)

        flush_tty_input
        local selection fzf_rc=0
        selection=$(echo "$entries" | fzf \
            --delimiter=$'\t' \
            --with-nth=2,3 \
            --border-label="  ╢ gamectl :: Wrappers : $title ╟  " \
            --border-label-pos=2 \
            --header="RUNTIME WRAPPERS (Enter: Toggle/Select │ Esc: Save & Return)" \
            --prompt="Wrappers > " \
            --height=45% \
            --reverse 2>/dev/null) || fzf_rc=$?

        local opt
        if [ "$fzf_rc" -eq 130 ]; then
            opt="9"
        elif [ -z "$selection" ]; then
            continue
        else
            opt=$(echo "$selection" | cut -f1 | tr -d '[:space:]')
        fi

        case "$opt" in
            1) gm=$((1 - gm)) ;;
            2) hud=$((1 - hud)) ;;
            3) scope=$((1 - scope)) ;;
            4) fsr=$((1 - fsr)); [ "$fsr" = 1 ] && scope=1 ;;
            5) glt=$((1 - glt)) ;;
            6) gm=1; hud=1; scope=0; fsr=0; glt=0 ;;
            7) gm=1; hud=1; scope=1; fsr=1; glt=0 ;;
            8) gm=0; hud=0; scope=0; fsr=0; glt=0 ;;
            9)
                cat <<EOF > "$w_file"
# Runtime wrappers for $title
gamemode=$gm
hud=$hud
gamescope=$scope
fsr=$fsr
glthread=$glt
gamescope_args=$gscope_args
EOF
                log_msg "INFO" "WRAPPERS" "Saved wrapper configuration for $title -> $w_file (gm=$gm,hud=$hud,scope=$scope,fsr=$fsr,glt=$glt)"
                break
                ;;
            0|q|Q|cancel)
                return 0
                ;;
            *)
                continue
                ;;
        esac
    done
}

# Global Configuration Manager TUI
configure_global() {
    mkdir -p "$HOME/.config/gamectl"

    while true; do
        local p_name="Player" p_id=""
        if [ -f "$HOME/.config/gamectl/persona" ]; then
            p_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
            p_id=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        fi
        [ -z "$p_name" ] && p_name="${USER:-Player}"

        local w_desc="Default (All Disabled)"
        if [ -f "$HOME/.config/gamectl/wrappers" ]; then
            local act_w=()
            grep -q "^gamemode=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && act_w+=("GameMode")
            grep -q -E "^(hud|mangohud)=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && act_w+=("MangoHud")
            grep -q "^gamescope=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && act_w+=("Gamescope")
            grep -q "^fsr=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && act_w+=("FSR")
            grep -q -E "^(glthread|mesa_glthread)=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && act_w+=("MesaGL")
            [ ${#act_w[@]} -gt 0 ] && w_desc="${act_w[*]}"
        fi

        local lib_count=0
        [ -f "$HOME/.config/gamectl/libraries" ] && lib_count=$(grep -v -E '^[[:space:]]*(#|$)' "$HOME/.config/gamectl/libraries" 2>/dev/null | wc -l || echo 0)

        local r_host="Not Configured"
        if [ -f "$HOME/.config/gamectl/remote_host" ]; then
            r_host=$(head -n 1 "$HOME/.config/gamectl/remote_host" 2>/dev/null | tr -d '[:space:]')
            [ -z "$r_host" ] && r_host="Not Configured"
        fi

        local menu_entries
        menu_entries=$(cat <<EOF
1	Global LAN Persona	Name: $p_name | SteamID: ${p_id:-Auto}
2	Default Runtime Wrappers	$w_desc
3	Custom Game Libraries	$lib_count paths registered
4	Remote Companion Host	$r_host
5	Return to Master Dashboard Hub	Return
EOF
)

        flush_tty_input
        local selection fzf_rc=0
        selection=$(echo "$menu_entries" | fzf \
            --delimiter=$'\t' \
            --with-nth=2,3 \
            --border-label="  ╢ gamectl :: Global Settings (~/.config/gamectl/) ╟  " \
            --border-label-pos=2 \
            --header="GLOBAL SETTINGS (Enter: Configure │ Esc: Return to Dashboard)" \
            --prompt="Settings > " \
            --height=40% \
            --reverse 2>/dev/null) || fzf_rc=$?

        [ "$fzf_rc" -eq 130 ] && break
        [ -z "$selection" ] && continue

        local cfg_opt
        cfg_opt=$(echo "$selection" | cut -f1 | tr -d '[:space:]')

        case "$cfg_opt" in
            1)
                flush_tty_input
                local in_name_raw in_id_raw rc=0
                in_name_raw=$(: | fzf \
                    --print-query \
                    --border-label="  ╢ Configure LAN Persona Name ╟  " \
                    --border-label-pos=2 \
                    --header="Enter Player Name (Current: $p_name │ Enter: Confirm │ Esc: Cancel)" \
                    --prompt="Player Name > " \
                    --height=20% \
                    --reverse 2>/dev/null) || rc=$?
                [ "$rc" -eq 130 ] && continue
                local new_name
                new_name=$(echo "$in_name_raw" | head -n 1 | tr -d '\r\n')
                [ -n "$new_name" ] && p_name="$new_name"

                flush_tty_input
                in_id_raw=$(: | fzf \
                    --print-query \
                    --border-label="  ╢ Configure SteamID64 ╟  " \
                    --border-label-pos=2 \
                    --header="Enter 17-digit SteamID64, 'gen' for random ID, or blank for Auto (Current: ${p_id:-Auto})" \
                    --prompt="SteamID64 > " \
                    --height=20% \
                    --reverse 2>/dev/null) || rc=$?
                [ "$rc" -eq 130 ] && continue
                local new_id
                new_id=$(echo "$in_id_raw" | head -n 1 | tr -d '[:space:]')
                if [ "$new_id" = "gen" ]; then
                    p_id=$(generate_steamid64)
                elif [ -n "$new_id" ]; then
                    p_id="$new_id"
                fi

                cat <<EOF > "$HOME/.config/gamectl/persona"
[user::general]
account_name=$p_name
account_steamid=$p_id
language=english
EOF
                log_msg "INFO" "CONFIG" "Saved global LAN persona: $p_name | $p_id"
                ;;
            2)
                configure_wrappers ""
                ;;
            3)
                while true; do
                    local lib_items=""
                    local l_idx=1
                    if [ -f "$HOME/.config/gamectl/libraries" ]; then
                        while IFS= read -r l_path; do
                            [ -z "$l_path" ] && continue
                            [[ "$l_path" =~ ^[[:space:]]*# ]] && continue
                            lib_items+="${l_idx}\t[REMOVE] $l_path\tSelect to remove this library path\n"
                            l_idx=$((l_idx + 1))
                        done < "$HOME/.config/gamectl/libraries"
                    fi
                    local lib_menu
                    lib_menu=$(cat <<EOF
add	[+] Register New Library Path	Enter filesystem path (e.g. ~/Games)
EOF
)
                    [ -n "$lib_items" ] && lib_menu="${lib_menu}"$'\n'"$(printf '%b' "$lib_items")"
                    lib_menu="${lib_menu}"$'\n'"back	[<] Return to Global Settings	Back"

                    flush_tty_input
                    local lib_sel l_rc=0
                    lib_sel=$(echo "$lib_menu" | fzf \
                        --delimiter=$'\t' \
                        --with-nth=2,3 \
                        --border-label="  ╢ gamectl :: Custom Game Libraries ╟  " \
                        --border-label-pos=2 \
                        --header="CUSTOM LIBRARIES (Enter: Select │ Esc: Return)" \
                        --prompt="Libraries > " \
                        --height=40% \
                        --reverse 2>/dev/null) || l_rc=$?

                    [ "$l_rc" -eq 130 ] && break
                    [ -z "$lib_sel" ] && continue

                    local l_action
                    l_action=$(echo "$lib_sel" | cut -f1 | tr -d '[:space:]')

                    if [ "$l_action" = "add" ]; then
                        flush_tty_input
                        local in_p_raw p_rc=0
                        in_p_raw=$(: | fzf \
                            --print-query \
                            --border-label="  ╢ Add Game Library Directory ╟  " \
                            --border-label-pos=2 \
                            --header="Enter directory path (e.g. ~/Games │ Enter: Add │ Esc: Cancel)" \
                            --prompt="Path > " \
                            --height=20% \
                            --reverse 2>/dev/null) || p_rc=$?
                        [ "$p_rc" -eq 130 ] && continue
                        local new_path
                        new_path=$(echo "$in_p_raw" | head -n 1 | tr -d '\r\n')
                        if [ -n "$new_path" ]; then
                            new_path="${new_path/#\~/$HOME}"
                            echo "$new_path" >> "$HOME/.config/gamectl/libraries"
                            log_msg "INFO" "CONFIG" "Added custom library: $new_path"
                            invalidate_scan_cache
                        fi
                    elif [ "$l_action" = "back" ]; then
                        break
                    else
                        local target_line
                        target_line=$(grep -v -E '^[[:space:]]*(#|$)' "$HOME/.config/gamectl/libraries" 2>/dev/null | sed -n "${l_action}p")
                        if [ -n "$target_line" ]; then
                            grep -v -F "$target_line" "$HOME/.config/gamectl/libraries" > "$HOME/.config/gamectl/libraries.tmp" 2>/dev/null && mv "$HOME/.config/gamectl/libraries.tmp" "$HOME/.config/gamectl/libraries"
                            log_msg "INFO" "CONFIG" "Removed custom library: $target_line"
                            invalidate_scan_cache
                        fi
                    fi
                done
                ;;
            4)
                flush_tty_input
                local in_host_raw rc=0
                in_host_raw=$(: | fzf \
                    --print-query \
                    --border-label="  ╢ Remote Companion Host ╟  " \
                    --border-label-pos=2 \
                    --header="Enter SSH hostname/alias or '-' to clear (Current: $r_host │ Enter: Save │ Esc: Cancel)" \
                    --prompt="SSH Host > " \
                    --height=20% \
                    --reverse 2>/dev/null) || rc=$?
                [ "$rc" -eq 130 ] && continue
                local new_rhost
                new_rhost=$(echo "$in_host_raw" | head -n 1 | tr -d '[:space:]')
                if [ "$new_rhost" = "-" ]; then
                    rm -f "$HOME/.config/gamectl/remote_host"
                    log_msg "INFO" "CONFIG" "Cleared remote companion host"
                elif [ -n "$new_rhost" ]; then
                    echo "$new_rhost" > "$HOME/.config/gamectl/remote_host"
                    log_msg "INFO" "CONFIG" "Saved remote companion host: $new_rhost"
                fi
                ;;
            5)
                break
                ;;
            0|q|Q|cancel)
                break
                ;;
            *)
                continue
                ;;
        esac
    done
}


# --- [MODULE] src/runners/50_launcher.sh ---
# Interactive Live HUD for running game process (Zero-Flicker FZF Modal)
game_controller_hud() {
    local game_pid="$1"
    local title="$2"
    local log_file="$3"
    local gdir="$4"
    local gbin="$5"
    local info_file="$6"
    local run_type="$7"

    flush_tty_input

    while true; do
        local is_alive=0
        if kill -0 "$game_pid" 2>/dev/null; then
            is_alive=1
        fi

        local status_badge="[TERMINATED / EXITED]"
        local status_color="\033[38;5;111m"
        if [ "$is_alive" -eq 1 ]; then
            status_badge="[RUNNING]"
            status_color="\033[38;5;120m"
        fi

        local hud_palette
        if [ "$is_alive" -eq 1 ]; then
            hud_palette=$(cat <<EOF
1	Return to Game Library	Keep process $game_pid active in background
2	Return to Master Dashboard	Keep process $game_pid active in background
3	Live Game Log Stream	View recent process output & runtime traces
4	Stop Game (SIGTERM)	Send graceful shutdown signal to process
5	Force Kill Game (SIGKILL)	Emergency teardown & terminate wineserver
EOF
)
        else
            hud_palette=$(cat <<EOF
1	Return to Game Library	Game process has exited
2	Return to Master Dashboard	Game process has exited
3	View Recent Logs	Inspect final process stdout & error logs
EOF
)
        fi

        local preview_cmd
        preview_cmd="echo -e '\033[38;5;60m╭─ PROCESS STATUS ────────────────────────────────────╮\033[0m\n  Target Game : \033[1m$title\033[0m\n  Process PID : \033[1m$game_pid\033[0m ($run_type)\n  Status      : ${status_color}${status_badge}\033[0m\n  Log File    : $log_file\n\033[38;5;60m╰─────────────────────────────────────────────────────╯\033[0m\n\033[38;5;60m╭─ RECENT LOG TAIL (Last 15 lines) ──────────────────╮\033[0m'; tail -n 15 '$log_file' 2>/dev/null || echo '  (No logs recorded)'"

        local hud_sel fzf_rc=0
        hud_sel=$(echo "$hud_palette" | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2 \
            --border-label="  ╢ gamectl :: Process Controller :: $title ╟  " \
            --border-label-pos=2 \
            --header="PROCESS HUD (Enter: Execute │ Esc: Return to Library)" \
            --prompt="HUD > " \
            --preview="$preview_cmd" \
            --preview-window=down:55%:border-rounded:wrap \
            --height=70% \
            --reverse 2>/dev/null) || fzf_rc=$?

        [ "$fzf_rc" -eq 130 ] && return 0
        [ -z "$hud_sel" ] && return 0

        local opt
        opt=$(echo "$hud_sel" | awk -F'\t' '{print $1}')

        case "$opt" in
            1)
                return 0
                ;;
            2)
                return 10
                ;;
            3)
                if [ -s "$log_file" ]; then
                    tac "$log_file" 2>/dev/null | fzf \
                        --border-label="  ╢ Logs :: $title (PID: $game_pid) ╟  " \
                        --border-label-pos=2 \
                        --header="PROCESS LOGS (Esc / Enter: Return)" \
                        --prompt="Log > " \
                        --preview="echo -e '\033[38;5;60m╭─ LINE DETAIL ───────────────────────────────────────╮\033[0m\n{}\n\033[38;5;60m╰─────────────────────────────────────────────────────╯\033[0m'" \
                        --preview-window=down:30%:border-rounded:wrap \
                        --height=80% \
                        --reverse 2>/dev/null || true
                else
                    tui_modal_notice "Log Stream" "Log file is currently empty or does not exist:\n$log_file"
                fi
                ;;
            4)
                local s_unit=""
                [ -f "$info_file" ] && s_unit=$(grep -E '^SCOPE_UNIT=' "$info_file" 2>/dev/null | cut -d'=' -f2- || true)
                log_msg "INFO" "LAUNCH" "Sending SIGTERM to process PID $game_pid ($title)..."
                if [ -n "$s_unit" ]; then
                    systemctl --user stop "$s_unit.scope" 2>/dev/null || true
                fi
                kill "$game_pid" 2>/dev/null || true
                local wait_cnt=0
                while kill -0 "$game_pid" 2>/dev/null && [ "$wait_cnt" -lt 6 ]; do
                    sleep 0.2
                    wait_cnt=$((wait_cnt + 1))
                done
                if [ -d "$gdir/pfx" ]; then
                    local ws_bin
                    ws_bin="$(get_wineserver_bin "$(find_runner "$gdir" 2>/dev/null || true)" 2>/dev/null || true)"
                    [ -n "$ws_bin" ] && WINEPREFIX="$gdir/pfx" "$ws_bin" -w 2>/dev/null || true # wineserver -w
                fi
                if ! kill -0 "$game_pid" 2>/dev/null; then
                    rm -f "$info_file" 2>/dev/null || true
                    log_msg "INFO" "LAUNCH" "Game '$title' (PID $game_pid) terminated gracefully"
                    tui_modal_notice "Game Stopped" "Game '$title' (PID $game_pid) terminated gracefully."
                else
                    tui_modal_notice "Process Still Alive" "Process did not respond to SIGTERM. Select 'Force Kill' (Option 5) for immediate teardown."
                fi
                ;;
            5)
                local s_unit=""
                [ -f "$info_file" ] && s_unit=$(grep -E '^SCOPE_UNIT=' "$info_file" 2>/dev/null | cut -d'=' -f2- || true)
                log_msg "WARN" "LAUNCH" "Sending SIGKILL to process PID $game_pid ($title)..."
                if [ -n "$s_unit" ]; then
                    systemctl --user kill -s SIGKILL "$s_unit.scope" 2>/dev/null || true
                    systemctl --user stop "$s_unit.scope" 2>/dev/null || true
                fi
                kill -9 "$game_pid" 2>/dev/null || true
                if [ -d "$gdir/pfx" ]; then
                    local ws_bin
                    ws_bin="$(get_wineserver_bin "$(find_runner "$gdir" 2>/dev/null || true)" 2>/dev/null || true)"
                    [ -n "$ws_bin" ] && WINEPREFIX="$gdir/pfx" "$ws_bin" -k 2>/dev/null || true # wineserver -k
                fi
                rm -f "$info_file" 2>/dev/null || true
                log_msg "WARN" "LAUNCH" "Game '$title' (PID $game_pid) force-killed"
                tui_modal_notice "Force Terminated" "Game '$title' (PID $game_pid) force-killed via SIGKILL."
                ;;
            *)
                return 0
                ;;
        esac
    done
}

# Setup P2P Multiplayer Compatibility Layer, mod DLL overrides & Spacewar (AppID 480) entitlement
setup_onlinefix() {
    local gdir="${1:-}"
    shift || true
    local auto_yes=false
    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes|--non-interactive) auto_yes=true; shift ;;
            *) shift ;;
        esac
    done

    if [ -z "$gdir" ] || [ ! -d "$gdir" ]; then
        echo "[ERROR] Game directory not found: $gdir" >&2
        return 1
    fi
    gdir="$(cd "$gdir" && pwd)"

    echo "[INFO] Running OnlineFix setup and Spacewar entitlement audit in: $gdir..."

    # 1. Discover OnlineFix signature files
    local of_files
    of_files=$(find "$gdir" -maxdepth 3 \( -name "pfx" -o -name ".git" -o -name ".save_snapshots" -o -name "saves" \) -prune -o \( \
        -iname "OnlineFix64.dll" -o -iname "OnlineFix.dll" -o -iname "OnlineFix.ini" -o \
        -iname "dnet.dll" -o -iname "SteamOverlay64.dll" \
    \) -print 2>/dev/null || true)

    if [ -z "$of_files" ]; then
        echo "[WARN] No OnlineFix signatures found in this game directory." >&2
        echo "       Neither OnlineFix64.dll, OnlineFix.dll, nor OnlineFix.ini was found." >&2
        return 1
    fi
    echo "[VERIFIED] OnlineFix signature detected."

    # 2. Spacewar (AppID 480) Entitlement & ACF Check
    local s_primary
    s_primary="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"
    local has_spacewar=0
    if [ -f "$s_primary/appmanifest_480.acf" ]; then
        has_spacewar=1
    fi
    local sls_cfg="$HOME/.config/SLSsteam/config.yaml"
    if [ -f "$sls_cfg" ] && grep -q -E '^[[:space:]]*480:' "$sls_cfg" 2>/dev/null; then
        has_spacewar=1
    fi

    if [ "$has_spacewar" -eq 1 ]; then
        echo "[VERIFIED] Spacewar (AppID 480) already registered in Steam/SLSsteam library."
    else
        echo "[INFO] Spacewar (AppID 480) not registered yet. Running automatic registration..."
        sync_steam 480 "Spacewar" "$gdir"
        echo "[VERIFIED] Spacewar (AppID 480) successfully registered to Steam/SLSsteam."
    fi

    # 3. Audit & Sync OnlineFix.ini PlayerName
    local ini_file
    ini_file=$(find "$gdir" -maxdepth 3 \( -name "pfx" -o -name ".git" \) -prune -o -iname "OnlineFix.ini" -print 2>/dev/null | head -n 1)
    if [ -n "$ini_file" ] && [ -f "$ini_file" ]; then
        local curr_pname
        curr_pname=$(grep -E '^[[:space:]]*PlayerName[[:space:]]*=' "$ini_file" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*PlayerName[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        echo "[INFO] OnlineFix.ini detected: $ini_file"
        echo "       Current PlayerName: ${curr_pname:-[Unset]}"

        local persona_name=""
        if [ -f "$HOME/.config/gamectl/persona" ]; then
            persona_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        fi
        [ -z "$persona_name" ] && persona_name="${USER:-Player}"

        if [ -n "$persona_name" ] && [ "$persona_name" != "$curr_pname" ]; then
            local should_sync=false
            if [ "$auto_yes" = true ]; then
                should_sync=true
            elif [ -t 0 ]; then
                echo -n "       Synchronize PlayerName to '$persona_name'? [Y/n] (Auto-yes in 5s): "
                local confirm_sync=""
                read -t 5 -r confirm_sync || confirm_sync="y"
                echo
                if [[ ! "$confirm_sync" =~ ^[nN] ]]; then
                    should_sync=true
                fi
            else
                should_sync=true
            fi

            if [ "$should_sync" = true ]; then
                sed -i -E "s/^[[:space:]]*PlayerName[[:space:]]*=.*/PlayerName = $persona_name/" "$ini_file"
                echo "       ${UI_GREEN}[SUCCESS] PlayerName in OnlineFix.ini synchronized to: $persona_name${UI_RST}"
            fi
        fi
    fi

    echo "[VERIFIED] OnlineFix setup completed for: $(basename "$gdir")"
    return 0
}

# Launch game with performance wrapping and runner isolation
launch_game() {
    local gdir="$1"
    local gbin="$2"
    local title="$3"
    shift 3 || true

    echo "[INFO] Preparing launch: $title..."
    log_msg "INFO" "LAUNCH" "Preparing launch: $title ($gdir/$gbin)"
    backup_save "$gdir" true || true

    # Resolve wrappers and extra flags
    declare -a GAMECTL_WRAPPER_PREFIX=()
    declare -a GAMECTL_REMAINING_ARGS=()
    GAMECTL_ACTIVE_GLTHREAD=0
    build_wrapper_command "$gdir" "$@"
    local wrappers=("${GAMECTL_WRAPPER_PREFIX[@]}")
    local game_args=("${GAMECTL_REMAINING_ARGS[@]}")

    # Set Mesa performance env safely (only enable glthread if explicitly opted in)
    if [ "${GAMECTL_ACTIVE_GLTHREAD:-0}" = "1" ]; then
        export mesa_glthread=true
    else
        unset mesa_glthread
    fi
    export vblank_mode=0

    # Hybrid dGPU PRIME offloading
    if [ "${GAMECTL_ACTIVE_PRIME:-0}" = "1" ]; then
        case "${GAMECTL_ACTIVE_PRIME_VENDOR:-none}" in
            nvidia)
                export __NV_PRIME_RENDER_OFFLOAD=1
                export __GLX_VENDOR_LIBRARY_NAME=nvidia
                export __VK_LAYER_NV_optimus=NVIDIA_only
                echo "[INFO] Hybrid Graphics: Injected NVIDIA PRIME offload environment."
                ;;
            amd|intel)
                export DRI_PRIME=1
                echo "[INFO] Hybrid Graphics: Injected DRI_PRIME=1 offload environment."
                ;;
            *)
                export DRI_PRIME=1
                echo "[INFO] Hybrid Graphics: Fallback to DRI_PRIME=1 offload environment."
                ;;
        esac
    fi

    # Remedi Audio (DEFECT-03): Set buffer latency environment safely (PipeWire / PulseAudio)
    export PIPEWIRE_LATENCY="${GAMECTL_PIPEWIRE_LATENCY:-256/48000}"
    export PULSE_LATENCY_MSEC="${GAMECTL_PULSE_LATENCY:-60}"

    # Sovereign Steam Interceptor: traps and silences unshielded Steam Client calls
    local prev_path="$PATH"
    local interceptor_dir="$(get_runtime_dir)/interceptor"
    setup_steam_interceptor "$interceptor_dir"
    export PATH="$interceptor_dir:$PATH"

    # SLSsteam path prioritization for DRM stub wrapper intercept (fallback)
    if [ -d "$HOME/.local/share/SLSsteam/path" ]; then
        export PATH="$PATH:$HOME/.local/share/SLSsteam/path"
    fi

    # Capture current CPU scaling governor for clean restoration
    local prev_governor=""
    if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
        prev_governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "")
    fi

    # Attempt CPU scaling governor if permitted and not already in performance mode
    if [ -w /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
        if [ "$prev_governor" != "performance" ]; then
            echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true
        fi
    fi

    # Local state cleanup helper & signal trap
    local unit_name=""
    _restore_launch_state() {
        trap - INT TERM EXIT
        if [ -n "${unit_name:-}" ]; then
            systemctl --user stop "$unit_name.scope" 2>/dev/null || true
        fi
        if [ -n "${prev_governor:-}" ] && [ -w /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
            echo "$prev_governor" | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true
        fi
        if [ "${is_win:-false}" = true ] && [ -n "${gdir:-}" ] && [ -d "$gdir/pfx" ]; then
            # Remediation DEFECT-02: Flush wine prefix writes to disk (wineserver -w)
            local ws_bin
            ws_bin="$(get_wineserver_bin "${runner_bin:-}" 2>/dev/null || true)"
            [ -n "$ws_bin" ] && WINEPREFIX="$gdir/pfx" "$ws_bin" -w 2>/dev/null || true
        fi
        unset __NV_PRIME_RENDER_OFFLOAD __GLX_VENDOR_LIBRARY_NAME __VK_LAYER_NV_optimus DRI_PRIME
        [ -n "${prev_path:-}" ] && export PATH="$prev_path"
        type clean_stale_locks >/dev/null 2>&1 && clean_stale_locks || true
    }
    trap '_restore_launch_state; trap - INT TERM EXIT; return 130 2>/dev/null || exit 130' INT
    trap '_restore_launch_state; trap - INT TERM EXIT; return 143 2>/dev/null || exit 143' TERM
    trap '_restore_launch_state' EXIT

    if [ ${#wrappers[@]} -gt 0 ]; then
        echo "[INFO] Active wrappers: ${wrappers[*]}"
    fi

    cd "$gdir"

    # Pre-flight SteamStub DRM inspection & mitigation
    if [ -f "$gdir/$gbin" ] && detect_steamstub_drm "$gdir/$gbin"; then
        local stub_type
        stub_type=$(detect_steamstub_type "$gdir/$gbin" 2>/dev/null || echo "unknown")
        if [ "$stub_type" = "windows_pe" ]; then
            local unpacked_bin
            unpacked_bin=$(resolve_unpacked_binary "$gdir" "$gbin" 2>/dev/null || true)
            if [ -n "$unpacked_bin" ] && [ -f "$gdir/$unpacked_bin" ]; then
                echo "  ${UI_GREEN}[SUCCESS] SteamStub PE: Automatically switched to unpacked binary: $unpacked_bin${UI_RST}"
                gbin="$unpacked_bin"
            else
                echo "  ${UI_AMBER}[INFO] SteamStub PE DRM detected on ($gbin). Attempting Steamless unpacking...${UI_RST}"
                if unpack_steamstub_pe "$gdir/$gbin" "${runner_bin:-}" "${pfx_dir:-}"; then
                    unpacked_bin=$(resolve_unpacked_binary "$gdir" "$gbin" 2>/dev/null || true)
                    if [ -n "$unpacked_bin" ] && [ -f "$gdir/$unpacked_bin" ]; then
                        echo "  ${UI_GREEN}[SUCCESS] SteamStub PE: Unpacked binary generated: $unpacked_bin${UI_RST}"
                        gbin="$unpacked_bin"
                    fi
                else
                    echo "  ${UI_AMBER}[WARN] SteamStub PE detected on ($gbin) but Steamless CLI not available or unpacking failed.${UI_RST}"
                    echo "  ${UI_DIM}       If launch fails, unpack $gbin with Steamless (producing ${gbin%.*}.unpacked.exe).${UI_RST}"
                fi
            fi
        elif [ "$stub_type" = "linux_elf" ]; then
            echo "  ${UI_AMBER}[WARN] SteamStub DRM (.bind section) detected on Linux binary ($gbin).${UI_RST}"
            echo "  ${UI_CYAN}[INFO] Sovereign steam.sh interceptor active in PATH to trap unsolicited Steam Client calls.${UI_RST}"
        else
            echo "  ${UI_AMBER}[WARN] SteamStub DRM markers detected on binary ($gbin).${UI_RST}"
        fi
    fi

    # Pre-flight savegame redirection & offline DLC check
    mkdir -p -m 700 "$gdir/saves" 2>/dev/null || true
    if [ -f "$gdir/steam_appid.txt" ]; then
        local raw_appid
        raw_appid=$(tr -dc '0-9' < "$gdir/steam_appid.txt" 2>/dev/null || echo "")
        if [ -n "$raw_appid" ] && [ ! -f "$gdir/steam_settings/DLC.txt" ]; then
            fetch_dlc "$gdir" "$raw_appid" 2>/dev/null || true
        fi
    fi

    # Pre-flight GBE auto-injection & Sovereign Hard-Stop Guard
    local allow_unshielded="${GAMECTL_ACTIVE_ALLOW_UNSHIELDED:-${GAMECTL_ALLOW_UNSHIELDED:-0}}"
    local has_steam_api=false
    local probe_candidates=()
    while IFS= read -r api_found || [ -n "$api_found" ]; do
        [ -f "$api_found" ] && probe_candidates+=("$api_found")
    done < <(find "$gdir" -maxdepth 4 \
        \( -name "pfx" -o -name ".git" -o -name "saves" -o -name ".save_snapshots" \) -prune \
        -o \( -name "steam_api64.dll" -o -name "steam_api.dll" -o -name "libsteam_api.so" \) -print 2>/dev/null)

    if [ ${#probe_candidates[@]} -gt 0 ]; then
        has_steam_api=true
        local unshielded_candidates=()
        for api_cand in "${probe_candidates[@]}"; do
            local c_sz
            c_sz=$(stat -c%s "$api_cand" 2>/dev/null || echo 0)
            if [ "$c_sz" -ge 5000000 ] || [ -f "$api_cand.orig" ]; then
                : # Already shielded
            else
                unshielded_candidates+=("$api_cand")
            fi
        done

        if [ ${#unshielded_candidates[@]} -gt 0 ]; then
            echo "  ${UI_AMBER}[INFO] Steamworks API detected without emulator shield. Attempting auto-injection...${UI_RST}"
            inject_game "$gdir" "" --no-sync 2>/dev/null || true

            local still_unshielded=()
            for api_cand in "${unshielded_candidates[@]}"; do
                if [ -f "$api_cand" ]; then
                    local re_sz
                    re_sz=$(stat -c%s "$api_cand" 2>/dev/null || echo 0)
                    if [ "$re_sz" -lt 5000000 ] && [ ! -f "$api_cand.orig" ]; then
                        still_unshielded+=("$api_cand")
                    fi
                fi
            done

            if [ ${#still_unshielded[@]} -gt 0 ]; then
                if [ "$allow_unshielded" = "1" ]; then
                    echo "  ${UI_AMBER}[WARN] Launching unshielded Steamworks binary by user override (--allow-unshielded).${UI_RST}"
                else
                    echo "  ${UI_RED}================================================================${UI_RST}" >&2
                    echo "  ${UI_RED}[HARD-STOP] Valve Steamworks API detected without emulator shield!${UI_RST}" >&2
                    echo "  ${UI_AMBER}Unshielded library: ${still_unshielded[*]}${UI_RST}" >&2
                    echo "  ${UI_AMBER}Launch halted to prevent Valve DRM from spawning Steam Client ('PURCHASE' prompt).${UI_RST}" >&2
                    echo "  ${UI_DIM}Remedy: Run 'gamectl setup-gbe' to provision templates or 'gamectl inject \"$gdir\"'.${UI_RST}" >&2
                    echo "  ${UI_DIM}Bypass: Pass --allow-unshielded to override this sovereign safety gate.${UI_RST}" >&2
                    echo "  ${UI_RED}================================================================${UI_RST}" >&2
                    _restore_launch_state
                    return 1
                fi
            else
                invalidate_scan_cache
                echo "  ${UI_GREEN}[VERIFIED] GBE Fork emulator shield successfully engaged.${UI_RST}"
            fi
        else
            echo "  ${UI_GREEN}[VERIFIED] GBE Fork emulator shield confirmed active.${UI_RST}"
        fi
    fi

    # Check if target is a Windows executable (.exe / PE)
    local is_win=false
    case "$gbin" in
        *.exe|*.EXE) is_win=true ;;
    esac
    if [ "$is_win" = false ] && [ -f "$gdir/$gbin" ]; then
        if file -b "$gdir/$gbin" 2>/dev/null | grep -qi -E "PE32|MS Windows"; then
            is_win=true
        fi
    fi

    # Prepare runtime directory and log stream
    local run_dir
    run_dir="$(get_runtime_dir)"
    mkdir -p -m 700 "$run_dir/active_games"
    local safe_gbin
    safe_gbin=$(basename "$gbin" | tr -cd '[:alnum:]_-')
    local log_file="$run_dir/game_${safe_gbin}.log"
    : > "$log_file"

    local game_pid=""
    local run_type="Native Linux"

    local safe_title
    safe_title=$(echo "$title" | tr -cd '[:alnum:]_-')
    [ -z "$safe_title" ] && safe_title="game"

    local use_scope=false
    if [ "${GAMECTL_ACTIVE_SYSTEMD_SCOPE:-0}" = "1" ] && check_systemd_scope_support; then
        use_scope=true
    fi

    local -a sandbox_cmd=()
    if [ "${GAMECTL_ACTIVE_SANDBOX:-0}" = "1" ] && [ ${#GAMECTL_SANDBOX_PREFIX[@]} -gt 0 ]; then
        sandbox_cmd=("${GAMECTL_SANDBOX_PREFIX[@]}")
        echo "[INFO] Security Sandbox: Bubblewrap rootless filesystem isolation active."
    fi

    _exec_in_scope() {
        local -a final_cmd=()
        [ ${#sandbox_cmd[@]} -gt 0 ] && final_cmd+=("${sandbox_cmd[@]}")
        final_cmd+=("$@")
        if [ "$use_scope" = true ]; then
            exec systemd-run --user --scope --quiet --unit="gamectl-${safe_title}-${BASHPID}" --description="gamectl: ${title}" "${final_cmd[@]}"
        else
            exec "${final_cmd[@]}"
        fi
    }

    if [ "$is_win" = true ]; then
        local detected_overrides
        detected_overrides=$(detect_dll_overrides "$gdir")
        if [ -n "$detected_overrides" ]; then
            export WINEDLLOVERRIDES="$detected_overrides"
            echo "[INFO] Active DLL Overrides: $WINEDLLOVERRIDES"
        fi

        local runner_bin
        runner_bin=$(find_runner "$gdir" 2>/dev/null || true)
        if [ -z "$runner_bin" ]; then
            echo "[ERROR] Windows runner not found (umu-run, Proton, or Wine not installed)." >&2
            echo "        Install GE-Proton in ~/.local/share/Steam/compatibilitytools.d/ or install wine." >&2
            _restore_launch_state
            return 1
        fi

        local pfx_dir="$gdir/pfx"
        mkdir -p "$pfx_dir"
        local appid=""
        if [ -f "$gdir/steam_appid.txt" ]; then
            appid=$(tr -dc '0-9' < "$gdir/steam_appid.txt")
        fi
        [ -z "$appid" ] && appid="0"

        run_type="Windows ($(basename "$runner_bin"))"
        echo "[INFO] Launching Windows game via $(basename "$runner_bin") in background..."
        echo "[INFO] Isolated Wine Prefix: $pfx_dir"
        echo "[INFO] Log stream: $log_file"

        case "$runner_bin" in
            umu-run)
                (
                    export WINEPREFIX="$pfx_dir" GAMEID="$appid" WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-}"
                    _exec_in_scope "${wrappers[@]}" umu-run "$gdir/$gbin" "${game_args[@]}"
                ) > "$log_file" 2>&1 &
                game_pid=$!
                ;;
            *proton*)
                (
                    export STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_CLIENT_INSTALL_PATH:-$(get_steam_root 2>/dev/null || echo "$HOME/.local/share/Steam")}" \
                    STEAM_COMPAT_DATA_PATH="$gdir" \
                    STEAM_COMPAT_APP_ID="$appid" \
                    WINEPREFIX="$pfx_dir" \
                    WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-}"
                    _exec_in_scope "${wrappers[@]}" "$runner_bin" waitforexitandrun "$gdir/$gbin" "${game_args[@]}"
                ) > "$log_file" 2>&1 &
                game_pid=$!
                ;;
            *)
                (
                    export WINEPREFIX="$pfx_dir" WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-}"
                    _exec_in_scope "${wrappers[@]}" "$runner_bin" "$gdir/$gbin" "${game_args[@]}"
                ) > "$log_file" 2>&1 &
                game_pid=$!
                ;;
        esac
    else
        echo "[INFO] Launching $title (Native Linux) in background..."
        echo "[INFO] Log stream: $log_file"
        (
            export LD_LIBRARY_PATH=".:$gdir:${LD_LIBRARY_PATH:-}"
            _exec_in_scope "${wrappers[@]}" ./"$gbin" "${game_args[@]}"
        ) > "$log_file" 2>&1 &
        game_pid=$!
    fi

    if [ -z "$game_pid" ] || ! kill -0 "$game_pid" 2>/dev/null; then
        echo "[ERROR] Failed to launch game into background." >&2
        _restore_launch_state
        return 1
    fi

    if [ "$use_scope" = true ]; then
        unit_name="gamectl-${safe_title}-${game_pid}"
    fi

    local info_file="$run_dir/active_games/${game_pid}.info"
    cat <<EOF > "$info_file"
PID=$game_pid
TITLE=$title
DIR=$gdir
BIN=$gbin
LOG=$log_file
START=$(date +%s)
SCOPE_UNIT=$unit_name
EOF

    # Detached background watchdog to restore CPU governor and cleanup when process exits
    (
        wait "$game_pid" 2>/dev/null
        if [ -n "$unit_name" ]; then
            systemctl --user stop "$unit_name.scope" 2>/dev/null || true
        fi
        if [ "$is_win" = true ] && [ -d "$pfx_dir" ]; then
            # Remediation DEFECT-02: Wait for wineserver to flush data & release lockfile before snapshot (wineserver -w)
            local ws_bin
            ws_bin="$(get_wineserver_bin "${runner_bin:-}" 2>/dev/null || true)"
            [ -n "$ws_bin" ] && WINEPREFIX="$pfx_dir" "$ws_bin" -w 2>/dev/null || true
        fi
        rm -f "$info_file" 2>/dev/null || true
        log_msg "INFO" "LAUNCH" "Game '$title' (PID: $game_pid) exited"
        _restore_launch_state
    ) &

    echo "[VERIFIED] Game '$title' running in background (PID: $game_pid)."
    log_msg "INFO" "LAUNCH" "Game '$title' running in background (PID: $game_pid, Log: $log_file)"

    # If running interactively, invoke Game Controller HUD
    local hud_exit=0
    if [ -t 0 ]; then
        game_controller_hud "$game_pid" "$title" "$log_file" "$gdir" "$gbin" "$info_file" "$run_type" || hud_exit=$?
    fi

    trap - INT TERM EXIT
    return "$hud_exit"
}

# Sync savegame to remote companion host (Push)
sync_save_remote() {
    local gdir="$1"
    local title="${2:-Game}"
    local override_host="${3:-}"
    local is_dry_run=false

    for arg in "$@"; do
        if [ "$arg" = "--dry-run" ] || [ "$arg" = "-n" ]; then
            is_dry_run=true
        fi
    done

    local sdir="$gdir/saves"
    local rhost="$override_host"
    [ -z "$rhost" ] && rhost=$(get_remote_host)

    if [ ! -d "$sdir" ]; then
        echo "[ERROR] Portable saves directory not found in $gdir"
        return 1
    fi

    if [ -z "$rhost" ]; then
        echo "[WARN] Target remote host not configured."
        echo "       Define host in ~/.config/gamectl/remote_host or GAMECTL_REMOTE_HOST variable."
        return 1
    fi

    echo "[INFO] Checking connectivity to $rhost..."
    if ! ssh -q -o ConnectTimeout=1 -o BatchMode=yes "$rhost" exit 2>/dev/null; then
        echo "[WARN] Remote host '$rhost' offline or unreachable on local network."
        return 1
    fi

    echo "[INFO] Synchronizing savegame $title to $rhost..."
    local canon_gdir
    canon_gdir="$(cd "$gdir" 2>/dev/null && pwd || echo "$gdir")"

    local rel_path
    if [[ "$canon_gdir" == "$HOME/"* ]]; then
        rel_path="${canon_gdir#$HOME/}"
    else
        # For games stored on secondary drives (/mnt, /media, /data, etc.)
        rel_path="Games/$(basename "$canon_gdir")"
    fi
    rel_path="${rel_path#/}"

    local rsync_opts=("-avzP" "--exclude=*.tmp")
    [ "$is_dry_run" = true ] && rsync_opts+=("-n")

    if [ "$is_dry_run" = false ]; then
        ssh "$rhost" "mkdir -p \"~/$rel_path\""
    fi

    rsync "${rsync_opts[@]}" "$sdir/" "$rhost:\"~/$rel_path/saves/\""
    if [ "$is_dry_run" = true ]; then
        echo "[INFO] [DRY-RUN] Savegame synchronization simulated successfully."
    else
        echo "[VERIFIED] Savegame synchronization to $rhost completed."
    fi
    return 0
}

# Pull savegame from remote companion host to local workstation (Pull)
pull_save_remote() {
    local gdir="$1"
    local title="${2:-Game}"
    local override_host="${3:-}"
    local is_dry_run=false

    for arg in "$@"; do
        if [ "$arg" = "--dry-run" ] || [ "$arg" = "-n" ]; then
            is_dry_run=true
        fi
    done

    local sdir="$gdir/saves"
    local rhost="$override_host"
    [ -z "$rhost" ] && rhost=$(get_remote_host)

    if [ -z "$gdir" ] || [ ! -d "$gdir" ]; then
        echo "[ERROR] Target game directory not found: ${gdir:-<empty>}" >&2
        return 1
    fi

    if [ -z "$rhost" ]; then
        echo "[WARN] Target remote host not configured." >&2
        echo "       Define host in ~/.config/gamectl/remote_host or GAMECTL_REMOTE_HOST variable." >&2
        return 1
    fi

    echo "[INFO] Checking connectivity to $rhost..."
    if ! ssh -q -o ConnectTimeout=1 -o BatchMode=yes "$rhost" exit 2>/dev/null; then
        echo "[WARN] Remote host '$rhost' offline or unreachable on local network." >&2
        return 1
    fi

    local canon_gdir
    canon_gdir="$(cd "$gdir" 2>/dev/null && pwd || echo "$gdir")"

    local rel_path
    if [[ "$canon_gdir" == "$HOME/"* ]]; then
        rel_path="${canon_gdir#$HOME/}"
    else
        rel_path="Games/$(basename "$canon_gdir")"
    fi
    rel_path="${rel_path#/}"

    # Verify remote saves directory exists
    if ! ssh -q -o BatchMode=yes "$rhost" "[ -d \"~/$rel_path/saves\" ]" 2>/dev/null; then
        echo "[ERROR] Remote saves directory not found on $rhost: ~/$rel_path/saves" >&2
        return 1
    fi

    # Protect local savegame before pulling remote overwrites
    if [ "$is_dry_run" = false ] && [ -d "$sdir" ]; then
        backup_save "$gdir" true || true
    fi

    mkdir -p "$sdir"
    local rsync_opts=("-avzP" "--exclude=*.tmp")
    [ "$is_dry_run" = true ] && rsync_opts+=("-n")

    echo "[INFO] Pulling savegame for '$title' from $rhost:~/$rel_path/saves/ -> $sdir/..."
    rsync "${rsync_opts[@]}" "$rhost:\"~/$rel_path/saves/\"" "$sdir/"

    if [ "$is_dry_run" = true ]; then
        echo "[INFO] [DRY-RUN] Remote savegame pull simulated successfully (no local files modified)."
    else
        echo "[VERIFIED] Savegame pull from $rhost completed."
        log_msg "INFO" "SAVE" "Pulled savegame for '$title' from $rhost"
    fi
    return 0
}

# Aliases for remote savegame synchronization
sync_to_companion() {
    sync_save_remote "$@"
}

sync_to_tuf() {
    sync_save_remote "$@"
}

pull_from_companion() {
    pull_save_remote "$@"
}

pull_from_tuf() {
    pull_save_remote "$@"
}


# Inject GBE Fork emulator and portable saves into a game folder
inject_game() {
    local target_dir="$1"
    local appid="${2:-}"
    local sync_mode="${3:-all}"

    # Strip ANSI escape sequences
    target_dir=$(strip_ansi "$target_dir")
    [ -n "$appid" ] && appid=$(strip_ansi "$appid" | tr -dc '0-9')

    if [ ! -d "$target_dir" ]; then
        echo "[ERROR] Target directory not found: $target_dir" >&2
        return 1
    fi

    # Canonical path
    target_dir="$(cd "$target_dir" && pwd)"

    # Resolve AppID if not provided
    if [ -z "$appid" ]; then
        if [ -f "$target_dir/steam_appid.txt" ]; then
            appid=$(tr -dc '0-9' < "$target_dir/steam_appid.txt")
        fi
        if [ -z "$appid" ]; then
            local parent_dir
            parent_dir="$(dirname "$target_dir")"
            if [ "$(basename "$parent_dir")" = "common" ]; then
                local steamapps_dir
                steamapps_dir="$(dirname "$parent_dir")"
                local base_name
                base_name="$(basename "$target_dir")"
                for acf in "$steamapps_dir"/appmanifest_*.acf; do
                    [ -f "$acf" ] || continue
                    if grep -q "\"installdir\"[[:space:]]\+\"$base_name\"" "$acf" 2>/dev/null; then
                        appid=$(grep -E '^\s*"appid"' "$acf" | head -n 1 | sed -E 's/.*"appid"[[:space:]]+"([0-9]+)".*/\1/')
                        break
                    fi
                done
            fi
        fi
    fi

    echo "[INFO] Preparing GBE Fork injection in: $target_dir..."

    # 1. Identify Target Executable and Platform
    local gbin=""
    gbin=$(find_game_binary "$target_dir") || true

    local target_platform="linux"
    local arch="x64"
    local is_32bit=false

    # Check existing steam libraries in target folder
    local found_win64 found_win32 found_linux
    found_win64=$(find "$target_dir" -maxdepth 4 -name "steam_api64.dll" 2>/dev/null | head -n 1)
    found_win32=$(find "$target_dir" -maxdepth 4 -name "steam_api.dll" 2>/dev/null | head -n 1)
    found_linux=$(find "$target_dir" -maxdepth 4 -name "libsteam_api.so" 2>/dev/null | head -n 1)

    if [ -n "$gbin" ] && [ -f "$target_dir/$gbin" ]; then
        local btype
        btype=$(file -b "$target_dir/$gbin" 2>/dev/null || echo "")
        if echo "$btype" | grep -qi -E "PE32|MS Windows|\.exe"; then
            target_platform="windows"
            if echo "$btype" | grep -qi "PE32+"; then
                arch="x64"
                is_32bit=false
            elif echo "$btype" | grep -qi "32-bit"; then
                arch="x86"
                is_32bit=true
            else
                arch="x64"
                is_32bit=false
            fi
        else
            target_platform="linux"
            if echo "$btype" | grep -qi "32-bit"; then
                arch="x86"
                is_32bit=true
            else
                arch="x64"
                is_32bit=false
            fi
        fi
    elif [ -n "$found_linux" ]; then
        target_platform="linux"
        if file -b "$found_linux" | grep -qi "32-bit"; then
            arch="x86"
            is_32bit=true
        else
            arch="x64"
            is_32bit=false
        fi
    elif [ -n "$found_win64" ] || [ -n "$found_win32" ]; then
        target_platform="windows"
        if [ -n "$found_win64" ]; then
            arch="x64"
            is_32bit=false
        else
            arch="x86"
            is_32bit=true
        fi
    fi

    # 2. Perform Shim Injections (with backup of originals)
    local primary_shim_dir="$target_dir"

    # 2a. Windows Shim Injection (if windows steam files exist or target is windows)
    if [ -n "$found_win64" ] || [ -n "$found_win32" ] || [ "$target_platform" = "windows" ]; then
        local win_targets=()
        if [ -n "$found_win64" ]; then
            win_targets+=("$found_win64:x64")
        fi
        if [ -n "$found_win32" ]; then
            win_targets+=("$found_win32:x86")
        fi

        # If neither found but target is windows, determine destination based on detected arch or gbin location
        if [ ${#win_targets[@]} -eq 0 ] && [ "$target_platform" = "windows" ]; then
            local bin_subdir="$target_dir"
            [ -n "$gbin" ] && [ -f "$target_dir/$gbin" ] && bin_subdir="$(dirname "$target_dir/$gbin")"
            if [ "$is_32bit" = true ]; then
                win_targets+=("$bin_subdir/steam_api.dll:x86")
            else
                win_targets+=("$bin_subdir/steam_api64.dll:x64")
            fi
        fi

        for entry in "${win_targets[@]}"; do
            local t_dll="${entry%%:*}"
            local t_arch="${entry##*:}"
            local t_template
            t_template=$(get_gbe_template "windows" "$t_arch") || true

            if [ -z "$t_template" ] || [ ! -f "$t_template" ]; then
                echo "[WARN] Windows GBE Fork template ($t_arch) not found. Attempting automatic provisioning..." >&2
                setup_gbe_templates --yes --win-only >/dev/null 2>&1 || true
                t_template=$(get_gbe_template "windows" "$t_arch") || true
                if [ -z "$t_template" ] || [ ! -f "$t_template" ]; then
                    echo "[WARN] Windows GBE Fork template ($t_arch) not found. Run 'gamectl setup-gbe' to install." >&2
                    continue
                fi
            fi

            # Backup original Valve DLL if present (<7MB and .orig not existing)
            if [ -f "$t_dll" ]; then
                local sz
                sz=$(stat -c%s "$t_dll" 2>/dev/null || echo 0)
                if [ "$sz" -lt 7000000 ] && [ ! -f "$t_dll.orig" ]; then
                    cp -a "$t_dll" "$t_dll.orig"
                    echo "[INFO] Original $(basename "$t_dll") backed up to: $t_dll.orig"
                fi
            fi

            mkdir -p "$(dirname "$t_dll")"
            cp "$t_template" "$t_dll"
            chmod +x "$t_dll" 2>/dev/null || true
            primary_shim_dir="$(dirname "$t_dll")"
            echo "[INFO] Windows GBE Fork DLL ($t_arch) installed at: $t_dll"
        done
    fi

    # 2b. Linux Shim Injection (if linux steam files exist or target is linux)
    if [ -n "$found_linux" ] || [ "$target_platform" = "linux" ]; then
        local linux_arch="x64"
        if [ -n "$found_linux" ]; then
            if file -b "$found_linux" | grep -qi "32-bit"; then
                linux_arch="x86"
            fi
        elif [ "$is_32bit" = true ]; then
            linux_arch="x86"
        fi

        local target_so="$target_dir/libsteam_api.so"
        if [ -n "$found_linux" ]; then
            target_so="$found_linux"
        elif [ -d "$target_dir/lib64" ] && [ "$linux_arch" = "x64" ]; then
            target_so="$target_dir/lib64/libsteam_api.so"
        elif [ -d "$target_dir/lib32" ] && [ "$linux_arch" = "x86" ]; then
            target_so="$target_dir/lib32/libsteam_api.so"
        fi

        local src_so
        src_so=$(get_gbe_template "linux" "$linux_arch") || true
        if [ -z "$src_so" ] || [ ! -f "$src_so" ]; then
            echo "[WARN] Linux GBE Fork template ($linux_arch) not found. Attempting automatic provisioning..." >&2
            setup_gbe_templates --yes --linux-only >/dev/null 2>&1 || true
            src_so=$(get_gbe_template "linux" "$linux_arch") || true
        fi
        if [ -n "$src_so" ] && [ -f "$src_so" ]; then
            # Backup original Valve SO if present (<7MB and .orig not existing)
            if [ -f "$target_so" ]; then
                local sz
                sz=$(stat -c%s "$target_so" 2>/dev/null || echo 0)
                if [ "$sz" -lt 7000000 ] && [ ! -f "$target_so.orig" ]; then
                    cp -a "$target_so" "$target_so.orig"
                    echo "[INFO] Original libsteam_api.so backed up to: $target_so.orig"
                fi
            fi

            mkdir -p "$(dirname "$target_so")"
            cp "$src_so" "$target_so"
            chmod +x "$target_so"
            primary_shim_dir="$(dirname "$target_so")"
            echo "[INFO] Linux GBE Fork ELF ($linux_arch) installed at: $target_so"
        else
            [ "$target_platform" = "linux" ] && echo "[WARN] Linux GBE Fork template ($linux_arch) not found at: ${src_so:-empty}" >&2
        fi
    fi

    # 3. Setup steam_settings and configs.user.ini
    mkdir -p "$target_dir/steam_settings"
    local user_name=""
    local steamid=""

    # Check existing game persona or global persona
    if [ -f "$target_dir/steam_settings/configs.user.ini" ]; then
        user_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$target_dir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        steamid=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$target_dir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    if [ -z "$user_name" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        user_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    if [ -z "$steamid" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        steamid=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    [ -z "$user_name" ] && user_name="${USER:-Player}"
    if [ -z "$steamid" ]; then
        steamid=$(resolve_active_steamid)
    fi

    cat <<EOF > "$target_dir/steam_settings/configs.user.ini"
[user::general]
account_name=$user_name
account_steamid=$steamid
language=english

[user::saves]
local_save_path=./saves
EOF

    # Scaffold configs.app.ini to unlock all DLCs in GBE Fork
    if [ ! -f "$target_dir/steam_settings/configs.app.ini" ]; then
        cat <<EOF > "$target_dir/steam_settings/configs.app.ini"
[app::dlc]
unlock_all=1
EOF
    fi

    # Scaffold custom_broadcasts.txt if missing
    if [ ! -f "$target_dir/steam_settings/custom_broadcasts.txt" ]; then
        cat <<EOF > "$target_dir/steam_settings/custom_broadcasts.txt"
# GBE Fork LAN Custom Broadcast IP list
# Add peer IPs or broadcast subnets (one IP per line)
127.0.0.1
255.255.255.255
EOF
    fi

    # If shim is in a subfolder, link steam_settings beside it as per GBE specification
    if [ "$primary_shim_dir" != "$target_dir" ] && [ -d "$primary_shim_dir" ]; then
        ln -sfn "$target_dir/steam_settings" "$primary_shim_dir/steam_settings" 2>/dev/null || true
    fi

    # 4. Setup isolated portable saves folder and markers
    mkdir -p -m 700 "$target_dir/saves"
    chmod 700 "$target_dir/saves" 2>/dev/null || true
    echo -n "saves" > "$target_dir/local_save.txt"
    if [ "$primary_shim_dir" != "$target_dir" ] && [ -d "$primary_shim_dir" ]; then
        echo -n "saves" > "$primary_shim_dir/local_save.txt" 2>/dev/null || true
        ln -sfn "$target_dir/saves" "$primary_shim_dir/saves" 2>/dev/null || true
    fi

    # 5. Write steam_appid.txt if available
    if [ -n "$appid" ] && [ "$appid" != "STANDALONE" ]; then
        echo -n "$appid" > "$target_dir/steam_appid.txt"
        if [ "$primary_shim_dir" != "$target_dir" ] && [ -d "$primary_shim_dir" ]; then
            echo -n "$appid" > "$primary_shim_dir/steam_appid.txt" 2>/dev/null || true
        fi
        echo "[INFO] AppID $appid registered in: $target_dir/steam_appid.txt"
        fetch_dlc "$target_dir" "$appid"
        if [ "$sync_mode" != "--no-sync" ] && [ "$sync_mode" != "no-sync" ] && [ "$sync_mode" != "standalone" ]; then
            sync_steam "$appid" "$(basename "$target_dir")" "$target_dir"
        else
            echo "[INFO] Standalone Mode active: Skipping Steam Client synchronization."
        fi
    fi

    invalidate_scan_cache
    echo "[VERIFIED] GBE Fork successfully injected (Platform: $target_platform, Arch: $arch, Save: ./saves, AppID: ${appid:-None})"
    log_msg "INFO" "INJECT" "GBE Fork successfully injected for $(basename "$target_dir") (Platform: $target_platform, Arch: $arch, Save: ./saves, AppID: ${appid:-None})"
}


# CLI helper for launching games with wrappers and options
cli_launch() {
    local l_dir="${1:-}"
    shift || true
    local l_bin=""
    local l_title=""
    local l_flags=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --hud|--mangohud|--no-hud|--no-mangohud|--gamemode|--no-gamemode|--gamescope|--no-gamescope|--fsr|--no-fsr|--glthread|--no-glthread|--scope|--systemd-scope|--no-scope|--no-systemd-scope|--prime|--no-prime|--sandbox|--no-sandbox)
                l_flags+=("$1")
                shift
                ;;
            *)
                if [ -z "$l_bin" ]; then
                    l_bin="$1"
                elif [ -z "$l_title" ]; then
                    l_title="$1"
                else
                    l_flags+=("$1")
                fi
                shift
                ;;
        esac
    done

    [ -z "$l_title" ] && l_title="$(basename "$l_dir")"
    if [ -z "$l_bin" ]; then
        l_bin=$(find_game_binary "$l_dir" 2>/dev/null || echo "")
    fi

    if [ -n "$l_bin" ]; then
        launch_game "$l_dir" "$l_bin" "$l_title" "${l_flags[@]}"
    else
        echo "[ERROR] Executable binary not found in: $l_dir" >&2
        return 1
    fi
}


# --- [MODULE] src/diagnostics/60_doctor.sh ---
# System Diagnostics & Health Audit
doctor_audit() {
    local pass_cnt=0 warn_cnt=0 miss_cnt=0

    echo "${UI_BOX}╭─ GAMECTL SYSTEM DIAGNOSTICS & HEALTH AUDIT ─────────────────╮${UI_RST}"
    local os_str="Linux"
    [ -f /etc/os-release ] && os_str=$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d'=' -f2 | tr -d '"')
    echo "│ ${UI_CYAN}Host OS     ${UI_RST}: ${UI_BOLD}$os_str${UI_RST} ${UI_DIM}($(uname -sr) $(uname -m))${UI_RST}"
    echo "│ ${UI_CYAN}Display     ${UI_RST}: ${WAYLAND_DISPLAY:+Wayland ($WAYLAND_DISPLAY)}${DISPLAY:+ X11 ($DISPLAY)}"
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"

    # Layer 1: CLI Fundamental Tools
    echo
    echo "  ${UI_PURPLE}[LAYER 1] Fundamental CLI Tools${UI_RST}"
    local cli_tool
    for cli_tool in fzf jq curl file zip unzip rsync ssh; do
        if command -v "$cli_tool" >/dev/null 2>&1; then
            echo "    • $(printf '%-10s' "$cli_tool") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v "$cli_tool"))${UI_RST}"
            pass_cnt=$((pass_cnt + 1))
        else
            echo "    • $(printf '%-10s' "$cli_tool") : ${UI_RED}[MISSING]${UI_RST} Install via distro package manager"
            miss_cnt=$((miss_cnt + 1))
        fi
    done

    local has_7z_bin=""
    for c in 7z 7za 7zr; do
        if command -v "$c" >/dev/null 2>&1; then
            has_7z_bin="$(command -v "$c")"
            break
        fi
    done
    if [ -n "$has_7z_bin" ]; then
        echo "    • $(printf '%-10s' "7z") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($has_7z_bin)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-10s' "7z") : ${UI_AMBER}[WARN]${UI_RST} Optional (Install p7zip/7zip for Windows GBE templates)"
        warn_cnt=$((warn_cnt + 1))
    fi

    # Layer 2: Python Runtime & YAML Engine
    echo
    echo "  ${UI_PURPLE}[LAYER 2] Python Runtime & YAML Engine${UI_RST}"
    if command -v python3 >/dev/null 2>&1; then
        echo "    • $(printf '%-10s' "python3") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(python3 --version 2>&1))${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
        if python3 -c "import ruamel.yaml" 2>/dev/null; then
            echo "    • $(printf '%-10s' "YAML") : ${UI_GREEN}[READY]${UI_RST} ruamel.yaml (Preserves SLSsteam layout)"
            pass_cnt=$((pass_cnt + 1))
        elif python3 -c "import yaml" 2>/dev/null; then
            echo "    • $(printf '%-10s' "YAML") : ${UI_GREEN}[READY]${UI_RST} PyYAML fallback installed"
            pass_cnt=$((pass_cnt + 1))
        else
            echo "    • $(printf '%-10s' "YAML") : ${UI_AMBER}[WARN]${UI_RST} Neither ruamel.yaml nor pyyaml found"
            warn_cnt=$((warn_cnt + 1))
        fi
    else
        echo "    • $(printf '%-10s' "python3") : ${UI_RED}[MISSING]${UI_RST} Python 3 runtime not found"
        miss_cnt=$((miss_cnt + 1))
    fi

    # Layer 3: GBE Fork Templates
    echo
    echo "  ${UI_PURPLE}[LAYER 3] GBE Fork Binary Templates${UI_RST}"
    local gbe_targets=(
        "Linux x64:linux:x64"
        "Linux x86:linux:x86"
        "Windows x64:windows:x64"
        "Windows x86:windows:x86"
    )
    for gt in "${gbe_targets[@]}"; do
        local g_label="${gt%%:*}"
        local g_rest="${gt#*:}"
        local g_plat="${g_rest%%:*}"
        local g_arch="${g_rest##*:}"
        local g_path
        g_path=$(get_gbe_template "$g_plat" "$g_arch" 2>/dev/null || true)
        if [ -n "$g_path" ] && [ -f "$g_path" ]; then
            echo "    • $(printf '%-11s' "$g_label") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($g_path)${UI_RST}"
            pass_cnt=$((pass_cnt + 1))
        else
            echo "    • $(printf '%-11s' "$g_label") : ${UI_RED}[MISSING]${UI_RST} Run 'gamectl setup-gbe' to install"
            miss_cnt=$((miss_cnt + 1))
        fi
    done

    # Layer 4: Windows Game Runner
    echo
    echo "  ${UI_PURPLE}[LAYER 4] Windows Game Runners${UI_RST}"
    local r_found=0
    if command -v umu-run >/dev/null 2>&1; then
        echo "    • $(printf '%-10s' "umu-run") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v umu-run))${UI_RST}"
        r_found=1
    else
        echo "    • $(printf '%-10s' "umu-run") : ${UI_DIM}[N/A]${UI_RST} (Optional Unified Proton Runner)"
    fi

    local ge_proton=""
    local s_dyn_root
    s_dyn_root="$(get_steam_root 2>/dev/null || true)"
    local cdir
    for cdir in "$s_dyn_root/compatibilitytools.d" "$HOME/.local/share/Steam/compatibilitytools.d" "$HOME/.steam/root/compatibilitytools.d" "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d"; do
        [ -n "$cdir" ] && [ -d "$cdir" ] || continue
        ge_proton=$(find "$cdir" -maxdepth 2 -name "proton" 2>/dev/null | head -n 1 || true)
        [ -n "$ge_proton" ] && break
    done
    if [ -n "$ge_proton" ]; then
        echo "    • $(printf '%-10s' "GE-Proton") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($ge_proton)${UI_RST}"
        r_found=1
    else
        echo "    • $(printf '%-10s' "GE-Proton") : ${UI_DIM}[N/A]${UI_RST} (In compatibilitytools.d/)"
    fi

    if command -v wine >/dev/null 2>&1; then
        echo "    • $(printf '%-10s' "Wine") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(wine --version 2>/dev/null || echo 'wine'))${UI_RST}"
        r_found=1
    else
        echo "    • $(printf '%-10s' "Wine") : ${UI_DIM}[N/A]${UI_RST} (System Wine fallback)"
    fi

    if [ "$r_found" -eq 1 ]; then
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • ${UI_AMBER}[WARN] No Windows runners detected. Only Native Linux games can launch.${UI_RST}"
        warn_cnt=$((warn_cnt + 1))
    fi

    # Layer 5: Performance & Display Wrappers
    echo
    echo "  ${UI_PURPLE}[LAYER 5] Performance & Display Wrappers${UI_RST}"
    for w_tool in "gamemoderun:GameMode" "mangohud:MangoHud" "gamescope:Gamescope"; do
        local wt_cmd="${w_tool%%:*}"
        local wt_name="${w_tool##*:}"
        if command -v "$wt_cmd" >/dev/null 2>&1; then
            echo "    • $(printf '%-10s' "$wt_name") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v "$wt_cmd"))${UI_RST}"
            pass_cnt=$((pass_cnt + 1))
        else
            echo "    • $(printf '%-10s' "$wt_name") : ${UI_DIM}[OFF]${UI_RST} Not installed ($wt_cmd missing)"
            warn_cnt=$((warn_cnt + 1))
        fi
    done

    # Layer 6: Manifest Harvester & CDN Providers
    echo
    echo "  ${UI_PURPLE}[LAYER 6] Manifest Harvester & CDN Providers${UI_RST}"
    local harvest_ok=1
    command -v curl >/dev/null 2>&1 || harvest_ok=0
    command -v jq >/dev/null 2>&1 || harvest_ok=0
    command -v zip >/dev/null 2>&1 || harvest_ok=0
    command -v unzip >/dev/null 2>&1 || harvest_ok=0
    if [ "$harvest_ok" -eq 1 ]; then
        echo "    • $(printf '%-18s' "Harvester") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}(curl, jq, zip, unzip)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-18s' "Harvester") : ${UI_RED}[MISSING]${UI_RST} curl, jq, zip, or unzip not found"
        miss_cnt=$((miss_cnt + 1))
    fi

    local dl_bin
    dl_bin="$(resolve_depot_dl_bin 2>/dev/null || true)"
    if [ -n "$dl_bin" ] && [ -x "$dl_bin" ]; then
        echo "    • $(printf '%-18s' "Depot Downloader") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($dl_bin)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-18s' "Depot Downloader") : ${UI_AMBER}[WARN]${UI_RST} Standalone Rust downloader not compiled (Run 'make build-depot-dl')"
        warn_cnt=$((warn_cnt + 1))
    fi

    # Layer 7: Steam Client & SLSsteam Integration
    echo
    echo "  ${UI_PURPLE}[LAYER 7] Steam Client & SLSsteam Integration${UI_RST}"
    local s_root
    s_root="$(get_steam_root 2>/dev/null || true)"
    if [ -n "$s_root" ] && [ -d "$s_root" ]; then
        echo "    • $(printf '%-12s' "Steam Root") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($s_root)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-12s' "Steam Root") : ${UI_AMBER}[WARN]${UI_RST} Steam client directory not found"
        warn_cnt=$((warn_cnt + 1))
    fi

    local sls_file="$HOME/.config/SLSsteam/config.yaml"
    if [ -f "$sls_file" ]; then
        echo "    • $(printf '%-12s' "SLSsteam") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($sls_file)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-12s' "SLSsteam") : ${UI_AMBER}[WARN]${UI_RST} SLSsteam config.yaml not found (needed for zero-download unlock)"
        warn_cnt=$((warn_cnt + 1))
    fi

    # Hardware GPU & Mesa Driver Health
    echo
    echo "  ${UI_PURPLE}[HARDWARE] GPU Controller & Mesa Driver Health${UI_RST}"
    local gpu_line
    gpu_line=$(lspci 2>/dev/null | grep -E "VGA|3D" | head -n 1 | sed -E 's/^[0-9a-f:.]+ (VGA compatible controller|3D controller): //' || true)
    [ -z "$gpu_line" ] && gpu_line="Not detected via lspci"
    echo "    • GPU Controller : ${UI_BOLD}$gpu_line${UI_RST}"
    if is_haswell_gpu; then
        echo "    • Mesa Driver    : ${UI_AMBER}[WARN]${UI_RST} Intel Haswell has incomplete Vulkan (hasvk)."
        echo "    • Driver Safety  : ${UI_ICE}Mesa GL Threading is disabled by default to prevent FNA/XNA asset decompression crashes.${UI_RST}"
        warn_cnt=$((warn_cnt + 1))
    else
        echo "    • Driver Status  : ${UI_GREEN}[READY]${UI_RST} GPU supported by standard Mesa driver stack."
        pass_cnt=$((pass_cnt + 1))
    fi

    local dgpu_vend
    dgpu_vend="$(detect_dgpu_vendor 2>/dev/null || echo "none")"
    if [ "$dgpu_vend" != "none" ]; then
        echo "    • Hybrid dGPU    : ${UI_GREEN}[READY]${UI_RST} Discrete GPU detected ($dgpu_vend). PRIME offload available (--prime)."
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • Hybrid dGPU    : ${UI_DIM}[N/A]${UI_RST} No discrete secondary GPU detected (single GPU topology)."
    fi

    echo
    echo "${UI_BOX}╭─ DIAGNOSTIC AUDIT SUMMARY ──────────────────────────────────╮${UI_RST}"
    echo "│ ${UI_GREEN}Passed: $pass_cnt${UI_RST}  •  ${UI_AMBER}Warnings: $warn_cnt${UI_RST}  •  ${UI_RED}Missing: $miss_cnt${UI_RST}"
    if [ "$miss_cnt" -eq 0 ] && [ "$warn_cnt" -eq 0 ]; then
        echo "│ System Status: ${UI_GREEN}[READY] 100% optimal for sovereign offline gaming.${UI_RST}"
    elif [ "$miss_cnt" -eq 0 ]; then
        echo "│ System Status: ${UI_GREEN}[READY] Core dependencies satisfied. Review warnings above.${UI_RST}"
    else
        echo "│ System Status: ${UI_AMBER}[WARN] Essential dependencies missing. Install missing tools.${UI_RST}"
    fi
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"

    return $(( miss_cnt > 0 ? 1 : 0 ))
}

# Query ProtonDB community compatibility tier and rating (Chunk 5)
query_protondb() {
    local target="${1:-}"

    if [ -z "$target" ]; then
        echo "Usage: gamectl protondb <appid|game_dir>" >&2
        return 1
    fi

    local appid=""
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        appid="$target"
    elif [ -d "$target" ]; then
        if [ -f "$target/steam_appid.txt" ]; then
            appid=$(tr -dc '0-9' < "$target/steam_appid.txt")
        fi
        if [ -z "$appid" ]; then
            local base_dir
            base_dir="$(basename "$target")"
            local parent_apps
            parent_apps="$(dirname "$target")"
            if [ "$(basename "$parent_apps")" = "common" ]; then
                local steamapps_dir
                steamapps_dir="$(dirname "$parent_apps")"
                local acf
                for acf in "$steamapps_dir"/appmanifest_*.acf; do
                    [ -f "$acf" ] || continue
                    local installdir
                    installdir=$(grep -E '^\s*"installdir"' "$acf" | head -n 1 | sed -E 's/.*"installdir"[[:space:]]+"([^"]+)".*/\1/')
                    if [ "$installdir" = "$base_dir" ]; then
                        appid=$(grep -E '^\s*"appid"' "$acf" | head -n 1 | sed -E 's/.*"appid"[[:space:]]+"([0-9]+)".*/\1/')
                        break
                    fi
                done
            fi
        fi
    fi

    if [ -z "$appid" ] || [[ ! "$appid" =~ ^[0-9]+$ ]]; then
        echo "[ERROR] Invalid AppID or game directory lacks steam_appid.txt: $target" >&2
        return 1
    fi

    echo "${UI_BOX}╭─ PROTONDB COMPATIBILITY REPORT ─────────────────────────────╮${UI_RST}"
    echo "│ ${UI_CYAN}Target AppID${UI_RST}  : ${UI_BOLD}$appid${UI_RST}"

    local pdb=""
    pdb=$(fetch_cached_json "https://www.protondb.com/api/v1/reports/summaries/${appid}.json" "protondb_${appid}" 3600 2>/dev/null || true)

    if [ -n "$pdb" ] && [ "$pdb" != "null" ] && echo "$pdb" | jq . >/dev/null 2>&1; then
        local tier score conf trending
        tier=$(echo "$pdb" | jq -r ".tier // \"Unknown\"" 2>/dev/null)
        score=$(echo "$pdb" | jq -r ".score // \"-\"" 2>/dev/null)
        conf=$(echo "$pdb" | jq -r ".confidence // \"-\"" 2>/dev/null)
        trending=$(echo "$pdb" | jq -r ".trendingTier // \"-\"" 2>/dev/null)

        local tier_upper="${tier^^}"
        local c_tier="${UI_GREEN}[$tier_upper]${UI_RST}"
        local recommendation=""

        case "$tier_upper" in
            *PLATINUM*)
                c_tier="${UI_ICE}[PLATINUM]${UI_RST}"
                recommendation="Plug and play. Works flawlessly out of the box without special tweaking."
                ;;
            *GOLD*)
                c_tier="${UI_AMBER}[GOLD]${UI_RST}"
                recommendation="Runs well after minor tweaks (e.g. GE-Proton / DirectX DLL override)."
                ;;
            *SILVER*)
                c_tier="${UI_DIM}[SILVER]${UI_RST}"
                recommendation="Playable with minor issues / requires specific launch options."
                ;;
            *BRONZE*)
                c_tier="${UI_AMBER}[BRONZE]${UI_RST}"
                recommendation="Frequent crashes or graphical glitches. Specific GE-Proton version recommended."
                ;;
            *BORKED*)
                c_tier="${UI_RED}[BORKED]${UI_RST}"
                recommendation="Game currently does not run under Wine/Proton (likely invasive anti-cheat)."
                ;;
            *NATIVE*)
                c_tier="${UI_GREEN}[NATIVE]${UI_RST}"
                recommendation="Native Linux ELF build available without Wine emulation."
                ;;
            *)
                recommendation="Limited community reports. Test with latest GE-Proton release."
                ;;
        esac

        echo "│ ${UI_CYAN}ProtonDB Tier${UI_RST} : $c_tier"
        echo "│ ${UI_CYAN}Rating Score ${UI_RST} : ${UI_BOLD}$score${UI_RST} ${UI_DIM}(Confidence: $conf, Trending: $trending)${UI_RST}"
        echo "│ ${UI_CYAN}Recommendation${UI_RST}: $recommendation"
        echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"
        return 0
    else
        echo "│ ${UI_CYAN}ProtonDB Tier${UI_RST} : ${UI_DIM}[NO REPORTS YET]${UI_RST}"
        echo "│ ${UI_CYAN}Details       ${UI_RST}: No community reports currently recorded for AppID $appid."
        echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"
        return 0
    fi
}


# --- [MODULE] src/tui/70_dashboard.sh ---
# Preview pane generator for installed games
preview_game() {
    local appid title status gdir gbin
    appid=$(strip_ansi "$1" | tr -d '[:space:]')
    title=$(strip_ansi "$2" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    status=$(strip_ansi "$3" | tr -d '][[:space:]]')
    gdir="$4"
    gbin="$5"

    # Real-time dynamic live inspection from filesystem
    if [ -n "$gdir" ] && [ -d "$gdir" ]; then
        local live_api=""
        if [ -f "$gdir/steam_api64.dll" ]; then
            live_api="$gdir/steam_api64.dll"
        elif [ -f "$gdir/steam_api.dll" ]; then
            live_api="$gdir/steam_api.dll"
        elif [ -f "$gdir/libsteam_api.so" ]; then
            live_api="$gdir/libsteam_api.so"
        elif [ -f "$gdir/lib64/libsteam_api.so" ]; then
            live_api="$gdir/lib64/libsteam_api.so"
        else
            live_api=$(find "$gdir" -maxdepth 3 \( -name "steam_api64.dll" -o -name "steam_api.dll" -o -name "libsteam_api.so" \) 2>/dev/null | head -n 1)
        fi

        if [ -n "$live_api" ] && [ -f "$live_api" ]; then
            local live_sz
            live_sz=$(stat -c%s "$live_api" 2>/dev/null || echo 0)
            if [ "$live_sz" -gt 7000000 ]; then
                status="GBE_FORK"
            else
                case "$live_api" in
                    *.dll) status="VALVE_DLL" ;;
                    *)     status="VALVE_SO" ;;
                esac
            fi
        else
            status="STANDALONE"
        fi
    fi

    local status_badge="${UI_CYAN}[${status}]${UI_RST}"
    local status_desc=""
    case "$status" in
        *VALVE_SO*)
            status_badge="${UI_AMBER}[VALVE_SO]${UI_RST}"
            status_desc="${UI_DIM}(Official Steam DRM - Requires Steam Client)${UI_RST}"
            ;;
        *VALVE_DLL*)
            status_badge="${UI_CYAN}[VALVE_DLL]${UI_RST}"
            status_desc="${UI_DIM}(Windows Steam DRM - Requires Steam + Runner)${UI_RST}"
            ;;
        *GBE_FORK*)
            status_badge="${UI_GREEN}[GBE_FORK]${UI_RST}"
            status_desc="${UI_DIM}(Goldberg Fork - Steam-Free, Full DLC, LAN Ready)${UI_RST}"
            ;;
        *STANDALONE*)
            status_badge="${UI_ICE}[STANDALONE]${UI_RST}"
            status_desc="${UI_DIM}(DRM-Free Standalone)${UI_RST}"
            ;;
    esac

    local run_dir
    run_dir="$(get_runtime_dir)"
    local is_running=false
    local run_pid=""
    if [ -d "$run_dir/active_games" ]; then
        for inf in "$run_dir/active_games"/*.info; do
            [ -f "$inf" ] || continue
            local inf_dir
            inf_dir=$(grep -E '^DIR=' "$inf" 2>/dev/null | head -n 1 | cut -d'=' -f2-)
            if [ "$inf_dir" = "$gdir" ]; then
                local check_pid
                check_pid=$(grep -E '^PID=' "$inf" 2>/dev/null | head -n 1 | cut -d'=' -f2)
                if [ -n "$check_pid" ] && kill -0 "$check_pid" 2>/dev/null; then
                    is_running=true
                    run_pid="$check_pid"
                    break
                fi
            fi
        done
    fi
    if [ "$is_running" = true ]; then
        status_badge="${UI_GREEN}[RUNNING PID:$run_pid]${UI_RST}"
        status_desc="${UI_DIM}(Game window active in background)${UI_RST}"
    fi

    echo "${UI_BOX}╭─ GAME INFORMATION ───────────────────────────────────╮${UI_RST}"
    echo "│ ${UI_BOLD}${title}${UI_RST} ${UI_DIM}(AppID: ${appid})${UI_RST}"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
    echo "  ${UI_CYAN}Status      ${UI_RST}: $status_badge $status_desc"
    echo "  ${UI_CYAN}Directory   ${UI_RST}: ${UI_DIM}$gdir${UI_RST}"
    echo "  ${UI_CYAN}Executable  ${UI_RST}: ${UI_BOLD}$gbin${UI_RST}"

    if [ -f "$gdir/$gbin" ]; then
        local arch_info
        arch_info=$(file -b "$gdir/$gbin" | cut -d',' -f1,2)
        echo "  ${UI_CYAN}Architecture${UI_RST}: ${UI_DIM}$arch_info${UI_RST}"
        if detect_steamstub_drm "$gdir/$gbin"; then
            echo "  ${UI_CYAN}DRM Stub    ${UI_RST}: ${UI_AMBER}[SteamStub .bind]${UI_RST} ${UI_DIM}(Valve Binary Stub Detected)${UI_RST}"
        fi
        local is_win=false
        case "$gbin" in *.exe|*.EXE) is_win=true ;; esac
        if [ "$is_win" = false ] && file -b "$gdir/$gbin" 2>/dev/null | grep -qi "PE32"; then
            is_win=true
        fi
        if [ "$is_win" = true ]; then
            local r_path
            r_path=$(find_runner "$gdir" 2>/dev/null || true)
            if [ -n "$r_path" ]; then
                echo "  ${UI_CYAN}Runner      ${UI_RST}: ${UI_PURPLE}$(basename "$r_path")${UI_RST} ${UI_DIM}($r_path)${UI_RST}"
            else
                echo "  ${UI_CYAN}Runner      ${UI_RST}: ${UI_RED}[MISSING] No Windows runner found (umu-run/Proton/wine)${UI_RST}"
            fi
            echo "  ${UI_CYAN}Prefix      ${UI_RST}: ${UI_DIM}$gdir/pfx (ISOLATED)${UI_RST}"
        else
            echo "  ${UI_CYAN}Runner      ${UI_RST}: ${UI_GREEN}Native Linux${UI_RST} ${UI_DIM}(Direct ELF/Script)${UI_RST}"
        fi
    fi

    echo
    echo "${UI_BOX}╭─ STORAGE & SAVEGAMES ────────────────────────────────╮${UI_RST}"
    if [ -d "$gdir/saves" ]; then
        local save_sz
        save_sz=$(du -sh "$gdir/saves" 2>/dev/null | cut -f1)
        echo "  ${UI_CYAN}Save Path   ${UI_RST}: ${UI_GREEN}./saves${UI_RST} ${UI_DIM}(PORTABLE - ACTIVE | Size: $save_sz)${UI_RST}"
        if [ -d "$gdir/.save_snapshots" ]; then
            local snaps
            snaps=$(ls -d "$gdir/.save_snapshots"/slot* 2>/dev/null | wc -l)
            echo "  ${UI_CYAN}Snapshots   ${UI_RST}: ${UI_BOLD}$snaps active recovery slots${UI_RST}"
        else
            echo "  ${UI_CYAN}Snapshots   ${UI_RST}: ${UI_DIM}0 slots (Auto-created before launch)${UI_RST}"
        fi
    else
        echo "  ${UI_CYAN}Save Path   ${UI_RST}: ${UI_AMBER}Default OS (Global Steam/Home - Not Isolated)${UI_RST}"
        echo "  ${UI_CYAN}Snapshots   ${UI_RST}: ${UI_DIM}Disabled (Requires GBE Fork ./saves)${UI_RST}"
    fi

    if [ -f "$gdir/steam_settings/DLC.txt" ]; then
        local dlc_count
        dlc_count=$(grep -c "=" "$gdir/steam_settings/DLC.txt" 2>/dev/null || echo 0)
        echo "  ${UI_CYAN}DLC State   ${UI_RST}: ${UI_GREEN}$dlc_count items unlocked (Full DLC)${UI_RST}"
    fi
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

    echo
    echo "${UI_BOX}╭─ RUNTIME WRAPPERS & PERFORMANCE ─────────────────────╮${UI_RST}"
    local w_gm="${UI_DIM}[N/A]${UI_RST}" w_hud="${UI_DIM}[N/A]${UI_RST}" w_scope="${UI_DIM}[N/A]${UI_RST}"
    command -v gamemoderun >/dev/null 2>&1 && w_gm="${UI_GREEN}[READY]${UI_RST}"
    command -v mangohud >/dev/null 2>&1 && w_hud="${UI_GREEN}[READY]${UI_RST}"
    command -v gamescope >/dev/null 2>&1 && w_scope="${UI_GREEN}[READY]${UI_RST}"
    echo "  ${UI_CYAN}Host Tools  ${UI_RST}: GameMode $w_gm • MangoHud $w_hud • Gamescope $w_scope"

    local act_w=()
    local c_gm=0 c_hud=0 c_scope=0 c_fsr=0 c_glt=0
    if [ -f "$HOME/.config/gamectl/wrappers" ]; then
        grep -q "^gamemode=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && c_gm=1
        grep -q -E "^(hud|mangohud)=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && c_hud=1
        grep -q "^gamescope=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && c_scope=1
        grep -q "^fsr=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && c_fsr=1
        grep -q -E "^(glthread|mesa_glthread)=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && c_glt=1
    fi
    if [ -f "$gdir/.wrappers" ]; then
        grep -q "^gamemode=1" "$gdir/.wrappers" 2>/dev/null && c_gm=1
        grep -q "^gamemode=0" "$gdir/.wrappers" 2>/dev/null && c_gm=0
        grep -q -E "^(hud|mangohud)=1" "$gdir/.wrappers" 2>/dev/null && c_hud=1
        grep -q -E "^(hud|mangohud)=0" "$gdir/.wrappers" 2>/dev/null && c_hud=0
        grep -q "^gamescope=1" "$gdir/.wrappers" 2>/dev/null && c_scope=1
        grep -q "^gamescope=0" "$gdir/.wrappers" 2>/dev/null && c_scope=0
        grep -q "^fsr=1" "$gdir/.wrappers" 2>/dev/null && c_fsr=1
        grep -q "^fsr=0" "$gdir/.wrappers" 2>/dev/null && c_fsr=0
        grep -q -E "^(glthread|mesa_glthread)=1" "$gdir/.wrappers" 2>/dev/null && c_glt=1
        grep -q -E "^(glthread|mesa_glthread)=0" "$gdir/.wrappers" 2>/dev/null && c_glt=0
    fi
    [ "$c_gm" = 1 ] && act_w+=("GameMode")
    [ "$c_hud" = 1 ] && act_w+=("MangoHud")
    [ "$c_scope" = 1 ] && act_w+=("Gamescope")
    [ "$c_fsr" = 1 ] && act_w+=("FSR")
    [ "$c_glt" = 1 ] && act_w+=("MesaGL")
    if [ ${#act_w[@]} -gt 0 ]; then
        echo "  ${UI_CYAN}Game Profile${UI_RST}: ${UI_BOLD}${act_w[*]}${UI_RST}"
    else
        echo "  ${UI_CYAN}Game Profile${UI_RST}: ${UI_DIM}Clean Native (Zero Wrappers)${UI_RST}"
    fi
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

    echo
    echo "${UI_BOX}╭─ LAN MULTIPLAYER & IDENTITY ─────────────────────────╮${UI_RST}"
    if [[ "$status" =~ GBE_FORK ]]; then
        local p_info p_name p_id
        p_info=$(get_game_persona "$gdir")
        p_name=$(echo "$p_info" | cut -d'|' -f1)
        p_id=$(echo "$p_info" | cut -d'|' -f2)
        echo "  ${UI_CYAN}Player Name ${UI_RST}: ${UI_BOLD}${p_name:-Player}${UI_RST} ${UI_DIM}(SteamID64: ${p_id:-Default})${UI_RST}"
        if [ -f "$gdir/steam_settings/custom_broadcasts.txt" ]; then
            local bc_count
            bc_count=$(grep -v -E '^[[:space:]]*(#|$)' "$gdir/steam_settings/custom_broadcasts.txt" 2>/dev/null | wc -l)
            echo "  ${UI_CYAN}Broadcast   ${UI_RST}: ${UI_BOLD}$bc_count peers configured${UI_RST}"
        else
            echo "  ${UI_CYAN}Broadcast   ${UI_RST}: ${UI_DIM}Subnet default (127.0.0.1, 255.255.255.255)${UI_RST}"
        fi
    else
        echo "  ${UI_CYAN}GBE State   ${UI_RST}: ${UI_AMBER}[INACTIVE] (Official Steam/DRM binary)${UI_RST}"
        echo "  ${UI_CYAN}Note        ${UI_RST}: ${UI_DIM}Press <CTRL-I> to enable LAN co-op & custom persona${UI_RST}"
    fi
    local total_sz
    total_sz=$(du -sh "$gdir" 2>/dev/null | cut -f1)
    echo "  ${UI_CYAN}Disk Size   ${UI_RST}: ${UI_BOLD}$total_sz${UI_RST}"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

    echo
    echo "${UI_BOX}╭─ KEYBOARD SHORTCUTS ─────────────────────────────────╮${UI_RST}"
    echo "  ${UI_PILL_ENTER} ${UI_BOLD}Launch Game${UI_RST}       ${UI_PILL_CTRLI} ${UI_BOLD}Inject GBE Fork${UI_RST}"
    echo "  ${UI_PILL_CTRLO} ${UI_BOLD}Setup Wrappers${UI_RST}    ${UI_PILL_CTRLP} ${UI_BOLD}Configure LAN Persona${UI_RST}"
    local rhost
    rhost=$(get_remote_host)
    if [ -n "$rhost" ]; then
        echo "  ${UI_PILL_CTRLS} ${UI_BOLD}Sync to $rhost${UI_RST}   ${UI_PILL_CTRLB} ${UI_BOLD}Manual Save Snapshot${UI_RST}"
    else
        echo "  ${UI_PILL_CTRLS} ${UI_BOLD}Cloud Sync (N/A)${UI_RST}   ${UI_PILL_CTRLB} ${UI_BOLD}Manual Save Snapshot${UI_RST}"
    fi
    echo "  ${UI_PILL_ESC}   ${UI_BOLD}Back to Master Dashboard Hub${UI_RST}"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
    echo "========================================================"
}


# Preview pane generator for Master Dashboard
preview_dashboard() {
    local item_key="${1:-1}"
    local gcount="${2:-}"

    local os_name="Linux"
    if [ -f /etc/os-release ]; then
        os_name=$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d'=' -f2 | tr -d '"')
    fi
    local kernel_info
    kernel_info=$(uname -sr)

    local disp_info="Headless/Unknown"
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        disp_info="Wayland ($WAYLAND_DISPLAY)"
        [ -n "${DISPLAY:-}" ] && disp_info="$disp_info + Xwayland ($DISPLAY)"
    elif [ -n "${DISPLAY:-}" ]; then
        disp_info="X11 ($DISPLAY)"
    fi

    [ -z "$gcount" ] && gcount=$(scan_installed_games 2>/dev/null | wc -l || echo "0")

    local def_runner
    def_runner=$(find_runner "$HOME" 2>/dev/null || true)
    local runner_str="${UI_DIM}[MISSING] Not installed${UI_RST}"
    if [ -n "$def_runner" ]; then
        runner_str="${UI_PURPLE}$(basename "$def_runner")${UI_RST} ${UI_DIM}($def_runner)${UI_RST}"
    fi

    local gbe_l64 gbe_w64
    gbe_l64=$(get_gbe_template "linux" "x64" 2>/dev/null || true)
    gbe_w64=$(get_gbe_template "windows" "x64" 2>/dev/null || true)
    local gbe_status="${UI_GREEN}[READY]${UI_RST}"
    [ -z "$gbe_l64" ] || [ -z "$gbe_w64" ] && gbe_status="${UI_AMBER}[PARTIAL]${UI_RST}"

    local w_gm="${UI_DIM}[N/A]${UI_RST}" w_hud="${UI_DIM}[N/A]${UI_RST}" w_scope="${UI_DIM}[N/A]${UI_RST}"
    command -v gamemoderun >/dev/null 2>&1 && w_gm="${UI_GREEN}[READY]${UI_RST}"
    command -v mangohud >/dev/null 2>&1 && w_hud="${UI_GREEN}[READY]${UI_RST}"
    command -v gamescope >/dev/null 2>&1 && w_scope="${UI_GREEN}[READY]${UI_RST}"

    local sls_status="${UI_DIM}[N/A]${UI_RST}" steam_status="${UI_DIM}[IDLE]${UI_RST}"
    local sls_cfg
    sls_cfg="$(get_sls_root 2>/dev/null || echo "$HOME/.config/SLSsteam")/config.yaml"
    [ -f "$sls_cfg" ] && sls_status="${UI_GREEN}[READY]${UI_RST}"
    if pgrep -x steam >/dev/null 2>&1; then
        steam_status="${UI_GREEN}[RUNNING]${UI_RST}"
    fi

    local run_dir
    run_dir="$(get_runtime_dir)"
    local active_count=0
    local active_titles=()
    if [ -d "$run_dir/active_games" ]; then
        for inf in "$run_dir/active_games"/*.info; do
            [ -f "$inf" ] || continue
            local a_pid a_title
            a_pid=$(grep -E '^PID=' "$inf" 2>/dev/null | head -n 1 | cut -d'=' -f2)
            a_title=$(grep -E '^TITLE=' "$inf" 2>/dev/null | head -n 1 | cut -d'=' -f2)
            if [ -n "$a_pid" ] && kill -0 "$a_pid" 2>/dev/null; then
                active_count=$((active_count + 1))
                active_titles+=("$a_title [PID:$a_pid]")
            else
                rm -f "$inf" 2>/dev/null || true
            fi
        done
    fi
    local active_desc="${UI_DIM}None${UI_RST}"
    if [ "$active_count" -gt 0 ]; then
        active_desc="${UI_GREEN}$active_count running${UI_RST} ${UI_DIM}(${active_titles[*]})${UI_RST}"
    fi

    echo "${UI_BOX}╭─ GAMECTL SOVEREIGN COCKPIT ───────────────────────────╮${UI_RST}"
    echo "│ ${UI_BOLD}SYSTEM STATUS & HARDWARE RUNTIME${UI_RST}"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
    echo "  ${UI_CYAN}Host OS     ${UI_RST}: ${UI_BOLD}$os_name${UI_RST} ${UI_DIM}($kernel_info)${UI_RST}"
    echo "  ${UI_CYAN}Display     ${UI_RST}: ${UI_BOLD}$disp_info${UI_RST}"
    echo "  ${UI_CYAN}Games Loaded${UI_RST}: ${UI_GREEN}$gcount titles detected${UI_RST}"
    echo "  ${UI_CYAN}Active Game ${UI_RST}: $active_desc"
    echo "  ${UI_CYAN}Win Runner  ${UI_RST}: $runner_str"
    echo "  ${UI_CYAN}GBE Fork    ${UI_RST}: $gbe_status ${UI_DIM}(Linux x64: $([ -n "$gbe_l64" ] && echo "OK" || echo "MISSING") | Win x64: $([ -n "$gbe_w64" ] && echo "OK" || echo "MISSING"))${UI_RST}"
    echo "  ${UI_CYAN}Tooling     ${UI_RST}: GameMode $w_gm • MangoHud $w_hud • Gamescope $w_scope"
    echo "  ${UI_CYAN}Integration ${UI_RST}: SLSsteam $sls_status • Steam Client $steam_status"
    echo

    local log_file
    log_file="$(get_runtime_log_file)"
    echo "${UI_BOX}╭─ RECENT ACTIVITY LOGS ────────────────────────────────╮${UI_RST}"
    if [ -s "$log_file" ]; then
        tail -n 5 "$log_file" 2>/dev/null | while IFS= read -r line; do
            echo "  ${UI_DIM}${line:0:84}${UI_RST}"
        done
    else
        echo "  ${UI_DIM}(No recent activity logged yet)${UI_RST}"
    fi
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
    echo

    case "$item_key" in
        *1*|*LIBRARY*|*PUSTAKA*)
            echo "${UI_BOX}╭─ SELECTED MODULE ─────────────────────────────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}[01] GAME LIBRARY${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
            echo "  • Browse installed Native Linux and Windows Proton/Wine games."
            echo "  • One-click launch with runtime wrappers & isolated runner prefix."
            echo "  • Automatic 3-slot savegame snapshot protection before launch."
            echo "  • Action shortcuts: ${UI_CYAN}Ctrl-I${UI_RST} (Inject), ${UI_CYAN}Ctrl-O${UI_RST} (Wrappers), ${UI_CYAN}Ctrl-P${UI_RST} (Persona)."
            ;;
        *2*|*SEARCH*|*PENCARIAN*)
            echo "${UI_BOX}╭─ SELECTED MODULE ─────────────────────────────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}[02] STEAM STORE SEARCH & PROTONDB${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
            echo "  • Search public Steam Store catalog via official web API."
            echo "  • Instant Linux compatibility tier audit from ProtonDB."
            echo "  • One-click background or foreground headless download."
            ;;
        *3*|*DOWNLOAD*|*UNDUHAN*)
            echo "${UI_BOX}╭─ SELECTED MODULE ─────────────────────────────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}[03] DOWNLOAD MONITOR${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
            echo "  • Monitor real-time Steam native downloads & ACF telemetry."
            echo "  • Pause and resume downloads via Valve client protocol."
            ;;
        *4*|*UNLOCK*|*ENTITLE*|*ENTITLEMENT*|*ACF*|*ADOPT*)
            echo "${UI_BOX}╭─ SELECTED MODULE ─────────────────────────────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}[04] STEAM ACF ADOPTION & ASSET MANAGER${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
            echo "  • Dual-input adoption by Game Title or numeric AppID without prior lookup."
            echo "  • Automatically resolve physical game directories & generate real ACF."
            echo "  • Integrated bridge to Standalone CDN or Steam native install."
            ;;
        *5*|*CONFIG*|*SETTINGS*|*KONFIGURASI*)
            echo "${UI_BOX}╭─ SELECTED MODULE ─────────────────────────────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}[05] GLOBAL CONFIGURATION${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
            echo "  • Manage global LAN Persona (Player Name & default SteamID64)."
            echo "  • Set default runtime wrappers (GameMode, MangoHud, Gamescope FSR)."
            echo "  • Configure additional library paths & remote companion sync host."
            ;;
        *6*|*DOCTOR*|*AUDIT*|*DIAGNOSTICS*|*DIAGNOSTIK*)
            echo "${UI_BOX}╭─ SELECTED MODULE ─────────────────────────────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}[06] SYSTEM DIAGNOSTICS (HEALTH AUDIT)${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
            echo "  • Verify 7-layer system readiness: CLI tools, runners, drivers, templates."
            echo "  • Early detection of GPU hardware limitations & Mesa driver advice."
            ;;
        *7*|*LOG*|*LOGS*|*ACTIVITY*|*RIWAYAT*)
            echo "${UI_BOX}╭─ SELECTED MODULE ─────────────────────────────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}[07] ACTIVITY & RUNTIME LOGS${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
            echo "  • Inspect centralized operational log (gamectl.log)."
            echo "  • Audit recent download events, GBE injections & save backups."
            echo "  • Interactive log navigation with Ctrl-X log purge."
            ;;
        *)
            echo "${UI_BOX}╭─ NAVIGATION INSTRUCTIONS ─────────────────────────────╮${UI_RST}"
            echo "  Select a module from the left panel using arrow keys or numbers."
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
            ;;
    esac
    echo
    echo "${UI_BOX}╭─ HUB CONTROLS ────────────────────────────────────────╮${UI_RST}"
    echo "  ${UI_PILL_ENTER} ${UI_BOLD}Open Selected Module${UI_RST}    ${UI_PILL_ESC} ${UI_BOLD}Exit / Close gamectl${UI_RST}"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
}

# Preview pane generator for Steam Store Search & ProtonDB compatibility
preview_search_game() {
    local appid="${1:-}"
    local title="${2:-}"
    local app_status="${3:-[NOT INSTALLED]}"

    appid=$(strip_ansi "$appid" | tr -d '[:space:]')
    title=$(strip_ansi "$title" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    app_status=$(strip_ansi "$app_status" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    printf "%s╭─ STEAM METADATA & PROTONDB AUDIT ───────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
    printf "│ %s%s%s %s(AppID: %s)%s\n" "${UI_BOLD}" "$title" "${UI_RST}" "${UI_DIM}" "$appid" "${UI_RST}"
    printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
    printf "  %sLocal State%s : %s\n" "${UI_CYAN}" "${UI_RST}" "$app_status"

    if [ -n "$appid" ] && [[ "$appid" =~ ^[0-9]+$ ]]; then
        local details
        details=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=platforms,genres" "steam_details_${appid}" 3600 2>/dev/null | jq -r ".\"${appid}\".data // empty" 2>/dev/null || true)
        if [ -n "$details" ] && [ "$details" != "null" ]; then
            local is_linux is_win genres
            is_linux=$(echo "$details" | jq -r ".platforms.linux // false" 2>/dev/null || echo "false")
            is_win=$(echo "$details" | jq -r ".platforms.windows // false" 2>/dev/null || echo "false")
            genres=$(echo "$details" | jq -r "[.genres[]?.description] | join(\", \")" 2>/dev/null || true)
            [ -n "$genres" ] && printf "  %sGenres     %s : %s%s%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "$genres" "${UI_RST}"
            if [ "$is_linux" = "true" ]; then
                printf "  %sPlatform   %s : %sNative Linux ELF available%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_GREEN}" "${UI_RST}"
            elif [ "$is_win" = "true" ]; then
                printf "  %sPlatform   %s : %sWindows PE (Requires Proton/Wine)%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_PURPLE}" "${UI_RST}"
            fi
        fi

        printf "\n%s╭─ COMMUNITY COMPATIBILITY ───────────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        local pdb
        pdb=$(fetch_cached_json "https://www.protondb.com/api/v1/reports/summaries/${appid}.json" "protondb_${appid}" 3600 2>/dev/null || true)
        if [ -n "$pdb" ] && [ "$pdb" != "null" ]; then
            local tier score conf total tier_upper c_tier
            tier=$(echo "$pdb" | jq -r ".tier // \"Unknown\"" 2>/dev/null || echo "Unknown")
            score=$(echo "$pdb" | jq -r ".score // \"-\"" 2>/dev/null || echo "-")
            conf=$(echo "$pdb" | jq -r ".confidence // \"-\"" 2>/dev/null || echo "-")
            total=$(echo "$pdb" | jq -r ".total // \"-\"" 2>/dev/null || echo "-")
            tier_upper="${tier^^}"
            c_tier="${UI_GREEN}[$tier_upper]${UI_RST}"
            case "$tier_upper" in
                *PLATINUM*) c_tier="${UI_ICE}[PLATINUM]${UI_RST}" ;;
                *GOLD*)     c_tier="${UI_AMBER}[GOLD]${UI_RST}" ;;
                *SILVER*)   c_tier="${UI_DIM}[SILVER]${UI_RST}" ;;
                *BRONZE*)   c_tier="${UI_RED}[BRONZE]${UI_RST}" ;;
                *BORKED*)   c_tier="${UI_RED}[BORKED]${UI_RST}" ;;
            esac
            printf "  %sProtonDB Tier %s: %s\n" "${UI_CYAN}" "${UI_RST}" "$c_tier"
            local rep_str=""
            [ "$total" != "-" ] && rep_str=" • Reports: $total"
            printf "  %sRating Score  %s: %s%s%s %s(Confidence: %s%s)%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_BOLD}" "$score" "${UI_RST}" "${UI_DIM}" "$conf" "$rep_str" "${UI_RST}"
        else
            printf "  %sProtonDB Tier %s: %s[NO REPORTS YET]%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "${UI_RST}"
        fi
        printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
    else
        printf "\n%s╭─ COMMUNITY COMPATIBILITY ───────────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        printf "  %sProtonDB Tier %s: %s[INVALID APPID]%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "${UI_RST}"
        printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
    fi
}

# Interactive Centralized Activity & Runtime Log Viewer
view_logs_interactive() {
    flush_tty_input
    local log_file
    log_file="$(get_runtime_log_file)"

    if [ ! -s "$log_file" ]; then
        log_msg "INFO" "SYSTEM" "Log file initialized"
    fi

    local fzf_rc=0
    if command -v tac >/dev/null 2>&1; then
        tac "$log_file" 2>/dev/null
    else
        sed -e '1!G;h;$!d' "$log_file" 2>/dev/null
    fi | fzf \
        --border-label="  ╢ gamectl :: Activity & Runtime Logs ╟  " \
        --border-label-pos=2 \
        --header="ACTIVITY LOGS (Arrows: Navigate │ Ctrl-X: Clear Log │ Esc: Return)" \
        --prompt="Logs > " \
        --preview="echo -e '\033[38;5;60m╭─ LOG ENTRY DETAILS ─────────────────────────────────╮\033[0m\n{}\n\033[38;5;60m╰─────────────────────────────────────────────────────╯\033[0m'" \
        --preview-window=down:30%:border-rounded:wrap \
        --bind="ctrl-x:execute(: > '$log_file')+reload(command -v tac >/dev/null 2>&1 && tac '$log_file' 2>/dev/null || sed -e '1!G;h;\$!d' '$log_file' 2>/dev/null)" \
        --height=85% \
        --reverse 2>/dev/null || fzf_rc=$?

    flush_tty_input
    return 0
}

# Master Dashboard Hub (Two-Panel Interactive TUI)
dashboard_menu() {
    enter_tui_screen
    clean_stale_locks

    local initial_count
    initial_count=$(scan_installed_games 2>/dev/null | wc -l || echo "0")
    log_msg "INFO" "DASHBOARD" "Cockpit active ($initial_count titles indexed)"

    while true; do
        flush_tty_input
        local game_count
        game_count=$(scan_installed_games 2>/dev/null | wc -l || echo "0")

        local menu_entries
        menu_entries=$(cat <<EOF
1	${UI_PURPLE}[01]${UI_RST} ${UI_BOLD}GAME LIBRARY${UI_RST}	${UI_DIM}Browse, inject and launch installed games${UI_RST}
2	${UI_PURPLE}[02]${UI_RST} ${UI_BOLD}STEAM STORE SEARCH${UI_RST}	${UI_DIM}Search games & check ProtonDB compatibility${UI_RST}
3	${UI_PURPLE}[03]${UI_RST} ${UI_BOLD}DOWNLOAD MONITOR${UI_RST}	${UI_DIM}Track Steam native downloads & ACF telemetry${UI_RST}
4	${UI_PURPLE}[04]${UI_RST} ${UI_BOLD}STEAM ACF ADOPTION & ASSET MANAGER${UI_RST}	${UI_DIM}Adopt physical files, shaders & bridge downloads${UI_RST}
5	${UI_PURPLE}[05]${UI_RST} ${UI_BOLD}GLOBAL SETTINGS${UI_RST}	${UI_DIM}Configure LAN persona, default wrappers & remote host${UI_RST}
6	${UI_PURPLE}[06]${UI_RST} ${UI_BOLD}SYSTEM DIAGNOSTICS${UI_RST}	${UI_DIM}Audit 7-layer dependencies, runners & GPU health${UI_RST}
7	${UI_PURPLE}[07]${UI_RST} ${UI_BOLD}ACTIVITY LOGS${UI_RST}	${UI_DIM}Inspect operational events, runner traces & error history${UI_RST}
EOF
)

        local fzf_out fzf_rc=0
        fzf_out=$(echo "$menu_entries" | fzf \
            --delimiter=$'\t' \
            --with-nth=2,3 \
            --expect=ctrl-l \
            --border-label="  ╢ gamectl :: Master Dashboard Hub ╟  " \
            --border-label-pos=2 \
            --header="MASTER DASHBOARD (Arrows/Numbers: Select │ Enter: Open │ Ctrl-L: Logs │ Esc: Exit)" \
            --prompt="Dashboard > " \
            --preview="$SELF_BIN --preview-dashboard {1} $game_count" \
            --preview-window=right:55%:border-rounded:wrap \
        ) || fzf_rc=$?

        [ "$fzf_rc" -eq 130 ] && break
        [ -z "$fzf_out" ] && continue

        local trigger_key selection
        trigger_key=$(echo "$fzf_out" | head -n 1)
        selection=$(echo "$fzf_out" | sed -n '2p')

        if [ "$trigger_key" = "ctrl-l" ]; then
            view_logs_interactive
            continue
        fi

        [ -z "$selection" ] && continue

        local sel_key
        sel_key=$(echo "$selection" | awk -F'\t' '{print $1}')

        case "$sel_key" in
            1)
                library_menu false
                ;;
            2)
                search_steam "" false
                ;;
            3)
                list_downloads_interactive
                ;;
            4)
                unlock_interactive
                ;;
            5)
                configure_global
                ;;
            6)
                flush_tty_input
                doctor_audit 2>&1 | fzf \
                    --ansi \
                    --no-sort \
                    --border-label="  ╢ gamectl :: System Diagnostics Audit ╟  " \
                    --border-label-pos=2 \
                    --header="SYSTEM DIAGNOSTICS (Arrows: Scroll │ Esc / q / Enter: Return to Dashboard)" \
                    --prompt="Audit > " \
                    --bind="q:abort" \
                    --reverse 2>/dev/null || true
                ;;
            7)
                view_logs_interactive
                ;;
            *)
                break
                ;;
        esac
        flush_tty_input
    done
    exit_tui_screen
}

# Main Library View
library_menu() {
    local standalone="${1:-false}"
    [ "$standalone" = "true" ] && enter_tui_screen
    clean_stale_locks

    while true; do
        flush_tty_input
        local fzf_out fzf_rc=0
        fzf_out=$(scan_installed_games --formatted | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2,3 \
            --expect=ctrl-f,ctrl-d,ctrl-l,ctrl-o,ctrl-p,ctrl-i,ctrl-s,ctrl-b,ctrl-r \
            --border-label="  ╢ gamectl :: Game Library ╟  " \
            --border-label-pos=2 \
            --header=$'GAME LIBRARY (Enter: Launch │ Esc: Dashboard Hub)\nShortcuts: Ctrl-F (Search) │ Ctrl-D (Downloads) │ Ctrl-L (Logs) │ Ctrl-I (Inject) │ Ctrl-O (Wrappers) │ Ctrl-P (LAN ID) │ Ctrl-S (Sync) │ Ctrl-B (Backup) │ Ctrl-R (Restore)' \
            --prompt="Library > " \
            --preview="$SELF_BIN --preview {1} {2} {3} {4} {5}" \
            --preview-window=right:55%:border-rounded:wrap \
        ) || fzf_rc=$?

        [ "$fzf_rc" -eq 130 ] && break
        [ -z "$fzf_out" ] && continue

        local trigger_key selection
        trigger_key=$(echo "$fzf_out" | head -n 1)
        selection=$(echo "$fzf_out" | sed -n '2p')

        # Global in-process hotkeys that do not require item selection
        if [ "$trigger_key" = "ctrl-l" ]; then
            view_logs_interactive
            continue
        elif [ "$trigger_key" = "ctrl-f" ]; then
            search_steam "" false
            invalidate_scan_cache
            continue
        elif [ "$trigger_key" = "ctrl-d" ]; then
            list_downloads_interactive
            continue
        fi

        [ -z "$selection" ] && continue

        local sel_appid sel_title sel_status sel_dir sel_bin
        sel_appid=$(echo "$selection" | awk -F'\t' '{print $1}')
        sel_title=$(echo "$selection" | awk -F'\t' '{print $2}')
        sel_status=$(echo "$selection" | awk -F'\t' '{print $3}')
        sel_dir=$(echo "$selection" | awk -F'\t' '{print $4}')
        sel_bin=$(echo "$selection" | awk -F'\t' '{print $5}')

        case "$trigger_key" in
            ctrl-o)
                configure_wrappers "$sel_dir" "$sel_title"
                invalidate_scan_cache
                continue
                ;;
            ctrl-p)
                set_id_interactive "$sel_dir" "$sel_title"
                invalidate_scan_cache
                continue
                ;;
            ctrl-i)
                inject_game "$sel_dir" "$sel_appid"
                sync_steam "$sel_appid" "$sel_title" "$sel_dir"
                invalidate_scan_cache
                tui_modal_notice "GBE Injection & Steam Sync" "Successfully injected GBE Fork & synchronized Steam entitlement for:\n${sel_title:-$sel_dir}"
                continue
                ;;
            ctrl-s)
                sync_save_remote "$sel_dir" "$sel_title"
                tui_modal_notice "Remote Sync" "Savegames synchronized with remote companion host for:\n${sel_title:-$sel_dir}"
                continue
                ;;
            ctrl-b)
                backup_save "$sel_dir"
                tui_modal_notice "Save Backup" "Savegame snapshot created in slot for:\n${sel_title:-$sel_dir}"
                continue
                ;;
            ctrl-r)
                if [ -d "$sel_dir/.save_snapshots" ]; then
                    local snaps
                    snaps=$(ls -d "$sel_dir/.save_snapshots"/slot* 2>/dev/null | wc -l)
                    if [ "$snaps" -gt 0 ]; then
                        local chosen_slot="1"
                        if [ "$snaps" -gt 1 ]; then
                            local slot_list=""
                            for s in "$sel_dir/.save_snapshots"/slot*; do
                                [ -d "$s" ] || continue
                                local s_name s_time
                                s_name=$(basename "$s")
                                s_time=$(date -r "$s" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "Snapshot")
                                slot_list+="${s_name}\t${s_time}\n"
                            done
                            flush_tty_input
                            local pick="" p_rc=0
                            pick=$(printf '%b' "$slot_list" | fzf \
                                --delimiter=$'\t' \
                                --border-label="  ╢ Restore Save Snapshot :: ${sel_title:-$sel_dir} ╟  " \
                                --border-label-pos=2 \
                                --header="Select Recovery Slot to Restore (Enter: Restore │ Esc: Cancel)" \
                                --prompt="Restore Slot > " \
                                --height=30% \
                                --reverse 2>/dev/null) || p_rc=$?
                            [ "$p_rc" -eq 130 ] || [ -z "$pick" ] && continue
                            chosen_slot=$(echo "$pick" | cut -f1)
                            chosen_slot="${chosen_slot#slot}"
                        fi
                        if restore_save "$sel_dir" "$chosen_slot"; then
                            tui_modal_notice "Save Restore" "Savegame restored successfully from slot${chosen_slot} for:\n${sel_title:-$sel_dir}"
                        else
                            tui_modal_notice "Save Restore Error" "Failed to restore savegame from slot${chosen_slot} for:\n${sel_title:-$sel_dir}"
                        fi
                    else
                        tui_modal_notice "Save Restore" "No snapshot recovery slots found for:\n${sel_title:-$sel_dir}"
                    fi
                else
                    tui_modal_notice "Save Restore" "No snapshot recovery directory (.save_snapshots) found for:\n${sel_title:-$sel_dir}"
                fi
                continue
                ;;
            *)
                local launch_rc=0
                launch_game "$sel_dir" "$sel_bin" "$sel_title" || launch_rc=$?
                invalidate_scan_cache
                if [ "$launch_rc" -eq 10 ]; then
                    # User selected return directly to Master Dashboard
                    break
                fi
                ;;
        esac
    done

    [ "$standalone" = "true" ] && exit_tui_screen
    return 0
}

# Live Steam Search View (Actionable TUI Search)
search_steam() {
    local query="${1:-}"
    local standalone="${2:-false}"
    [ "$standalone" = "true" ] && enter_tui_screen
    flush_tty_input
    if [ -z "$query" ]; then
        local query_raw="" fzf_rc=0
        query_raw=$(: | fzf \
            --print-query \
            --border-label="  ╢ gamectl :: Steam Store Search ╟  " \
            --border-label-pos=2 \
            --header="Type game title to search (Enter: Search │ Esc: Cancel)" \
            --prompt="Search Store > " \
            --height=20% \
            --reverse 2>/dev/null) || fzf_rc=$?

        # Only abort if user cancelled via ESC or Ctrl-C (exit status 130)
        if [ "$fzf_rc" -eq 130 ]; then
            flush_tty_input
            [ "$standalone" = "true" ] && exit_tui_screen
            [ "$fzf_rc" -eq 130 ] && return 0
        fi

        query=$(echo "$query_raw" | head -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if [ -z "$query" ]; then
            flush_tty_input
            [ "$standalone" = "true" ] && exit_tui_screen
            return 0
        fi
    fi

    log_msg "INFO" "STORE" "Searching '$query' on Steam Store API..."
    local encoded_query
    encoded_query=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
    local raw_results
    raw_results=$(curl -s --connect-timeout 5 "https://store.steampowered.com/api/storesearch/?term=${encoded_query}&l=english&cc=US" 2>/dev/null)

    local items
    items=$(echo "$raw_results" | jq -r '.items[]? | "\(.id)\t\(.name)"' 2>/dev/null || true)

    if [ -z "$items" ]; then
        log_msg "WARN" "STORE" "Game '$query' not found on Steam Store API."
        tui_modal_notice "Steam Store Search" "Game '$query' was not found on Steam Store."
        [ "$standalone" = "true" ] && exit_tui_screen
        return 0
    fi

    # Build list with local installed status across all libraries via scan_installed_games
    local results=""
    declare -A installed_by_id=()
    declare -A installed_by_title=()
    declare -A installed_dir=()

    _refresh_search_results() {
        results=""
        installed_by_id=()
        installed_by_title=()
        installed_dir=()

        local sc_id sc_name sc_st sc_dir sc_bin
        while IFS=$'\t' read -r sc_id sc_name sc_st sc_dir sc_bin; do
            sc_id="${sc_id//[[:space:]]/}"
            sc_name="${sc_name#"${sc_name%%[![:space:]]*}"}"
            sc_name="${sc_name%"${sc_name##*[![:space:]]}"}"
            sc_dir="${sc_dir//$'\r'/}"
            if [ -n "$sc_id" ] && [ "$sc_id" != "STANDALONE" ]; then
                installed_by_id["$sc_id"]=1
                installed_dir["$sc_id"]="$sc_dir"
            fi
            if [ -n "$sc_name" ]; then
                local clean_title="${sc_name,,}"
                installed_by_title["$clean_title"]=1
                [ -z "${installed_dir["$clean_title"]:-}" ] && installed_dir["$clean_title"]="$sc_dir"
            fi
        done < <(scan_installed_games --refresh)

        while IFS=$'\t' read -r appid name; do
            [ -z "$appid" ] && continue
            local is_installed=0
            local clean_name="${name,,}"
            if [[ -v installed_by_id["$appid"] ]] || [[ -v installed_by_title["$clean_name"] ]]; then
                is_installed=1
            fi
            local status="${UI_DIM}[NOT INSTALLED]${UI_RST}"
            [ "$is_installed" -eq 1 ] && status="${UI_GREEN}[INSTALLED]    ${UI_RST}"
            results+="${appid}"$'\t'"${name}"$'\t'"${status}"$'\n'
        done <<< "$items"
    }

    _refresh_search_results

    while true; do
        flush_tty_input
        local fzf_out fzf_rc=0
        fzf_out=$(echo -n "$results" | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2,3 \
            --expect=ctrl-a,ctrl-u,ctrl-s,ctrl-d \
            --bind="ctrl-a:accept,ctrl-u:accept,ctrl-s:accept,ctrl-d:accept" \
            --border-label="  ╢ gamectl :: Steam Store Catalog ╟  " \
            --border-label-pos=2 \
            --header="STEAM CATALOG (Enter: Actions │ Ctrl-A: All-in-One │ Ctrl-U: Entitle │ Ctrl-S: Standalone │ Esc: Back)" \
            --prompt="Steam Store > " \
            --preview="$SELF_BIN --preview-search {1} {2} {3}" \
            --preview-window=right:52%:border-rounded:wrap \
        ) || fzf_rc=$?

        [ "$fzf_rc" -eq 130 ] && break
        [ -z "$fzf_out" ] && continue

        local trigger_key selection
        trigger_key=$(echo "$fzf_out" | sed -n '1p')
        selection=$(echo "$fzf_out" | sed -n '2,$p')

        [ -z "$selection" ] && continue

        local sel_id sel_name sel_status
        sel_id=$(echo "$selection" | awk -F'\t' '{print $1}')
        sel_name=$(echo "$selection" | awk -F'\t' '{print $2}')
        sel_status=$(echo "$selection" | awk -F'\t' '{print $3}')

        local gdir=""
        local clean_sel_name="${sel_name,,}"
        if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
            if [ -n "${installed_dir["$sel_id"]:-}" ] && [ -d "${installed_dir["$sel_id"]}" ]; then
                gdir="${installed_dir["$sel_id"]}"
            elif [ -n "${installed_dir["$clean_sel_name"]:-}" ] && [ -d "${installed_dir["$clean_sel_name"]}" ]; then
                gdir="${installed_dir["$clean_sel_name"]}"
            elif [ -d "$HOME/Games/$sel_name" ]; then
                gdir="$HOME/Games/$sel_name"
            fi
        fi

        # Resolve optimal destination library and target OS platform for uninstalled games
        local dest_dir target_os="linux"
        if [[ ! "$sel_status" =~ INSTALLED ]] || [[ "$sel_status" =~ NOT ]]; then
            dest_dir="$(resolve_target_library_dir "$sel_name")"
            target_os="$(detect_app_platform_os "$sel_id")"
        fi

        # Direct hotkey triggers
        if [ "$trigger_key" = "ctrl-a" ]; then
            if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-A>: Injecting GBE + Syncing Steam for $sel_name ($sel_id)"
                inject_game "$gdir" "$sel_id"
            else
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-A>: Starting All-in-One Background Download for $sel_name ($target_os)"
                download_game "$sel_id" "$dest_dir" "$sel_name" --all --background --os "$target_os"
            fi
        elif [ "$trigger_key" = "ctrl-u" ]; then
            if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-U>: Synchronizing Steam Entitlement & ACF for $sel_name ($sel_id)"
                sync_steam "$sel_id" "$sel_name" "$gdir"
            else
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-U>: Adopting Steam Entitlement & ACF for $sel_name ($sel_id)"
                unlock_game "$sel_id" "$sel_name"
            fi
        elif [ "$trigger_key" = "ctrl-s" ]; then
            if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-S>: Injecting Standalone GBE Fork for $sel_name ($sel_id)"
                inject_game "$gdir" "$sel_id" --no-sync
            else
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-S>: Starting Standalone Background Download for $sel_name ($target_os)"
                download_game "$sel_id" "$dest_dir" "$sel_name" --inject-only --background --os "$target_os"
            fi
        elif [ "$trigger_key" = "ctrl-d" ]; then
            if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
                local gbin
                gbin=$(find_game_binary "$gdir" 2>/dev/null || echo "")
                if [ -n "$gbin" ]; then
                    local launch_rc=0
                    launch_game "$gdir" "$gbin" "$sel_name" || launch_rc=$?
                    if [ "$launch_rc" -eq 10 ]; then
                        break
                    fi
                else
                    log_msg "ERROR" "LAUNCH" "Binary executable not found in $gdir for $sel_name"
                    tui_modal_notice "Executable Not Found" "Binary executable not found in directory:\n$gdir"
                fi
            else
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-D>: Starting All-in-One Live Stream Download for $sel_name ($target_os)"
                download_game "$sel_id" "$dest_dir" "$sel_name" --all --foreground --os "$target_os"
            fi
        else
            # Enter key: Open Modal Action Palette
            if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
                local action_palette
                action_palette=$(cat <<EOF
1	Launch Game Directly
2	Inject GBE Fork Only (Standalone ./saves & DLC.txt)
3	Inject GBE + Sync Steam Client (All-in-One Full DLC)
4	Sync to Steam Client Entitlement Only (ACF & Steam Input)
5	Cancel / Return
EOF
)
                local action_sel
                action_sel=$(echo "$action_palette" | fzf \
                    --delimiter=$'\t' \
                    --with-nth=2 \
                    --border-label="  ╢ Action Palette: $sel_name ╟  " \
                    --border-label-pos=2 \
                    --header="ACTION PALETTE (Enter: Execute │ Esc: Return)" \
                    --prompt="Action > " \
                    --height=40% \
                    --reverse 2>/dev/null) || action_sel="5"

                local act_opt
                act_opt=$(echo "$action_sel" | awk -F'\t' '{print $1}')

                case "$act_opt" in
                    1)
                        local gbin
                        gbin=$(find_game_binary "$gdir" 2>/dev/null || echo "")
                        if [ -n "$gbin" ]; then
                            local launch_rc=0
                            launch_game "$gdir" "$gbin" "$sel_name" || launch_rc=$?
                            if [ "$launch_rc" -eq 10 ]; then
                                break
                            fi
                        else
                            log_msg "ERROR" "LAUNCH" "Binary executable not found in $gdir for $sel_name"
                            tui_modal_notice "Executable Not Found" "Binary executable not found in directory:\n$gdir"
                        fi
                        ;;
                    2)
                        inject_game "$gdir" "$sel_id" --no-sync
                        ;;
                    3)
                        inject_game "$gdir" "$sel_id"
                        ;;
                    4)
                        sync_steam "$sel_id" "$sel_name" "$gdir"
                        ;;
                    *)
                        ;;
                esac
            else
                local not_installed_palette
                not_installed_palette=$(cat <<EOF
1	[All-in-One] Download & Auto-Provision via Steam Native CDN (SLSsteam)
2	[Steam Entitlement & ACF] Adopt files, Steam Input & Shaders (Full DLC)
3	[Standalone] Inject GBE LAN runtime (Steam-free)
4	Cancel / Return
EOF
)
                local pkg_sel
                pkg_sel=$(echo "$not_installed_palette" | fzf \
                    --delimiter=$'\t' \
                    --with-nth=2 \
                    --border-label="  ╢ Action Palette: $sel_name ╟  " \
                    --border-label-pos=2 \
                    --header="PACKAGE SELECTION (Enter: Execute │ Esc: Return)" \
                    --prompt="Package > " \
                    --height=40% \
                    --reverse 2>/dev/null) || pkg_sel="4"

                local opt
                opt=$(echo "$pkg_sel" | awk -F'\t' '{print $1}')
                case "$opt" in
                    1)
                        download_game "$sel_id" "$dest_dir" "$sel_name" --all --os "$target_os"
                        ;;
                    2)
                        unlock_game "$sel_id" "$sel_name"
                        ;;
                    3)
                        inject_game "$dest_dir" "$sel_id" --no-sync
                        ;;
                    *)
                        ;;
                esac
            fi
        fi
        _refresh_search_results
    done

    flush_tty_input
    [ "$standalone" = "true" ] && exit_tui_screen
    return 0
}


# --- [MODULE] src/main.sh ---
# Export functions for subshells in fzf
export -f get_runtime_dir strip_ansi preview_game sync_save_remote sync_to_companion sync_to_tuf pull_save_remote pull_from_companion pull_from_tuf backup_save restore_save inject_game fetch_dlc setup_gbe_templates download_game ensure_downloader resolve_depot_dl_bin resolve_target_library_dir resolve_standalone_library_dir detect_steamstub_drm detect_steamstub_type resolve_unpacked_binary find_steamless_cli unpack_steamstub_pe setup_steam_interceptor diagnose_steamstub cli_unpack_stub harvest_dlc_manifests detect_app_platform_os sync_steam list_downloads list_downloads_interactive unlock_game unlock_interactive entitle_game entitle_interactive adopt_steam get_remote_host get_gbe_template find_game_binary find_runner get_wineserver_bin launch_game game_controller_hud is_haswell_gpu get_native_resolution get_default_gamescope_args get_steam_root get_steam_primary_apps get_steam_libraries build_wrapper_command configure_wrappers configure_global doctor_audit cli_launch generate_steamid64 resolve_active_steamid get_game_persona set_id set_id_interactive preview_dashboard dashboard_menu scan_installed_games detect_dll_overrides setup_onlinefix proton_list proton_install proton_remove manage_prefix query_protondb create_desktop_entry get_steam_grid_dir fetch_steam_artwork get_steam_shortcuts_vdf add_steam_shortcut check_steam_active fetch_cached_json check_systemd_scope_support detect_dgpu_vendor build_sandbox_command manifest_has_payload_magic validate_manifest_zip fetch_manifest get_sls_root get_sls_manifests_dir get_steam_stplug_in_dir get_steam_depotcache_dir deploy_sls_manifest trigger_steam_install find_app_acf format_bytes parse_acf_download_state check_game_fixes resolve_game_install_dir audit_proton_compatibility detect_fix_custom_launcher install_game_fix revert_game_fix restart_steam_client clean_stale_locks get_compat_dir get_valid_luatools_token is_valid_lua_manifest library_menu login_luatools luatools_status search_steam invalidate_scan_cache flush_tty_input enter_tui_screen exit_tui_screen tui_modal_notice get_runtime_log_file log_msg log_info log_warn log_error view_logs_interactive preview_search_game preview_download get_depot_dl_progress

# Top-level Menu
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
case "${1:-}" in
    proton-list|proton)
        proton_list
        ;;
    proton-install)
        proton_install "${2:-latest}" "${@:3}"
        ;;
    proton-remove)
        if [ -n "${2:-}" ]; then
            proton_remove "$2" "${@:3}"
        else
            echo "Usage: gamectl proton-remove <tag> [-y|--yes]"
            exit 1
        fi
        ;;
    setup-gbe|gbe-setup|gbe-install|install-gbe)
        setup_gbe_templates "${@:2}"
        ;;
    mod-overrides|onlinefix|onlinefix-setup)
        if [ -n "${2:-}" ]; then
            setup_onlinefix "$2" "${@:3}"
        else
            echo "Usage: gamectl mod-overrides <game_dir> [--yes|-y] (alias: onlinefix)"
            exit 1
        fi
        ;;
    fix-check|check-fix)
        if [ -n "${2:-}" ]; then
            check_game_fixes "$2" "${@:3}"
        else
            echo "Usage: gamectl fix-check <appid>"
            exit 1
        fi
        ;;
    fix-install|install-fix|apply-fix)
        if [ -n "${2:-}" ]; then
            install_game_fix "$2" "${@:3}"
        else
            echo "Usage: gamectl fix-install <appid> [game_dir] [--type online|generic|voices38|all] [--fix-id <id>] [--yes|-y] [--restart]"
            exit 1
        fi
        ;;
    fix-revert|revert-fix)
        if [ -n "${2:-}" ]; then
            revert_game_fix "$2" "${@:3}"
        else
            echo "Usage: gamectl fix-revert <game_dir|appid> [--dry-run]"
            exit 1
        fi
        ;;
    restart-steam|reload-steam)
        restart_steam_client "${@:2}"
        ;;
    detect-overrides|dll-overrides)
        if [ -n "${2:-}" ]; then
            detect_dll_overrides "$2" "${3:-}"
        else
            echo "Usage: gamectl detect-overrides <game_dir> [existing_overrides]"
            exit 1
        fi
        ;;
    pfx|prefix)
        if [ -n "${2:-}" ]; then
            manage_prefix "$2" "${3:-}" "${@:4}"
        else
            echo "Usage: gamectl pfx <game_dir> [winecfg|regedit|cmd|shell|kill|clean|winetricks] [args...]"
            exit 1
        fi
        ;;
    protondb|pdb)
        if [ -n "${2:-}" ]; then
            query_protondb "$2"
        else
            echo "Usage: gamectl protondb <appid|game_dir>"
            exit 1
        fi
        ;;
    make-desktop|desktop-entry)
        if [ -n "${2:-}" ]; then
            create_desktop_entry "$2" "${3:-}"
        else
            echo "Usage: gamectl make-desktop <game_dir> [title]"
            exit 1
        fi
        ;;
    fetch-art|fetch-artwork|get-art)
        if [ -n "${2:-}" ]; then
            fetch_steam_artwork "$2" "${3:-}"
        else
            echo "Usage: gamectl fetch-art <game_dir|appid> [appid]"
            exit 1
        fi
        ;;
    get-steam-grid)
        get_steam_grid_dir
        ;;
    add-to-steam|add-steam|shortcut-steam)
        if [ -n "${2:-}" ]; then
            add_steam_shortcut "$2" "${3:-}"
        else
            echo "Usage: gamectl add-to-steam <game_dir> [title]"
            exit 1
        fi
        ;;
    get-steam-shortcuts)
        get_steam_shortcuts_vdf
        ;;
    dashboard|menu|--dashboard)
        dashboard_menu
        ;;
    library|list-ui)
        library_menu true
        ;;
    config|config-global|configure)
        configure_global
        ;;
    doctor|audit)
        doctor_audit
        ;;
    check-scope|systemd-scope)
        if check_systemd_scope_support; then
            echo "[INFO] cgroups v2 / systemd-run user scope isolation is supported and active."
            exit 0
        else
            echo "[WARN] cgroups v2 / systemd-run user scope isolation is not supported on this host."
            exit 1
        fi
        ;;
    detect-gpu|gpu-detect|dgpu)
        vend="$(detect_dgpu_vendor)"
        echo "[INFO] Detected secondary discrete GPU vendor: $vend"
        if [ "$vend" != "none" ]; then
            exit 0
        else
            exit 1
        fi
        ;;
    check-sandbox|sandbox-check)
        if command -v bwrap >/dev/null 2>&1; then
            echo "[INFO] bubblewrap (bwrap) is installed and available for security sandboxing."
            exit 0
        else
            echo "[WARN] bubblewrap (bwrap) is not found in PATH."
            exit 1
        fi
        ;;
    --preview-dashboard)
        preview_dashboard "${2:-1}" "${3:-}"
        ;;
    --preview-search)
        preview_search_game "${2:-}" "${3:-}" "${4:-}"
        ;;
    --preview-download)
        preview_download "${2:-}" "${3:-}" "${4:-}"
        ;;
    set-id)
        if [ -n "${2:-}" ]; then
            set_id "${@:2}"
        else
            echo "Usage: gamectl set-id <player_name> [steamid] [game_dir] [--broadcast <ip>] [--global]"
            exit 1
        fi
        ;;
    generate-steamid)
        generate_steamid64
        ;;
    get-gamescope-args)
        get_default_gamescope_args
        ;;
    get-resolution)
        get_native_resolution
        ;;
    get-steam-root)
        get_steam_root
        ;;
    get-steam-libraries|steam-libs)
        get_steam_libraries
        ;;
    get-wineserver)
        get_wineserver_bin "${2:-}"
        ;;
    resolve-library|get-target-library)
        resolve_target_library_dir "${2:-game}"
        ;;
    resolve-standalone-library)
        resolve_standalone_library_dir "${2:-}" "${3:-}"
        ;;
    detect-steamstub|steamstub|check-stub)
        if [ -n "${2:-}" ]; then
            diagnose_steamstub "$2"
        else
            echo "Usage: gamectl detect-steamstub <binary>"
            exit 2
        fi
        ;;
    unpack-stub|unpack|steamless)
        if [ -n "${2:-}" ]; then
            cli_unpack_stub "$2"
        else
            echo "Usage: gamectl unpack-stub <binary.exe>"
            exit 2
        fi
        ;;
    detect-os)
        detect_app_platform_os "${2:-}"
        ;;
    check-steam|check-steam-active)
        check_steam_active "${2:-Manual check}"
        ;;
    cache-json|fetch-cached-json)
        fetch_cached_json "${2:-}" "${3:-}" "${4:-3600}"
        ;;
    set-id-interactive)
        if [ -n "${2:-}" ]; then
            set_id_interactive "$2" "${3:-}"
        else
            echo "Usage: gamectl set-id-interactive <game_dir> [title]"
            exit 1
        fi
        ;;
    launch|run|--launch)
        if [ -n "${2:-}" ]; then
            cli_launch "${@:2}"
        else
            echo "Usage: gamectl launch <game_dir> [binary] [title] [--hud] [--gamemode] [--gamescope] [--fsr]"
            exit 1
        fi
        ;;
    configure-wrappers)
        if [ -n "${2:-}" ]; then
            configure_wrappers "$2" "${3:-}"
        else
            echo "Usage: gamectl configure-wrappers <game_dir> [title]"
            exit 1
        fi
        ;;
    inject|--inject)
        if [ -n "${2:-}" ]; then
            inject_game "$2" "${3:-}" "${4:-all}"
        else
            echo "Usage: gamectl inject <game_dir> [appid] [--no-sync|--all]"
            exit 1
        fi
        ;;
    fetch-dlc|--fetch-dlc)
        if [ -n "${2:-}" ]; then
            fetch_dlc "$2" "${3:-}"
        else
            echo "Usage: gamectl fetch-dlc <game_dir> [appid]"
            exit 1
        fi
        ;;
    download|--download)
        if [ -n "${2:-}" ]; then
            download_game "$2" "${@:3}"
        else
            echo "Usage: gamectl download <appid> [dir] [title] [--source <auto|...>] [--raw|--inject-only|--all|--standalone|--sls]"
            exit 1
        fi
        ;;
    unlock|add-steam|entitle|adopt-steam|--unlock|--entitle)
        if [ -n "${2:-}" ]; then
            unlock_game "$2" "${3:-}"
        else
            if [ -t 0 ]; then
                unlock_interactive
            else
                echo "Usage: gamectl entitle <appid> [title] (aliases: unlock, adopt-steam)"
                exit 1
            fi
        fi
        ;;
    downloads|--downloads|download-status|--download-status)
        if [ "${1:-}" = "download-status" ] || [ "${1:-}" = "--download-status" ] || [ ! -t 0 ] || [ ! -t 1 ]; then
            list_downloads
        else
            enter_tui_screen
            list_downloads_interactive
            exit_tui_screen
        fi
        ;;
    sync-steam|--sync-steam)
        if [ -n "${2:-}" ]; then
            sync_steam "$2" "${3:-}" "${4:-}"
        else
            echo "Usage: gamectl sync-steam <appid> [title] [game_dir]"
            exit 1
        fi
        ;;
    deploy-manifest|deploy-sls)
        if [ -n "${2:-}" ]; then
            deploy_sls_manifest "$2" "${3:-}" "${4:-}"
        else
            echo "Usage: gamectl deploy-manifest <appid> [manifest_zip] [title]"
            exit 1
        fi
        ;;
    fetch-manifest|manifest)
        if [ -n "${2:-}" ]; then
            fetch_manifest "$2" "${3:-}" "${4:-auto}"
        else
            echo "Usage: gamectl fetch-manifest <appid> [dest_file] [source]"
            exit 1
        fi
        ;;
    harvest-dlc|dlc-manifests|fetch-dlc-manifests)
        if [ -n "${2:-}" ]; then
            harvest_dlc_manifests "$2" "${3:-.}" "${4:-auto}"
        else
            echo "Usage: gamectl harvest-dlc <appid> [stage_dir] [source]"
            exit 1
        fi
        ;;
    login-luatools|auth-luatools)
        login_luatools "${2:-}"
        ;;
    auth-status|luatools-status)
        luatools_status
        ;;
    ensure-downloader)
        ensure_downloader
        ;;
    --preview)
        preview_game "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}"
        ;;
    --backup|backup|backup-save)
        if [ -n "${2:-}" ]; then
            backup_save "$2"
        else
            echo "Usage: gamectl backup <game_dir>"
            exit 1
        fi
        ;;
    --restore|restore|restore-save)
        if [ -n "${2:-}" ]; then
            restore_save "$2" "${3:-1}"
        else
            echo "Usage: gamectl restore <game_dir> [slot_num]"
            exit 1
        fi
        ;;
    search|--search)
        is_standalone=true
        q_arg="${2:-}"
        if [ "$q_arg" = "--no-dashboard" ]; then
            q_arg=""
            is_standalone=false
        elif [ "${3:-}" = "--no-dashboard" ]; then
            is_standalone=false
        fi
        search_steam "$q_arg" "$is_standalone"
        ;;
    logs|--logs)
        enter_tui_screen
        view_logs_interactive
        exit_tui_screen
        ;;
    --sync|sync|sync-remote|sync-companion|sync-tuf)
        if [ -n "${2:-}" ]; then
            sync_save_remote "$2" "${3:-Game}" "${4:-}" "${@:5}"
        else
            echo "Usage: gamectl --sync <game_dir> [title] [remote_host] [--dry-run]"
            exit 1
        fi
        ;;
    --sync-pull|sync-pull|pull-remote|pull-companion|pull-tuf)
        if [ -n "${2:-}" ]; then
            pull_save_remote "$2" "${3:-Game}" "${4:-}" "${@:5}"
        else
            echo "Usage: gamectl sync-pull <game_dir> [title] [remote_host] [--dry-run]"
            exit 1
        fi
        ;;
    --list|list)
        scan_installed_games "${@:2}"
        ;;
    list-formatted|--list-formatted)
        scan_installed_games --formatted "${@:2}"
        ;;
    --version|-v)
        echo "gamectl v1.4.0 (sovereign native TUI)"
        ;;
    --help|-h)
        cat <<EOF
gamectl - Sovereign TUI Game Manager & Launcher (Zero-Bloat)

Usage:
  gamectl [menu]      Open Master Dashboard Hub TUI (alias: dashboard)
  gamectl library     Open Game Library TUI directly (alias: list-ui)
  gamectl config      Open global configuration menu (~/.config/gamectl/) (alias: configure)
  gamectl doctor      Run 7-layer system & GPU health diagnostics (alias: audit)
  gamectl launch <dir> [bin] [title] [--hud] [--gamemode] [--gamescope] [--fsr] [--glthread] [--scope|--no-scope] [--prime|--no-prime] [--sandbox|--no-sandbox]
                      Launch game with isolated prefix and runtime wrapper options
  gamectl configure-wrappers <dir> [title]
                      Configure per-game wrappers (GameMode/MangoHud/Gamescope FSR/MesaGL)
  gamectl download <appid> [dir] [title] [--source <auto|...>] [--standalone|--sls] [--raw|--inject-only]
                      Download game via native Valve CDN (default: Pure Standalone zero-client)
  gamectl downloads   Monitor active & recent downloads (Interactive TUI)
  gamectl download-status
                      Display active download tasks across Steam & Standalone engines
  gamectl fetch-manifest <appid> [dest] [source]
                      Harvest manifest archive across Ryuu/Sushi/LuaTools providers
  gamectl auth-status Display current LuaTools authentication session & auto-refresh status
  gamectl login-luatools <code|token|file>
                      Authenticate standalone LuaTools provider (6-char code, refresh token, or json)
  gamectl deploy-manifest <appid> [manifest_zip] [title]
                      Deploy manifest & stplug-in keys into SLSsteam & Steam depotcache
  gamectl entitle <appid> [title]
                      Adopt local assets, Steam Input & shaders via Steam entitlement & ACF (aliases: unlock, adopt-steam)
  gamectl unlock <appid> [title] (Alias for entitle)
  gamectl inject <dir> [appid] [--no-sync|--all]
                      Inject decentralized LAN runtime & portable saves
  gamectl setup-gbe [--yes] [--force] [--linux-only|--win-only] [--dest <dir>]
                      Auto-download & provision Goldberg Emulator templates into ~/.local/share/gbe-fork/
  gamectl mod-overrides <dir>
                      Setup P2P multiplayer compatibility & mod DLL overrides (alias: onlinefix)
  gamectl onlinefix <dir> (Alias for mod-overrides)
  gamectl fix-check <appid>
                      Query available community, Denuvo, & Online-Fix bypasses (Public)
  gamectl fix-install <appid> [dir] [--type online|generic] [--yes] [--restart]
                      Download, verify, backup, & deploy Online-Fix/bypass directly to game
  gamectl fix-revert <dir|appid> [--dry-run]
                      Safely revert game fix and restore pristine vanilla files from snapshot
  gamectl restart-steam
                      Graceful Steam client hot-reload (SLSsteam & Game Mode supervisor)
  gamectl proton-list List local & latest upstream GE-Proton releases
  gamectl proton-install [tag|latest] Headless GE-Proton installer
  gamectl proton-remove <tag> Safely remove an installed GE-Proton version
  gamectl pfx <dir> [action] [args...] [--dry-run]
                      Wine prefix Swiss Army knife (winecfg/regedit/cmd/shell/kill/clean/winetricks)
  gamectl protondb <appid|dir>
                      Query ProtonDB community rating & launch recommendations
  gamectl make-desktop <dir> [title]
                      Generate FreeDesktop .desktop application shortcut
  gamectl add-to-steam <dir> [title]
                      Register standalone game as non-Steam shortcut in Steam Deck Game Mode
  gamectl fetch-art <dir|appid> [appid]
                      Download official Steam capsule, banner, hero, & logo artwork
  gamectl set-id <player> [steamid] [dir] [--broadcast <ip>] [--global]
                      Configure LAN player name & SteamID for offline co-op
  gamectl fetch-dlc <dir> [appid] Fetch & generate steam_settings/DLC.txt
  gamectl harvest-dlc <appid> [dir]
                      Harvest & unpack multi-depot DLC manifests across CDN providers
  gamectl sync-steam <appid> [title] [dir] Sync Steam Client & SLSsteam entitlements
  gamectl get-resolution Print detected native display resolution
  gamectl get-gamescope-args Print dynamically scaled Gamescope FSR parameters
  gamectl get-steam-root   Print detected active Steam root directory
  gamectl get-steam-libraries Print all detected Steam library folders
  gamectl detect-gpu       Audit and print detected secondary discrete GPU vendor
  gamectl check-scope      Check if cgroups v2 / systemd-run user scope isolation is supported
  gamectl check-sandbox    Check if bubblewrap (bwrap) rootless security sandbox is available
  gamectl search [query]   Search Steam Store catalog & audit ProtonDB rating
  gamectl --search         Search Steam Store catalog (interactive TUI prompt)
  gamectl --list      Print detected installed games list
  gamectl list-formatted  Print formatted games list with ANSI badges
  gamectl detect-steamstub <bin>
                      Audit SteamStub (.bind ELF & PE markers) and print forensic diagnostics
  gamectl unpack-stub <bin.exe>
                      Unpack Windows PE SteamStub DRM binary via Steamless CLI
  gamectl --sync <dir> [title] [host]   Push saves to remote companion host (alias: sync)
  gamectl sync-pull <dir> [title] [host] Pull saves from remote companion host (alias: --sync-pull)
  gamectl backup <dir>        Create manual savegame backup snapshot (alias: --backup)
  gamectl restore <dir> [slot]  Restore savegame snapshot from recovery slot (1-3)
  gamectl logs        View centralized runtime activity logs
  gamectl --help      Show this help documentation
  gamectl --version   Print active version
EOF
        ;;
    *)
        dashboard_menu
        ;;
esac
fi

