            echo "  ${UI_CYAN}Remote Sync Host   ${UI_RST}: ${UI_BOLD}${r_host:-None (Local Only)}${UI_RST}"
            echo "  ${UI_CYAN}Custom Libraries   ${UI_RST}: ${UI_BOLD}$lib_paths_count path(s) configured${UI_RST}"
            echo "  ${UI_CYAN}Config Location    ${UI_RST}: ${UI_BOLD}~/.config/gamectl/${UI_RST}"
            echo
            echo "  ${UI_DIM}Configurable Subsystems:${UI_RST}"
            echo "  • LAN Persona: Custom nickname and SteamID64 for multiplayer save isolation"
            echo "  • Runtime Wrappers: Global toggle for GameMode, MangoHud, and Gamescope FSR"
            echo "  • Multi-Library: Custom paths scanned across external drives or shared mounts"
            ;;
        *6*|*DOCTOR*|*AUDIT*|*DIAGNOSTICS*|*DIAGNOSTIK*)
            echo "${UI_BOX}╭─ SELECTED MODULE: [06] SYSTEM DIAGNOSTICS ────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}7-LAYER DEPENDENCY & RUNTIME HEALTH AUDIT${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

            local pass_cnt=0 warn_cnt=0 miss_cnt=0
            local l1_st="${UI_GREEN}[OK]${UI_RST}"
            local l2_st="${UI_GREEN}[OK]${UI_RST}"
            local l3_st="${UI_GREEN}[OK]${UI_RST}"
            local l4_st="${UI_GREEN}[OK]${UI_RST}"

            # Layer 1: CLI tools
            for t in fzf jq curl file zip unzip rsync ssh; do
                if command -v "$t" >/dev/null 2>&1; then
                    pass_cnt=$((pass_cnt + 1))
                else
                    miss_cnt=$((miss_cnt + 1))
                    l1_st="${UI_RED}[MISSING]${UI_RST}"
                fi
            done
            local has_7z=""
            for c in 7z 7za 7zr; do command -v "$c" >/dev/null 2>&1 && { has_7z="$c"; break; }; done
            if [ -n "$has_7z" ]; then
                pass_cnt=$((pass_cnt + 1))
            else
                warn_cnt=$((warn_cnt + 1))
            fi

            # Layer 2: Python Runtime
            if command -v python3 >/dev/null 2>&1; then
                pass_cnt=$((pass_cnt + 1))
                if python3 -c "import ruamel.yaml" >/dev/null 2>&1 || python3 -c "import yaml" >/dev/null 2>&1; then
                    pass_cnt=$((pass_cnt + 1))
                else
                    warn_cnt=$((warn_cnt + 1))
                    l2_st="${UI_AMBER}[WARN]${UI_RST}"
                fi
            else
                miss_cnt=$((miss_cnt + 1))
                l2_st="${UI_RED}[MISSING]${UI_RST}"
            fi

            # Layer 3: Runner
            if [ -n "$def_runner" ]; then
                pass_cnt=$((pass_cnt + 1))
            else
                miss_cnt=$((miss_cnt + 1))
                l3_st="${UI_RED}[MISSING]${UI_RST}"
            fi

            # Layer 4: GBE Templates
            if [ -n "$gbe_l64" ] && [ -n "$gbe_w64" ]; then
                pass_cnt=$((pass_cnt + 1))
            else
                warn_cnt=$((warn_cnt + 1))
                l4_st="${UI_AMBER}[PARTIAL]${UI_RST}"
            fi

            # Layer 5: Tooling wrappers
            for w in gamemoderun mangohud gamescope; do
                if command -v "$w" >/dev/null 2>&1; then
                    pass_cnt=$((pass_cnt + 1))
                else
                    warn_cnt=$((warn_cnt + 1))
                fi
            done

            # Layer 8: Security Sandboxing & Process Isolation
            local has_bwrap=0 has_scope=0
            if command -v bwrap >/dev/null 2>&1; then
                pass_cnt=$((pass_cnt + 1))
                has_bwrap=1
            else
                warn_cnt=$((warn_cnt + 1))
            fi
            if check_systemd_scope_support >/dev/null 2>&1; then
                pass_cnt=$((pass_cnt + 1))
                has_scope=1
            else
                warn_cnt=$((warn_cnt + 1))
            fi

            local health_badge="${UI_GREEN}[HEALTHY] Ready for Gaming${UI_RST}"
            if [ "$miss_cnt" -gt 0 ]; then
                health_badge="${UI_RED}[DEGRADED] Missing Core Dependencies${UI_RST}"
            elif [ "$warn_cnt" -gt 0 ]; then
                health_badge="${UI_AMBER}[OPERATIONAL] Minor Warnings Detected${UI_RST}"
            fi

            echo "  ${UI_CYAN}Overall Health     ${UI_RST}: $health_badge"
            echo "  ${UI_CYAN}Audit Summary      ${UI_RST}: ${UI_BOLD}${UI_GREEN}$pass_cnt passed${UI_RST} • ${UI_BOLD}${UI_AMBER}$warn_cnt warnings${UI_RST} • ${UI_BOLD}${UI_RED}$miss_cnt missing${UI_RST}"
            echo
            echo "  ${UI_BOLD}7-Layer Architecture Status:${UI_RST}"
            echo "  • L1 CLI Core Tools: $l1_st    • L2 Python & YAML: $l2_st"
            echo "  • L3 Windows Runner: $l3_st    • L4 GBE Templates: $l4_st"
            echo "  • L5 Wrappers      : GameMode $w_gm • MangoHud $w_hud • Gamescope $w_scope"
            echo "  • L6 Bridge (Opt)  : SLSsteam $sls_status • Steam Client $steam_status"
            echo "  • L8 Security      : Sandbox $([ "$has_bwrap" -eq 1 ] && echo "${UI_GREEN}[READY]${UI_RST}" || echo "${UI_AMBER}[OFF]${UI_RST}") • Scope $([ "$has_scope" -eq 1 ] && echo "${UI_GREEN}[READY]${UI_RST}" || echo "${UI_AMBER}[OFF]${UI_RST}")"
            echo
            echo "  ${UI_DIM}Full Audit: Press Enter to launch interactive 7-layer doctor_audit${UI_RST}"
            ;;
        *7*|*LOG*|*ACTIVITY*|*RIWAYAT*)
            echo "${UI_BOX}╭─ SELECTED MODULE: [07] ACTIVITY & RUNTIME LOGS ───────╮${UI_RST}"
            echo "│ ${UI_BOLD}CENTRALIZED OPERATIONAL TELEMETRY & AUDIT${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

            local log_lines=0 log_size="0B" log_warn=0 log_err=0 log_info=0
            if [ -s "$log_file" ]; then
                log_lines=$(wc -l < "$log_file" 2>/dev/null || echo 0)
                log_size=$(du -sh "$log_file" 2>/dev/null | awk '{print $1}' || echo "0B")
                log_warn=$(grep -c -E "\[WARN[ ]*\]" "$log_file" 2>/dev/null || true)
                log_err=$(grep -c -E "\[ERROR[ ]*\]" "$log_file" 2>/dev/null || true)
                log_info=$(grep -c -E "\[INFO[ ]*\]" "$log_file" 2>/dev/null || true)
            fi

            echo "  ${UI_CYAN}Log File Path      ${UI_RST}: ${UI_BOLD}$log_file${UI_RST}"
            echo "  ${UI_CYAN}Total Records      ${UI_RST}: ${UI_BOLD}$log_lines lines${UI_RST} ${UI_DIM}($log_size)${UI_RST}"
            echo "  ${UI_CYAN}Severity Breakdown ${UI_RST}: ${UI_GREEN}$log_info INFO${UI_RST} • ${UI_AMBER}$log_warn WARN${UI_RST} • ${UI_RED}$log_err ERROR${UI_RST}"
            echo
            echo "${UI_BOX}╭─ RECENT ACTIVITY LOGS ────────────────────────────────╮${UI_RST}"
            if [ -s "$log_file" ]; then
                tail -n 5 "$log_file" 2>/dev/null | while IFS= read -r line; do
                    echo "  ${UI_DIM}${line:0:84}${UI_RST}"
                done
            else
                echo "  ${UI_DIM}(No recent activity logged yet)${UI_RST}"
            fi
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
            echo
            echo "  ${UI_DIM}Log Controls: Press Enter to open viewer │ Ctrl-X in viewer to clear${UI_RST}"
            ;;
        *)
            echo "${UI_BOX}╭─ NAVIGATION INSTRUCTIONS ─────────────────────────────╮${UI_RST}"
            echo "  Select a module from the left panel using arrow keys or numbers."
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
            ;;
    esac
    echo
    echo "${UI_BOX}╭─ HUB CONTROLS ────────────────────────────────────────╮${UI_RST}"
    echo "  ${UI_PILL_ENTER} ${UI_BOLD}Open Selected Module${UI_RST}    ${UI_PILL_ESC} ${UI_BOLD}Exit / Close gamectl${UI_RST}"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
}

# Preview pane generator for Steam Store Search & ProtonDB compatibility
preview_search_game() {
    local appid="${1:-}"
    local title="${2:-}"
    local app_status="${3:-[NOT INSTALLED]}"

    appid=$(strip_ansi "$appid" | tr -d '[:space:]')
    title=$(strip_ansi "$title" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    app_status=$(strip_ansi "$app_status" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    printf "%s╭─ STEAM METADATA & PROTONDB AUDIT ───────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
    printf "│ %s%s%s %s(AppID: %s)%s\n" "${UI_BOLD}" "$title" "${UI_RST}" "${UI_DIM}" "$appid" "${UI_RST}"
    printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
    printf "  %sLocal State%s : %s\n" "${UI_CYAN}" "${UI_RST}" "$app_status"

    if [ -n "$appid" ] && [[ "$appid" =~ ^[0-9]+$ ]]; then
        local details
        details=$(fetch_steam_app_details "$appid" 2>/dev/null || true)
        if [ -n "$details" ] && [ "$details" != "null" ]; then
            local has_type="0" norm_type="APP" parent_id="" parent_name="" is_linux is_win genres
            if declare -F parse_steam_app_type_json >/dev/null 2>&1; then
                local parsed_type
                parsed_type=$(parse_steam_app_type_json "$details")
                IFS=$'\t' read -r has_type norm_type parent_id parent_name <<< "$parsed_type"
            fi
            if [ "$has_type" = "1" ]; then
                local type_badge
                type_badge="$(format_app_type_badge "$norm_type")"
                if [ "$norm_type" = "DLC" ] && [[ "$parent_id" =~ ^[0-9]+$ ]]; then
                    if [ -n "$parent_name" ]; then
                        printf "  %sType       %s : %s %s(Base: %s • %s)%s\n" "${UI_CYAN}" "${UI_RST}" "$type_badge" "${UI_DIM}" "$parent_name" "$parent_id" "${UI_RST}"
                    else
                        printf "  %sType       %s : %s %s(Base: %s)%s\n" "${UI_CYAN}" "${UI_RST}" "$type_badge" "${UI_DIM}" "$parent_id" "${UI_RST}"
                    fi
                else
                    printf "  %sType       %s : %s\n" "${UI_CYAN}" "${UI_RST}" "$type_badge"
                fi
            fi
            is_linux=$(echo "$details" | jq -r ".platforms.linux // false" 2>/dev/null || echo "false")
            is_win=$(echo "$details" | jq -r ".platforms.windows // false" 2>/dev/null || echo "false")
            genres=$(echo "$details" | jq -r "[.genres[]?.description] | join(\", \")" 2>/dev/null || true)
            [ -n "$genres" ] && printf "  %sGenres     %s : %s%s%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "$genres" "${UI_RST}"
            if [ "$is_linux" = "true" ]; then
                printf "  %sPlatform   %s : %sNative Linux ELF available%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_GREEN}" "${UI_RST}"
            elif [ "$is_win" = "true" ]; then
                printf "  %sPlatform   %s : %sWindows PE (Requires Proton/Wine)%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_PURPLE}" "${UI_RST}"
            fi
        fi

        printf "\n%s╭─ COMMUNITY COMPATIBILITY ───────────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        local pdb
        pdb=$(fetch_cached_json "https://www.protondb.com/api/v1/reports/summaries/${appid}.json" "protondb_${appid}" 3600 2>/dev/null || true)
        if [ -n "$pdb" ] && [ "$pdb" != "null" ]; then
            local tier score conf total tier_upper c_tier
            tier=$(echo "$pdb" | jq -r ".tier // \"Unknown\"" 2>/dev/null || echo "Unknown")
            score=$(echo "$pdb" | jq -r ".score // \"-\"" 2>/dev/null || echo "-")
            conf=$(echo "$pdb" | jq -r ".confidence // \"-\"" 2>/dev/null || echo "-")
            total=$(echo "$pdb" | jq -r ".total // \"-\"" 2>/dev/null || echo "-")
            tier_upper="${tier^^}"
            c_tier="${UI_GREEN}[$tier_upper]${UI_RST}"
            case "$tier_upper" in
                *PLATINUM*) c_tier="${UI_ICE}[PLATINUM]${UI_RST}" ;;
                *GOLD*)     c_tier="${UI_AMBER}[GOLD]${UI_RST}" ;;
                *SILVER*)   c_tier="${UI_DIM}[SILVER]${UI_RST}" ;;
                *BRONZE*)   c_tier="${UI_RED}[BRONZE]${UI_RST}" ;;
                *BORKED*)   c_tier="${UI_RED}[BORKED]${UI_RST}" ;;
            esac
            printf "  %sProtonDB Tier %s: %s\n" "${UI_CYAN}" "${UI_RST}" "$c_tier"
            local rep_str=""
            [ "$total" != "-" ] && rep_str=" • Reports: $total"
            printf "  %sRating Score  %s: %s%s%s %s(Confidence: %s%s)%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_BOLD}" "$score" "${UI_RST}" "${UI_DIM}" "$conf" "$rep_str" "${UI_RST}"
        else
            printf "  %sProtonDB Tier %s: %s[NO REPORTS YET]%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "${UI_RST}"
        fi
        printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
    else
        printf "\n%s╭─ COMMUNITY COMPATIBILITY ───────────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        printf "  %sProtonDB Tier %s: %s[INVALID APPID]%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "${UI_RST}"
        printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
    fi
}

# Preview pane generator for Activity & Runtime Log entries
preview_log_entry() {
    local raw_entry="$1"
    [ -z "$raw_entry" ] && return 0

    local ts="N/A" lvl="UNKNOWN" mod="GENERAL" msg="$raw_entry"
    if [[ "$raw_entry" =~ ^\[([^]]+)\][[:space:]]+\[([^]]+)\][[:space:]]+\[([^]]+)\][[:space:]]+(.*)$ ]]; then
        ts="${BASH_REMATCH[1]}"
        lvl="${BASH_REMATCH[2]// /}"
        mod="${BASH_REMATCH[3]// /}"
        msg="${BASH_REMATCH[4]}"
    fi

    local lvl_badge="${UI_BOLD}$lvl${UI_RST}"
    case "$lvl" in
        INFO)  lvl_badge="${UI_GREEN}${UI_BOLD}[INFO]${UI_RST}" ;;
        WARN)  lvl_badge="${UI_AMBER}${UI_BOLD}[WARN]${UI_RST}" ;;
        ERROR) lvl_badge="${UI_RED}${UI_BOLD}[ERROR]${UI_RST}" ;;
        DEBUG) lvl_badge="${UI_CYAN}${UI_BOLD}[DEBUG]${UI_RST}" ;;
    esac

    echo "${UI_BOX}╭─ LOG ENTRY DETAILS ─────────────────────────────────╮${UI_RST}"
    echo "  ${UI_CYAN}Timestamp  ${UI_RST}: ${UI_BOLD}$ts${UI_RST}"
    echo "  ${UI_CYAN}Severity   ${UI_RST}: $lvl_badge"
    echo "  ${UI_CYAN}Subsystem  ${UI_RST}: ${UI_PURPLE}${UI_BOLD}$mod${UI_RST}"
    echo "  ${UI_CYAN}Message    ${UI_RST}: $msg"
    echo "${UI_BOX}╰─────────────────────────────────────────────────────╯${UI_RST}"

    if [ "$lvl" = "ERROR" ]; then
        echo
        echo "${UI_RED}╭─ REMEDIATION & TROUBLESHOOTING GUIDANCE ────────────╮${UI_RST}"
        local advice="Run 'gamectl doctor' to audit system health or review recent activity logs."
        case "$mod" in
            *LAUNCH*|*RUNNER*)
                advice="Windows runner missing or crashed. Run 'gamectl doctor' or install Proton-GE/Wine."
                ;;
            *SAVE*|*BACKUP*|*RESTORE*)
                advice="Savegame snapshot error. Verify disk space in target directory or storage quota."
                ;;
            *STORE*|*DOWNLOAD*|*DEPOT*)
                advice="Network or CDN timeout. Check connectivity to Steam Store or CDN endpoints."
                ;;
            *GBE*|*INJECT*)
                advice="GBE injection failure. Check file permissions or verify 32-bit vs 64-bit architecture."
                ;;
            *DRM*|*STEAMSTUB*)
                advice="SteamStub DRM detected. Run 'gamectl unpack <exe>' using Steamless CLI."
                ;;
            *)
                if [[ "$msg" =~ (runner|wine|proton) ]]; then
                    advice="Windows runner failure. Verify runner configuration in ~/.config/gamectl/."
                elif [[ "$msg" =~ (permission|denied|write) ]]; then
                    advice="Filesystem permission error. Verify user write permissions on target directory."
                fi
                ;;
        esac
        echo "  ${UI_AMBER}• Suggestion: ${advice}${UI_RST}"
        echo "${UI_RED}╰─────────────────────────────────────────────────────╯${UI_RST}"
    fi
}

# --- [MODULE] src/tui/72_store_tui.sh ---
# ==============================================================================
# Multi-Store TUI Views & Cross-Store Search Switcher (Split from 70_dashboard.sh)
# ==============================================================================

# Interactive Cross-Store Search & Download Switcher
search_stores_interactive() {
    local query="${1:-}" target_store="${2:-all}"
    [ -t 0 ] && [ -t 1 ] && command -v fzf >/dev/null 2>&1 || return 1
    if [ -z "$query" ]; then
        query=$(tui_prompt_input "gamectl :: Cross-Store Search" "Search across Steam, GOG, Epic & Amazon" "" "Search All > ") || return 0
        query=$(echo "$query" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -n "$query" ] || return 0
    fi
    local raw_rows="" rows="" r_store r_id r_title r_plats r_status r_type r_parent
    raw_rows=$(store_search_all "$query" --store "$target_store" 2>/dev/null || true)
    if [ -z "$raw_rows" ]; then
        tui_modal_notice "Cross-Store Search" "No matches found across available stores for '$query'." || return $?
        return 0
    fi
    while IFS=$'\t' read -r r_store r_id r_title r_plats r_status r_type r_parent; do
        [ -n "$r_store" ] && [ -n "$r_id" ] || continue
        local badge; badge="$(format_app_type_badge "${r_type:-APP}")"
        rows+="${r_store}"$'\t'"${r_id}"$'\t'"${badge}"$'\t'"${r_title}"$'\t'"${r_plats}"$'\t'"${r_status}"$'\t'"${r_type}"$'\t'"${r_parent}"$'\n'
    done <<< "$raw_rows"

    local pick p_rc=0
    pick=$(printf '%s' "$rows" | fzf --delimiter=$'\t' --with-nth=1,2,3,4,5,6 \
        --border-label="  ╢ gamectl :: Cross-Store Catalog ($target_store) ╟  " --border-label-pos=2 \
        --header="Enter: Download via Store Adapter │ Esc: Return" --prompt="Cross-Store > ") || p_rc=$?
    [ "$p_rc" -eq 130 ] && return 0
    [ "$p_rc" -ne 0 ] && [ "$p_rc" -ne 1 ] && return "$p_rc"
    [ -n "$pick" ] || return 0

    IFS=$'\t' read -r r_store r_id _ r_title _ _ r_type r_parent <<< "$pick"
    local dest_dir; dest_dir="$(resolve_target_library_dir "$r_title")"
    if [ "$r_store" = "STEAM" ]; then
        local target_os; target_os="$(detect_app_platform_os "$r_id")"
        tui_exec_action "Steam Download ($r_title)" download_game "$r_id" "$dest_dir" "$r_title" --all --os "$target_os"
    else
        tui_exec_action "$r_store Download ($r_title)" store_dispatch "${r_store,,}" download "$r_id" "$dest_dir"
    fi
}

# --- [MODULE] src/tui/73_search_tui.sh ---
# ==============================================================================
# Live Steam Store Search & Actionable TUI Picker (Split from 70_dashboard.sh)
# ==============================================================================

# Live Steam Search View (Actionable TUI Search)
search_steam() {
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "[ERROR] Interactive Steam search requires a terminal (TTY)." >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for interactive mode but was not found in PATH." >&2
        return 127
    fi

    local query="${1:-}"
    local standalone="${2:-false}"
    [ "$standalone" = "true" ] && enter_tui_screen
    flush_tty_input
    if [ -z "$query" ]; then
        local fzf_rc=0
        # Input primitive canonicalized via tui_prompt_input (: | fzf wrapper)
        query=$(tui_prompt_input "gamectl :: Steam Store Search" "Type game title to search (Enter: Search │ Esc: Cancel)" "" "Search Store > ") || fzf_rc=$?
        [ "$fzf_rc" -eq 130 ] && return 0
        if [ "$fzf_rc" -ne 0 ]; then
            [ "$standalone" = "true" ] && exit_tui_screen
            return "$fzf_rc"
        fi
        query=$(echo "$query" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if [ -z "$query" ]; then
            [ "$standalone" = "true" ] && exit_tui_screen
            return 0
        fi
    fi

    log_msg "INFO" "STORE" "Searching '$query' on Steam Store API..."
    local encoded_query
    encoded_query=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
    local raw_results
    raw_results=$(curl -s --connect-timeout 5 --max-time 15 "https://store.steampowered.com/api/storesearch/?term=${encoded_query}&l=english&cc=US" 2>/dev/null)

    local items
    items=$(printf '%s' "$raw_results" | store_search_items) || {
        echo "[ERROR] Invalid Steam search catalog." >&2
        return 1
    }

    if [ -z "$items" ]; then
        log_msg "WARN" "STORE" "Game '$query' not found on Steam Store API."
        tui_modal_notice "Steam Store Search" "Game '$query' was not found on Steam Store." || return $?
        [ "$standalone" = "true" ] && exit_tui_screen
        return 0
    fi

    # Build list with local installed status across all libraries via scan_installed_games
    local results=""
    local type_filter="ALL"
    declare -A installed_by_id=()
    declare -A installed_by_title=()
    declare -A installed_dir=()
    declare -A item_type_map=()
    declare -A item_parent_map=()

    _classify_current_items() {
        item_type_map=()
        item_parent_map=()
        local -a batch_ids=()
        local c_id c_name
        while IFS=$'\t' read -r c_id c_name; do
            c_id="${c_id//[[:space:]]/}"
            [[ "$c_id" =~ ^[0-9]+$ ]] && batch_ids+=("$c_id")
        done <<< "$items"
        [ "${#batch_ids[@]}" -eq 0 ] && return 0

        local c_out c_type c_parent
        c_out=$(classify_steam_app_types "${batch_ids[@]}" 2>/dev/null || true)
        while IFS=$'\t' read -r c_id c_type c_parent; do
            [ -n "$c_id" ] || continue
            item_type_map["$c_id"]="${c_type:-APP}"
            item_parent_map["$c_id"]="${c_parent:-}"
        done <<< "$c_out"
    }

    _refresh_search_results() {
        results=""
        installed_by_id=()
        installed_by_title=()
        installed_dir=()

        local sc_id sc_name sc_st sc_dir sc_bin
        while IFS=$'\t' read -r sc_id sc_name sc_st sc_dir sc_bin; do
            sc_id="${sc_id//[[:space:]]/}"
            sc_name="${sc_name#"${sc_name%%[![:space:]]*}"}"
            sc_name="${sc_name%"${sc_name##*[![:space:]]}"}"
            sc_dir="${sc_dir//$'\r'/}"
            if [ -n "$sc_id" ] && [ "$sc_id" != "STANDALONE" ]; then
                installed_by_id["$sc_id"]=1
                installed_dir["$sc_id"]="$sc_dir"
            fi
            if [ -n "$sc_name" ]; then
                local clean_title="${sc_name,,}"
                installed_by_title["$clean_title"]=1
                [ -z "${installed_dir["$clean_title"]:-}" ] && installed_dir["$clean_title"]="$sc_dir"
            fi
        done < <(scan_installed_games --refresh)

        while IFS=$'\t' read -r appid name; do
            [ -z "$appid" ] && continue
            local is_installed=0
            local clean_name="${name,,}"
            if [[ -v installed_by_id["$appid"] ]] || [[ -v installed_by_title["$clean_name"] ]]; then
                is_installed=1
            fi
            local status="${UI_DIM}[NOT INSTALLED]${UI_RST}"
            [ "$is_installed" -eq 1 ] && status="${UI_GREEN}[INSTALLED]    ${UI_RST}"
            local raw_type="${item_type_map[$appid]:-APP}"
            local parent_appid="${item_parent_map[$appid]:-}"
            local type_badge
            type_badge="$(format_app_type_badge "$raw_type")"
            validate_tui_fields "$appid" "$name" "$raw_type" "$parent_appid" || continue
            results+="${appid}"$'\t'"${type_badge}"$'\t'"${name}"$'\t'"${status}"$'\t'"${raw_type}"$'\t'"${parent_appid}"$'\n'
        done <<< "$items"
    }

    _filtered_search_results() {
        if [ "$type_filter" = "ALL" ]; then
            printf '%s' "$results"
        else
            printf '%s' "$results" | awk -F'\t' -v tf="$type_filter" '$5 == tf'
        fi
    }

    _classify_current_items
    _refresh_search_results

    export GAMECTL_PREVIEW_BIN="$SELF_BIN"

    while true; do
        flush_tty_input
        local fzf_out fzf_rc=0
        local fzf_header="Enter: Actions │ Tab: Type ($type_filter) │ Alt-S: All Stores │ Ctrl-F: New Search │ Esc: Dashboard"
        fzf_out=$(_filtered_search_results | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2,3,4 \
            --expect=tab,alt-s,ctrl-a,ctrl-u,ctrl-s,ctrl-d,ctrl-f \
            --bind="tab:accept,alt-s:accept,ctrl-a:accept,ctrl-u:accept,ctrl-s:accept,ctrl-d:accept,ctrl-f:accept" \
            --border-label="  ╢ gamectl :: Steam Store Catalog [Type: $type_filter] ╟  " \
            --border-label-pos=2 \
            --header="$fzf_header" \
            --prompt="Filter Results > " \
            --preview='"$GAMECTL_PREVIEW_BIN" --preview-search {1} {3} {4}' \
            --preview-window=right:52%:border-rounded:wrap \
        ) || fzf_rc=$?

        [ "$fzf_rc" -eq 130 ] && break
        if [ "$fzf_rc" -ne 0 ] && [ "$fzf_rc" -ne 1 ]; then
            echo "[ERROR] Steam search catalog failed (fzf exit code $fzf_rc)." >&2
            return "$fzf_rc"
        fi
        [ -z "$fzf_out" ] && continue

        local trigger_key selection
        trigger_key=$(echo "$fzf_out" | sed -n '1p')
        selection=$(echo "$fzf_out" | sed -n '2,$p')

        if [ "$trigger_key" = "tab" ]; then
            case "$type_filter" in
                ALL)  type_filter="GAME" ;;
                GAME) type_filter="DLC" ;;
                *)    type_filter="ALL" ;;
            esac
            continue
        fi

        if [ "$trigger_key" = "alt-s" ]; then
            search_stores_interactive "$query" || true
            _refresh_search_results
            continue
        fi

        if [ "$trigger_key" = "ctrl-f" ]; then
            local new_q n_rc=0
            new_q=$(tui_prompt_input "gamectl :: Steam Store Search" "Type game title to search (Enter: Search │ Esc: Keep Current List)" "" "Search Store > ") || n_rc=$?
            if [ "$n_rc" -eq 130 ]; then
                continue
            fi
            if [ "$n_rc" -ne 0 ]; then
                return "$n_rc"
            fi
            new_q=$(echo "$new_q" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            if [ -z "$new_q" ]; then
                continue
            fi

            log_msg "INFO" "STORE" "Searching '$new_q' on Steam Store API..."
            local new_encoded_query
            new_encoded_query=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$new_q")
            local new_raw_results
            new_raw_results=$(curl -s --connect-timeout 5 --max-time 15 "https://store.steampowered.com/api/storesearch/?term=${new_encoded_query}&l=english&cc=US" 2>/dev/null)
            local new_items
            new_items=$(printf '%s' "$new_raw_results" | store_search_items) || true

            if [ -z "$new_items" ]; then
                log_msg "WARN" "STORE" "Game '$new_q' not found on Steam Store API."
                tui_modal_notice "Steam Store Search" "Game '$new_q' was not found on Steam Store." || true
                continue
            fi

            query="$new_q"
            items="$new_items"
            type_filter="ALL"
            _classify_current_items
            _refresh_search_results
            continue
        fi

        [ -z "$selection" ] && continue

        local sel_id="" sel_name="" sel_status="" sel_type="" sel_parent=""
        local _c1="" _c2="" _c3="" _c4="" _c5="" _c6=""
        IFS=$'\t' read -r _c1 _c2 _c3 _c4 _c5 _c6 <<< "$selection"
        if [ -n "$_c4" ]; then
            sel_id="$_c1"
            sel_name="$_c3"
            sel_status="$_c4"
            sel_type="$_c5"
            sel_parent="$_c6"
        else
            sel_id="$_c1"
            sel_name="$_c2"
            sel_status="$_c3"
        fi

        local gdir=""
        local clean_sel_name="${sel_name,,}"
        if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
            if [ -n "${installed_dir["$sel_id"]:-}" ] && [ -d "${installed_dir["$sel_id"]}" ]; then
                gdir="${installed_dir["$sel_id"]}"
            elif [ -n "${installed_dir["$clean_sel_name"]:-}" ] && [ -d "${installed_dir["$clean_sel_name"]}" ]; then
                gdir="${installed_dir["$clean_sel_name"]}"
            elif [ -d "$HOME/Games/$sel_name" ]; then
                gdir="$HOME/Games/$sel_name"
            fi
        fi

        # Resolve optimal destination library and target OS platform for uninstalled games
        local dest_dir target_os="linux"
        local -a dl_extra_args=()
        if [[ ! "$sel_status" =~ INSTALLED ]] || [[ "$sel_status" =~ NOT ]]; then
            dest_dir="$(resolve_target_library_dir "$sel_name")"
            target_os="$(detect_app_platform_os "$sel_id")"
        fi

        _prepare_download_target() {
            dl_extra_args=()
            [ "$sel_type" = "DLC" ] || return 0

            local parent_id="" parent_name=""
            if declare -F resolve_steam_app_type >/dev/null 2>&1; then
                local r_info="" r_type=""
                r_info=$(resolve_steam_app_type "$sel_id" 2>/dev/null || true)
                IFS=$'\t' read -r r_type parent_id parent_name <<< "$r_info"
            fi
            [[ "$parent_id" =~ ^[0-9]+$ ]] || parent_id="$sel_parent"
            [[ "$parent_id" =~ ^[0-9]+$ ]] || return 0

            local dlc_choice="" dlc_rc=0
            local base_label="${parent_name:-AppID $parent_id}"
            dlc_choice=$(tui_action_palette \
                "DLC Selected" \
                "AppID $sel_id ($sel_name) is a DLC. Base game downloads already include associated DLC depots." \
                "$(printf 'base\tDownload Base Game (%s • %s) [Recommended]\ndlc\tDownload DLC Only (%s • %s) [--allow-dlc]\ncancel\tCancel / Return\n' "$base_label" "$parent_id" "$sel_name" "$sel_id")" \
                "" \
                "DLC Action > ") || dlc_rc=$?
            [ "$dlc_rc" -eq 130 ] && return 130
            if [ "$dlc_rc" -ne 0 ] && [ "$dlc_rc" -ne 1 ]; then
                return "$dlc_rc"
            fi
            local dlc_opt="${dlc_choice%%$'\t'*}"
            case "$dlc_opt" in
                base)
                    sel_id="$parent_id"
                    sel_name="${parent_name:-AppID_${parent_id}}"
                    dest_dir="$(resolve_target_library_dir "$sel_name")"
                    target_os="$(detect_app_platform_os "$sel_id")"
                    dl_extra_args=()
                    return 0
                    ;;
                dlc)
                    dl_extra_args=("--allow-dlc")
                    return 0
                    ;;
                *)
                    return 130
                    ;;
            esac
        }

        # Direct hotkey triggers
        if [ "$trigger_key" = "ctrl-a" ]; then
            if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-A>: Injecting standalone GBE for $sel_name ($sel_id)"
                tui_exec_action "Inject Standalone GBE ($sel_name)" inject_game "$gdir" "$sel_id"
            else
                local prep_rc=0
                _prepare_download_target || prep_rc=$?
                [ "$prep_rc" -eq 130 ] && continue
                [ "$prep_rc" -ne 0 ] && return "$prep_rc"
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-A>: Starting All-in-One Download for $sel_name ($target_os)"
                tui_exec_action "All-in-One Download ($sel_name)" download_game "$sel_id" "$dest_dir" "$sel_name" --all --os "$target_os" ${dl_extra_args[@]+"${dl_extra_args[@]}"}
            fi
        elif [ "$trigger_key" = "ctrl-u" ]; then
            if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-U>: Synchronizing Steam Entitlement & ACF for $sel_name ($sel_id)"
                tui_exec_action "Synchronize Steam Entitlement ($sel_name)" sync_steam "$sel_id" "$sel_name" "$gdir"
            else
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-U>: Adopting Steam Entitlement & ACF for $sel_name ($sel_id)"
                tui_exec_action "Adopt Steam Entitlement ($sel_name)" unlock_game "$sel_id" "$sel_name"
            fi
        elif [ "$trigger_key" = "ctrl-s" ]; then
            if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-S>: Injecting Standalone GBE Fork for $sel_name ($sel_id)"
                tui_exec_action "Inject Standalone GBE ($sel_name)" inject_game "$gdir" "$sel_id" --no-sync
            else
                local prep_rc=0
                _prepare_download_target || prep_rc=$?
                [ "$prep_rc" -eq 130 ] && continue
                [ "$prep_rc" -ne 0 ] && return "$prep_rc"
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-S>: Starting Standalone Download for $sel_name ($target_os)"
                tui_exec_action "Standalone Download ($sel_name)" download_game "$sel_id" "$dest_dir" "$sel_name" --inject-only --os "$target_os" ${dl_extra_args[@]+"${dl_extra_args[@]}"}
            fi
        elif [ "$trigger_key" = "ctrl-d" ]; then
            if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
                local gbin
                gbin=$(find_game_binary "$gdir" 2>/dev/null || echo "")
                if [ -n "$gbin" ]; then
                    local launch_rc=0
                    tui_run_engine "Launch $sel_name" launch_game "$gdir" "$gbin" "$sel_name" || launch_rc=$?
                    if [ "$launch_rc" -eq 10 ]; then
                        break
                    fi
                else
                    log_msg "ERROR" "LAUNCH" "Binary executable not found in $gdir for $sel_name"
                    tui_modal_notice "Executable Not Found" "Binary executable not found in directory:\n$gdir" || return $?
                fi
            else
                local prep_rc=0
                _prepare_download_target || prep_rc=$?
                [ "$prep_rc" -eq 130 ] && continue
                [ "$prep_rc" -ne 0 ] && return "$prep_rc"
                log_msg "INFO" "HOTKEY" "Shortcut <Ctrl-D>: Starting Live Stream Download for $sel_name ($target_os)"
                tui_exec_action "Live Stream Download ($sel_name)" download_game "$sel_id" "$dest_dir" "$sel_name" --all --os "$target_os" ${dl_extra_args[@]+"${dl_extra_args[@]}"}
            fi
        else
            # Enter key: Open Modal Action Palette
            if [[ "$sel_status" =~ INSTALLED ]] && [[ ! "$sel_status" =~ NOT ]]; then
                local action_palette
                action_palette=$(cat <<EOF
1	Launch Game Directly
2	Inject GBE Fork Only (Standalone ./saves & DLC.txt)
3	Inject GBE + Sync Steam Client (All-in-One Full DLC)
4	Sync to Steam Client Entitlement Only (ACF & Steam Input)
5	Check Community Fixes & Online-Fix Catalog
6	Cancel / Return
EOF
)
                local action_sel action_rc=0
                action_sel=$(echo "$action_palette" | fzf \
                    --delimiter=$'\t' \
                    --with-nth=2 \
                    --border-label="  ╢ Action Palette: $sel_name ╟  " \
                    --border-label-pos=2 \
                    --header="ACTION PALETTE (Enter: Execute │ Esc: Return)" \
                    --prompt="Action > " \
                    --reverse 2>/dev/null) || action_rc=$?
                check_fzf_status "$action_rc" || return $?
                [ "$action_rc" -eq 130 ] && continue

                local act_opt
                act_opt=$(echo "$action_sel" | awk -F'\t' '{print $1}')

                case "$act_opt" in
                    1)
                        local gbin
                        gbin=$(find_game_binary "$gdir" 2>/dev/null || echo "")
                        if [ -n "$gbin" ]; then
                            local launch_rc=0
                            tui_run_engine "Launch $sel_name" launch_game "$gdir" "$gbin" "$sel_name" || launch_rc=$?
                            if [ "$launch_rc" -eq 10 ]; then
                                break
                            fi
                        else
                            log_msg "ERROR" "LAUNCH" "Binary executable not found in $gdir for $sel_name"
                            tui_modal_notice "Executable Not Found" "Binary executable not found in directory:\n$gdir" || return $?
                        fi
                        ;;
                    2)
                        tui_exec_action "Inject Standalone GBE ($sel_name)" inject_game "$gdir" "$sel_id" --no-sync
                        ;;
                    3)
                        tui_exec_action "Inject GBE + Steam Sync ($sel_name)" inject_game "$gdir" "$sel_id" --all
                        ;;
                    4)
                        tui_exec_action "Synchronize Steam Entitlement ($sel_name)" sync_steam "$sel_id" "$sel_name" "$gdir"
                        ;;
                    5)
                        manage_game_fixes_interactive "$sel_id" "$sel_name" "$gdir" || return $?
                        ;;
                    *)
                        ;;
                esac
            else
                local not_installed_palette
                not_installed_palette=$(cat <<EOF
1	[Sovereign Standalone] Download & Auto-Provision via CDN (Zero-Steam GBE)
2	[Steam Client Bridge] Adopt files & DLC to Steam Client (Requires Steam)
3	[Offline GBE] Inject GBE LAN runtime (Steam-free)
4	[Fixes & OnlineFix] Check Community Fixes & Online-Fix Catalog
5	Cancel / Return
EOF
)
                local pkg_sel pkg_rc=0
                pkg_sel=$(echo "$not_installed_palette" | fzf \
                    --delimiter=$'\t' \
                    --with-nth=2 \
                    --border-label="  ╢ Action Palette: $sel_name ╟  " \
                    --border-label-pos=2 \
                    --header="PACKAGE SELECTION (Enter: Execute │ Esc: Return)" \
                    --prompt="Package > " \
                    --reverse 2>/dev/null) || pkg_rc=$?
                check_fzf_status "$pkg_rc" || return $?
                [ "$pkg_rc" -eq 130 ] && continue

                local opt
                opt=$(echo "$pkg_sel" | awk -F'\t' '{print $1}')
                case "$opt" in
                    1)
                        local prep_rc=0
                        _prepare_download_target || prep_rc=$?
                        [ "$prep_rc" -eq 130 ] && continue
                        [ "$prep_rc" -ne 0 ] && return "$prep_rc"
                        tui_exec_action "Sovereign Standalone Download ($sel_name)" download_game "$sel_id" "$dest_dir" "$sel_name" --all --os "$target_os" ${dl_extra_args[@]+"${dl_extra_args[@]}"}
                        ;;
                    2)
                        tui_exec_action "Adopt Steam Entitlement ($sel_name)" unlock_game "$sel_id" "$sel_name"
                        ;;
                    3)
                        tui_exec_action "Inject Standalone GBE ($sel_name)" inject_game "$dest_dir" "$sel_id" --no-sync
                        ;;
                    4)
                        manage_game_fixes_interactive "$sel_id" "$sel_name" "" || return $?
                        ;;
                    *)
                        ;;
                esac
            fi
        fi
        _refresh_search_results
    done

    flush_tty_input
    [ "$standalone" = "true" ] && exit_tui_screen
    return 0
}

# --- [MODULE] src/main.sh ---
# Minimal subshell exports: previews dispatch via "$GAMECTL_PREVIEW_BIN" --preview*; keep only contract-pinned functions.
export -f pull_save_remote remote_sync_interactive manage_game_fixes_interactive preview_fix_entry

# Top-level Menu
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
case "${1:-}" in
    proton-list|proton)
        proton_list
        ;;
    proton-install)
        proton_install "${2:-latest}" "${@:3}"
        ;;
    proton-remove)
        if [ -n "${2:-}" ]; then
            proton_remove "$2" "${@:3}"
        else
            echo "Usage: gamectl proton-remove <tag> [-y|--yes]"
            exit 1
        fi
        ;;
    setup-gbe|gbe-setup|gbe-install|install-gbe)
