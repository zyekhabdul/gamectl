        download) store_dispatch amazon download "$@" ;;
        sync) store_dispatch amazon sync "$@" ;;
        --help|-h|help) echo "Usage: gamectl amazon <status|auth|search|download|sync> [args...]" ;;
        *) echo "[ERROR] Unknown amazon subcommand '$action'. Usage: gamectl amazon <status|auth|search|download|sync> [args...]" >&2; return 1 ;;
    esac
}

# --- [MODULE] src/runners/40_wrappers.sh ---
# Canonical wrapper config & env override loader (SSoT)
load_wrapper_config() {
    local gdir="${1:-}"
    local apply_env="${2:-1}"

    GAMECTL_CFG_GM=0
    GAMECTL_CFG_HUD=0
    GAMECTL_CFG_SCOPE=0
    GAMECTL_CFG_FSR=0
    GAMECTL_CFG_GLTHREAD=0
    GAMECTL_CFG_SYSTEMD_SCOPE=""
    GAMECTL_CFG_PRIME=0
    GAMECTL_CFG_SANDBOX=0
    GAMECTL_CFG_RENDERER="auto"
    GAMECTL_CFG_GAMESCOPE_ARGS=""
    GAMECTL_CFG_AUTO_LOCATE_SAVES=0
    GAMECTL_CFG_DEV_WINEDEBUG="0"
    GAMECTL_CFG_DEV_VK_DEBUG="0"
    GAMECTL_CFG_DEV_GBE_LOG="0"

    local w_cfgs=("$HOME/.config/gamectl/wrappers")
    [ -n "$gdir" ] && w_cfgs+=("$gdir/.wrappers")
    local w_cfg k v
    for w_cfg in "${w_cfgs[@]}"; do
        [ -f "$w_cfg" ] || continue
        while IFS='=' read -r k v || [ -n "$k" ]; do
            k="${k//[[:space:]]/}"
            [[ -z "$k" || "$k" =~ ^# ]] && continue
            v="${v//$'\r'/}"
            v="${v#"${v%%[![:space:]]*}"}"
            v="${v%"${v##*[![:space:]]}"}"
            v="${v#\"}"
            v="${v%\"}"
            v="${v#\'}"
            v="${v%\'}"
            case "$k" in
                gamemode) GAMECTL_CFG_GM="$v" ;;
                hud|mangohud) GAMECTL_CFG_HUD="$v" ;;
                gamescope) GAMECTL_CFG_SCOPE="$v" ;;
                fsr) GAMECTL_CFG_FSR="$v" ;;
                glthread|mesa_glthread) GAMECTL_CFG_GLTHREAD="$v" ;;
                scope|systemd_scope) GAMECTL_CFG_SYSTEMD_SCOPE="$v" ;;
                prime|dgpu) GAMECTL_CFG_PRIME="$v" ;;
                sandbox) GAMECTL_CFG_SANDBOX="$v" ;;
                renderer) GAMECTL_CFG_RENDERER="$v" ;;
                gamescope_args) GAMECTL_CFG_GAMESCOPE_ARGS="$v" ;;
                auto_locate_saves) GAMECTL_CFG_AUTO_LOCATE_SAVES="$v" ;;
                dev_winedebug) GAMECTL_CFG_DEV_WINEDEBUG="$v" ;;
                dev_vk_debug) GAMECTL_CFG_DEV_VK_DEBUG="$v" ;;
                dev_gbe_log) GAMECTL_CFG_DEV_GBE_LOG="$v" ;;
            esac
        done < "$w_cfg"
    done

    if [ "$apply_env" = "1" ]; then
        [ -n "${GAMECTL_GAMEMODE:-}" ] && GAMECTL_CFG_GM="$GAMECTL_GAMEMODE"
        [ -n "${GAMECTL_HUD:-${GAMECTL_MANGOHUD:-}}" ] && GAMECTL_CFG_HUD="${GAMECTL_HUD:-$GAMECTL_MANGOHUD}"
        [ -n "${GAMECTL_GAMESCOPE:-}" ] && GAMECTL_CFG_SCOPE="$GAMECTL_GAMESCOPE"
        [ -n "${GAMECTL_FSR:-}" ] && GAMECTL_CFG_FSR="$GAMECTL_FSR"
        [ -n "${GAMECTL_GLTHREAD:-}" ] && GAMECTL_CFG_GLTHREAD="$GAMECTL_GLTHREAD"
        [ -n "${GAMECTL_SCOPE:-${GAMECTL_SYSTEMD_SCOPE:-}}" ] && GAMECTL_CFG_SYSTEMD_SCOPE="${GAMECTL_SCOPE:-$GAMECTL_SYSTEMD_SCOPE}"
        [ -n "${GAMECTL_PRIME:-}" ] && GAMECTL_CFG_PRIME="$GAMECTL_PRIME"
        [ -n "${GAMECTL_SANDBOX:-}" ] && GAMECTL_CFG_SANDBOX="$GAMECTL_SANDBOX"
        if [ -n "${GAMECTL_RENDERER:-}" ]; then
            GAMECTL_CFG_RENDERER="$GAMECTL_RENDERER"
        elif [ -n "${PROTON_USE_WINED3D:-}" ]; then
            [ "$PROTON_USE_WINED3D" = "1" ] && GAMECTL_CFG_RENDERER="wined3d"
            [ "$PROTON_USE_WINED3D" = "0" ] && GAMECTL_CFG_RENDERER="dxvk"
        fi
        [ -n "${GAMECTL_GAMESCOPE_ARGS:-}" ] && GAMECTL_CFG_GAMESCOPE_ARGS="$GAMECTL_GAMESCOPE_ARGS"
        [ -n "${GAMECTL_AUTO_LOCATE_SAVES:-}" ] && GAMECTL_CFG_AUTO_LOCATE_SAVES="$GAMECTL_AUTO_LOCATE_SAVES"
        [ -n "${GAMECTL_DEV_WINEDEBUG:-}" ] && GAMECTL_CFG_DEV_WINEDEBUG="$GAMECTL_DEV_WINEDEBUG"
        [ -n "${GAMECTL_DEV_VK_DEBUG:-}" ] && GAMECTL_CFG_DEV_VK_DEBUG="$GAMECTL_DEV_VK_DEBUG"
        [ -n "${GAMECTL_DEV_GBE_LOG:-}" ] && GAMECTL_CFG_DEV_GBE_LOG="$GAMECTL_DEV_GBE_LOG"
    fi
}

# Canonical developer profiler environment resolver (SSoT; zero pollution when OFF)
resolve_dev_profiler_env() {
    local gdir="${1:-}"
    local apply_env="${2:-1}"

    load_wrapper_config "$gdir" "$apply_env"

    GAMECTL_DEV_ACTIVE=0
    GAMECTL_DEV_RESOLVED_WINEDEBUG=""
    GAMECTL_DEV_RESOLVED_VK_DEBUG=""
    GAMECTL_DEV_RESOLVED_GBE_LOG=0
    GAMECTL_DEV_TRACE_LOG=""
    GAMECTL_DEV_RESPECTED_USER_WINEDEBUG=0
    GAMECTL_DEV_RESPECTED_USER_VK_DEBUG=0

    local wd_raw="${GAMECTL_CFG_DEV_WINEDEBUG:-0}"
    local wd_lc="${wd_raw,,}"
    local mapped_wd=""
    case "$wd_lc" in
        ""|0|off|false) mapped_wd="" ;;
        basic) mapped_wd="+loaddll,+seh" ;;
        full)  mapped_wd="+relay,+seh,+loaddll" ;;
        *)
            mapped_wd=$(printf '%s' "$wd_raw" | tr -cd 'A-Za-z0-9_+,=-')
            if [ -z "$mapped_wd" ]; then
                echo "[WARN] Ignored invalid dev_winedebug setting." >&2
            fi
            ;;
    esac

    if [ -n "$mapped_wd" ]; then
        GAMECTL_DEV_ACTIVE=1
        if [ -n "${WINEDEBUG:-}" ]; then
            GAMECTL_DEV_RESPECTED_USER_WINEDEBUG=1
        else
            GAMECTL_DEV_RESOLVED_WINEDEBUG="$mapped_wd"
        fi
    fi

    local vk_lc="${GAMECTL_CFG_DEV_VK_DEBUG:-0}"
    vk_lc="${vk_lc,,}"
    if [ "$vk_lc" = "1" ] || [ "$vk_lc" = "true" ]; then
        GAMECTL_DEV_ACTIVE=1
        if [ -n "${VK_LOADER_DEBUG:-}" ]; then
            GAMECTL_DEV_RESPECTED_USER_VK_DEBUG=1
        else
            GAMECTL_DEV_RESOLVED_VK_DEBUG="all"
        fi
    fi

    local gbe_lc="${GAMECTL_CFG_DEV_GBE_LOG:-0}"
    gbe_lc="${gbe_lc,,}"
    if [ "$gbe_lc" = "1" ] || [ "$gbe_lc" = "true" ]; then
        GAMECTL_DEV_ACTIVE=1
        GAMECTL_DEV_RESOLVED_GBE_LOG=1
    fi

    if [ "$GAMECTL_DEV_ACTIVE" -eq 1 ]; then
        local base_slug hash_part
        base_slug=$(basename "${gdir:-global}" | tr -cd '[:alnum:]_-')
        [ -z "$base_slug" ] && base_slug="game"
        hash_part=$(printf '%s' "${gdir:-global}" | cksum | awk '{print $1}')
        GAMECTL_DEV_TRACE_LOG="$(get_runtime_dir)/dev_traces/${base_slug}_${hash_part}.log"
    fi
}

# CLI helper for per-game developer profiler configuration
configure_dev_profile() {
    local gdir="${1:-}"
    local mode="${2:-status}"

    if [ -z "$gdir" ] || [ ! -d "$gdir" ]; then
        echo "[ERROR] Game directory not found: ${gdir:-<empty>}" >&2
        echo "Usage: gamectl dev-profile <game_dir> [status|basic|full|off]" >&2
        return 1
    fi

    local w_file="$gdir/.wrappers"
    case "$mode" in
        status)
            resolve_dev_profiler_env "$gdir" 1
            echo "dev_winedebug=${GAMECTL_CFG_DEV_WINEDEBUG:-0}"
            echo "dev_vk_debug=${GAMECTL_CFG_DEV_VK_DEBUG:-0}"
            echo "dev_gbe_log=${GAMECTL_CFG_DEV_GBE_LOG:-0}"
            echo "active=$GAMECTL_DEV_ACTIVE"
            echo "resolved_winedebug=$GAMECTL_DEV_RESOLVED_WINEDEBUG"
            echo "resolved_vk_debug=$GAMECTL_DEV_RESOLVED_VK_DEBUG"
            echo "trace_log=$GAMECTL_DEV_TRACE_LOG"
            ;;
        basic)
            atomic_set_kv_file "$w_file" "dev_winedebug" "basic" && \
            atomic_set_kv_file "$w_file" "dev_vk_debug" "0" && \
            atomic_set_kv_file "$w_file" "dev_gbe_log" "1" || return 1
            echo "[VERIFIED] Developer profiler set to 'basic' in $w_file"
            ;;
        full)
            atomic_set_kv_file "$w_file" "dev_winedebug" "full" && \
            atomic_set_kv_file "$w_file" "dev_vk_debug" "1" && \
            atomic_set_kv_file "$w_file" "dev_gbe_log" "1" || return 1
            echo "[VERIFIED] Developer profiler set to 'full' in $w_file"
            ;;
        off)
            atomic_set_kv_file "$w_file" "dev_winedebug" "0" && \
            atomic_set_kv_file "$w_file" "dev_vk_debug" "0" && \
            atomic_set_kv_file "$w_file" "dev_gbe_log" "0" || return 1
            echo "[VERIFIED] Developer profiler disabled in $w_file"
            ;;
        *)
            echo "Usage: gamectl dev-profile <game_dir> [status|basic|full|off]" >&2
            return 1
            ;;
    esac
}

# Resolve and build wrapper prefix command array (gamemoderun, mangohud, gamescope)
build_wrapper_command() {
    local gdir="$1"
    shift || true
    local opt_gamemode="" opt_hud="" opt_gamescope="" opt_fsr="" opt_systemd_scope="" opt_prime="" opt_sandbox="" opt_allow_unshielded="" opt_renderer=""
    local remaining_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --hud|--mangohud) opt_hud=1; shift ;;
            --no-hud|--no-mangohud) opt_hud=0; shift ;;
            --gamemode) opt_gamemode=1; shift ;;
            --no-gamemode) opt_gamemode=0; shift ;;
            --gamescope) opt_gamescope=1; shift ;;
            --no-gamescope) opt_gamescope=0; shift ;;
            --fsr) opt_fsr=1; opt_gamescope=1; shift ;;
            --no-fsr) opt_fsr=0; shift ;;
            --glthread) opt_glthread=1; shift ;;
            --no-glthread) opt_glthread=0; shift ;;
            --scope|--systemd-scope) opt_systemd_scope=1; shift ;;
            --no-scope|--no-systemd-scope) opt_systemd_scope=0; shift ;;
            --prime) opt_prime=1; shift ;;
            --no-prime) opt_prime=0; shift ;;
            --sandbox) opt_sandbox=1; shift ;;
            --no-sandbox) opt_sandbox=0; shift ;;
            --wined3d|--opengl) opt_renderer="wined3d"; shift ;;
            --dxvk|--vulkan) opt_renderer="dxvk"; shift ;;
            --renderer) opt_renderer="${2:-auto}"; shift 2 ;;
            --renderer=*) opt_renderer="${1#*=}"; shift ;;
            --allow-unshielded) opt_allow_unshielded=1; shift ;;
            --) shift; remaining_args+=("$@"); break ;;
            *) remaining_args+=("$1"); shift ;;
        esac
    done

    # 1. Load config hierarchy + env overrides via SSoT
    load_wrapper_config "$gdir" 1
    local use_gm="$GAMECTL_CFG_GM"
    local use_hud="$GAMECTL_CFG_HUD"
    local use_scope="$GAMECTL_CFG_SCOPE"
    local use_fsr="$GAMECTL_CFG_FSR"
    local use_glthread="$GAMECTL_CFG_GLTHREAD"
    local use_systemd_scope="$GAMECTL_CFG_SYSTEMD_SCOPE"
    local use_prime="$GAMECTL_CFG_PRIME"
    local use_sandbox="$GAMECTL_CFG_SANDBOX"
    local use_renderer="$GAMECTL_CFG_RENDERER"
    local gscope_args="${GAMECTL_CFG_GAMESCOPE_ARGS:-}"
    [ -z "$gscope_args" ] && gscope_args=$(get_default_gamescope_args)

    # 5. CLI flag overrides
    [ -n "$opt_gamemode" ] && use_gm="$opt_gamemode"
    [ -n "$opt_hud" ] && use_hud="$opt_hud"
    [ -n "$opt_gamescope" ] && use_scope="$opt_gamescope"
    [ -n "$opt_fsr" ] && use_fsr="$opt_fsr"
    [ -n "${opt_glthread:-}" ] && use_glthread="$opt_glthread"
    [ -n "${opt_systemd_scope:-}" ] && use_systemd_scope="$opt_systemd_scope"
    [ -n "$opt_prime" ] && use_prime="$opt_prime"
    [ -n "$opt_sandbox" ] && use_sandbox="$opt_sandbox"
    [ -n "$opt_renderer" ] && use_renderer="$opt_renderer"

    if [ -z "${use_systemd_scope:-}" ]; then
        if check_systemd_scope_support; then
            use_systemd_scope=1
        else
            use_systemd_scope=0
        fi
    fi

    local dgpu_vendor="none"
    if [ "$use_prime" = "1" ]; then
        dgpu_vendor=$(detect_dgpu_vendor)
        if [ "$dgpu_vendor" = "none" ]; then
            echo "[WARN] PRIME offloading requested (--prime) but no secondary dGPU detected." >&2
        fi
    fi

    declare -ga GAMECTL_SANDBOX_PREFIX=()
    if [ "$use_sandbox" = "1" ]; then
        build_sandbox_command "$gdir" || use_sandbox=0
    fi

    local resolved_renderer
    resolved_renderer="$(resolve_graphics_renderer "$use_renderer" "$use_prime")"
    GAMECTL_RENDERER_MODE="$use_renderer"
    GAMECTL_ACTIVE_RENDERER="$resolved_renderer"
    GAMECTL_ACTIVE_GLTHREAD="$use_glthread"
    GAMECTL_ACTIVE_SYSTEMD_SCOPE="$use_systemd_scope"
    GAMECTL_ACTIVE_PRIME="$use_prime"
    GAMECTL_ACTIVE_PRIME_VENDOR="$dgpu_vendor"
    GAMECTL_ACTIVE_SANDBOX="$use_sandbox"
    GAMECTL_ACTIVE_ALLOW_UNSHIELDED="${opt_allow_unshielded:-0}"
    GAMECTL_ACTIVE_AUTO_LOCATE_SAVES="${GAMECTL_CFG_AUTO_LOCATE_SAVES:-0}"

    local prefix=()
    if [ "$use_gm" = "1" ]; then
        if command -v gamemoderun >/dev/null 2>&1; then
            prefix+=("gamemoderun")
        else
            echo "[WARN] gamemoderun is enabled but binary not found in PATH." >&2
        fi
    fi

    if [ "$use_hud" = "1" ]; then
        if command -v mangohud >/dev/null 2>&1; then
            prefix+=("mangohud")
        else
            echo "[WARN] mangohud is enabled but binary not found in PATH." >&2
        fi
    fi

    if [ "$use_scope" = "1" ] || [ "$use_fsr" = "1" ]; then
        if command -v gamescope >/dev/null 2>&1; then
            prefix+=("gamescope")
            local active_args="$gscope_args"
            if [ "$use_fsr" = "1" ] && [[ ! "$active_args" =~ (-F|fsr|-U) ]]; then
                active_args="-F fsr $active_args"
            elif [ "$use_fsr" = "0" ]; then
                active_args=$(echo "$active_args" | sed -E 's/-F[[:space:]]+fsr//g' | xargs)
            fi
            if [ -n "$active_args" ]; then
                read -r -a parsed_args <<< "$active_args"
                prefix+=("${parsed_args[@]}")
            fi
            prefix+=("--")
        else
            echo "[WARN] gamescope is enabled but binary not found in PATH." >&2
        fi
    fi

    GAMECTL_WRAPPER_PREFIX=("${prefix[@]}")
    GAMECTL_REMAINING_ARGS=("${remaining_args[@]}")
}

# Interactive wrapper configuration for a game or global defaults
configure_wrappers() {
    require_tui "Runtime wrappers" || return $?
    local gdir="${1:-}"
    local title="${2:-}"
    local w_file

    if [ -n "$gdir" ] && [ -d "$gdir" ]; then
        [ -z "$title" ] && title="$(basename "$gdir")"
        w_file="$gdir/.wrappers"
    else
        title="Global Default Wrappers"
        mkdir -p "$HOME/.config/gamectl"
        w_file="$HOME/.config/gamectl/wrappers"
    fi

    load_wrapper_config "${gdir:-}" 0
    local gm="$GAMECTL_CFG_GM" hud="$GAMECTL_CFG_HUD" scope="$GAMECTL_CFG_SCOPE"
    local fsr="$GAMECTL_CFG_FSR" glt="$GAMECTL_CFG_GLTHREAD" renderer="${GAMECTL_CFG_RENDERER:-auto}"
    local auto_saves="${GAMECTL_CFG_AUTO_LOCATE_SAVES:-0}"
    local dev_wd="${GAMECTL_CFG_DEV_WINEDEBUG:-0}" dev_vk="${GAMECTL_CFG_DEV_VK_DEBUG:-0}" dev_gbe="${GAMECTL_CFG_DEV_GBE_LOG:-0}"
    local gscope_args="${GAMECTL_CFG_GAMESCOPE_ARGS:-}"
    [ -z "$gscope_args" ] && gscope_args=$(get_default_gamescope_args)

    while true; do
        local b_gm="${UI_DIM}[OFF]${UI_RST}" b_hud="${UI_DIM}[OFF]${UI_RST}"
        local b_scope="${UI_DIM}[OFF]${UI_RST}" b_fsr="${UI_DIM}[OFF]${UI_RST}" b_glt="${UI_DIM}[OFF]${UI_RST}"
        local b_autosaves="${UI_DIM}[OFF]${UI_RST}" b_devwd="${UI_DIM}[OFF]${UI_RST}"
        local b_devvk="${UI_DIM}[OFF]${UI_RST}" b_devgbe="${UI_DIM}[OFF]${UI_RST}"
        [ "$gm" = 1 ] && b_gm="${UI_GREEN}[ACTIVE]${UI_RST}"
        [ "$hud" = 1 ] && b_hud="${UI_GREEN}[ACTIVE]${UI_RST}"
        [ "$scope" = 1 ] && b_scope="${UI_GREEN}[ACTIVE]${UI_RST}"
        [ "$fsr" = 1 ] && b_fsr="${UI_GREEN}[ACTIVE]${UI_RST}"
        [ "$glt" = 1 ] && b_glt="${UI_GREEN}[ACTIVE]${UI_RST}"
        [ "$auto_saves" = 1 ] && b_autosaves="${UI_GREEN}[ACTIVE]${UI_RST}"
        case "${dev_wd,,}" in
            ""|0|off|false) ;;
            basic) b_devwd="${UI_AMBER}[BASIC]${UI_RST}" ;;
            full)  b_devwd="${UI_RED}[FULL]${UI_RST}" ;;
            *)     b_devwd="${UI_CYAN}[$dev_wd]${UI_RST}" ;;
        esac
        [ "$dev_vk" = 1 ] && b_devvk="${UI_AMBER}[ACTIVE]${UI_RST}"
        [ "$dev_gbe" = 1 ] && b_devgbe="${UI_AMBER}[ACTIVE]${UI_RST}"

        local eff_rend b_rend
        eff_rend="$(resolve_graphics_renderer "$renderer" 0)"
        case "$renderer" in
            wined3d) b_rend="${UI_AMBER}[WINED3D]${UI_RST}" ;;
            dxvk)    b_rend="${UI_CYAN}[DXVK]${UI_RST}" ;;
            *)       b_rend="${UI_GREEN}[AUTO -> ${eff_rend^^}]${UI_RST}" ;;
        esac

        local h_gm="${UI_DIM}[N/A]${UI_RST}" h_hud="${UI_DIM}[N/A]${UI_RST}" h_scope="${UI_DIM}[N/A]${UI_RST}"
        command -v gamemoderun >/dev/null 2>&1 && h_gm="${UI_GREEN}[READY]${UI_RST}"
        command -v mangohud >/dev/null 2>&1 && h_hud="${UI_GREEN}[READY]${UI_RST}"
        command -v gamescope >/dev/null 2>&1 && h_scope="${UI_GREEN}[READY]${UI_RST}"

        local glt_hint="${UI_DIM}(Opt-in Performance)${UI_RST}"
        is_haswell_gpu && glt_hint="${UI_AMBER}(Intel Haswell: Keep OFF)${UI_RST}"

        local entries
        entries=$(cat <<EOF
1	GameMode (gamemoderun)	$b_gm
2	MangoHud (FPS & Telemetry)	$b_hud
3	Gamescope (Isolated Window)	$b_scope
4	Gamescope FSR Upscaling	$b_fsr
5	Mesa GL Threading (mesa_gl)	$b_glt $glt_hint
r	Graphics Renderer (DXVK/WineD3D)	$b_rend
s	Auto-Locate Wine Prefix Saves	$b_autosaves
d	Dev Profiler: WINEDEBUG	$b_devwd
v	Dev Profiler: Vulkan Debug	$b_devvk
g	Dev Profiler: GBE Callback Log	$b_devgbe
6	Preset: Balanced Performance	GameMode + MangoHud
7	Preset: Handheld / FSR	GameMode + MangoHud + Gamescope FSR
8	Reset: Safe Defaults	All Disabled (Renderer: Auto)
9	Save & Return	Save configuration
0	Cancel / Discard Changes	Discard changes and return
EOF
)

        flush_tty_input
        local selection fzf_rc=0
        selection=$(echo "$entries" | fzf \
            --delimiter=$'\t' \
            --with-nth=2,3 \
            --border-label="  ╢ gamectl :: Wrappers : $title ╟  " \
            --border-label-pos=2 \
            --header="Enter: Toggle/Select │ Esc: Save & Return" \
            --prompt="Wrappers > " \
            --reverse 2>/dev/null) || fzf_rc=$?

        check_fzf_status "$fzf_rc" || return $?
        local opt
        if [ "$fzf_rc" -eq 130 ]; then
            opt="9"
        elif [ -z "$selection" ]; then
            continue
        else
            opt=$(echo "$selection" | cut -f1 | tr -d '[:space:]')
        fi

        case "$opt" in
            1) gm=$((1 - gm)) ;;
            2) hud=$((1 - hud)) ;;
            3) scope=$((1 - scope)) ;;
            4) fsr=$((1 - fsr)); [ "$fsr" = 1 ] && scope=1 ;;
            5) glt=$((1 - glt)) ;;
            r|R)
                case "$renderer" in
                    auto|"") renderer="wined3d" ;;
                    wined3d) renderer="dxvk" ;;
                    *)       renderer="auto" ;;
                esac
                ;;
            s|S) auto_saves=$((1 - auto_saves)) ;;
            d|D)
                case "${dev_wd,,}" in
                    ""|0|off|false) dev_wd="basic" ;;
                    basic) dev_wd="full" ;;
                    *)     dev_wd="0" ;;
                esac
                ;;
            v|V) dev_vk=$((1 - dev_vk)) ;;
            g|G) dev_gbe=$((1 - dev_gbe)) ;;
            6) gm=1; hud=1; scope=0; fsr=0; glt=0 ;;
            7) gm=1; hud=1; scope=1; fsr=1; glt=0 ;;
            8) gm=0; hud=0; scope=0; fsr=0; glt=0; renderer="auto"; auto_saves=0; dev_wd="0"; dev_vk=0; dev_gbe=0 ;;
            9)
                cat <<EOF > "$w_file"
# Runtime wrappers for $title
gamemode=$gm
hud=$hud
gamescope=$scope
fsr=$fsr
glthread=$glt
renderer=$renderer
gamescope_args=$gscope_args
auto_locate_saves=$auto_saves
dev_winedebug=$dev_wd
dev_vk_debug=$dev_vk
dev_gbe_log=$dev_gbe
EOF
                log_msg "INFO" "WRAPPERS" "Saved wrapper configuration for $title -> $w_file (gm=$gm,hud=$hud,scope=$scope,fsr=$fsr,glt=$glt,renderer=$renderer,auto_saves=$auto_saves,dev_wd=$dev_wd,dev_vk=$dev_vk,dev_gbe=$dev_gbe)"
                break
                ;;
            0|q|Q|cancel)
                return 0
                ;;
            *)
                continue
                ;;
        esac
    done
}

# Global Configuration Manager TUI
configure_global() {
    require_tui "Global settings" || return $?
    mkdir -p "$HOME/.config/gamectl"

    while true; do
        local p_name="Player" p_id=""
        if [ -f "$HOME/.config/gamectl/persona" ]; then
            p_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
            p_id=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        fi
        [ -z "$p_name" ] && p_name="${USER:-Player}"

        local w_desc="Default (All Disabled)"
        if [ -f "$HOME/.config/gamectl/wrappers" ]; then
            local act_w=()
            grep -q "^gamemode=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && act_w+=("GameMode")
            grep -q -E "^(hud|mangohud)=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && act_w+=("MangoHud")
            grep -q "^gamescope=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && act_w+=("Gamescope")
            grep -q "^fsr=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && act_w+=("FSR")
            grep -q -E "^(glthread|mesa_glthread)=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && act_w+=("MesaGL")
            [ ${#act_w[@]} -gt 0 ] && w_desc="${act_w[*]}"
        fi

        local lib_count=0
        [ -f "$HOME/.config/gamectl/libraries" ] && lib_count=$(grep -v -E '^[[:space:]]*(#|$)' "$HOME/.config/gamectl/libraries" 2>/dev/null | wc -l || echo 0)

        local r_host="Not Configured"
        if [ -f "$HOME/.config/gamectl/remote_host" ]; then
            r_host=$(head -n 1 "$HOME/.config/gamectl/remote_host" 2>/dev/null | tr -d '[:space:]')
            [ -z "$r_host" ] && r_host="Not Configured"
        fi

        local lt_status="Not Configured"
        local cfg_auth="$HOME/.config/gamectl/lua_tools_auth.json"
        if [ -f "$cfg_auth" ]; then
            local u_name
            u_name=$(jq -r '.user.user_metadata.custom_claims.global_name // .user.user_metadata.full_name // .user.email // "Active"' "$cfg_auth" 2>/dev/null || echo "Active")
            lt_status="Active ($u_name)"
        fi

        local hc_status="Not Configured"
        local hc_key
        hc_key=$(get_hubcap_api_key 2>/dev/null || true)
        if [ -n "$hc_key" ]; then
            if [ ${#hc_key} -gt 8 ]; then
                hc_status="Active (${hc_key:0:4}...${hc_key: -4})"
            else
                hc_status="Active"
            fi
        fi

        validate_tui_fields "$p_name" "$p_id" "$r_host" "$lt_status" "$hc_status" || return 1
        local menu_entries
        menu_entries=$(cat <<EOF
1	Global LAN Persona	Name: $p_name | SteamID: ${p_id:-Auto}
2	Default Runtime Wrappers	$w_desc
3	Custom Game Libraries	$lib_count paths registered
4	Remote Companion Host	$r_host
5	LuaTools Provider Session	$lt_status
6	Hubcap Manifest API Key	$hc_status
7	Return to Master Dashboard Hub	Return
EOF
)

        flush_tty_input
        local selection fzf_rc=0
        selection=$(echo "$menu_entries" | fzf \
            --delimiter=$'\t' \
            --with-nth=2,3 \
            --border-label="  ╢ gamectl :: Global Settings (~/.config/gamectl/) ╟  " \
            --border-label-pos=2 \
            --header="GLOBAL SETTINGS (Enter: Configure │ Esc: Return to Dashboard)" \
            --prompt="Settings > " \
            --reverse 2>/dev/null) || fzf_rc=$?

        check_fzf_status "$fzf_rc" || return $?
        [ "$fzf_rc" -eq 130 ] && break
        [ -z "$selection" ] && continue

        local cfg_opt
        cfg_opt=$(echo "$selection" | cut -f1 | tr -d '[:space:]')

        case "$cfg_opt" in
            1)
                local new_name rc=0
                new_name=$(tui_prompt_input "Configure LAN Persona Name" "Enter Player Name (Current: $p_name │ Enter: Confirm │ Esc: Cancel)" "$p_name" "Player Name > ") || rc=$?
                [ "$rc" -eq 130 ] && continue
                [ "$rc" -ne 0 ] && return "$rc"
                validate_tui_fields "$new_name" || return 1
                [ -n "$new_name" ] && p_name="$new_name"

                local new_id
                rc=0
                new_id=$(tui_prompt_input "Configure SteamID64" "Enter 17-digit SteamID64, 'gen' for random ID, or blank for Auto (Current: ${p_id:-Auto})" "" "SteamID64 > ") || rc=$?
                [ "$rc" -eq 130 ] && continue
                [ "$rc" -ne 0 ] && return "$rc"
                new_id=$(echo "$new_id" | tr -d '[:space:]')
                if [ "$new_id" = "gen" ]; then
                    p_id=$(generate_steamid64)
                elif [ -n "$new_id" ]; then
                    p_id="$new_id"
                fi

                cat <<EOF > "$HOME/.config/gamectl/persona"
[user::general]
account_name=$p_name
account_steamid=$p_id
language=english
EOF
                log_msg "INFO" "CONFIG" "Saved global LAN persona: $p_name | $p_id"
                ;;
            2)
                configure_wrappers "" || return $?
                ;;
            3)
                while true; do
                    local lib_items=""
                    local l_idx=1
                    if [ -f "$HOME/.config/gamectl/libraries" ]; then
                        while IFS= read -r l_path; do
                            [ -z "$l_path" ] && continue
                            [[ "$l_path" =~ ^[[:space:]]*# ]] && continue
                            validate_tui_fields "$l_path" || return 1
                            lib_items+="${l_idx}"$'\t'"[REMOVE] $l_path"$'\t'"Select to remove this library path"$'\n'
                            l_idx=$((l_idx + 1))
                        done < "$HOME/.config/gamectl/libraries"
                    fi
                    local lib_menu
                    lib_menu=$(cat <<EOF
add	[+] Register New Library Path	Enter filesystem path (e.g. ~/Games)
EOF
)
                    [ -n "$lib_items" ] && lib_menu="${lib_menu}"$'\n'"${lib_items%$'\n'}"
                    lib_menu="${lib_menu}"$'\n'"back	[<] Return to Global Settings	Back"

                    flush_tty_input
                    local lib_sel l_rc=0
                    lib_sel=$(echo "$lib_menu" | fzf \
                        --delimiter=$'\t' \
                        --with-nth=2,3 \
                        --border-label="  ╢ gamectl :: Custom Game Libraries ╟  " \
                        --border-label-pos=2 \
                        --header="CUSTOM LIBRARIES (Enter: Select │ Esc: Return)" \
                        --prompt="Libraries > " \
                        --reverse 2>/dev/null) || l_rc=$?

                    check_fzf_status "$l_rc" || return $?
                    [ "$l_rc" -eq 130 ] && break
                    [ -z "$lib_sel" ] && continue

                    local l_action
                    l_action=$(echo "$lib_sel" | cut -f1 | tr -d '[:space:]')

                    if [ "$l_action" = "add" ]; then
                        local new_path rc=0
                        new_path=$(tui_prompt_input "Add Game Library Directory" "Enter directory path (e.g. ~/Games │ Enter: Add │ Esc: Cancel)" "" "Path > ") || rc=$?
                        [ "$rc" -eq 130 ] && continue
                        [ "$rc" -ne 0 ] && return "$rc"
                        validate_tui_fields "$new_path" || return 1
                        if [ -n "$new_path" ]; then
                            new_path="${new_path/#\~/$HOME}"
                            echo "$new_path" >> "$HOME/.config/gamectl/libraries"
                            log_msg "INFO" "CONFIG" "Added custom library: $new_path"
                            invalidate_scan_cache
                        fi
                    elif [ "$l_action" = "back" ]; then
                        break
                    else
                        local target_line
                        target_line=$(grep -v -E '^[[:space:]]*(#|$)' "$HOME/.config/gamectl/libraries" 2>/dev/null | sed -n "${l_action}p")
                        if [ -n "$target_line" ]; then
                            grep -v -F "$target_line" "$HOME/.config/gamectl/libraries" > "$HOME/.config/gamectl/libraries.tmp" 2>/dev/null && mv "$HOME/.config/gamectl/libraries.tmp" "$HOME/.config/gamectl/libraries"
                            log_msg "INFO" "CONFIG" "Removed custom library: $target_line"
                            invalidate_scan_cache
                        fi
                    fi
                done
                ;;
            4)
                local new_rhost rc=0
                new_rhost=$(tui_prompt_input "Remote Companion Host" "Enter SSH host (serv, host:~/path), rclone (gdrive:path), or '-' to clear (Current: $r_host │ Enter: Save │ Esc: Cancel)" "$r_host" "Remote Target > ") || rc=$?
                [ "$rc" -eq 130 ] && continue
                [ "$rc" -ne 0 ] && return "$rc"
                new_rhost=$(printf '%s' "$new_rhost" | tr -d '[:space:]')
                if [ "$new_rhost" = "-" ]; then
                    rm -f "$HOME/.config/gamectl/remote_host"
                    log_msg "INFO" "CONFIG" "Cleared remote companion host"
                elif [[ "$new_rhost" == -* ]]; then
                    tui_modal_notice "Invalid Remote Host" "Remote host cannot start with '-':\n$new_rhost" || return $?
                    continue
                elif [ -n "$new_rhost" ]; then
                    local parse_err=""
                    if ! parse_err=$(parse_remote_sync_target "$new_rhost" 2>&1); then
                        tui_modal_notice "Invalid Remote Target" "$parse_err" || return $?
                        continue
                    fi
                    mkdir -p "$HOME/.config/gamectl" || return 1
                    printf '%s\n' "$new_rhost" > "$HOME/.config/gamectl/remote_host"
                    log_msg "INFO" "CONFIG" "Saved remote companion host: $new_rhost"
                fi
                ;;
            5)
                login_luatools_interactive || return $?
                ;;
            6)
                local new_hckey rc=0
                new_hckey=$(tui_prompt_input "Hubcap Manifest API Key" "Enter Hubcap API key (prefix 'smm_') or '-' to clear (Current: $hc_status │ Enter: Save │ Esc: Cancel)" "" "Hubcap Key > ") || rc=$?
                [ "$rc" -eq 130 ] && continue
                [ "$rc" -ne 0 ] && return "$rc"
                new_hckey=$(echo "$new_hckey" | tr -d '[:space:]')
                if [ "$new_hckey" = "-" ]; then
                    set_config_value "hubcap_api_key" ""
                    log_msg "INFO" "CONFIG" "Cleared Hubcap Manifest API key"
                elif [ -n "$new_hckey" ]; then
                    set_config_value "hubcap_api_key" "$new_hckey"
                    log_msg "INFO" "CONFIG" "Saved Hubcap Manifest API key (${new_hckey:0:4}...)"
                fi
                ;;
            7)
                break
                ;;
            0|q|Q|cancel)
                break
                ;;
            *)
                continue
                ;;
        esac
    done
}


# Standalone-source compatibility: load split runner submodules when sourced directly outside bin/gamectl
if [ -z "${GAMECTL_BUNDLED:-}" ] && [ -n "${BASH_SOURCE[0]:-}" ]; then
    _runners_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    for _runners_sub in 41_proton_prefix.sh 42_graphics_isolation.sh; do
        if [ -f "$_runners_dir/$_runners_sub" ]; then
            # shellcheck source=/dev/null
            source "$_runners_dir/$_runners_sub"
        fi
    done
    unset _runners_dir _runners_sub
fi

# --- [MODULE] src/runners/41_proton_prefix.sh ---
# Detect P2P multiplayer compatibility hooks, mod loaders, and custom DLL overrides for a game directory
detect_dll_overrides() {
    local gdir="${1:-}"
    [ -n "$gdir" ] && [ -d "$gdir" ] || return 0

    local has_onlinefix=0
    local has_bepinex=0
    local has_ue4ss=0
    local has_reframework=0
    local has_reshade=0
    local custom_overrides=""

    # 1. Check custom declarative .dll_overrides file
    if [ -f "$gdir/.dll_overrides" ]; then
        custom_overrides=$(grep -v -E '^[[:space:]]*(#|$)' "$gdir/.dll_overrides" 2>/dev/null | tr '\n' ';' || true)
    fi

    # 2. Scan root and subdirectories (up to depth 3) excluding runtime/save folders
    local found_signatures
    found_signatures=$(find "$gdir" -maxdepth 3 \( \
        -name "pfx" -o -name ".git" -o -name ".save_snapshots" -o -name "saves" \
    \) -prune -o \( \
        -iname "OnlineFix64.dll" -o -iname "OnlineFix.dll" -o -iname "dnet.dll" -o \
        -iname "SteamOverlay64.dll" -o -iname "winmm.dll" -o -iname "version.dll" -o \
        -iname "BepInEx" -o -iname "doorstop_config.ini" -o -iname "winhttp.dll" -o \
        -iname "ue4ss" -o -iname "UE4SS.dll" -o -iname "dwmapi.dll" -o \
        -iname "dinput8.dll" -o \
        -iname "ReShade.ini" -o -iname "dxgi.dll" \
    \) -print 2>/dev/null || true)

    if [ -n "$found_signatures" ]; then
        while IFS= read -r item; do
            [ -z "$item" ] && continue
            local base
            base=$(basename "$item")
            case "${base,,}" in
                onlinefix64.dll|onlinefix.dll|dnet.dll|steamoverlay64.dll|winmm.dll|version.dll)
                    has_onlinefix=1 ;;
                bepinex|doorstop_config.ini|winhttp.dll)
                    has_bepinex=1 ;;
                ue4ss|ue4ss.dll|dwmapi.dll)
                    has_ue4ss=1 ;;
                dinput8.dll)
                    has_reframework=1 ;;
                reshade.ini|dxgi.dll)
                    has_reshade=1 ;;
            esac
        done <<< "$found_signatures"
    fi

    # Return empty string if no mod/OnlineFix signatures or custom overrides found
    if [ "$has_onlinefix" -eq 0 ] && [ "$has_bepinex" -eq 0 ] && \
       [ "$has_ue4ss" -eq 0 ] && [ "$has_reframework" -eq 0 ] && \
       [ "$has_reshade" -eq 0 ] && [ -z "$custom_overrides" ]; then
        return 0
    fi

    local detected_tokens=""
    if [ "$has_onlinefix" -eq 1 ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}onlinefix=n;onlinefix64=n;steamoverlay64=n;dnet=n;winmm=n,b;version=n,b;steam_api64=n;steam_api=n"
    fi
    if [ "$has_bepinex" -eq 1 ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}winhttp=n,b"
    fi
    if [ "$has_ue4ss" -eq 1 ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}dwmapi=n,b"
    fi
    if [ "$has_reframework" -eq 1 ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}dinput8=n,b"
    fi
    if [ "$has_reshade" -eq 1 ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}dxgi=n,b"
    fi
    if [ -n "$custom_overrides" ]; then
        detected_tokens="${detected_tokens:+${detected_tokens};}${custom_overrides}"
    fi

    local user_env_overrides="${2:-${WINEDLLOVERRIDES:-}}"
    declare -A seen=()
    declare -A values=()
    local ordered_keys=()

    # 1. Process user environment overrides first to preserve user precedence
    if [ -n "$user_env_overrides" ]; then
        local u_arr=()
        IFS=';' read -r -a u_arr <<< "$user_env_overrides"
        for item in "${u_arr[@]}"; do
            [ -z "$item" ] && continue
            local k="${item%%=*}"
            local v="${item#*=}"
            [ "$item" = "$k" ] && v="n"
            k=$(echo "$k" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
            v=$(echo "$v" | tr -d '[:space:]')
            [ -z "$k" ] && continue
            if [ -z "${seen["$k"]:-}" ]; then
                seen["$k"]=1
                ordered_keys+=("$k")
                values["$k"]="$v"
            fi
        done
    fi

    # 2. Process detected mod tokens (add only if not overridden by user)
    local d_arr=()
    IFS=';' read -r -a d_arr <<< "$detected_tokens"
    for item in "${d_arr[@]}"; do
        [ -z "$item" ] && continue
        local k="${item%%=*}"
        local v="${item#*=}"
        [ "$item" = "$k" ] && v="n"
        k=$(echo "$k" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
        v=$(echo "$v" | tr -d '[:space:]')
        [ -z "$k" ] && continue
        if [ -z "${seen["$k"]:-}" ]; then
            seen["$k"]=1
            ordered_keys+=("$k")
            values["$k"]="$v"
        fi
    done

    # 3. Format normalized semicolon-separated output
    local result=""
    for k in "${ordered_keys[@]}"; do
        local entry="${k}=${values["$k"]}"
        result="${result:+${result};}${entry}"
    done
    echo "$result"
}

# Canonical ordered list of standalone XDG and Steam runner parent directories
list_runner_dirs() {
    local s_dyn_root
    s_dyn_root="$(get_steam_root 2>/dev/null || true)"
    local xdg_runners="${XDG_DATA_HOME:-$HOME/.local/share}/gamectl/runners"
    local -a raw_dirs=()
    [ -n "${GAMECTL_RUNNER_DIR:-}" ] && raw_dirs+=("$GAMECTL_RUNNER_DIR")
    raw_dirs+=("$xdg_runners")
    [ -n "$s_dyn_root" ] && raw_dirs+=("$s_dyn_root/compatibilitytools.d")
    raw_dirs+=(
        "$HOME/.local/share/Steam/compatibilitytools.d"
        "$HOME/.steam/root/compatibilitytools.d"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d"
    )
    local d
    declare -A seen=()
    for d in "${raw_dirs[@]}"; do
        [ -n "$d" ] || continue
        if [ -z "${seen["$d"]:-}" ]; then
            seen["$d"]=1
            printf '%s\n' "$d"
        fi
    done
}

# Discover runner for Windows games (priority: umu-run -> GE-Proton / Proton Steam -> wine)
find_runner() {
    local target_dir="${1:-}"

    # Priority 0: Per-game runner override or environment override
    if [ -n "$target_dir" ] && [ -f "$target_dir/.runner" ]; then
        local g_runner
        g_runner=$(head -n 1 "$target_dir/.runner" | tr -d '[:space:]')
        if [ -n "$g_runner" ] && { [ -x "$g_runner" ] || command -v "$g_runner" >/dev/null 2>&1; }; then
            echo "$g_runner"
            return 0
        fi
    fi
    if [ -n "${GAMECTL_RUNNER:-}" ]; then
        if [ -x "$GAMECTL_RUNNER" ] || command -v "$GAMECTL_RUNNER" >/dev/null 2>&1; then
            echo "$GAMECTL_RUNNER"
            return 0
        fi
    fi
    if [ -f "$HOME/.config/gamectl/runner" ]; then
        local user_runner
        user_runner=$(head -n 1 "$HOME/.config/gamectl/runner" | tr -d '[:space:]')
        if [ -n "$user_runner" ] && { [ -x "$user_runner" ] || command -v "$user_runner" >/dev/null 2>&1; }; then
            echo "$user_runner"
            return 0
        fi
    fi

    # Priority 1: umu-run
    if command -v umu-run >/dev/null 2>&1; then
        echo "umu-run"
        return 0
    fi

    # Priority 2: Standalone XDG runners & Steam compatibilitytools.d
    local -a compat_dirs=()
    local cdir
    while IFS= read -r cdir; do
        [ -n "$cdir" ] && compat_dirs+=("$cdir")
    done < <(list_runner_dirs)
    for cdir in "${compat_dirs[@]}"; do
        [ -d "$cdir" ] || continue
        local p
        while read -r p; do
            [ -z "$p" ] && continue
            if [ -x "$p/proton" ]; then
                echo "$p/proton"
                return 0
            fi
        done < <(find "$cdir" -mindepth 1 -maxdepth 1 -type d -iname "*proton*" 2>/dev/null | sort -Vr)
    done

    # Check Proton in Steam common libraries
    local steam_lib
    while read -r steam_lib; do
        [ -d "$steam_lib/common" ] || continue
        local p
        while read -r p; do
            [ -z "$p" ] && continue
            if [ -x "$p/proton" ]; then
                echo "$p/proton"
                return 0
            fi
        done < <(find "$steam_lib/common" -mindepth 1 -maxdepth 1 -type d -name "Proton*" 2>/dev/null | sort -Vr)
    done < <(get_steam_libraries 2>/dev/null || true)

    # Priority 3: System Wine
    if command -v wine64 >/dev/null 2>&1; then
        echo "wine64"
        return 0
    elif command -v wine >/dev/null 2>&1; then
        echo "wine"
        return 0
    fi

    # Priority 4: Internal wine binary inside GE-Proton files/bin
    for cdir in "${compat_dirs[@]}"; do
        [ -d "$cdir" ] || continue
        local w
        w=$(find "$cdir" -type f \( -name "wine64" -o -name "wine" \) 2>/dev/null | head -n 1)
        if [ -n "$w" ] && [ -x "$w" ]; then
            echo "$w"
            return 0
        fi
    done

    return 1
}

# Resolve wineserver binary matching active runner or system/Proton installation
get_wineserver_bin() {
    local runner="${1:-}"

    # 1. If runner points directly to a Proton executable or runner string contains proton
    if [ -n "$runner" ]; then
        if [[ "$runner" =~ proton ]] || [ -f "$runner" ]; then
            local p_base
            p_base="$(dirname "$runner")"
            for sub in "files/bin/wineserver" "dist/bin/wineserver" "bin/wineserver"; do
                if [ -x "$p_base/$sub" ]; then
                    echo "$p_base/$sub"
                    return 0
                fi
            done
        fi
    fi

    # 2. Check system PATH for wineserver
    if command -v wineserver >/dev/null 2>&1; then
        command -v wineserver
        return 0
    fi

    # 3. Fallback: Search standalone XDG & Steam compatibility tools for highest GE-Proton wineserver
    local -a compat_dirs=()
    local cdir
    while IFS= read -r cdir; do
        [ -n "$cdir" ] && compat_dirs+=("$cdir")
    done < <(list_runner_dirs)
    for cdir in "${compat_dirs[@]}"; do
        [ -n "$cdir" ] && [ -d "$cdir" ] || continue
        local p
        while read -r p; do
            [ -z "$p" ] && continue
            for sub in "files/bin/wineserver" "dist/bin/wineserver" "bin/wineserver"; do
                if [ -x "$p/$sub" ]; then
                    echo "$p/$sub"
                    return 0
                fi
            done
        done < <(find "$cdir" -mindepth 1 -maxdepth 1 -type d -iname "*proton*" 2>/dev/null | sort -Vr)
    done

    # 4. Check system wine64 / wine adjacent wineserver
    for w in "$(command -v wine64 2>/dev/null || true)" "$(command -v wine 2>/dev/null || true)"; do
        [ -n "$w" ] || continue
        local w_dir
        w_dir="$(dirname "$w")"
        if [ -x "$w_dir/wineserver" ]; then
            echo "$w_dir/wineserver"
            return 0
        fi
    done

    return 1
}

# Resolve active runner compatibility tools directory (standalone XDG fallback when Steam is absent)
get_compat_dir() {
    if [ -n "${GAMECTL_RUNNER_DIR:-}" ]; then
        echo "$GAMECTL_RUNNER_DIR"
        return 0
    fi
    local s_dyn_root
    s_dyn_root="$(get_steam_root 2>/dev/null || true)"
    if [ -n "$s_dyn_root" ] && [ -d "$s_dyn_root" ]; then
        echo "$s_dyn_root/compatibilitytools.d"
    elif [ -d "$HOME/.steam/root" ]; then
        echo "$HOME/.steam/root/compatibilitytools.d"
    else
        echo "${XDG_DATA_HOME:-$HOME/.local/share}/gamectl/runners"
    fi
}

# List local and latest upstream GE-Proton releases
proton_list() {
    local -a compat_dirs=()
    local cdir
    while IFS= read -r cdir; do
        [ -n "$cdir" ] && compat_dirs+=("$cdir")
    done < <(list_runner_dirs)

    declare -A local_installs=()
    for cdir in "${compat_dirs[@]}"; do
        [ -n "$cdir" ] && [ -d "$cdir" ] || continue
        for d in "$cdir"/*; do
            [ -d "$d" ] || continue
            local t_name
            t_name=$(basename "$d")
            [ -z "${local_installs["$t_name"]:-}" ] && local_installs["$t_name"]="$d"
        done
    done

    echo "${UI_BOX}╭─ GE-PROTON RELEASE MANAGER (HEADLESS) ───────────────────────╮${UI_RST}"
    echo "│ ${UI_CYAN}Target Path${UI_RST}: $(get_compat_dir)"
    echo "│ ${UI_CYAN}Installed  ${UI_RST}: ${#local_installs[@]} version(s) detected locally"
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"

    # 1. Show local versions
    echo
    echo "  ${UI_PURPLE}[LOCAL VERSIONS]${UI_RST}"
    if [ ${#local_installs[@]} -gt 0 ]; then
        for v in "${!local_installs[@]}"; do
            local v_path="${local_installs["$v"]}"
            local v_sz
            v_sz=$(du -sh "$v_path" 2>/dev/null | awk '{print $1}')
            echo "    • ${UI_BOLD}$(printf '%-22s' "$v")${UI_RST} : ${UI_GREEN}[INSTALLED]${UI_RST} ${UI_DIM}(Size: $v_sz | $v_path)${UI_RST}"
        done
    else
        echo "    ${UI_DIM}(No GE-Proton versions installed in gamectl/runners/ or compatibilitytools.d/)${UI_RST}"
    fi

    # 2. Query GitHub Releases upstream
    echo
    echo "  ${UI_PURPLE}[UPSTREAM RELEASES (GitHub: GloriousEggroll/proton-ge-custom)]${UI_RST}"
    local arch_pat="x86_64\\.tar\\.gz$"
    case "$(uname -m 2>/dev/null || echo "x86_64")" in
        aarch64|arm64) arch_pat="aarch64\\.tar\\.gz$" ;;
        *) arch_pat="x86_64\\.tar\\.gz$" ;;
    esac

    local raw_json=""
    raw_json=$(curl -s --connect-timeout 5 --max-time 10 "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases?per_page=5" 2>/dev/null || echo "")

    local parsed_releases=""
    if [ -n "$raw_json" ] && echo "$raw_json" | jq -e 'if type=="array" then true else false end' >/dev/null 2>&1; then
        parsed_releases=$(echo "$raw_json" | jq -r --arg pat "$arch_pat" '
            .[] | {
                tag: .tag_name,
                asset: ([.assets[] | select(.name | test($pat))] | first)
            } | select(.asset != null) | [
                .tag,
                .asset.name,
                ((.asset.size // 0) / 1048576 | floor | tostring + " MB"),
                .asset.browser_download_url
            ] | @tsv
        ' 2>/dev/null || true)
    fi

    if [ -n "$parsed_releases" ]; then
        local idx=0
        while IFS=$'\t' read -r r_tag _ r_size _; do
            [ -z "$r_tag" ] && continue
            idx=$((idx + 1))
            local status_badge="${UI_CYAN}[AVAILABLE]${UI_RST}"
            [ -n "${local_installs["$r_tag"]:-}" ] && status_badge="${UI_GREEN}[INSTALLED]${UI_RST}"
            [ "$idx" -eq 1 ] && status_badge="${status_badge} ${UI_AMBER}(Latest)${UI_RST}"
            echo "    • ${UI_BOLD}$(printf '%-22s' "$r_tag")${UI_RST} : $status_badge ${UI_DIM}(Download Size: $r_size)${UI_RST}"
        done <<< "$parsed_releases"
        echo
        echo "  ${UI_DIM}Install command: gamectl proton-install [tag|latest]${UI_RST}"
    else
        echo "    ${UI_AMBER}[WARN]${UI_RST} ${UI_DIM}Unable to fetch upstream release list (Offline or GitHub API rate-limited).${UI_RST}"
        echo "    ${UI_DIM}You can still install directly via: gamectl proton-install <tag_name>${UI_RST}"
    fi
    echo
}

# Headless GE-Proton installer
proton_install() {
    local target_tag="${1:-latest}"
    local auto_yes=false
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes) auto_yes=true; shift ;;
            *) shift ;;
        esac
    done

    local compat_dir
    compat_dir="$(get_compat_dir)"
    mkdir -p "$compat_dir"

    local arch_suffix="x86_64"
    case "$(uname -m 2>/dev/null || echo "x86_64")" in
        aarch64|arm64) arch_suffix="aarch64" ;;
        *) arch_suffix="x86_64" ;;
    esac

    echo "[INFO] Preparing GE-Proton installation ($target_tag) for architecture $arch_suffix..."

    local resolved_tag=""
    local download_url=""
    local sha512_url=""
    local release_json=""

    if [ "$target_tag" = "latest" ]; then
        release_json=$(curl -s --connect-timeout 5 --max-time 10 "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest" 2>/dev/null || echo "")
        if [ -n "$release_json" ] && echo "$release_json" | jq -e '.tag_name' >/dev/null 2>&1; then
            resolved_tag=$(echo "$release_json" | jq -r '.tag_name')
            local pat="${arch_suffix}\\.tar\\.gz$"
            download_url=$(echo "$release_json" | jq -r --arg pat "$pat" '
                [.assets[] | select(.name | test($pat))] | first | .browser_download_url
            ' 2>/dev/null || echo "")
        fi
        if [ -z "$resolved_tag" ] || [ -z "$download_url" ] || [ "$download_url" = "null" ]; then
            echo "[ERROR] Failed to obtain latest release URL from GitHub API." >&2
            echo "        Specify target tag explicitly: gamectl proton-install <tag_name>" >&2
            return 1
        fi
    else
        resolved_tag="$target_tag"
        release_json=$(curl -s --connect-timeout 5 --max-time 10 "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/tags/${resolved_tag}" 2>/dev/null || echo "")
        if [ -n "$release_json" ] && echo "$release_json" | jq -e '.tag_name' >/dev/null 2>&1; then
            local pat="${arch_suffix}\\.tar\\.gz$"
            download_url=$(echo "$release_json" | jq -r --arg pat "$pat" '
                [.assets[] | select(.name | test($pat))] | first | .browser_download_url
            ' 2>/dev/null || echo "")
        fi
        if [ -z "$download_url" ] || [ "$download_url" = "null" ]; then
            # Direct asset fallback pattern
            download_url="https://github.com/GloriousEggroll/proton-ge-custom/releases/download/${resolved_tag}/${resolved_tag}-${arch_suffix}.tar.gz"
        fi
    fi

    local tarball_name
    tarball_name=$(basename "${download_url%%\?*}")
    [ -z "$tarball_name" ] && tarball_name="${resolved_tag}-${arch_suffix}.tar.gz"

    if [ -n "$release_json" ] && echo "$release_json" | jq -e '.assets' >/dev/null 2>&1; then
        local exact_sum1="${tarball_name%.tar.gz}.sha512sum"
        local exact_sum2="${tarball_name}.sha512sum"
        local arch_sum_pat="${arch_suffix}.*\\.sha512sum$"
        sha512_url=$(echo "$release_json" | jq -r --arg e1 "$exact_sum1" --arg e2 "$exact_sum2" --arg ap "$arch_sum_pat" '
            ([.assets[] | select(.name == $e1 or .name == $e2)] | first | .browser_download_url) //
            ([.assets[] | select(.name | test($ap))] | first | .browser_download_url) //
            (
                [.assets[] | select(.name | test("\\.sha512sum$"))] as $all |
                if ($all | length) == 1 then ($all[0].browser_download_url) else "" end
            ) // ""
        ' 2>/dev/null || echo "")
    fi

    echo "[INFO] Target version : $resolved_tag"
    echo "[INFO] Download URL   : $download_url"
    echo "[INFO] Target Dir     : $compat_dir/"

    if [ -d "$compat_dir/$resolved_tag" ] && [ "$auto_yes" = false ]; then
        if [ -t 0 ]; then
            echo -n "[WARN] Directory $resolved_tag already exists. Overwrite installation? [y/N]: "
            local confirm=""
            read -t 10 -r confirm || confirm="n"
            if [[ ! "$confirm" =~ ^[yY] ]]; then
                echo "[INFO] Installation canceled."
                return 0
            fi
        fi
    fi

    (
        local stage_dir=""
        stage_dir=$(mktemp -d "$compat_dir/.proton_stage.XXXXXX") || exit 1
        trap 'rm -rf "$stage_dir"' EXIT INT TERM

        local staged_tar="$stage_dir/$tarball_name"
        echo "[INFO] Downloading release tarball to staging directory..."
        if ! curl -# -fL --connect-timeout 15 -o "$staged_tar" "$download_url" || [ ! -s "$staged_tar" ]; then
            echo "[ERROR] Failed to download $resolved_tag from $download_url" >&2
            exit 1
        fi

        if [ -n "$sha512_url" ] && [ "$sha512_url" != "null" ]; then
            echo "[INFO] Verifying SHA-512 checksum..."
            local sum_file="$stage_dir/release.sha512sum"
            if ! curl -sSL --connect-timeout 15 --max-time 30 -o "$sum_file" "$sha512_url" || [ ! -s "$sum_file" ]; then
                echo "[ERROR] Failed to download SHA-512 checksum from $sha512_url" >&2
                exit 1
            fi
            local expected_hash=""
            expected_hash=$(grep -F "$tarball_name" "$sum_file" 2>/dev/null | grep -Eoi '[0-9a-f]{128}' | head -n 1 || true)
            [ -z "$expected_hash" ] && expected_hash=$(grep -Eoi '[0-9a-f]{128}' "$sum_file" 2>/dev/null | head -n 1 || true)
            if [ -z "$expected_hash" ]; then
                echo "[ERROR] SHA-512 checksum asset did not contain a valid 128-hex digest." >&2
                exit 1
            fi
            printf '%s  %s\n' "$expected_hash" "$tarball_name" > "$stage_dir/verify.sha512sum"
            if ! ( cd "$stage_dir" && sha512sum -c "verify.sha512sum" >/dev/null 2>&1 ); then
                echo "[ERROR] SHA-512 checksum verification failed for $tarball_name." >&2
                exit 1
            fi
            echo "[VERIFIED] SHA-512 checksum matched."
        fi

        if ! python3 - "$staged_tar" <<'PY'
import posixpath, re, sys, tarfile

tar_path = sys.argv[1]
unsafe_re = re.compile(r"(^/|^[A-Za-z]:|(^|[/\\])\.\.([/\\]|$)|\\)")
try:
    with tarfile.open(tar_path, "r:gz") as tf:
        members = tf.getmembers()
        if not members:
            print("[ERROR] Downloaded tarball is empty or unreadable.", file=sys.stderr)
            sys.exit(1)
        for m in members:
            if unsafe_re.search(m.name):
                print(f"[ERROR] Security violation: unsafe path traversal in tarball ({m.name}).", file=sys.stderr)
                sys.exit(1)
            if m.isdev() or m.isfifo():
                print(f"[ERROR] Security violation: device/fifo entry in tarball ({m.name}).", file=sys.stderr)
                sys.exit(1)
            if m.issym() or m.islnk():
                lnk = m.linkname
                if not lnk or lnk.startswith(("/", "\\")) or re.match(r"^[A-Za-z]:", lnk):
                    print(f"[ERROR] Security violation: absolute link target in tarball ({m.name} -> {lnk}).", file=sys.stderr)
                    sys.exit(1)
                norm = posixpath.normpath(posixpath.join(posixpath.dirname(m.name), lnk) if m.issym() else lnk)
                if norm == ".." or norm.startswith("../"):
                    print(f"[ERROR] Security violation: escaping link target in tarball ({m.name} -> {lnk}).", file=sys.stderr)
                    sys.exit(1)
except tarfile.TarError as exc:
    print(f"[ERROR] Downloaded tarball is corrupt or unreadable ({exc}).", file=sys.stderr)
    sys.exit(1)
PY
        then
            exit 1
        fi

        mkdir -p "$stage_dir/extract"
        echo "[INFO] Extracting staged tarball..."
        if ! tar -xzf "$staged_tar" -C "$stage_dir/extract"; then
            echo "[ERROR] Failed to extract $tarball_name in staging directory." >&2
            exit 1
        fi

        local extracted_folder="$stage_dir/extract/$resolved_tag"
        if [ ! -d "$extracted_folder" ]; then
            extracted_folder=$(find "$stage_dir/extract" -mindepth 1 -maxdepth 1 -type d -name "*${resolved_tag}*" 2>/dev/null | head -n 1)
        fi
        if [ -z "$extracted_folder" ] || [ ! -d "$extracted_folder" ]; then
            extracted_folder=$(find "$stage_dir/extract" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n 1)
        fi
        if [ -z "$extracted_folder" ] || [ ! -f "$extracted_folder/compatibilitytool.vdf" ]; then
            echo "[ERROR] Extraction completed but compatibilitytool.vdf not found in staged release." >&2
            exit 1
        fi
        [ -f "$extracted_folder/proton" ] && chmod +x "$extracted_folder/proton"

        local final_folder="$compat_dir/$(basename "$extracted_folder")"
        if [ -e "$final_folder" ]; then
            mv "$final_folder" "$stage_dir/old_backup" 2>/dev/null || {
                echo "[ERROR] Failed to replace existing runner directory: $final_folder" >&2
                exit 1
            }
        fi
        if ! mv "$extracted_folder" "$final_folder"; then
            [ -d "$stage_dir/old_backup" ] && mv "$stage_dir/old_backup" "$final_folder" 2>/dev/null || true
            echo "[ERROR] Failed to promote staged runner to: $final_folder" >&2
            exit 1
        fi

        echo "[VERIFIED] GE-Proton $resolved_tag installed successfully in: $final_folder"
        exit 0
    )
}

# Safely remove an installed GE-Proton version
proton_remove() {
    local tag="${1:-}"
    local auto_yes=false
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes) auto_yes=true; shift ;;
            *) shift ;;
        esac
    done

    if [ -z "$tag" ]; then
        echo "Usage: gamectl proton-remove <tag> [-y|--yes]" >&2
        return 1
    fi

    # Path traversal protection
    if [[ "$tag" =~ (\.\.|\/|\\) ]]; then
        echo "[ERROR] Invalid tag (path traversal sequence detected): $tag" >&2
        return 1
    fi

    local -a compat_dirs=()
    local cdir
    while IFS= read -r cdir; do
        [ -n "$cdir" ] && compat_dirs+=("$cdir")
    done < <(list_runner_dirs)

    local target_dir=""
    for cdir in "${compat_dirs[@]}"; do
        [ -n "$cdir" ] && [ -d "$cdir" ] || continue
        if [ -d "$cdir/$tag" ]; then
            target_dir="$cdir/$tag"
            break
        fi
    done

    if [ -z "$target_dir" ] || [ ! -d "$target_dir" ]; then
        echo "[ERROR] GE-Proton version '$tag' not found in runner directories." >&2
        return 1
    fi

    # Canonical path traversal assertion against authorized runner parent directories
    local real_target guard_ok=0 real_parent
    real_target="$(realpath "$target_dir" 2>/dev/null || echo "")"
    if [ -n "$real_target" ]; then
        for cdir in "${compat_dirs[@]}"; do
            [ -n "$cdir" ] && [ -d "$cdir" ] || continue
            real_parent="$(realpath "$cdir" 2>/dev/null || echo "")"
            if [ -n "$real_parent" ] && [[ "$real_target" == "$real_parent/"* ]] && [ "$real_target" != "$real_parent" ]; then
                guard_ok=1
                break
            fi
        done
    fi
    if [ "$guard_ok" -ne 1 ]; then
        echo "[ERROR] Path traversal guard failed for: $target_dir" >&2
        return 1
    fi

    local sz
    sz=$(du -sh "$target_dir" 2>/dev/null | awk '{print $1}')

    if [ "$auto_yes" = false ] && [ -t 0 ]; then
        echo -n "Delete GE-Proton directory '$tag' (Size: $sz)? [y/N]: "
        local confirm=""
        read -t 10 -r confirm || confirm="n"
        echo
        if [[ ! "$confirm" =~ ^[yY] ]]; then
            echo "[INFO] Removal of $tag canceled."
            return 0
        fi
    fi

    rm -rf "$target_dir"
    echo "[VERIFIED] GE-Proton '$tag' removed successfully ($sz disk space freed)."
    return 0
}

# Canonical Windows runner environment contract shared by launch_game & manage_prefix
prepare_windows_runner_env() {
    local runner_bin="${1:-wine}"
    local gdir="${2:-}"
    local raw_appid="${3:-0}"
    local renderer_mode="${4:-auto}"
    local prime_active="${5:-0}"

    local clean_appid="${raw_appid//[!0-9]/}"
    [ -z "$clean_appid" ] && clean_appid="0"

    GAMECTL_WIN_PFX_DIR="$gdir/pfx"
    GAMECTL_WIN_APPID="$clean_appid"
    if [ "$clean_appid" != "0" ]; then
        GAMECTL_WIN_UMU_GAMEID="umu-${clean_appid}"
    else
        GAMECTL_WIN_UMU_GAMEID="umu-default"
    fi
    GAMECTL_WIN_STEAM_ROOT="${STEAM_CLIENT_INSTALL_PATH:-$(get_steam_root 2>/dev/null || echo "$HOME/.local/share/Steam")}"

    case "$runner_bin" in
        umu-run|*/umu-run) GAMECTL_WIN_RUNNER_KIND="umu" ;;
        *proton*)          GAMECTL_WIN_RUNNER_KIND="proton" ;;
        *)                 GAMECTL_WIN_RUNNER_KIND="wine" ;;
    esac

    local eff_renderer="${GAMECTL_ACTIVE_RENDERER:-}"
    if [ -z "$eff_renderer" ]; then
        if [ -n "${PROTON_USE_WINED3D:-}" ]; then
            [ "$PROTON_USE_WINED3D" = "1" ] && eff_renderer="wined3d" || eff_renderer="dxvk"
        elif type resolve_graphics_renderer >/dev/null 2>&1; then
            eff_renderer="$(resolve_graphics_renderer "$renderer_mode" "$prime_active")"
        else
            eff_renderer="dxvk"
        fi
    fi
    GAMECTL_WIN_RENDERER="$eff_renderer"
    if [ "$eff_renderer" = "wined3d" ]; then
        GAMECTL_WIN_PROTON_WINED3D="1"
    else
        GAMECTL_WIN_PROTON_WINED3D="0"
    fi

    if [ "$clean_appid" = "0" ] && [ -z "${PROTONFIXES_DISABLE+x}" ]; then
        GAMECTL_WIN_DISABLE_PROTONFIXES="1"
    else
        GAMECTL_WIN_DISABLE_PROTONFIXES=""
    fi
}

# Wine Prefix Swiss Army Knife & Wineserver Lifecycle Guard (Chunk 4)
manage_prefix() {
    local game_dir="${1:-}"
    local action="${2:-}"
    shift 2 2>/dev/null || shift $# 2>/dev/null || true

    if [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        echo "[ERROR] Game directory not found or invalid: $game_dir" >&2
        echo "Usage: gamectl pfx <game_dir> [winecfg|regedit|cmd|shell|kill|clean|winetricks] [args...]" >&2
        return 1
    fi

    # Canonicalize game_dir path
    game_dir="$(cd "$game_dir" 2>/dev/null && pwd || echo "$game_dir")"
    local pfx_dir="$game_dir/pfx"
    local runner_bin
    runner_bin="$(find_runner "$game_dir" 2>/dev/null || true)"
    [ -z "$runner_bin" ] && runner_bin="wine"

    # AppID resolution (SSoT)
    local appid
    appid="$(resolve_game_appid "$game_dir" "0")"

    # Wineserver resolution
    local ws_bin
    ws_bin="$(get_wineserver_bin "$runner_bin" 2>/dev/null || echo "")"

    # Interactive menu if action is empty and stdin is terminal
    if [ -z "$action" ]; then
        require_tui "Wine prefix manager" || return $?
        if [ -t 0 ]; then
            if command -v fzf >/dev/null 2>&1; then
                flush_tty_input
                local game_name
                game_name="$(basename "$game_dir")"
                local pfx_status="[NOT FOUND]"
                local pfx_color="\033[38;5;203m"
                local pfx_size="0 B"
                if [ -d "$pfx_dir" ]; then
                    pfx_status="[ACTIVE]"
                    pfx_color="\033[38;5;120m"
                    pfx_size="$(du -sh "$pfx_dir" 2>/dev/null | awk '{print $1}' || echo "N/A")"
                fi

                local pfx_palette
                pfx_palette=$(cat <<EOF
winecfg	Wine Configuration	Configure Audio, Graphics, Windows Version & DLL Overrides
regedit	Registry Editor	Windows Registry Editor (regedit.exe)
cmd	Command Prompt	Windows Command Prompt (cmd.exe)
shell	Host Bash Subshell	Spawn bash subshell with active WINEPREFIX & PATH
winetricks	Winetricks Manager	Launch winetricks GUI / Package Manager helper
kill	Kill Wineserver	Terminate locked / hung Wineserver process
clean	Wipe Wine Prefix	Create save snapshot backup & wipe entire pfx directory
EOF
)

                export GAMECTL_PFX_NAME="$game_name"
                export GAMECTL_PFX_DIR="$game_dir"
                export GAMECTL_PFX_PATH="$pfx_dir"
                export GAMECTL_PFX_RUNNER="$runner_bin"
                export GAMECTL_PFX_STATUS="${pfx_color}${pfx_status}"
                export GAMECTL_PFX_SIZE="$pfx_size"

                local preview_cmd
                preview_cmd='printf "\033[38;5;60m╭─ WINE PREFIX OVERVIEW ──────────────────────────────╮\033[0m\n  Game Title  : \033[1m%s\033[0m\n  Directory   : %s\n  Prefix Path : %s\n  Active Wine : \033[38;5;111m%s\033[0m\n  Status      : %b\033[0m (Size: %s)\n\033[38;5;60m╰─────────────────────────────────────────────────────╯\033[0m\n\033[38;5;60m╭─ ACTION DETAIL ─────────────────────────────────────╮\033[0m\n  Tool   : \033[1m%s\033[0m - %s\n  Desc   : %s\n\033[38;5;60m╰─────────────────────────────────────────────────────╯\033[0m\n" "$GAMECTL_PFX_NAME" "$GAMECTL_PFX_DIR" "$GAMECTL_PFX_PATH" "$GAMECTL_PFX_RUNNER" "$GAMECTL_PFX_STATUS" "$GAMECTL_PFX_SIZE" {1} {2} {3}'

                local pfx_sel fzf_rc=0
                pfx_sel=$(echo "$pfx_palette" | fzf \
                    --delimiter=$'\t' \
                    --with-nth=1,2 \
                    --border-label="  ╢ gamectl :: Wine Prefix Manager :: $game_name ╟  " \
                    --border-label-pos=2 \
                    --header="Enter: Execute │ Esc: Return" \
                    --prompt="Prefix > " \
                    --preview="$preview_cmd" \
                    --preview-window=down:50%:border-rounded:wrap \
                    --reverse 2>/dev/null) || fzf_rc=$?

                if [ "$fzf_rc" -eq 130 ]; then
                    return 0
                fi
                if [ "$fzf_rc" -ne 0 ] && [ "$fzf_rc" -ne 1 ]; then
                    echo "[ERROR] Wine prefix manager failed (fzf exit code $fzf_rc)." >&2
                    return "$fzf_rc"
                fi
                [ -z "$pfx_sel" ] && return 0

                action=$(echo "$pfx_sel" | awk -F'\t' '{print $1}')
            else
                echo "[ERROR] fzf is required for Wine prefix manager." >&2
                return 127
            fi
        else
            echo "Usage: gamectl pfx <game_dir> [winecfg|regedit|cmd|shell|kill|clean|winetricks] [args...]" >&2
            return 1
        fi
    fi

    case "$action" in
        kill)
            echo "[INFO] Sending force termination signal (wineserver -k) to prefix: $pfx_dir"
            if [ -d "$pfx_dir" ]; then
                if [ -n "$ws_bin" ]; then
                    WINEPREFIX="$pfx_dir" "$ws_bin" -k 2>/dev/null || true
                elif command -v wineserver >/dev/null 2>&1; then
                    WINEPREFIX="$pfx_dir" wineserver -k 2>/dev/null || true
                fi
            fi
            echo "[VERIFIED] Wineserver for prefix $pfx_dir has been stopped."
            return 0
            ;;
        clean)
            echo "[INFO] Starting Wine prefix cleanup: $pfx_dir"
            if [ ! -d "$pfx_dir" ]; then
                echo "[INFO] Prefix directory $pfx_dir does not exist, nothing to clean."
                return 0
            fi

            local is_dry_run=false auto_yes=false
            for arg in "$@"; do
                if [ "$arg" = "--dry-run" ] || [ "$arg" = "-n" ]; then
                    is_dry_run=true
                elif [ "$arg" = "-y" ] || [ "$arg" = "--yes" ]; then
                    auto_yes=true
                fi
            done

            if [ "$is_dry_run" = true ]; then
                local pfx_sz="0"
                pfx_sz=$(du -sh "$pfx_dir" 2>/dev/null | cut -f1 || echo "unknown")
                echo "[INFO] [DRY-RUN] Target Wine prefix directory: $pfx_dir (Size: $pfx_sz)"
                echo "[INFO] [DRY-RUN] Would create pre-wipe savegame backup snapshot via backup_save."
                echo "[INFO] [DRY-RUN] Would terminate wineserver process."
                echo "[INFO] [DRY-RUN] Would remove prefix directory: $pfx_dir"
                echo "[INFO] [DRY-RUN] Wine prefix cleanup simulated successfully (no files deleted)."
                return 0
            fi

            # 1. Create save snapshot backup
            if [ -d "$game_dir/saves" ] || [ -L "$game_dir/saves" ]; then
                if ! backup_save "$game_dir" true; then
                    echo "[ERROR] Pre-wipe save snapshot backup failed. Aborting prefix wipe to protect saves." >&2
                    log_msg "ERROR" "PFX" "Pre-wipe save snapshot backup failed for $(basename "$game_dir")"
                    return 1
                fi
            fi

            # 2. Kill running wineserver
            if [ -n "$ws_bin" ]; then
                WINEPREFIX="$pfx_dir" "$ws_bin" -k 2>/dev/null || true
            elif command -v wineserver >/dev/null 2>&1; then
                WINEPREFIX="$pfx_dir" wineserver -k 2>/dev/null || true
            fi
            sleep 0.2

            # 3. Confirmation check
            if [ "$auto_yes" = false ] && [ -t 0 ]; then
                echo -n "[WARN] Wipe entire Wine prefix ($pfx_dir)? Registry and Wine configuration will be reset. [y/N]: "
                local confirm=""
                read -t 10 -r confirm || confirm="n"
                echo
                if [[ ! "$confirm" =~ ^[yY] ]]; then
                    echo "[INFO] Prefix cleanup canceled."
                    return 0
                fi
            fi

            # 4. Remove pfx folder safely
            rm -rf "$pfx_dir"
            echo "[VERIFIED] Wine prefix wiped successfully ($pfx_dir removed)."
            return 0
            ;;
        shell)
            prepare_windows_runner_env "$runner_bin" "$game_dir" "$appid" "auto" "0"
            echo "[INFO] Spawning interactive bash subshell inside prefix environment: $pfx_dir"
            echo "[INFO] Active environment: WINEPREFIX=$pfx_dir, RUNNER=$runner_bin"
            echo "[INFO] Type 'exit' to return to gamectl."
            (
                export WINEPREFIX="$GAMECTL_WIN_PFX_DIR" \
                    GAMECTL_RUNNER="$runner_bin" \
                    GAMEID="$GAMECTL_WIN_UMU_GAMEID" \
                    STEAM_COMPAT_APP_ID="$GAMECTL_WIN_APPID" \
                    SteamAppId="$GAMECTL_WIN_APPID" \
                    SteamGameId="$GAMECTL_WIN_APPID"
                if [ "$GAMECTL_WIN_RUNNER_KIND" = "proton" ] || [ "$GAMECTL_WIN_RUNNER_KIND" = "umu" ]; then
                    export PROTON_USE_WINED3D="$GAMECTL_WIN_PROTON_WINED3D"
                    [ "$GAMECTL_WIN_DISABLE_PROTONFIXES" = "1" ] && export PROTONFIXES_DISABLE=1
                fi
                if [ "$GAMECTL_WIN_RUNNER_KIND" = "proton" ]; then
                    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$GAMECTL_WIN_STEAM_ROOT" \
                        STEAM_COMPAT_DATA_PATH="$game_dir"
                    local p_bin_dir
                    p_bin_dir="$(dirname "$runner_bin")/files/bin"
                    [ -d "$p_bin_dir" ] && export PATH="$p_bin_dir:$PATH"
                fi
                cd "$game_dir" || true
                exec bash -i
            )
            return 0
            ;;
        winecfg|regedit|cmd)
            mkdir -p "$pfx_dir"
            prepare_windows_runner_env "$runner_bin" "$game_dir" "$appid" "auto" "0"
            echo "[INFO] Executing $action inside prefix: $pfx_dir (Runner: $runner_bin)..."
            local target_exec="$action"
            [ "$action" = "cmd" ] && target_exec="cmd.exe"

            (
                export WINEPREFIX="$GAMECTL_WIN_PFX_DIR" \
                    GAMEID="$GAMECTL_WIN_UMU_GAMEID" \
                    STEAM_COMPAT_APP_ID="$GAMECTL_WIN_APPID" \
                    SteamAppId="$GAMECTL_WIN_APPID" \
                    SteamGameId="$GAMECTL_WIN_APPID"
                if [ "$GAMECTL_WIN_RUNNER_KIND" = "proton" ] || [ "$GAMECTL_WIN_RUNNER_KIND" = "umu" ]; then
                    export PROTON_USE_WINED3D="$GAMECTL_WIN_PROTON_WINED3D"
                    [ "$GAMECTL_WIN_DISABLE_PROTONFIXES" = "1" ] && export PROTONFIXES_DISABLE=1
                fi
                case "$GAMECTL_WIN_RUNNER_KIND" in
                    umu)
                        "$runner_bin" "$target_exec" "$@"
                        ;;
                    proton)
                        export STEAM_COMPAT_CLIENT_INSTALL_PATH="$GAMECTL_WIN_STEAM_ROOT" \
                            STEAM_COMPAT_DATA_PATH="$game_dir"
                        "$runner_bin" run "$target_exec" "$@"
                        ;;
                    *)
                        "$runner_bin" "$target_exec" "$@"
                        ;;
                esac
            )
            ;;
        winetricks)
            if ! command -v winetricks >/dev/null 2>&1; then
                echo "[ERROR] 'winetricks' binary not found on host system." >&2
                echo "[INFO] Install winetricks via your distribution package manager (e.g. pacman -S winetricks / apt install winetricks)." >&2
                return 1
            fi
            mkdir -p "$pfx_dir"
            echo "[INFO] Launching winetricks inside prefix: $pfx_dir"
            WINEPREFIX="$pfx_dir" winetricks "$@"
            ;;
        *)
            echo "[ERROR] Unknown prefix action: '$action'" >&2
            echo "Supported actions: winecfg, regedit, cmd, shell, kill, clean, winetricks" >&2
            return 1
            ;;
    esac
}

# --- [MODULE] src/runners/42_graphics_isolation.sh ---
# Check if host GPU is Intel Haswell / 4th Gen Core (prone to Mesa GL threaded asset decompression crashes)
is_haswell_gpu() {
    local pci_dir="${GAMECTL_PCI_UEVENT_DIR:-/sys/bus/pci/devices}"
    if [ -z "${GAMECTL_PCI_UEVENT_DIR:-}" ] && command -v lspci >/dev/null 2>&1; then
        local gpu_info
        gpu_info=$(lspci 2>/dev/null | grep -E "VGA|3D" || true)
        if echo "$gpu_info" | grep -qi -E "Haswell|4th Gen Core"; then
            return 0
        fi
    fi
    if [ -d "$pci_dir" ]; then
        local uev
        for uev in "$pci_dir"/*/uevent; do
            [ -f "$uev" ] || continue
            grep -qiE '^PCI_CLASS=0?3(00|02|80)00' "$uev" 2>/dev/null || continue
            grep -qiE '^PCI_ID=8086:(04|0a|0d)[0-9a-f]{2}$' "$uev" 2>/dev/null && return 0
        done
    fi
    return 1
}

# Canonical 2-tier host Vulkan capability probe (zero hardcode vendor dependency)
# Outputs: VULKAN_READY | VULKAN_LEGACY | OPENGL_ONLY
detect_vulkan_capability() {
    if [ -n "${GAMECTL_VULKAN_CAPABILITY:-}" ]; then
        echo "$GAMECTL_VULKAN_CAPABILITY"
        return 0
    fi

    # Tier 1: Runtime per-device probe via vulkaninfo --summary when available
    if command -v vulkaninfo >/dev/null 2>&1; then
        local v_sum
        v_sum=$(vulkaninfo --summary 2>&1 || true)
        if echo "$v_sum" | grep -q -E '(^|[[:space:]])GPU[0-9]+:|PHYSICAL_DEVICE_TYPE_'; then
            local vk_tier
            vk_tier=$(printf '%s\n' "$v_sum" | awk '
                function flush_gpu(    ver_str, p, maj, min, score) {
                    if (in_gpu != 1) return
                    if (cur_type !~ /PHYSICAL_DEVICE_TYPE_(DISCRETE|INTEGRATED)_GPU/) return
                    if (tolower(cur_name) ~ /(llvmpipe|swiftshader)/) return
                    hw_count++
                    if (match(cur_ver, /[0-9]+\.[0-9]+\.[0-9]+/)) {
                        ver_str = substr(cur_ver, RSTART, RLENGTH)
                        split(ver_str, p, ".")
                        maj = p[1] + 0
                        min = p[2] + 0
                        score = maj * 1000 + min
                        if (score > max_score) {
                            max_score = score
                            max_maj = maj
                            max_min = min
                        }
                        if (cur_type ~ /PHYSICAL_DEVICE_TYPE_DISCRETE_GPU/ && (maj > 1 || (maj == 1 && min >= 3))) {
                            has_modern_dgpu = 1
                        }
                    }
                }
                BEGIN {
                    in_gpu = 0; hw_count = 0; max_score = -1; max_maj = 0; max_min = 0;
                    has_modern_dgpu = 0; incomplete_warn = 0;
                    cur_ver = ""; cur_type = ""; cur_name = "";
                }
                {
                    if (tolower($0) ~ /vulkan support is incomplete|non-conformant/) {
                        incomplete_warn = 1
                    }
                }
                /^[[:space:]]*GPU[0-9]+:/ {
                    flush_gpu()
                    in_gpu = 1
                    cur_ver = ""; cur_type = ""; cur_name = ""
                    next
                }
                in_gpu == 1 && /apiVersion[[:space:]]*=/ { cur_ver = $0; next }
                in_gpu == 1 && /deviceType[[:space:]]*=/ { cur_type = $0; next }
                in_gpu == 1 && /deviceName[[:space:]]*=/ { cur_name = $0; next }
                END {
                    flush_gpu()
                    if (hw_count == 0) {
                        print "OPENGL_ONLY"
                    } else if (max_maj > 1 || (max_maj == 1 && max_min >= 3)) {
                        if (incomplete_warn == 1 && has_modern_dgpu == 0) {
                            print "VULKAN_LEGACY"
                        } else {
                            print "VULKAN_READY"
                        }
                    } else if (max_maj == 1 && max_min >= 1) {
                        print "VULKAN_LEGACY"
                    } else {
                        print "OPENGL_ONLY"
                    }
                }
            ')
            if [ -n "$vk_tier" ]; then
                echo "$vk_tier"
                return 0
            fi
        elif echo "$v_sum" | grep -qiE 'Cannot create Vulkan instance|ERROR_INCOMPATIBLE_DRIVER'; then
            echo "OPENGL_ONLY"
            return 0
        fi
    fi

    # Tier 2: Kernel DRM driver & Vulkan ICD manifest inspection
    local icd_files=() icd
    for icd in /usr/share/vulkan/icd.d/*.json /etc/vulkan/icd.d/*.json; do
        [ -f "$icd" ] && icd_files+=("$icd")
    done
    if [ ${#icd_files[@]} -eq 0 ]; then
        echo "OPENGL_ONLY"
        return 0
    fi

    local has_hw_icd=0 has_modern_icd=0
    for icd in "${icd_files[@]}"; do
        local bname
        bname="$(basename "$icd")"
        case "$bname" in
            *lvp*|*swiftshader*|*virtio*) ;;
            *hasvk*) has_hw_icd=1 ;;
            *) has_hw_icd=1; has_modern_icd=1 ;;
        esac
    done
    if [ "$has_hw_icd" -eq 0 ]; then
        echo "OPENGL_ONLY"
        return 0
    fi

    local dgpu_vend="none"
    type detect_dgpu_vendor >/dev/null 2>&1 && dgpu_vend="$(detect_dgpu_vendor 2>/dev/null || echo none)"
    if [ "$dgpu_vend" = "none" ]; then
        if is_haswell_gpu; then
            echo "VULKAN_LEGACY"
            return 0
        fi
        local pci_vga=""
        command -v lspci >/dev/null 2>&1 && pci_vga=$(lspci 2>/dev/null | grep -E "VGA|3D" || true)
        if echo "$pci_vga" | grep -qi -E "Ivy Bridge|3rd Gen Core|HD Graphics 2500|HD Graphics 4000"; then
            echo "VULKAN_LEGACY"
            return 0
        fi
        local has_modern_drv=0 has_legacy_drv=0 drv_link drv_name
        for drv_link in /sys/class/drm/card[0-9]*/device/driver; do
            [ -L "$drv_link" ] || continue
            drv_name="$(basename "$(readlink -f "$drv_link" 2>/dev/null)" 2>/dev/null || true)"
            case "$drv_name" in
                amdgpu|nvidia|xe|i915) has_modern_drv=1 ;;
                radeon|nouveau|vmwgfx|virtio-pci|bochs-drm|qxl|vboxvideo) has_legacy_drv=1 ;;
            esac
        done
        if [ "$has_modern_drv" -eq 0 ] && [ "$has_legacy_drv" -eq 1 ]; then
            echo "VULKAN_LEGACY"
            return 0
        fi
    fi

    if [ "$has_modern_icd" -eq 1 ]; then
        echo "VULKAN_READY"
    else
        echo "VULKAN_LEGACY"
    fi
    return 0
}

# Resolve effective graphics renderer (dxvk | wined3d) from mode + host capability
resolve_graphics_renderer() {
    local mode="${1:-auto}"
    local prime_active="${2:-0}"
    mode="${mode,,}"

    case "$mode" in
        wined3d|opengl|gl)
            echo "wined3d"
            ;;
        dxvk|vulkan|vk)
            echo "dxvk"
            ;;
        auto|"")
            if [ "$prime_active" = "1" ]; then
                echo "dxvk"
            else
                local cap
                cap="$(detect_vulkan_capability)"
                case "$cap" in
                    VULKAN_READY) echo "dxvk" ;;
                    *)            echo "wined3d" ;;
                esac
            fi
            ;;
        *)
            echo "dxvk"
            ;;
    esac
}

# Dynamically detect host native display resolution via DRM / Wayland / X11
get_native_resolution() {
    local res=""
    # Priority 1: DRM kernel modes (direct & universal across all compositors/X11)
    for m_file in /sys/class/drm/card*-*/modes; do
        [ -f "$m_file" ] || continue
        local s_file="$(dirname "$m_file")/status"
        if [ -f "$s_file" ] && grep -q "^connected" "$s_file" 2>/dev/null; then
            local line
            line=$(head -n 1 "$m_file" 2>/dev/null | tr -d '[:space:]')
            if [[ "$line" =~ ^[0-9]+x[0-9]+$ ]]; then
                res="$line"
                break
            fi
        fi
    done

    # Priority 2: Hyprland monitor inspection
    if [ -z "$res" ] && command -v hyprctl >/dev/null 2>&1; then
        res=$(hyprctl monitors 2>/dev/null | grep -E '^[[:space:]]*[0-9]+x[0-9]+@' | head -n 1 | sed -E 's/.*([0-9]+x[0-9]+)@.*/\1/' || true)
    fi

    # Priority 3: X11 / Xwayland via xrandr
    if [ -z "$res" ] && command -v xrandr >/dev/null 2>&1; then
        res=$(xrandr --current 2>/dev/null | grep -E '\bconnected\b' | grep -o -E '[0-9]+x[0-9]+\+[0-9]+\+[0-9]+' | head -n 1 | cut -d'+' -f1 || true)
        [ -z "$res" ] && res=$(xrandr --current 2>/dev/null | grep -E '^[[:space:]]+[0-9]+x[0-9]+' | head -n 1 | awk '{print $1}' || true)
    fi

    # Fallback default
    if [[ ! "$res" =~ ^[0-9]+x[0-9]+$ ]]; then
        res="1920x1080"
    fi
    echo "$res"
}

# Dynamically calculate Gamescope display & FSR render arguments based on native resolution
get_default_gamescope_args() {
    local n_res
    n_res=$(get_native_resolution)
    local nw="${n_res%x*}"
    local nh="${n_res#*x}"

    local rw rh
    if [ "$nw" -ge 3840 ] && [ "$nh" -ge 2160 ]; then
        rw=2560; rh=1440
    elif [ "$nw" -ge 2560 ] && [ "$nh" -ge 1440 ]; then
        rw=1920; rh=1080
    elif [ "$nw" -eq 1920 ] && [ "$nh" -eq 1080 ]; then
        rw=1280; rh=720
    elif [ "$nw" -eq 1600 ] && [ "$nh" -eq 900 ]; then
        rw=1280; rh=720
    elif [ "$nw" -eq 1280 ] && [ "$nh" -eq 800 ]; then
        rw=960; rh=600
    else
        rw=$(( (nw * 2 / 3 + 1) / 2 * 2 ))
        rh=$(( (nh * 2 / 3 + 1) / 2 * 2 ))
    fi
    echo "-W $rw -H $rh -w $nw -h $nh -F fsr -f"
}

# Check if systemd user daemon and cgroups v2 scope unit execution is supported
check_systemd_scope_support() {
    if command -v systemd-run >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1; then
        if systemd-run --user --scope --quiet true 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# Detect discrete secondary GPU vendor on hybrid systems (NVIDIA, AMD, Intel Arc)
detect_dgpu_vendor() {
    if [ -n "${GAMECTL_DGPU_VENDOR:-}" ]; then
        echo "$GAMECTL_DGPU_VENDOR"
        return 0
    fi

    local vga_count=0
    local vendors=()

    for dev in /sys/bus/pci/devices/*; do
        [ -f "$dev/class" ] || continue
        local pci_class
        pci_class=$(cat "$dev/class" 2>/dev/null || echo "")
        case "$pci_class" in
            0x0302*|0x030200*)
                # Secondary 3D controller (Optimized for 3D acceleration / dGPU)
                local v_id
                v_id=$(cat "$dev/vendor" 2>/dev/null || echo "")
                case "$v_id" in
                    0x10de) echo "nvidia"; return 0 ;;
                    0x1002) echo "amd"; return 0 ;;
                    0x8086) echo "intel"; return 0 ;;
                esac
                ;;
            0x0300*|0x030000*)
                vga_count=$((vga_count + 1))
                local v_id
                v_id=$(cat "$dev/vendor" 2>/dev/null || echo "")
                vendors+=("$v_id")
                ;;
        esac
    done

    # If multiple display controllers exist without a specific 0x0302 class device
    if [ "$vga_count" -gt 1 ]; then
        for v in "${vendors[@]}"; do
            if [ "$v" = "0x10de" ]; then
                echo "nvidia"
                return 0
            fi
        done
        local has_amd=false has_intel=false amd_count=0
        for v in "${vendors[@]}"; do
            [ "$v" = "0x1002" ] && { has_amd=true; amd_count=$((amd_count + 1)); }
            [ "$v" = "0x8086" ] && has_intel=true
        done
        if [ "$has_amd" = true ] && [ "$has_intel" = true ]; then
            echo "amd"
            return 0
        fi
        if [ "$amd_count" -gt 1 ]; then
            echo "amd"
            return 0
        fi
    fi

    echo "none"
    return 0
}

# Construct rootless Bubblewrap (bwrap) security sandbox argument array
build_sandbox_command() {
    local gdir="$1"
    declare -ga GAMECTL_SANDBOX_PREFIX=()

    if ! command -v bwrap >/dev/null 2>&1; then
        echo "[WARN] bubblewrap (bwrap) not found in PATH. Sandboxing skipped." >&2
        return 1
    fi

    local desktop_runtime_dir app_runtime_dir
    desktop_runtime_dir="$(get_desktop_runtime_dir)"
    app_runtime_dir="$(get_runtime_dir)"
    local wayland_socket="${WAYLAND_DISPLAY:-wayland-0}"
    local xauth_file="${XAUTHORITY:-$HOME/.Xauthority}"

    GAMECTL_SANDBOX_PREFIX=(
        bwrap
        --ro-bind /usr /usr
        --ro-bind-try /lib /lib
        --ro-bind-try /lib64 /lib64
        --ro-bind-try /bin /bin
        --ro-bind-try /sbin /sbin
        --ro-bind-try /etc /etc
        --proc /proc
        --dev /dev
        --ro-bind /sys /sys
        --tmpfs /tmp
        --ro-bind-try /tmp/.X11-unix /tmp/.X11-unix
        --tmpfs /run
        --tmpfs "$desktop_runtime_dir"
        --bind-try "$desktop_runtime_dir/wayland-0" "$desktop_runtime_dir/wayland-0"
        --bind-try "$desktop_runtime_dir/$wayland_socket" "$desktop_runtime_dir/$wayland_socket"
        --bind-try "$desktop_runtime_dir/pipewire-0" "$desktop_runtime_dir/pipewire-0"
        --bind-try "$desktop_runtime_dir/pulse" "$desktop_runtime_dir/pulse"
        --bind-try "$app_runtime_dir" "$app_runtime_dir"
        --tmpfs "$HOME"
        --ro-bind-try "$xauth_file" "$xauth_file"
        --bind-try "$HOME/.config/gamectl" "$HOME/.config/gamectl"
        --ro-bind-try "${XDG_DATA_HOME:-$HOME/.local/share}/gamectl/runners" "${XDG_DATA_HOME:-$HOME/.local/share}/gamectl/runners"
        --ro-bind-try "$HOME/.local/share/Steam" "$HOME/.local/share/Steam"
        --ro-bind-try "$HOME/.local/share/gbe-fork" "$HOME/.local/share/gbe-fork"
        --ro-bind-try "$HOME/.steam" "$HOME/.steam"
        --bind-try "$HOME/.local/share/vulkan" "$HOME/.local/share/vulkan"
        --bind "$gdir" "$gdir"
        --chdir "$gdir"
        --unshare-user
        --unshare-ipc
        --unshare-pid
        --die-with-parent
    )
    return 0
}

# --- [MODULE] src/runners/50_launcher.sh ---
# Preview pane generator for Process HUD Log context (3 lines before and 3 lines after)
preview_process_log() {
    local lfile="$1"
    local lnum="${2:-1}"
    [ -f "$lfile" ] || return 0
    [[ "$lnum" =~ ^[0-9]+$ ]] || lnum=1

    local total_lines
    total_lines=$(wc -l < "$lfile" 2>/dev/null || echo 1)
    local start_line=$(( lnum > 3 ? lnum - 3 : 1 ))
    local end_line=$(( lnum + 3 < total_lines ? lnum + 3 : total_lines ))

    echo "${UI_BOX}╭─ PROCESS LOG CONTEXT (Lines $start_line..$end_line of $total_lines) ────────────────╮${UI_RST}"
    local cur=1
    while IFS= read -r line || [ -n "$line" ]; do
        if [ "$cur" -ge "$start_line" ] && [ "$cur" -le "$end_line" ]; then
            if [ "$cur" -eq "$lnum" ]; then
                printf "  ${UI_GREEN}-> [%3d]${UI_RST} ${UI_BOLD}${UI_CYAN}%s${UI_RST}\n" "$cur" "$line"
            else
                printf "     ${UI_DIM}[%3d] %s${UI_RST}\n" "$cur" "$line"
            fi
        fi
        cur=$((cur + 1))
        [ "$cur" -gt "$end_line" ] && break
    done < "$lfile"
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────────────╯${UI_RST}"
}

# Interactive Live HUD for running game process (Zero-Flicker FZF Modal)
game_controller_hud() {
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "[ERROR] Process HUD requires a terminal (TTY)." >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for Process HUD but was not found in PATH." >&2
        return 127
    fi

    local game_pid="$1"
    local title="$2"
    local log_file="$3"
    local gdir="$4"
    local gbin="$5"
    local info_file="$6"
    local run_type="$7"

    flush_tty_input

    while true; do
        local is_alive=0
        if kill -0 "$game_pid" 2>/dev/null; then
            is_alive=1
        fi

        local status_badge="[TERMINATED / EXITED]"
        local status_color="\033[38;5;111m"
        if [ "$is_alive" -eq 1 ]; then
            status_badge="[RUNNING]"
            status_color="\033[38;5;120m"
        fi

        local hud_palette
        if [ "$is_alive" -eq 1 ]; then
            hud_palette=$(cat <<EOF
1	Return to Game Library	Keep process $game_pid active in background
2	Return to Master Dashboard	Keep process $game_pid active in background
3	Live Game Log Stream	View recent process output & runtime traces
4	Stop Game (SIGTERM)	Send graceful shutdown signal to process
5	Force Kill Game (SIGKILL)	Emergency teardown & terminate wineserver
EOF
)
        else
            hud_palette=$(cat <<EOF
1	Return to Game Library	Game process has exited
2	Return to Master Dashboard	Game process has exited
3	View Recent Logs	Inspect final process stdout & error logs
EOF
)
        fi

        local log_hint
        log_hint=$(inspect_game_log_hint "$log_file" 2>/dev/null || true)

        export GAMECTL_HUD_TITLE="$title"
        export GAMECTL_HUD_PID="$game_pid"
        export GAMECTL_HUD_RUN_TYPE="$run_type"
        export GAMECTL_HUD_COLOR="$status_color"
        export GAMECTL_HUD_BADGE="$status_badge"
        export GAMECTL_HUD_LOG="$log_file"
        export GAMECTL_HUD_HINT="$log_hint"

        local preview_cmd
        preview_cmd='printf "\033[38;5;60m╭─ PROCESS STATUS ────────────────────────────────────╮\033[0m\n  Target Game : \033[1m%s\033[0m\n  Process PID : \033[1m%s\033[0m (%s)\n  Status      : %b%s\033[0m\n  Log File    : %s\n\033[38;5;60m╰─────────────────────────────────────────────────────╯\033[0m\n" "$GAMECTL_HUD_TITLE" "$GAMECTL_HUD_PID" "$GAMECTL_HUD_RUN_TYPE" "$GAMECTL_HUD_COLOR" "$GAMECTL_HUD_BADGE" "$GAMECTL_HUD_LOG"; if [ -n "$GAMECTL_HUD_HINT" ]; then printf "  \033[38;5;214m[HINT]\033[0m %s\n" "$GAMECTL_HUD_HINT"; fi; printf "\033[38;5;60m╭─ RECENT LOG TAIL (Last 15 lines) ──────────────────╮\033[0m\n"; if [ -n "$GAMECTL_HUD_LOG" ] && [ -f "$GAMECTL_HUD_LOG" ]; then tail -n 15 "$GAMECTL_HUD_LOG" 2>/dev/null; else echo "  (No logs recorded)"; fi'

        local hud_sel fzf_rc=0
        hud_sel=$(echo "$hud_palette" | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2 \
            --border-label="  ╢ gamectl :: Process Controller :: $title ╟  " \
            --border-label-pos=2 \
            --header="Enter: Execute │ Esc: Return to Library" \
            --prompt="HUD > " \
            --preview="$preview_cmd" \
            --preview-window=down:55%:border-rounded:wrap \
            --reverse 2>/dev/null) || fzf_rc=$?

        if [ "$fzf_rc" -eq 130 ]; then
            return 0
        fi
        if [ "$fzf_rc" -ne 0 ] && [ "$fzf_rc" -ne 1 ]; then
            echo "[ERROR] Process HUD failed (fzf exit code $fzf_rc)." >&2
            return "$fzf_rc"
        fi
        [ -z "$hud_sel" ] && return 0

        local opt
        opt=$(echo "$hud_sel" | awk -F'\t' '{print $1}')

        case "$opt" in
            1)
                return 0
                ;;
            2)
                return 10
                ;;
            3)
                if [ -s "$log_file" ]; then
                    export GAMECTL_LOG_FILE="$log_file"
                    export GAMECTL_PREVIEW_BIN="$SELF_BIN"
                    local log_fzf_rc=0
                    awk '{printf "%d\t%s\n", NR, $0}' "$log_file" 2>/dev/null | (command -v tac >/dev/null 2>&1 && tac || sed -e '1!G;h;$!d') | fzf \
                        --delimiter=$'\t' \
                        --with-nth=1,2 \
                        --border-label="  ╢ Logs :: $title (PID: $game_pid) ╟  " \
                        --border-label-pos=2 \
                        --header="PROCESS LOGS (Esc / Enter: Return)" \
                        --prompt="Log > " \
                        --preview='"$GAMECTL_PREVIEW_BIN" --preview-process-log "$GAMECTL_LOG_FILE" {1}' \
                        --preview-window=down:35%:border-rounded:wrap \
                        --reverse 2>/dev/null || log_fzf_rc=$?

                    if [ "$log_fzf_rc" -ne 0 ] && [ "$log_fzf_rc" -ne 1 ] && [ "$log_fzf_rc" -ne 130 ]; then
                        echo "[ERROR] Process log viewer failed (fzf exit code $log_fzf_rc)." >&2
                        return "$log_fzf_rc"
                    fi
                else
                    tui_modal_notice "Log Stream" "Log file is currently empty or does not exist:\n$log_file" || return $?
                fi
                ;;
            4)
                local s_unit=""
                [ -f "$info_file" ] && s_unit=$(grep -E '^SCOPE_UNIT=' "$info_file" 2>/dev/null | cut -d'=' -f2- || true)
                log_msg "INFO" "LAUNCH" "Sending SIGTERM to process PID $game_pid ($title)..."
                if [ -n "$s_unit" ]; then
                    systemctl --user stop --no-block "$s_unit.scope" 2>/dev/null || true
                fi
                kill "$game_pid" 2>/dev/null || true
                local wait_cnt=0
                while kill -0 "$game_pid" 2>/dev/null && [ "$wait_cnt" -lt 6 ]; do
                    sleep 0.2
                    wait_cnt=$((wait_cnt + 1))
                done
                if [ -d "$gdir/pfx" ]; then
                    local ws_bin
                    ws_bin="$(get_wineserver_bin "$(find_runner "$gdir" 2>/dev/null || true)" 2>/dev/null || true)"
                    [ -n "$ws_bin" ] && WINEPREFIX="$gdir/pfx" "$ws_bin" -w 2>/dev/null || true # wineserver -w
                fi
                if ! kill -0 "$game_pid" 2>/dev/null; then
                    rm -f "$info_file" 2>/dev/null || true
                    log_msg "INFO" "LAUNCH" "Game '$title' (PID $game_pid) terminated gracefully"
                    tui_modal_notice "Game Stopped" "Game '$title' (PID $game_pid) terminated gracefully." || return $?
                else
                    tui_modal_notice "Process Still Alive" "Process did not respond to SIGTERM. Select 'Force Kill' (Option 5) for immediate teardown." || return $?
                fi
                ;;
            5)
                local s_unit=""
                [ -f "$info_file" ] && s_unit=$(grep -E '^SCOPE_UNIT=' "$info_file" 2>/dev/null | cut -d'=' -f2- || true)
                log_msg "WARN" "LAUNCH" "Sending SIGKILL to process PID $game_pid ($title)..."
                if [ -n "$s_unit" ]; then
                    systemctl --user kill -s SIGKILL "$s_unit.scope" 2>/dev/null || true
                    systemctl --user stop --no-block "$s_unit.scope" 2>/dev/null || true
                fi
                kill -9 "$game_pid" 2>/dev/null || true
                if [ -d "$gdir/pfx" ]; then
                    local ws_bin
                    ws_bin="$(get_wineserver_bin "$(find_runner "$gdir" 2>/dev/null || true)" 2>/dev/null || true)"
                    [ -n "$ws_bin" ] && WINEPREFIX="$gdir/pfx" "$ws_bin" -k 2>/dev/null || true # wineserver -k
                fi
                rm -f "$info_file" 2>/dev/null || true
                log_msg "WARN" "LAUNCH" "Game '$title' (PID $game_pid) force-killed"
                tui_modal_notice "Force Terminated" "Game '$title' (PID $game_pid) force-killed via SIGKILL." || return $?
                ;;
            *)
                return 0
                ;;
        esac
    done
}

# Launch game with performance wrapping and runner isolation
launch_game() {
    local gdir="$1"
    local gbin="$2"
    local title="$3"
    shift 3 || true

    local in_tui="${GAMECTL_IN_ALT_SCREEN:-0}"
    local run_dir
    run_dir="$(get_runtime_dir)"
    mkdir -p -m 700 "$run_dir/active_games" 2>/dev/null || true
    local log_file
    log_file="$(get_game_log_file "$gdir" "${gbin:-game}")"
    : >> "$log_file" 2>/dev/null || true

    _launch_echo() {
        if [ "$in_tui" -eq 1 ]; then
            local clean_text
            clean_text=$(strip_ansi "$*")
            [ -n "${log_file:-}" ] && echo "$clean_text" >> "$log_file" 2>/dev/null || true
            log_msg "INFO" "LAUNCH" "$clean_text"
        else
            echo "$@"
        fi
    }

    _launch_err() {
        if [ "$in_tui" -eq 1 ]; then
            local clean_text
            clean_text=$(strip_ansi "$*")
            [ -n "${log_file:-}" ] && echo "$clean_text" >> "$log_file" 2>/dev/null || true
            log_msg "ERROR" "LAUNCH" "$clean_text"
        else
            echo "$@" >&2
        fi
    }

    _launch_echo "[INFO] Preparing launch: $title..."
    log_msg "INFO" "LAUNCH" "Preparing launch: $title ($gdir/$gbin)"
    load_wrapper_config "$gdir" 1
    if [ "${GAMECTL_CFG_AUTO_LOCATE_SAVES:-0}" = "1" ] && [ -d "$gdir/pfx" ]; then
        if ! collect_prefix_saves "$gdir" true; then
            _launch_err "[WARN] Pre-launch prefix save collection failed for '$title'. Proceeding with launch."
            log_msg "WARN" "LAUNCH" "Pre-launch prefix save collection failed for $title"
        fi
    fi
    if [ -d "$gdir/saves" ] || [ -L "$gdir/saves" ]; then
        if ! backup_save "$gdir" true; then
            _launch_err "[WARN] Pre-launch save snapshot backup failed for '$title'. Proceeding with launch."
            log_msg "WARN" "LAUNCH" "Pre-launch save snapshot backup failed for $title"
        fi
    fi

    # Resolve wrappers and extra flags
    declare -a GAMECTL_WRAPPER_PREFIX=()
    declare -a GAMECTL_REMAINING_ARGS=()
    GAMECTL_ACTIVE_GLTHREAD=0
    build_wrapper_command "$gdir" "$@"
    local wrappers=("${GAMECTL_WRAPPER_PREFIX[@]}")
    local game_args=("${GAMECTL_REMAINING_ARGS[@]}")

    # Resolve Developer Mode & Engine Profiler (default OFF -> zero env pollution)
    resolve_dev_profiler_env "$gdir" 1
    local dev_trace_log=""
    if [ "${GAMECTL_DEV_ACTIVE:-0}" -eq 1 ] && [ -n "${GAMECTL_DEV_TRACE_LOG:-}" ]; then
        dev_trace_log="$GAMECTL_DEV_TRACE_LOG"
        mkdir -p -m 700 "$(dirname "$dev_trace_log")" 2>/dev/null || true
        {
            printf '=== gamectl dev-trace [%s] ===\n' "$(date '+%Y-%m-%d %H:%M:%S')"
            printf 'Title=%s\nDir=%s\nBin=%s\n' "$title" "$gdir" "$gbin"
            printf 'WINEDEBUG=%s (user_override=%s)\n' "${GAMECTL_DEV_RESOLVED_WINEDEBUG:-<unset>}" "${GAMECTL_DEV_RESPECTED_USER_WINEDEBUG:-0}"
            printf 'VK_LOADER_DEBUG=%s (user_override=%s)\n' "${GAMECTL_DEV_RESOLVED_VK_DEBUG:-<unset>}" "${GAMECTL_DEV_RESPECTED_USER_VK_DEBUG:-0}"
            printf 'GBE_LOG=%s\nMainLog=%s\n' "${GAMECTL_DEV_RESOLVED_GBE_LOG:-0}" "$log_file"
        } > "$dev_trace_log" 2>/dev/null || true
        _launch_echo "[INFO] Developer Profiler active. Trace log: $dev_trace_log"
        log_msg "INFO" "LAUNCH" "Developer Profiler active for $title (Trace: $dev_trace_log)"
    fi

    # Set Mesa performance env safely (only enable glthread if explicitly opted in)
    if [ "${GAMECTL_ACTIVE_GLTHREAD:-0}" = "1" ]; then
        export mesa_glthread=true
    else
        unset mesa_glthread
    fi
    export vblank_mode=0

    # Hybrid dGPU PRIME offloading
    if [ "${GAMECTL_ACTIVE_PRIME:-0}" = "1" ]; then
        case "${GAMECTL_ACTIVE_PRIME_VENDOR:-none}" in
            nvidia)
                export __NV_PRIME_RENDER_OFFLOAD=1
                export __GLX_VENDOR_LIBRARY_NAME=nvidia
                export __VK_LAYER_NV_optimus=NVIDIA_only
                _launch_echo "[INFO] Hybrid Graphics: Injected NVIDIA PRIME offload environment."
                ;;
            amd|intel)
                export DRI_PRIME=1
                _launch_echo "[INFO] Hybrid Graphics: Injected DRI_PRIME=1 offload environment."
                ;;
            *)
                export DRI_PRIME=1
                _launch_echo "[INFO] Hybrid Graphics: Fallback to DRI_PRIME=1 offload environment."
                ;;
        esac
    fi

    # Remedi Audio (DEFECT-03): Set buffer latency environment safely (PipeWire / PulseAudio)
    export PIPEWIRE_LATENCY="${GAMECTL_PIPEWIRE_LATENCY:-256/48000}"
    export PULSE_LATENCY_MSEC="${GAMECTL_PULSE_LATENCY:-60}"

    # Sovereign Steam Interceptor: traps and silences unshielded Steam Client calls
    local prev_path="$PATH"
    local interceptor_dir="$(get_runtime_dir)/interceptor"
    setup_steam_interceptor "$interceptor_dir"
    export PATH="$interceptor_dir:$PATH"



    # Capture current CPU scaling governor for clean restoration
    local prev_governor=""
    if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
        prev_governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "")
    fi

    # Attempt CPU scaling governor if permitted and not already in performance mode
    if [ -w /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
        if [ "$prev_governor" != "performance" ]; then
            echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true
        fi
    fi

    # Local state cleanup helper & signal trap (scoped so TUI owner traps are never clobbered)
    local unit_name=""
    local _launch_traps_installed=0
    _disarm_launch_traps() {
        if [ "${_launch_traps_installed:-0}" -eq 1 ]; then
            if [ "${GAMECTL_IN_ALT_SCREEN:-0}" -eq 1 ] && [ "${BASHPID:-$$}" = "${GAMECTL_TUI_OWNER_PID:-}" ] && type install_tui_screen_traps >/dev/null 2>&1; then
                install_tui_screen_traps
            else
                trap - INT TERM EXIT
            fi
            _launch_traps_installed=0
        fi
    }
    _restore_launch_state() {
        _disarm_launch_traps
        if [ -n "${unit_name:-}" ]; then
            systemctl --user stop --no-block "$unit_name.scope" 2>/dev/null || true
        fi
        if [ -n "${prev_governor:-}" ] && [ -w /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
            echo "$prev_governor" | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true
        fi
        if [ "${is_win:-false}" = true ] && [ -n "${gdir:-}" ] && [ -d "$gdir/pfx" ]; then
            # Remediation DEFECT-02: Flush wine prefix writes to disk (wineserver -w)
            local ws_bin
            ws_bin="$(get_wineserver_bin "${runner_bin:-}" 2>/dev/null || true)"
            [ -n "$ws_bin" ] && WINEPREFIX="$gdir/pfx" "$ws_bin" -w 2>/dev/null || true
        fi
        unset __NV_PRIME_RENDER_OFFLOAD __GLX_VENDOR_LIBRARY_NAME __VK_LAYER_NV_optimus DRI_PRIME
        [ -n "${prev_path:-}" ] && export PATH="$prev_path"
        type clean_stale_locks >/dev/null 2>&1 && clean_stale_locks || true
    }
    if [ "${GAMECTL_IN_ALT_SCREEN:-0}" -ne 1 ] || [ "${BASHPID:-$$}" != "${GAMECTL_TUI_OWNER_PID:-}" ]; then
        _launch_traps_installed=1
        trap '_restore_launch_state; trap - INT TERM EXIT; return 130 2>/dev/null || exit 130' INT
        trap '_restore_launch_state; trap - INT TERM EXIT; return 143 2>/dev/null || exit 143' TERM
        trap '_restore_launch_state' EXIT
    fi

    if [ ${#wrappers[@]} -gt 0 ]; then
        _launch_echo "[INFO] Active wrappers: ${wrappers[*]}"
    fi

    cd "$gdir"

    # Pre-flight SteamStub DRM inspection & mitigation
    if [ -f "$gdir/$gbin" ] && detect_steamstub_drm "$gdir/$gbin"; then
        local stub_type
        stub_type=$(detect_steamstub_type "$gdir/$gbin" 2>/dev/null || echo "unknown")
        if [ "$stub_type" = "windows_pe" ]; then
            local unpacked_bin
            unpacked_bin=$(resolve_unpacked_binary "$gdir" "$gbin" 2>/dev/null || true)
            if [ -n "$unpacked_bin" ] && [ -f "$gdir/$unpacked_bin" ]; then
                if [ "$gbin" != "$unpacked_bin" ]; then
                    _launch_echo "  ${UI_GREEN}[SUCCESS] SteamStub PE: Automatically switched to unpacked binary: $unpacked_bin${UI_RST}"
                    gbin="$unpacked_bin"
                fi
            else
                _launch_echo "  ${UI_AMBER}[INFO] SteamStub PE DRM detected on ($gbin). Attempting Steamless unpacking...${UI_RST}"
                if unpack_steamstub_pe "$gdir/$gbin" "${runner_bin:-}" "${pfx_dir:-}"; then
                    unpacked_bin=$(resolve_unpacked_binary "$gdir" "$gbin" 2>/dev/null || true)
                    if [ -n "$unpacked_bin" ] && [ -f "$gdir/$unpacked_bin" ]; then
                        _launch_echo "  ${UI_GREEN}[SUCCESS] SteamStub PE: Unpacked binary generated: $unpacked_bin${UI_RST}"
                        gbin="$unpacked_bin"
                    fi
                else
                    _launch_echo "  ${UI_AMBER}[WARN] SteamStub PE detected on ($gbin) but Steamless CLI not available or unpacking failed.${UI_RST}"
                    _launch_echo "  ${UI_DIM}       If launch fails, unpack $gbin with Steamless (producing ${gbin%.*}.unpacked.exe).${UI_RST}"
                fi
            fi
        elif [ "$stub_type" = "linux_elf" ]; then
            local unpacked_bin
            unpacked_bin=$(resolve_unpacked_binary "$gdir" "$gbin" 2>/dev/null || true)
            if [ -n "$unpacked_bin" ] && [ -f "$gdir/$unpacked_bin" ]; then
                if [ "$gbin" != "$unpacked_bin" ]; then
                    _launch_echo "  ${UI_GREEN}[SUCCESS] SteamStub ELF: Automatically switched to unpacked binary: $unpacked_bin${UI_RST}"
                    gbin="$unpacked_bin"
                fi
            else
                local is_active=true
                if ! is_steamstub_elf_active "$gdir/$gbin"; then
                    is_active=false
                fi
                if [ "$is_active" = false ]; then
                    :
                else
                    _launch_echo "  ${UI_AMBER}[INFO] SteamStub ELF DRM (.bind) detected on ($gbin). Attempting native unpacking...${UI_RST}"
                    if unpack_steamstub_elf "$gdir/$gbin"; then
                        unpacked_bin=$(resolve_unpacked_binary "$gdir" "$gbin" 2>/dev/null || true)
                        if [ -n "$unpacked_bin" ] && [ -f "$gdir/$unpacked_bin" ]; then
                            _launch_echo "  ${UI_GREEN}[SUCCESS] SteamStub ELF: Unpacked binary generated: $unpacked_bin${UI_RST}"
                            gbin="$unpacked_bin"
                        fi
                    else
                        _launch_echo "  ${UI_AMBER}[WARN] Linux ELF SteamStub unpacking failed or unsupported stub variant.${UI_RST}"
                        _launch_echo "  ${UI_CYAN}[INFO] Sovereign steam.sh interceptor active in PATH to trap unsolicited Steam Client calls.${UI_RST}"
                    fi
                fi
            fi
        else
            _launch_echo "  ${UI_AMBER}[WARN] SteamStub DRM markers detected on binary ($gbin).${UI_RST}"
        fi
    fi

    # Pre-flight savegame redirection & offline DLC check
    mkdir -p -m 700 "$gdir/saves" 2>/dev/null || true
    local raw_appid
    raw_appid="$(resolve_game_appid "$gdir")"
    if [ -n "$raw_appid" ] && [ ! -f "$gdir/steam_settings/DLC.txt" ]; then
        fetch_dlc "$gdir" "$raw_appid" 2>/dev/null || true
    fi

    # Pre-flight GBE auto-injection & Sovereign Hard-Stop Guard
    local allow_unshielded="${GAMECTL_ACTIVE_ALLOW_UNSHIELDED:-${GAMECTL_ALLOW_UNSHIELDED:-0}}"
    local has_steam_api=false
    local probe_candidates=()
    while IFS= read -r api_found || [ -n "$api_found" ]; do
        [ -f "$api_found" ] && probe_candidates+=("$api_found")
    done < <(find "$gdir" -maxdepth 4 \
        \( -name "pfx" -o -name ".git" -o -name "saves" -o -name ".save_snapshots" \) -prune \
        -o \( -name "steam_api64.dll" -o -name "steam_api.dll" -o -name "libsteam_api.so" \) -print 2>/dev/null)

    if [ ${#probe_candidates[@]} -gt 0 ]; then
        has_steam_api=true
        local unshielded_candidates=()
        for api_cand in "${probe_candidates[@]}"; do
            if ! is_gbe_library "$api_cand"; then
                unshielded_candidates+=("$api_cand")
            fi
        done

        if [ ${#unshielded_candidates[@]} -gt 0 ]; then
            _launch_echo "  ${UI_AMBER}[INFO] Steamworks API detected without emulator shield. Attempting auto-injection...${UI_RST}"
            inject_game "$gdir" "" --no-sync 2>/dev/null || true

            local still_unshielded=()
            for api_cand in "${unshielded_candidates[@]}"; do
                if ! is_gbe_library "$api_cand"; then
                    still_unshielded+=("$api_cand")
                fi
            done

            if [ ${#still_unshielded[@]} -gt 0 ]; then
                if [ "$allow_unshielded" = "1" ]; then
                    _launch_echo "  ${UI_AMBER}[WARN] Launching unshielded Steamworks binary by user override (--allow-unshielded).${UI_RST}"
                else
                    _launch_err "  ${UI_RED}================================================================${UI_RST}"
                    _launch_err "  ${UI_RED}[HARD-STOP] Valve Steamworks API detected without emulator shield!${UI_RST}"
                    _launch_err "  ${UI_AMBER}Unshielded library: ${still_unshielded[*]}${UI_RST}"
                    _launch_err "  ${UI_AMBER}Launch halted to prevent Valve DRM from spawning Steam Client ('PURCHASE' prompt).${UI_RST}"
                    _launch_err "  ${UI_DIM}Remedy: Run 'gamectl setup-gbe' to provision templates or 'gamectl inject \"$gdir\"'.${UI_RST}"
                    _launch_err "  ${UI_DIM}Bypass: Pass --allow-unshielded to override this sovereign safety gate.${UI_RST}"
                    _launch_err "  ${UI_RED}================================================================${UI_RST}"
                    _restore_launch_state
                    return 1
                fi
            else
                invalidate_scan_cache
                _launch_echo "  ${UI_GREEN}[VERIFIED] GBE Fork emulator shield successfully engaged.${UI_RST}"
            fi
        else
            _launch_echo "  ${UI_GREEN}[VERIFIED] GBE Fork emulator shield confirmed active.${UI_RST}"
        fi
    fi

    # Check if target is a Windows executable (.exe / PE)
    local is_win=false
    case "$gbin" in
        *.exe|*.EXE) is_win=true ;;
    esac
    if [ "$is_win" = false ] && [ -f "$gdir/$gbin" ]; then
        if file -b "$gdir/$gbin" 2>/dev/null | grep -qi -E "PE32|MS Windows"; then
            is_win=true
        fi
    fi

    # Prepare runtime directory and log stream (collision-free SSoT)
    log_file="$(get_game_log_file "$gdir" "$gbin")"
    : >> "$log_file" 2>/dev/null || true

    local game_pid=""
    local run_type="Native Linux"

    local safe_title
    safe_title=$(echo "$title" | tr -cd '[:alnum:]_-')
    [ -z "$safe_title" ] && safe_title="game"

    local use_scope=false
    if [ "${GAMECTL_ACTIVE_SYSTEMD_SCOPE:-0}" = "1" ] && check_systemd_scope_support; then
        use_scope=true
    fi

    local -a sandbox_cmd=()
    if [ "${GAMECTL_ACTIVE_SANDBOX:-0}" = "1" ] && [ ${#GAMECTL_SANDBOX_PREFIX[@]} -gt 0 ]; then
        sandbox_cmd=("${GAMECTL_SANDBOX_PREFIX[@]}")
        _launch_echo "[INFO] Security Sandbox: Bubblewrap rootless filesystem isolation active."
    fi

    _exec_in_scope() {
        local fn
        while IFS= read -r fn; do
            [ -n "$fn" ] && export -fn "$fn" 2>/dev/null || true
        done < <(declare -Fx | awk '{print $NF}')
        local -a final_cmd=()
        [ ${#sandbox_cmd[@]} -gt 0 ] && final_cmd+=("${sandbox_cmd[@]}")
        final_cmd+=("$@")
        if [ "$use_scope" = true ]; then
            exec systemd-run --user --scope --quiet --unit="gamectl-${safe_title}-${BASHPID}" --description="gamectl: ${title}" "${final_cmd[@]}"
        else
            exec "${final_cmd[@]}"
        fi
    }

    if [ "$is_win" = true ]; then
        local detected_overrides
        detected_overrides=$(detect_dll_overrides "$gdir")
        if [ -n "$detected_overrides" ]; then
            export WINEDLLOVERRIDES="$detected_overrides"
            _launch_echo "[INFO] Active DLL Overrides: $WINEDLLOVERRIDES"
        fi

        local runner_bin
        runner_bin=$(find_runner "$gdir" 2>/dev/null || true)
        if [ -z "$runner_bin" ]; then
            _launch_err "[ERROR] Windows runner not found (umu-run, Proton, or Wine not installed)."
            _launch_err "        Install GE-Proton in ~/.local/share/Steam/compatibilitytools.d/ or install wine."
            _restore_launch_state
            return 1
        fi

        local appid
        appid="$(resolve_game_appid "$gdir" "0")"
        prepare_windows_runner_env "$runner_bin" "$gdir" "$appid" "${GAMECTL_RENDERER_MODE:-auto}" "${GAMECTL_ACTIVE_PRIME:-0}"
        local pfx_dir="$GAMECTL_WIN_PFX_DIR"
        mkdir -p "$pfx_dir"

        if [ "$GAMECTL_WIN_RUNNER_KIND" = "umu" ] || [ "$GAMECTL_WIN_RUNNER_KIND" = "proton" ]; then
            if [ "$GAMECTL_WIN_RENDERER" = "wined3d" ]; then
                _launch_echo "[INFO] Graphics Renderer: WineD3D / OpenGL fallback (PROTON_USE_WINED3D=1)."
            else
                _launch_echo "[INFO] Graphics Renderer: DXVK / Vulkan (PROTON_USE_WINED3D=0)."
            fi
        else
            _launch_echo "[INFO] Graphics Renderer: Wine native (WineD3D / OpenGL)."
        fi

        run_type="Windows ($(basename "$runner_bin"))"
        _launch_echo "[INFO] Launching Windows game via $(basename "$runner_bin") in background..."
        _launch_echo "[INFO] Isolated Wine Prefix: $pfx_dir"
        _launch_echo "[INFO] Log stream: $log_file"

        case "$GAMECTL_WIN_RUNNER_KIND" in
            umu)
                (
                    export WINEPREFIX="$GAMECTL_WIN_PFX_DIR" \
                        GAMEID="$GAMECTL_WIN_UMU_GAMEID" \
                        STEAM_COMPAT_APP_ID="$GAMECTL_WIN_APPID" \
                        SteamAppId="$GAMECTL_WIN_APPID" \
                        SteamGameId="$GAMECTL_WIN_APPID" \
                        WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-}" \
                        PROTON_USE_WINED3D="$GAMECTL_WIN_PROTON_WINED3D"
                    [ "$GAMECTL_WIN_DISABLE_PROTONFIXES" = "1" ] && export PROTONFIXES_DISABLE=1
                    [ -n "${GAMECTL_DEV_RESOLVED_WINEDEBUG:-}" ] && export WINEDEBUG="$GAMECTL_DEV_RESOLVED_WINEDEBUG"
                    [ -n "${GAMECTL_DEV_RESOLVED_VK_DEBUG:-}" ] && export VK_LOADER_DEBUG="$GAMECTL_DEV_RESOLVED_VK_DEBUG"
                    [ "${GAMECTL_DEV_RESOLVED_GBE_LOG:-0}" = "1" ] && export GAMECTL_GBE_LOG=1 GBE_LOG_FILE="$dev_trace_log"
                    _exec_in_scope "${wrappers[@]}" "$runner_bin" "$gdir/$gbin" "${game_args[@]}"
                ) > "$log_file" 2>&1 &
                game_pid=$!
                ;;
            proton)
                (
                    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$GAMECTL_WIN_STEAM_ROOT" \
                        STEAM_COMPAT_DATA_PATH="$gdir" \
                        STEAM_COMPAT_APP_ID="$GAMECTL_WIN_APPID" \
                        SteamAppId="$GAMECTL_WIN_APPID" \
                        SteamGameId="$GAMECTL_WIN_APPID" \
                        GAMEID="$GAMECTL_WIN_UMU_GAMEID" \
                        WINEPREFIX="$GAMECTL_WIN_PFX_DIR" \
                        WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-}" \
                        PROTON_USE_WINED3D="$GAMECTL_WIN_PROTON_WINED3D"
                    [ "$GAMECTL_WIN_DISABLE_PROTONFIXES" = "1" ] && export PROTONFIXES_DISABLE=1
                    [ -n "${GAMECTL_DEV_RESOLVED_WINEDEBUG:-}" ] && export WINEDEBUG="$GAMECTL_DEV_RESOLVED_WINEDEBUG"
                    [ -n "${GAMECTL_DEV_RESOLVED_VK_DEBUG:-}" ] && export VK_LOADER_DEBUG="$GAMECTL_DEV_RESOLVED_VK_DEBUG"
                    [ "${GAMECTL_DEV_RESOLVED_GBE_LOG:-0}" = "1" ] && export GAMECTL_GBE_LOG=1 GBE_LOG_FILE="$dev_trace_log"
                    _exec_in_scope "${wrappers[@]}" "$runner_bin" waitforexitandrun "$gdir/$gbin" "${game_args[@]}"
                ) > "$log_file" 2>&1 &
                game_pid=$!
                ;;
            *)
                (
                    export WINEPREFIX="$GAMECTL_WIN_PFX_DIR" \
                        STEAM_COMPAT_APP_ID="$GAMECTL_WIN_APPID" \
                        SteamAppId="$GAMECTL_WIN_APPID" \
                        SteamGameId="$GAMECTL_WIN_APPID" \
                        WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-}"
                    [ -n "${GAMECTL_DEV_RESOLVED_WINEDEBUG:-}" ] && export WINEDEBUG="$GAMECTL_DEV_RESOLVED_WINEDEBUG"
                    [ -n "${GAMECTL_DEV_RESOLVED_VK_DEBUG:-}" ] && export VK_LOADER_DEBUG="$GAMECTL_DEV_RESOLVED_VK_DEBUG"
                    [ "${GAMECTL_DEV_RESOLVED_GBE_LOG:-0}" = "1" ] && export GAMECTL_GBE_LOG=1 GBE_LOG_FILE="$dev_trace_log"
                    _exec_in_scope "${wrappers[@]}" "$runner_bin" "$gdir/$gbin" "${game_args[@]}"
                ) > "$log_file" 2>&1 &
                game_pid=$!
                ;;
        esac
    else
        _launch_echo "[INFO] Launching $title (Native Linux) in background..."
        _launch_echo "[INFO] Log stream: $log_file"
        (
            export LD_LIBRARY_PATH=".:$gdir:${LD_LIBRARY_PATH:-}"
            [ -n "${GAMECTL_DEV_RESOLVED_WINEDEBUG:-}" ] && export WINEDEBUG="$GAMECTL_DEV_RESOLVED_WINEDEBUG"
            [ -n "${GAMECTL_DEV_RESOLVED_VK_DEBUG:-}" ] && export VK_LOADER_DEBUG="$GAMECTL_DEV_RESOLVED_VK_DEBUG"
            [ "${GAMECTL_DEV_RESOLVED_GBE_LOG:-0}" = "1" ] && export GAMECTL_GBE_LOG=1 GBE_LOG_FILE="$dev_trace_log"
            _exec_in_scope "${wrappers[@]}" ./"$gbin" "${game_args[@]}"
        ) > "$log_file" 2>&1 &
        game_pid=$!
    fi

    if [ -z "$game_pid" ] || ! kill -0 "$game_pid" 2>/dev/null; then
        _launch_err "[ERROR] Failed to launch game into background."
        _restore_launch_state
        return 1
    fi

    if [ "$use_scope" = true ]; then
        unit_name="gamectl-${safe_title}-${game_pid}"
    fi

    local info_file="$run_dir/active_games/${game_pid}.info"
    cat <<EOF > "$info_file"
PID=$game_pid
TITLE=$title
DIR=$gdir
BIN=$gbin
LOG=$log_file
START=$(date +%s)
SCOPE_UNIT=$unit_name
EOF

    # Detached background watchdog to restore CPU governor and cleanup when process exits
    _run_launch_watchdog() {
        # This watchdog is a sibling of the game, so shell wait cannot reap it.
        if ! tail --pid="$game_pid" --sleep-interval=0.2 -f /dev/null >/dev/null 2>&1; then
            log_msg "ERROR" "LAUNCH" "Unable to monitor game process $game_pid"
            exit 1
        fi
        if [ -n "$unit_name" ]; then
            systemctl --user stop --no-block "$unit_name.scope" 2>/dev/null || true
        fi
        if [ "$is_win" = true ] && [ -d "$pfx_dir" ]; then
            # Remediation DEFECT-02: Wait for wineserver to flush data & release lockfile before snapshot (wineserver -w)
            local ws_bin
            ws_bin="$(get_wineserver_bin "${runner_bin:-}" 2>/dev/null || true)"
            [ -n "$ws_bin" ] && WINEPREFIX="$pfx_dir" "$ws_bin" -w 2>/dev/null || true
        fi
        rm -f "$info_file" 2>/dev/null || true
        if [ "$is_win" = true ] && [ "${GAMECTL_ACTIVE_AUTO_LOCATE_SAVES:-0}" = "1" ] && [ -d "$gdir/pfx" ]; then
            collect_prefix_saves "$gdir" true || true
        fi
        if [ "${GAMECTL_DEV_ACTIVE:-0}" -eq 1 ] && [ -n "${dev_trace_log:-}" ]; then
            {
                if [ -s "$log_file" ]; then
                    printf '\n--- Runner Output (%s) ---\n' "$log_file"
                    cat "$log_file"
                fi
                if [ "${GAMECTL_DEV_RESOLVED_GBE_LOG:-0}" = "1" ] && [ -s "$gdir/STEAM_LOG.txt" ]; then
                    printf '\n--- GBE STEAM_LOG.txt ---\n'
                    cat "$gdir/STEAM_LOG.txt"
                fi
            } >> "$dev_trace_log" 2>/dev/null || true
        fi
        log_msg "INFO" "LAUNCH" "Game '$title' (PID: $game_pid) exited"
        _restore_launch_state
    }
    if [ "${GAMECTL_IN_ALT_SCREEN:-0}" -eq 1 ] || [ "${GAMECTL_ENGINE_ISOLATED:-0}" -eq 1 ]; then
        ( _run_launch_watchdog ) </dev/null >/dev/null 2>&1 &
    else
        ( _run_launch_watchdog ) </dev/null &
    fi

    _launch_echo "[VERIFIED] Game '$title' running in background (PID: $game_pid)."
    log_msg "INFO" "LAUNCH" "Game '$title' running in background (PID: $game_pid, Log: $log_file)"

    export GAMECTL_LAST_LAUNCH_PID="$game_pid"
    export GAMECTL_LAST_INFO_FILE="$info_file"
    export GAMECTL_LAST_LOG_FILE="$log_file"
    export GAMECTL_LAST_RUN_TYPE="$run_type"

    _disarm_launch_traps
    export PATH="$prev_path"
    return 0
}

# CLI helper for launching games with wrappers and options
cli_launch() {
    local l_dir="${1:-}"
    shift || true

    # Auto-resolve numeric AppID to installed game directory
    if [[ "$l_dir" =~ ^[0-9]+$ ]] && [ ! -d "$l_dir" ]; then
        local resolved_dir
        resolved_dir=$(scan_installed_games 2>/dev/null | awk -F'\t' -v aid="$l_dir" '$1 == aid {print $4}' | head -n 1)
        if [ -n "$resolved_dir" ] && [ -d "$resolved_dir" ]; then
            l_dir="$resolved_dir"
        fi
    fi

    local l_bin=""
    local l_title=""
    local l_flags=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --hud|--mangohud|--no-hud|--no-mangohud|--gamemode|--no-gamemode|--gamescope|--no-gamescope|--fsr|--no-fsr|--glthread|--no-glthread|--scope|--systemd-scope|--no-scope|--no-systemd-scope|--prime|--no-prime|--sandbox|--no-sandbox)
                l_flags+=("$1")
                shift
                ;;
            *)
                if [ -z "$l_bin" ]; then
                    l_bin="$1"
                elif [ -z "$l_title" ]; then
                    l_title="$1"
                else
                    l_flags+=("$1")
                fi
                shift
                ;;
        esac
    done

    [ -z "$l_title" ] && l_title="$(basename "$l_dir")"
    if [ -z "$l_bin" ]; then
        l_bin=$(find_game_binary "$l_dir" 2>/dev/null || echo "")
    fi

    if [ -n "$l_bin" ]; then
        local l_rc=0
        launch_game "$l_dir" "$l_bin" "$l_title" "${l_flags[@]}" || l_rc=$?
        if [ "$l_rc" -eq 0 ] && [ -t 0 ] && [ -t 1 ] && [ "${GAMECTL_IN_ALT_SCREEN:-0}" -eq 0 ]; then
            local gpid="${GAMECTL_LAST_LAUNCH_PID:-}"
            local inf="${GAMECTL_LAST_INFO_FILE:-}"
            local lfile="${GAMECTL_LAST_LOG_FILE:-}"
            local rtype="${GAMECTL_LAST_RUN_TYPE:-Native Linux}"
            if [ -n "$gpid" ] && [ -f "$inf" ] && kill -0 "$gpid" 2>/dev/null; then
                game_controller_hud "$gpid" "$l_title" "$lfile" "$l_dir" "$l_bin" "$inf" "$rtype" || true
            fi
        fi
        return "$l_rc"
    else
        echo "[ERROR] Executable binary not found in: $l_dir" >&2
        return 1
    fi
}


# Standalone-source compatibility: load split launcher submodules when sourced directly outside bin/gamectl
if [ -z "${GAMECTL_BUNDLED:-}" ] && [ -n "${BASH_SOURCE[0]:-}" ]; then
    _launcher_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    for _launcher_sub in 51_remote_sync.sh 52_inject_runtime.sh; do
        if [ -f "$_launcher_dir/$_launcher_sub" ]; then
            # shellcheck source=/dev/null
            source "$_launcher_dir/$_launcher_sub"
        fi
    done
    unset _launcher_dir _launcher_sub
fi

# --- [MODULE] src/runners/51_remote_sync.sh ---
# Probe SSH remote $HOME with honest error classification on stderr
probe_ssh_remote_home() {
    local ssh_host="$1"
    local ssh_timeout="${GAMECTL_SSH_TIMEOUT:-5}"
    [[ "$ssh_timeout" =~ ^[1-9][0-9]*$ ]] || ssh_timeout=5

    local run_dir ssh_err_file
    run_dir="$(get_runtime_dir)"
    ssh_err_file=$(mktemp "$run_dir/ssh_probe_${$}.XXXXXX") || return 1

    local remote_home="" rc=0
    remote_home=$(ssh -o LogLevel=ERROR -o ConnectTimeout="$ssh_timeout" -o BatchMode=yes "$ssh_host" 'printf %s "$HOME"' 2>"$ssh_err_file") || rc=$?

    local ssh_err=""
    if [ -s "$ssh_err_file" ]; then
        ssh_err=$(tr -d '\r' < "$ssh_err_file" | grep -v '^[[:space:]]*$' | head -n 4 || true)
    fi
    rm -f "$ssh_err_file" 2>/dev/null || true

    if [ "$rc" -eq 0 ] && [ -n "$remote_home" ] && [[ "$remote_home" != *$'\n'* && "$remote_home" != *$'\r'* ]]; then
        printf '%s\n' "$remote_home"
        return 0
    fi

    if printf '%s\n' "$ssh_err" | grep -qiE 'Permission denied|publickey|Authentication failed|passphrase'; then
        echo "[ERROR] SSH authentication failed for '$ssh_host':" >&2
        printf '%s\n' "$ssh_err" >&2
        echo "Hint: Load your SSH key into ssh-agent first (e.g. ssh-add ~/.ssh/<key>)." >&2
    elif printf '%s\n' "$ssh_err" | grep -qiE 'Host key verification failed|REMOTE HOST IDENTIFICATION'; then
        echo "[ERROR] SSH host key verification failed for '$ssh_host':" >&2
        printf '%s\n' "$ssh_err" >&2
        echo "Hint: Verify host fingerprint once interactively via: ssh $ssh_host" >&2
    elif printf '%s\n' "$ssh_err" | grep -qiE 'Could not resolve hostname|Name or service not known'; then
        echo "[ERROR] SSH hostname '$ssh_host' could not be resolved:" >&2
        printf '%s\n' "$ssh_err" >&2
    else
        echo "[WARN] Remote host '$ssh_host' offline or unreachable (timeout ${ssh_timeout}s)." >&2
        if [ -n "$ssh_err" ]; then
            echo "SSH detail: $ssh_err" >&2
        fi
    fi
    return 1
}

# Resolve target SSH base directory (default mirror or custom prefix isolated per game folder)
resolve_ssh_remote_base() {
    local remote_home="${1%/}"
    local rel_path="$2"
    local custom_base="$3"
    local game_leaf="$4"

    if [ -z "$custom_base" ]; then
        printf '%s/%s\n' "$remote_home" "$rel_path"
        return 0
    fi

    local resolved=""
    if [ "$custom_base" = "~" ]; then
        resolved="$remote_home"
    elif [[ "$custom_base" == "~/"* ]]; then
        local sub="${custom_base#\~/}"
        while [[ "$sub" == */ ]]; do sub="${sub%/}"; done
        if [ -n "$sub" ]; then
            resolved="${remote_home}/${sub}"
        else
            resolved="$remote_home"
        fi
    elif [[ "$custom_base" == /* ]]; then
        resolved="$custom_base"
        while [[ "$resolved" == */ && "$resolved" != "/" ]]; do resolved="${resolved%/}"; done
    else
        local rel_sub="$custom_base"
        while [[ "$rel_sub" == */ ]]; do rel_sub="${rel_sub%/}"; done
        if [ -n "$rel_sub" ]; then
            resolved="${remote_home}/${rel_sub}"
        else
            resolved="$remote_home"
        fi
    fi

    if [ "$resolved" = "/" ]; then
        printf '/%s\n' "$game_leaf"
    else
        printf '%s/%s\n' "$resolved" "$game_leaf"
    fi
}

# Resolve target rclone saves path (isolated per game folder)
resolve_rclone_remote_saves() {
    local endpoint="$1"
    local custom_base="$2"
    local game_leaf="$3"

    if [ -z "$custom_base" ]; then
        printf '%sgamectl-saves/%s/saves\n' "$endpoint" "$game_leaf"
    else
        printf '%s%s/%s/saves\n' "$endpoint" "$custom_base" "$game_leaf"
    fi
}

# Sync savegame to remote host or rclone cloud remote (Push)
sync_save_remote() {
    local is_dry_run=false
    local is_force=false
    local -a pos=()
    local arg

    for arg in "$@"; do
        case "$arg" in
            --dry-run|-n) is_dry_run=true ;;
            --force|-f) is_force=true ;;
            *) pos+=("$arg") ;;
        esac
    done

    local gdir="${pos[0]:-}"
    local title="${pos[1]:-Game}"
    local override_host="${pos[2]:-}"

    local sdir="$gdir/saves"
    local rhost="$override_host"
    [ -z "$rhost" ] && rhost=$(get_remote_host)

    if [ -z "$gdir" ] || [ ! -d "$sdir" ]; then
        echo "[ERROR] Portable saves directory not found in ${gdir:-<empty>}" >&2
        return 1
    fi

    if [ "$is_dry_run" = false ] && [ "$is_force" = false ]; then
        local active_pid=""
        if active_pid=$(is_game_active_for_dir "$gdir" 2>/dev/null); then
            echo "[ERROR] Cannot sync saves while game process is active (PID: $active_pid). Close the game first or pass --force." >&2
            return 1
        fi
    fi

    parse_remote_sync_target "$rhost" || return 1

    local canon_gdir game_leaf
    canon_gdir="$(cd "$gdir" 2>/dev/null && pwd || echo "$gdir")"
    game_leaf="$(basename "$canon_gdir")"
    if [ -z "$game_leaf" ] || [ "$game_leaf" = "." ] || [ "$game_leaf" = ".." ] || [ "$game_leaf" = "/" ]; then
        echo "[ERROR] Invalid game directory name for remote sync: $canon_gdir" >&2
        return 1
    fi

    local rel_path
    if [[ "$canon_gdir" == "$HOME/"* ]]; then
        rel_path="${canon_gdir#$HOME/}"
    else
        # For games stored on secondary drives (/mnt, /media, /data, etc.)
        rel_path="Games/$(basename "$canon_gdir")"
    fi
    rel_path="${rel_path#/}"

    if [ -z "$rel_path" ] || [[ "$rel_path" == *$'\n'* || "$rel_path" == *$'\r'* ]] || \
       [[ "$rel_path" == ".." || "$rel_path" == "../"* || "$rel_path" == *"/.." || "$rel_path" == *"/../"* ]]; then
        echo "[ERROR] Invalid relative remote sync path: $rel_path" >&2
        return 1
    fi

    local ssh_timeout="${GAMECTL_SSH_TIMEOUT:-5}"
    [[ "$ssh_timeout" =~ ^[1-9][0-9]*$ ]] || ssh_timeout=5

    if [ "$REMOTE_TARGET_BACKEND" = "rclone" ]; then
        local rclone_saves run_dir rc_out rc=0
        rclone_saves=$(resolve_rclone_remote_saves "$REMOTE_TARGET_ENDPOINT" "$REMOTE_TARGET_BASE" "$game_leaf")
        run_dir="$(get_runtime_dir)"
        rc_out=$(mktemp "$run_dir/rclone_push_${$}.XXXXXX") || return 1

        local -a rclone_opts=(
            "--exclude" "*.tmp"
            "--contimeout" "${ssh_timeout}s"
            "--timeout" "30s"
            "--retries" "2"
            "--low-level-retries" "3"
            "--stats-one-line"
        )
        [ "$is_dry_run" = true ] && rclone_opts+=("--dry-run")

        echo "[INFO] Synchronizing savegame $title to $rclone_saves..."
        rclone copy "${rclone_opts[@]}" -- "$sdir" "$rclone_saves" >"$rc_out" 2>&1 || rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "[ERROR] Savegame synchronization via rclone ($rclone_saves) failed (exit $rc)." >&2
            [ -s "$rc_out" ] && tail -n 8 "$rc_out" >&2
            rm -f "$rc_out" 2>/dev/null || true
            return 1
        fi
        [ -s "$rc_out" ] && cat "$rc_out"
        rm -f "$rc_out" 2>/dev/null || true

        if [ "$is_dry_run" = true ]; then
            echo "[INFO] [DRY-RUN] Savegame synchronization via rclone simulated successfully."
        else
            echo "[VERIFIED] Savegame synchronization to $rclone_saves completed."
        fi
        return 0
    fi

    local ssh_host="$REMOTE_TARGET_ENDPOINT"
    echo "[INFO] Checking connectivity to $ssh_host..."
    local remote_home
    remote_home=$(probe_ssh_remote_home "$ssh_host") || return 1

    local remote_base remote_saves q_base
    remote_base=$(resolve_ssh_remote_base "$remote_home" "$rel_path" "$REMOTE_TARGET_BASE" "$game_leaf")
    remote_saves="${remote_base}/saves"
    q_base="'${remote_base//\'/\'\\\'\'}'"

    echo "[INFO] Synchronizing savegame $title to ${ssh_host}:${remote_saves}..."
    local -a ssh_opts=(-o LogLevel=ERROR -o ConnectTimeout="$ssh_timeout" -o BatchMode=yes)
    local rsync_ssh="ssh -o LogLevel=ERROR -o ConnectTimeout=${ssh_timeout} -o BatchMode=yes"
    local -a rsync_opts=("-avzP" "--exclude=*.tmp")
    [ "$is_dry_run" = true ] && rsync_opts+=("-n")

    if [ "$is_dry_run" = false ]; then
        if ! ssh "${ssh_opts[@]}" "$ssh_host" "mkdir -p -- $q_base"; then
            echo "[ERROR] Failed to prepare remote save directory on $ssh_host ($remote_base)." >&2
            return 1
        fi
    fi

    if ! rsync -s -e "$rsync_ssh" "${rsync_opts[@]}" "$sdir/" "${ssh_host}:${remote_saves}/"; then
        echo "[ERROR] Savegame synchronization to ${ssh_host}:${remote_saves} failed." >&2
        return 1
    fi

    if [ "$is_dry_run" = true ]; then
        echo "[INFO] [DRY-RUN] Savegame synchronization simulated successfully."
    else
        echo "[VERIFIED] Savegame synchronization to ${ssh_host}:${remote_saves} completed."
    fi
    return 0
}

# Pull savegame from remote companion host or rclone cloud remote to local workstation (Pull)
pull_save_remote() {
    local is_dry_run=false
    local -a pos=()
    local arg

    for arg in "$@"; do
        case "$arg" in
            --dry-run|-n) is_dry_run=true ;;
            *) pos+=("$arg") ;;
        esac
    done

    local gdir="${pos[0]:-}"
    local title="${pos[1]:-Game}"
    local override_host="${pos[2]:-}"

    local sdir="$gdir/saves"
    local rhost="$override_host"
    [ -z "$rhost" ] && rhost=$(get_remote_host)

    if [ -z "$gdir" ] || [ ! -d "$gdir" ]; then
        echo "[ERROR] Target game directory not found: ${gdir:-<empty>}" >&2
        return 1
    fi

    if [ "$is_dry_run" = false ]; then
        local active_pid=""
        if active_pid=$(is_game_active_for_dir "$gdir" 2>/dev/null); then
            echo "[ERROR] Cannot pull saves while game process is active (PID: $active_pid). Close the game first." >&2
            return 1
        fi
    fi

    parse_remote_sync_target "$rhost" || return 1

    local canon_gdir game_leaf
    canon_gdir="$(cd "$gdir" 2>/dev/null && pwd || echo "$gdir")"
    game_leaf="$(basename "$canon_gdir")"
    if [ -z "$game_leaf" ] || [ "$game_leaf" = "." ] || [ "$game_leaf" = ".." ] || [ "$game_leaf" = "/" ]; then
        echo "[ERROR] Invalid game directory name for remote pull: $canon_gdir" >&2
        return 1
    fi

    local rel_path
    if [[ "$canon_gdir" == "$HOME/"* ]]; then
        rel_path="${canon_gdir#$HOME/}"
    else
        rel_path="Games/$(basename "$canon_gdir")"
    fi
    rel_path="${rel_path#/}"

    if [ -z "$rel_path" ] || [[ "$rel_path" == *$'\n'* || "$rel_path" == *$'\r'* ]] || \
       [[ "$rel_path" == ".." || "$rel_path" == "../"* || "$rel_path" == *"/.." || "$rel_path" == *"/../"* ]]; then
        echo "[ERROR] Invalid relative remote sync path: $rel_path" >&2
        return 1
    fi

    local ssh_timeout="${GAMECTL_SSH_TIMEOUT:-5}"
    [[ "$ssh_timeout" =~ ^[1-9][0-9]*$ ]] || ssh_timeout=5

    if [ "$REMOTE_TARGET_BACKEND" = "rclone" ]; then
        local rclone_saves run_dir rc_out rc=0
        rclone_saves=$(resolve_rclone_remote_saves "$REMOTE_TARGET_ENDPOINT" "$REMOTE_TARGET_BASE" "$game_leaf")
        run_dir="$(get_runtime_dir)"
        rc_out=$(mktemp "$run_dir/rclone_pull_${$}.XXXXXX") || return 1

        if ! rclone lsf --max-depth 1 --contimeout "${ssh_timeout}s" --timeout 30s --retries 2 -- "$rclone_saves" >"$rc_out" 2>&1; then
            echo "[ERROR] Remote saves directory not found or inaccessible on $rclone_saves:" >&2
            [ -s "$rc_out" ] && tail -n 6 "$rc_out" >&2
            rm -f "$rc_out" 2>/dev/null || true
            return 1
        fi

        if [ "$is_dry_run" = false ] && { [ -d "$sdir" ] || [ -L "$sdir" ]; }; then
            if ! backup_save "$gdir" true; then
                echo "[ERROR] Pre-pull local save backup failed. Aborting pull to prevent unrecoverable save overwrite." >&2
                log_msg "ERROR" "SAVE" "Pre-pull local save backup failed for '$title'"
                rm -f "$rc_out" 2>/dev/null || true
                return 1
            fi
        fi

        if [ "$is_dry_run" = false ]; then
            if ! mkdir -p "$sdir"; then
                rm -f "$rc_out" 2>/dev/null || true
                return 1
            fi
        fi

        local -a rclone_opts=(
            "--exclude" "*.tmp"
            "--contimeout" "${ssh_timeout}s"
            "--timeout" "30s"
            "--retries" "2"
            "--low-level-retries" "3"
            "--stats-one-line"
        )
        [ "$is_dry_run" = true ] && rclone_opts+=("--dry-run")

        echo "[INFO] Pulling savegame for '$title' from $rclone_saves -> $sdir/..."
        : > "$rc_out"
        rclone copy "${rclone_opts[@]}" -- "$rclone_saves" "$sdir" >"$rc_out" 2>&1 || rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "[ERROR] Savegame pull via rclone ($rclone_saves) failed (exit $rc)." >&2
            [ -s "$rc_out" ] && tail -n 8 "$rc_out" >&2
            rm -f "$rc_out" 2>/dev/null || true
            return 1
        fi
        [ -s "$rc_out" ] && cat "$rc_out"
        rm -f "$rc_out" 2>/dev/null || true

        if [ "$is_dry_run" = true ]; then
            echo "[INFO] [DRY-RUN] Remote savegame pull via rclone simulated successfully (no local files modified)."
        else
            echo "[VERIFIED] Savegame pull from $rclone_saves completed."
            log_msg "INFO" "SAVE" "Pulled savegame for '$title' from $rclone_saves"
        fi
        return 0
    fi

    local ssh_host="$REMOTE_TARGET_ENDPOINT"
    echo "[INFO] Checking connectivity to $ssh_host..."
    local remote_home
    remote_home=$(probe_ssh_remote_home "$ssh_host") || return 1

    local remote_base remote_saves q_saves
    remote_base=$(resolve_ssh_remote_base "$remote_home" "$rel_path" "$REMOTE_TARGET_BASE" "$game_leaf")
    remote_saves="${remote_base}/saves"
    q_saves="'${remote_saves//\'/\'\\\'\'}'"

    local -a ssh_opts=(-o LogLevel=ERROR -o ConnectTimeout="$ssh_timeout" -o BatchMode=yes)
    # Verify remote saves directory exists
    if ! ssh "${ssh_opts[@]}" "$ssh_host" "test -d $q_saves"; then
        echo "[ERROR] Remote saves directory not found on $ssh_host: $remote_saves" >&2
        return 1
    fi

    # Protect local savegame before pulling remote overwrites
    if [ "$is_dry_run" = false ] && { [ -d "$sdir" ] || [ -L "$sdir" ]; }; then
        if ! backup_save "$gdir" true; then
            echo "[ERROR] Pre-pull local save backup failed. Aborting pull to prevent unrecoverable save overwrite." >&2
            log_msg "ERROR" "SAVE" "Pre-pull local save backup failed for '$title'"
            return 1
        fi
    fi

    if [ "$is_dry_run" = false ]; then
        mkdir -p "$sdir" || return 1
    fi

    local rsync_ssh="ssh -o LogLevel=ERROR -o ConnectTimeout=${ssh_timeout} -o BatchMode=yes"
    local -a rsync_opts=("-avzP" "--exclude=*.tmp")
    [ "$is_dry_run" = true ] && rsync_opts+=("-n")

    echo "[INFO] Pulling savegame for '$title' from ${ssh_host}:${remote_saves}/ -> $sdir/..."
    if ! rsync -s -e "$rsync_ssh" "${rsync_opts[@]}" "${ssh_host}:${remote_saves}/" "$sdir/"; then
        echo "[ERROR] Savegame pull from ${ssh_host}:${remote_saves} failed." >&2
        return 1
    fi

    if [ "$is_dry_run" = true ]; then
        echo "[INFO] [DRY-RUN] Remote savegame pull simulated successfully (no local files modified)."
    else
        echo "[VERIFIED] Savegame pull from ${ssh_host}:${remote_saves} completed."
        log_msg "INFO" "SAVE" "Pulled savegame for '$title' from ${ssh_host}:${remote_saves}"
    fi
    return 0
}

# Aliases for remote savegame synchronization
sync_to_companion() {
    sync_save_remote "$@"
}

sync_to_tuf() {
    sync_save_remote "$@"
}

pull_from_companion() {
    pull_save_remote "$@"
}

pull_from_tuf() {
    pull_save_remote "$@"
}

# --- [MODULE] src/runners/52_inject_runtime.sh ---
# Setup local P2P compatibility and mod DLL overrides without Steam registration.
setup_onlinefix() {
    local gdir="${1:-}"
    shift || true
    local auto_yes=false
    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes|--non-interactive) auto_yes=true; shift ;;
            *) shift ;;
        esac
    done

    if [ -z "$gdir" ] || [ ! -d "$gdir" ]; then
        echo "[ERROR] Game directory not found: $gdir" >&2
        return 1
    fi
    gdir="$(cd "$gdir" && pwd)"

    echo "[INFO] Running local OnlineFix compatibility setup in: $gdir..."

    # 1. Discover OnlineFix signature files
    local of_files
    of_files=$(find "$gdir" -maxdepth 3 \( -name "pfx" -o -name ".git" -o -name ".save_snapshots" -o -name "saves" \) -prune -o \( \
        -iname "OnlineFix64.dll" -o -iname "OnlineFix.dll" -o -iname "OnlineFix.ini" -o \
        -iname "dnet.dll" -o -iname "SteamOverlay64.dll" \
    \) -print 2>/dev/null || true)

    if [ -z "$of_files" ]; then
        echo "[WARN] No OnlineFix signatures found in this game directory." >&2
        echo "       Neither OnlineFix64.dll, OnlineFix.dll, nor OnlineFix.ini was found." >&2
        return 1
    fi
    echo "[VERIFIED] OnlineFix signature detected."

    # Steam registration remains available through the explicit sync-steam command.
    # 2. Audit & Sync OnlineFix.ini PlayerName
    local ini_file
    ini_file=$(find "$gdir" -maxdepth 3 \( -name "pfx" -o -name ".git" \) -prune -o -iname "OnlineFix.ini" -print 2>/dev/null | head -n 1)
    if [ -n "$ini_file" ] && [ -f "$ini_file" ]; then
        local curr_pname
        curr_pname=$(grep -E '^[[:space:]]*PlayerName[[:space:]]*=' "$ini_file" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*PlayerName[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        echo "[INFO] OnlineFix.ini detected: $ini_file"
        echo "       Current PlayerName: ${curr_pname:-[Unset]}"

        local persona_name=""
        if [ -f "$HOME/.config/gamectl/persona" ]; then
            persona_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        fi
        [ -z "$persona_name" ] && persona_name="${USER:-Player}"

        if [ -n "$persona_name" ] && [ "$persona_name" != "$curr_pname" ]; then
            local should_sync=false
            if [ "$auto_yes" = true ]; then
                should_sync=true
            elif [ -t 0 ]; then
                echo -n "       Synchronize PlayerName to '$persona_name'? [Y/n] (Auto-yes in 5s): "
                local confirm_sync=""
                read -t 5 -r confirm_sync || confirm_sync="y"
                echo
                if [[ ! "$confirm_sync" =~ ^[nN] ]]; then
                    should_sync=true
                fi
            else
                should_sync=true
            fi

            if [ "$should_sync" = true ]; then
                if atomic_set_kv_file "$ini_file" "PlayerName" "$persona_name" " = "; then
                    echo "       ${UI_GREEN}[SUCCESS] PlayerName in OnlineFix.ini synchronized to: $persona_name${UI_RST}"
                else
                    echo "[ERROR] Failed to update PlayerName in $ini_file" >&2
                    return 1
                fi
            fi
        fi
    fi

    echo "[VERIFIED] OnlineFix setup completed for: $(basename "$gdir")"
    return 0
}

# Inject GBE Fork emulator and portable saves into a game folder
inject_game() {
    local target_dir="$1"
    local appid="${2:-}"
    local sync_mode="${3:---no-sync}"

    # Strip ANSI escape sequences
    target_dir=$(strip_ansi "$target_dir")
    [ -n "$appid" ] && appid=$(strip_ansi "$appid" | tr -dc '0-9')

    if [ ! -d "$target_dir" ]; then
        echo "[ERROR] Target directory not found: $target_dir" >&2
        return 1
    fi

    # Canonical path
    target_dir="$(cd "$target_dir" && pwd)"

    # Resolve AppID if not provided
    if [ -z "$appid" ]; then
        appid="$(resolve_game_appid "$target_dir")"
        if [ -z "$appid" ]; then
            local parent_dir
            parent_dir="$(dirname "$target_dir")"
            if [ "$(basename "$parent_dir")" = "common" ]; then
                local steamapps_dir
                steamapps_dir="$(dirname "$parent_dir")"
                local base_name
                base_name="$(basename "$target_dir")"
                for acf in "$steamapps_dir"/appmanifest_*.acf; do
                    [ -f "$acf" ] || continue
                    if grep -q "\"installdir\"[[:space:]]\+\"$base_name\"" "$acf" 2>/dev/null; then
                        appid=$(grep -E '^\s*"appid"' "$acf" | head -n 1 | sed -E 's/.*"appid"[[:space:]]+"([0-9]+)".*/\1/')
                        break
                    fi
                done
            fi
        fi
    fi

    echo "[INFO] Preparing GBE Fork injection in: $target_dir..."

    # 1. Identify Target Executable and Platform
    local gbin=""
    gbin=$(find_game_binary "$target_dir") || true

    local target_platform="linux"
    local arch="x64"
    local is_32bit=false

    # Check existing steam libraries in target folder
    local found_win64 found_win32 found_linux
    local api_targets=() api_file
    while IFS= read -r -d '' api_file; do
        [ -f "$api_file" ] && api_targets+=("$api_file")
    done < <(find "$target_dir" -maxdepth 4 \
        \( -name pfx -o -name .git -o -name saves -o -name .save_snapshots \) -prune \
        -o \( -name steam_api64.dll -o -name steam_api.dll -o -name libsteam_api.so \) -print0 2>/dev/null)
    found_win64="" found_win32="" found_linux=""
    for api_file in "${api_targets[@]}"; do
        case "${api_file##*/}" in
            steam_api64.dll) found_win64="${found_win64:-$api_file}" ;;
            steam_api.dll) found_win32="${found_win32:-$api_file}" ;;
            libsteam_api.so) found_linux="${found_linux:-$api_file}" ;;
        esac
    done

    if [ -n "$gbin" ] && [ -f "$target_dir/$gbin" ]; then
        local btype
        btype=$(file -b "$target_dir/$gbin" 2>/dev/null || echo "")
        if echo "$btype" | grep -qi -E "PE32|MS Windows|\.exe"; then
            target_platform="windows"
            if echo "$btype" | grep -qi "PE32+"; then
                arch="x64"
                is_32bit=false
            elif echo "$btype" | grep -qi "32-bit"; then
                arch="x86"
                is_32bit=true
            else
                arch="x64"
                is_32bit=false
            fi
        else
            target_platform="linux"
            if echo "$btype" | grep -qi "32-bit"; then
                arch="x86"
                is_32bit=true
            else
                arch="x64"
                is_32bit=false
            fi
        fi
    elif [ -n "$found_linux" ]; then
        target_platform="linux"
        if file -Lb "$found_linux" | grep -qi "32-bit"; then
            arch="x86"
            is_32bit=true
        else
            arch="x64"
            is_32bit=false
        fi
    elif [ -n "$found_win64" ] || [ -n "$found_win32" ]; then
        target_platform="windows"
        if [ -n "$found_win64" ]; then
            arch="x64"
            is_32bit=false
        else
            arch="x86"
            is_32bit=true
        fi
    fi

    # 2. Perform Shim Injections (with backup of originals)
    local shim_dirs=("$target_dir")

    # 2a. Windows Shim Injection (if windows steam files exist or target is windows)
    if [ -n "$found_win64" ] || [ -n "$found_win32" ] || [ "$target_platform" = "windows" ]; then
        local win_targets=()
        for api_file in "${api_targets[@]}"; do
            case "${api_file##*/}" in
                steam_api64.dll|steam_api.dll) win_targets+=("$api_file") ;;
            esac
        done

        # If neither found but target is windows, determine destination based on detected arch or gbin location
        if [ ${#win_targets[@]} -eq 0 ] && [ "$target_platform" = "windows" ]; then
            local bin_subdir="$target_dir"
            [ -n "$gbin" ] && [ -f "$target_dir/$gbin" ] && bin_subdir="$(dirname "$target_dir/$gbin")"
            if [ "$is_32bit" = true ]; then
                win_targets+=("$bin_subdir/steam_api.dll")
            else
                win_targets+=("$bin_subdir/steam_api64.dll")
            fi
        fi

        for entry in "${win_targets[@]}"; do
            local t_dll="$entry" t_arch=x64
            [ "${t_dll##*/}" = steam_api.dll ] && t_arch=x86
            local t_template
            t_template=$(get_gbe_template "windows" "$t_arch") || true

            if [ -z "$t_template" ] || [ ! -f "$t_template" ]; then
                echo "[WARN] Windows GBE Fork template ($t_arch) not found. Attempting automatic provisioning..." >&2
                setup_gbe_templates --yes --win-only >/dev/null 2>&1 || true
                t_template=$(get_gbe_template "windows" "$t_arch") || true
                if [ -z "$t_template" ] || [ ! -f "$t_template" ]; then
                    echo "[ERROR] Windows GBE Fork template ($t_arch) not found. Run 'gamectl setup-gbe' to install." >&2
                    return 1
                fi
            fi

            install_gbe_library "$t_template" "$t_dll" || return 1
            shim_dirs+=("$(dirname "$t_dll")")
            echo "[INFO] Windows GBE Fork DLL ($t_arch) installed at: $t_dll"
        done
    fi

    # 2b. Linux Shim Injection (if linux steam files exist or target is linux)
    if [ -n "$found_linux" ] || [ "$target_platform" = "linux" ]; then
        local linux_arch="x64"
        if [ -n "$found_linux" ]; then
            if file -Lb "$found_linux" | grep -qi "32-bit"; then
                linux_arch="x86"
            fi
        elif [ "$is_32bit" = true ]; then
            linux_arch="x86"
        fi

        local target_so="$target_dir/libsteam_api.so"
        if [ -n "$found_linux" ]; then
            target_so="$found_linux"
        elif [ -d "$target_dir/lib64" ] && [ "$linux_arch" = "x64" ]; then
            target_so="$target_dir/lib64/libsteam_api.so"
        elif [ -d "$target_dir/lib32" ] && [ "$linux_arch" = "x86" ]; then
            target_so="$target_dir/lib32/libsteam_api.so"
        fi

        local linux_targets=()
        for api_file in "${api_targets[@]}"; do
            [ "${api_file##*/}" = libsteam_api.so ] && linux_targets+=("$api_file")
        done
        [ ${#linux_targets[@]} -gt 0 ] || linux_targets+=("$target_so")
        for target_so in "${linux_targets[@]}"; do
            if [ -f "$target_so" ]; then
                linux_arch=x64
                if file -Lb "$target_so" | grep -qi '32-bit'; then linux_arch=x86; fi
            fi
            local src_so
            src_so=$(get_gbe_template "linux" "$linux_arch") || true
            if [ -z "$src_so" ] || [ ! -f "$src_so" ]; then
                echo "[WARN] Linux GBE Fork template ($linux_arch) not found. Attempting automatic provisioning..." >&2
                setup_gbe_templates --yes --linux-only >/dev/null 2>&1 || true
                src_so=$(get_gbe_template "linux" "$linux_arch") || true
            fi
            if [ -z "$src_so" ] || [ ! -f "$src_so" ]; then
                echo "[ERROR] Linux GBE Fork template ($linux_arch) not found at: ${src_so:-empty}" >&2
                return 1
            fi
            install_gbe_library "$src_so" "$target_so" || return 1
            shim_dirs+=("$(dirname "$target_so")")
            echo "[INFO] Linux GBE Fork ELF ($linux_arch) installed at: $target_so"
        done
    fi

    # 3. Setup steam_settings and configs.user.ini
    mkdir -p "$target_dir/steam_settings" || return 1
    local user_name=""
    local steamid=""

    # Check existing game persona or global persona
    if [ -f "$target_dir/steam_settings/configs.user.ini" ]; then
        user_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$target_dir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        steamid=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$target_dir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    if [ -z "$user_name" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        user_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    if [ -z "$steamid" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        steamid=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    [ -z "$user_name" ] && user_name="${USER:-Player}"
    if [ -z "$steamid" ]; then
        steamid=$(resolve_active_steamid)
    fi

    cat <<EOF > "$target_dir/steam_settings/configs.user.ini" || return 1
[user::general]
account_name=$user_name
account_steamid=$steamid
language=english

[user::saves]
local_save_path=./saves
EOF

    # Scaffold configs.app.ini to unlock all DLCs in GBE Fork
    if [ ! -f "$target_dir/steam_settings/configs.app.ini" ]; then
        cat <<EOF > "$target_dir/steam_settings/configs.app.ini" || return 1
[app::dlc]
unlock_all=1
EOF
    fi

    # Scaffold custom_broadcasts.txt if missing
    if [ ! -f "$target_dir/steam_settings/custom_broadcasts.txt" ]; then
        cat <<EOF > "$target_dir/steam_settings/custom_broadcasts.txt" || return 1
# GBE Fork LAN Custom Broadcast IP list
# Add peer IPs or broadcast subnets (one IP per line)
127.0.0.1
255.255.255.255
EOF
    fi

    # 4. Setup isolated portable saves folder and markers
    mkdir -p -m 700 "$target_dir/saves" || return 1
    chmod 700 "$target_dir/saves" || return 1
    local shim_dir
    for shim_dir in "${shim_dirs[@]}"; do
        printf saves > "$shim_dir/local_save.txt" || return 1
        if [ "$shim_dir" != "$target_dir" ]; then
            ln -sfn "$target_dir/steam_settings" "$shim_dir/steam_settings" || return 1
            ln -sfn "$target_dir/saves" "$shim_dir/saves" || return 1
        fi
        if [ -n "$appid" ] && [ "$appid" != STANDALONE ]; then
            printf '%s' "$appid" > "$shim_dir/steam_appid.txt" || return 1
        fi
    done

    # 5. Write steam_appid.txt if available
    if [ -n "$appid" ] && [ "$appid" != "STANDALONE" ]; then
        echo "[INFO] AppID $appid registered in: $target_dir/steam_appid.txt"
        fetch_dlc "$target_dir" "$appid"
        if [ "$sync_mode" = "--all" ] || [ "$sync_mode" = "all" ]; then
            sync_steam "$appid" "$(basename "$target_dir")" "$target_dir" || return $?
        else
            echo "[INFO] Standalone Mode active: Skipping Steam Client synchronization."
        fi
    fi

    invalidate_scan_cache
    echo "[VERIFIED] GBE Fork successfully injected (Platform: $target_platform, Arch: $arch, Save: ./saves, AppID: ${appid:-None})"
    log_msg "INFO" "INJECT" "GBE Fork successfully injected for $(basename "$target_dir") (Platform: $target_platform, Arch: $arch, Save: ./saves, AppID: ${appid:-None})"
}

# --- [MODULE] src/diagnostics/60_doctor.sh ---
# System Diagnostics & Health Audit
doctor_audit() {
    local pass_cnt=0 warn_cnt=0 miss_cnt=0

    echo "${UI_BOX}╭─ GAMECTL SYSTEM DIAGNOSTICS & HEALTH AUDIT ─────────────────╮${UI_RST}"
    local os_str="Linux"
    [ -f /etc/os-release ] && os_str=$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d'=' -f2 | tr -d '"')
    echo "│ ${UI_CYAN}Host OS     ${UI_RST}: ${UI_BOLD}$os_str${UI_RST} ${UI_DIM}($(uname -sr) $(uname -m))${UI_RST}"
    echo "│ ${UI_CYAN}Display     ${UI_RST}: ${WAYLAND_DISPLAY:+Wayland ($WAYLAND_DISPLAY)}${DISPLAY:+ X11 ($DISPLAY)}"
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"

    # Layer 1: CLI Fundamental Tools
    echo
    echo "  ${UI_PURPLE}[LAYER 1] Fundamental CLI Tools${UI_RST}"
    local cli_tool
    for cli_tool in fzf jq curl file zip unzip rsync ssh; do
        if command -v "$cli_tool" >/dev/null 2>&1; then
            echo "    • $(printf '%-10s' "$cli_tool") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v "$cli_tool"))${UI_RST}"
            pass_cnt=$((pass_cnt + 1))
        else
            echo "    • $(printf '%-10s' "$cli_tool") : ${UI_RED}[MISSING]${UI_RST} Install via distro package manager"
            miss_cnt=$((miss_cnt + 1))
        fi
    done

    local has_7z_bin=""
    for c in 7z 7za 7zr; do
        if command -v "$c" >/dev/null 2>&1; then
            has_7z_bin="$(command -v "$c")"
            break
        fi
    done
    if [ -n "$has_7z_bin" ]; then
        echo "    • $(printf '%-10s' "7z") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($has_7z_bin)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-10s' "7z") : ${UI_AMBER}[WARN]${UI_RST} Optional (Install p7zip/7zip for Windows GBE templates)"
        warn_cnt=$((warn_cnt + 1))
    fi

    # YAML belongs to the optional Steam bridge, not standalone readiness.
    echo
    echo "  ${UI_PURPLE}[LAYER 2] Python Runtime${UI_RST}"
    if command -v python3 >/dev/null 2>&1; then
        echo "    • $(printf '%-10s' "python3") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(python3 --version 2>&1))${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
        if python3 -c "import ruamel.yaml" 2>/dev/null; then
            echo "    • $(printf '%-10s' "YAML") : ${UI_DIM}[OPTIONAL]${UI_RST} ruamel.yaml available for explicit Steam bridge commands"
        elif python3 -c "import yaml" 2>/dev/null; then
            echo "    • $(printf '%-10s' "YAML") : ${UI_DIM}[OPTIONAL]${UI_RST} PyYAML available for explicit Steam bridge commands"
        else
            echo "    • $(printf '%-10s' "YAML") : ${UI_DIM}[OPTIONAL]${UI_RST} Not installed; standalone operation does not require YAML"
        fi
    else
        echo "    • $(printf '%-10s' "python3") : ${UI_RED}[MISSING]${UI_RST} Python 3 runtime not found"
        miss_cnt=$((miss_cnt + 1))
    fi

    # Layer 3: GBE Fork Templates
    echo
    echo "  ${UI_PURPLE}[LAYER 3] GBE Fork Binary Templates${UI_RST}"
    local gbe_targets=(
        "Linux x64:linux:x64"
        "Linux x86:linux:x86"
        "Windows x64:windows:x64"
        "Windows x86:windows:x86"
    )
    for gt in "${gbe_targets[@]}"; do
        local g_label="${gt%%:*}"
        local g_rest="${gt#*:}"
        local g_plat="${g_rest%%:*}"
        local g_arch="${g_rest##*:}"
        local g_path
        g_path=$(get_gbe_template "$g_plat" "$g_arch" 2>/dev/null || true)
        if [ -n "$g_path" ] && [ -f "$g_path" ]; then
            echo "    • $(printf '%-11s' "$g_label") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($g_path)${UI_RST}"
            pass_cnt=$((pass_cnt + 1))
        else
            echo "    • $(printf '%-11s' "$g_label") : ${UI_RED}[MISSING]${UI_RST} Run 'gamectl setup-gbe' to install"
            miss_cnt=$((miss_cnt + 1))
        fi
    done

    # Layer 4: Windows Game Runner
    echo
    echo "  ${UI_PURPLE}[LAYER 4] Windows Game Runners${UI_RST}"
    local r_found=0
    if command -v umu-run >/dev/null 2>&1; then
        echo "    • $(printf '%-10s' "umu-run") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v umu-run))${UI_RST}"
        r_found=1
    else
        echo "    • $(printf '%-10s' "umu-run") : ${UI_DIM}[N/A]${UI_RST} (Optional Unified Proton Runner)"
    fi

    local ge_proton=""
    local cdir
    while IFS= read -r cdir; do
        [ -n "$cdir" ] && [ -d "$cdir" ] || continue
        ge_proton=$(find "$cdir" -maxdepth 2 -name "proton" 2>/dev/null | head -n 1 || true)
        [ -n "$ge_proton" ] && break
    done < <(list_runner_dirs)
    if [ -n "$ge_proton" ]; then
        echo "    • $(printf '%-10s' "GE-Proton") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($ge_proton)${UI_RST}"
        r_found=1
    else
        echo "    • $(printf '%-10s' "GE-Proton") : ${UI_DIM}[N/A]${UI_RST} (In gamectl/runners/ or compatibilitytools.d/)"
    fi

    if command -v wine >/dev/null 2>&1; then
        echo "    • $(printf '%-10s' "Wine") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(wine --version 2>/dev/null || echo 'wine'))${UI_RST}"
        r_found=1
    else
        echo "    • $(printf '%-10s' "Wine") : ${UI_DIM}[N/A]${UI_RST} (System Wine fallback)"
    fi

    if [ "$r_found" -eq 1 ]; then
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • ${UI_AMBER}[WARN] No Windows runners detected. Only Native Linux games can launch.${UI_RST}"
        warn_cnt=$((warn_cnt + 1))
    fi

    # Layer 5: Performance & Display Wrappers
    echo
    echo "  ${UI_PURPLE}[LAYER 5] Performance & Display Wrappers${UI_RST}"
    for w_tool in "gamemoderun:GameMode" "mangohud:MangoHud" "gamescope:Gamescope"; do
        local wt_cmd="${w_tool%%:*}"
        local wt_name="${w_tool##*:}"
        if command -v "$wt_cmd" >/dev/null 2>&1; then
            echo "    • $(printf '%-10s' "$wt_name") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v "$wt_cmd"))${UI_RST}"
            pass_cnt=$((pass_cnt + 1))
        else
            echo "    • $(printf '%-10s' "$wt_name") : ${UI_DIM}[OFF]${UI_RST} Not installed ($wt_cmd missing)"
            warn_cnt=$((warn_cnt + 1))
        fi
    done

    # Layer 6: Manifest Harvester & CDN Providers
    echo
    echo "  ${UI_PURPLE}[LAYER 6] Manifest Harvester & CDN Providers${UI_RST}"
    local harvest_ok=1
    command -v curl >/dev/null 2>&1 || harvest_ok=0
    command -v jq >/dev/null 2>&1 || harvest_ok=0
    command -v zip >/dev/null 2>&1 || harvest_ok=0
    command -v unzip >/dev/null 2>&1 || harvest_ok=0
    if [ "$harvest_ok" -eq 1 ]; then
        echo "    • $(printf '%-18s' "Harvester") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}(curl, jq, zip, unzip)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-18s' "Harvester") : ${UI_RED}[MISSING]${UI_RST} curl, jq, zip, or unzip not found"
        miss_cnt=$((miss_cnt + 1))
    fi

    local dl_bin
    dl_bin="$(resolve_depot_dl_bin 2>/dev/null || true)"
    if [ -n "$dl_bin" ] && [ -x "$dl_bin" ]; then
        echo "    • $(printf '%-18s' "Depot Downloader") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($dl_bin)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-18s' "Depot Downloader") : ${UI_AMBER}[WARN]${UI_RST} Standalone Rust downloader not compiled (Run 'make build-depot-dl')"
        warn_cnt=$((warn_cnt + 1))
    fi

    if command -v gogdl >/dev/null 2>&1; then
        echo "    • $(printf '%-18s' "GOG Store CLI") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v gogdl))${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    elif command -v lgogdownloader >/dev/null 2>&1; then
        echo "    • $(printf '%-18s' "GOG Store CLI") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v lgogdownloader))${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-18s' "GOG Store CLI") : ${UI_DIM}[OPT]${UI_RST} Optional (Install gogdl or lgogdownloader for GOG support)"
    fi

    if command -v legendary >/dev/null 2>&1; then
        echo "    • $(printf '%-18s' "Epic Store CLI") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v legendary))${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-18s' "Epic Store CLI") : ${UI_DIM}[OPT]${UI_RST} Optional (Install legendary for Epic Games support)"
    fi

    if command -v nile >/dev/null 2>&1; then
        echo "    • $(printf '%-18s' "Amazon Store CLI") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v nile))${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-18s' "Amazon Store CLI") : ${UI_DIM}[OPT]${UI_RST} Optional (Install nile for Amazon Games support)"
    fi

    # Layer 7: Steam Client & SLSsteam Integration
    echo
    echo "  ${UI_PURPLE}[LAYER 7] Steam Client & Secondary Bridge Integration${UI_RST}"
    local s_root
    s_root="$(get_steam_root 2>/dev/null || true)"
    if [ -n "$s_root" ] && [ -d "$s_root" ]; then
        echo "    • $(printf '%-12s' "Steam Root") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($s_root)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-12s' "Steam Root") : ${UI_DIM}[OPTIONAL]${UI_RST} ${UI_DIM}Steam client not detected (Standalone primary)${UI_RST}"
    fi

    local sls_file="$HOME/.config/SLSsteam/config.yaml"
    if [ -f "$sls_file" ]; then
        echo "    • $(printf '%-12s' "SLSsteam") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}(Secondary bridge active: $sls_file)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-12s' "SLSsteam") : ${UI_DIM}[OPTIONAL]${UI_RST} ${UI_DIM}Secondary bridge inactive (Standalone GBE primary)${UI_RST}"
    fi

    # Layer 8: Security Sandboxing & Process Isolation
    echo
    echo "  ${UI_PURPLE}[LAYER 8] Security Sandboxing & Process Isolation${UI_RST}"
    if command -v bwrap >/dev/null 2>&1; then
        echo "    • $(printf '%-18s' "Bubblewrap") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}($(command -v bwrap))${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-18s' "Bubblewrap") : ${UI_AMBER}[WARN]${UI_RST} bwrap not found in PATH (Rootless sandbox disabled: --sandbox)"
        warn_cnt=$((warn_cnt + 1))
    fi

    if check_systemd_scope_support; then
        echo "    • $(printf '%-18s' "cgroups v2 Scope") : ${UI_GREEN}[READY]${UI_RST} ${UI_DIM}(systemd-run --user scope active)${UI_RST}"
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • $(printf '%-18s' "cgroups v2 Scope") : ${UI_AMBER}[WARN]${UI_RST} systemd-run user scope unsupported or inactive"
        warn_cnt=$((warn_cnt + 1))
    fi

    # Hardware GPU & Mesa Driver Health
    echo
    echo "  ${UI_PURPLE}[HARDWARE] GPU Controller & Mesa Driver Health${UI_RST}"
    local gpu_line
    gpu_line=$(lspci 2>/dev/null | grep -E "VGA|3D" | head -n 1 | sed -E 's/^[0-9a-f:.]+ (VGA compatible controller|3D controller): //' || true)
    [ -z "$gpu_line" ] && gpu_line="Not detected via lspci"
    echo "    • GPU Controller : ${UI_BOLD}$gpu_line${UI_RST}"
    local vk_cap eff_renderer eff_label
    vk_cap="$(detect_vulkan_capability 2>/dev/null || echo "OPENGL_ONLY")"
    eff_renderer="$(resolve_graphics_renderer "auto" "0" 2>/dev/null || echo "wined3d")"
    if [ "$eff_renderer" = "dxvk" ]; then
        eff_label="DXVK (Vulkan)"
    else
        eff_label="WineD3D (OpenGL)"
    fi

    case "$vk_cap" in
        VULKAN_READY)
            echo "    • Vulkan Stack   : ${UI_GREEN}[READY]${UI_RST} Full Vulkan ICD ($vk_cap) -> Auto Renderer: $eff_label."
            pass_cnt=$((pass_cnt + 1))
            ;;
        VULKAN_LEGACY)
            echo "    • Vulkan Stack   : ${UI_AMBER}[LEGACY]${UI_RST} Incomplete/legacy Vulkan ICD ($vk_cap) -> Auto Renderer: $eff_label."
            warn_cnt=$((warn_cnt + 1))
            ;;
        *)
            echo "    • Vulkan Stack   : ${UI_AMBER}[OPENGL_ONLY]${UI_RST} No usable Vulkan ICD ($vk_cap) -> Auto Renderer: $eff_label."
            warn_cnt=$((warn_cnt + 1))
            ;;
    esac

    if is_haswell_gpu; then
        echo "    • Driver Safety  : ${UI_ICE}Mesa GL Threading is disabled by default on Haswell to prevent FNA/XNA asset decompression crashes.${UI_RST}"
    fi

    local lib32_gl="" ldconfig_bin=""
    if command -v ldconfig >/dev/null 2>&1; then
        ldconfig_bin=$(command -v ldconfig)
    elif [ -x /sbin/ldconfig ]; then
        ldconfig_bin="/sbin/ldconfig"
    elif [ -x /usr/sbin/ldconfig ]; then
        ldconfig_bin="/usr/sbin/ldconfig"
    fi
    if [ -n "$ldconfig_bin" ]; then
        lib32_gl=$("$ldconfig_bin" -p 2>/dev/null | awk '/^[[:space:]]*libGL\.so\.1[[:space:]]*\(libc6/ && !/x86-64|AArch64|64bit/ { sub(/^.*=>[[:space:]]*/, ""); print; exit }' || true)
    fi
    if [ -z "$lib32_gl" ]; then
        if [ -e "/usr/lib32/libGL.so.1" ]; then
            lib32_gl="/usr/lib32/libGL.so.1"
        elif [ -e "/usr/lib/i386-linux-gnu/libGL.so.1" ]; then
            lib32_gl="/usr/lib/i386-linux-gnu/libGL.so.1"
        elif [ -e "/usr/lib/libGL.so.1" ] && file -L "/usr/lib/libGL.so.1" 2>/dev/null | grep -q "32-bit"; then
            lib32_gl="/usr/lib/libGL.so.1 (32-bit)"
        fi
    fi
    if [ -n "$lib32_gl" ]; then
        echo "    • Multilib 32-bit: ${UI_GREEN}[READY]${UI_RST} 32-bit OpenGL runtime detected ($lib32_gl)."
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • Multilib 32-bit: ${UI_AMBER}[WARN]${UI_RST} 32-bit libGL.so.1 missing; PE32/32-bit Windows games may fail silently."
        warn_cnt=$((warn_cnt + 1))
    fi

    local dgpu_vend
    dgpu_vend="$(detect_dgpu_vendor 2>/dev/null || echo "none")"
    if [ "$dgpu_vend" != "none" ]; then
        echo "    • Hybrid dGPU    : ${UI_GREEN}[READY]${UI_RST} Discrete GPU detected ($dgpu_vend). PRIME offload available (--prime)."
        pass_cnt=$((pass_cnt + 1))
    else
        echo "    • Hybrid dGPU    : ${UI_DIM}[N/A]${UI_RST} No discrete secondary GPU detected (single GPU topology)."
    fi

    echo
    echo "${UI_BOX}╭─ DIAGNOSTIC AUDIT SUMMARY ──────────────────────────────────╮${UI_RST}"
    echo "│ ${UI_GREEN}Passed: $pass_cnt${UI_RST}  •  ${UI_AMBER}Warnings: $warn_cnt${UI_RST}  •  ${UI_RED}Missing: $miss_cnt${UI_RST}"
    if [ "$miss_cnt" -eq 0 ] && [ "$warn_cnt" -eq 0 ]; then
        echo "│ System Status: ${UI_GREEN}[READY] 100% optimal for sovereign offline gaming.${UI_RST}"
    elif [ "$miss_cnt" -eq 0 ]; then
        echo "│ System Status: ${UI_GREEN}[READY] Core dependencies satisfied. Review warnings above.${UI_RST}"
    else
        echo "│ System Status: ${UI_AMBER}[WARN] Essential dependencies missing. Install missing tools.${UI_RST}"
    fi
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"

    return $(( miss_cnt > 0 ? 1 : 0 ))
}

# Query ProtonDB community compatibility tier and rating (Chunk 5)
query_protondb() {
    local target="${1:-}"

    if [ -z "$target" ]; then
        echo "Usage: gamectl protondb <appid|game_dir>" >&2
        return 1
    fi

    local appid=""
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        appid="$target"
    elif [ -d "$target" ]; then
        appid="$(resolve_game_appid "$target")"
        if [ -z "$appid" ]; then
            local base_dir
            base_dir="$(basename "$target")"
            local parent_apps
            parent_apps="$(dirname "$target")"
            if [ "$(basename "$parent_apps")" = "common" ]; then
                local steamapps_dir
                steamapps_dir="$(dirname "$parent_apps")"
                local acf
                for acf in "$steamapps_dir"/appmanifest_*.acf; do
                    [ -f "$acf" ] || continue
                    local installdir
                    installdir=$(grep -E '^\s*"installdir"' "$acf" | head -n 1 | sed -E 's/.*"installdir"[[:space:]]+"([^"]+)".*/\1/')
                    if [ "$installdir" = "$base_dir" ]; then
                        appid=$(grep -E '^\s*"appid"' "$acf" | head -n 1 | sed -E 's/.*"appid"[[:space:]]+"([0-9]+)".*/\1/')
                        break
                    fi
                done
            fi
        fi
    fi

    if [ -z "$appid" ] || [[ ! "$appid" =~ ^[0-9]+$ ]]; then
        echo "[ERROR] Invalid AppID or game directory lacks steam_appid.txt: $target" >&2
        return 1
    fi

    echo "${UI_BOX}╭─ PROTONDB COMPATIBILITY REPORT ─────────────────────────────╮${UI_RST}"
    echo "│ ${UI_CYAN}Target AppID${UI_RST}  : ${UI_BOLD}$appid${UI_RST}"

    local pdb=""
    pdb=$(fetch_cached_json "https://www.protondb.com/api/v1/reports/summaries/${appid}.json" "protondb_${appid}" 3600 2>/dev/null || true)

    if [ -n "$pdb" ] && [ "$pdb" != "null" ] && echo "$pdb" | jq . >/dev/null 2>&1; then
        local tier score conf trending
        tier=$(echo "$pdb" | jq -r ".tier // \"Unknown\"" 2>/dev/null)
        score=$(echo "$pdb" | jq -r ".score // \"-\"" 2>/dev/null)
        conf=$(echo "$pdb" | jq -r ".confidence // \"-\"" 2>/dev/null)
        trending=$(echo "$pdb" | jq -r ".trendingTier // \"-\"" 2>/dev/null)

        local tier_upper="${tier^^}"
        local c_tier="${UI_GREEN}[$tier_upper]${UI_RST}"
        local recommendation=""

        case "$tier_upper" in
            *PLATINUM*)
                c_tier="${UI_ICE}[PLATINUM]${UI_RST}"
                recommendation="Plug and play. Works flawlessly out of the box without special tweaking."
                ;;
            *GOLD*)
                c_tier="${UI_AMBER}[GOLD]${UI_RST}"
                recommendation="Runs well after minor tweaks (e.g. GE-Proton / DirectX DLL override)."
                ;;
            *SILVER*)
                c_tier="${UI_DIM}[SILVER]${UI_RST}"
                recommendation="Playable with minor issues / requires specific launch options."
                ;;
            *BRONZE*)
                c_tier="${UI_AMBER}[BRONZE]${UI_RST}"
                recommendation="Frequent crashes or graphical glitches. Specific GE-Proton version recommended."
                ;;
            *BORKED*)
                c_tier="${UI_RED}[BORKED]${UI_RST}"
                recommendation="Game currently does not run under Wine/Proton (likely invasive anti-cheat)."
                ;;
            *NATIVE*)
                c_tier="${UI_GREEN}[NATIVE]${UI_RST}"
                recommendation="Native Linux ELF build available without Wine emulation."
                ;;
            *)
                recommendation="Limited community reports. Test with latest GE-Proton release."
                ;;
        esac

        echo "│ ${UI_CYAN}ProtonDB Tier${UI_RST} : $c_tier"
        echo "│ ${UI_CYAN}Rating Score ${UI_RST} : ${UI_BOLD}$score${UI_RST} ${UI_DIM}(Confidence: $conf, Trending: $trending)${UI_RST}"
        echo "│ ${UI_CYAN}Recommendation${UI_RST}: $recommendation"
        echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"
        return 0
    else
        echo "│ ${UI_CYAN}ProtonDB Tier${UI_RST} : ${UI_DIM}[NO REPORTS YET]${UI_RST}"
        echo "│ ${UI_CYAN}Details       ${UI_RST}: No community reports currently recorded for AppID $appid."
        echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"
        return 0
    fi
}


# --- [MODULE] src/tui/70_dashboard.sh ---
# Interactive Centralized Activity & Runtime Log Viewer
view_logs_interactive() {
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "[ERROR] Interactive log viewer requires a terminal (TTY)." >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for interactive mode but was not found in PATH." >&2
        return 127
    fi

    flush_tty_input
    local log_file
    log_file="$(get_runtime_log_file)"

    if [ ! -s "$log_file" ]; then
        log_msg "INFO" "SYSTEM" "Log file initialized"
    fi

    local fzf_rc=0
    export GAMECTL_LOG_FILE="$log_file"
    export GAMECTL_PREVIEW_BIN="$SELF_BIN"
    if command -v tac >/dev/null 2>&1; then
        tac "$log_file" 2>/dev/null
    else
        sed -e '1!G;h;$!d' "$log_file" 2>/dev/null
    fi | fzf \
        --border-label="  ╢ gamectl :: Activity & Runtime Logs ╟  " \
        --border-label-pos=2 \
        --header="Ctrl-X: Clear Log │ Esc: Return" \
        --prompt="Logs > " \
        --preview='"$GAMECTL_PREVIEW_BIN" --preview-log {}' \
        --preview-window=down:35%:border-rounded:wrap \
        --bind='ctrl-x:execute(: > "$GAMECTL_LOG_FILE")+reload(command -v tac >/dev/null 2>&1 && tac "$GAMECTL_LOG_FILE" 2>/dev/null || sed -e "1!G;h;\$!d" "$GAMECTL_LOG_FILE" 2>/dev/null)' \
        --reverse 2>/dev/null || fzf_rc=$?

    flush_tty_input
    if [ "$fzf_rc" -eq 130 ]; then
        return 0
    fi
    if [ "$fzf_rc" -ne 0 ] && [ "$fzf_rc" -ne 1 ]; then
        echo "[ERROR] Activity log viewer failed (fzf exit code $fzf_rc)." >&2
        return "$fzf_rc"
    fi
    return 0
}

# In-Dashboard Process Management & Cockpit Controller
manage_active_processes_interactive() {
    local run_dir
    run_dir="$(get_runtime_dir)"
    if [ ! -d "$run_dir/active_games" ]; then
        tui_modal_notice "Process Controller" "No games currently running."
        return 0
    fi

    local running_list=""
    local count=0
    local p_pid p_title p_dir p_bin p_log p_inf _p_scope _p_sep=$'\x1f'
    while IFS="$_p_sep" read -r p_pid p_title p_dir p_bin p_log p_inf _p_scope; do
        [ -n "$p_pid" ] || continue
        count=$((count + 1))
        running_list+="${p_pid}\t${p_title}\t${p_dir}\t${p_bin}\t${p_log}\t${p_inf}\n"
    done < <(list_active_games)

    if [ "$count" -eq 0 ] || [ -z "$running_list" ]; then
        tui_modal_notice "Process Controller" "No games currently running."
        return 0
    fi

    # If only 1 game is running, open its controller HUD directly
    if [ "$count" -eq 1 ]; then
        local s_pid s_title s_dir s_bin s_log s_inf
        s_pid=$(printf '%b' "$running_list" | head -n 1 | cut -f1)
        s_title=$(printf '%b' "$running_list" | head -n 1 | cut -f2)
        s_dir=$(printf '%b' "$running_list" | head -n 1 | cut -f3)
        s_bin=$(printf '%b' "$running_list" | head -n 1 | cut -f4)
        s_log=$(printf '%b' "$running_list" | head -n 1 | cut -f5)
        s_inf=$(printf '%b' "$running_list" | head -n 1 | cut -f6)
        game_controller_hud "$s_pid" "$s_title" "$s_log" "$s_dir" "$s_bin" "$s_inf" "Active Game"
        return 0
    fi

    # If multiple games are running, let the user select which one to manage
    local pick p_rc=0
    pick=$(tui_action_palette "Running Games ($count Active)" "Select Game Process to Manage (Enter: Select │ Esc: Return)" "$(printf '%b' "$running_list")" "" "Process > ") || p_rc=$?
    [ "$p_rc" -eq 130 ] && return 0
    [ "$p_rc" -ne 0 ] && return "$p_rc"
    [ -z "$pick" ] && return 0
    local c_pid c_title c_dir c_bin c_log c_inf
    c_pid=$(echo "$pick" | cut -f1)
    c_title=$(echo "$pick" | cut -f2)
    c_dir=$(echo "$pick" | cut -f3)
    c_bin=$(echo "$pick" | cut -f4)
    c_log=$(echo "$pick" | cut -f5)
    c_inf=$(echo "$pick" | cut -f6)
    game_controller_hud "$c_pid" "$c_title" "$c_log" "$c_dir" "$c_bin" "$c_inf" "Active Game"
    return 0
}

# Master Dashboard Hub (Two-Panel Interactive TUI)
dashboard_menu() {
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "[ERROR] Master Dashboard requires a terminal (TTY)." >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for Master Dashboard but was not found in PATH." >&2
        return 127
    fi

    enter_tui_screen
    clean_stale_locks

    local initial_count
    initial_count=$(scan_installed_games 2>/dev/null | wc -l || echo "0")
    log_msg "INFO" "DASHBOARD" "Cockpit active ($initial_count titles indexed)"

    export GAMECTL_PREVIEW_BIN="$SELF_BIN"

    while true; do
        flush_tty_input
        local game_count
        game_count=$(scan_installed_games 2>/dev/null | wc -l || echo "0")
        export GAMECTL_GAME_COUNT="$game_count"

        local menu_entries
        menu_entries=$(cat <<EOF
1	${UI_PURPLE}[01]${UI_RST} ${UI_BOLD}GAME LIBRARY${UI_RST}	${UI_DIM}Browse, inject and launch installed games${UI_RST}
2	${UI_PURPLE}[02]${UI_RST} ${UI_BOLD}STEAM STORE SEARCH${UI_RST}	${UI_DIM}Search games & check ProtonDB compatibility${UI_RST}
3	${UI_PURPLE}[03]${UI_RST} ${UI_BOLD}DOWNLOAD MONITOR${UI_RST}	${UI_DIM}Track Steam native downloads & ACF telemetry${UI_RST}
4	${UI_PURPLE}[04]${UI_RST} ${UI_BOLD}STEAM ACF ADOPTION & ASSET MANAGER${UI_RST}	${UI_DIM}Adopt physical files, shaders & bridge downloads${UI_RST}
5	${UI_PURPLE}[05]${UI_RST} ${UI_BOLD}GLOBAL SETTINGS${UI_RST}	${UI_DIM}Configure LAN persona, default wrappers & remote host${UI_RST}
6	${UI_PURPLE}[06]${UI_RST} ${UI_BOLD}SYSTEM DIAGNOSTICS${UI_RST}	${UI_DIM}Audit 7-layer dependencies, runners & GPU health${UI_RST}
7	${UI_PURPLE}[07]${UI_RST} ${UI_BOLD}ACTIVITY LOGS${UI_RST}	${UI_DIM}Inspect operational events, runner traces & error history${UI_RST}
EOF
)

        local fzf_out fzf_rc=0
        fzf_out=$(echo "$menu_entries" | fzf \
            --delimiter=$'\t' \
            --with-nth=2,3 \
            --expect=ctrl-l,ctrl-p \
            --border-label="  ╢ gamectl :: Master Dashboard Hub ╟  " \
            --border-label-pos=2 \
            --header="Enter: Open │ 1-7: Quick Select │ Ctrl-P: Process Controller │ Ctrl-L: Logs │ Esc: Exit" \
            --prompt="Dashboard > " \
            --preview='"$GAMECTL_PREVIEW_BIN" --preview-dashboard {1} "$GAMECTL_GAME_COUNT"' \
            --preview-window=right:55%:border-rounded:wrap \
        ) || fzf_rc=$?

        [ "$fzf_rc" -eq 130 ] && break
        if [ "$fzf_rc" -ne 0 ] && [ "$fzf_rc" -ne 1 ]; then
            echo "[ERROR] Master Dashboard menu failed (fzf exit code $fzf_rc)." >&2
            return "$fzf_rc"
        fi
        [ -z "$fzf_out" ] && continue

        local trigger_key selection
        trigger_key=$(echo "$fzf_out" | head -n 1)
        selection=$(echo "$fzf_out" | sed -n '2p')

        if [ "$trigger_key" = "ctrl-l" ]; then
            view_logs_interactive || return $?
            continue
        elif [ "$trigger_key" = "ctrl-p" ]; then
            manage_active_processes_interactive || return $?
            continue
        fi

        [ -z "$selection" ] && continue

        local sel_key
        sel_key=$(echo "$selection" | awk -F'\t' '{print $1}')

        local sub_rc=0
        case "$sel_key" in
            1)
                library_menu false || sub_rc=$?
                ;;
            2)
                search_steam "" false || sub_rc=$?
                ;;
            3)
                list_downloads_interactive || sub_rc=$?
                ;;
            4)
                unlock_interactive || sub_rc=$?
                ;;
            5)
                configure_global || sub_rc=$?
                ;;
            6)
                flush_tty_input
                local audit_rc=0
                doctor_audit 2>&1 | fzf \
                    --ansi \
                    --no-sort \
                    --border-label="  ╢ gamectl :: System Diagnostics Audit ╟  " \
                    --border-label-pos=2 \
                    --header="Esc / Enter / q: Return to Dashboard" \
                    --prompt="Audit > " \
                    --bind="q:abort" \
                    --reverse 2>/dev/null || audit_rc=$?
                check_fzf_status "$audit_rc" || sub_rc=$?
                ;;
            7)
                view_logs_interactive || sub_rc=$?
                ;;
            *)
                break
                ;;
        esac
        if [ "$sub_rc" -ne 0 ] && [ "$sub_rc" -ne 1 ] && [ "$sub_rc" -ne 130 ]; then
            return "$sub_rc"
        fi
        flush_tty_input
    done
    exit_tui_screen
}

# Unified Remote Save Sync Palette (Push, Pull, Dry-Run, Configure Host)
remote_sync_interactive() {
    local sel_dir="$1"
    local sel_title="${2:-$sel_dir}"

    while true; do
        local rhost="" host_display=""
        rhost=$(get_remote_host 2>/dev/null || true)
        host_display="${rhost:-Not configured}"

        local sync_entries
        sync_entries=$(printf 'push\tPush Saves - Send local saves to %s\npull\tPull Saves - Download remote saves from %s (auto pre-pull backup)\npull-dry\tPull Dry-Run - Simulate remote pull without modifying local files\nconfig\tConfigure Remote Host - Set SSH host (serv, host:~/path) or rclone (gdrive:path) (Current: %s)\n' \
            "$host_display" "$host_display" "$host_display")

        local pal_rc=0 sel=""
        sel=$(tui_action_palette \
            "Remote Save Sync :: ${sel_title:-$sel_dir}" \
            "Host: $host_display │ Select Sync Action (Enter: Run │ Esc: Return)" \
            "$sync_entries" \
            "" \
            "Sync > ") || pal_rc=$?
        [ "$pal_rc" -eq 130 ] && return 0
        [ "$pal_rc" -ne 0 ] && return "$pal_rc"
        [ -z "$sel" ] && continue

        local action="${sel%%$'\t'*}"
        case "$action" in
            push)
                if tui_run_engine --fail-title "Remote Sync Error" "Remote Push (${sel_title:-$sel_dir})" sync_save_remote "$sel_dir" "$sel_title"; then
                    tui_modal_notice "Remote Sync (Push)" "Savegames pushed to ${rhost:-remote host} for:\n${sel_title:-$sel_dir}" || return $?
                fi
                ;;
            pull)
                if tui_run_engine --fail-title "Remote Pull Error" "Remote Pull (${sel_title:-$sel_dir})" pull_save_remote "$sel_dir" "$sel_title"; then
                    tui_modal_notice "Remote Sync (Pull)" "Savegames pulled from ${rhost:-remote host} for:\n${sel_title:-$sel_dir}\n\nPre-pull local snapshot saved to .save_snapshots/ when local saves existed." || return $?
                fi
                ;;
            pull-dry)
                if tui_run_engine --fail-title "Remote Pull Dry-Run Error" "Remote Pull Dry-Run (${sel_title:-$sel_dir})" pull_save_remote "$sel_dir" "$sel_title" --dry-run; then
                    tui_modal_notice "Remote Pull (Dry-Run)" "Dry-run pull simulation completed from ${rhost:-remote host} for:\n${sel_title:-$sel_dir}\n\nNo local files were modified.\nSimulation log:\n$(get_runtime_log_file)" || return $?
                fi
                ;;
            config)
                local new_rhost="" cfg_rc=0
                new_rhost=$(tui_prompt_input "Remote Companion Host" "Enter SSH host (serv, host:~/path), rclone (gdrive:path), or '-' to clear (Current: $host_display │ Enter: Save │ Esc: Cancel)" "$rhost" "Remote Target > ") || cfg_rc=$?
                [ "$cfg_rc" -eq 130 ] && continue
                [ "$cfg_rc" -ne 0 ] && return "$cfg_rc"
                new_rhost=$(printf '%s' "$new_rhost" | tr -d '[:space:]')
                local env_rhost="${GAMECTL_REMOTE_HOST:-${GAMECTL_COMPANION_HOST:-${GAMECTL_SYNC_HOST:-${GAMECTL_TUF_HOST:-}}}}"

                if [ "$new_rhost" = "-" ]; then
                    rm -f "$HOME/.config/gamectl/remote_host"
                    log_msg "INFO" "CONFIG" "Cleared remote companion host"
                    if [ -n "$env_rhost" ]; then
                        tui_modal_notice "Remote Companion Host" "Cleared saved remote host (~/.config/gamectl/remote_host).\n\nNote: environment variable override is still active:\n$env_rhost" || return $?
                    else
                        tui_modal_notice "Remote Companion Host" "Cleared remote companion host." || return $?
                    fi
                elif [[ "$new_rhost" == -* ]]; then
                    tui_modal_notice "Invalid Remote Host" "Remote host cannot start with '-':\n$new_rhost" || return $?
                    continue
                elif [ -n "$new_rhost" ]; then
                    local parse_err=""
                    if ! parse_err=$(parse_remote_sync_target "$new_rhost" 2>&1); then
                        tui_modal_notice "Invalid Remote Target" "$parse_err" || return $?
                        continue
                    fi
                    mkdir -p "$HOME/.config/gamectl" || return 1
                    printf '%s\n' "$new_rhost" > "$HOME/.config/gamectl/remote_host"
                    log_msg "INFO" "CONFIG" "Saved remote companion host: $new_rhost"
                    if [ -n "$env_rhost" ] && [ "$env_rhost" != "$new_rhost" ]; then
                        tui_modal_notice "Remote Companion Host" "Saved remote companion host:\n$new_rhost\n\nNote: environment variable override is currently active:\n$env_rhost" || return $?
                    else
                        tui_modal_notice "Remote Companion Host" "Saved remote companion host:\n$new_rhost" || return $?
                    fi
                fi
                ;;
        esac
    done
}

# Main Library View
library_menu() {
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "[ERROR] Game Library requires a terminal (TTY)." >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for Game Library but was not found in PATH." >&2
        return 127
    fi

    local standalone="${1:-false}"
    [ "$standalone" = "true" ] && enter_tui_screen
    clean_stale_locks

    export GAMECTL_PREVIEW_BIN="$SELF_BIN"
    local active_store="ALL"
    local last_status_banner=""

    while true; do
        flush_tty_input
        local active_summary active_cnt=0 active_names="" _a_sep=$'\x1f'
        active_summary=$(get_active_games_summary)
        IFS="$_a_sep" read -r active_cnt active_names <<< "$active_summary"
        local lib_label="  ╢ gamectl :: Game Library [Store: $active_store] ╟  "
        [ "${active_cnt:-0}" -gt 0 ] && lib_label="  ╢ gamectl :: Game Library [Store: $active_store] [Running: $active_cnt] ╟  "
        local lib_header="Enter: Launch/Manage │ Tab/Alt-S: Store │ Ctrl-I: Inject GBE │ Ctrl-F: Search │ Esc: Dashboard"
        if [ -n "$last_status_banner" ]; then
            lib_header+=$'\n'"$last_status_banner"
            last_status_banner=""
        elif [ "${active_cnt:-0}" -gt 0 ]; then
            lib_header+=$'\n'"[RUNNING ($active_cnt)] $active_names — Press Enter on a running game to Stop / View Logs"
        fi
        local fzf_out fzf_rc=0
        fzf_out=$(scan_installed_games --formatted --store "$active_store" | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2,3 \
            --expect=ctrl-f,ctrl-d,ctrl-l,ctrl-o,ctrl-p,ctrl-i,ctrl-s,ctrl-b,ctrl-r,ctrl-x,tab,alt-s \
            --border-label="$lib_label" \
            --border-label-pos=2 \
            --header="$lib_header" \
            --prompt="Library > " \
            --preview='"$GAMECTL_PREVIEW_BIN" --preview {1} {2} {3} {4} {5}' \
            --preview-window=right:55%:border-rounded:wrap \
        ) || fzf_rc=$?

        [ "$fzf_rc" -eq 130 ] && break
        if [ "$fzf_rc" -ne 0 ] && [ "$fzf_rc" -ne 1 ]; then
            echo "[ERROR] Game Library menu failed (fzf exit code $fzf_rc)." >&2
            return "$fzf_rc"
        fi
        [ -z "$fzf_out" ] && continue

        local trigger_key selection
        trigger_key=$(echo "$fzf_out" | head -n 1)
        selection=$(echo "$fzf_out" | sed -n '2p')

        # Global in-process hotkeys that do not require item selection
        local hk_rc=0
        if [ "$trigger_key" = "ctrl-l" ]; then
            view_logs_interactive || hk_rc=$?
        elif [ "$trigger_key" = "ctrl-f" ]; then
            search_steam "" false || hk_rc=$?
            invalidate_scan_cache
        elif [ "$trigger_key" = "tab" ]; then
            case "$active_store" in
                ALL) active_store="STEAM" ;;
                STEAM) active_store="GOG" ;;
                GOG) active_store="EPIC" ;;
                EPIC) active_store="AMAZON" ;;
                AMAZON) active_store="STANDALONE" ;;
                *) active_store="ALL" ;;
            esac
            continue
        elif [ "$trigger_key" = "alt-s" ]; then
            local store_pick=""
            store_pick=$(tui_action_palette \
                "Store Filter" \
                "Select Store View (Enter: Apply │ Esc: Cancel)" \
                "$(printf 'ALL\tAll Stores (Unified)\nSTEAM\tSteam Library\nGOG\tGOG Library (DRM-Free)\nEPIC\tEpic Games Library (Legendary)\nAMAZON\tAmazon Games Library (Nile)\nSTANDALONE\tStandalone / Portable\n')" \
                "" \
                "Store > ") || hk_rc=$?
            if [ "$hk_rc" -ne 0 ] && [ "$hk_rc" -ne 1 ] && [ "$hk_rc" -ne 130 ]; then
                return "$hk_rc"
            fi
            if [ "$hk_rc" -eq 0 ] && [ -n "$store_pick" ]; then
                active_store=$(printf '%s' "$store_pick" | cut -f1)
            fi
            continue
        fi
        if [ "$hk_rc" -ne 0 ] && [ "$hk_rc" -ne 1 ] && [ "$hk_rc" -ne 130 ]; then
            return "$hk_rc"
        fi
        if [ "$trigger_key" = "ctrl-l" ] || [ "$trigger_key" = "ctrl-f" ]; then
            continue
        fi

        [ -z "$selection" ] && continue

        local sel_appid sel_title sel_status sel_dir sel_bin
        sel_appid=$(echo "$selection" | awk -F'\t' '{print $1}')
        sel_title=$(echo "$selection" | awk -F'\t' '{print $2}')
        sel_status=$(echo "$selection" | awk -F'\t' '{print $3}')
        sel_dir=$(echo "$selection" | awk -F'\t' '{print $4}')
        sel_bin=$(echo "$selection" | awk -F'\t' '{print $5}')

        case "$trigger_key" in
            ctrl-d)
                if tui_run_engine --fail-title "Desktop Shortcut Failed" "Create Desktop Shortcut (${sel_title:-$sel_dir})" create_desktop_entry "$sel_dir" "$sel_title"; then
                    tui_modal_notice "Desktop Shortcut Created" "Created application launcher for:\n${sel_title:-$sel_dir}\nSaved to ~/.local/share/applications/" || return $?
                fi
                continue
                ;;
            ctrl-o)
                configure_wrappers "$sel_dir" "$sel_title" || return $?
                invalidate_scan_cache
                continue
                ;;
            ctrl-p)
                set_id_interactive "$sel_dir" "$sel_title" || return $?
                invalidate_scan_cache
                continue
                ;;
            ctrl-i)
                if tui_run_engine --fail-title "GBE Injection Failed" "GBE Injection (${sel_title:-$sel_dir})" inject_game "$sel_dir" "$sel_appid" --no-sync; then
                    tui_modal_notice "Standalone GBE Injection" "Successfully injected GBE Fork for:\n${sel_title:-$sel_dir}" || return $?
                fi
                invalidate_scan_cache
                continue
                ;;
            ctrl-s)
                remote_sync_interactive "$sel_dir" "$sel_title" || return $?
                invalidate_scan_cache
                continue
                ;;
            ctrl-b)
                if tui_run_engine --fail-title "Save Backup Error" "Save Backup (${sel_title:-$sel_dir})" backup_save "$sel_dir"; then
                    tui_modal_notice "Save Backup" "Savegame snapshot created in slot for:\n${sel_title:-$sel_dir}" || return $?
                fi
                continue
                ;;
            ctrl-r)
                if [ -d "$sel_dir/.save_snapshots" ]; then
                    local snaps
                    snaps=$(ls -d "$sel_dir/.save_snapshots"/slot* 2>/dev/null | wc -l)
                    if [ "$snaps" -gt 0 ]; then
                        local chosen_slot="1"
                        if [ "$snaps" -gt 1 ]; then
                            local slot_list=""
                            for s in "$sel_dir/.save_snapshots"/slot*; do
                                [ -d "$s" ] || continue
                                local s_name s_time
                                s_name=$(basename "$s")
                                s_time=$(date -r "$s" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "Snapshot")
                                slot_list+="${s_name}\t${s_time}\n"
                            done
                            flush_tty_input
                            local pick="" p_rc=0
                            pick=$(printf '%b' "$slot_list" | fzf \
                                --delimiter=$'\t' \
                                --border-label="  ╢ Restore Save Snapshot :: ${sel_title:-$sel_dir} ╟  " \
                                --border-label-pos=2 \
                                --header="Select Recovery Slot to Restore (Enter: Restore │ Esc: Cancel)" \
                                --prompt="Restore Slot > " \
                                --reverse 2>/dev/null) || p_rc=$?
                            check_fzf_status "$p_rc" || return $?
                            [ "$p_rc" -eq 130 ] || [ -z "$pick" ] && continue
                            chosen_slot=$(echo "$pick" | cut -f1)
                            chosen_slot="${chosen_slot#slot}"
                        fi
                        if tui_run_engine --fail-title "Save Restore Error" "Save Restore slot${chosen_slot} (${sel_title:-$sel_dir})" restore_save "$sel_dir" "$chosen_slot"; then
                            tui_modal_notice "Save Restore" "Savegame restored successfully from slot${chosen_slot} for:\n${sel_title:-$sel_dir}" || return $?
                        fi
                    else
                        tui_modal_notice "Save Restore" "No snapshot recovery slots found for:\n${sel_title:-$sel_dir}" || return $?
                    fi
                else
                    tui_modal_notice "Save Restore" "No snapshot recovery directory (.save_snapshots) found for:\n${sel_title:-$sel_dir}" || return $?
                fi
                continue
                ;;
            ctrl-x)
                manage_game_fixes_interactive "$sel_appid" "$sel_title" "$sel_dir" || return $?
                invalidate_scan_cache
                continue
                ;;
            *)
                local launch_rc=0
                if [ -z "$sel_bin" ]; then
                    local cand_bin
                    cand_bin=$(find_game_binary "$sel_dir" 2>/dev/null || echo "")
                    if [ -z "$cand_bin" ] && [ -n "$sel_appid" ] && [[ "$sel_appid" =~ ^[0-9]+$ ]]; then
                        local target_os
                        target_os="$(detect_app_platform_os "$sel_appid")"
                        log_msg "INFO" "LIBRARY" "Missing executable binary in $sel_dir for $sel_title ($sel_appid). Bridging to standalone download."
                        tui_exec_action "Download Missing Files ($sel_title)" download_game "$sel_appid" "$sel_dir" "$sel_title" --all --os "$target_os"
                        invalidate_scan_cache
                        continue
                    fi
                fi
                # Check if game is already active / running
                local active_row="" active_pid="" active_log="" active_inf=""
                active_row=$(find_active_game_for_dir "$sel_dir" 2>/dev/null || true)
                if [ -n "$active_row" ]; then
                    local _a_title _a_dir _a_bin _a_scope _a_sep=$'\x1f'
                    IFS="$_a_sep" read -r active_pid _a_title _a_dir _a_bin active_log active_inf _a_scope <<< "$active_row"
                fi

                if [ -n "$active_pid" ]; then
                    # Game is already running: open In-Dashboard Process Controller
                    local hud_rc=0
                    game_controller_hud "$active_pid" "$sel_title" "$active_log" "$sel_dir" "$sel_bin" "$active_inf" "Running Process" || hud_rc=$?
                    invalidate_scan_cache
                    if [ "$hud_rc" -eq 10 ]; then
                        break
                    fi
                    continue
                fi

                # Launch game via isolated engine harness (zero terminal leaks, seamless background launch)
                # Engine failures are already logged and surfaced via tui_run_engine modal; do not conflate with fzf status
                tui_run_engine "Launch $sel_title" launch_game "$sel_dir" "$sel_bin" "$sel_title" || launch_rc=$?
                invalidate_scan_cache
                if [ "$launch_rc" -eq 0 ]; then
                    if verify_launched_game_startup "$sel_dir" "$sel_bin" "$sel_title"; then
                        last_status_banner="[RUNNING] $sel_title (PID $GAMECTL_VERIFY_PID) — Press Enter on it to Stop / View Logs"
                    else
                        log_msg "ERROR" "LIBRARY" "Game '$sel_title' exited immediately after launch (Log: ${GAMECTL_VERIFY_LOG:-unknown})"
                        tui_modal_notice "Launch Failed ($sel_title)" "$GAMECTL_VERIFY_SUMMARY" || true
                        last_status_banner="[FAILED] $sel_title exited immediately — Log: ${GAMECTL_VERIFY_LOG:-unknown}"
                    fi
                else
                    log_msg "WARN" "LIBRARY" "Launch returned exit code $launch_rc for $sel_title"
                    last_status_banner="[FAILED] $sel_title failed to launch (exit code $launch_rc)"
                fi
                ;;
        esac
    done

    [ "$standalone" = "true" ] && exit_tui_screen
    return 0
}

# Standalone-source compatibility: load split tui submodules when sourced directly outside bin/gamectl
if [ -z "${GAMECTL_BUNDLED:-}" ] && [ -n "${BASH_SOURCE[0]:-}" ]; then
    _tui_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    for _tui_sub in 71_previews.sh 72_store_tui.sh 73_search_tui.sh; do
        if [ -f "$_tui_dir/$_tui_sub" ]; then
            # shellcheck source=/dev/null
            source "$_tui_dir/$_tui_sub"
        fi
    done
    unset _tui_dir _tui_sub
fi

# --- [MODULE] src/tui/71_previews.sh ---
# Preview pane generator for installed games
preview_game() {
    local appid title status gdir gbin
    appid=$(strip_ansi "$1" | tr -d '[:space:]')
    title=$(strip_ansi "$2" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    status=$(strip_ansi "$3" | tr -d '][[:space:]]')
    gdir="$4"
    gbin="$5"

    # Real-time dynamic live inspection from filesystem
    if [ -n "$gdir" ] && [ -d "$gdir" ]; then
        status=$(resolve_game_drm_status "$gdir" "" "$gbin")
    fi

    local status_badge="${UI_CYAN}[${status}]${UI_RST}"
    local status_desc=""
    case "$status" in
        *VALVE_SO*)
            status_badge="${UI_AMBER}[VALVE_SO]${UI_RST}"
            status_desc="${UI_DIM}(Official Steam DRM - Requires Steam Client)${UI_RST}"
            ;;
        *VALVE_DLL*)
            status_badge="${UI_CYAN}[VALVE_DLL]${UI_RST}"
            status_desc="${UI_DIM}(Windows Steam DRM - Requires Steam + Runner)${UI_RST}"
            ;;
        *GBE_FORK*)
            status_badge="${UI_GREEN}[GBE_FORK]${UI_RST}"
            status_desc="${UI_DIM}(Goldberg Fork - Steam-Free, Full DLC, LAN Ready)${UI_RST}"
            ;;
        *STANDALONE*)
            status_badge="${UI_ICE}[STANDALONE]${UI_RST}"
            status_desc="${UI_DIM}(DRM-Free Standalone)${UI_RST}"
            ;;
    esac

    local run_dir
    run_dir="$(get_runtime_dir)"
    local is_running=false
    local run_pid=""
    local run_log=""
    local active_row=""
    active_row=$(find_active_game_for_dir "$gdir" 2>/dev/null || true)
    if [ -n "$active_row" ]; then
        local _r_title _r_dir _r_bin _r_inf _r_scope _r_sep=$'\x1f'
        IFS="$_r_sep" read -r run_pid _r_title _r_dir _r_bin run_log _r_inf _r_scope <<< "$active_row"
        is_running=true
    fi
    if [ "$is_running" = true ]; then
        status_badge="${UI_GREEN}[RUNNING PID:$run_pid]${UI_RST}"
        status_desc="${UI_DIM}(Active in background)${UI_RST}"
    fi

    echo "${UI_BOX}╭─ GAME INFORMATION ───────────────────────────────────╮${UI_RST}"
    echo "│ ${UI_BOLD}${title}${UI_RST} ${UI_DIM}(AppID: ${appid})${UI_RST}"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
    echo "  ${UI_CYAN}Status      ${UI_RST}: $status_badge $status_desc"
    echo "  ${UI_CYAN}Directory   ${UI_RST}: ${UI_DIM}$gdir${UI_RST}"
    echo "  ${UI_CYAN}Executable  ${UI_RST}: ${UI_BOLD}$gbin${UI_RST}"

    if [ -f "$gdir/$gbin" ]; then
        local arch_info
        arch_info=$(file -b "$gdir/$gbin" | cut -d',' -f1,2)
        echo "  ${UI_CYAN}Architecture${UI_RST}: ${UI_DIM}$arch_info${UI_RST}"
        if detect_steamstub_drm "$gdir/$gbin"; then
            echo "  ${UI_CYAN}DRM Stub    ${UI_RST}: ${UI_AMBER}[SteamStub .bind]${UI_RST} ${UI_DIM}(Valve Binary Stub Detected)${UI_RST}"
        fi
        local is_win=false
        case "$gbin" in *.exe|*.EXE) is_win=true ;; esac
        if [ "$is_win" = false ] && file -b "$gdir/$gbin" 2>/dev/null | grep -qi "PE32"; then
            is_win=true
        fi
        if [ "$is_win" = true ]; then
            local r_path
            r_path=$(find_runner "$gdir" 2>/dev/null || true)
            if [ -n "$r_path" ]; then
                local r_label r_short
                r_label=$(basename "$r_path")
                [ "$r_label" = "proton" ] && r_label=$(basename "$(dirname "$r_path")")
                r_short="${r_path/#$HOME/~}"
                echo "  ${UI_CYAN}Runner      ${UI_RST}: ${UI_PURPLE}$r_label${UI_RST} ${UI_DIM}($r_short)${UI_RST}"
            else
                echo "  ${UI_CYAN}Runner      ${UI_RST}: ${UI_RED}[MISSING] No Windows runner found (umu-run/Proton/wine)${UI_RST}"
            fi
            echo "  ${UI_CYAN}Prefix      ${UI_RST}: ${UI_DIM}$gdir/pfx (ISOLATED)${UI_RST}"
        else
            echo "  ${UI_CYAN}Runner      ${UI_RST}: ${UI_GREEN}Native Linux${UI_RST} ${UI_DIM}(Direct ELF/Script)${UI_RST}"
        fi
        local target_log log_hint
        target_log="${run_log:-$(get_game_log_file "$gdir" "$gbin")}"
        log_hint=$(inspect_game_log_hint "$target_log" 2>/dev/null || true)
        [ -n "$log_hint" ] && echo "  ${UI_AMBER}Log Hint    ${UI_RST}: [HINT] $log_hint"
    fi

    echo
    echo "${UI_BOX}╭─ STORAGE & SAVEGAMES ────────────────────────────────╮${UI_RST}"
    if [ -d "$gdir/saves" ]; then
        local save_sz=""
        local s_cache="$gdir/saves/.size_cache"
        local s_mtime
        s_mtime=$(stat -c%Y "$gdir/saves" 2>/dev/null || echo 0)
        if [ -f "$s_cache" ] && [ "$(head -n 1 "$s_cache" 2>/dev/null)" = "$s_mtime" ]; then
            save_sz=$(tail -n 1 "$s_cache" 2>/dev/null)
        fi
        if [ -z "$save_sz" ]; then
            save_sz=$(du -sh "$gdir/saves" 2>/dev/null | cut -f1)
            [ -w "$gdir/saves" ] && printf "%s\n%s\n" "$s_mtime" "$save_sz" > "$s_cache" 2>/dev/null || true
        fi
        echo "  ${UI_CYAN}Save Path   ${UI_RST}: ${UI_GREEN}./saves${UI_RST} ${UI_DIM}(PORTABLE - ACTIVE | Size: ${save_sz:-0B})${UI_RST}"
        if [ -d "$gdir/.save_snapshots" ]; then
            local snaps
            snaps=$(ls -d "$gdir/.save_snapshots"/slot* 2>/dev/null | wc -l)
            echo "  ${UI_CYAN}Snapshots   ${UI_RST}: ${UI_BOLD}$snaps active recovery slots${UI_RST}"
        else
            echo "  ${UI_CYAN}Snapshots   ${UI_RST}: ${UI_DIM}0 slots (Auto-created before launch)${UI_RST}"
        fi
    else
        echo "  ${UI_CYAN}Save Path   ${UI_RST}: ${UI_AMBER}Default OS (Global Steam/Home - Not Isolated)${UI_RST}"
        echo "  ${UI_CYAN}Snapshots   ${UI_RST}: ${UI_DIM}Disabled (Requires GBE Fork ./saves)${UI_RST}"
    fi

    if [ -f "$gdir/steam_settings/DLC.txt" ]; then
        local dlc_count
        dlc_count=$(grep -c "=" "$gdir/steam_settings/DLC.txt" 2>/dev/null || echo 0)
        echo "  ${UI_CYAN}DLC State   ${UI_RST}: ${UI_GREEN}$dlc_count items unlocked (Full DLC)${UI_RST}"
    fi
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

    echo
    echo "${UI_BOX}╭─ RUNTIME WRAPPERS & PERFORMANCE ─────────────────────╮${UI_RST}"
    local w_gm="${UI_DIM}[N/A]${UI_RST}" w_hud="${UI_DIM}[N/A]${UI_RST}" w_scope="${UI_DIM}[N/A]${UI_RST}"
    command -v gamemoderun >/dev/null 2>&1 && w_gm="${UI_GREEN}[READY]${UI_RST}"
    command -v mangohud >/dev/null 2>&1 && w_hud="${UI_GREEN}[READY]${UI_RST}"
    command -v gamescope >/dev/null 2>&1 && w_scope="${UI_GREEN}[READY]${UI_RST}"
    echo "  ${UI_CYAN}Host Tools  ${UI_RST}: GameMode $w_gm • MangoHud $w_hud • Gamescope $w_scope"

    local act_w=()
    load_wrapper_config "$gdir" 1
    [ "$GAMECTL_CFG_GM" = 1 ] && act_w+=("GameMode")
    [ "$GAMECTL_CFG_HUD" = 1 ] && act_w+=("MangoHud")
    [ "$GAMECTL_CFG_SCOPE" = 1 ] && act_w+=("Gamescope")
    [ "$GAMECTL_CFG_FSR" = 1 ] && act_w+=("FSR")
    [ "$GAMECTL_CFG_GLTHREAD" = 1 ] && act_w+=("MesaGL")
    [ "$GAMECTL_CFG_PRIME" = 1 ] && act_w+=("PRIME")
    [ "$GAMECTL_CFG_SANDBOX" = 1 ] && act_w+=("Sandbox")
    if [ ${#act_w[@]} -gt 0 ]; then
        echo "  ${UI_CYAN}Game Profile${UI_RST}: ${UI_BOLD}${act_w[*]}${UI_RST}"
    else
        echo "  ${UI_CYAN}Game Profile${UI_RST}: ${UI_DIM}Clean Native (Zero Wrappers)${UI_RST}"
    fi
    local c_renderer="${GAMECTL_CFG_RENDERER:-auto}" eff_renderer vk_cap_label renderer_label
    eff_renderer=$(resolve_graphics_renderer "$c_renderer" "$GAMECTL_CFG_PRIME" 2>/dev/null || echo "wined3d")
    if [ "$eff_renderer" = "wined3d" ]; then
        vk_cap_label="WineD3D"
    else
        vk_cap_label="DXVK"
    fi
    if [ "$c_renderer" = "auto" ]; then
        renderer_label="${UI_ICE}Auto ($vk_cap_label)${UI_RST}"
    else
        renderer_label="${UI_BOLD}${vk_cap_label}${UI_RST} ${UI_DIM}(forced: $c_renderer)${UI_RST}"
    fi
    echo "  ${UI_CYAN}Renderer    ${UI_RST}: $renderer_label"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

    echo
    echo "${UI_BOX}╭─ LAN MULTIPLAYER & IDENTITY ─────────────────────────╮${UI_RST}"
    if [[ "$status" =~ GBE_FORK ]]; then
        local p_info p_name p_id
        p_info=$(get_game_persona "$gdir")
        p_name=$(echo "$p_info" | cut -d'|' -f1)
        p_id=$(echo "$p_info" | cut -d'|' -f2)
        echo "  ${UI_CYAN}Player Name ${UI_RST}: ${UI_BOLD}${p_name:-Player}${UI_RST} ${UI_DIM}(SteamID64: ${p_id:-Default})${UI_RST}"
        if [ -f "$gdir/steam_settings/custom_broadcasts.txt" ]; then
            local bc_count
            bc_count=$(grep -v -E '^[[:space:]]*(#|$)' "$gdir/steam_settings/custom_broadcasts.txt" 2>/dev/null | wc -l)
            echo "  ${UI_CYAN}Broadcast   ${UI_RST}: ${UI_BOLD}$bc_count peers configured${UI_RST}"
        else
            echo "  ${UI_CYAN}Broadcast   ${UI_RST}: ${UI_DIM}Subnet default (127.0.0.1, 255.255.255.255)${UI_RST}"
        fi
    else
        echo "  ${UI_CYAN}GBE State   ${UI_RST}: ${UI_AMBER}[INACTIVE] (Official Steam/DRM binary)${UI_RST}"
        echo "  ${UI_CYAN}Note        ${UI_RST}: ${UI_DIM}Press <CTRL-I> to enable LAN co-op & custom persona${UI_RST}"
    fi
    local total_sz=""
    if [ -n "$appid" ] && [[ "$appid" =~ ^[0-9]+$ ]]; then
        local acf_path=""
        if [ -f "$gdir/appmanifest_${appid}.acf" ]; then
            acf_path="$gdir/appmanifest_${appid}.acf"
        elif [ -f "$(dirname "$gdir")/appmanifest_${appid}.acf" ]; then
            acf_path="$(dirname "$gdir")/appmanifest_${appid}.acf"
        else
            acf_path=$(find_app_acf "$appid" 2>/dev/null || true)
        fi
        if [ -n "$acf_path" ] && [ -f "$acf_path" ]; then
            local bytes_on_disk
            bytes_on_disk=$(sed -n 's/^[[:space:]]*"SizeOnDisk"[[:space:]]*"\([0-9]*\)".*/\1/p' "$acf_path" | head -n 1)
            if [ -n "$bytes_on_disk" ] && [ "$bytes_on_disk" -gt 0 ] 2>/dev/null; then
                total_sz=$(format_bytes "$bytes_on_disk")
            fi
        fi
    fi
    if [ -z "$total_sz" ]; then
        local run_dir
        run_dir="$(get_runtime_dir)"
        local sz_hash
        sz_hash=$(echo -n "$gdir" | md5sum 2>/dev/null | cut -d' ' -f1 || echo "")
        local sz_cache="$run_dir/sz_${sz_hash}.cache"
        if [ -n "$sz_hash" ] && [ -f "$sz_cache" ]; then
            total_sz=$(cat "$sz_cache" 2>/dev/null || true)
        fi
        if [ -z "$total_sz" ]; then
            total_sz=$(du -sh "$gdir" 2>/dev/null | cut -f1)
            [ -n "$sz_hash" ] && echo "$total_sz" > "$sz_cache" 2>/dev/null || true
        fi
    fi
    echo "  ${UI_CYAN}Disk Size   ${UI_RST}: ${UI_BOLD}$total_sz${UI_RST}"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

    echo
    echo "${UI_BOX}╭─ KEYBOARD SHORTCUTS ─────────────────────────────────╮${UI_RST}"
    if [ "$is_running" = true ]; then
        echo "  ${UI_PILL_ENTER} ${UI_BOLD}Manage Running Game${UI_RST} ${UI_PILL_CTRLI} ${UI_BOLD}Inject GBE Fork${UI_RST}"
    else
        echo "  ${UI_PILL_ENTER} ${UI_BOLD}Launch Game${UI_RST}       ${UI_PILL_CTRLI} ${UI_BOLD}Inject GBE Fork${UI_RST}"
    fi
    echo "  ${UI_PILL_CTRLO} ${UI_BOLD}Setup Wrappers${UI_RST}    ${UI_PILL_CTRLP} ${UI_BOLD}Configure LAN Persona${UI_RST}"
    local rhost
    rhost=$(get_remote_host)
    if [ -n "$rhost" ]; then
        echo "  ${UI_PILL_CTRLS} ${UI_BOLD}Remote Sync ($rhost)${UI_RST}   ${UI_PILL_CTRLB} ${UI_BOLD}Manual Save Snapshot${UI_RST}"
    else
        echo "  ${UI_PILL_CTRLS} ${UI_BOLD}Remote Sync (Setup)${UI_RST}   ${UI_PILL_CTRLB} ${UI_BOLD}Manual Save Snapshot${UI_RST}"
    fi
    echo "  ${UI_PILL_CTRLR} ${UI_BOLD}Restore Snapshot${UI_RST}   ${UI_PILL_CTRLX} ${UI_BOLD}Community Fixes${UI_RST}"
    echo "  ${UI_PILL_ESC}   ${UI_BOLD}Back to Master Dashboard Hub${UI_RST}"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
    echo "========================================================"
}


# Preview pane generator for Master Dashboard
preview_dashboard() {
    local item_key="${1:-1}"
    local gcount="${2:-}"

    local os_name="Linux"
    if [ -f /etc/os-release ]; then
        os_name=$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d'=' -f2 | tr -d '"')
    fi
    local kernel_info
    kernel_info=$(uname -sr)

    local disp_info="Headless/Unknown"
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        disp_info="Wayland ($WAYLAND_DISPLAY)"
        [ -n "${DISPLAY:-}" ] && disp_info="$disp_info + Xwayland ($DISPLAY)"
    elif [ -n "${DISPLAY:-}" ]; then
        disp_info="X11 ($DISPLAY)"
    fi

    [ -z "$gcount" ] && gcount=$(scan_installed_games 2>/dev/null | wc -l || echo "0")

    local def_runner
    def_runner=$(find_runner "$HOME" 2>/dev/null || true)
    local runner_str="${UI_DIM}[MISSING] Not installed${UI_RST}"
    if [ -n "$def_runner" ]; then
        runner_str="${UI_PURPLE}$(basename "$def_runner")${UI_RST} ${UI_DIM}($def_runner)${UI_RST}"
    fi

    local gbe_l64 gbe_w64
    gbe_l64=$(get_gbe_template "linux" "x64" 2>/dev/null || true)
    gbe_w64=$(get_gbe_template "windows" "x64" 2>/dev/null || true)
    local gbe_status="${UI_GREEN}[READY]${UI_RST}"
    [ -z "$gbe_l64" ] || [ -z "$gbe_w64" ] && gbe_status="${UI_AMBER}[PARTIAL]${UI_RST}"

    local w_gm="${UI_DIM}[N/A]${UI_RST}" w_hud="${UI_DIM}[N/A]${UI_RST}" w_scope="${UI_DIM}[N/A]${UI_RST}"
    command -v gamemoderun >/dev/null 2>&1 && w_gm="${UI_GREEN}[READY]${UI_RST}"
    command -v mangohud >/dev/null 2>&1 && w_hud="${UI_GREEN}[READY]${UI_RST}"
    command -v gamescope >/dev/null 2>&1 && w_scope="${UI_GREEN}[READY]${UI_RST}"

    local sls_status="${UI_DIM}[N/A]${UI_RST}" steam_status="${UI_DIM}[IDLE]${UI_RST}"
    local sls_cfg
    sls_cfg="$(get_sls_root 2>/dev/null || echo "$HOME/.config/SLSsteam")/config.yaml"
    [ -f "$sls_cfg" ] && sls_status="${UI_GREEN}[READY]${UI_RST}"
    if pgrep -x steam >/dev/null 2>&1; then
        steam_status="${UI_GREEN}[RUNNING]${UI_RST}"
    fi

    local run_dir
    run_dir="$(get_runtime_dir)"
    local active_count=0
    local active_titles=()
    local a_pid a_title _a_rest _a_sep=$'\x1f'
    while IFS="$_a_sep" read -r a_pid a_title _a_rest; do
        [ -n "$a_pid" ] || continue
        active_count=$((active_count + 1))
        active_titles+=("$a_title [PID:$a_pid]")
    done < <(list_active_games)
    local active_desc="${UI_DIM}None${UI_RST}"
    if [ "$active_count" -gt 0 ]; then
        active_desc="${UI_GREEN}$active_count running${UI_RST} ${UI_DIM}(${active_titles[*]})${UI_RST}"
    fi

    local log_file
    log_file="$(get_runtime_log_file)"

    echo "${UI_BOX}╭─ GAMECTL SOVEREIGN COCKPIT ───────────────────────────╮${UI_RST}"
    echo "│ ${UI_BOLD}SYSTEM STATUS & HARDWARE RUNTIME${UI_RST}"
    echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"
    echo "  ${UI_CYAN}Host OS     ${UI_RST}: ${UI_BOLD}$os_name${UI_RST} ${UI_DIM}($kernel_info)${UI_RST}"
    echo "  ${UI_CYAN}Display     ${UI_RST}: ${UI_BOLD}$disp_info${UI_RST}"
    echo "  ${UI_CYAN}Games Loaded${UI_RST}: ${UI_GREEN}$gcount titles detected${UI_RST}"
    echo "  ${UI_CYAN}Active Game ${UI_RST}: $active_desc"
    echo "  ${UI_CYAN}Win Runner  ${UI_RST}: $runner_str"
    echo "  ${UI_CYAN}GBE Fork    ${UI_RST}: $gbe_status ${UI_DIM}(Linux x64: $([ -n "$gbe_l64" ] && echo "OK" || echo "MISSING") | Win x64: $([ -n "$gbe_w64" ] && echo "OK" || echo "MISSING"))${UI_RST}"
    echo "  ${UI_CYAN}Tooling     ${UI_RST}: GameMode $w_gm • MangoHud $w_hud • Gamescope $w_scope"
    echo "  ${UI_CYAN}Bridge (Opt)${UI_RST}: SLSsteam $sls_status • Steam Client $steam_status"
    echo

    case "$item_key" in
        *1*|*LIBRARY*|*PUSTAKA*)
            echo "${UI_BOX}╭─ SELECTED MODULE: [01] GAME LIBRARY ──────────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}LOCAL LIBRARY & RUNTIME DEPLOYMENT METRICS${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

            local cache_file="$run_dir/scancache.tab"
            if [ ! -f "$cache_file" ]; then
                scan_installed_games >/dev/null 2>&1 || true
            fi

            local lib_total=0 lib_linux=0 lib_win=0 lib_gbe=0 lib_valve=0
            if [ -f "$cache_file" ]; then
                read -r lib_total lib_linux lib_win lib_gbe lib_valve < <(awk -F"\t" '
                    NF >= 4 {
                        tot++
                        if ($3 ~ /GBE_FORK/) gbe++
                        else if ($3 ~ /VALVE/) valve++
                        if ($5 ~ /\.(exe|EXE)$/) win++
                        else linux++
                    }
                    END {
                        printf "%d %d %d %d %d\n", tot, linux, win, gbe, valve
                    }
                ' "$cache_file")
            fi
            [ -z "$lib_total" ] || [ "$lib_total" -eq 0 ] && lib_total="${gcount:-0}"

            local storage_cache="$run_dir/lib_storage.cache"
            local storage_str="0 MB"
            if [ -f "$storage_cache" ] && [ $(($(date +%s) - $(stat -c%Y "$storage_cache" 2>/dev/null || echo 0))) -lt 60 ]; then
                storage_str=$(cat "$storage_cache" 2>/dev/null || echo "0 MB")
            elif [ -f "$cache_file" ]; then
                storage_str=$(cut -f4 "$cache_file" 2>/dev/null | sort -u | tr '\n' '\0' | xargs -0 -r du -sk 2>/dev/null | awk '{s+=$1} END {if (s>1048576) printf "%.2f GB", s/1048576; else printf "%.1f MB", s/1024}')
                [ -n "$storage_str" ] && echo "$storage_str" > "$storage_cache" 2>/dev/null || true
            fi

            echo "  ${UI_CYAN}Installed Titles   ${UI_RST}: ${UI_BOLD}${UI_GREEN}${lib_total} titles detected${UI_RST}"
            echo "  ${UI_CYAN}Storage Footprint  ${UI_RST}: ${UI_BOLD}${storage_str:-0 MB}${UI_RST}"
            echo "  ${UI_CYAN}Platform Ratio     ${UI_RST}: ${UI_BOLD}Linux ELF: $lib_linux${UI_RST} • ${UI_BOLD}Windows PE: $lib_win${UI_RST}"
            echo "  ${UI_CYAN}GBE Fork Injected  ${UI_RST}: ${UI_BOLD}${UI_GREEN}$lib_gbe titles${UI_RST} ${UI_DIM}(DRM-Free LAN Emulation)${UI_RST}"
            echo "  ${UI_CYAN}Stock / Standalone ${UI_RST}: ${UI_BOLD}$((lib_total - lib_gbe)) titles${UI_RST}"
            echo
            echo "  ${UI_DIM}Quick Shortcuts:${UI_RST}"
            echo "  • ${UI_CYAN}Ctrl-I${UI_RST} Inject GBE Fork   • ${UI_CYAN}Ctrl-O${UI_RST} Wrappers & Overrides"
            echo "  • ${UI_CYAN}Ctrl-P${UI_RST} LAN Persona       • ${UI_CYAN}Ctrl-S${UI_RST} Savegame Snapshots"
            ;;
        *2*|*SEARCH*|*PENCARIAN*)
            echo "${UI_BOX}╭─ SELECTED MODULE: [02] STEAM STORE & PROTONDB ────────╮${UI_RST}"
            echo "│ ${UI_BOLD}REMOTE CATALOG & COMPATIBILITY TELEMETRY${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

            local net_cache="$run_dir/net_status.cache"
            local steam_st="${UI_GREEN}[ONLINE]${UI_RST}" pdb_st="${UI_GREEN}[ONLINE]${UI_RST}"
            if [ -f "$net_cache" ] && [ $(($(date +%s) - $(stat -c%Y "$net_cache" 2>/dev/null || echo 0))) -lt 60 ]; then
                read -r steam_st pdb_st < "$net_cache"
            else
                if curl -s -I --connect-timeout 1 --max-time 1 "https://store.steampowered.com" >/dev/null 2>&1; then
                    steam_st="${UI_GREEN}[ONLINE]${UI_RST}"
                else
                    steam_st="${UI_RED}[OFFLINE]${UI_RST}"
                fi
                if curl -s -I --connect-timeout 1 --max-time 1 "https://www.protondb.com" >/dev/null 2>&1; then
                    pdb_st="${UI_GREEN}[ONLINE]${UI_RST}"
                else
                    pdb_st="${UI_RED}[OFFLINE]${UI_RST}"
                fi
                printf "%s %s\n" "$steam_st" "$pdb_st" > "$net_cache" 2>/dev/null || true
            fi

            local c_dir="$HOME/.cache/gamectl"
            local c_size="0B" c_steam=0 c_pdb=0
            local c_hash
            c_hash=$(printf '%s' "$c_dir" | md5sum 2>/dev/null | cut -c1-12 || echo "default")
            local c_cache="$run_dir/cache_stat_${c_hash}.cache"
            if [ -f "$c_cache" ] && [ $(($(date +%s) - $(stat -c%Y "$c_cache" 2>/dev/null || echo 0))) -lt 60 ]; then
                read -r c_size c_steam c_pdb < "$c_cache"
            elif [ -d "$c_dir" ]; then
                c_size=$(du -sh "$c_dir" 2>/dev/null | awk '{print $1}' || echo "0B")
                for f in "$c_dir"/*; do
                    [ -f "$f" ] || continue
                    local fname="${f##*/}"
                    case "$fname" in
                        *steam*|store_*) c_steam=$((c_steam + 1)) ;;
                        *proton*) c_pdb=$((c_pdb + 1)) ;;
                    esac
                done
                printf "%s %s %s\n" "$c_size" "$c_steam" "$c_pdb" > "$c_cache" 2>/dev/null || true
            fi

            echo "  ${UI_CYAN}Steam Store API    ${UI_RST}: $steam_st ${UI_DIM}(store.steampowered.com)${UI_RST}"
            echo "  ${UI_CYAN}ProtonDB API       ${UI_RST}: $pdb_st ${UI_DIM}(protondb.com/api/v1)${UI_RST}"
            echo "  ${UI_CYAN}Local Cache Dir    ${UI_RST}: ${UI_BOLD}~/.cache/gamectl/${UI_RST} ${UI_DIM}($c_size total)${UI_RST}"
            echo "  ${UI_CYAN}Cached Store Items ${UI_RST}: ${UI_BOLD}$c_steam entries${UI_RST}"
            echo "  ${UI_CYAN}Cached ProtonDB    ${UI_RST}: ${UI_BOLD}$c_pdb ratings${UI_RST}"
            echo
            echo "  ${UI_DIM}Catalog Features:${UI_RST}"
            echo "  • Live ProtonDB tier badges: Platinum, Gold, Silver, Bronze, Borked"
            echo "  • Direct metadata retrieval: Genres, Platform (Linux ELF vs Windows PE)"
            echo "  • Headless downloads via Standalone CDN or Steam native install"
            ;;
        *3*|*DOWNLOAD*|*UNDUHAN*)
            echo "${UI_BOX}╭─ SELECTED MODULE: [03] DOWNLOAD MONITOR ──────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}UNIFIED DOWNLOAD ENGINE & REAL-TIME TELEMETRY${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

            local st_count=0 steam_count=0
            local dl_items=()

            # Standalone downloads
            shopt -s nullglob
            for s_dir in "$run_dir"/depot_dl_*; do
                [ -d "$s_dir" ] || continue
                local s_base="${s_dir##*/}"
                local s_pid="${s_base##*_}"
                local s_rest="${s_base#depot_dl_}"
                local s_aid="${s_rest%_*}"
                [ -z "$s_aid" ] || [ -z "$s_pid" ] && continue
                if ! [[ "$s_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$s_pid" 2>/dev/null; then
                    continue
                fi

                local s_title="Standalone CDN Download"
                local s_info="$s_dir/status.info"
                local s_log="$s_dir/download.log"
                if [ -f "$s_info" ]; then
                    local i_title i_log
                    i_title=$(grep -E '^TITLE=' "$s_info" | cut -d= -f2- || true)
                    i_log=$(grep -E '^LOG_FILE=' "$s_info" | cut -d= -f2- || true)
                    [ -n "$i_title" ] && s_title="$i_title"
                    [ -n "$i_log" ] && [ -f "$i_log" ] && s_log="$i_log"
                fi

                local s_prog s_pct s_bytes s_st
                s_prog=$(get_depot_dl_progress "$s_log" "$s_pid" 2>/dev/null || printf "0%%\t0 MB / 0 MB\t[DOWNLOADING]\n")
                IFS=$'\t' read -r s_pct s_bytes s_st <<< "$s_prog"
                st_count=$((st_count + 1))
                dl_items+=("${UI_CYAN}$s_title${UI_RST} ${UI_GREEN}$s_pct${UI_RST} ${UI_DIM}($s_bytes - Standalone CDN)${UI_RST}")
            done

            # Steam native downloads
            local s_apps
            s_apps="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"
            for s_acf in "$s_apps"/appmanifest_*.acf; do
                [ -f "$s_acf" ] || continue
                local s_data
                s_data=$(parse_acf_download_state "$s_acf" 2>/dev/null || true)
                [ -z "$s_data" ] && continue
                local a_id a_title a_status a_pct a_dl a_total a_flags a_dir a_path
                IFS=$'\t' read -r a_id a_title a_status a_pct a_dl a_total a_flags a_dir a_path <<< "$s_data"
                if [ "$a_status" = "[DOWNLOADING]" ] || [ "$a_status" = "[PAUSED]" ] || [ "$a_status" = "[UPDATE REQUIRED]" ]; then
                    steam_count=$((steam_count + 1))
                    local d_fmt t_fmt
                    d_fmt=$(format_bytes "$a_dl")
                    t_fmt=$(format_bytes "$a_total")
                    dl_items+=("${UI_CYAN}$a_title${UI_RST} ${UI_PURPLE}$a_pct${UI_RST} ${UI_DIM}($d_fmt / $t_fmt - Steam Engine)${UI_RST}")
                fi
            done
            shopt -u nullglob

            local total_active=$((st_count + steam_count))
            echo "  ${UI_CYAN}Active Downloads   ${UI_RST}: ${UI_BOLD}${UI_GREEN}$total_active active task(s)${UI_RST}"
            echo "  ${UI_CYAN}Standalone Engine  ${UI_RST}: ${UI_BOLD}$st_count running${UI_RST} ${UI_DIM}(Direct CDN depot download)${UI_RST}"
            echo "  ${UI_CYAN}Steam Client Engine${UI_RST}: ${UI_BOLD}$steam_count running/queued${UI_RST} ${UI_DIM}(ACF manifest telemetry)${UI_RST}"
            echo
            if [ "$total_active" -gt 0 ]; then
                echo "  ${UI_BOLD}Active Tasks In Progress:${UI_RST}"
                for item in "${dl_items[@]}"; do
                    echo "  • $item"
                done
            else
                echo "  ${UI_DIM}(No active downloads currently running in background)${UI_RST}"
            fi
            echo
            echo "  ${UI_DIM}Engine Capabilities:${UI_RST}"
            echo "  • Live real-time download log streaming"
            echo "  • Interactive pause/resume and process cancellation (${UI_CYAN}Ctrl-K${UI_RST})"
            ;;
        *4*|*UNLOCK*|*ENTITLE*|*ACF*|*ADOPT*)
            echo "${UI_BOX}╭─ SELECTED MODULE: [04] STEAM ACF ADOPTION ────────────╮${UI_RST}"
            echo "│ ${UI_BOLD}PHYSICAL DISCOVERY & ASSET ADOPTION MANAGER${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

            local unadopted=()
            local total_phys=0
            if [ -d "$HOME/Games" ]; then
                for g_cand in "$HOME/Games"/*; do
                    [ -d "$g_cand" ] || continue
                    local g_base="${g_cand##*/}"
                    [[ "$g_base" =~ ^\. ]] && continue
                    total_phys=$((total_phys + 1))

                    local c_aid
                    c_aid="$(resolve_game_appid "$g_cand")"

                    local has_acf=""
                    [ -n "$c_aid" ] && has_acf=$(find_app_acf "$c_aid" 2>/dev/null || true)

                    if [ -z "$has_acf" ]; then
                        unadopted+=("$g_base [AppID:${c_aid:-N/A}]")
                    fi
                done
            fi

            local s_papps
            s_papps="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"

            echo "  ${UI_CYAN}Physical Games Dir ${UI_RST}: ${UI_BOLD}~/Games/${UI_RST} ${UI_DIM}($total_phys titles scanned)${UI_RST}"
            echo "  ${UI_CYAN}Pending Adoption   ${UI_RST}: ${UI_BOLD}${UI_AMBER}${#unadopted[@]} titles pending ACF${UI_RST}"
            echo "  ${UI_CYAN}Steam Apps Target  ${UI_RST}: ${UI_BOLD}$s_papps${UI_RST}"
            echo "  ${UI_CYAN}Steam Client State ${UI_RST}: $steam_status"
            echo
            if [ ${#unadopted[@]} -gt 0 ]; then
                echo "  ${UI_BOLD}Titles Ready For Adoption (Missing ACF Manifest):${UI_RST}"
                local u_shown=0
                for u_item in "${unadopted[@]}"; do
                    if [ "$u_shown" -ge 4 ]; then
                        echo "  • ${UI_DIM}...and $((${#unadopted[@]} - u_shown)) more title(s)${UI_RST}"
                        break
                    fi
                    echo "  • ${UI_CYAN}$u_item${UI_RST}"
                    u_shown=$((u_shown + 1))
                done
            else
                echo "  ${UI_GREEN}All physical game directories are properly adopted into Steam.${UI_RST}"
            fi
            echo
            echo "  ${UI_DIM}Adoption Workflow:${UI_RST}"
            echo "  • Dual-input adoption by Game Title or numeric AppID without prior lookup"
            echo "  • Auto-provisions physical appmanifest ACF with StateFlags=4"
            ;;
        *5*|*CONFIG*|*SETTINGS*|*KONFIGURASI*)
            echo "${UI_BOX}╭─ SELECTED MODULE: [05] GLOBAL CONFIGURATION ──────────╮${UI_RST}"
            echo "│ ${UI_BOLD}SOVEREIGN ENVIRONMENT & PREFERENCE STATE${UI_RST}"
            echo "${UI_BOX}╰───────────────────────────────────────────────────────╯${UI_RST}"

            local persona_data
            persona_data=$(get_game_persona "" 2>/dev/null || printf "Player|76561197960287930|english\n")
            local p_name p_id p_lang
            IFS='|' read -r p_name p_id p_lang <<< "$persona_data"

            local r_host
            r_host=$(get_remote_host 2>/dev/null || true)

            local act_w=()
            load_wrapper_config "" 0
            [ "$GAMECTL_CFG_GM" = 1 ] && act_w+=("GameMode")
            [ "$GAMECTL_CFG_HUD" = 1 ] && act_w+=("MangoHud")
            [ "$GAMECTL_CFG_SCOPE" = 1 ] && act_w+=("Gamescope")
            [ "$GAMECTL_CFG_FSR" = 1 ] && act_w+=("FSR")
            [ "$GAMECTL_CFG_GLTHREAD" = 1 ] && act_w+=("MesaGL")
            [ "$GAMECTL_CFG_PRIME" = 1 ] && act_w+=("PRIME")
            [ "$GAMECTL_CFG_SANDBOX" = 1 ] && act_w+=("Sandbox")
            local wrappers_desc="${UI_DIM}None (Disabled)${UI_RST}"
            [ ${#act_w[@]} -gt 0 ] && wrappers_desc="${UI_GREEN}${act_w[*]}${UI_RST}"

            local lib_paths_count=0
            if [ -f "$HOME/.config/gamectl/libraries" ]; then
                lib_paths_count=$(grep -v -E '^[[:space:]]*(#|$)' "$HOME/.config/gamectl/libraries" 2>/dev/null | wc -l || echo 0)
            fi

