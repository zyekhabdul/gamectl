#!/usr/bin/env bash
# ==============================================================================
# GAMECTL - SOVEREIGN TUI GAME MANAGER & LAUNCHER (ZERO-BLOAT)
# ==============================================================================
# Lightweight, native Linux gaming hub:
# - Library scanner for local/standalone games
# - Automatic GBE Fork / runner inspection
# - Savegame snapshot rotation (auto-backup before launch)
# - Performance profile wrapper (Mesa GL thread, CPU governor)
# - 1-key sync to remote companion host via rsync over SSH
# - Live Steam Store search + ProtonDB rating via fzf
# ==============================================================================

set -uo pipefail

SELF_BIN="$(readlink -f "${BASH_SOURCE[0]}")"
GBE_X64="${GAMECTL_GBE_X64:-$HOME/.local/share/gbe-fork/regular/x64/libsteam_api.so}"
GBE_X86="${GAMECTL_GBE_X86:-$HOME/.local/share/gbe-fork/regular/x86/libsteam_api.so}"
GBE_WIN_X64="${GAMECTL_GBE_WIN_X64:-$HOME/.local/share/gbe-fork/windows/release/regular/x64/steam_api64.dll}"
GBE_WIN_X86="${GAMECTL_GBE_WIN_X86:-$HOME/.local/share/gbe-fork/windows/release/regular/x86/steam_api.dll}"

# Resolve GBE template file based on platform and architecture
get_gbe_template() {
    local platform="$1" # "linux" or "windows"
    local arch="$2"     # "x64" or "x86"
    local p=""
    if [ "$platform" = "windows" ]; then
        if [ "$arch" = "x64" ]; then
            for p in "${GAMECTL_GBE_WIN_X64:-}" \
                     "$HOME/.local/share/gbe-fork/windows/release/regular/x64/steam_api64.dll" \
                     "$HOME/.local/share/gbe-fork/windows/regular/x64/steam_api64.dll" \
                     "$HOME/.local/share/gbe-fork/regular/x64/steam_api64.dll" \
                     "$HOME/.local/share/gbe-fork/windows/release/experimental/x64/steam_api64.dll"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        else
            for p in "${GAMECTL_GBE_WIN_X86:-}" \
                     "$HOME/.local/share/gbe-fork/windows/release/regular/x86/steam_api.dll" \
                     "$HOME/.local/share/gbe-fork/windows/regular/x86/steam_api.dll" \
                     "$HOME/.local/share/gbe-fork/regular/x86/steam_api.dll" \
                     "$HOME/.local/share/gbe-fork/windows/release/experimental/x86/steam_api.dll"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        fi
    else
        if [ "$arch" = "x64" ]; then
            for p in "${GAMECTL_GBE_X64:-}" \
                     "$HOME/.local/share/gbe-fork/regular/x64/libsteam_api.so" \
                     "$HOME/.local/share/gbe-fork/experimental/x64/libsteam_api.so"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        else
            for p in "${GAMECTL_GBE_X86:-}" \
                     "$HOME/.local/share/gbe-fork/regular/x86/libsteam_api.so" \
                     "$HOME/.local/share/gbe-fork/experimental/x86/libsteam_api.so"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        fi
    fi
    return 1
}

# Resolve remote sync host (optional)
get_remote_host() {
    local host="${GAMECTL_REMOTE_HOST:-${GAMECTL_SYNC_HOST:-${GAMECTL_TUF_HOST:-}}}"
    if [ -z "$host" ] && [ -f "$HOME/.config/gamectl/remote_host" ]; then
        host=$(head -n 1 "$HOME/.config/gamectl/remote_host" | tr -d '[:space:]')
    fi
    echo "$host"
}

# Pre-flight cleanup of orphaned sockets and locks
clean_stale_locks() {
    rm -f /tmp/SteaMidra-* /tmp/steam_chrome_shmem_* /tmp/steam_chrome_overlay_* 2>/dev/null || true
    rm -f "$HOME/.config/SLSsteam/cache/.picsbuffer.lock" 2>/dev/null || true
}

# Auto-backup savegame (Rolling 3 snapshots)
backup_save() {
    local game_dir="$1"
    local is_quiet="${2:-false}"
    local save_dir="$game_dir/saves"
    if [ -d "$save_dir" ]; then
        local snap_dir="$game_dir/.save_snapshots"
        mkdir -p "$snap_dir"
        [ -d "$snap_dir/slot2" ] && rm -rf "$snap_dir/slot3" && mv "$snap_dir/slot2" "$snap_dir/slot3"
        [ -d "$snap_dir/slot1" ] && mv "$snap_dir/slot1" "$snap_dir/slot2"
        cp -a "$save_dir" "$snap_dir/slot1"
        echo "[INFO] Save snapshot berhasil dibuat di slot1 ($snap_dir/slot1)"
    else
        if [ "$is_quiet" = true ]; then
            return 0
        fi
        echo "[WARN] Folder saves portable ($save_dir) tidak ditemukan." >&2
        echo "       Game belum di-inject GBE Fork atau belum memiliki save terisolasi." >&2
        echo "       Tekan <CTRL-I> terlebih dahulu untuk mengaktifkan portable saves." >&2
        return 1
    fi
}

# Dynamic executable finder for game directory
find_game_binary() {
    local dir="$1"
    local base
    base=$(basename "$dir")
    local clean_base="${base// /}"
    local lower_base="${base,,}"
    local lower_clean="${clean_base,,}"

    # Priority 1: Common launch scripts or matching names
    local candidates=(
        "start.sh" "run.sh" "launch.sh" "start" "run"
        "$base" "$clean_base" "$lower_base" "$lower_clean"
    )
    for c in "${candidates[@]}"; do
        if [ -x "$dir/$c" ] && [ ! -d "$dir/$c" ]; then
            echo "$c"
            return 0
        fi
    done

    # Priority 2: Any root executable file excluding assets/libs/runtime dumps
    local f fname
    for f in "$dir"/*; do
        if [ -x "$f" ] && [ ! -d "$f" ]; then
            fname=$(basename "$f")
            case "$fname" in
                *.so|*.so.*|*.dll|*.dylib|installscript.vdf|*.png|*.bmp|*.txt|*.pkg|createdump|monoconfig|monomachineconfig)
                    continue
                    ;;
                *)
                    echo "$fname"
                    return 0
                    ;;
            esac
        fi
    done

    # Priority 3: Windows executables matching title/folder name
    local win_candidates=(
        "$base.exe" "$clean_base.exe" "$lower_base.exe" "$lower_clean.exe"
    )
    for c in "${win_candidates[@]}"; do
        if [ -f "$dir/$c" ] && [ ! -d "$dir/$c" ]; then
            chmod +x "$dir/$c" 2>/dev/null || true
            echo "$c"
            return 0
        fi
    done

    # Priority 4: Any root .exe excluding setup/redist/crash handlers
    for f in "$dir"/*.exe "$dir"/*.EXE; do
        [ -f "$f" ] || continue
        fname=$(basename "$f")
        case "$fname" in
            UnityCrashHandler*|*unins*|*setup*|*installer*|*redist*|DXSETUP*|vcredist*|dotnet*|vc_redist*|*CrashReport*)
                continue
                ;;
            *)
                chmod +x "$f" 2>/dev/null || true
                echo "$fname"
                return 0
                ;;
        esac
    done

    # Priority 5: Subdirectory .exe in standard game binary folders
    for sub in "bin" "bin/x64" "bin/Win64" "Binaries/Win64" "Binaries/Win32" "x64"; do
        if [ -d "$dir/$sub" ]; then
            for f in "$dir/$sub"/*.exe "$dir/$sub"/*.EXE; do
                [ -f "$f" ] || continue
                fname=$(basename "$f")
                case "$fname" in
                    UnityCrashHandler*|*unins*|*setup*|*installer*|*redist*|DXSETUP*|vcredist*|dotnet*|vc_redist*|*CrashReport*)
                        continue
                        ;;
                    *)
                        chmod +x "$f" 2>/dev/null || true
                        echo "$sub/$fname"
                        return 0
                        ;;
                esac
            done
        fi
    done

    return 1
}

# Discover all configured Steam library paths
get_steam_libraries() {
    local primary="$HOME/.local/share/Steam/steamapps"
    [ -d "$primary" ] && echo "$primary"

    local vdf="$primary/libraryfolders.vdf"
    if [ -f "$vdf" ]; then
        local line path
        while read -r line; do
            path=$(echo "$line" | sed -E 's/.*"path"[[:space:]]+"([^"]+)".*/\1\/steamapps/')
            if [ -d "$path" ] && [ "$path" != "$primary" ]; then
                echo "$path"
            fi
        done < <(grep -E '^\s*"path"' "$vdf" 2>/dev/null || true)
    fi
}

# Scan installed games dynamically in standard & custom paths
scan_installed_games() {
    declare -A seen_dirs

    # 1. Scan Steam Libraries
    local steam_lib
    while read -r steam_lib; do
        [ -d "$steam_lib" ] || continue
        for acf in "$steam_lib"/appmanifest_*.acf; do
            [ -f "$acf" ] || continue

            local appid name installdir
            appid=$(grep -E '^\s*"appid"' "$acf" | head -n 1 | sed -E 's/.*"appid"[[:space:]]+"([0-9]+)".*/\1/')
            name=$(grep -E '^\s*"name"' "$acf" | head -n 1 | sed -E 's/.*"name"[[:space:]]+"([^"]+)".*/\1/')
            installdir=$(grep -E '^\s*"installdir"' "$acf" | head -n 1 | sed -E 's/.*"installdir"[[:space:]]+"([^"]+)".*/\1/')

            # Filter out Proton, Steam Linux Runtimes, and tools
            [[ "$name" =~ ^(Steam Linux Runtime|Proton|Steamworks) ]] && continue
            [ -z "$installdir" ] && continue

            local gdir="$steam_lib/common/$installdir"
            [ -d "$gdir" ] || continue
            [[ -v seen_dirs["$gdir"] ]] && continue
            seen_dirs["$gdir"]=1

            local gbin
            gbin=$(find_game_binary "$gdir") || continue
            [ -z "$gbin" ] && continue

            local status="STANDALONE"
            local api_file=""
            if [ -f "$gdir/libsteam_api.so" ]; then
                api_file="$gdir/libsteam_api.so"
            elif [ -f "$gdir/lib64/libsteam_api.so" ]; then
                api_file="$gdir/lib64/libsteam_api.so"
            elif [ -f "$gdir/steam_api64.dll" ]; then
                api_file="$gdir/steam_api64.dll"
            elif [ -f "$gdir/steam_api.dll" ]; then
                api_file="$gdir/steam_api.dll"
            else
                api_file=$(find "$gdir" -maxdepth 3 \( -name "libsteam_api.so" -o -name "steam_api64.dll" -o -name "steam_api.dll" \) 2>/dev/null | head -n 1)
            fi

            if [ -n "$api_file" ]; then
                local sz
                sz=$(stat -c%s "$api_file" 2>/dev/null || echo 0)
                if [ "$sz" -gt 7000000 ]; then
                    status="GBE_FORK"
                else
                    case "$api_file" in
                        *.dll) status="VALVE_DLL" ;;
                        *)     status="VALVE_SO" ;;
                    esac
                fi
            fi

            printf "%-8s\t%-22s\t%-12s\t%s\t%s\n" "$appid" "$name" "[$status]" "$gdir" "$gbin"
        done
    done < <(get_steam_libraries)

    # 2. Scan Custom & Standalone Directories
    local custom_search_dirs=(
        "$HOME/Games"
        "$HOME/.local/share/lutris/games"
    )

    # Allow extending library directories via ~/.config/gamectl/libraries or env
    if [ -f "$HOME/.config/gamectl/libraries" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line#"${line%%[![:space:]]*}"}" # trim leading
            line="${line%"${line##*[![:space:]]}"}" # trim trailing
            [ -z "$line" ] && continue
            [[ "$line" =~ ^# ]] && continue
            custom_search_dirs+=("${line/#\~/$HOME}")
        done < "$HOME/.config/gamectl/libraries"
    fi

    if [ -n "${GAMECTL_LIBRARY_DIRS:-}" ]; then
        IFS=":" read -r -a extra_dirs <<< "$GAMECTL_LIBRARY_DIRS"
        custom_search_dirs+=("${extra_dirs[@]}")
    fi

    for base_dir in "${custom_search_dirs[@]}"; do
        [ -d "$base_dir" ] || continue
        for gdir in "$base_dir"/*; do
            [ -d "$gdir" ] || continue
            [[ -v seen_dirs["$gdir"] ]] && continue
            seen_dirs["$gdir"]=1

            local folder_name
            folder_name=$(basename "$gdir")
            [[ "$folder_name" =~ ^\. ]] && continue

            local gbin
            gbin=$(find_game_binary "$gdir") || continue
            [ -z "$gbin" ] && continue

            local appid="STANDALONE"
            if [ -f "$gdir/steam_appid.txt" ]; then
                appid=$(tr -dc '0-9' < "$gdir/steam_appid.txt")
                [ -z "$appid" ] && appid="STANDALONE"
            elif [ -f "$gdir/.gamectl_appid" ]; then
                appid=$(tr -dc '0-9' < "$gdir/.gamectl_appid")
                [ -z "$appid" ] && appid="STANDALONE"
            fi

            local title="$folder_name"
            if [ -f "$gdir/.gamectl_title" ]; then
                title=$(head -n 1 "$gdir/.gamectl_title")
            fi

            local status="STANDALONE"
            local api_file=""
            if [ -f "$gdir/libsteam_api.so" ]; then
                api_file="$gdir/libsteam_api.so"
            elif [ -f "$gdir/lib64/libsteam_api.so" ]; then
                api_file="$gdir/lib64/libsteam_api.so"
            elif [ -f "$gdir/steam_api64.dll" ]; then
                api_file="$gdir/steam_api64.dll"
            elif [ -f "$gdir/steam_api.dll" ]; then
                api_file="$gdir/steam_api.dll"
            else
                api_file=$(find "$gdir" -maxdepth 3 \( -name "libsteam_api.so" -o -name "steam_api64.dll" -o -name "steam_api.dll" \) 2>/dev/null | head -n 1)
            fi

            if [ -n "$api_file" ]; then
                local sz
                sz=$(stat -c%s "$api_file" 2>/dev/null || echo 0)
                if [ "$sz" -gt 7000000 ]; then
                    status="GBE_FORK"
                else
                    case "$api_file" in
                        *.dll) status="VALVE_DLL" ;;
                        *)     status="VALVE_SO" ;;
                    esac
                fi
            fi

            printf "%-8s\t%-22s\t%-12s\t%s\t%s\n" "$appid" "$title" "[$status]" "$gdir" "$gbin"
        done
    done
}

# Preview pane generator for installed games
preview_game() {
    local appid="$1"
    local title="$2"
    local status="$3"
    local gdir="$4"
    local gbin="$5"

    echo "========================================================"
    echo " GAME DETAILS & RUNTIME STATUS"
    echo "========================================================"
    echo " Judul        : $title"
    echo " AppID        : $appid"
    local status_desc="$status"
    case "$status" in
        *VALVE_SO*)   status_desc="$status (Valve DRM Linux - Butuh Steam Client)" ;;
        *VALVE_DLL*)  status_desc="$status (Valve DRM Windows - Butuh Steam + Runner)" ;;
        *GBE_FORK*)   status_desc="$status (Goldberg Fork - Bebas Steam, Full DLC, LAN Ready)" ;;
        *STANDALONE*) status_desc="$status (DRM-Free Standalone)" ;;
    esac
    echo " Status       : $status_desc"
    echo " Direktori    : $gdir"
    echo " Executable   : $gdir/$gbin"

    if [ -f "$gdir/$gbin" ]; then
        echo " Arsitektur   : $(file -b "$gdir/$gbin" | cut -d',' -f1,2)"
        local is_win=false
        case "$gbin" in *.exe|*.EXE) is_win=true ;; esac
        if [ "$is_win" = false ] && file -b "$gdir/$gbin" 2>/dev/null | grep -qi "PE32"; then
            is_win=true
        fi
        if [ "$is_win" = true ]; then
            local r_path
            r_path=$(find_runner "$gdir" 2>/dev/null || true)
            if [ -n "$r_path" ]; then
                echo " Runner       : $(basename "$r_path") ($r_path)"
            else
                echo " Runner       : Belum terpasang (umu-run/Proton/wine)"
            fi
            echo " Wine Prefix  : $gdir/pfx (ISOLATED)"
        else
            echo " Runner       : Native Linux (Direct ELF/Script)"
        fi
    fi

    echo "--------------------------------------------------------"
    echo " SAVEGAME & STORAGE"
    if [ -d "$gdir/saves" ]; then
        echo " Save Path    : $gdir/saves (PORTABLE - AKTIF)"
        echo " Save Size    : $(du -sh "$gdir/saves" 2>/dev/null | cut -f1)"
        if [ -d "$gdir/.save_snapshots" ]; then
            local snaps
            snaps=$(ls -d "$gdir/.save_snapshots"/slot* 2>/dev/null | wc -l)
            echo " Snapshots    : $snaps slot aktif"
        else
            echo " Snapshots    : 0 slot (Akan dibuat saat launch atau Ctrl-B)"
        fi
    else
        echo " Save Path    : Default OS (Global Steam/Home - Belum terisolasi)"
        echo " Snapshots    : Nonaktif (Memerlukan GBE Fork ./saves)"
    fi

    if [ -f "$gdir/steam_settings/DLC.txt" ]; then
        local dlc_count
        dlc_count=$(grep -c "=" "$gdir/steam_settings/DLC.txt" 2>/dev/null || echo 0)
        echo " DLC Unlocked : $dlc_count item"
    fi

    echo "--------------------------------------------------------"
    echo " RUNTIME WRAPPERS & PERFORMANCE"
    local w_gm="[OFF]" w_hud="[OFF]" w_scope="[OFF]"
    command -v gamemoderun >/dev/null 2>&1 && w_gm="[READY]" || w_gm="[N/A]"
    command -v mangohud >/dev/null 2>&1 && w_hud="[READY]" || w_hud="[N/A]"
    command -v gamescope >/dev/null 2>&1 && w_scope="[READY]" || w_scope="[N/A]"
    echo " Host Tools   : GameMode $w_gm | MangoHud $w_hud | Gamescope $w_scope"

    local act_w=()
    local c_gm=0 c_hud=0 c_scope=0 c_fsr=0
    if [ -f "$HOME/.config/gamectl/wrappers" ]; then
        grep -q "^gamemode=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && c_gm=1
        grep -q -E "^(hud|mangohud)=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && c_hud=1
        grep -q "^gamescope=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && c_scope=1
        grep -q "^fsr=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && c_fsr=1
    fi
    if [ -f "$gdir/.wrappers" ]; then
        grep -q "^gamemode=1" "$gdir/.wrappers" 2>/dev/null && c_gm=1
        grep -q "^gamemode=0" "$gdir/.wrappers" 2>/dev/null && c_gm=0
        grep -q -E "^(hud|mangohud)=1" "$gdir/.wrappers" 2>/dev/null && c_hud=1
        grep -q -E "^(hud|mangohud)=0" "$gdir/.wrappers" 2>/dev/null && c_hud=0
        grep -q "^gamescope=1" "$gdir/.wrappers" 2>/dev/null && c_scope=1
        grep -q "^gamescope=0" "$gdir/.wrappers" 2>/dev/null && c_scope=0
        grep -q "^fsr=1" "$gdir/.wrappers" 2>/dev/null && c_fsr=1
        grep -q "^fsr=0" "$gdir/.wrappers" 2>/dev/null && c_fsr=0
    fi
    [ "$c_gm" = 1 ] && act_w+=("GameMode")
    [ "$c_hud" = 1 ] && act_w+=("MangoHud")
    [ "$c_scope" = 1 ] && act_w+=("Gamescope")
    [ "$c_fsr" = 1 ] && act_w+=("FSR")
    if [ ${#act_w[@]} -gt 0 ]; then
        echo " Active Profile: ${act_w[*]}"
    else
        echo " Active Profile: Default (Native / Mesa GL Thread)"
    fi

    echo "--------------------------------------------------------"
    if [[ "$status" =~ GBE_FORK ]]; then
        echo " LAN MULTIPLAYER & IDENTITY (GBE FORK: AKTIF)"
        local p_info
        p_info=$(get_game_persona "$gdir")
        local p_name p_id
        p_name=$(echo "$p_info" | cut -d'|' -f1)
        p_id=$(echo "$p_info" | cut -d'|' -f2)
        echo " Player Name  : ${p_name:-Player}"
        echo " SteamID64    : ${p_id:-Auto-Generated / Default}"
        if [ -f "$gdir/steam_settings/custom_broadcasts.txt" ]; then
            local bc_count
            bc_count=$(grep -v -E '^[[:space:]]*(#|$)' "$gdir/steam_settings/custom_broadcasts.txt" 2>/dev/null | wc -l)
            echo " Broadcast IPs: $bc_count peer terkonfigurasi"
        else
            echo " Broadcast IPs: Subnet default (127.0.0.1, 255.255.255.255)"
        fi
    else
        echo " LAN MULTIPLAYER & IDENTITY (GBE FORK: NONAKTIF)"
        echo " Status       : Belum di-inject (Biner Steam/DRM resmi aktif)"
        echo " Keterangan   : Tekan <CTRL-I> untuk mengaktifkan LAN co-op & profil custom"
    fi

    echo " Total Size   : $(du -sh "$gdir" 2>/dev/null | cut -f1)"
    echo "--------------------------------------------------------"
    echo " ACTION KEYS:"
    echo " <ENTER>       : Launch Game"
    if [[ "$status" =~ GBE_FORK ]]; then
        echo " <CTRL-I>      : Re-Inject / Update GBE Fork & Full DLC"
    else
        echo " <CTRL-I>      : Inject GBE Fork (Bebas Steam, Portable Saves & LAN)"
    fi
    echo " <CTRL-O>      : Configure Runtime Wrappers (GameMode/HUD/FSR)"
    echo " <CTRL-P>      : Configure LAN Player Persona & SteamID"
    local rhost
    rhost=$(get_remote_host)
    if [ -n "$rhost" ]; then
        echo " <CTRL-S>      : Sync Savegame to $rhost"
    else
        echo " <CTRL-S>      : Sync Savegame to Remote (Belum dikonfigurasi)"
    fi
    echo " <CTRL-B>      : Trigger Manual Save Snapshot"
    echo " <ESC>         : Back to Menu"
    echo "========================================================"
}

# Discover runner for Windows games (priority: umu-run -> GE-Proton / Proton Steam -> wine)
find_runner() {
    local target_dir="${1:-}"

    # Priority 0: Per-game runner override or environment override
    if [ -n "$target_dir" ] && [ -f "$target_dir/.runner" ]; then
        local g_runner
        g_runner=$(head -n 1 "$target_dir/.runner" | tr -d '[:space:]')
        if [ -n "$g_runner" ] && { [ -x "$g_runner" ] || command -v "$g_runner" >/dev/null 2>&1; }; then
            echo "$g_runner"
            return 0
        fi
    fi
    if [ -n "${GAMECTL_RUNNER:-}" ]; then
        if [ -x "$GAMECTL_RUNNER" ] || command -v "$GAMECTL_RUNNER" >/dev/null 2>&1; then
            echo "$GAMECTL_RUNNER"
            return 0
        fi
    fi
    if [ -f "$HOME/.config/gamectl/runner" ]; then
        local user_runner
        user_runner=$(head -n 1 "$HOME/.config/gamectl/runner" | tr -d '[:space:]')
        if [ -n "$user_runner" ] && { [ -x "$user_runner" ] || command -v "$user_runner" >/dev/null 2>&1; }; then
            echo "$user_runner"
            return 0
        fi
    fi

    # Priority 1: umu-run
    if command -v umu-run >/dev/null 2>&1; then
        echo "umu-run"
        return 0
    fi

    # Priority 2: GE-Proton / Proton in Steam compatibilitytools.d or common
    local compat_dirs=(
        "$HOME/.local/share/Steam/compatibilitytools.d"
        "$HOME/.steam/root/compatibilitytools.d"
    )
    for cdir in "${compat_dirs[@]}"; do
        [ -d "$cdir" ] || continue
        local p
        while read -r p; do
            [ -z "$p" ] && continue
            if [ -x "$p/proton" ]; then
                echo "$p/proton"
                return 0
            fi
        done < <(find "$cdir" -mindepth 1 -maxdepth 1 -type d -name "*Proton*" 2>/dev/null | sort -Vr)
    done

    # Check Proton in Steam common libraries
    local steam_lib
    while read -r steam_lib; do
        [ -d "$steam_lib/common" ] || continue
        local p
        while read -r p; do
            [ -z "$p" ] && continue
            if [ -x "$p/proton" ]; then
                echo "$p/proton"
                return 0
            fi
        done < <(find "$steam_lib/common" -mindepth 1 -maxdepth 1 -type d -name "Proton*" 2>/dev/null | sort -Vr)
    done < <(get_steam_libraries 2>/dev/null || true)

    # Priority 3: System Wine
    if command -v wine64 >/dev/null 2>&1; then
        echo "wine64"
        return 0
    elif command -v wine >/dev/null 2>&1; then
        echo "wine"
        return 0
    fi

    # Priority 4: Internal wine binary inside GE-Proton files/bin
    for cdir in "${compat_dirs[@]}"; do
        [ -d "$cdir" ] || continue
        local w
        w=$(find "$cdir" -type f -name "wine64" -o -name "wine" 2>/dev/null | head -n 1)
        if [ -n "$w" ] && [ -x "$w" ]; then
            echo "$w"
            return 0
        fi
    done

    return 1
}

# Resolve and build wrapper prefix command array (gamemoderun, mangohud, gamescope)
build_wrapper_command() {
    local gdir="$1"
    shift || true
    local opt_gamemode="" opt_hud="" opt_gamescope="" opt_fsr=""
    local remaining_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --hud|--mangohud) opt_hud=1; shift ;;
            --no-hud|--no-mangohud) opt_hud=0; shift ;;
            --gamemode) opt_gamemode=1; shift ;;
            --no-gamemode) opt_gamemode=0; shift ;;
            --gamescope) opt_gamescope=1; shift ;;
            --no-gamescope) opt_gamescope=0; shift ;;
            --fsr) opt_fsr=1; opt_gamescope=1; shift ;;
            --no-fsr) opt_fsr=0; shift ;;
            --) shift; remaining_args+=("$@"); break ;;
            *) remaining_args+=("$1"); shift ;;
        esac
    done

    # 1. Base defaults
    local use_gm=0 use_hud=0 use_scope=0 use_fsr=0
    local gscope_args="-W 1280 -H 720 -w 1920 -h 1080 -F fsr -f"

    # 2. Global configuration (~/.config/gamectl/wrappers)
    if [ -f "$HOME/.config/gamectl/wrappers" ]; then
        while IFS='=' read -r k v || [ -n "$k" ]; do
            k=$(echo "$k" | tr -d '[:space:]')
            v=$(echo "$v" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')
            [[ "$k" =~ ^# ]] && continue
            case "$k" in
                gamemode) use_gm="$v" ;;
                hud|mangohud) use_hud="$v" ;;
                gamescope) use_scope="$v" ;;
                fsr) use_fsr="$v" ;;
                gamescope_args) gscope_args="$v" ;;
            esac
        done < "$HOME/.config/gamectl/wrappers"
    fi

    # 3. Per-game override ($gdir/.wrappers)
    if [ -n "$gdir" ] && [ -f "$gdir/.wrappers" ]; then
        while IFS='=' read -r k v || [ -n "$k" ]; do
            k=$(echo "$k" | tr -d '[:space:]')
            v=$(echo "$v" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')
            [[ "$k" =~ ^# ]] && continue
            case "$k" in
                gamemode) use_gm="$v" ;;
                hud|mangohud) use_hud="$v" ;;
                gamescope) use_scope="$v" ;;
                fsr) use_fsr="$v" ;;
                gamescope_args) gscope_args="$v" ;;
            esac
        done < "$gdir/.wrappers"
    fi

    # 4. Environment variable overrides
    [ -n "${GAMECTL_GAMEMODE:-}" ] && use_gm="$GAMECTL_GAMEMODE"
    [ -n "${GAMECTL_HUD:-${GAMECTL_MANGOHUD:-}}" ] && use_hud="${GAMECTL_HUD:-$GAMECTL_MANGOHUD}"
    [ -n "${GAMECTL_GAMESCOPE:-}" ] && use_scope="$GAMECTL_GAMESCOPE"
    [ -n "${GAMECTL_FSR:-}" ] && use_fsr="$GAMECTL_FSR"
    [ -n "${GAMECTL_GAMESCOPE_ARGS:-}" ] && gscope_args="$GAMECTL_GAMESCOPE_ARGS"

    # 5. CLI flag overrides
    [ -n "$opt_gamemode" ] && use_gm="$opt_gamemode"
    [ -n "$opt_hud" ] && use_hud="$opt_hud"
    [ -n "$opt_gamescope" ] && use_scope="$opt_gamescope"
    [ -n "$opt_fsr" ] && use_fsr="$opt_fsr"

    local prefix=()
    if [ "$use_gm" = "1" ]; then
        if command -v gamemoderun >/dev/null 2>&1; then
            prefix+=("gamemoderun")
        else
            echo "[WARN] gamemoderun diaktifkan tetapi biner tidak ditemukan di PATH." >&2
        fi
    fi

    if [ "$use_hud" = "1" ]; then
        if command -v mangohud >/dev/null 2>&1; then
            prefix+=("mangohud")
        else
            echo "[WARN] mangohud diaktifkan tetapi biner tidak ditemukan di PATH." >&2
        fi
    fi

    if [ "$use_scope" = "1" ] || [ "$use_fsr" = "1" ]; then
        if command -v gamescope >/dev/null 2>&1; then
            prefix+=("gamescope")
            local active_args="$gscope_args"
            if [ "$use_fsr" = "1" ] && [[ ! "$active_args" =~ (-F|fsr|-U) ]]; then
                active_args="-F fsr $active_args"
            elif [ "$use_fsr" = "0" ]; then
                active_args=$(echo "$active_args" | sed -E 's/-F[[:space:]]+fsr//g' | xargs)
            fi
            if [ -n "$active_args" ]; then
                read -r -a parsed_args <<< "$active_args"
                prefix+=("${parsed_args[@]}")
            fi
            prefix+=("--")
        else
            echo "[WARN] gamescope diaktifkan tetapi biner tidak ditemukan di PATH." >&2
        fi
    fi

    GAMECTL_WRAPPER_PREFIX=("${prefix[@]}")
    GAMECTL_REMAINING_ARGS=("${remaining_args[@]}")
}

# Interactive wrapper configuration for a game or global defaults
configure_wrappers() {
    local gdir="$1"
    local title="${2:-$(basename "$gdir")}"
    local w_file="$gdir/.wrappers"

    local gm=0 hud=0 scope=0 fsr=0
    local gscope_args="-W 1280 -H 720 -w 1920 -h 1080 -F fsr -f"
    if [ -f "$HOME/.config/gamectl/wrappers" ]; then
        grep -q "^gamemode=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && gm=1
        grep -q -E "^(hud|mangohud)=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && hud=1
        grep -q "^gamescope=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && scope=1
        grep -q "^fsr=1" "$HOME/.config/gamectl/wrappers" 2>/dev/null && fsr=1
    fi
    if [ -f "$w_file" ]; then
        grep -q "^gamemode=1" "$w_file" 2>/dev/null && gm=1
        grep -q "^gamemode=0" "$w_file" 2>/dev/null && gm=0
        grep -q -E "^(hud|mangohud)=1" "$w_file" 2>/dev/null && hud=1
        grep -q -E "^(hud|mangohud)=0" "$w_file" 2>/dev/null && hud=0
        grep -q "^gamescope=1" "$w_file" 2>/dev/null && scope=1
        grep -q "^gamescope=0" "$w_file" 2>/dev/null && scope=0
        grep -q "^fsr=1" "$w_file" 2>/dev/null && fsr=1
        grep -q "^fsr=0" "$w_file" 2>/dev/null && fsr=0
    fi

    echo "========================================================"
    echo " KONFIGURASI RUNTIME WRAPPERS: $title"
    echo "========================================================"
    echo " Status Host:"
    echo "  • GameMode  : $(command -v gamemoderun >/dev/null 2>&1 && echo 'Tersedia' || echo 'Tidak terpasang')"
    echo "  • MangoHud  : $(command -v mangohud >/dev/null 2>&1 && echo 'Tersedia' || echo 'Tidak terpasang')"
    echo "  • Gamescope : $(command -v gamescope >/dev/null 2>&1 && echo 'Tersedia' || echo 'Tidak terpasang')"
    echo "--------------------------------------------------------"
    echo " Opsi Toggle:"
    echo "  1) GameMode (gamemoderun) : $([ "$gm" = 1 ] && echo '[AKTIF]' || echo '[NONAKTIF]')"
    echo "  2) MangoHud (FPS/Stats)   : $([ "$hud" = 1 ] && echo '[AKTIF]' || echo '[NONAKTIF]')"
    echo "  3) Gamescope Windowing    : $([ "$scope" = 1 ] && echo '[AKTIF]' || echo '[NONAKTIF]')"
    echo "  4) Gamescope FSR Upscale  : $([ "$fsr" = 1 ] && echo '[AKTIF]' || echo '[NONAKTIF]')"
    echo "  5) Preset: Full Performance (GameMode + MangoHud)"
    echo "  6) Preset: Handheld / FSR (GameMode + MangoHud + Gamescope FSR)"
    echo "  7) Reset ke Default (Semua Nonaktif)"
    echo "  8) Batal / Keluar"
    read -r -p "Pilihan toggle [1-8]: " opt
    case "$opt" in
        1) gm=$((1 - gm)) ;;
        2) hud=$((1 - hud)) ;;
        3) scope=$((1 - scope)) ;;
        4) fsr=$((1 - fsr)); [ "$fsr" = 1 ] && scope=1 ;;
        5) gm=1; hud=1; scope=0; fsr=0 ;;
        6) gm=1; hud=1; scope=1; fsr=1 ;;
        7) gm=0; hud=0; scope=0; fsr=0 ;;
        *) return 0 ;;
    esac

    cat <<EOF > "$w_file"
# Runtime wrappers for $title
gamemode=$gm
hud=$hud
gamescope=$scope
fsr=$fsr
gamescope_args=$gscope_args
EOF
    echo "[VERIFIED] Konfigurasi wrapper tersimpan di: $w_file"
    sleep 1
}

# Launch game with performance wrapping and runner isolation
launch_game() {
    local gdir="$1"
    local gbin="$2"
    local title="$3"
    shift 3 || true

    echo "[INFO] Menyiapkan peluncuran: $title..."
    backup_save "$gdir" true || true

    # Set Mesa performance env
    export mesa_glthread=true
    export vblank_mode=0

    # Attempt CPU scaling governor if permitted
    if [ -w /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
        echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true
    fi

    # Resolve wrappers and extra flags
    declare -a GAMECTL_WRAPPER_PREFIX=()
    declare -a GAMECTL_REMAINING_ARGS=()
    build_wrapper_command "$gdir" "$@"
    local wrappers=("${GAMECTL_WRAPPER_PREFIX[@]}")
    local game_args=("${GAMECTL_REMAINING_ARGS[@]}")

    if [ ${#wrappers[@]} -gt 0 ]; then
        echo "[INFO] Wrapper aktif: ${wrappers[*]}"
    fi

    cd "$gdir"

    # Check if target is a Windows executable (.exe / PE)
    local is_win=false
    case "$gbin" in
        *.exe|*.EXE) is_win=true ;;
    esac
    if [ "$is_win" = false ] && [ -f "$gdir/$gbin" ]; then
        if file -b "$gdir/$gbin" 2>/dev/null | grep -qi -E "PE32|MS Windows"; then
            is_win=true
        fi
    fi

    local exit_code=0
    if [ "$is_win" = true ]; then
        local runner_bin
        runner_bin=$(find_runner "$gdir" 2>/dev/null || true)
        if [ -z "$runner_bin" ]; then
            echo "[ERROR] Runner Windows tidak ditemukan (umu-run, Proton, atau Wine belum terpasang)." >&2
            echo "        Pasang GE-Proton di ~/.local/share/Steam/compatibilitytools.d/ atau install wine." >&2
            exit_code=1
        else
            local pfx_dir="$gdir/pfx"
            mkdir -p "$pfx_dir"
            local appid=""
            if [ -f "$gdir/steam_appid.txt" ]; then
                appid=$(tr -dc '0-9' < "$gdir/steam_appid.txt")
            fi
            [ -z "$appid" ] && appid="0"

            echo "[INFO] Meluncurkan game Windows via $(basename "$runner_bin")..."
            echo "[INFO] Wine Prefix terisolasi: $pfx_dir"

            case "$runner_bin" in
                umu-run)
                    WINEPREFIX="$pfx_dir" GAMEID="$appid" \
                    "${wrappers[@]}" umu-run "$gdir/$gbin" "${game_args[@]}" || exit_code=$?
                    ;;
                *proton*)
                    STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_CLIENT_INSTALL_PATH:-$HOME/.local/share/Steam}" \
                    STEAM_COMPAT_DATA_PATH="$gdir" \
                    STEAM_COMPAT_APP_ID="$appid" \
                    WINEPREFIX="$pfx_dir" \
                    "${wrappers[@]}" "$runner_bin" waitforexitandrun "$gdir/$gbin" "${game_args[@]}" || exit_code=$?
                    ;;
                *)
                    WINEPREFIX="$pfx_dir" \
                    "${wrappers[@]}" "$runner_bin" "$gdir/$gbin" "${game_args[@]}" || exit_code=$?
                    ;;
            esac
        fi
    else
        echo "[INFO] Menjalankan $title (Native Linux)..."
        "${wrappers[@]}" ./"$gbin" "${game_args[@]}" || exit_code=$?
    fi

    [ "$exit_code" -ne 0 ] && echo "[WARN] Game exited with code $exit_code"

    # Restore CPU governor to powersave
    if [ -w /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
        echo powersave | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true
    fi

    clean_stale_locks
    echo "[INFO] Game ditutup. Sesi bersih."
    return $exit_code
}

# Sync savegame to remote companion host
sync_save_remote() {
    local gdir="$1"
    local title="$2"
    local override_host="${3:-}"
    local sdir="$gdir/saves"
    local rhost="$override_host"
    [ -z "$rhost" ] && rhost=$(get_remote_host)

    if [ ! -d "$sdir" ]; then
        echo "[ERROR] Folder portable saves tidak ditemukan di $gdir"
        return 1
    fi

    if [ -z "$rhost" ]; then
        echo "[WARN] Target remote host belum dikonfigurasi."
        echo "       Tentukan host di ~/.config/gamectl/remote_host atau variabel GAMECTL_REMOTE_HOST."
        return 1
    fi

    echo "[INFO] Memeriksa konektivitas ke $rhost..."
    if ! ssh -q -o ConnectTimeout=1 -o BatchMode=yes "$rhost" exit 2>/dev/null; then
        echo "[WARN] Host remote '$rhost' offline atau tidak terjangkau jaringan lokal."
        return 1
    fi

    echo "[INFO] Menyinkronkan savegame $title ke $rhost..."
    local rel_path="${gdir#$HOME/}"
    ssh "$rhost" "mkdir -p ~/$rel_path"
    rsync -avzP --exclude="*.tmp" "$sdir/" "$rhost:~/$rel_path/saves/"
    echo "[VERIFIED] Sinkronisasi savegame ke $rhost selesai."
}

# Alias for backward compatibility
sync_to_tuf() {
    sync_save_remote "$@"
}

# Generate a valid 17-digit SteamID64 for individual accounts (76561197960265728 + 31-bit random int)
generate_steamid64() {
    local base=76561197960265728
    local rand=""
    if [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
        local raw
        raw=$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d ' ')
        if [ -n "$raw" ] && [ "$raw" -gt 0 ] 2>/dev/null; then
            rand=$(( raw % 2000000000 + 100000 ))
        fi
    fi
    if [ -z "$rand" ]; then
        local r1=$(( (RANDOM << 16) | RANDOM ))
        rand=$(( (r1 & 0x7FFFFFFF) % 2000000000 + 100000 ))
    fi
    echo $(( base + rand ))
}

# Resolve game LAN persona (account_name, account_steamid, language)
get_game_persona() {
    local gdir="$1"
    local p_name=""
    local p_id=""
    local p_lang="english"

    if [ -f "$gdir/steam_settings/configs.user.ini" ]; then
        p_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$gdir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        p_id=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$gdir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        p_lang=$(grep -E '^[[:space:]]*language[[:space:]]*=' "$gdir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*language[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi

    if [ -z "$p_name" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        p_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    if [ -z "$p_id" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        p_id=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi

    [ -z "$p_name" ] && p_name="${USER:-Player}"
    [ -z "$p_id" ] && p_id="${GAMECTL_STEAMID:-}"
    [ -z "$p_lang" ] && p_lang="english"

    echo "$p_name|$p_id|$p_lang"
}

# Inject GBE Fork emulator and portable saves into a game folder
inject_game() {
    local target_dir="$1"
    local appid="${2:-}"
    local sync_mode="${3:-all}"

    if [ ! -d "$target_dir" ]; then
        echo "[ERROR] Direktori target tidak ditemukan: $target_dir" >&2
        return 1
    fi

    # Canonical path
    target_dir="$(cd "$target_dir" && pwd)"

    # Resolve AppID if not provided
    if [ -z "$appid" ]; then
        if [ -f "$target_dir/steam_appid.txt" ]; then
            appid=$(tr -dc '0-9' < "$target_dir/steam_appid.txt")
        fi
        if [ -z "$appid" ]; then
            local parent_dir
            parent_dir="$(dirname "$target_dir")"
            if [ "$(basename "$parent_dir")" = "common" ]; then
                local steamapps_dir
                steamapps_dir="$(dirname "$parent_dir")"
                local base_name
                base_name="$(basename "$target_dir")"
                for acf in "$steamapps_dir"/appmanifest_*.acf; do
                    [ -f "$acf" ] || continue
                    if grep -q "\"installdir\"[[:space:]]\+\"$base_name\"" "$acf" 2>/dev/null; then
                        appid=$(grep -E '^\s*"appid"' "$acf" | head -n 1 | sed -E 's/.*"appid"[[:space:]]+"([0-9]+)".*/\1/')
                        break
                    fi
                done
            fi
        fi
    fi

    echo "[INFO] Menyiapkan injeksi GBE Fork di: $target_dir..."

    # 1. Identify Target Executable and Platform
    local gbin=""
    gbin=$(find_game_binary "$target_dir") || true

    local target_platform="linux"
    local arch="x64"
    local is_32bit=false

    # Check existing steam libraries in target folder
    local found_win64 found_win32 found_linux
    found_win64=$(find "$target_dir" -maxdepth 4 -name "steam_api64.dll" 2>/dev/null | head -n 1)
    found_win32=$(find "$target_dir" -maxdepth 4 -name "steam_api.dll" 2>/dev/null | head -n 1)
    found_linux=$(find "$target_dir" -maxdepth 4 -name "libsteam_api.so" 2>/dev/null | head -n 1)

    if [ -n "$found_win64" ] || [ -n "$found_win32" ]; then
        target_platform="windows"
        if [ -n "$found_win64" ]; then
            arch="x64"
            is_32bit=false
        else
            arch="x86"
            is_32bit=true
        fi
    elif [ -n "$found_linux" ]; then
        target_platform="linux"
        if file -b "$found_linux" | grep -qi "32-bit"; then
            arch="x86"
            is_32bit=true
        else
            arch="x64"
            is_32bit=false
        fi
    elif [ -n "$gbin" ] && [ -f "$target_dir/$gbin" ]; then
        local btype
        btype=$(file -b "$target_dir/$gbin" 2>/dev/null || echo "")
        if echo "$btype" | grep -qi -E "PE32|MS Windows|\.exe"; then
            target_platform="windows"
            if echo "$btype" | grep -qi "PE32+"; then
                arch="x64"
                is_32bit=false
            elif echo "$btype" | grep -qi "32-bit"; then
                arch="x86"
                is_32bit=true
            else
                arch="x64"
                is_32bit=false
            fi
        else
            target_platform="linux"
            if echo "$btype" | grep -qi "32-bit"; then
                arch="x86"
                is_32bit=true
            else
                arch="x64"
                is_32bit=false
            fi
        fi
    fi

    # 2. Perform Shim Injections (with backup of originals)
    local primary_shim_dir="$target_dir"

    if [ "$target_platform" = "windows" ]; then
        local win_targets=()
        if [ -n "$found_win64" ]; then
            win_targets+=("$found_win64:x64")
        fi
        if [ -n "$found_win32" ]; then
            win_targets+=("$found_win32:x86")
        fi

        # If neither found, determine destination based on detected arch or gbin location
        if [ ${#win_targets[@]} -eq 0 ]; then
            local bin_subdir="$target_dir"
            [ -n "$gbin" ] && [ -f "$target_dir/$gbin" ] && bin_subdir="$(dirname "$target_dir/$gbin")"
            if [ "$is_32bit" = true ]; then
                win_targets+=("$bin_subdir/steam_api.dll:x86")
            else
                win_targets+=("$bin_subdir/steam_api64.dll:x64")
            fi
        fi

        for entry in "${win_targets[@]}"; do
            local t_dll="${entry%%:*}"
            local t_arch="${entry##*:}"
            local t_template
            t_template=$(get_gbe_template "windows" "$t_arch") || true

            if [ -z "$t_template" ] || [ ! -f "$t_template" ]; then
                echo "[ERROR] Template GBE Fork Windows ($t_arch) tidak ditemukan." >&2
                echo "        Pastikan steam_api(64).dll tersedia di ~/.local/share/gbe-fork/windows/..." >&2
                return 1
            fi

            # Backup original Valve DLL if present (<7MB and .orig not existing)
            if [ -f "$t_dll" ]; then
                local sz
                sz=$(stat -c%s "$t_dll" 2>/dev/null || echo 0)
                if [ "$sz" -lt 7000000 ] && [ ! -f "$t_dll.orig" ]; then
                    cp -a "$t_dll" "$t_dll.orig"
                    echo "[INFO] Backup $(basename "$t_dll") asli tersimpan di: $t_dll.orig"
                fi
            fi

            mkdir -p "$(dirname "$t_dll")"
            cp "$t_template" "$t_dll"
            chmod +x "$t_dll" 2>/dev/null || true
            primary_shim_dir="$(dirname "$t_dll")"
            echo "[INFO] GBE Fork Windows DLL ($t_arch) terpasang di: $t_dll"
        done
    else
        local target_so="$target_dir/libsteam_api.so"
        if [ -n "$found_linux" ]; then
            target_so="$found_linux"
        elif [ -d "$target_dir/lib64" ] && [ "$is_32bit" = false ]; then
            target_so="$target_dir/lib64/libsteam_api.so"
        elif [ -d "$target_dir/lib32" ] && [ "$is_32bit" = true ]; then
            target_so="$target_dir/lib32/libsteam_api.so"
        fi

        local src_so
        src_so=$(get_gbe_template "linux" "$arch") || true
        if [ -z "$src_so" ] || [ ! -f "$src_so" ]; then
            echo "[ERROR] Template GBE Fork Linux ($arch) tidak ditemukan di: ${src_so:-empty}" >&2
            return 1
        fi

        # Backup original Valve SO if present (<7MB and .orig not existing)
        if [ -f "$target_so" ]; then
            local sz
            sz=$(stat -c%s "$target_so" 2>/dev/null || echo 0)
            if [ "$sz" -lt 7000000 ] && [ ! -f "$target_so.orig" ]; then
                cp -a "$target_so" "$target_so.orig"
                echo "[INFO] Backup libsteam_api.so asli tersimpan di: $target_so.orig"
            fi
        fi

        mkdir -p "$(dirname "$target_so")"
        cp "$src_so" "$target_so"
        chmod +x "$target_so"
        primary_shim_dir="$(dirname "$target_so")"
        echo "[INFO] GBE Fork Linux ELF ($arch) terpasang di: $target_so"
    fi

    # 3. Setup steam_settings and configs.user.ini
    mkdir -p "$target_dir/steam_settings"
    local user_name=""
    local steamid=""

    # Check existing game persona or global persona
    if [ -f "$target_dir/steam_settings/configs.user.ini" ]; then
        user_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$target_dir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        steamid=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$target_dir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    if [ -z "$user_name" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        user_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    if [ -z "$steamid" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        steamid=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    [ -z "$user_name" ] && user_name="${USER:-Player}"
    if [ -z "$steamid" ]; then
        if [ -n "${GAMECTL_STEAMID:-}" ]; then
            steamid="$GAMECTL_STEAMID"
        else
            steamid=$(generate_steamid64)
        fi
    fi

    cat <<EOF > "$target_dir/steam_settings/configs.user.ini"
[user::general]
account_name=$user_name
account_steamid=$steamid
language=english

[user::saves]
local_save_path=./saves
EOF

    # Scaffold custom_broadcasts.txt if missing
    if [ ! -f "$target_dir/steam_settings/custom_broadcasts.txt" ]; then
        cat <<EOF > "$target_dir/steam_settings/custom_broadcasts.txt"
# GBE Fork LAN Custom Broadcast IP list
# Tambahkan IP peer atau broadcast subnet (satu IP per baris)
127.0.0.1
255.255.255.255
EOF
    fi

    # If shim is in a subfolder, link steam_settings beside it as per GBE specification
    if [ "$primary_shim_dir" != "$target_dir" ] && [ -d "$primary_shim_dir" ]; then
        ln -sfn "$target_dir/steam_settings" "$primary_shim_dir/steam_settings" 2>/dev/null || true
    fi

    # 4. Setup isolated portable saves folder and markers
    mkdir -p "$target_dir/saves"
    echo -n "saves" > "$target_dir/local_save.txt"
    if [ "$primary_shim_dir" != "$target_dir" ] && [ -d "$primary_shim_dir" ]; then
        echo -n "saves" > "$primary_shim_dir/local_save.txt" 2>/dev/null || true
        ln -sfn "$target_dir/saves" "$primary_shim_dir/saves" 2>/dev/null || true
    fi

    # 5. Write steam_appid.txt if available
    if [ -n "$appid" ] && [ "$appid" != "STANDALONE" ]; then
        echo -n "$appid" > "$target_dir/steam_appid.txt"
        if [ "$primary_shim_dir" != "$target_dir" ] && [ -d "$primary_shim_dir" ]; then
            echo -n "$appid" > "$primary_shim_dir/steam_appid.txt" 2>/dev/null || true
        fi
        echo "[INFO] AppID $appid terdaftar di: $target_dir/steam_appid.txt"
        fetch_dlc "$target_dir" "$appid"
        if [ "$sync_mode" != "--no-sync" ] && [ "$sync_mode" != "no-sync" ] && [ "$sync_mode" != "standalone" ]; then
            sync_steam "$appid" "$(basename "$target_dir")" "$target_dir"
        else
            echo "[INFO] Mode Standalone aktif: Melewati sinkronisasi Steam Client."
        fi
    fi

    echo "[VERIFIED] Game berhasil diinjeksi GBE Fork (Platform: $target_platform, Arsitektur: $arch, Save: ./saves, AppID: ${appid:-None})"
}

# Set LAN Player Name, SteamID, and broadcast IPs for GBE Fork co-op
set_id() {
    local player_name="${1:-}"
    shift || true

    if [ -z "$player_name" ]; then
        echo "Usage: gamectl set-id <player_name> [steamid] [target_dir] [--broadcast <ip>] [--global]" >&2
        return 1
    fi

    local steamid=""
    local target_dir=""
    local broadcast_ips=()
    local save_global=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --global)
                save_global=true
                shift
                ;;
            --broadcast)
                if [ -n "${2:-}" ]; then
                    broadcast_ips+=("$2")
                    shift 2
                else
                    shift
                fi
                ;;
            --broadcast=*)
                broadcast_ips+=("${1#*=}")
                shift
                ;;
            *)
                if [ -z "$steamid" ] && { [[ "$1" =~ ^7656119[0-9]{10}$ ]] || [ "$1" = "auto" ] || [ "$1" = "random" ]; }; then
                    if [ "$1" = "auto" ] || [ "$1" = "random" ]; then
                        steamid=$(generate_steamid64)
                    else
                        steamid="$1"
                    fi
                elif [ -z "$target_dir" ] && [ -d "$1" ]; then
                    target_dir="$1"
                elif [ -z "$steamid" ] && [[ "$1" =~ ^[0-9]+$ ]] && [ ${#1} -eq 17 ]; then
                    steamid="$1"
                else
                    if [ -z "$target_dir" ]; then
                        target_dir="$1"
                    fi
                fi
                shift
                ;;
        esac
    done

    # Generate steamid if still empty
    if [ -z "$steamid" ]; then
        steamid=$(generate_steamid64)
    fi

    # Determine target directory
    if [ -z "$target_dir" ]; then
        if [ -d "./steam_settings" ] || [ -f "./steam_appid.txt" ]; then
            target_dir="."
        else
            save_global=true
        fi
    fi

    # Save to global config if requested or if no game directory identified
    if [ "$save_global" = true ]; then
        mkdir -p "$HOME/.config/gamectl"
        cat <<EOF > "$HOME/.config/gamectl/persona"
# gamectl global persona
account_name=$player_name
account_steamid=$steamid
language=english
EOF
        echo "[INFO] Identitas global tersimpan di ~/.config/gamectl/persona ($player_name | $steamid)"
    fi

    if [ -n "$target_dir" ] && [ -d "$target_dir" ]; then
        target_dir="$(cd "$target_dir" && pwd)"
        mkdir -p "$target_dir/steam_settings"

        local ini_file="$target_dir/steam_settings/configs.user.ini"
        if [ -f "$ini_file" ]; then
            if grep -q -E '^[[:space:]]*account_name[[:space:]]*=' "$ini_file"; then
                sed -i -E "s/^[[:space:]]*account_name[[:space:]]*=.*/account_name=$player_name/" "$ini_file"
            else
                echo "account_name=$player_name" >> "$ini_file"
            fi
            if grep -q -E '^[[:space:]]*account_steamid[[:space:]]*=' "$ini_file"; then
                sed -i -E "s/^[[:space:]]*account_steamid[[:space:]]*=.*/account_steamid=$steamid/" "$ini_file"
            else
                echo "account_steamid=$steamid" >> "$ini_file"
            fi
        else
            cat <<EOF > "$ini_file"
[user::general]
account_name=$player_name
account_steamid=$steamid
language=english

[user::saves]
local_save_path=./saves
EOF
        fi

        # Handle custom_broadcasts.txt
        local bc_file="$target_dir/steam_settings/custom_broadcasts.txt"
        if [ ! -f "$bc_file" ]; then
            cat <<EOF > "$bc_file"
# GBE Fork LAN Custom Broadcast IP list
# Tambahkan IP peer atau broadcast subnet (satu IP per baris)
127.0.0.1
255.255.255.255
EOF
        fi

        if [ ${#broadcast_ips[@]} -gt 0 ]; then
            for ip in "${broadcast_ips[@]}"; do
                IFS=',' read -ra split_ips <<< "$ip"
                for s_ip in "${split_ips[@]}"; do
                    s_ip=$(echo "$s_ip" | tr -d ' ')
                    [ -z "$s_ip" ] && continue
                    if ! grep -q -F "$s_ip" "$bc_file" 2>/dev/null; then
                        echo "$s_ip" >> "$bc_file"
                        echo "[INFO] Ditambahkan broadcast IP: $s_ip"
                    fi
                done
            done
        fi

        # Ensure symlinks to subfolders if shim exists in subdirectory
        for shim_candidate in "$target_dir"/*/*.dll "$target_dir"/*/*/*.dll "$target_dir"/*/*.so "$target_dir"/*/*/*.so; do
            if [ -f "$shim_candidate" ]; then
                local s_dir
                s_dir="$(dirname "$shim_candidate")"
                if [ "$s_dir" != "$target_dir" ] && [ -d "$s_dir" ]; then
                    ln -sfn "$target_dir/steam_settings" "$s_dir/steam_settings" 2>/dev/null || true
                fi
            fi
        done

        echo "[VERIFIED] Identitas LAN game diperbarui di $target_dir:"
        echo "           Nama Pemain : $player_name"
        echo "           SteamID64   : $steamid"
        echo "           Config File : $ini_file"
    fi
}

# Interactive TUI configurator for LAN persona & SteamID
set_id_interactive() {
    local target_dir="${1:-}"
    local title="${2:-}"
    if [ -z "$target_dir" ] || [ ! -d "$target_dir" ]; then
        echo "[ERROR] Direktori game tidak valid: $target_dir" >&2
        return 1
    fi
    target_dir="$(cd "$target_dir" && pwd)"
    [ -z "$title" ] && title="$(basename "$target_dir")"

    local p_info
    p_info=$(get_game_persona "$target_dir")
    local cur_name cur_id cur_lang
    cur_name=$(echo "$p_info" | cut -d'|' -f1)
    cur_id=$(echo "$p_info" | cut -d'|' -f2)
    cur_lang=$(echo "$p_info" | cut -d'|' -f3)

    echo ""
    echo "========================================================"
    echo " KONFIGURASI IDENTITAS LAN & STEAMID (GBE FORK)"
    echo "========================================================"
    echo " Target Game   : $title"
    echo " Direktori     : $target_dir"
    echo " Nama Pemain   : ${cur_name:-[Belum diset]}"
    echo " SteamID64     : ${cur_id:-[Belum diset]}"
    echo "--------------------------------------------------------"

    read -r -p "Nama Pemain LAN [${cur_name}]: " in_name
    [ -z "$in_name" ] && in_name="$cur_name"
    [ -z "$in_name" ] && in_name="${USER:-Player}"

    local suggested_id
    suggested_id=$(generate_steamid64)
    read -r -p "SteamID64 (Ketik 'random' untuk acak baru) [${cur_id:-$suggested_id}]: " in_id
    [ -z "$in_id" ] && in_id="${cur_id:-$suggested_id}"
    if [ "$in_id" = "random" ] || [ "$in_id" = "auto" ]; then
        in_id=$(generate_steamid64)
    fi

    echo ""
    echo "Konfigurasi Peer Broadcast LAN (Opsional):"
    echo "Ketik IP LAN teman (misal: 192.168.1.50) atau tekan Enter untuk lewati."
    read -r -p "Peer/Broadcast IP: " in_bc

    read -r -p "Simpan juga sebagai identitas default global? (y/N): " in_glob

    local extra_args=()
    [ -n "$in_bc" ] && extra_args+=(--broadcast "$in_bc")
    case "$in_glob" in
        y|Y|yes|YES) extra_args+=(--global) ;;
    esac

    set_id "$in_name" "$in_id" "$target_dir" "${extra_args[@]}"
    echo ""
    read -r -p "Tekan [ENTER] untuk kembali ke pustaka..."
}

# Fetch and generate steam_settings/DLC.txt for GBE Fork
fetch_dlc() {
    local target_dir="$1"
    local appid="${2:-}"

    if [ ! -d "$target_dir" ]; then
        echo "[ERROR] Direktori target tidak ditemukan: $target_dir" >&2
        return 1
    fi

    target_dir="$(cd "$target_dir" && pwd)"

    # Resolve AppID if not provided
    if [ -z "$appid" ]; then
        if [ -f "$target_dir/steam_appid.txt" ]; then
            appid=$(tr -dc '0-9' < "$target_dir/steam_appid.txt")
        fi
    fi

    if [ -z "$appid" ] || [ "$appid" = "STANDALONE" ]; then
        echo "[WARN] AppID numerik tidak ditemukan. Melewati pembuatan DLC.txt."
        return 0
    fi

    echo "[INFO] Mengambil daftar DLC untuk AppID $appid dari Steam API..."
    local dlc_file="$target_dir/steam_settings/DLC.txt"
    mkdir -p "$target_dir/steam_settings"

    # Primary: dlcforapp endpoint (names & IDs in single call)
    local dlc_data=""
    dlc_data=$(curl -s --connect-timeout 4 "https://store.steampowered.com/api/dlcforapp/?appid=${appid}" | jq -r '.dlc[]? | "\(.id)=\(.name)"' 2>/dev/null || true)

    # Fallback: appdetails basic,dlc
    if [ -z "$dlc_data" ]; then
        local dlc_ids
        dlc_ids=$(curl -s --connect-timeout 4 "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=basic,dlc" | jq -r ".\"${appid}\".data.dlc[]?" 2>/dev/null || true)
        if [ -n "$dlc_ids" ]; then
            dlc_data=""
            while read -r did; do
                [ -n "$did" ] && dlc_data+="${did}=DLC_${did}"$'\n'
            done <<< "$dlc_ids"
        fi
    fi

    if [ -n "$dlc_data" ]; then
        echo -n "$dlc_data" > "$dlc_file"
        # Ensure trailing newline
        [ -s "$dlc_file" ] && echo "" >> "$dlc_file"
        local count
        count=$(grep -c "=" "$dlc_file" || echo 0)
        echo "[VERIFIED] Berhasil menulis $count DLC ke: $dlc_file"
    else
        touch "$dlc_file"
        echo "[INFO] Tidak ada DLC yang ditemukan di Steam API. File kosong: $dlc_file"
    fi
}

# Ensure DepotDownloader runtime is available
ensure_downloader() {
    local depot_bin=""
    if command -v depotdownloader >/dev/null 2>&1; then
        depot_bin="$(command -v depotdownloader)"
    elif [ -x "$HOME/.local/share/gamectl/bin/DepotDownloader" ]; then
        depot_bin="$HOME/.local/share/gamectl/bin/DepotDownloader"
    elif [ -x "$HOME/.local/bin/depotdownloader" ]; then
        depot_bin="$HOME/.local/bin/depotdownloader"
    else
        echo "[INFO] Mengunduh DepotDownloader standalone binary..." >&2
        mkdir -p "$HOME/.local/share/gamectl/bin" "$HOME/.local/bin"
        local dl_url="https://github.com/SteamRE/DepotDownloader/releases/download/DepotDownloader_3.4.0/DepotDownloader-linux-x64.zip"
        if curl -sL "$dl_url" -o /tmp/depotdownloader.zip 2>/dev/null; then
            unzip -q -o /tmp/depotdownloader.zip -d "$HOME/.local/share/gamectl/bin/"
            chmod +x "$HOME/.local/share/gamectl/bin/DepotDownloader"
            ln -sf "$HOME/.local/share/gamectl/bin/DepotDownloader" "$HOME/.local/bin/depotdownloader"
            rm -f /tmp/depotdownloader.zip
            depot_bin="$HOME/.local/share/gamectl/bin/DepotDownloader"
            echo "[VERIFIED] DepotDownloader terpasang di $depot_bin" >&2
        else
            echo "[ERROR] Gagal mengunduh DepotDownloader dari GitHub." >&2
            return 1
        fi
    fi
    echo "$depot_bin"
}

# Headless Game Downloader (Pengganti ACCELA & SteaMidra)
download_game() {
    local appid="${1:-}"
    if [ -z "$appid" ]; then
        echo "Usage: gamectl download <appid> [target_dir] [title] [--raw|--inject-only|--all] [--foreground|-f]" >&2
        return 1
    fi
    shift

    local target_dir=""
    local title=""
    local action="all"     # "all", "inject", "raw"
    local exec_mode="bg"   # "bg" or "fg"

    while [ $# -gt 0 ]; do
        case "$1" in
            --raw|--download-only|--no-inject)
                action="raw"
                ;;
            --inject-only|--standalone|--no-sync)
                action="inject"
                ;;
            --all)
                action="all"
                ;;
            --foreground|-f|foreground)
                exec_mode="fg"
                ;;
            --background|-b|background)
                exec_mode="bg"
                ;;
            *)
                if [ -z "$target_dir" ]; then
                    target_dir="$1"
                elif [ -z "$title" ]; then
                    title="$1"
                fi
                ;;
        esac
        shift
    done

    local depot_bin
    depot_bin=$(ensure_downloader) || return 1

    if [ -z "$title" ]; then
        title=$(curl -s --connect-timeout 4 "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=basic" | jq -r ".\"${appid}\".data.name // empty" 2>/dev/null || true)
        [ -z "$title" ] && title="AppID_${appid}"
    fi

    local safe_title
    safe_title=$(echo "$title" | tr -cd '[:alnum:] _-')
    [ -z "$safe_title" ] && safe_title="$appid"

    if [ -z "$target_dir" ]; then
        target_dir="$HOME/Games/$safe_title"
    fi

    mkdir -p "$target_dir"
    target_dir="$(cd "$target_dir" && pwd)"
    local log_file="/tmp/gamectl_dl_${appid}.log"

    local extra_args=()
    local user_cfg="$HOME/.config/gamectl/steam_user"
    local steam_user="${GAMECTL_STEAM_USER:-}"
    if [ -z "$steam_user" ] && [ -f "$user_cfg" ]; then
        steam_user=$(head -n 1 "$user_cfg" | tr -d '[:space:]')
    fi
    if [ -n "$steam_user" ]; then
        extra_args+=("-username" "$steam_user" "-remember-password")
    fi

    echo "=========================================="
    echo " HEADLESS GAME DOWNLOADER (DepotDownloader)"
    echo "=========================================="
    echo " AppID     : $appid"
    echo " Judul     : $title"
    echo " Target    : $target_dir"
    echo " Paket     : $action (raw / inject / all)"
    echo " Log Stream: $log_file"
    [ -n "$steam_user" ] && echo " Steam User: $steam_user"
    echo "=========================================="

    if [ "$exec_mode" = "fg" ]; then
        echo "[INFO] Menjalankan unduhan di foreground..."
        echo "[INFO] Mulai unduh AppID $appid ke $target_dir pada $(date)" > "$log_file"
        "$depot_bin" -app "$appid" -os linux "${extra_args[@]}" -dir "$target_dir" 2>&1 | tee -a "$log_file"
        local dl_status="${PIPESTATUS[0]}"
        if [ "$dl_status" -eq 0 ]; then
            case "$action" in
                raw)
                    echo "[SUCCESS] Unduhan aset mentah selesai untuk $title ($appid)."
                    ;;
                inject)
                    echo "[INFO] Menjalankan injeksi GBE Fork standalone..."
                    "$SELF_BIN" inject "$target_dir" "$appid" --no-sync
                    echo "[SUCCESS] Unduh dan injeksi standalone selesai untuk $title ($appid)."
                    ;;
                all|*)
                    echo "[INFO] Menjalankan injeksi GBE Fork dan sinkronisasi Steam Client..."
                    "$SELF_BIN" inject "$target_dir" "$appid"
                    echo "[SUCCESS] Instalasi All-in-One selesai untuk $title ($appid)."
                    ;;
            esac
        else
            echo "[ERROR] Unduhan gagal (exit code: $dl_status). Cek: $log_file" >&2
            return "$dl_status"
        fi
    else
        echo "[INFO] Meluncurkan proses unduh di background..."
        (
            echo "[INFO] Mulai unduh AppID $appid ke $target_dir pada $(date)" > "$log_file"
            "$depot_bin" -app "$appid" -os linux "${extra_args[@]}" -dir "$target_dir" >> "$log_file" 2>&1
            local bg_status=$?
            if [ $bg_status -eq 0 ]; then
                case "$action" in
                    raw)
                        echo "[SUCCESS] Unduhan aset mentah selesai untuk $title ($appid) pada $(date)." >> "$log_file"
                        ;;
                    inject)
                        echo "[INFO] Menjalankan injeksi GBE Fork standalone..." >> "$log_file"
                        "$SELF_BIN" inject "$target_dir" "$appid" --no-sync >> "$log_file" 2>&1
                        echo "[SUCCESS] Unduh dan injeksi standalone selesai untuk $title ($appid) pada $(date)." >> "$log_file"
                        ;;
                    all|*)
                        echo "[INFO] Menjalankan auto-inject dan sinkronisasi Steam Client..." >> "$log_file"
                        "$SELF_BIN" inject "$target_dir" "$appid" >> "$log_file" 2>&1
                        echo "[SUCCESS] Pemasangan lengkap All-in-One selesai untuk $title ($appid) pada $(date)." >> "$log_file"
                        ;;
                esac
            else
                echo "[ERROR] Unduhan gagal (exit code: $bg_status) pada $(date)." >> "$log_file"
            fi
        ) &
        local pid=$!
        echo "[VERIFIED] Unduhan berjalan di background (PID: $pid)."
        echo "Pantau progres: tail -f $log_file"
    fi
}

# List active and recent downloads
list_downloads() {
    echo "=========================================="
    echo " STATUS UNDUHAN GAMECTL (DepotDownloader)"
    echo "=========================================="
    local count=0
    for log in /tmp/gamectl_dl_*.log; do
        [ -f "$log" ] || continue
        count=$((count + 1))
        local appid
        appid=$(basename "$log" | sed -E 's/gamectl_dl_([0-9]+)\.log/\1/')
        local status="[SELESAI/BERHENTI]"
        if pgrep -f "DepotDownloader.*-app ${appid}" >/dev/null 2>&1; then
            status="[SEDANG MENGUNDUH]"
        fi
        echo "$status AppID: $appid | Log: $log"
        tail -n 2 "$log" 2>/dev/null | sed 's/^/  > /'
        echo "------------------------------------------"
    done
    if [ $count -eq 0 ]; then
        echo "[INFO] Tidak ada riwayat atau proses unduhan aktif di /tmp/."
    fi
}

# Dual-Mode Steam Client & SLSsteam Full DLC Sync
sync_steam() {
    local appid="$1"
    local title="${2:-}"
    local game_dir="${3:-}"

    if [ -z "$appid" ] || [ "$appid" = "STANDALONE" ]; then
        echo "[WARN] AppID numerik tidak valid. Melewati sinkronisasi Steam." >&2
        return 0
    fi

    if [ -z "$title" ]; then
        title="AppID_${appid}"
    fi

    local safe_title
    safe_title=$(echo "$title" | tr -cd '[:alnum:] _-')
    [ -z "$safe_title" ] && safe_title="$appid"

    echo "[INFO] Sinkronisasi Steam Client & SLSsteam untuk: $title ($appid)..."

    # 1. Fetch DLC mapping via Steam API
    local dlc_json
    dlc_json=$(curl -s --connect-timeout 4 "https://store.steampowered.com/api/dlcforapp/?appid=${appid}" 2>/dev/null || echo "{}")

    # 2. Update ~/.config/SLSsteam/config.yaml using ruamel.yaml
    local sls_cfg="$HOME/.config/SLSsteam/config.yaml"
    if [ -f "$sls_cfg" ]; then
        python3 -c "
import sys, json

cfg_path = sys.argv[1]
appid = int(sys.argv[2])
dlc_raw = sys.argv[3]

has_ruamel = False
try:
    from ruamel.yaml import YAML
    yaml_engine = YAML()
    yaml_engine.preserve_quotes = True
    has_ruamel = True
except Exception:
    try:
        import yaml as pyyaml
    except Exception:
        print('[ERROR] Tidak ditemukan library YAML di Python (ruamel.yaml atau pyyaml)', file=sys.stderr)
        sys.exit(1)

try:
    with open(cfg_path, 'r') as f:
        if has_ruamel:
            data = yaml_engine.load(f) or {}
        else:
            data = pyyaml.safe_load(f) or {}

    if 'AppIds' not in data or data['AppIds'] is None:
        data['AppIds'] = []
    if appid not in data['AppIds']:
        data['AppIds'].append(appid)

    if 'AdditionalApps' not in data or data['AdditionalApps'] is None:
        data['AdditionalApps'] = []
    if appid not in data['AdditionalApps']:
        data['AdditionalApps'].append(appid)

    dlc_obj = json.loads(dlc_raw)
    dlc_list = dlc_obj.get('dlc', [])
    if dlc_list:
        if 'DlcData' not in data or data['DlcData'] is None:
            data['DlcData'] = {}
        if appid not in data['DlcData'] or data['DlcData'][appid] is None:
            data['DlcData'][appid] = {}
        for item in dlc_list:
            d_id = int(item['id'])
            d_name = item.get('name', f'DLC {d_id}')
            data['DlcData'][appid][d_id] = d_name

    with open(cfg_path, 'w') as f:
        if has_ruamel:
            yaml_engine.dump(data, f)
        else:
            pyyaml.dump(data, f, default_flow_style=False, sort_keys=False)
    engine_name = 'ruamel.yaml' if has_ruamel else 'pyyaml (fallback)'
    print(f'[VERIFIED] SLSsteam config.yaml: AppID {appid} dan {len(dlc_list)} DLC terdaftar ({engine_name}).')
except Exception as e:
    print(f'[WARN] SLSsteam config sync notice: {e}', file=sys.stderr)
" "$sls_cfg" "$appid" "$dlc_json" 2>/dev/null || true
    fi

    # 3. Create appmanifest_<appid>.acf in Steam steamapps
    local steam_apps="$HOME/.local/share/Steam/steamapps"
    if [ -d "$steam_apps" ]; then
        local acf_file="$steam_apps/appmanifest_${appid}.acf"
        local install_name="$safe_title"
        local size_bytes="1000000000"
        local steamid="${GAMECTL_STEAMID:-76561198609877617}"

        if [ -n "$game_dir" ] && [ -d "$game_dir" ]; then
            install_name="$(basename "$game_dir")"
            local calc_sz
            calc_sz=$(du -sb "$game_dir" 2>/dev/null | awk '{print $1}')
            [ -n "$calc_sz" ] && [ "$calc_sz" -gt 0 ] && size_bytes="$calc_sz"
        fi

        cat <<ACF > "$acf_file"
"AppState"
{
	"appid"		"$appid"
	"Universe"		"1"
	"name"		"$safe_title"
	"StateFlags"		"4"
	"installdir"		"$install_name"
	"LastUpdated"		"$(date +%s)"
	"SizeOnDisk"		"$size_bytes"
	"buildid"		"1"
	"LastOwner"		"$steamid"
	"UserConfig"
	{
		"language"		"english"
	}
	"MountedConfig"
	{
		"language"		"english"
	}
}
ACF
        # Symlink in steamapps/common if game_dir is external, or ensure install dir exists
        mkdir -p "$steam_apps/common"
        if [ -n "$game_dir" ] && [ -d "$game_dir" ]; then
            local common_target="$steam_apps/common/$install_name"
            if [ ! -e "$common_target" ]; then
                ln -sf "$game_dir" "$common_target"
                echo "[INFO] Symlink common dibuat: $common_target -> $game_dir"
            fi
        else
            mkdir -p "$steam_apps/common/$install_name"
        fi
        echo "[VERIFIED] appmanifest_${appid}.acf terdaftar (Status: Terinstal di Steam, Size: $size_bytes bytes)."
    fi
}

# Unlock game in official Steam client without downloading game files
unlock_game() {
    local appid="${1:-}"
    local title="${2:-}"

    if [ -z "$appid" ]; then
        echo "Usage: gamectl unlock <appid> [title]" >&2
        return 1
    fi

    if [ -z "$title" ]; then
        echo "[INFO] Mengambil judul game untuk AppID $appid dari Steam Store API..."
        title=$(curl -s --connect-timeout 4 "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=basic" | jq -r ".\"${appid}\".data.name // empty" 2>/dev/null || true)
        [ -z "$title" ] && title="AppID_${appid}"
    fi

    echo "=========================================="
    echo " UNLOCK STEAM TANPA DOWNLOAD (Full DLC)"
    echo "=========================================="
    echo " AppID : $appid"
    echo " Judul : $title"
    echo "=========================================="

    sync_steam "$appid" "$title" ""
    echo "[SUCCESS] Game '$title' ($appid) telah dibuka di Steam resmi dengan Full DLC tanpa download."
}

# Main Library View
library_menu() {
    clean_stale_locks

    while true; do
        local selection
        selection=$(scan_installed_games | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2,3 \
            --header="GAMECTL LIBRARY (Enter: Launch | Ctrl-O: Wrappers | Ctrl-P: Persona | Ctrl-I: Inject | Ctrl-S: Sync | Ctrl-B: Backup)" \
            --prompt="Game > " \
            --preview="$SELF_BIN --preview {1} {2} {3} {4} {5}" \
            --preview-window=right:55%:wrap \
            --bind="ctrl-o:execute($SELF_BIN configure-wrappers {4} {2})+reload($SELF_BIN --list)" \
            --bind="ctrl-p:execute($SELF_BIN set-id-interactive {4} {2})+reload($SELF_BIN --list)" \
            --bind="ctrl-i:execute($SELF_BIN inject {4} {1}; $SELF_BIN sync-steam {1} {2} {4}; read -n 1 -s -r -p 'Tekan tombol apa saja untuk kembali ke pustaka...')+reload($SELF_BIN --list)" \
            --bind="ctrl-s:execute($SELF_BIN --sync {4} {2}; read -n 1 -s -r -p 'Tekan tombol apa saja untuk lanjut...')" \
            --bind="ctrl-b:execute($SELF_BIN --backup {4}; read -n 1 -s -r -p 'Tekan tombol apa saja untuk lanjut...')" \
        ) || break

        if [ -n "$selection" ]; then
            local sel_dir sel_bin sel_title
            sel_dir=$(echo "$selection" | awk -F'\t' '{print $4}')
            sel_bin=$(echo "$selection" | awk -F'\t' '{print $5}')
            sel_title=$(echo "$selection" | awk -F'\t' '{print $2}')
            launch_game "$sel_dir" "$sel_bin" "$sel_title"
            read -r -p "Tekan [ENTER] untuk kembali ke Library..."
        fi
    done
}

# Live Steam Search View (Actionable TUI Search)
search_steam() {
    echo -n "Masukkan nama game yang dicari: "
    read -r query
    [ -z "$query" ] && return

    echo "[INFO] Mencari '$query' di Steam Store API..."
    local encoded_query
    encoded_query=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
    local raw_results
    raw_results=$(curl -s --connect-timeout 5 "https://store.steampowered.com/api/storesearch/?term=${encoded_query}&l=english&cc=US" 2>/dev/null)

    local items
    items=$(echo "$raw_results" | jq -r '.items[]? | "\(.id)\t\(.name)"' 2>/dev/null || true)

    if [ -z "$items" ]; then
        echo "[INFO] Game tidak ditemukan."
        sleep 1
        return
    fi

    # Build list with local installed status across all libraries
    local results=""
    local steam_libs=()
    mapfile -t steam_libs < <(get_steam_libraries)

    while IFS=$'\t' read -r appid name; do
        [ -z "$appid" ] && continue
        local is_installed=0
        if [ -d "$HOME/Games/$name" ]; then
            is_installed=1
        else
            for slib in "${steam_libs[@]}"; do
                if [ -f "$slib/appmanifest_${appid}.acf" ]; then
                    is_installed=1
                    break
                fi
            done
        fi
        local status="[BELUM TERPASANG]"
        [ "$is_installed" -eq 1 ] && status="[TERPASANG]"
        results+="${appid}"$'\t'"${name}"$'\t'"${status}"$'\n'
    done <<< "$items"

    local selection
    selection=$(echo -n "$results" | fzf \
        --delimiter=$'\t' \
        --with-nth=1,2,3 \
        --header="HASIL PENCARIAN STEAM (Enter: Pasang/Aksi | Esc: Batal)" \
        --prompt="Steam Store > " \
        --preview='
            appid={1}
            title={2}
            status={3}
            echo "=========================================="
            echo " STEAM METADATA & PROTONDB AUDIT"
            echo "=========================================="
            echo " AppID    : $appid"
            echo " Judul    : $title"
            echo " Status   : $status"
            echo "------------------------------------------"
            details=$(curl -s --connect-timeout 2 "https://store.steampowered.com/api/appdetails?appids=$appid&filters=platforms,genres" | jq -r ".\"$appid\".data // empty" 2>/dev/null)
            if [ -n "$details" ]; then
                is_linux=$(echo "$details" | jq -r ".platforms.linux // false" 2>/dev/null)
                is_win=$(echo "$details" | jq -r ".platforms.windows // false" 2>/dev/null)
                genres=$(echo "$details" | jq -r "[.genres[]?.description] | join(\", \")" 2>/dev/null)
                [ -n "$genres" ] && echo " Genre    : $genres"
                if [ "$is_linux" = "true" ]; then
                    echo " Runner   : Native Linux (Depot ELF tersedia)"
                elif [ "$is_win" = "true" ]; then
                    echo " Runner   : Windows Only (Memerlukan Proton/WINE)"
                fi
                echo "------------------------------------------"
            fi
            pdb=$(curl -s --connect-timeout 2 "https://www.protondb.com/api/v1/reports/summaries/$appid.json" 2>/dev/null)
            if [ -n "$pdb" ] && [ "$pdb" != "null" ]; then
                tier=$(echo "$pdb" | jq -r ".tier // \"Unknown\"" 2>/dev/null)
                score=$(echo "$pdb" | jq -r ".score // \"-\"" 2>/dev/null)
                conf=$(echo "$pdb" | jq -r ".confidence // \"-\"" 2>/dev/null)
                echo " ProtonDB Tier       : $tier"
                echo " ProtonDB Score      : $score"
                echo " Confidence          : $conf"
            else
                echo " ProtonDB Rating     : Belum ada laporan komunitas"
            fi
            echo "=========================================="
        ' \
        --preview-window=right:50%:wrap
    ) || return

    if [ -n "$selection" ]; then
        local sel_id sel_name sel_status
        sel_id=$(echo "$selection" | awk -F'\t' '{print $1}')
        sel_name=$(echo "$selection" | awk -F'\t' '{print $2}')
        sel_status=$(echo "$selection" | awk -F'\t' '{print $3}')

        echo ""
        echo "=========================================="
        echo " TARGET: $sel_name (AppID: $sel_id)"
        echo " STATUS: $sel_status"
        echo "=========================================="
        if [ "$sel_status" = "[TERPASANG]" ]; then
            local gdir="$HOME/Games/$sel_name"
            if [ ! -d "$gdir" ]; then
                for slib in "${steam_libs[@]}"; do
                    if [ -d "$slib/common/$sel_name" ]; then
                        gdir="$slib/common/$sel_name"
                        break
                    fi
                done
            fi

            echo "Pilih aksi untuk game terpasang:"
            echo "  1) Luncurkan game langsung"
            echo "  2) Injeksi GBE Fork saja (Standalone ./saves & DLC.txt)"
            echo "  3) Injeksi GBE + Sync Steam Client (All-in-One full DLC)"
            echo "  4) Sync ke Steam Client resmi saja"
            echo "  5) Batal / Kembali"
            read -r -p "Pilihan [1-5]: " act_opt

            case "$act_opt" in
                1)
                    local gbin
                    gbin=$(find_game_binary "$gdir" 2>/dev/null || echo "")
                    if [ -n "$gbin" ]; then
                        launch_game "$gdir" "$gbin" "$sel_name"
                    else
                        echo "[ERROR] Biner eksekutabel tidak ditemukan di $gdir."
                    fi
                    ;;
                2)
                    inject_game "$gdir" "$sel_id" --no-sync
                    ;;
                3)
                    inject_game "$gdir" "$sel_id"
                    ;;
                4)
                    sync_steam "$sel_id" "$sel_name" "$gdir"
                    ;;
                *)
                    echo "[INFO] Aksi dibatalkan."
                    ;;
            esac
        else
            echo "Pilih paket instalasi untuk $sel_name:"
            echo "  1) [All-in-One] Unduh + Injeksi GBE + Sync Steam (Background)"
            echo "  2) [All-in-One] Unduh + Injeksi GBE + Sync Steam (Foreground Stream)"
            echo "  3) [Standalone] Unduh + Injeksi GBE saja (Tanpa Client Steam)"
            echo "  4) [Unlock Steam Saja] Buka di Steam resmi tanpa unduh game (Full DLC)"
            echo "  5) [Raw Download] Unduh aset mentah saja (Tanpa Injeksi)"
            echo "  6) Batal"
            read -r -p "Pilihan [1-6]: " opt
            case "$opt" in
                1)
                    download_game "$sel_id" "$HOME/Games/$sel_name" "$sel_name" --all --background
                    ;;
                2)
                    download_game "$sel_id" "$HOME/Games/$sel_name" "$sel_name" --all --foreground
                    ;;
                3)
                    download_game "$sel_id" "$HOME/Games/$sel_name" "$sel_name" --inject-only --background
                    ;;
                4)
                    unlock_game "$sel_id" "$sel_name"
                    ;;
                5)
                    download_game "$sel_id" "$HOME/Games/$sel_name" "$sel_name" --raw --background
                    ;;
                *)
                    echo "[INFO] Aksi dibatalkan."
                    ;;
            esac
        fi
        read -r -p "Tekan [ENTER] untuk melanjutkan..."
    fi
}

# CLI helper for launching games with wrappers and options
cli_launch() {
    local l_dir="${1:-}"
    shift || true
    local l_bin=""
    local l_title=""
    local l_flags=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --hud|--mangohud|--no-hud|--no-mangohud|--gamemode|--no-gamemode|--gamescope|--no-gamescope|--fsr|--no-fsr)
                l_flags+=("$1")
                shift
                ;;
            *)
                if [ -z "$l_bin" ]; then
                    l_bin="$1"
                elif [ -z "$l_title" ]; then
                    l_title="$1"
                else
                    l_flags+=("$1")
                fi
                shift
                ;;
        esac
    done

    [ -z "$l_title" ] && l_title="$(basename "$l_dir")"
    if [ -z "$l_bin" ]; then
        l_bin=$(find_game_binary "$l_dir" 2>/dev/null || echo "")
    fi

    if [ -n "$l_bin" ]; then
        launch_game "$l_dir" "$l_bin" "$l_title" "${l_flags[@]}"
    else
        echo "[ERROR] Biner eksekutabel tidak ditemukan di: $l_dir" >&2
        return 1
    fi
}

# Export functions for subshells in fzf
export -f preview_game sync_save_remote sync_to_tuf backup_save inject_game fetch_dlc download_game ensure_downloader sync_steam list_downloads unlock_game get_remote_host get_gbe_template find_game_binary find_runner launch_game build_wrapper_command configure_wrappers cli_launch generate_steamid64 get_game_persona set_id set_id_interactive

# Top-level Menu
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
case "${1:-}" in
    set-id)
        if [ -n "${2:-}" ]; then
            set_id "${@:2}"
        else
            echo "Usage: gamectl set-id <player_name> [steamid] [game_dir] [--broadcast <ip>] [--global]"
            exit 1
        fi
        ;;
    generate-steamid)
        generate_steamid64
        ;;
    set-id-interactive)
        if [ -n "${2:-}" ]; then
            set_id_interactive "$2" "${3:-}"
        else
            echo "Usage: gamectl set-id-interactive <game_dir> [title]"
            exit 1
        fi
        ;;
    launch|run|--launch)
        if [ -n "${2:-}" ]; then
            cli_launch "${@:2}"
        else
            echo "Usage: gamectl launch <game_dir> [binary] [title] [--hud] [--gamemode] [--gamescope] [--fsr]"
            exit 1
        fi
        ;;
    configure-wrappers)
        if [ -n "${2:-}" ]; then
            configure_wrappers "$2" "${3:-}"
        else
            echo "Usage: gamectl configure-wrappers <game_dir> [title]"
            exit 1
        fi
        ;;
    inject|--inject)
        if [ -n "${2:-}" ]; then
            inject_game "$2" "${3:-}" "${4:-all}"
        else
            echo "Usage: gamectl inject <game_dir> [appid] [--no-sync|--all]"
            exit 1
        fi
        ;;
    fetch-dlc|--fetch-dlc)
        if [ -n "${2:-}" ]; then
            fetch_dlc "$2" "${3:-}"
        else
            echo "Usage: gamectl fetch-dlc <game_dir> [appid]"
            exit 1
        fi
        ;;
    download|--download)
        if [ -n "${2:-}" ]; then
            download_game "$2" "${@:3}"
        else
            echo "Usage: gamectl download <appid> [dir] [title] [--raw|--inject-only|--all] [--foreground|-f]"
            exit 1
        fi
        ;;
    unlock|add-steam|--unlock)
        if [ -n "${2:-}" ]; then
            unlock_game "$2" "${3:-}"
        else
            echo "Usage: gamectl unlock <appid> [title]"
            exit 1
        fi
        ;;
    downloads|--downloads)
        list_downloads
        ;;
    sync-steam|--sync-steam)
        if [ -n "${2:-}" ]; then
            sync_steam "$2" "${3:-}" "${4:-}"
        else
            echo "Usage: gamectl sync-steam <appid> [title] [game_dir]"
            exit 1
        fi
        ;;
    ensure-downloader)
        ensure_downloader
        ;;
    --preview)
        preview_game "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}"
        ;;
    --backup)
        if [ -n "${2:-}" ]; then
            backup_save "$2"
        fi
        ;;
    --search)
        search_steam
        ;;
    --sync|sync-remote)
        if [ -n "${2:-}" ]; then
            sync_save_remote "$2" "${3:-Game}" "${4:-}"
        else
            echo "Usage: gamectl --sync <game_dir> [title] [remote_host]"
        fi
        ;;
    --list)
        scan_installed_games
        ;;
    --version|-v)
        echo "gamectl v1.2.0 (sovereign native TUI)"
        ;;
    --help|-h)
        cat <<EOF
gamectl - Sovereign TUI Game Manager & Launcher (Zero-Bloat)

Usage:
  gamectl             Buka antarmuka TUI library game
  gamectl launch <dir> [bin] [title] [--hud] [--gamemode] [--gamescope] [--fsr]
                      Jalankan game dengan prefix mandiri dan opsi wrapper performa
  gamectl configure-wrappers <dir> [title]
                      Buka menu konfigurasi wrapper (GameMode/MangoHud/Gamescope FSR)
  gamectl download <appid> [dir] [title] [--raw|--inject-only|--all] [-f]
                      Unduh game headless via DepotDownloader (pilihan paket fleksibel)
  gamectl downloads   Pantau status & log unduhan aktif
  gamectl unlock <appid> [title]
                      Buka game di Steam resmi tanpa unduh file (Full DLC)
  gamectl inject <dir> [appid] [--no-sync|--all]
                      Injeksi GBE Fork standalone & portable save
  gamectl set-id <player> [steamid] [dir] [--broadcast <ip>] [--global]
                      Atur nama akun & SteamID LAN untuk co-op offline tanpa bentrok
  gamectl fetch-dlc <dir> [appid] Unduh & tulis daftar DLC ke steam_settings/DLC.txt
  gamectl sync-steam <appid> [title] [dir] Sinkronisasi Steam Client & SLSsteam full DLC
  gamectl --search    Cari game di Steam Store & audit ProtonDB rating
  gamectl --list      Tampilkan daftar game yang terdeteksi
  gamectl --sync <dir> [title] [host]  Sinkronisasi savegame ke remote companion host
  gamectl --backup <dir>        Buat snapshot backup savegame
  gamectl --help      Tampilkan panduan ini
  gamectl --version   Tampilkan versi aktif
EOF
        ;;
    *)
        library_menu
        ;;
esac
fi
