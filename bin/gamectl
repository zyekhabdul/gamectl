    local app_id="${1:-}" game_dir="${2:-}"
    if [ -z "$app_id" ] || [[ ! "$app_id" =~ ^[0-9A-Za-z._-]+$ ]] || [[ "$app_id" == *".."* ]] || [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
