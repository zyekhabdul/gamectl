# --- [MODULE] src/core/10_utils.sh ---
# Resolve GBE template file based on platform and architecture
get_gbe_template() {
    local platform="${1:-linux}" # "linux" or "windows"
    local arch="${2:-x64}"       # "x64" or "x86"
    local p=""
    if [ "$platform" = "windows" ]; then
        if [ "$arch" = "x64" ]; then
            for p in "${GAMECTL_GBE_WIN_X64:-}" \
                     "$HOME/.local/share/gbe-fork/windows/release/regular/x64/steam_api64.dll" \
                     "$HOME/.local/share/gbe-fork/windows/regular/x64/steam_api64.dll" \
                     "$HOME/.local/share/gbe-fork/regular/x64/steam_api64.dll" \
                     "$HOME/.local/share/gbe-fork/windows/release/experimental/x64/steam_api64.dll"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        else
            for p in "${GAMECTL_GBE_WIN_X86:-}" \
                     "$HOME/.local/share/gbe-fork/windows/release/regular/x86/steam_api.dll" \
                     "$HOME/.local/share/gbe-fork/windows/regular/x86/steam_api.dll" \
                     "$HOME/.local/share/gbe-fork/regular/x86/steam_api.dll" \
                     "$HOME/.local/share/gbe-fork/windows/release/experimental/x86/steam_api.dll"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        fi
    else
        if [ "$arch" = "x64" ]; then
            for p in "${GAMECTL_GBE_X64:-}" \
                     "$HOME/.local/share/gbe-fork/regular/x64/libsteam_api.so" \
                     "$HOME/.local/share/gbe-fork/experimental/x64/libsteam_api.so"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        else
            for p in "${GAMECTL_GBE_X86:-}" \
                     "$HOME/.local/share/gbe-fork/regular/x86/libsteam_api.so" \
                     "$HOME/.local/share/gbe-fork/experimental/x86/libsteam_api.so"; do
                [ -n "$p" ] && [ -f "$p" ] && echo "$p" && return 0
            done
        fi
    fi
    return 1
}

# Check the installed bytes, not the presence of an original-library backup.
is_gbe_library() {
    local library="$1" platform=linux arch=x64 template
    case "${library##*/}" in
        steam_api64.dll) platform=windows ;;
        steam_api.dll) platform=windows; arch=x86 ;;
        libsteam_api.so)
            if file -Lb "$library" 2>/dev/null | grep -qi '32-bit'; then arch=x86; fi
            ;;
        *) return 1 ;;
    esac
    template=$(get_gbe_template "$platform" "$arch") || return 1
    cmp -s -- "$template" "$library"
}

# Stage replacements beside their destination so failed copies preserve the live library.
install_gbe_library() {
    local template="$1" destination="$2" staged
    mkdir -p "$(dirname "$destination")" || return 1
    if [ -e "$destination.orig" ] || [ -L "$destination.orig" ]; then
        [ -f "$destination.orig" ] || return 1
    elif [ -f "$destination" ]; then
        staged=$(mktemp "$destination.orig.gamectl.XXXXXX") || return 1
        if ! cp -a -- "$destination" "$staged" || ! mv -nT -- "$staged" "$destination.orig"; then
            rm -f -- "$staged"
            return 1
        fi
        rm -f -- "$staged"
    fi
    staged=$(mktemp "$destination.gamectl.XXXXXX") || return 1
    if ! cp "$template" "$staged" || ! chmod +x "$staged" || \
       ! cmp -s -- "$template" "$staged" || ! mv -fT -- "$staged" "$destination"; then
        rm -f -- "$staged"
        echo "[ERROR] Failed to install GBE library: $destination" >&2
        return 1
    fi
}

# Auto-download and provision Goldberg Emulator (GBE Fork) templates into destination
setup_gbe_templates() {
    local auto_yes=false
    local force=false
    local linux_only=false
    local win_only=false
    local dry_run=false
    local src_linux=""
    local src_win=""
    local dest_dir="${GAMECTL_GBE_DIR:-$HOME/.local/share/gbe-fork}"

    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes) auto_yes=true ;;
            -f|--force) force=true ;;
            --dry-run) dry_run=true ;;
            --linux-only) linux_only=true ;;
            --win-only) win_only=true ;;
            --source-linux) shift; src_linux="${1:-}" ;;
            --source-linux=*) src_linux="${1#--source-linux=}" ;;
            --source-win) shift; src_win="${1:-}" ;;
            --source-win=*) src_win="${1#--source-win=}" ;;
            --dest) shift; dest_dir="${1:-}" ;;
            --dest=*) dest_dir="${1#--dest=}" ;;
            -h|--help)
                cat <<EOF
Usage: gamectl setup-gbe [options]

Auto-download & provision Goldberg Emulator templates into ~/.local/share/gbe-fork/

Options:
  -y, --yes          Non-interactive mode, skip confirmations
  -f, --force        Overwrite existing templates
  --linux-only       Install only Linux templates (.so)
  --win-only         Install only Windows templates (.dll)
  --dry-run          Test execution without downloading or modifying filesystem
  --source-linux     Custom file or URL for Linux tarball (emu-linux-release.tar.bz2)
  --source-win       Custom file or URL for Windows 7z (emu-win-release-vs22.7z)
  --dest <dir>       Target GBE directory (default: ~/.local/share/gbe-fork)
EOF
                return 0
                ;;
            *)
                echo "[WARN] Unknown argument: $1" >&2
                ;;
        esac
        shift || true
    done

    echo "=========================================="
    echo " GOLDBERG EMULATOR PROVISIONING (GBE Fork)"
    echo " Target Dir : $dest_dir"
    echo " Mode       : $([ "$linux_only" = true ] && echo "Linux Only" || ([ "$win_only" = true ] && echo "Windows Only" || echo "Dual Platform (Linux + Windows)"))"
    echo "=========================================="

    if [ "$dry_run" = true ]; then
        echo "[DRY-RUN] Target destination verified: $dest_dir"
        return 0
    fi

    local has_lin_x64=false has_lin_x86=false has_win_x64=false has_win_x86=false
    [ -f "$dest_dir/regular/x64/libsteam_api.so" ] || [ -f "$dest_dir/experimental/x64/libsteam_api.so" ] && has_lin_x64=true
    [ -f "$dest_dir/regular/x86/libsteam_api.so" ] || [ -f "$dest_dir/experimental/x86/libsteam_api.so" ] && has_lin_x86=true
    [ -f "$dest_dir/windows/release/regular/x64/steam_api64.dll" ] || [ -f "$dest_dir/regular/x64/steam_api64.dll" ] || [ -f "$dest_dir/windows/regular/x64/steam_api64.dll" ] && has_win_x64=true
    [ -f "$dest_dir/windows/release/regular/x86/steam_api.dll" ] || [ -f "$dest_dir/regular/x86/steam_api.dll" ] || [ -f "$dest_dir/windows/regular/x86/steam_api.dll" ] && has_win_x86=true

    if [ "$force" = false ]; then
        if [ "$linux_only" = true ] && [ "$has_lin_x64" = true ] && [ "$has_lin_x86" = true ]; then
            echo "[PASS] Linux GBE Fork templates already provisioned in $dest_dir."
            return 0
        elif [ "$win_only" = true ] && [ "$has_win_x64" = true ] && [ "$has_win_x86" = true ]; then
            echo "[PASS] Windows GBE Fork templates already provisioned in $dest_dir."
            return 0
        elif [ "$linux_only" = false ] && [ "$win_only" = false ] && [ "$has_lin_x64" = true ] && [ "$has_lin_x86" = true ] && [ "$has_win_x64" = true ] && [ "$has_win_x86" = true ]; then
            echo "[PASS] All GBE Fork templates already provisioned in $dest_dir."
            return 0
        fi
    fi

    mkdir -p "$dest_dir"

    local tmp_work=""
    tmp_work=$(mktemp -d "${TMPDIR:-/tmp}/gamectl_gbe_setup_XXXXXX")
    trap 'rm -rf "${tmp_work:-}" 2>/dev/null || true' RETURN

    # 1. Linux Templates
    if [ "$win_only" = false ]; then
        echo "[INFO] Provisioning Linux GBE templates..."
        local lin_archive="$tmp_work/emu-linux.tar.bz2"
        local lin_url="${src_linux:-https://github.com/Detanup01/gbe_fork/releases/latest/download/emu-linux-release.tar.bz2}"

        if [ -f "$lin_url" ]; then
            cp -f "$lin_url" "$lin_archive"
        else
            echo "[INFO] Downloading Linux archive from: $lin_url"
            if ! curl -sL --connect-timeout 8 --max-time 60 "$lin_url" -o "$lin_archive"; then
                echo "[ERROR] Failed to download Linux GBE archive from $lin_url" >&2
                return 1
            fi
        fi

        if [ -f "$lin_archive" ] && [ -s "$lin_archive" ]; then
            mkdir -p "$tmp_work/linux_extract"
            if tar -xjf "$lin_archive" -C "$tmp_work/linux_extract" 2>/dev/null || tar -xf "$lin_archive" -C "$tmp_work/linux_extract" 2>/dev/null; then
                local src_root="$tmp_work/linux_extract"
                [ -d "$src_root/release" ] && src_root="$src_root/release"
                mkdir -p "$dest_dir/regular/x64" "$dest_dir/regular/x86" "$dest_dir/experimental/x64" "$dest_dir/experimental/x86"
                [ -f "$src_root/regular/x64/libsteam_api.so" ] && cp -f "$src_root/regular/x64/libsteam_api.so" "$dest_dir/regular/x64/"
                [ -f "$src_root/regular/x86/libsteam_api.so" ] && cp -f "$src_root/regular/x86/libsteam_api.so" "$dest_dir/regular/x86/"
                [ -f "$src_root/experimental/x64/libsteam_api.so" ] && cp -f "$src_root/experimental/x64/libsteam_api.so" "$dest_dir/experimental/x64/"
                [ -f "$src_root/experimental/x86/libsteam_api.so" ] && cp -f "$src_root/experimental/x86/libsteam_api.so" "$dest_dir/experimental/x86/"
                echo "[PASS] Linux GBE templates provisioned (x64 & x86)."
            else
                echo "[ERROR] Failed to extract Linux GBE archive." >&2
                return 1
            fi
        fi
    fi

    # 2. Windows Templates
    if [ "$linux_only" = false ]; then
        echo "[INFO] Provisioning Windows GBE templates..."
        local win_archive="$tmp_work/emu-win.7z"
        local win_url="${src_win:-https://github.com/Detanup01/gbe_fork/releases/latest/download/emu-win-release-vs22.7z}"

        local has_7z=false
        local cmd_7z=""
        for c in 7z 7za 7zr; do
            if command -v "$c" >/dev/null 2>&1; then
                has_7z=true
                cmd_7z="$c"
                break
            fi
        done

        if [ "$has_7z" = false ]; then
            echo "[WARN] 7z decompression utility not found. Install 7zip or p7zip-full to unpack Windows templates." >&2
            echo "       Skipping Windows template extraction. Linux templates remain functional." >&2
        else
            if [ -f "$win_url" ]; then
                cp -f "$win_url" "$win_archive"
            else
                echo "[INFO] Downloading Windows archive from: $win_url"
                if ! curl -sL --connect-timeout 8 --max-time 60 "$win_url" -o "$win_archive"; then
                    echo "[WARN] Failed to download Windows GBE archive from $win_url" >&2
                fi
            fi

            if [ -f "$win_archive" ] && [ -s "$win_archive" ]; then
                mkdir -p "$tmp_work/win_extract"
                if "$cmd_7z" x -y -o"$tmp_work/win_extract" "$win_archive" >/dev/null 2>&1; then
                    local w_root="$tmp_work/win_extract"
                    [ -d "$w_root/release" ] && w_root="$w_root/release"
                    mkdir -p "$dest_dir/windows/release/regular/x64" "$dest_dir/windows/release/regular/x86" \
                             "$dest_dir/regular/x64" "$dest_dir/regular/x86"
                    if [ -f "$w_root/regular/x64/steam_api64.dll" ]; then
                        cp -f "$w_root/regular/x64/steam_api64.dll" "$dest_dir/windows/release/regular/x64/"
                        cp -f "$w_root/regular/x64/steam_api64.dll" "$dest_dir/regular/x64/"
                    fi
                    if [ -f "$w_root/regular/x86/steam_api.dll" ]; then
                        cp -f "$w_root/regular/x86/steam_api.dll" "$dest_dir/windows/release/regular/x86/"
                        cp -f "$w_root/regular/x86/steam_api.dll" "$dest_dir/regular/x86/"
                    fi
                    echo "[PASS] Windows GBE templates provisioned (x64 & x86)."
                else
                    echo "[WARN] Failed to extract Windows GBE archive." >&2
                fi
            fi
        fi
    fi

    echo "[VERIFIED] GBE Fork template provisioning completed in $dest_dir."
    rm -rf "${tmp_work:-}" 2>/dev/null || true
    trap - RETURN
    return 0
}

# Resolve remote sync host (optional)
get_remote_host() {
    local host="${GAMECTL_REMOTE_HOST:-${GAMECTL_COMPANION_HOST:-${GAMECTL_SYNC_HOST:-${GAMECTL_TUF_HOST:-}}}}"
    if [ -z "$host" ] && [ -f "$HOME/.config/gamectl/remote_host" ]; then
        host=$(head -n 1 "$HOME/.config/gamectl/remote_host" | tr -d '[:space:]')
    fi
    echo "$host"
}

# Parse remote sync target into REMOTE_TARGET_BACKEND (ssh|rclone), REMOTE_TARGET_ENDPOINT, REMOTE_TARGET_BASE
parse_remote_sync_target() {
    local raw="${1:-}"
    REMOTE_TARGET_BACKEND=""
    REMOTE_TARGET_ENDPOINT=""
    REMOTE_TARGET_BASE=""

    if [ -z "$raw" ]; then
        echo "[WARN] Target remote host not configured." >&2
        echo "       Define target in ~/.config/gamectl/remote_host or GAMECTL_REMOTE_HOST variable." >&2
        return 1
    fi
    if [[ "$raw" == *$'\n'* || "$raw" == *$'\r'* ]] || [[ "$raw" == -* ]]; then
        echo "[ERROR] Invalid remote sync target '$raw': cannot start with '-' or contain newlines." >&2
        return 1
    fi

    if [[ "$raw" == rclone:* ]]; then
        local rest="${raw#rclone:}"
        local r_name="${rest%%:*}"
        local r_base="${rest#*:}"
        if [[ "$rest" != *:* ]] || [ -z "$r_name" ]; then
            echo "[ERROR] Invalid rclone target '$raw'. Expected format: rclone:<remote>:[path]." >&2
            return 1
        fi
        if ! command -v rclone >/dev/null 2>&1; then
            echo "[ERROR] Remote target '$raw' requires rclone, which is not installed in PATH." >&2
            return 1
        fi
        local rclone_remotes
        rclone_remotes=$(rclone listremotes 2>/dev/null || true)
        if ! grep -Fqx "${r_name}:" <<< "$rclone_remotes"; then
            echo "[ERROR] rclone remote '${r_name}:' not found (check 'rclone listremotes')." >&2
            return 1
        fi
        while [[ "$r_base" == /* ]]; do r_base="${r_base#/}"; done
        while [[ "$r_base" == */ ]]; do r_base="${r_base%/}"; done
        REMOTE_TARGET_BACKEND="rclone"
        REMOTE_TARGET_ENDPOINT="${r_name}:"
        REMOTE_TARGET_BASE="$r_base"
    elif [[ "$raw" == \[* ]]; then
        if [[ "$raw" =~ ^(\[[^]]+\])(:(.*))?$ ]]; then
            REMOTE_TARGET_BACKEND="ssh"
            REMOTE_TARGET_ENDPOINT="${BASH_REMATCH[1]}"
            REMOTE_TARGET_BASE="${BASH_REMATCH[3]:-}"
        else
            echo "[ERROR] Invalid IPv6 remote sync target: $raw" >&2
            return 1
        fi
    elif [[ "$raw" == *:* ]]; then
        local lhs="${raw%%:*}"
        local rhs="${raw#*:}"
        if [ -z "$lhs" ]; then
            echo "[ERROR] Invalid remote sync target '$raw': missing host or remote name." >&2
            return 1
        fi
        local rclone_remotes=""
        if command -v rclone >/dev/null 2>&1; then
            rclone_remotes=$(rclone listremotes 2>/dev/null || true)
        fi
        if [[ "$lhs" == *@* ]] || [[ "$lhs" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            if [ -z "$rhs" ]; then
                echo "[ERROR] SSH target '$raw' has empty path after ':'. Omit ':' or specify a path (e.g. ${lhs}:~/gamectl-saves)." >&2
                return 1
            fi
            REMOTE_TARGET_BACKEND="ssh"
            REMOTE_TARGET_ENDPOINT="$lhs"
            REMOTE_TARGET_BASE="$rhs"
        elif [ -n "$rclone_remotes" ] && grep -Fqx "${lhs}:" <<< "$rclone_remotes"; then
            while [[ "$rhs" == /* ]]; do rhs="${rhs#/}"; done
            while [[ "$rhs" == */ ]]; do rhs="${rhs%/}"; done
            REMOTE_TARGET_BACKEND="rclone"
            REMOTE_TARGET_ENDPOINT="${lhs}:"
            REMOTE_TARGET_BASE="$rhs"
        elif [ -z "$rhs" ]; then
            if ! command -v rclone >/dev/null 2>&1; then
                echo "[ERROR] Remote target '$raw' requires rclone, which is not installed in PATH." >&2
            else
                echo "[ERROR] Remote '${lhs}:' not found in 'rclone listremotes'. For SSH, omit ':' or append a path (e.g. ${lhs}:~/gamectl-saves)." >&2
            fi
            return 1
        else
            REMOTE_TARGET_BACKEND="ssh"
            REMOTE_TARGET_ENDPOINT="$lhs"
            REMOTE_TARGET_BASE="$rhs"
        fi
    else
        REMOTE_TARGET_BACKEND="ssh"
        REMOTE_TARGET_ENDPOINT="$raw"
        REMOTE_TARGET_BASE=""
    fi

    if [ -n "$REMOTE_TARGET_BASE" ]; then
        if [[ "$REMOTE_TARGET_BASE" == ".." || "$REMOTE_TARGET_BASE" == "../"* || "$REMOTE_TARGET_BASE" == *"/.." || "$REMOTE_TARGET_BASE" == *"/../"* ]]; then
            echo "[ERROR] Invalid remote path traversal in '$REMOTE_TARGET_BASE'." >&2
            return 1
        fi
        if [ "$REMOTE_TARGET_BACKEND" = "rclone" ] && [[ "$REMOTE_TARGET_BASE" == "~" || "$REMOTE_TARGET_BASE" == "~/"* ]]; then
            echo "[ERROR] rclone remote path cannot start with '~' ('$REMOTE_TARGET_BASE'). Use e.g. ${REMOTE_TARGET_ENDPOINT}gamectl-saves." >&2
            return 1
        fi
    fi

    return 0
}

# Pre-flight cleanup of orphaned sockets, locks, and stale download staging directories
clean_stale_locks() {
    local run_dir
    run_dir="$(get_runtime_dir)"
    # Self-healing cleanup of orphaned standalone download staging directories
    local st_dir
    shopt -s nullglob
    for st_dir in "$run_dir"/depot_dl_*; do
        if [ -d "$st_dir" ]; then
            local st_pid="${st_dir##*_}"
            if ! [[ "$st_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$st_pid" 2>/dev/null; then
                rm -rf "$st_dir" 2>/dev/null || true
            fi
        fi
    done
    shopt -u nullglob
}

# Invalidate ephemeral library scanner cache
invalidate_scan_cache() {
    local cache_dir
    cache_dir="$(get_runtime_dir)"
    rm -f "$cache_dir/scancache.tab" "$cache_dir/scancache.tab.tmp" 2>/dev/null || true
}

# Canonical desktop session runtime directory (Wayland/PipeWire/Pulse/D-Bus sockets)
get_desktop_runtime_dir() {
    local run_uid="${UID:-$(id -u 2>/dev/null || echo 1000)}"
    echo "${XDG_RUNTIME_DIR:-/run/user/$run_uid}"
}

# Canonical user-isolated runtime directory (0700 permissions)
get_runtime_dir() {
    local run_uid="${UID:-$(id -u 2>/dev/null || echo 1000)}"
    local run_dir="${XDG_RUNTIME_DIR:-/tmp/gamectl-$run_uid}"
    mkdir -p -m 700 "$run_dir" 2>/dev/null || true
    echo "$run_dir"
}

# Canonical POSIX-compliant ANSI escape sequence stripper
strip_ansi() {
    printf "%s" "${1:-}" | sed -E $'s/\033\\[[0-9;]*[a-zA-Z]//g'
}

# Centralized Runtime Logger (user-isolated, rolling buffer max 1000 lines)
get_runtime_log_file() {
    local run_dir
    run_dir="$(get_runtime_dir)"
    echo "$run_dir/gamectl.log"
}

log_msg() {
    local level="${1:-INFO}"
    local comp="${2:-CORE}"
    shift 2 || true
    local msg="$*"

    local log_file
    log_file="$(get_runtime_log_file)"

    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date)
    printf "[%s] [%-5s] [%-10s] %s\n" "$ts" "${level^^}" "${comp^^}" "$msg" >> "$log_file" 2>/dev/null || true

    # Rolling buffer cap: keep last 1000 lines if log file exceeds ~120KB
    local sz=0
    sz=$(stat -c%s "$log_file" 2>/dev/null || echo 0)
    if [ "$sz" -gt 120000 ]; then
        local tmp_log="$log_file.tmp.$$"
        tail -n 1000 "$log_file" > "$tmp_log" 2>/dev/null && mv -f "$tmp_log" "$log_file" 2>/dev/null || rm -f "$tmp_log" 2>/dev/null || true
    fi
    return 0
}

log_info() { log_msg "INFO" "$@"; }
log_warn() { log_msg "WARN" "$@"; }
log_error() { log_msg "ERROR" "$@"; }

# Ephemeral cache tier for JSON APIs (Steam Store & ProtonDB) with TTL
fetch_cached_json() {
    local url="${1:-}"
    local cache_key="${2:-}"
    local ttl="${3:-3600}"

    if [ -z "$url" ] || [ -z "$cache_key" ]; then
        return 1
    fi

    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gamectl"
    mkdir -p "$cache_dir" 2>/dev/null || true

    local safe_key
    safe_key=$(echo "$cache_key" | tr -cd '[:alnum:]_-')
    local cache_file="$cache_dir/${safe_key}.json"

    local now
    now=$(date +%s)

    # 1. Check existing cache validity against TTL
    if [ -f "$cache_file" ]; then
        local mtime
        mtime=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0)
        local age=$(( now - mtime ))
        if [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ] && [ -s "$cache_file" ]; then
            cat "$cache_file"
            return 0
        fi
    fi

    # 2. Fetch fresh content with timeout and atomic replacement
    local tmp_file="${cache_file}.tmp.$$"
    local fetched
    fetched=$(curl -s --connect-timeout 2 --max-time 4 "$url" 2>/dev/null || true)

    if [ -n "$fetched" ] && [ "$fetched" != "null" ]; then
        # Ensure it contains valid JSON before caching
        if echo "$fetched" | jq . >/dev/null 2>&1; then
            echo "$fetched" > "$tmp_file" 2>/dev/null && mv -f "$tmp_file" "$cache_file" 2>/dev/null || rm -f "$tmp_file" 2>/dev/null
            echo "$fetched"
            return 0
        fi
    fi
    rm -f "$tmp_file" 2>/dev/null || true

    # 3. Fallback to stale cache if network/API failed
    if [ -s "$cache_file" ]; then
        cat "$cache_file"
        return 0
    fi

    return 1
}

# Resolve sovereign library path prioritizing explicit arg, env, config, and default $HOME/Games
resolve_standalone_library_dir() {
    local safe_title="${1:-}"
    local explicit_dir="${2:-}"

    local base_dir=""
    if [ -n "$explicit_dir" ]; then
        base_dir="$explicit_dir"
    elif [ -n "${GAMECTL_LIBRARY_DIR:-}" ]; then
        base_dir="$GAMECTL_LIBRARY_DIR"
    elif [ -f "$HOME/.config/gamectl/library_dir" ]; then
        local cfg_dir
        cfg_dir=$(head -n 1 "$HOME/.config/gamectl/library_dir" 2>/dev/null | tr -d '\r\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if [ -n "$cfg_dir" ]; then
            base_dir="${cfg_dir/#\~/$HOME}"
        fi
    fi

    if [ -z "$base_dir" ]; then
        base_dir="$HOME/Games"
    fi

    if [ -n "$safe_title" ]; then
        echo "$base_dir/$safe_title"
    else
        echo "$base_dir"
    fi
}

# Canonical DRM & Emulator Resolution SSoT
# Resolves: GBE_FORK | VALVE_DLL | VALVE_SO | STANDALONE
resolve_game_drm_status() {
    local gdir="$1"
    local api_file="${2:-}"
    local bin_file="${3:-}"

    [ -n "$gdir" ] && [ -d "$gdir" ] || { echo "STANDALONE"; return 0; }

    if [ -z "$api_file" ] || [ ! -f "$api_file" ]; then
        local is_win=false
        case "$bin_file" in
            *.exe|*.EXE|*.bat|*.BAT) is_win=true ;;
        esac

        if [ "$is_win" = true ]; then
            if [ -f "$gdir/steam_api64.dll" ]; then
                api_file="$gdir/steam_api64.dll"
            elif [ -f "$gdir/steam_api.dll" ]; then
                api_file="$gdir/steam_api.dll"
            elif [ -f "$gdir/libsteam_api.so" ]; then
                api_file="$gdir/libsteam_api.so"
            elif [ -f "$gdir/lib64/libsteam_api.so" ]; then
                api_file="$gdir/lib64/libsteam_api.so"
            else
                api_file=$(find "$gdir" -maxdepth 3 \( -name "steam_api64.dll" -o -name "steam_api.dll" -o -name "libsteam_api.so" \) 2>/dev/null | head -n 1)
            fi
        else
            if [ -f "$gdir/libsteam_api.so" ]; then
                api_file="$gdir/libsteam_api.so"
            elif [ -f "$gdir/lib64/libsteam_api.so" ]; then
                api_file="$gdir/lib64/libsteam_api.so"
            elif [ -f "$gdir/steam_api64.dll" ]; then
                api_file="$gdir/steam_api64.dll"
            elif [ -f "$gdir/steam_api.dll" ]; then
                api_file="$gdir/steam_api.dll"
            else
                api_file=$(find "$gdir" -maxdepth 3 \( -name "libsteam_api.so" -o -name "steam_api64.dll" -o -name "steam_api.dll" \) 2>/dev/null | head -n 1)
            fi
        fi
    fi

    local is_gbe=false
    if [ -n "$api_file" ] && [ -f "$api_file" ]; then
        if is_gbe_library "$api_file" 2>/dev/null; then
            is_gbe=true
        fi
    fi

    if [ "$is_gbe" = false ]; then
        if { [ -n "$api_file" ] && [ -f "${api_file}.orig" ]; } || \
           [ -f "$gdir/libsteam_api.so.orig" ] || [ -f "$gdir/lib64/libsteam_api.so.orig" ] || \
           [ -f "$gdir/steam_api64.dll.orig" ] || [ -f "$gdir/steam_api.dll.orig" ] || \
           [ -d "$gdir/steam_settings" ] || [ -f "$gdir/local_save.txt" ] || [ -f "$gdir/.gamectl_gbe" ]; then
            is_gbe=true
        fi
    fi

    if [ "$is_gbe" = false ] && [ -n "$api_file" ] && [ -f "$api_file" ]; then
        if LC_ALL=C grep -q -a -E 'steam_settings/configs\.user\.ini|coldclient|goldberg|gbe_fork' "$api_file" 2>/dev/null; then
            is_gbe=true
        else
            local sz
            sz=$(stat -c%s "$api_file" 2>/dev/null || echo 0)
            [ "$sz" -gt 7000000 ] && is_gbe=true
        fi
    fi

    if [ "$is_gbe" = true ]; then
        echo "GBE_FORK"
    elif [ -n "$api_file" ] && [ -f "$api_file" ]; then
        case "$api_file" in
            *.dll) echo "VALVE_DLL" ;;
            *)     echo "VALVE_SO" ;;
        esac
    else
        echo "STANDALONE"
    fi
    return 0
}

# Canonical SSoT AppID resolver across standalone & Steam game directories
resolve_game_appid() {
    local gdir="${1:-}"
    local default_val="${2:-}"
    if [ -z "$gdir" ] || [ ! -d "$gdir" ]; then
        [ -n "$default_val" ] && echo "$default_val"
        return 0
    fi

    local cand line digits
    for cand in "$gdir/steam_appid.txt" "$gdir/steam_settings/steam_appid.txt" "$gdir/.gamectl_appid"; do
        [ -f "$cand" ] || continue
        while IFS= read -r line || [ -n "$line" ]; do
            digits="${line//[!0-9]/}"
            if [ -n "$digits" ]; then
                echo "$digits"
                return 0
            fi
        done < "$cand" 2>/dev/null
    done

    [ -n "$default_val" ] && echo "$default_val"
    return 0
}

# Canonical collision-free runtime log path resolver per game directory + executable
get_game_log_file() {
    local gdir="${1:-}"
    local gbin="${2:-game}"
    local run_dir safe_gbin
    run_dir="$(get_runtime_dir)"
    safe_gbin=$(basename "${gbin:-game}" 2>/dev/null | tr -cd '[:alnum:]_-')
    [ -z "$safe_gbin" ] && safe_gbin="game"

    if [ -n "$gdir" ]; then
        local base_slug path_id
        base_slug=$(basename "$gdir" 2>/dev/null | tr -cd '[:alnum:]_-')
        path_id=$(printf '%s' "$gdir" | cksum | awk '{print $1}')
        echo "$run_dir/game_${base_slug:+${base_slug}_}${path_id}_${safe_gbin}.log"
    else
        echo "$run_dir/game_${safe_gbin}.log"
    fi
}

# Atomically set or append a key=value entry without sed delimiter/escape injection
atomic_set_kv_file() {
    local file="${1:-}"
    local key="${2:-}"
    local val="${3:-}"
    local sep="${4:-=}"
    [ -n "$file" ] && [ -n "$key" ] || return 1
    if [[ "$key" == *[$'\n\r']* ]] || [[ "$val" == *[$'\n\r']* ]]; then
        echo "[ERROR] Key/value mutation rejected: newline/CR not permitted." >&2
        return 1
    fi
    mkdir -p "$(dirname "$file")" || return 1

    local tmp
    tmp=$(mktemp "${file}.gamectl.XXXXXX") || return 1
    local src_file="/dev/null"
    [ -f "$file" ] && src_file="$file"

    if ! GAMECTL_KV_KEY="$key" GAMECTL_KV_VAL="$val" GAMECTL_KV_SEP="$sep" awk '
        BEGIN {
            k = ENVIRON["GAMECTL_KV_KEY"]
            v = ENVIRON["GAMECTL_KV_VAL"]
            s = ENVIRON["GAMECTL_KV_SEP"]
            found = 0
        }
        {
            pos = index($0, "=")
            if (pos > 0) {
                lhs = substr($0, 1, pos - 1)
                gsub(/^[ \t]+|[ \t]+$/, "", lhs)
                if (lhs == k) {
                    if (!found) {
                        print k s v
                        found = 1
                    }
                    next
                }
            }
            print $0
        }
        END {
            if (!found) {
                print k s v
            }
        }
    ' "$src_file" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi

    if [ -f "$file" ]; then
        chmod --reference="$file" "$tmp" 2>/dev/null || true
    else
        chmod 600 "$tmp" 2>/dev/null || true
    fi

    if ! mv -f "$tmp" "$file"; then
        rm -f "$tmp"
        return 1
    fi
}

# Atomically prepend a line to a file (safe on 0-byte or nonexistent files)
atomic_prepend_line() {
    local file="${1:-}"
    local line="${2:-}"
    [ -n "$file" ] || return 1
    if [[ "$line" == *[$'\n\r']* ]]; then
        echo "[ERROR] Line prepend rejected: newline/CR not permitted." >&2
        return 1
    fi
    mkdir -p "$(dirname "$file")" || return 1

    local tmp
    tmp=$(mktemp "${file}.gamectl.XXXXXX") || return 1
    if ! printf '%s\n' "$line" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    if [ -f "$file" ]; then
        if ! cat "$file" >> "$tmp"; then
            rm -f "$tmp"
            return 1
        fi
        chmod --reference="$file" "$tmp" 2>/dev/null || true
    else
        chmod 600 "$tmp" 2>/dev/null || true
    fi
    if ! mv -f "$tmp" "$file"; then
        rm -f "$tmp"
        return 1
    fi
}

# Audit ZIP archive integrity, path traversal, and symlink entries before extraction
audit_zip_safety() {
    local zip_file="${1:-}"
    if [ -z "$zip_file" ] || [ ! -f "$zip_file" ] || [ ! -s "$zip_file" ]; then
        echo "[ERROR] Archive not found or empty: ${zip_file:-<empty>}" >&2
        return 1
    fi
    if ! unzip -tq "$zip_file" >/dev/null 2>&1; then
        echo "[ERROR] Archive failed ZIP integrity check: $zip_file" >&2
        return 1
    fi
    local entries
    entries=$(unzip -Z1 "$zip_file" 2>/dev/null) || return 1
    if [ -z "$entries" ]; then
        echo "[ERROR] Archive contains no entries: $zip_file" >&2
        return 1
    fi
    if printf '%s\n' "$entries" | grep -Eq '(^/|^[A-Za-z]:|(^|[/\\])\.\.([/\\]|$)|\\)'; then
        echo "[ERROR] Security violation: unsafe path traversal detected in archive payload." >&2
        return 1
    fi
    local zip_details
    zip_details=$(unzip -Z "$zip_file" 2>/dev/null) || return 1
    if grep -Eq '^l[-rwxstST]{6,9}[[:space:]]' <<< "$zip_details"; then
        echo "[ERROR] Security violation: symlink entry detected in archive payload." >&2
        return 1
    fi
    return 0
}

# Read a configuration key from ~/.config/gamectl/config
get_config_value() {
    local key="$1"
    local default_val="${2:-}"
    local cfg_file="$HOME/.config/gamectl/config"
    [ -f "$cfg_file" ] || { echo "$default_val"; return 0; }
    local val
    val=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$cfg_file" 2>/dev/null | tail -n 1 | sed -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//" | tr -d '\r')
    if [ -z "$val" ] && [ "$key" = "hubcap_key" ]; then
        val=$(grep -E "^[[:space:]]*hubcap_api_key[[:space:]]*=" "$cfg_file" 2>/dev/null | tail -n 1 | sed -E "s/^[[:space:]]*hubcap_api_key[[:space:]]*=[[:space:]]*//" | tr -d '\r')
    elif [ -z "$val" ] && [ "$key" = "hubcap_api_key" ]; then
        val=$(grep -E "^[[:space:]]*hubcap_key[[:space:]]*=" "$cfg_file" 2>/dev/null | tail -n 1 | sed -E "s/^[[:space:]]*hubcap_key[[:space:]]*=[[:space:]]*//" | tr -d '\r')
    fi
    if [ -n "$val" ]; then
        echo "$val"
    else
        echo "$default_val"
    fi
}

# Write or update a configuration key in ~/.config/gamectl/config
set_config_value() {
    local key="$1"
    local val="$2"
    [ "$key" = "hubcap_key" ] && key="hubcap_api_key"
    local cfg_dir="$HOME/.config/gamectl"
    local cfg_file="$cfg_dir/config"
    mkdir -p "$cfg_dir"
    atomic_set_kv_file "$cfg_file" "$key" "$val" "="
}

# Resolve Hubcap Manifest API key across environment, config file, and legacy stash
get_hubcap_api_key() {
    if [ -n "${HUBCAP_API_KEY:-}" ]; then
        echo "$HUBCAP_API_KEY"
        return 0
    elif [ -n "${HUBCAP_KEY:-}" ]; then
        echo "$HUBCAP_KEY"
        return 0
    fi

    local key
    key=$(get_config_value "hubcap_api_key")
    if [ -z "$key" ]; then
        key=$(get_config_value "hubcap_key")
    fi

    if [ -z "$key" ] && [ -f "$HOME/.config/gamectl/hubcap_api_key" ]; then
        key=$(head -n 1 "$HOME/.config/gamectl/hubcap_api_key" 2>/dev/null | tr -d '[:space:]')
    fi

    echo "$key"
}
# Standalone-source compatibility: load split core submodules when sourced directly outside bin/gamectl
if [ -z "${GAMECTL_BUNDLED:-}" ] && [ -n "${BASH_SOURCE[0]:-}" ]; then
    _core_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    for _core_sub in 12_tui_primitives.sh 14_saves.sh 16_steamstub.sh 18_process_runtime.sh; do
        if [ -f "$_core_dir/$_core_sub" ]; then
            # shellcheck source=/dev/null
            source "$_core_dir/$_core_sub"
        fi
    done
    unset _core_dir _core_sub
fi

# --- [MODULE] src/core/12_tui_primitives.sh ---
# Flush pending keyboard input to prevent ghost keypress propagation across TUI views
flush_tty_input() {
    if [ -t 0 ]; then
        while read -r -t 0.01 -n 10000 _ 2>/dev/null; do
            :
        done
    elif [ -r /dev/tty ]; then
        while read -r -t 0.01 -n 10000 _ < /dev/tty 2>/dev/null; do
            :
        done
    fi
    return 0
}

# Terminal Screen Lifecycle Management (Alternate Screen Buffer)
export GAMECTL_IN_ALT_SCREEN=0
GAMECTL_TUI_OWNER_PID=""
GAMECTL_TUI_EXITING=0
GAMECTL_SAVED_STTY=""

# Canonical TUI signal trap installer (Single Authoritative Owner)
install_tui_screen_traps() {
    if [ "${GAMECTL_IN_ALT_SCREEN:-0}" -eq 1 ] && [ "${BASHPID:-$$}" = "${GAMECTL_TUI_OWNER_PID:-}" ]; then
        trap '_gamectl_tui_rc=$?; trap - EXIT INT TERM; exit_tui_screen; exit "$_gamectl_tui_rc"' EXIT
        trap 'trap - EXIT INT TERM; exit_tui_screen; exit 130' INT
        trap 'trap - EXIT INT TERM; exit_tui_screen; exit 143' TERM
    fi
    return 0
}

enter_tui_screen() {
    if [ -t 1 ] && [ "${TERM:-}" != "dumb" ] && [ "${GAMECTL_IN_ALT_SCREEN:-0}" -eq 0 ]; then
        if [ -t 0 ]; then
            GAMECTL_SAVED_STTY=$(stty -g 2>/dev/null || echo "")
        fi
        tput smcup 2>/dev/null || printf '\033[?1049h'
        printf '\033[2J\033[H' 2>/dev/null || true
        export GAMECTL_IN_ALT_SCREEN=1
        GAMECTL_TUI_OWNER_PID="${BASHPID:-$$}"
        GAMECTL_TUI_EXITING=0
        install_tui_screen_traps
    fi
    return 0
}

exit_tui_screen() {
    # Re-entrant & single-owner guard: idempotent under concurrent signals or repeated calls
    if [ "${GAMECTL_TUI_EXITING:-0}" -eq 1 ]; then
        return 0
    fi
    if [ "${GAMECTL_IN_ALT_SCREEN:-0}" -ne 1 ]; then
        return 0
    fi
    if [ -n "${GAMECTL_TUI_OWNER_PID:-}" ] && [ "${BASHPID:-$$}" != "${GAMECTL_TUI_OWNER_PID}" ]; then
        return 0
    fi

    GAMECTL_TUI_EXITING=1
    export GAMECTL_IN_ALT_SCREEN=0

    if [ -t 1 ]; then
        printf '\033[2J\033[H' 2>/dev/null || true
        tput rmcup 2>/dev/null || printf '\033[?1049l'
        tput cnorm 2>/dev/null || printf '\033[?25h'
    fi
    if [ -t 0 ]; then
        if [ -n "${GAMECTL_SAVED_STTY:-}" ]; then
            stty "$GAMECTL_SAVED_STTY" 2>/dev/null || stty echo icanon 2>/dev/null || true
            GAMECTL_SAVED_STTY=""
        else
            stty echo icanon 2>/dev/null || true
        fi
    elif [ -t 1 ]; then
        stty echo icanon 2>/dev/null || true
    fi

    trap - EXIT INT TERM 2>/dev/null || true
    GAMECTL_TUI_OWNER_PID=""
    GAMECTL_TUI_EXITING=0
    return 0
}

# Clean FZF Modal Notification Dialog (Zero-Flicker)
tui_modal_notice() {
    local title="${1:-Notice}"
    local msg="${2:-}"
    local rendered="${msg//\\n/$'\n'}"

    if [ ! -t 0 ] || [ ! -t 1 ]; then
        log_msg "INFO" "UI" "[$title] ${rendered//$'\n'/ | }"
        printf '[%s]\n%s\n' "$title" "$rendered"
        return 0
    fi
    require_tui "$title" || return $?
    flush_tty_input

    local fzf_rc=0
    printf '%s\n' "$rendered" | fzf \
        --disabled \
        --no-info \
        --no-sort \
        --wrap=word \
        --pointer=' ' \
        --prompt='' \
        --border-label="  ╢ $title ╟  " \
        --border-label-pos=2 \
        --header="NOTICE (Enter or Esc: Dismiss)" \
        --reverse 2>/dev/null || fzf_rc=$?
    check_fzf_status "$fzf_rc" || return $?
    return 0
}

# Canonical Free-Text Input Dialog (Zero-Flicker FZF Wrapper)
tui_prompt_input() {
    local title="${1:-Input}"
    local header="${2:-Enter text (Enter: Confirm │ Esc: Cancel)}"
    local default_val="${3:-}"
    local prompt_str="${4:-Input > }"

    if [ ! -t 0 ]; then
        log_msg "INFO" "UI" "[$title] Non-interactive input fallback: '$default_val'"
        echo "$default_val"
        return 0
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for $title." >&2
        return 127
    fi

    flush_tty_input
    local input_raw="" fzf_rc=0
    input_raw=$(: | fzf \
        --print-query \
        --query="$default_val" \
        --border-label="  ╢ $title ╟  " \
        --border-label-pos=2 \
        --header="$header" \
        --prompt="$prompt_str" \
        --reverse 2>/dev/null) || fzf_rc=$?

    check_fzf_status "$fzf_rc" || return $?
    [ "$fzf_rc" -eq 130 ] && return 130

    local cleaned
    cleaned=$(echo "$input_raw" | head -n 1 | tr -d '\r\n')
    echo "$cleaned"
    return 0
}

# Canonical Action Selection Palette (Zero-Flicker FZF Wrapper)
tui_action_palette() {
    local title="${1:-Menu}"
    local header="${2:-Select Option (Enter: Select │ Esc: Cancel)}"
    local options_tsv="${3:-}"
    local preview_cmd="${4:-}"
    local prompt_str="${5:-Select > }"

    if [ ! -t 0 ]; then
        echo "[ERROR] Interactive palette requires a terminal (TTY)." >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for $title." >&2
        return 127
    fi

    flush_tty_input
    local fzf_cmd=(
        fzf
        --delimiter=$'\t'
        --with-nth=1,2
        --border-label="  ╢ $title ╟  "
        --border-label-pos=2
        --header="$header"
        --prompt="$prompt_str"
        --reverse
    )
    if [ -n "$preview_cmd" ]; then
        fzf_cmd+=(--preview="$preview_cmd" --preview-window=down:40%:border-rounded:wrap)
    fi

    local sel="" fzf_rc=0
    sel=$(printf "%s" "$options_tsv" | "${fzf_cmd[@]}" 2>/dev/null) || fzf_rc=$?

    check_fzf_status "$fzf_rc" || return $?
    [ "$fzf_rc" -eq 130 ] && return 130

    echo "$sel"
    return 0
}

# Execute headless engine command with isolated subshell and deterministic error capture
tui_run_engine() {
    local fail_title=""
    if [ "${1:-}" = "--fail-title" ]; then
        fail_title="${2:-}"
        shift 2
    fi
    local action_name="$1"
    shift
    [ -n "$fail_title" ] || fail_title="Engine Failure ($action_name)"
    local cmd=("$@")
    local run_dir run_log out_log err_log
    run_dir="$(get_runtime_dir)"
    run_log="$(get_runtime_log_file)"
    out_log=$(mktemp "$run_dir/out_${$}.XXXXXX") || return 1
    err_log=$(mktemp "$run_dir/err_${$}.XXXXXX") || { rm -f "$out_log" 2>/dev/null || true; return 1; }

    local rc=0
    # Execute inside isolated subshell with stdin disconnected (< /dev/null)
    # Capture stdout & stderr per invocation, append stdout to runtime log, and fall back to stdout on silent stderr
    ( export GAMECTL_ENGINE_ISOLATED=1; "${cmd[@]}" ) < /dev/null > "$out_log" 2> "$err_log" || rc=$?
    if [ -s "$out_log" ]; then
        cat "$out_log" >> "$run_log" 2>/dev/null || true
    fi

    if [ "$rc" -ne 0 ]; then
        local err_summary=""
        if [ -s "$err_log" ]; then
            err_summary=$(tail -n 12 "$err_log" 2>/dev/null || true)
        elif [ -s "$out_log" ]; then
            err_summary=$(tail -n 12 "$out_log" 2>/dev/null || true)
        fi
        if [ -z "${err_summary//[[:space:]]/}" ]; then
            err_summary="No diagnostic output emitted."
        fi
        log_msg "ERROR" "ENGINE" "$action_name failed (exit code $rc)"
        tui_modal_notice "$fail_title" "Operation returned Exit Code $rc.\n\nError Traces:\n$err_summary\n\nFull log:\n$run_log"
    fi
    rm -f "$out_log" "$err_log" 2>/dev/null || true
    return "$rc"
}

# Execute command with live interactive terminal streaming and zero raw leaks
tui_exec_action() {
    local action_title="$1"
    shift
    local cmd=("$@")

    if [ ! -t 0 ] || [ ! -t 1 ]; then
        "${cmd[@]}"
        return $?
    fi

    local run_dir
    run_dir="$(get_runtime_dir)"
    local tmp_log="$run_dir/action_review_$$.log"
    : > "$tmp_log"

    # Clean the full alternate screen to guarantee zero ghost lines from previous menus
    printf '\033[2J\033[H'
    printf '\033[1;35m╭── ╢ gamectl :: Live Action Stream ╟────────────────────────────────────────────\033[0m\n'
    printf '\033[1;36m│ Target : %s\033[0m\n' "$action_title"
    printf '\033[38;5;244m│ Stream : Real-time live execution (Ctrl+C to abort)\033[0m\n'
    printf '\033[1;35m╰───────────────────────────────────────────────────────────────────────────────\033[0m\n\n'

    echo "[INFO] Running: $action_title..." >> "$tmp_log"

    # Shield parent shell from SIGINT termination so child process handles abort cleanly
    trap '' INT

    local rc=0 _had_errexit=0
    [[ $- == *e* ]] && _had_errexit=1
    set +e
    "${cmd[@]}" 2>&1 | tee -a "$tmp_log"
    rc="${PIPESTATUS[0]}"
    [ "$_had_errexit" -eq 1 ] && set -e

    if [ "${GAMECTL_IN_ALT_SCREEN:-0}" -eq 1 ] && [ "${BASHPID:-$$}" = "${GAMECTL_TUI_OWNER_PID:-}" ]; then
        install_tui_screen_traps
    else
        trap - INT
    fi

    printf '\n'
    if [ "$rc" -eq 0 ]; then
        printf '\033[1;32m╭── ╢ [SUCCESS] %s completed successfully ╟─────────────────────────\033[0m\n' "$action_title"
    elif [ "$rc" -eq 130 ]; then
        printf '\033[1;33m╭── ╢ [CANCELLED] %s was aborted by user ╟─────────────────────────\033[0m\n' "$action_title"
    else
        printf '\033[1;31m╭── ╢ [FAILED (Exit %d)] %s encountered an error ╟──────────────────\033[0m\n' "$rc" "$action_title"
    fi
    printf '\033[38;5;244m╰── Press Enter or Esc to return to Dashboard ──────────────────────────────────\033[0m\n'

    flush_tty_input
    local key=""
    IFS= read -r -s -n 1 key 2>/dev/null || true
    if [ "$key" = $'\e' ]; then
        read -r -s -n 2 -t 0.05 _ || true
    fi
    flush_tty_input

    # Clean the screen completely before handing back control to caller TUI
    printf '\033[2J\033[H'

    rm -f "$tmp_log" 2>/dev/null || true
    return "$rc"
}

require_tui() {
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "[ERROR] ${1:-Interactive mode} requires a terminal (TTY)." >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for ${1:-interactive mode}." >&2
        return 127
    fi
}

check_fzf_status() {
    case "$1" in
        0|1|130) return 0 ;;
        *) echo "[ERROR] Interactive selection failed (fzf exit code $1)." >&2; return "$1" ;;
    esac
}

validate_tui_fields() {
    local field
    for field in "$@"; do
        if [[ "$field" == *[$'\t\r\n']* ]]; then
            printf '[ERROR] TUI fields cannot contain TAB, CR or newline: %q\n' "$field" >&2
            return 1
        fi
    done
}

store_search_items() {
    jq -r 'if any(.items[]?; (.id | tostring | test("[\\t\\r\\n]")) or (.name | test("[\\t\\r\\n]")))
        then error("TUI catalog contains TAB, CR or newline")
        else .items[]? | "\(.id)\t\(.name)" end'
}


# --- [MODULE] src/core/14_saves.sh ---
# Auto-backup savegame (Rolling 3 snapshots)
backup_save() (
    local game_dir="$1"
    local is_quiet="${2:-false}"

    if [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] Target game directory not found: ${game_dir:-<empty>}" >&2
        return 1
    fi

    local save_dir="$game_dir/saves"

    # If saves path does not exist (neither a directory nor a symlink)
    if [ ! -e "$save_dir" ] && [ ! -L "$save_dir" ]; then
        if [ -e "$game_dir/.save_snapshots/.lock" ] ||
           [ -e "$game_dir/.save_snapshots/.pre_restore_stash" ] ||
           [ -L "$game_dir/.save_snapshots/.pre_restore_stash" ]; then
            echo "[ERROR] Active saves are missing with pending save recovery in $game_dir/.save_snapshots" >&2
            return 1
        fi
        if [ "$is_quiet" = true ]; then
            return 0
        fi
        echo "[WARN] Portable saves directory ($save_dir) not found." >&2
        log_msg "WARN" "SAVE" "Portable saves directory ($save_dir) not found"
        echo "       Game has not been injected with GBE Fork or lacks an isolated save directory." >&2
        echo "       Press <CTRL-I> first to enable portable saves." >&2
        return 1
    fi

    # Symlink validation: ensure target exists and is a directory
    if [ -L "$save_dir" ]; then
        local target_path
        target_path=$(readlink -f "$save_dir" 2>/dev/null || true)
        if [ -z "$target_path" ] || [ ! -d "$target_path" ]; then
            [ "$is_quiet" = true ] || echo "[ERROR] Portable saves symlink points to invalid directory: $save_dir -> ${target_path:-broken}" >&2
            log_msg "ERROR" "SAVE" "Portable saves symlink is broken for $(basename "$game_dir")"
            return 1
        fi
    elif [ ! -d "$save_dir" ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] Portable saves path is not a directory: $save_dir" >&2
        log_msg "ERROR" "SAVE" "Portable saves path is not a directory for $(basename "$game_dir")"
        return 1
    fi

    local snap_dir="$game_dir/.save_snapshots"
    mkdir -p "$snap_dir" 2>/dev/null || {
        [ "$is_quiet" = true ] || echo "[ERROR] Failed to create snapshots directory: $snap_dir" >&2
        return 1
    }

    # shortcut: SIGKILL retains lock/staging for manual recovery; add a durable journal before automatic takeover.
    # Per-game lock using atomic directory creation
    local lock_dir="$snap_dir/.lock"
    local lock_pid=$BASHPID
    local lock_retries=15
    while ! mkdir "$lock_dir" 2>/dev/null; do
        lock_retries=$((lock_retries - 1))
        if [ "$lock_retries" -le 0 ]; then
            echo "[ERROR] Save lock unavailable: $lock_dir. Review owner/recovery data before removing a stale lock." >&2
            log_msg "ERROR" "SAVE" "Lock contention on backup for $(basename "$game_dir")"
            return 1
        fi
        sleep 0.1
    done
    local stage_dir="" committed=false rollback_ok=true
    local -a move_sources=() move_targets=()
    _cleanup_backup() {
        local rc=$? i
        trap - EXIT
        if [ "$committed" = false ]; then
            for ((i=${#move_sources[@]}-1; i>=0; i--)); do
                if [ ! -e "${move_sources[i]}" ] && [ ! -L "${move_sources[i]}" ] &&
                   { [ -e "${move_targets[i]}" ] || [ -L "${move_targets[i]}" ]; }; then
                    mv -T -- "${move_targets[i]}" "${move_sources[i]}" || rollback_ok=false
                fi
            done
        fi
        if [ "$rollback_ok" = true ]; then
            [ -z "$stage_dir" ] || rm -rf -- "$stage_dir" || rc=1
        else
            echo "[ERROR] Snapshot rollback incomplete; lock and recovery files retained in $stage_dir" >&2
            rc=1
        fi
        if [ "$rollback_ok" = true ]; then
            rm -rf -- "$lock_dir" || rc=1
        fi
        exit "$rc"
    }
    trap _cleanup_backup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    echo "$lock_pid" > "$lock_dir/pid" || return 1

    stage_dir=$(mktemp -d "$snap_dir/.stage_backup.XXXXXX") || return 1
    mkdir "$stage_dir/new" || return 1

    # Copy files dereferencing symlinks so snapshot is an independent copy
    local cp_rc=0
    cp -aL "$save_dir/." "$stage_dir/new/" 2>/dev/null || cp_rc=$?

    if [ "$cp_rc" -ne 0 ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] Failed to copy savegame files to snapshot staging." >&2
        log_msg "ERROR" "SAVE" "Failed to copy savegame files for $(basename "$game_dir")"
        return 1
    fi

    # Retain slot3 until every rename succeeds; reverse completed moves on failure.
    local -a sources=("$snap_dir/slot3" "$snap_dir/slot2" "$snap_dir/slot1" "$stage_dir/new")
    local -a targets=("$stage_dir/slot3" "$snap_dir/slot3" "$snap_dir/slot2" "$snap_dir/slot1")
    local i
    for i in "${!sources[@]}"; do
        [ -e "${sources[i]}" ] || [ -L "${sources[i]}" ] || continue
        move_sources+=("${sources[i]}")
        move_targets+=("${targets[i]}")
        if ! mv -T -- "${sources[i]}" "${targets[i]}"; then
            echo "[ERROR] Snapshot rotation failed: ${sources[i]} -> ${targets[i]}" >&2
            return 1
        fi
    done
    committed=true

    [ "$is_quiet" = true ] || echo "[INFO] Save snapshot created successfully in slot1 ($snap_dir/slot1)"
    log_msg "INFO" "SAVE" "Save snapshot created in slot1 for $(basename "$game_dir")"
    return 0
)

# Check if any active game PID in runtime active_games matches game_dir
is_game_active_for_dir() {
    local game_dir="$1"
    [ -n "$game_dir" ] || return 1
    local active_dir
    active_dir="$(get_runtime_dir)/active_games"
    [ -d "$active_dir" ] || return 1

    local canon_target
    canon_target=$(realpath -m -- "$game_dir" 2>/dev/null || (cd "$game_dir" 2>/dev/null && pwd -P) || printf '%s' "$game_dir")
    canon_target="${canon_target%/}"
    [ -n "$canon_target" ] || canon_target="/"

    local inf a_pid a_dir canon_a_dir
    for inf in "$active_dir"/*.info; do
        [ -f "$inf" ] || continue
        a_pid=$(grep -E '^PID=' "$inf" 2>/dev/null | head -n 1 | cut -d'=' -f2- | tr -dc '0-9')
        [ -n "$a_pid" ] || continue
        kill -0 "$a_pid" 2>/dev/null || continue
        a_dir=$(grep -E '^DIR=' "$inf" 2>/dev/null | head -n 1 | cut -d'=' -f2-)
        [ -n "$a_dir" ] || continue
        canon_a_dir=$(realpath -m -- "$a_dir" 2>/dev/null || (cd "$a_dir" 2>/dev/null && pwd -P) || printf '%s' "$a_dir")
        canon_a_dir="${canon_a_dir%/}"
        [ -n "$canon_a_dir" ] || canon_a_dir="/"
        if [ "$canon_a_dir" = "$canon_target" ]; then
            printf '%s\n' "$a_pid"
            return 0
        fi
    done
    return 1
}

# Restore savegame snapshot from recovery slot (slot1, slot2, or slot3)
restore_save() (
    local game_dir="$1"
    local slot="${2:-1}"
    local is_quiet="${3:-false}"

    if [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] Target game directory not found: ${game_dir:-<empty>}" >&2
        return 1
    fi

    local active_pid=""
    if active_pid=$(is_game_active_for_dir "$game_dir" 2>/dev/null); then
        [ "$is_quiet" = true ] || echo "[ERROR] Cannot restore saves while game process is active (PID: $active_pid). Close the game first." >&2
        log_msg "ERROR" "SAVE" "Restore blocked while active game PID $active_pid running for $(basename "$game_dir")"
        return 1
    fi

    local snap_dir="$game_dir/.save_snapshots"
    local save_dir="$game_dir/saves"
    local stash_dir="$snap_dir/.pre_restore_stash"

    if [ ! -d "$snap_dir" ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] No savegame snapshots directory found in: $game_dir" >&2
        return 1
    fi

    # Normalize slot notation: "1", "slot1", "2", "slot2", etc.
    slot="${slot#slot}"
    case "$slot" in
        1|2|3) ;;
        *)
            [ "$is_quiet" = true ] || echo "[ERROR] Invalid recovery slot: use 1, 2, or 3." >&2
            return 1
            ;;
    esac
    local target_slot="$snap_dir/slot${slot}"

    if [ ! -d "$target_slot" ]; then
        if [ "$is_quiet" != true ]; then
            echo "[ERROR] Recovery snapshot slot $slot not found in: $snap_dir" >&2
            echo "        Available slots:" >&2
            for s in "$snap_dir"/slot*; do
                [ -d "$s" ] && echo "        - $(basename "$s")" >&2
            done
        fi
        return 1
    fi

    # Per-game lock
    local lock_dir="$snap_dir/.lock"
    local lock_pid=$BASHPID
    local lock_retries=15
    while ! mkdir "$lock_dir" 2>/dev/null; do
        lock_retries=$((lock_retries - 1))
        if [ "$lock_retries" -le 0 ]; then
            echo "[ERROR] Save lock unavailable: $lock_dir. Review owner/recovery data before removing a stale lock." >&2
            log_msg "ERROR" "SAVE" "Lock contention on restore for $(basename "$game_dir")"
            return 1
        fi
        sleep 0.1
    done
    local restore_stage="" committed=false rollback_ok=true
    local -a move_sources=() move_targets=()
    _cleanup_restore() {
        local rc=$? i
        trap - EXIT
        if [ "$committed" = false ]; then
            for ((i=${#move_sources[@]}-1; i>=0; i--)); do
                if [ ! -e "${move_sources[i]}" ] && [ ! -L "${move_sources[i]}" ] &&
                   { [ -e "${move_targets[i]}" ] || [ -L "${move_targets[i]}" ]; }; then
                    mv -T -- "${move_targets[i]}" "${move_sources[i]}" || rollback_ok=false
                fi
            done
        fi
        if [ "$rollback_ok" = true ]; then
            [ -z "$restore_stage" ] || rm -rf -- "$restore_stage" || rc=1
        else
            echo "[ERROR] Restore rollback incomplete; lock and recovery files retained in $restore_stage and $stash_dir" >&2
            rc=1
        fi
        if [ "$rollback_ok" = true ]; then
            rm -rf -- "$lock_dir" || rc=1
        fi
        exit "$rc"
    }
    trap _cleanup_restore EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    echo "$lock_pid" > "$lock_dir/pid" || return 1

    if [ ! -e "$save_dir" ] && [ ! -L "$save_dir" ] && [ -d "$stash_dir" ]; then
        mv -T -- "$stash_dir" "$save_dir" || return 1
        log_msg "WARN" "SAVE" "Recovered missing active saves from .pre_restore_stash for $(basename "$game_dir")"
    fi

    restore_stage=$(mktemp -d "$game_dir/.save_restore_stage.XXXXXX") || return 1
    mkdir "$restore_stage/new" || return 1

    local cp_rc=0
    cp -aL "$target_slot/." "$restore_stage/new/" 2>/dev/null || cp_rc=$?

    if [ "$cp_rc" -ne 0 ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] Failed to stage snapshot files for restore." >&2
        log_msg "ERROR" "SAVE" "Restore staging failed for $(basename "$game_dir")"
        return 1
    fi

    # Preserve the previous recovery stash until the new active save is committed.
    local -a sources=() targets=()
    if [ -e "$save_dir" ] || [ -L "$save_dir" ]; then
        if [ -e "$stash_dir" ] || [ -L "$stash_dir" ]; then
            sources+=("$stash_dir")
            targets+=("$restore_stage/previous_stash")
        fi
        sources+=("$save_dir")
        targets+=("$stash_dir")
    fi
    sources+=("$restore_stage/new")
    targets+=("$save_dir")
    local i
    for i in "${!sources[@]}"; do
        move_sources+=("${sources[i]}")
        move_targets+=("${targets[i]}")
        if ! mv -T -- "${sources[i]}" "${targets[i]}"; then
            echo "[ERROR] Restore rename failed: ${sources[i]} -> ${targets[i]}" >&2
            return 1
        fi
    done
    committed=true

    [ "$is_quiet" = true ] || echo "[VERIFIED] Savegame restored successfully from slot${slot} ($target_slot -> $save_dir)"
    log_msg "INFO" "SAVE" "Savegame restored from slot${slot} for $(basename "$game_dir")"
    return 0
)

# Internal helper: check whether a prefix folder name is OS/driver/runtime noise
_is_prefix_save_noise() {
    local name_lc="${1,,}"
    case "$name_lc" in
        microsoft|temp|packages|crashdumps|d3dscache|nvidia|amd|intel|wine|steam|\
        "goldberg steamemu saves"|"gse saves"|mesa_shader_cache|vulkan|windows|\
        "internet explorer"|mozilla|google|chromium|cache|shaders|dxvk_state_cache|nv_cache)
            return 0
            ;;
    esac
    return 1
}

# Internal helper: verify deepest existing ancestor of a target path stays within a root
_check_confined_ancestor() {
    local probe="$1"
    local root="$2"
    while [ "$probe" != "/" ] && [ "$probe" != "." ] && [ ! -e "$probe" ] && [ ! -L "$probe" ]; do
        probe=$(dirname "$probe")
    done
    local probe_real
    probe_real=$(realpath -e -- "$probe" 2>/dev/null || true)
    [ -n "$probe_real" ] || return 1
    if [ "$probe_real" = "$root" ] || [[ "$probe_real" == "$root"/* ]]; then
        return 0
    fi
    return 1
}

# Discover savegame directories inside a Wine/Proton prefix (strictly read-only)
discover_prefix_saves() {
    local game_dir="${1:-}"
    if [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        echo "[ERROR] Target game directory not found: ${game_dir:-<empty>}" >&2
        return 1
    fi

    local pfx_path="$game_dir/pfx"
    local users_path="$pfx_path/drive_c/users"
    if [ ! -e "$users_path" ] && [ ! -L "$users_path" ]; then
        return 0
    fi

    local pfx_root users_root
    pfx_root=$(realpath -e -- "$pfx_path" 2>/dev/null || true)
    users_root=$(realpath -e -- "$users_path" 2>/dev/null || true)
    if [ -z "$pfx_root" ] || [ -z "$users_root" ] || [[ "$users_root" != "$pfx_root"/* ]]; then
        echo "[ERROR] Wine prefix users directory escapes prefix root: $users_path" >&2
        return 1
    fi
    [ -d "$users_root" ] || return 0

    local -a save_roots=(
        "AppData/Local"
        "AppData/LocalLow"
        "AppData/Roaming"
        "Documents/My Games"
        "My Documents/My Games"
        "Saved Games"
    )
    local -A seen_reals=()
    local -a discovered=()

    local user_dir user_real rel_root root_path root_real cand cand_name cand_real
    local sym sym_real escaped has_file rel_out
    for user_dir in "$users_root"/*; do
        [ -e "$user_dir" ] || [ -L "$user_dir" ] || continue
        user_real=$(realpath -e -- "$user_dir" 2>/dev/null || true)
        if [ -z "$user_real" ] || [[ "$user_real" != "$users_root"/* ]] || [ ! -d "$user_real" ]; then
            continue
        fi

        for rel_root in "${save_roots[@]}"; do
            root_path="$user_real/$rel_root"
            [ -e "$root_path" ] || [ -L "$root_path" ] || continue
            root_real=$(realpath -e -- "$root_path" 2>/dev/null || true)
            if [ -z "$root_real" ] || [[ "$root_real" != "$users_root"/* ]]; then
                echo "[WARN] Rejected escaping prefix save root: $root_path" >&2
                continue
            fi
            [ -d "$root_real" ] || continue

            for cand in "$root_real"/*; do
                [ -e "$cand" ] || [ -L "$cand" ] || continue
                cand_name="${cand##*/}"
                if [[ "$cand_name" == *$'\n'* ]] || [[ "$cand_name" == *$'\r'* ]]; then
                    echo "[WARN] Rejected prefix save directory with control character" >&2
                    continue
                fi
                if _is_prefix_save_noise "$cand_name"; then
                    continue
                fi

                cand_real=$(realpath -e -- "$cand" 2>/dev/null || true)
                if [ -z "$cand_real" ] || [[ "$cand_real" != "$users_root"/* ]]; then
                    echo "[WARN] Rejected escaping prefix save candidate: $cand" >&2
                    continue
                fi
                [ -d "$cand_real" ] || continue

                escaped=0
                while IFS= read -r -d '' sym; do
                    sym_real=$(realpath -e -- "$sym" 2>/dev/null || true)
                    if [ -z "$sym_real" ] || [[ "$sym_real" != "$users_root"/* ]]; then
                        echo "[WARN] Rejected prefix save with escaping symlink: $sym" >&2
                        escaped=1
                        break
                    fi
                done < <(find "$cand_real" -type l -print0 2>/dev/null)
                [ "$escaped" -eq 1 ] && continue

                has_file=$(find "$cand_real" -type f -print -quit 2>/dev/null || true)
                [ -n "$has_file" ] || continue

                if [ -n "${seen_reals[$cand_real]:-}" ]; then
                    continue
                fi
                seen_reals["$cand_real"]=1

                rel_out="${cand_real#"$users_root"/}"
                discovered+=("$rel_out")
            done
        done
    done

    if [ ${#discovered[@]} -gt 0 ]; then
        printf '%s\n' "${discovered[@]}" | LC_ALL=C sort -u
    fi
    return 0
}

# Collect discovered Wine prefix saves non-destructively into <game_dir>/saves/_prefix_saves/
collect_prefix_saves() {
    local game_dir="${1:-}"
    local is_quiet="${2:-false}"

    if [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] Target game directory not found: ${game_dir:-<empty>}" >&2
        return 1
    fi

    local active_pid=""
    if active_pid=$(is_game_active_for_dir "$game_dir" 2>/dev/null); then
        [ "$is_quiet" = true ] || echo "[ERROR] Cannot collect prefix saves while game process is active (PID: $active_pid)." >&2
        log_msg "ERROR" "SAVE" "Prefix save collect blocked while active PID $active_pid running for $(basename "$game_dir")"
        return 1
    fi

    local -a rels=()
    local line
    while IFS= read -r line; do
        [ -n "$line" ] && rels+=("$line")
    done < <(discover_prefix_saves "$game_dir")

    if [ ${#rels[@]} -eq 0 ]; then
        [ "$is_quiet" = true ] || echo "[INFO] No Wine prefix save directories found in: $game_dir"
        return 0
    fi

    local save_dir="$game_dir/saves"
    if [ -L "$save_dir" ]; then
        local target_path
        target_path=$(readlink -f "$save_dir" 2>/dev/null || true)
        if [ -z "$target_path" ] || [ ! -d "$target_path" ]; then
            [ "$is_quiet" = true ] || echo "[ERROR] Portable saves symlink points to invalid directory: $save_dir" >&2
            return 1
        fi
    elif [ -e "$save_dir" ] && [ ! -d "$save_dir" ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] Portable saves path is not a directory: $save_dir" >&2
        return 1
    fi

    local stage_root="$save_dir/_prefix_saves"
    mkdir -p -m 700 "$stage_root" || return 1

    local users_root
    users_root=$(realpath -e -- "$game_dir/pfx/drive_c/users" 2>/dev/null || true)
    [ -n "$users_root" ] || return 1

    local rel src src_real tmp_dir dst dst_parent count=0
    for rel in "${rels[@]}"; do
        case "$rel" in
            /*|..|../*|*/..|*/../*)
                echo "[WARN] Skipping unsafe relative save path: $rel" >&2
                continue
                ;;
        esac
        src="$users_root/$rel"
        src_real=$(realpath -e -- "$src" 2>/dev/null || true)
        if [ -z "$src_real" ] || [[ "$src_real" != "$users_root"/* ]] || [ ! -d "$src_real" ]; then
            echo "[WARN] Skipping invalid prefix save source: $rel" >&2
            continue
        fi

        dst="$stage_root/$rel"
        dst_parent=$(dirname "$dst")
        mkdir -p "$dst_parent" || return 1
        tmp_dir=$(mktemp -d "$stage_root/.stage_collect.XXXXXX") || return 1
        mkdir "$tmp_dir/payload" || { rm -rf -- "$tmp_dir"; return 1; }

        if ! cp -a -- "$src_real/." "$tmp_dir/payload/" 2>/dev/null; then
            rm -rf -- "$tmp_dir"
            [ "$is_quiet" = true ] || echo "[ERROR] Failed to stage prefix saves from $src_real" >&2
            return 1
        fi

        if [ -e "$dst" ] || [ -L "$dst" ]; then
            if ! mv -T -- "$dst" "$tmp_dir/old"; then
                rm -rf -- "$tmp_dir"
                return 1
            fi
        fi
        if ! mv -T -- "$tmp_dir/payload" "$dst"; then
            [ -e "$tmp_dir/old" ] && mv -T -- "$tmp_dir/old" "$dst" 2>/dev/null || true
            rm -rf -- "$tmp_dir"
            return 1
        fi
        rm -rf -- "$tmp_dir"
        count=$((count + 1))
    done

    [ "$is_quiet" = true ] || echo "[VERIFIED] Collected $count Wine prefix save directory(ies) into $stage_root"
    log_msg "INFO" "SAVE" "Collected $count Wine prefix save directory(ies) for $(basename "$game_dir")"
    return 0
}

# Opt-in restore of staged Wine prefix saves from <game_dir>/saves/_prefix_saves/ -> pfx/drive_c/users/
restore_prefix_saves() {
    local game_dir="${1:-}"
    local is_quiet="${2:-false}"

    if [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        [ "$is_quiet" = true ] || echo "[ERROR] Target game directory not found: ${game_dir:-<empty>}" >&2
        return 1
    fi

    local active_pid=""
    if active_pid=$(is_game_active_for_dir "$game_dir" 2>/dev/null); then
        [ "$is_quiet" = true ] || echo "[ERROR] Cannot restore prefix saves while game process is active (PID: $active_pid)." >&2
        return 1
    fi

    local stage_root="$game_dir/saves/_prefix_saves"
    if [ ! -d "$stage_root" ]; then
        [ "$is_quiet" = true ] || echo "[INFO] No staged Wine prefix saves found in: $stage_root"
        return 0
    fi

    local pfx_root users_root
    pfx_root=$(realpath -e -- "$game_dir/pfx" 2>/dev/null || true)
    users_root=$(realpath -e -- "$game_dir/pfx/drive_c/users" 2>/dev/null || true)
    if [ -z "$pfx_root" ] || [ -z "$users_root" ] || [[ "$users_root" != "$pfx_root"/* ]]; then
        [ "$is_quiet" = true ] || echo "[ERROR] Target Wine prefix users directory missing or invalid." >&2
        return 1
    fi

    local bad_sym
    bad_sym=$(find "$stage_root" -type l -print -quit 2>/dev/null || true)
    if [ -n "$bad_sym" ]; then
        echo "[ERROR] Staged prefix saves contain disallowed symlink: $bad_sym" >&2
        return 1
    fi

    local file rel dst_file dst_parent dst_parent_real count=0
    while IFS= read -r -d '' file; do
        rel="${file#"$stage_root"/}"
        case "$rel" in
            /*|..|../*|*/..|*/../*)
                echo "[ERROR] Unsafe staged prefix save path: $rel" >&2
                return 1
                ;;
        esac
        dst_file="$users_root/$rel"
        dst_parent=$(dirname "$dst_file")
        if ! _check_confined_ancestor "$dst_parent" "$users_root"; then
            echo "[ERROR] Prefix restore destination escapes users root: $dst_parent" >&2
            return 1
        fi
        mkdir -p -- "$dst_parent" || return 1
        dst_parent_real=$(realpath -e -- "$dst_parent" 2>/dev/null || true)
        if [ -z "$dst_parent_real" ] || { [ "$dst_parent_real" != "$users_root" ] && [[ "$dst_parent_real" != "$users_root"/* ]]; }; then
            echo "[ERROR] Prefix restore destination resolved outside users root: $dst_parent" >&2
            return 1
        fi
        if [ -L "$dst_file" ]; then
            echo "[ERROR] Refusing to overwrite symlink in Wine prefix: $dst_file" >&2
            return 1
        fi
        cp -a -- "$file" "$dst_file" || return 1
        count=$((count + 1))
    done < <(find "$stage_root" -type f -print0 2>/dev/null)

    [ "$is_quiet" = true ] || echo "[VERIFIED] Restored $count Wine prefix save file(s) from $stage_root"
    log_msg "INFO" "SAVE" "Restored $count Wine prefix save file(s) for $(basename "$game_dir")"
    return 0
}


# --- [MODULE] src/core/16_steamstub.sh ---
# Detect SteamStub DRM wrapper in Linux ELF (.bind section) or Windows PE
detect_steamstub_drm() {
    local bin_path="$1"
    [ -f "$bin_path" ] || return 1

    # Check 1: Linux ELF .bind section (readelf or strings)
    if command -v readelf >/dev/null 2>&1; then
        if readelf -S "$bin_path" 2>/dev/null | grep -Eq '(\.bind|[[:space:]]\.bind[[:space:]])'; then
            return 0
        fi
    fi

    # Check 2: Strings heuristic for SteamStub / SteamDRM markers
    if command -v strings >/dev/null 2>&1; then
        if strings -n 6 "$bin_path" 2>/dev/null | head -n 500 | grep -Eq '(SteamDRM|\.bind|SteamStub)'; then
            return 0
        fi
    fi

    return 1
}

# Distinguish SteamStub type (windows_pe, linux_elf, or unknown)
detect_steamstub_type() {
    local bin_path="$1"
    [ -f "$bin_path" ] || return 1
    if ! detect_steamstub_drm "$bin_path"; then
        return 1
    fi
    local btype
    btype=$(file -b "$bin_path" 2>/dev/null || echo "")
    if echo "$btype" | grep -qi -E "PE32|MS Windows"; then
        echo "windows_pe"
    elif case "$bin_path" in *.exe|*.EXE) true ;; *) false ;; esac; then
        echo "windows_pe"
    elif echo "$btype" | grep -qi "ELF"; then
        echo "linux_elf"
    else
        echo "unknown"
    fi
    return 0
}

# Check if a Linux ELF SteamStub (.bind) is actively protecting the binary
# (entry point resides inside the .bind section) or has been remediated
is_steamstub_elf_active() {
    local bin_path="$1"
    [ -f "$bin_path" ] || return 1
    if command -v readelf >/dev/null 2>&1; then
        local ep_hex b_addr_hex b_size_hex
        ep_hex=$(readelf -h "$bin_path" 2>/dev/null | awk '/Entry point address:/ { print $4 }')
        read -r b_addr_hex b_size_hex < <(readelf -S -W "$bin_path" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == ".bind") { print "0x"$(i+2), "0x"$(i+4); break } }')
        if [ -n "$ep_hex" ] && [ -n "$b_addr_hex" ] && [ -n "$b_size_hex" ]; then
            local ep=$((ep_hex)) b_start=$((b_addr_hex)) b_end=$((b_addr_hex + b_size_hex))
            if [ "$ep" -lt "$b_start" ] || [ "$ep" -ge "$b_end" ]; then
                return 1
            fi
        fi
    fi
    return 0
}

# Resolve candidate unpacked binary for Windows PE SteamStub
resolve_unpacked_binary() {
    local gdir="$1"
    local gbin="$2"
    [ -d "$gdir" ] || return 1
    [ -n "$gbin" ] || return 1

    local base_no_ext="${gbin%.*}"
    local cand
    for cand in "${base_no_ext}.unpacked.exe" \
                "${base_no_ext}_unpacked.exe" \
                "${base_no_ext}-unpacked.exe" \
                "${gbin}.unpacked.exe" \
                "${base_no_ext}.unpacked" \
                "${base_no_ext}_unpacked" \
                "${gbin}.unpacked"; do
        if [ -f "$gdir/$cand" ]; then
            [ -x "$gdir/$cand" ] || chmod +x "$gdir/$cand" 2>/dev/null || true
            echo "$cand"
            return 0
        fi
    done
    return 1
}

# Find Steamless CLI executable on system
find_steamless_cli() {
    local cand
    for cand in "${GAMECTL_STEAMLESS_PATH:-}" \
                "$(command -v steamless 2>/dev/null || true)" \
                "$(command -v Steamless.CLI.exe 2>/dev/null || true)" \
                "$HOME/.local/share/steamless/Steamless.CLI.exe" \
                "$HOME/.local/share/steamless/Steamless.exe" \
                "$HOME/.config/gamectl/tools/Steamless.CLI.exe"; do
        if [ -n "$cand" ] && [ -f "$cand" ]; then
            echo "$cand"
            return 0
        fi
    done
    return 1
}

# Unpack Windows PE SteamStub binary via Steamless CLI
unpack_steamstub_pe() {
    local target_exe="$1"
    local runner_bin="${2:-}"
    local pfx_dir="${3:-}"
    [ -f "$target_exe" ] || return 1

    local gdir
    gdir="$(dirname "$target_exe")"
    local gbin
    gbin="$(basename "$target_exe")"

    # If already unpacked, nothing to do
    if resolve_unpacked_binary "$gdir" "$gbin" >/dev/null 2>&1; then
        return 0
    fi

    local steamless_bin
    steamless_bin=$(find_steamless_cli 2>/dev/null || true)
    if [ -z "$steamless_bin" ]; then
        return 1
    fi

    if [ -z "$runner_bin" ]; then
        runner_bin=$(find_runner "$gdir" 2>/dev/null || true)
    fi
    pfx_dir="${pfx_dir:-$gdir/pfx}"

    echo "  ${UI_CYAN:-}[INFO] Invoking Steamless CLI: $steamless_bin on $gbin...${UI_RST:-}"
    if [ -x "$steamless_bin" ] && ! echo "$steamless_bin" | grep -qi '\.exe$'; then
        "$steamless_bin" "$target_exe" >/dev/null 2>&1 || true
    elif command -v mono >/dev/null 2>&1; then
        mono "$steamless_bin" "$target_exe" >/dev/null 2>&1 || true
    elif command -v dotnet >/dev/null 2>&1; then
        dotnet "$steamless_bin" "$target_exe" >/dev/null 2>&1 || true
    elif [ -n "$runner_bin" ] && [ -x "$runner_bin" ]; then
        WINEPREFIX="${pfx_dir:-$gdir/pfx}" "$runner_bin" "$steamless_bin" "$target_exe" >/dev/null 2>&1 || true
    elif command -v wine >/dev/null 2>&1; then
        WINEPREFIX="${pfx_dir:-$gdir/pfx}" wine "$steamless_bin" "$target_exe" >/dev/null 2>&1 || true
    else
        return 1
    fi

    # Check if unpacked binary was produced
    if resolve_unpacked_binary "$gdir" "$gbin" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

# Unpack Linux ELF SteamStub binary (.bind section) via native Python unpacker
unpack_steamstub_elf() {
    local target_bin="$1"
    [ -f "$target_bin" ] || return 1

    local gdir
    gdir="$(dirname "$target_bin")"
    local gbin
    gbin="$(basename "$target_bin")"

    # If already unpacked, nothing to do
    if resolve_unpacked_binary "$gdir" "$gbin" >/dev/null 2>&1; then
        return 0
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        echo "  ${UI_AMBER:-}[WARN] python3 not available. Cannot unpack Linux SteamStub binary.${UI_RST:-}" >&2
        return 1
    fi

    echo "  ${UI_CYAN:-}[INFO] Unpacking Linux ELF SteamStub DRM (.bind) on $gbin...${UI_RST:-}"

    local out_bin="$gdir/${gbin}.unpacked"
    local py_rc=0
    python3 - "$target_bin" "$out_bin" << 'EOF_UNPACK_PY' || py_rc=$?
import sys, os, struct, subprocess

def decrypt_aes(key, iv, data):
    try:
        from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
        ecb = Cipher(algorithms.AES(key), modes.ECB()).decryptor()
        new_iv = ecb.update(iv) + ecb.finalize()
        cbc = Cipher(algorithms.AES(key), modes.CBC(new_iv)).decryptor()
        return cbc.update(data) + cbc.finalize()
    except Exception:
        pass
    try:
        key_hex = key.hex()
        p1 = subprocess.run(['openssl', 'enc', '-d', '-aes-256-ecb', '-K', key_hex, '-nopad'],
                            input=iv, capture_output=True, check=True)
        new_iv_hex = p1.stdout.hex()
        p2 = subprocess.run(['openssl', 'enc', '-d', '-aes-256-cbc', '-K', key_hex, '-iv', new_iv_hex, '-nopad'],
                            input=data, capture_output=True, check=True)
        return p2.stdout
    except Exception as e:
        sys.stderr.write(f"[ERROR] AES decryption failed: {e}\n")
        return None

def unpack(target_path, output_path):
    with open(target_path, 'rb') as f:
        magic = f.read(4)
        if magic != b'\x7fELF':
            sys.stderr.write("[ERROR] Not an ELF binary.\n")
            return 1
        ei_class = f.read(1)[0]
        ei_data = f.read(1)[0]
        endian = '<' if ei_data == 1 else '>'
        if ei_class not in (1, 2) or ei_data not in (1, 2):
            sys.stderr.write("[ERROR] Unsupported ELF encoding.\n")
            return 1

        f.seek(0x18)
        if ei_class == 1:
            entrypoint = struct.unpack(endian + 'I', f.read(4))[0]
            f.seek(0x20)
            shoff = struct.unpack(endian + 'I', f.read(4))[0]
            f.seek(0x2e)
            shentsize, shnum, shstrndx = struct.unpack(endian + 'HHH', f.read(6))
        else:
            entrypoint = struct.unpack(endian + 'Q', f.read(8))[0]
            f.seek(0x28)
            shoff = struct.unpack(endian + 'Q', f.read(8))[0]
            f.seek(0x3a)
            shentsize, shnum, shstrndx = struct.unpack(endian + 'HHH', f.read(6))

        f.seek(shoff + shstrndx * shentsize)
        if ei_class == 1:
            _, _, _, _, str_offset, str_size, _, _, _, _ = struct.unpack(endian + 'IIIIIIIIII', f.read(40))
        else:
            _, _, _, _, str_offset, str_size, _, _, _, _ = struct.unpack(endian + 'IIQQQQIIQQ', f.read(64))

        f.seek(str_offset)
        strtab = f.read(str_size)

        sections = []
        bind_sec = None
        for i in range(shnum):
            f.seek(shoff + i * shentsize)
            if ei_class == 1:
                name_idx, s_type, s_flags, s_addr, s_offset, s_size, _, _, _, _ = struct.unpack(endian + 'IIIIIIIIII', f.read(40))
            else:
                name_idx, s_type, s_flags, s_addr, s_offset, s_size, _, _, _, _ = struct.unpack(endian + 'IIQQQQIIQQ', f.read(64))
            name_end = strtab.find(b'\x00', name_idx)
            name = strtab[name_idx:name_end].decode('latin1', errors='replace')
            sec = {'name': name, 'type': s_type, 'flags': s_flags, 'addr': s_addr, 'offset': s_offset, 'size': s_size}
            sections.append(sec)
            if name == '.bind':
                bind_sec = sec

        if not bind_sec:
            sys.stderr.write("[ERROR] No .bind section found in ELF binary.\n")
            return 1

        f.seek(bind_sec['offset'])
        bind_data = f.read(bind_sec['size'])
        if len(bind_data) < 0xb0:
            sys.stderr.write("[ERROR] .bind section too small.\n")
            return 1

        candidates = []
        seen_cand = set()
        if bind_sec['addr'] <= entrypoint < bind_sec['addr'] + bind_sec['size']:
            bind_entry = entrypoint - bind_sec['addr']
            for h_sz in (0xc0, 0xd0, 0xb0):
                if bind_entry >= h_sz:
                    item = (bind_entry - h_sz, h_sz)
                    candidates.append(item)
                    seen_cand.add(item)

        for off in range(0, min(len(bind_data) - 0xb4, 0x8000), 4):
            for h_sz in (0xc0, 0xd0, 0xb0):
                item = (off, h_sz)
                if item not in seen_cand:
                    candidates.append(item)
                    seen_cand.add(item)

        pattern_64 = '<IQQIIQIIIIIIIIQQ32s16s16s16s32sQI'
        names_64 = ('signature base drm_entrypoint bind_offset u0 '
                    'real_entrypoint u1 payload_size u2 u3 appid '
                    'flags bind_virtual_size u4 code_virtual_addr '
                    'code_size aes_key aes_iv code_stolen keys u5 '
                    'u6 u7').split()

        pattern_32 = '<IQIIIIIIIIIIIIII32s16s16s16s'
        names_32 = ('signature base drm_entrypoint bind_offset u0 '
                    'real_entrypoint u1 payload_size drmp_offset drmp_size '
                    'appid flags bind_virtual_size u2 code_virtual_addr code_size '
                    'aes_key aes_iv code_stolen enc_keys').split()

        hdr_info = None
        arch = None

        for cand_off, h_sz in candidates:
            if cand_off + h_sz + 4 > len(bind_data):
                continue
            key = int.from_bytes(bind_data[cand_off:cand_off+4], byteorder='little')
            header_bytes = bytearray()
            h_off = cand_off
            end_off = cand_off + h_sz
            while h_off < end_off:
                h_off += 4
                val = int.from_bytes(bind_data[h_off:h_off+4], byteorder='little')
                header_bytes.extend(int.to_bytes(val ^ key, 4, byteorder='little'))
                key = val

            if len(header_bytes) >= 4:
                sig = int.from_bytes(header_bytes[0:4], byteorder='little')
                if sig == 0xc0dec0df and len(header_bytes) >= struct.calcsize(pattern_64):
                    raw_tuple = struct.unpack(pattern_64, bytes(header_bytes[:struct.calcsize(pattern_64)]))
                    hdr_info = dict(zip(names_64, raw_tuple))
                    arch = 'x64'
                    break
                elif sig == 0xc0dec0de and len(header_bytes) >= struct.calcsize(pattern_32):
                    raw_tuple = struct.unpack(pattern_32, bytes(header_bytes[:struct.calcsize(pattern_32)]))
                    hdr_info = dict(zip(names_32, raw_tuple))
                    arch = 'x86'
                    break

        if not hdr_info:
            sys.stderr.write("[ERROR] SteamStub .bind header signature (0xc0dec0df / 0xc0dec0de) not found.\n")
            return 1

        flags = hdr_info.get('flags', 0)
        is_encrypted = not bool(flags & 0x04)

        f.seek(0)
        file_bytes = bytearray(f.read())

        if is_encrypted:
            code_sec = None
            c_addr = hdr_info['code_virtual_addr']
            for s in sections:
                if (s['addr'] <= c_addr < s['addr'] + s['size']) or (s['offset'] <= c_addr < s['offset'] + s['size']):
                    code_sec = s
                    break

            if not code_sec:
                for s in sections:
                    if s['name'] == '.text':
                        code_sec = s
                        break

            if not code_sec:
                sys.stderr.write(f"[ERROR] Could not identify code section for virtual addr 0x{c_addr:x}.\n")
                return 1

            f.seek(code_sec['offset'])
            enc_code_from_sec = f.read(min(hdr_info['code_size'], code_sec['size']))
            code_payload = bytearray(hdr_info['code_stolen'])
            code_payload.extend(enc_code_from_sec)

            decrypted_code = decrypt_aes(hdr_info['aes_key'], hdr_info['aes_iv'], bytes(code_payload))
            if not decrypted_code:
                sys.stderr.write("[ERROR] Decryption of code section failed.\n")
                return 1

            write_len = min(len(decrypted_code), code_sec['size'], max(0, len(file_bytes) - code_sec['offset']))
            file_bytes[code_sec['offset'] : code_sec['offset'] + write_len] = decrypted_code[:write_len]

        real_ep = hdr_info['real_entrypoint']
        base_addr = hdr_info.get('base', 0)
        if arch == 'x86':
            if real_ep < base_addr:
                real_ep = real_ep + base_addr
            ep_bytes = struct.pack(endian + 'I', real_ep & 0xffffffff)
        else:
            code_sec_addr = 0
            for s in sections:
                if s['name'] == '.text':
                    code_sec_addr = s['addr']
                    break
            base_ref = base_addr if base_addr > 0 else code_sec_addr
            if real_ep < base_ref:
                real_ep = real_ep + base_ref
            ep_bytes = struct.pack(endian + 'Q', real_ep)

        file_bytes[0x18 : 0x18 + len(ep_bytes)] = ep_bytes

        with open(output_path, 'wb') as out_f:
            out_f.write(file_bytes)

        os.chmod(output_path, 0o755)
        sys.stdout.write(f"[SUCCESS] Unpacked SteamStub ELF ({arch}, AppID: {hdr_info['appid']}) -> {output_path}\n")
        return 0

target = sys.argv[1]
output = sys.argv[2]
sys.exit(unpack(target, output))
EOF_UNPACK_PY

    if [ "$py_rc" -eq 0 ] && [ -f "$out_bin" ] && [ -x "$out_bin" ]; then
        return 0
    fi
    rm -f "$out_bin" 2>/dev/null || true
    return 1
}

# Setup sovereign Steam interceptor scripts in target directory
setup_steam_interceptor() {
    local target_dir="${1:-$(get_runtime_dir)/interceptor}"
    mkdir -p -m 700 "$target_dir" 2>/dev/null || mkdir -p "$target_dir"
    cat << 'EOF_INTERCEPTOR' > "$target_dir/steam"
# Sovereign Steam Interceptor: traps and silences unshielded Steam Client calls
target_appid=""
for arg in "$@"; do
    case "$arg" in
        steam://run/*)
            target_appid="${arg##steam://run/}"
            target_appid="${target_appid%%/*}"
            ;;
    esac
done
if [ -n "$target_appid" ]; then
    echo "[gamectl interceptor] Blocked unsolicited Steam Client launch (steam://run/$target_appid)" >&2
else
    echo "[gamectl interceptor] Blocked unsolicited Steam Client launch ($*)" >&2
fi
exit 0
EOF_INTERCEPTOR
    chmod +x "$target_dir/steam" 2>/dev/null || true
    cp -f "$target_dir/steam" "$target_dir/steam.sh" 2>/dev/null || true
    return 0
}

# Forensic diagnostics report for SteamStub DRM inspection
diagnose_steamstub() {
    local bin_path="$1"
    if [ ! -f "$bin_path" ]; then
        echo "[ERROR] File not found: $bin_path" >&2
        return 1
    fi

    local b_name
    b_name="$(basename "$bin_path")"
    local b_dir
    b_dir="$(dirname "$bin_path")"
    local b_type
    b_type=$(file -b "$bin_path" 2>/dev/null || echo "Unknown")

    echo "╭─ STEAMSTUB FORENSIC DIAGNOSTICS ────────────────────────────╮"
    echo "│ Target Binary : $b_name"
    echo "│ Full Path     : $bin_path"
    echo "│ Architecture  : $b_type"

    local is_stub=false
    local stub_type="none"

    if detect_steamstub_drm "$bin_path"; then
        is_stub=true
        stub_type=$(detect_steamstub_type "$bin_path" 2>/dev/null || echo "unknown")
    fi

    if [ "$is_stub" = true ]; then
        if [ "$stub_type" = "windows_pe" ]; then
            local up_bin
            up_bin=$(resolve_unpacked_binary "$b_dir" "$b_name" 2>/dev/null || true)
            if [ "$b_name" = "$up_bin" ] || case "$b_name" in *.unpacked.exe|*_unpacked.exe|*-unpacked.exe) true ;; *) false ;; esac; then
                echo "│ DRM Status    : ${UI_GREEN:-}[REMEDIATED] Windows PE SteamStub (unpacked / DRM cleared)${UI_RST:-}"
                echo "│ Unpack Status : ${UI_GREEN:-}[ACTIVE] Executable DRM wrapper removed${UI_RST:-}"
                echo "│ Remediation   : Binary is unpacked and ready for Proton/Wine execution"
            elif [ -n "$up_bin" ]; then
                echo "│ DRM Status    : ${UI_AMBER:-}[DETECTED] Windows PE SteamStub DRM${UI_RST:-}"
                echo "│ Unpack Status : ${UI_GREEN:-}[READY] Unpacked counterpart found: $up_bin${UI_RST:-}"
                echo "│ Remediation   : launch_game will automatically execute $up_bin"
            else
                echo "│ DRM Status    : ${UI_AMBER:-}[DETECTED] Windows PE SteamStub DRM${UI_RST:-}"
                echo "│ Unpack Status : ${UI_AMBER:-}[PENDING] No unpacked binary found${UI_RST:-}"
                local s_cli
                s_cli=$(find_steamless_cli 2>/dev/null || true)
                if [ -n "$s_cli" ]; then
                    echo "│ Steamless CLI : ${UI_GREEN:-}[AVAILABLE] $s_cli${UI_RST:-}"
                    echo "│ Action        : Run 'gamectl unpack-stub \"$bin_path\"'"
                else
                    echo "│ Steamless CLI : ${UI_AMBER:-}[NOT FOUND] Place Steamless in ~/.local/share/steamless/${UI_RST:-}"
                    echo "│ Remediation   : Unpack $b_name with Steamless or provide ${b_name%.*}.unpacked.exe"
                fi
            fi
        elif [ "$stub_type" = "linux_elf" ]; then
            local is_active=true
            if ! is_steamstub_elf_active "$bin_path"; then
                is_active=false
            fi

            local up_bin
            up_bin=$(resolve_unpacked_binary "$b_dir" "$b_name" 2>/dev/null || true)
            if [ "$is_active" = false ] || [ "$b_name" = "$up_bin" ]; then
                echo "│ DRM Status    : ${UI_GREEN:-}[REMEDIATED] Linux ELF SteamStub (.bind inactive / OEP restored)${UI_RST:-}"
                echo "│ Unpack Status : ${UI_GREEN:-}[ACTIVE] Executable entry point points to original code${UI_RST:-}"
                echo "│ Remediation   : Binary is unpacked and ready for direct execution"
            elif [ -n "$up_bin" ]; then
                echo "│ DRM Status    : ${UI_AMBER:-}[DETECTED] Linux ELF SteamStub (.bind section)${UI_RST:-}"
                echo "│ Unpack Status : ${UI_GREEN:-}[READY] Unpacked counterpart found: $up_bin${UI_RST:-}"
                echo "│ Remediation   : launch_game will automatically execute $up_bin"
            else
                echo "│ DRM Status    : ${UI_AMBER:-}[DETECTED] Linux ELF SteamStub (.bind section)${UI_RST:-}"
                echo "│ Unpack Status : ${UI_AMBER:-}[PENDING] No unpacked binary found${UI_RST:-}"
                echo "│ Action        : Run 'gamectl unpack-stub \"$bin_path\"' to decrypt .bind section"
            fi
            echo "│ Interceptor   : ${UI_GREEN:-}[ACTIVE] Sovereign steam.sh trap prevents Steam Client launch${UI_RST:-}"
            local cand_win
            cand_win=$(find "$b_dir" -maxdepth 2 -iname "*.exe" 2>/dev/null | head -n 1 || true)
            if [ -n "$cand_win" ]; then
                echo "│ Runner Option : Windows executable found ($(basename "$cand_win")). Can run via Proton with Steamless."
            else
                echo "│ Runner Option : Pure Linux native. Runs with unpacked binary and sovereign steam.sh trap."
            fi
        else
            echo "│ DRM Status    : ${UI_AMBER:-}[DETECTED] SteamStub / SteamDRM markers found${UI_RST:-}"
        fi
    else
        echo "│ DRM Status    : ${UI_GREEN:-}[CLEAN] No SteamStub DRM markers detected${UI_RST:-}"
    fi
    echo "╰─────────────────────────────────────────────────────────────╯"

    [ "$is_stub" = true ] && return 0 || return 1
}

# CLI subcommand handler for unpacking SteamStub Windows PE or Linux ELF binaries
cli_unpack_stub() {
    local target="$1"
    if [ ! -f "$target" ]; then
        echo "[ERROR] Target file not found: $target" >&2
        return 1
    fi
    local up_res
    up_res=$(resolve_unpacked_binary "$(dirname "$target")" "$(basename "$target")" 2>/dev/null || true)
    if [ -n "$up_res" ]; then
        echo "[VERIFIED] Binary is already unpacked: $up_res"
        return 0
    fi

    local stype
    stype=$(detect_steamstub_type "$target" 2>/dev/null || echo "unknown")

    if [ "$stype" = "linux_elf" ]; then
        echo "[INFO] Attempting to unpack Linux ELF binary $target..."
        if unpack_steamstub_elf "$target"; then
            up_res=$(resolve_unpacked_binary "$(dirname "$target")" "$(basename "$target")" 2>/dev/null || true)
            echo "[SUCCESS] Binary successfully unpacked: $up_res"
            return 0
        else
            echo "[ERROR] Failed to unpack Linux ELF SteamStub binary." >&2
            return 1
        fi
    elif [ "$stype" = "windows_pe" ]; then
        echo "[INFO] Attempting to unpack Windows PE binary $target via Steamless CLI..."
        if unpack_steamstub_pe "$target"; then
            up_res=$(resolve_unpacked_binary "$(dirname "$target")" "$(basename "$target")" 2>/dev/null || true)
            echo "[SUCCESS] Binary successfully unpacked: $up_res"
            return 0
        else
            echo "[ERROR] Failed to unpack binary. Ensure Steamless CLI is installed or run under Wine." >&2
            return 1
        fi
    else
        echo "[INFO] Architecture undetermined. Probing Linux ELF and Windows PE unpackers..."
        if unpack_steamstub_elf "$target" || unpack_steamstub_pe "$target"; then
            up_res=$(resolve_unpacked_binary "$(dirname "$target")" "$(basename "$target")" 2>/dev/null || true)
            echo "[SUCCESS] Binary successfully unpacked: $up_res"
            return 0
        else
            echo "[ERROR] Failed to unpack binary with available unpackers." >&2
            return 1
        fi
    fi
}


# --- [MODULE] src/core/18_process_runtime.sh ---
# Binary Resolution, Shebang Detection & Active Process SSoT Helpers

# Check if a regular file begins with a POSIX shebang (#!)
_is_shebang_script() {
    local f="${1:-}" magic=""
    [ -s "$f" ] && [ ! -d "$f" ] || return 1
    IFS= read -r -n 2 magic < "$f" 2>/dev/null || true
    [ "$magic" = "#!" ]
}

# Print ELF class ("64", "32", or "0") if non-empty regular file starts with ELF magic
_read_elf_class() {
    local f="${1:-}" hdr=""
    [ -s "$f" ] && [ ! -d "$f" ] || return 1
    hdr=$(od -An -tx1 -N5 "$f" 2>/dev/null | tr -d ' \n' || true)
    case "$hdr" in
        7f454c4602) echo "64"; return 0 ;;
        7f454c4601) echo "32"; return 0 ;;
        7f454c46*)  echo "0";  return 0 ;;
    esac
    return 1
}

# Check if filename is an ignorable non-launcher artifact
_is_ignored_binary_name() {
    case "${1:-}" in
        *.so|*.so.*|*.dll|*.dylib|*.exe|*.EXE|*.lock|*.log|installscript.vdf|*.png|*.bmp|*.txt|*.pkg|\
        createdump|monoconfig|monomachineconfig|*.vdf|*.json|*.cfg|*.ini|*.xml|*.md|*.README|*.config|*.orig)
            return 0 ;;
    esac
    return 1
}

# Select best native Linux executable from directory prioritizing host architecture
_pick_native_linux_binary() {
    local dir="$1"
    local host_arch
    host_arch="$(uname -m 2>/dev/null || echo x86_64)"
    local is_64bit=false
    case "$host_arch" in
        x86_64|amd64|aarch64) is_64bit=true ;;
    esac

    local f fname elf_cls is_script preferred_bin="" fallback_bin=""
    for f in "$dir"/*; do
        [ -x "$f" ] && [ -s "$f" ] && [ ! -d "$f" ] || continue
        fname="${f##*/}"
        validate_tui_fields "$fname" || continue
        _is_ignored_binary_name "$fname" && continue

        elf_cls=""
        is_script=false
        if _is_shebang_script "$f"; then
            is_script=true
        elif ! elf_cls=$(_read_elf_class "$f"); then
            continue
        fi

        if [ "$is_64bit" = true ]; then
            if [ "$is_script" = true ] || [ "$elf_cls" = "64" ] || \
               [[ "$fname" == *.x86_64 || "$fname" == *.x64 || "$fname" == *_64 || "$fname" == *64 ]]; then
                preferred_bin="$fname"
                break
            fi
            [ -z "$fallback_bin" ] && fallback_bin="$fname"
        else
            if [ "$is_script" = true ] || [ "$elf_cls" = "32" ] || \
               [[ "$fname" == *.x86 || "$fname" == *32 ]]; then
                preferred_bin="$fname"
                break
            fi
            [ -z "$fallback_bin" ] && fallback_bin="$fname"
        fi
    done

    if [ -n "$preferred_bin" ]; then
        echo "$preferred_bin"
        return 0
    fi
    if [ -n "$fallback_bin" ]; then
        echo "$fallback_bin"
        return 0
    fi
    return 1
}

# Dynamic executable finder for game directory
find_game_binary() {
    local dir="$1"
    local base
    base=$(basename "$dir")
    local clean_base="${base// /}"
    local lower_base="${base,,}"
    local lower_clean="${clean_base,,}"

    # Priority 1: Common launch scripts or matching names (auto-+x shebang scripts)
    local candidates=(
        "start.sh" "run.sh" "launch.sh" "start" "run"
        "$base" "$clean_base" "$lower_base" "$lower_clean"
    )
    local c
    for c in "${candidates[@]}"; do
        if [ -f "$dir/$c" ] && [ ! -d "$dir/$c" ]; then
            validate_tui_fields "$c" || continue
            if [ ! -x "$dir/$c" ] && _is_shebang_script "$dir/$c"; then
                chmod +x "$dir/$c" 2>/dev/null || true
            fi
            if [ -x "$dir/$c" ]; then
                echo "$c"
                return 0
            fi
        fi
    done

    # Priority 2: Native Linux executables matching host architecture
    local native_bin
    if native_bin=$(_pick_native_linux_binary "$dir"); then
        echo "$native_bin"
        return 0
    fi

    # Priority 3: Windows executables matching title/folder name
    local win_candidates=(
        "$base.exe" "$clean_base.exe" "$lower_base.exe" "$lower_clean.exe"
    )
    for c in "${win_candidates[@]}"; do
        if [ -f "$dir/$c" ] && [ ! -d "$dir/$c" ]; then
            validate_tui_fields "$c" || continue
            chmod +x "$dir/$c" 2>/dev/null || true
            echo "$c"
            return 0
        fi
    done

    # Priority 4: Any root .exe excluding setup/redist/crash handlers
    local f fname
    for f in "$dir"/*.exe "$dir"/*.EXE; do
        [ -f "$f" ] || continue
        fname="${f##*/}"
        validate_tui_fields "$fname" || continue
        case "$fname" in
            UnityCrashHandler*|*unins*|*setup*|*installer*|*redist*|DXSETUP*|dotnet*|*CrashReport*)
                continue
                ;;
            *)
                chmod +x "$f" 2>/dev/null || true
                echo "$fname"
                return 0
                ;;
        esac
    done

    # Priority 5: Subdirectory .exe in standard game binary folders
    local sub
    for sub in "bin" "bin/x64" "bin/Win64" "Binaries/Win64" "Binaries/Win32" "x64"; do
        if [ -d "$dir/$sub" ]; then
            for f in "$dir/$sub"/*.exe "$dir/$sub"/*.EXE; do
                [ -f "$f" ] || continue
                fname="${f##*/}"
                validate_tui_fields "$fname" || continue
                case "$fname" in
                    UnityCrashHandler*|*unins*|*setup*|*installer*|*redist*|DXSETUP*|dotnet*|*CrashReport*)
                        continue
                        ;;
                    *)
                        chmod +x "$f" 2>/dev/null || true
                        echo "$sub/$fname"
                        return 0
                        ;;
                esac
            done
        fi
    done

    # Priority 6: Unrecognized +x files when no native ELF/shebang or Windows PE exists
    for f in "$dir"/*; do
        [ -x "$f" ] && [ ! -d "$f" ] || continue
        fname="${f##*/}"
        validate_tui_fields "$fname" || continue
        _is_ignored_binary_name "$fname" && continue
        echo "$fname"
        return 0
    done

    return 1
}

# Extract an actionable 1-line diagnostic hint from a game's recent launch log
inspect_game_log_hint() {
    local log_file="${1:-}"
    [ -n "$log_file" ] && [ -f "$log_file" ] || return 0

    local tail_log
    tail_log=$(tail -n 60 "$log_file" 2>/dev/null || true)
    [ -n "$tail_log" ] || return 0

    if echo "$tail_log" | grep -qiE '0x887a0002|DXGI_ERROR|Vulkan support is incomplete|dxvk.*(failed|error|unable)|vkCreateInstance'; then
        echo "Graphics API error detected -> switch Renderer to WineD3D (<CTRL-O> or --wined3d)"
    elif echo "$tail_log" | grep -qiE 'err:module:import_dll|cannot open shared object file|error while loading shared libraries|libGL\.so\.1|System\.DllNotFoundException|DllNotFoundException|Unable to load shared library'; then
        echo "Missing runtime DLL/library -> run Community Fixes (<CTRL-X>) or install 32-bit multilib"
    elif echo "$tail_log" | grep -qiE 'Exec format error|cannot execute binary file|Permission denied'; then
        echo "Executable architecture or permission mismatch -> verify 64-bit binary / chmod +x"
    elif echo "$tail_log" | grep -qiE 'SteamStub|Application load error|steamclient.*fail'; then
        echo "SteamStub/DRM signature detected -> run unpack-stub or Inject GBE (<CTRL-I>)"
    fi
    return 0
}

# Emit active running game rows (FS=\x1f: PID, TITLE, DIR, BIN, LOG, INFO_FILE, SCOPE_UNIT) and prune stale info files
list_active_games() {
    local run_dir
    run_dir="$(get_runtime_dir)"
    local active_dir="$run_dir/active_games"
    [ -d "$active_dir" ] || return 0

    local inf p_pid p_title p_dir p_bin p_log p_scope
    local sep=$'\x1f'
    local had_nullglob=0
    shopt -q nullglob && had_nullglob=1
    shopt -s nullglob
    for inf in "$active_dir"/*.info; do
        [ -f "$inf" ] || continue
        p_pid="" p_title="" p_dir="" p_bin="" p_log="" p_scope=""
        local k v
        while IFS='=' read -r k v; do
            case "$k" in
                PID) p_pid="$v" ;;
                TITLE) p_title="$v" ;;
                DIR) p_dir="$v" ;;
                BIN) p_bin="$v" ;;
                LOG) p_log="$v" ;;
                SCOPE_UNIT) p_scope="$v" ;;
            esac
        done < "$inf"
        if [ -n "$p_pid" ] && kill -0 "$p_pid" 2>/dev/null; then
            printf '%s%s%s%s%s%s%s%s%s%s%s%s%s\n' \
                "$p_pid" "$sep" "$p_title" "$sep" "$p_dir" "$sep" "$p_bin" "$sep" "$p_log" "$sep" "$inf" "$sep" "$p_scope"
        else
            rm -f "$inf" 2>/dev/null || true
        fi
    done
    [ "$had_nullglob" -eq 0 ] && shopt -u nullglob
    return 0
}

# Find active game row matching target directory (exact or realpath canonical)
find_active_game_for_dir() {
    local gdir="${1:-}"
    [ -n "$gdir" ] || return 1
    local canon_gdir
    canon_gdir=$(realpath -e "$gdir" 2>/dev/null || echo "$gdir")

    local sep=$'\x1f'
    local r_pid r_title r_dir r_bin r_log r_inf r_scope r_canon
    while IFS="$sep" read -r r_pid r_title r_dir r_bin r_log r_inf r_scope; do
        [ -n "$r_pid" ] || continue
        if [ "$r_dir" = "$gdir" ]; then
            printf '%s%s%s%s%s%s%s%s%s%s%s%s%s\n' \
                "$r_pid" "$sep" "$r_title" "$sep" "$r_dir" "$sep" "$r_bin" "$sep" "$r_log" "$sep" "$r_inf" "$sep" "$r_scope"
            return 0
        fi
        r_canon=$(realpath -e "$r_dir" 2>/dev/null || echo "$r_dir")
        if [ "$r_canon" = "$canon_gdir" ]; then
            printf '%s%s%s%s%s%s%s%s%s%s%s%s%s\n' \
                "$r_pid" "$sep" "$r_title" "$sep" "$r_dir" "$sep" "$r_bin" "$sep" "$r_log" "$sep" "$r_inf" "$sep" "$r_scope"
            return 0
        fi
    done < <(list_active_games)
    return 1
}

# Return active game summary as "COUNT\x1fTITLE1, TITLE2"
get_active_games_summary() {
    local count=0 titles="" sep=$'\x1f'
    local r_pid r_title _rest
    while IFS="$sep" read -r r_pid r_title _rest; do
        [ -n "$r_pid" ] || continue
        count=$((count + 1))
        if [ -z "$titles" ]; then
            titles="$r_title"
        else
            titles="$titles, $r_title"
        fi
    done < <(list_active_games)
    printf '%d%s%s\n' "$count" "$sep" "$titles"
}

# Audit a Native Linux ELF executable via ldd and emit "ARCH\x1flib1, lib2" for missing shared libraries
list_missing_elf_libs() {
    local gdir="${1:-}"
    local gbin="${2:-}"
    [ -n "$gdir" ] && [ -n "$gbin" ] && [ -d "$gdir" ] && [ -f "$gdir/$gbin" ] || return 1
    command -v ldd >/dev/null 2>&1 || return 1

    local elf_cls=""
    elf_cls=$(_read_elf_class "$gdir/$gbin") || return 1

    local arch_label="ELF" rel_ld=".:lib64:lib"
    case "$elf_cls" in
        32) arch_label="32-bit"; rel_ld=".:lib" ;;
        64) arch_label="64-bit"; rel_ld=".:lib64:lib" ;;
    esac

    # Use cd + relative LD_LIBRARY_PATH so directory names with ':' never split lookup entries
    local ldd_out="" missing_joined=""
    ldd_out=$(cd "$gdir" && LC_ALL=C LD_LIBRARY_PATH="${rel_ld}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ldd -- "./$gbin" 2>/dev/null || true)
    [ -n "$ldd_out" ] || return 1

    missing_joined=$(awk '/=> not found/ {
        sub(/^[ \t]+/, "", $1)
        if ($1 != "" && !seen[$1]++) {
            out = (out == "" ? $1 : out ", " $1)
        }
    }
    END { print out }' <<< "$ldd_out")

    [ -n "$missing_joined" ] || return 1
    printf '%s\x1f%s\n' "$arch_label" "$missing_joined"
    return 0
}

# Probe newly launched game across startup window to catch early crashes cleanly
verify_launched_game_startup() {
    local gdir="${1:-}"
    local gbin="${2:-}"
    local title="${3:-}"
    local probe_ticks="${GAMECTL_LAUNCH_PROBE_TICKS:-10}"
    [[ "$probe_ticks" =~ ^[0-9]+$ ]] && [ "$probe_ticks" -ge 1 ] || probe_ticks=10

    GAMECTL_VERIFY_PID=""
    GAMECTL_VERIFY_LOG=""
    GAMECTL_VERIFY_INFO=""
    GAMECTL_VERIFY_SUMMARY=""

    local row=""
    row=$(find_active_game_for_dir "$gdir" 2>/dev/null || true)
    if [ -z "$row" ]; then
        sleep 0.1
        row=$(find_active_game_for_dir "$gdir" 2>/dev/null || true)
    fi

    local sep=$'\x1f'
    local v_pid="" v_title="" v_dir="" v_bin="" v_log="" v_inf="" v_scope=""
    if [ -n "$row" ]; then
        IFS="$sep" read -r v_pid v_title v_dir v_bin v_log v_inf v_scope <<< "$row"
    fi

    local alive=false
    if [ -n "$v_pid" ]; then
        alive=true
        local tick=0
        while [ "$tick" -lt "$probe_ticks" ]; do
            if ! kill -0 "$v_pid" 2>/dev/null; then
                alive=false
                break
            fi
            tick=$((tick + 1))
            [ "$tick" -lt "$probe_ticks" ] && sleep 0.1
        done
    fi

    if [ "$alive" = true ]; then
        GAMECTL_VERIFY_PID="$v_pid"
        GAMECTL_VERIFY_LOG="$v_log"
        GAMECTL_VERIFY_INFO="$v_inf"
        export GAMECTL_VERIFY_PID GAMECTL_VERIFY_LOG GAMECTL_VERIFY_INFO
        return 0
    fi

    [ -n "$v_inf" ] && rm -f "$v_inf" 2>/dev/null || true
    [ -z "$v_log" ] && v_log="$(get_game_log_file "$gdir" "$gbin")"
    GAMECTL_VERIFY_LOG="$v_log"
    export GAMECTL_VERIFY_LOG

    local v_hint="" v_tail="" missing_info="" m_arch="" m_libs=""
    v_hint=$(inspect_game_log_hint "$v_log" 2>/dev/null || true)
    missing_info=$(list_missing_elf_libs "$gdir" "$gbin" 2>/dev/null || true)
    if [ -n "$missing_info" ]; then
        IFS="$sep" read -r m_arch m_libs <<< "$missing_info"
        [ -z "$v_hint" ] && v_hint="Missing $m_arch shared libraries -> install required multilib/system packages"
    fi
    if [ -s "$v_log" ]; then
        v_tail=$(tail -n 12 "$v_log" 2>/dev/null || true)
    else
        v_tail="(No diagnostic output recorded in log file.)"
    fi

    GAMECTL_VERIFY_SUMMARY="Game '$title' exited immediately after launch."
    [ -n "$v_hint" ] && GAMECTL_VERIFY_SUMMARY+=$'\n\n'"[HINT] $v_hint"
    [ -n "$m_libs" ] && GAMECTL_VERIFY_SUMMARY+=$'\n\n'"Missing Shared Libraries ($m_arch):"$'\n'"$m_libs"
    GAMECTL_VERIFY_SUMMARY+=$'\n\n'"Recent Log Output:"$'\n'"$v_tail"$'\n\n'"Full log:"$'\n'"$v_log"
    export GAMECTL_VERIFY_SUMMARY
    return 1
}

# --- [MODULE] src/steam/20_discovery.sh ---

# Discover active Steam root directory across standard, custom, Flatpak, and Snap installations
get_steam_root() {
    if [ -n "${STEAM_ROOT:-}" ] && [ -d "$STEAM_ROOT" ]; then
        echo "$STEAM_ROOT"
        return 0
    fi

    local candidate
    for candidate in \
        "$HOME/.local/share/Steam" \
        "$HOME/.steam/steam" \
        "$HOME/.steam/root" \
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam" \
        "$HOME/snap/steam/common/.local/share/Steam"; do
        if [ -d "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    return 1
}

# Discover active primary steamapps directory
get_steam_primary_apps() {
    local s_root
    s_root="$(get_steam_root 2>/dev/null || true)"
    if [ -n "$s_root" ] && [ -d "$s_root/steamapps" ]; then
        echo "$s_root/steamapps"
        return 0
    fi

    local first_lib
    first_lib="$(get_steam_libraries 2>/dev/null | head -n 1 || true)"
    if [ -n "$first_lib" ] && [ -d "$first_lib" ]; then
        echo "$first_lib"
        return 0
    fi

    echo "$HOME/.local/share/Steam/steamapps"
}

# Discover active SLSsteam configuration directory
get_sls_root() {
    local xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
    echo "$xdg/SLSsteam"
}

# Discover active SLSsteam manifests storage directory
get_sls_manifests_dir() {
    local sls_root
    sls_root="$(get_sls_root)"
    echo "$sls_root/manifests"
}

# Discover active Steam stplug-in Lua directory
get_steam_stplug_in_dir() {
    local s_root
    s_root="$(get_steam_root 2>/dev/null || echo "$HOME/.local/share/Steam")"
    echo "$s_root/config/stplug-in"
}

# Discover active Steam depotcache directory
get_steam_depotcache_dir() {
    local s_root
    s_root="$(get_steam_root 2>/dev/null || echo "$HOME/.local/share/Steam")"
    echo "$s_root/depotcache"
}

# Discover all configured Steam library paths with deduplication
get_steam_libraries() {
    declare -A seen_libs=()
    local candidate_roots=(
        "${STEAM_ROOT:-}"
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.steam/root"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
        "$HOME/snap/steam/common/.local/share/Steam"
    )

    for root in "${candidate_roots[@]}"; do
        [ -n "$root" ] && [ -d "$root" ] || continue

        local primary="$root/steamapps"
        if [ -d "$primary" ]; then
            local real_primary
            real_primary="$(realpath "$primary" 2>/dev/null || echo "$primary")"
            if [ -z "${seen_libs["$real_primary"]:-}" ]; then
                seen_libs["$real_primary"]=1
                echo "$primary"
            fi
        fi

        # Check libraryfolders.vdf
        local vdf_candidates=(
            "$root/steamapps/libraryfolders.vdf"
            "$root/config/libraryfolders.vdf"
        )
        for vdf in "${vdf_candidates[@]}"; do
            [ -f "$vdf" ] || continue
            local line p_path
            while read -r line; do
                p_path=$(echo "$line" | sed -E 's/.*"path"[[:space:]]+"([^"]+)".*/\1\/steamapps/')
                if [ -d "$p_path" ]; then
                    local real_p
                    real_p="$(realpath "$p_path" 2>/dev/null || echo "$p_path")"
                    if [ -z "${seen_libs["$real_p"]:-}" ]; then
                        seen_libs["$real_p"]=1
                        echo "$p_path"
                    fi
                fi
            done < <(grep -E '^\s*"path"' "$vdf" 2>/dev/null || true)
        done
    done
}

# Scan installed games dynamically in standard & custom paths (v3 6-column schema)
scan_installed_games() {
    local is_formatted=false
    local force_refresh=false
    local store_filter="ALL"

    while [ $# -gt 0 ]; do
        case "$1" in
            --formatted|-f) is_formatted=true ;;
            --refresh|--no-cache|-r) force_refresh=true ;;
            --store)
                shift
                store_filter="${1:-ALL}"
                ;;
            --store=*)
                store_filter="${1#--store=}"
                ;;
        esac
        shift || true
    done
    store_filter="${store_filter^^}"
    [ -n "$store_filter" ] || store_filter="ALL"

    local cache_dir
    cache_dir="$(get_runtime_dir)"
    local cache_file="$cache_dir/scancache.tab"

    local epic_cfg_dir="${LEGENDARY_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/legendary}"
    declare -F _epic_config_dir >/dev/null 2>&1 && epic_cfg_dir="$(_epic_config_dir)"
    local epic_installed="$epic_cfg_dir/installed.json"

    local amazon_cfg_dir="${NILE_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/nile}"
    declare -F _amazon_config_dir >/dev/null 2>&1 && amazon_cfg_dir="$(_amazon_config_dir)"
    local amazon_installed="$amazon_cfg_dir/installed.json"

    # Fast-path: Check cache validity (TTL: 60s, invalidated if candidate library directories are newer)
    local use_cached=false
    if [ "$force_refresh" = false ] && [ -f "$cache_file" ] &&
       [ "$(head -n 1 "$cache_file")" = "# gamectl scanner v3" ]; then
        local now mtime
        now=$(date +%s)
        mtime=$(stat -c%Y "$cache_file" 2>/dev/null || echo 0)
        if [ $((now - mtime)) -lt 60 ]; then
            use_cached=true
            local lib_check
            for lib_check in "$HOME/Games" "$HOME/GOG Games" "$HOME/.local/share/Steam/steamapps" "$HOME/.local/share/lutris/games"; do
                if [ -d "$lib_check" ] && [ "$lib_check" -nt "$cache_file" ]; then
                    use_cached=false
                    break
                fi
            done
            if [ "$use_cached" = true ] && [ -f "$epic_installed" ] && [ "$epic_installed" -nt "$cache_file" ]; then
                use_cached=false
            fi
            if [ "$use_cached" = true ] && [ -f "$amazon_installed" ] && [ "$amazon_installed" -nt "$cache_file" ]; then
                use_cached=false
            fi
        fi
    fi

    if [ "$use_cached" = false ]; then
        printf '%s\n' '# gamectl scanner v3' > "$cache_file.tmp"
        declare -A seen_dirs=()
        declare -A seen_appids=()

        # 1. Scan Steam Libraries
        local steam_lib
        local re_appid='"appid"[[:space:]]+"([0-9]+)"'
        local re_name='"name"[[:space:]]+"([^"]+)"'
        local re_installdir='"installdir"[[:space:]]+"([^"]+)"'
        while IFS= read -r steam_lib; do
            [ -d "$steam_lib" ] || continue
            for acf in "$steam_lib"/appmanifest_*.acf; do
                [ -f "$acf" ] || continue

                # Single-pass regex parse of ACF manifest without subshell forks
                local appid="" name="" installdir=""
                while IFS= read -r acf_line; do
                    if [[ "$acf_line" =~ $re_appid ]]; then
                        appid="${BASH_REMATCH[1]}"
                    elif [[ "$acf_line" =~ $re_name ]]; then
                        name="${BASH_REMATCH[1]}"
                    elif [[ "$acf_line" =~ $re_installdir ]]; then
                        installdir="${BASH_REMATCH[1]}"
                    fi
                    [ -n "$appid" ] && [ -n "$name" ] && [ -n "$installdir" ] && break
                done < "$acf"

                # Filter out Proton, Steam Linux Runtimes, and tools
                [[ "$name" =~ ^(Steam Linux Runtime|Proton|Steamworks) ]] && continue
                [ -z "$installdir" ] && continue

                local gdir="$steam_lib/common/$installdir"
                validate_tui_fields "$appid" "$name" "$gdir" || continue
                [ -d "$gdir" ] || continue

                local canon_gdir
                canon_gdir=$(realpath -e "$gdir" 2>/dev/null || echo "$gdir")
                [[ -v seen_dirs["$canon_gdir"] ]] && continue
                [[ -v seen_dirs["$gdir"] ]] && continue
                seen_dirs["$canon_gdir"]=1
                seen_dirs["$gdir"]=1
                [ -n "$appid" ] && [ "$appid" != "STANDALONE" ] && seen_appids["$appid"]=1

                local gbin
                gbin=$(find_game_binary "$gdir") || continue
                [ -z "$gbin" ] && continue

                local status
                status=$(resolve_game_drm_status "$gdir" "" "$gbin")

                [ -z "$appid" ] && appid="STANDALONE"
                printf "%s\t%s\t%s\t%s\t%s\tSTEAM\n" "$appid" "$name" "$status" "$gdir" "$gbin" >> "$cache_file.tmp"
            done
        done < <(get_steam_libraries)

        # 1b/1c. Scan Epic & Amazon JSON manifests before custom dirs to deduplicate ~/Games/
        _scan_json_store_entries() {
            local s_label="$1" s_tag="$2" s_file="$3" allow_arr="${4:-0}" j_rows=""
            [ -f "$s_file" ] && command -v jq >/dev/null 2>&1 || return 0
            if j_rows=$(jq -r --arg aa "$allow_arr" '
                (if type == "object" then to_entries | map({k:.key, v:.value})
                 elif ($aa == "1" and type == "array") then to_entries | map({k:(.key|tostring), v:.value})
                 else error("invalid") end)[] | (.k | tostring) as $k |
                if (.v | type) != "object" then "ERR\t" + ($k | gsub("[\\t\\r\\n]"; "_"))
                else
                    ((.v.app_name // .v.id // .v.product.id // (if ($aa == "1" and ($k | test("^[0-9]+$"))) then "" else $k end)) | tostring) as $id |
                    ((.v.title // .v.product.title // $id) | tostring) as $title |
                    ((.v.path // .v.install_path // "") | tostring) as $ipath |
                    ((.v.executable // "") | tostring) as $exe |
                    if ($id == "") or ($ipath == "") or ($id | test("[\\t\\r\\n]")) or ($title | test("[\\t\\r\\n]")) or ($ipath | test("[\\t\\r\\n]")) or ($exe | test("[\\t\\r\\n]")) then
                        "ERR\t" + ($k | gsub("[\\t\\r\\n]"; "_"))
                    else ["OK", $id, $title, $ipath, $exe] | @tsv end
                end' "$s_file" 2>/dev/null); then
                local j_kind j_id j_title j_path j_exe
                while IFS=$'\t' read -r j_kind j_id j_title j_path j_exe; do
                    [ -n "$j_kind" ] || continue
                    if [ "$j_kind" = "ERR" ]; then
                        printf '[ERROR] Invalid %s metadata entry (%s) in %s\n' "$s_label" "${j_id:-unknown}" "$s_file" >&2; continue
                    fi
                    [ -d "$j_path" ] || continue
                    local canon_jdir; canon_jdir=$(realpath -e "$j_path" 2>/dev/null || echo "$j_path")
                    [[ -v seen_dirs["$canon_jdir"] ]] || [[ -v seen_dirs["$j_path"] ]] && continue
                    seen_dirs["$canon_jdir"]=1; seen_dirs["$j_path"]=1
                    local j_gbin=""
                    if [ -n "$j_exe" ] && [[ "$j_exe" != /* ]] && [[ "$j_exe" != *".."* ]] && [ -f "$j_path/$j_exe" ]; then j_gbin="$j_exe"
                    else j_gbin=$(find_game_binary "$j_path") || continue; fi
                    [ -n "$j_gbin" ] || continue
                    validate_tui_fields "$j_id" "$j_title" "$j_path" "$j_gbin" || continue
                    local j_status; j_status=$(resolve_game_drm_status "$j_path" "" "$j_gbin")
                    [ "$j_status" = "STANDALONE" ] && j_status="$s_tag"
                    printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$j_id" "$j_title" "$j_status" "$j_path" "$j_gbin" "$s_tag" >> "$cache_file.tmp"
                done <<< "$j_rows"
            else
                printf '[ERROR] Invalid %s installed.json payload in %s\n' "$s_label" "$s_file" >&2
            fi
        }
        _scan_json_store_entries "Epic" "EPIC" "$epic_installed" "0"
        _scan_json_store_entries "Amazon" "AMAZON" "$amazon_installed" "1"

        # 2. Scan Custom & Standalone Directories
        local custom_search_dirs=(
            "$HOME/Games"
            "$HOME/GOG Games"
            "$HOME/.local/share/lutris/games"
        )

        # Allow extending library directories via ~/.config/gamectl/libraries or env
        if [ -f "$HOME/.config/gamectl/library_dir" ]; then
            local p_lib
            p_lib=$(head -n 1 "$HOME/.config/gamectl/library_dir" 2>/dev/null | tr -d '\r\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            [ -n "$p_lib" ] && custom_search_dirs+=("${p_lib/#\~/$HOME}")
        fi
        if [ -f "$HOME/.config/gamectl/libraries" ]; then
            while IFS= read -r line || [ -n "$line" ]; do
                line="${line#"${line%%[![:space:]]*}"}" # trim leading
                line="${line%"${line##*[![:space:]]}"}" # trim trailing
                [ -z "$line" ] && continue
                [[ "$line" =~ ^# ]] && continue
                custom_search_dirs+=("${line/#\~/$HOME}")
            done < "$HOME/.config/gamectl/libraries"
        fi

        if [ -n "${GAMECTL_LIBRARY_DIR:-}" ]; then
            custom_search_dirs+=("${GAMECTL_LIBRARY_DIR/#\~/$HOME}")
        fi
        if [ -n "${GAMECTL_LIBRARY_DIRS:-}" ]; then
            IFS=":" read -r -a extra_dirs <<< "$GAMECTL_LIBRARY_DIRS"
            custom_search_dirs+=("${extra_dirs[@]}")
        fi

        for base_dir in "${custom_search_dirs[@]}"; do
            [ -d "$base_dir" ] || continue
            for gdir in "$base_dir"/*; do
                [ -d "$gdir" ] || continue
                validate_tui_fields "$gdir" || continue

                local canon_gdir
                canon_gdir=$(realpath -e "$gdir" 2>/dev/null || echo "$gdir")
                [[ -v seen_dirs["$canon_gdir"] ]] && continue
                [[ -v seen_dirs["$gdir"] ]] && continue
                seen_dirs["$canon_gdir"]=1
                seen_dirs["$gdir"]=1

                local folder_name="${gdir##*/}"
                [[ "$folder_name" =~ ^\. ]] && continue

                local gbin
                gbin=$(find_game_binary "$gdir") || continue
                [ -z "$gbin" ] && continue

                local row_store="STANDALONE" gog_info="" gog_id="" gog_name="" _gf
                for _gf in "$gdir"/goggame-*.info; do
                    [ -f "$_gf" ] && gog_info="$_gf" && break
                done
                if [ -n "$gog_info" ]; then
                    local gog_tsv=""
                    if ! gog_tsv=$(jq -r '[((.gameId // .rootGameId // "") | tostring), ((.name // "") | tostring)] | if any(test("[\\t\\r\\n]")) then error("invalid") else @tsv end' "$gog_info" 2>/dev/null); then
                        printf '[ERROR] Invalid GOG metadata in %s\n' "$gdir" >&2
                        continue
                    fi
                    IFS=$'\t' read -r gog_id gog_name <<< "$gog_tsv"
                    if [ -z "$gog_id" ]; then
                        local _gbase="${gog_info##*/}"
                        _gbase="${_gbase#goggame-}"
                        gog_id="${_gbase%.info}"
                    fi
                    row_store="GOG"
                elif [ -f "$gdir/.gog_id" ]; then
                    gog_id=$(cat "$gdir/.gog_id" 2>/dev/null) || gog_id=""
                    if [ -f "$gdir/gameinfo" ]; then
                        gog_name=$(head -n 1 "$gdir/gameinfo" 2>/dev/null) || gog_name=""
                    fi
                    [ -n "$gog_id" ] && row_store="GOG"
                fi

                local appid
                if [ "$row_store" = "GOG" ]; then
                    appid="${gog_id:-STANDALONE}"
                else
                    appid="$(resolve_game_appid "$gdir" "STANDALONE")"
                fi

                # AppID collision precedence: skip duplicate Steam AppID if already discovered in Steam library
                if [ "$row_store" != "GOG" ] && [ "$appid" != "STANDALONE" ] && [[ -v seen_appids["$appid"] ]]; then
                    continue
                fi
                [ "$row_store" != "GOG" ] && [ "$appid" != "STANDALONE" ] && seen_appids["$appid"]=1

                local title="${gog_name:-$folder_name}"
                if [ -f "$gdir/.gamectl_title" ]; then
                    title=$(cat "$gdir/.gamectl_title" 2>/dev/null) || title="$folder_name"
                fi
                [ -n "$title" ] || title="$folder_name"
                validate_tui_fields "$appid" "$title" "$gbin" || continue

                local status
                status=$(resolve_game_drm_status "$gdir" "" "$gbin")
                [ "$row_store" = "GOG" ] && [ "$status" = "STANDALONE" ] && status="GOG"

                printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$appid" "$title" "$status" "$gdir" "$gbin" "$row_store" >> "$cache_file.tmp"
            done
        done
        mv -f "$cache_file.tmp" "$cache_file"
    fi

    # Render formatted or raw tab entries (6-column v3 TSV: APPID, TITLE, STATUS, GAME_DIR, GAME_BIN, STORE)
    if [ "$is_formatted" = true ]; then
        declare -A _running_dirs=()
        if declare -F list_active_games >/dev/null 2>&1; then
            local _r_pid _r_title _r_dir _r_rest _r_canon _r_sep=$'\x1f'
            while IFS="$_r_sep" read -r _r_pid _r_title _r_dir _r_rest; do
                [ -n "$_r_pid" ] && [ -n "$_r_dir" ] || continue
                _running_dirs["$_r_dir"]=1
                _r_canon=$(realpath -e "$_r_dir" 2>/dev/null || echo "$_r_dir")
                _running_dirs["$_r_canon"]=1
            done < <(list_active_games)
        fi
        while IFS=$'\t' read -r c_appid c_title c_status c_gdir c_gbin c_store; do
            [[ "$c_appid" == \#* ]] && continue
            [ -z "$c_gdir" ] && continue
            c_store="${c_store:-STANDALONE}"
            [ "$store_filter" != "ALL" ] && [ "${c_store^^}" != "$store_filter" ] && continue
            local c_badge=""
            case "$c_status" in
                *GBE_FORK*)   c_badge="${UI_GREEN}[GBE_FORK]  ${UI_RST}" ;;
                *VALVE_SO*)   c_badge="${UI_AMBER}[VALVE_SO]  ${UI_RST}" ;;
                *VALVE_DLL*)  c_badge="${UI_CYAN}[VALVE_DLL] ${UI_RST}" ;;
                *GOG*)        c_badge="${UI_PURPLE}[GOG]       ${UI_RST}" ;;
                *EPIC*)       c_badge="${UI_CYAN}[EPIC]      ${UI_RST}" ;;
                *AMAZON*)     c_badge="${UI_AMBER}[AMAZON]    ${UI_RST}" ;;
                *)            c_badge="${UI_ICE}[STANDALONE]${UI_RST}" ;;
            esac
            local _c_canon=""
            if [ ${#_running_dirs[@]} -gt 0 ]; then
                if [[ -v _running_dirs["$c_gdir"] ]]; then
                    c_badge="${UI_GREEN}[RUNNING]${UI_RST} $c_badge"
                else
                    _c_canon=$(realpath -e "$c_gdir" 2>/dev/null || echo "$c_gdir")
                    if [[ -v _running_dirs["$_c_canon"] ]]; then
                        c_badge="${UI_GREEN}[RUNNING]${UI_RST} $c_badge"
                    fi
                fi
            fi
            printf "%s\t%s\t%s\t%s\t%s\t%s\n" "${UI_DIM}${c_appid}${UI_RST}" "${UI_BOLD}${c_title}${UI_RST}" "$c_badge" "$c_gdir" "$c_gbin" "$c_store"
        done < "$cache_file"
    else
        while IFS=$'\t' read -r c_appid c_title c_status c_gdir c_gbin c_store; do
            [[ "$c_appid" == \#* ]] && continue
            [ -z "$c_gdir" ] && continue
            c_store="${c_store:-STANDALONE}"
            [ "$store_filter" != "ALL" ] && [ "${c_store^^}" != "$store_filter" ] && continue
            local clean_stat="$c_status"
            [[ "$clean_stat" != \[*\] ]] && clean_stat="[$clean_stat]"
            printf "%-8s\t%-22s\t%-12s\t%s\t%s\t%s\n" "$c_appid" "$c_title" "$clean_stat" "$c_gdir" "$c_gbin" "$c_store"
        done < "$cache_file"
    fi
}

# Standalone-source compatibility: load split discovery submodules when sourced directly outside bin/gamectl
if [ -z "${GAMECTL_BUNDLED:-}" ] && [ -n "${BASH_SOURCE[0]:-}" ]; then
    _disc_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    for _disc_sub in 21_shortcuts_artwork.sh; do
        if [ -f "$_disc_dir/$_disc_sub" ]; then
            # shellcheck source=/dev/null
            source "$_disc_dir/$_disc_sub"
        fi
    done
    unset _disc_dir _disc_sub
fi

# --- [MODULE] src/steam/21_shortcuts_artwork.sh ---
# ==============================================================================
# Desktop Entries, Steam Grid Artwork & Steam Deck Shortcuts (Split from 20_discovery.sh)
# ==============================================================================

# Generate FreeDesktop .desktop application shortcut (Chunk 5)
create_desktop_entry() {
    local game_dir="${1:-}"
    local title="${2:-}"

    if [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        echo "[ERROR] Game directory not found or invalid: $game_dir" >&2
        echo "Usage: gamectl make-desktop <game_dir> [title]" >&2
        return 1
    fi

    game_dir="$(cd "$game_dir" 2>/dev/null && pwd || echo "$game_dir")"

    # Attempt to resolve title if not supplied
    if [ -z "$title" ]; then
        local base_dir
        base_dir="$(basename "$game_dir")"
        local parent_apps
        parent_apps="$(dirname "$game_dir")"
        if [ "$(basename "$parent_apps")" = "common" ]; then
            local steamapps_dir
            steamapps_dir="$(dirname "$parent_apps")"
            local acf
            for acf in "$steamapps_dir"/appmanifest_*.acf; do
                [ -f "$acf" ] || continue
                local installdir
                installdir=$(grep -E '^\s*"installdir"' "$acf" | head -n 1 | sed -E 's/.*"installdir"[[:space:]]+"([^"]+)".*/\1/')
                if [ "$installdir" = "$base_dir" ]; then
                    title=$(grep -E '^\s*"name"' "$acf" | head -n 1 | sed -E 's/.*"name"[[:space:]]+"([^"]+)".*/\1/')
                    break
                fi
            done
        fi
        [ -z "$title" ] && title="$base_dir"
    fi

    # Locate game binary
    local gbin
    gbin="$(find_game_binary "$game_dir" 2>/dev/null || true)"
    if [ -z "$gbin" ]; then
        echo "[WARN] Game executable binary not detected automatically in $game_dir" >&2
    fi

    # Locate game icon (prefer icon.png, icon.ico, logo.png, or any png/ico)
    local icon_path="applications-games"
    local found_icon=""
    for candidate in "icon.png" "icon.ico" "logo.png" "app.png" "banner.png"; do
        if [ -f "$game_dir/$candidate" ]; then
            found_icon="$game_dir/$candidate"
            break
        fi
    done
    if [ -z "$found_icon" ]; then
        found_icon=$(find "$game_dir" -maxdepth 2 \( -name "*.ico" -o -name "*.png" \) 2>/dev/null | head -n 1 || true)
    fi
    [ -n "$found_icon" ] && icon_path="$found_icon"

    # Resolve gamectl binary
    local gamectl_bin
    gamectl_bin="$(command -v gamectl 2>/dev/null || true)"
    if [ -z "$gamectl_bin" ]; then
        if [ -x "$HOME/.local/bin/gamectl" ]; then
            gamectl_bin="$HOME/.local/bin/gamectl"
        elif [ -x "/usr/local/bin/gamectl" ]; then
            gamectl_bin="/usr/local/bin/gamectl"
        else
            gamectl_bin="gamectl"
        fi
    fi

    # Sanitize title for desktop entry file name
    local safe_title
    safe_title=$(echo "$title" | tr -dc '[:alnum:]_-' | tr '[:upper:]' '[:lower:]')
    [ -z "$safe_title" ] && safe_title="game"

    local desk_dir="$HOME/.local/share/applications"
    mkdir -p "$desk_dir"
    local desk_file="$desk_dir/gamectl-${safe_title}.desktop"

    cat <<EOF > "$desk_file"
[Desktop Entry]
Type=Application
Name=$title
Comment=Launched via gamectl
Exec=$gamectl_bin launch "$game_dir" --hud
Icon=$icon_path
Terminal=false
Categories=Game;
Path=$game_dir
StartupNotify=true
EOF

    chmod +x "$desk_file"
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$desk_dir" 2>/dev/null || true
    fi

    echo "[VERIFIED] Desktop entry created successfully: $desk_file"
    echo "[INFO] Title    : $title"
    echo "[INFO] Exec     : $gamectl_bin launch \"$game_dir\" --hud"
    echo "[INFO] Icon     : $icon_path"
    return 0
}

# Resolve active Steam user grid directory (~/.local/share/Steam/userdata/<account_id>/config/grid)
get_steam_grid_dir() {
    if [ -n "${GAMECTL_GRID_DIR:-}" ]; then
        echo "$GAMECTL_GRID_DIR"
        return 0
    fi

    local s_roots=(
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.steam/root"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
        "$HOME/snap/steam/common/.local/share/Steam"
    )
    for s_root in "${s_roots[@]}"; do
        if [ -d "$s_root/userdata" ]; then
            for udir in "$s_root/userdata"/*; do
                [ -d "$udir" ] || continue
                local u_id
                u_id=$(basename "$udir")
                if [[ "$u_id" =~ ^[0-9]+$ ]] && [ "$u_id" -gt 0 ] 2>/dev/null; then
                    echo "$udir/config/grid"
                    return 0
                fi
            done
        fi
    done

    # Fallback to default
    echo "$HOME/.local/share/Steam/userdata/0/config/grid"
}

# Fetch official artwork (portrait, banner, hero, logo) from Steam CDN
fetch_steam_artwork() {
    local target="${1:-}"
    local appid="${2:-}"

    if [ -z "$target" ]; then
        echo "Usage: gamectl fetch-art <game_dir|appid> [appid]" >&2
        return 1
    fi

    local game_dir=""
    if [[ "$target" =~ ^[0-9]+$ ]] && [ -z "$appid" ]; then
        appid="$target"
    elif [ -d "$target" ]; then
        game_dir="$target"
    elif [ -f "$target" ]; then
        game_dir="$(dirname "$target")"
    fi

    # Resolve AppID from directory if not explicitly provided
    if [ -z "$appid" ] && [ -n "$game_dir" ]; then
        appid="$(resolve_game_appid "$game_dir")"
    fi

    if [ -z "$appid" ]; then
        echo "[ERROR] Cannot resolve Steam AppID for target: $target" >&2
        echo "        Provide a numeric AppID: gamectl fetch-art <dir> <appid>" >&2
        return 1
    fi

    local grid_dir
    grid_dir=$(get_steam_grid_dir)
    mkdir -p "$grid_dir"

    # Identify target shortcut and artwork IDs
    local target_ids=("$appid")
    if [ -n "$game_dir" ]; then
        local g_bin
        g_bin=$(find_game_binary "$game_dir" 2>/dev/null || true)
        local g_title
        g_title=$(basename "$game_dir")
        if [ -n "$g_bin" ]; then
            local sc_id
            sc_id=$(python3 -c "import binascii, sys; p = sys.argv[1]; t = sys.argv[2]; print((binascii.crc32((p + t).encode('utf-8')) | 0x80000000))" "$game_dir/$g_bin" "$g_title" 2>/dev/null || true)
            if [ -n "$sc_id" ] && [ "$sc_id" != "$appid" ]; then
                target_ids+=("$sc_id")
            fi
        fi
    fi

    echo "[INFO] Fetching Steam artwork for AppID: $appid"
    echo "[INFO] Destination Steam grid directory: $grid_dir"

    local tmp_dir
    tmp_dir=$(mktemp -d)
    local downloaded_count=0

    # Helper function to download and convert image to PNG
    _download_asset() {
        local asset_type="$1"
        local asset_suffix="$2"
        shift 2
        local urls=("$@")

        local tmp_file="$tmp_dir/${asset_type// /_}.raw"
        rm -f "$tmp_file"

        local url
        for url in "${urls[@]}"; do
            if curl -fsSL --connect-timeout 5 --max-time 15 "$url" -o "$tmp_file" 2>/dev/null && [ -s "$tmp_file" ]; then
                break
            fi
        done

        if [ ! -s "$tmp_file" ]; then
            echo "    • $(printf '%-18s' "$asset_type") : [WARN] Not available on CDN"
            return 1
        fi

        local tid
        for tid in "${target_ids[@]}"; do
            local dest_png="$grid_dir/${tid}${asset_suffix}.png"
            if command -v magick >/dev/null 2>&1; then
                magick "$tmp_file" "$dest_png" 2>/dev/null || cp "$tmp_file" "$dest_png"
            elif command -v convert >/dev/null 2>&1; then
                convert "$tmp_file" "$dest_png" 2>/dev/null || cp "$tmp_file" "$dest_png"
            elif command -v ffmpeg >/dev/null 2>&1; then
                ffmpeg -v error -y -i "$tmp_file" "$dest_png" 2>/dev/null || cp "$tmp_file" "$dest_png"
            else
                cp "$tmp_file" "$dest_png"
            fi
        done

        echo "    • $(printf '%-18s' "$asset_type") : [VERIFIED] Saved as <id>${asset_suffix}.png"
        downloaded_count=$((downloaded_count + 1))
        return 0
    }

    # 1. Portrait capsule (600x900) -> <shortcut_id>p.png
    _download_asset "Portrait Capsule" "p" \
        "https://cdn.akamai.steamstatic.com/steam/apps/$appid/library_600x900_2x.jpg" \
        "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/$appid/library_600x900_2x.jpg" \
        "https://cdn.cloudflare.steamstatic.com/steam/apps/$appid/library_600x900_2x.jpg" \
        "https://cdn.akamai.steamstatic.com/steam/apps/$appid/library_600x900.jpg" || true

    # 2. Horizontal banner (920x430 or 460x215) -> <shortcut_id>.png
    _download_asset "Horizontal Banner" "" \
        "https://cdn.akamai.steamstatic.com/steam/apps/$appid/header.jpg" \
        "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/$appid/header.jpg" \
        "https://cdn.cloudflare.steamstatic.com/steam/apps/$appid/header.jpg" || true

    # 3. Hero background (1920x620) -> <shortcut_id>_hero.png
    _download_asset "Hero Background" "_hero" \
        "https://cdn.akamai.steamstatic.com/steam/apps/$appid/library_hero.jpg" \
        "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/$appid/library_hero.jpg" \
        "https://cdn.cloudflare.steamstatic.com/steam/apps/$appid/library_hero.jpg" || true

    # 4. Logo transparent overlay -> <shortcut_id>_logo.png
    _download_asset "Logo Overlay" "_logo" \
        "https://cdn.akamai.steamstatic.com/steam/apps/$appid/logo.png" \
        "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/$appid/logo.png" \
        "https://cdn.cloudflare.steamstatic.com/steam/apps/$appid/logo.png" || true

    rm -rf "$tmp_dir"

    if [ "$downloaded_count" -gt 0 ]; then
        echo "[VERIFIED] Successfully fetched $downloaded_count artwork asset(s) for AppID: $appid"
        return 0
    else
        echo "[ERROR] Failed to fetch any artwork assets for AppID: $appid" >&2
        return 1
    fi
}

# Resolve active Steam user shortcuts.vdf path (~/.local/share/Steam/userdata/<account_id>/config/shortcuts.vdf)
get_steam_shortcuts_vdf() {
    if [ -n "${GAMECTL_SHORTCUTS_VDF:-}" ]; then
        echo "$GAMECTL_SHORTCUTS_VDF"
        return 0
    fi

    local s_roots=(
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.steam/root"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
        "$HOME/snap/steam/common/.local/share/Steam"
    )
    for s_root in "${s_roots[@]}"; do
        if [ -d "$s_root/userdata" ]; then
            for udir in "$s_root/userdata"/*; do
                [ -d "$udir" ] || continue
                local u_id
                u_id=$(basename "$udir")
                if [[ "$u_id" =~ ^[0-9]+$ ]] && [ "$u_id" -gt 0 ] 2>/dev/null; then
                    echo "$udir/config/shortcuts.vdf"
                    return 0
                fi
            done
        fi
    done

    # Default fallback
    echo "$HOME/.local/share/Steam/userdata/0/config/shortcuts.vdf"
}

# Check if Steam client process is actively running and warn about memory lock
check_steam_active() {
    local context="${1:-Steam operations}"
    if pgrep -x steam >/dev/null 2>&1; then
        echo "[WARN] Steam client is currently running! $context while Steam is active may cause file lock conflicts or get overwritten upon client exit." >&2
        echo "[WARN] Recommendation: Exit Steam or restart it after this operation to reload shortcuts and manifests cleanly." >&2
        return 0
    fi
    return 1
}

# Add or update a non-Steam shortcut in Steam Deck Game Mode (binary shortcuts.vdf)
add_steam_shortcut() {
    local game_dir="${1:-}"
    local title="${2:-}"

    if [ -z "$game_dir" ]; then
        echo "Usage: gamectl add-to-steam <game_dir> [title]" >&2
        return 1
    fi

    if [ ! -d "$game_dir" ]; then
        echo "[ERROR] Game directory does not exist: $game_dir" >&2
        return 1
    fi

    # Guard against concurrent Steam client memory lock on shortcuts.vdf
    check_steam_active "Registering non-Steam shortcut in shortcuts.vdf" || true

    game_dir="$(cd "$game_dir" && pwd)"

    if [ -z "$title" ]; then
        title="$(basename "$game_dir")"
    fi

    # Locate game icon
    local icon_path=""
    for candidate in "icon.png" "icon.ico" "logo.png" "app.png" "banner.png"; do
        if [ -f "$game_dir/$candidate" ]; then
            icon_path="$game_dir/$candidate"
            break
        fi
    done
    if [ -z "$icon_path" ]; then
        icon_path=$(find "$game_dir" -maxdepth 2 \( -name "*.ico" -o -name "*.png" \) 2>/dev/null | head -n 1 || true)
    fi

    # Resolve gamectl binary
    local gamectl_bin
    gamectl_bin="$(command -v gamectl 2>/dev/null || true)"
    if [ -z "$gamectl_bin" ]; then
        if [ -x "$HOME/.local/bin/gamectl" ]; then
            gamectl_bin="$HOME/.local/bin/gamectl"
        elif [ -x "/usr/local/bin/gamectl" ]; then
            gamectl_bin="/usr/local/bin/gamectl"
        elif [ -x "${REPO_ROOT:-}/bin/gamectl" ]; then
            gamectl_bin="${REPO_ROOT:-}/bin/gamectl"
        else
            gamectl_bin="gamectl"
        fi
    fi

    local shortcuts_file
    shortcuts_file="$(get_steam_shortcuts_vdf)"
    local vdf_dir
    vdf_dir="$(dirname "$shortcuts_file")"
    mkdir -p "$vdf_dir"

    # Create atomic backup if file already exists
    if [ -f "$shortcuts_file" ]; then
        cp -f "$shortcuts_file" "${shortcuts_file}.bak"
    fi

    python3 - "$shortcuts_file" "$title" "$game_dir" "$gamectl_bin" "$icon_path" << 'PYEOF'
import sys, os, struct, binascii

shortcuts_path = sys.argv[1]
title = sys.argv[2]
game_dir = os.path.abspath(sys.argv[3])
gamectl_bin = sys.argv[4]
icon_path = sys.argv[5]

exe_field = f'"{gamectl_bin}"'
startdir_field = f'"{game_dir}"'
launch_opts = f'launch "{game_dir}" --hud'

raw_crc = (binascii.crc32((exe_field + title).encode('utf-8')) | 0x80000000) & 0xffffffff
signed_appid = struct.unpack('<i', struct.pack('<I', raw_crc))[0]

def parse_binary_vdf(data):
    pos = 0
    def read_str():
        nonlocal pos
        end = data.find(b'\x00', pos)
        if end == -1: return ''
        s = data[pos:end].decode('utf-8', errors='replace')
        pos = end + 1
        return s
    def parse_map():
        nonlocal pos
        res = {}
        while pos < len(data):
            b = data[pos]
            pos += 1
            if b == 8: break
            key = read_str()
            if b == 0: res[key] = parse_map()
            elif b == 1: res[key] = read_str()
            elif b == 2:
                if pos + 4 <= len(data):
                    val = struct.unpack('<i', data[pos:pos+4])[0]
                    pos += 4
                    res[key] = val
        return res
    if data.startswith(b'\x00shortcuts\x00'):
        pos = len(b'\x00shortcuts\x00')
        root = parse_map()
        shortcuts = []
        for k in sorted(root.keys(), key=lambda x: int(x) if x.isdigit() else 9999):
            if isinstance(root[k], dict): shortcuts.append(root[k])
        return shortcuts
    return []

def serialize_shortcuts(shortcuts):
    buf = bytearray(b'\x00shortcuts\x00')
    for idx, s in enumerate(shortcuts):
        buf.append(0)
        buf.extend(str(idx).encode('utf-8') + b'\x00')
        for k, v in s.items():
            if isinstance(v, int):
                buf.append(2)
                buf.extend(k.encode('utf-8') + b'\x00')
                buf.extend(struct.pack('<i', v))
            elif isinstance(v, str):
                buf.append(1)
                buf.extend(k.encode('utf-8') + b'\x00')
                buf.extend(v.encode('utf-8') + b'\x00')
            elif isinstance(v, dict):
                buf.append(0)
                buf.extend(k.encode('utf-8') + b'\x00')
                for tk, tv in v.items():
                    buf.append(1)
                    buf.extend(str(tk).encode('utf-8') + b'\x00')
                    buf.extend(str(tv).encode('utf-8') + b'\x00')
                buf.append(8)
        buf.append(8)
    buf.append(8)
    buf.append(8)
    return bytes(buf)

shortcuts = []
if os.path.exists(shortcuts_path):
    try:
        with open(shortcuts_path, 'rb') as f:
            shortcuts = parse_binary_vdf(f.read())
    except Exception:
        shortcuts = []

existing_idx = -1
for i, sc in enumerate(shortcuts):
    if sc.get('AppName') == title or sc.get('StartDir', '').strip('"') == game_dir:
        existing_idx = i
        break

new_entry = {
    'appid': signed_appid,
    'AppName': title,
    'Exe': exe_field,
    'StartDir': startdir_field,
    'icon': icon_path,
    'ShortcutPath': '',
    'LaunchOptions': launch_opts,
    'IsHidden': 0,
    'AllowDesktopConfig': 1,
    'AllowOverlay': 1,
    'OpenVR': 0,
    'Devkit': 0,
    'DevkitGameID': '',
    'DevkitOverrideAppID': 0,
    'LastPlayTime': 0,
    'FlatpakAppID': '',
    'tags': {}
}

if existing_idx >= 0:
    shortcuts[existing_idx] = new_entry
    action = "updated"
else:
    shortcuts.append(new_entry)
    action = "registered"

out_data = serialize_shortcuts(shortcuts)
tmp_path = shortcuts_path + f'.tmp.{os.getpid()}'
with open(tmp_path, 'wb') as f:
    f.write(out_data)
os.replace(tmp_path, shortcuts_path)

print(f'[VERIFIED] Steam shortcut {action} successfully: {title}')
print(f'[INFO] Target 32-bit AppID : {raw_crc}')
print(f'[INFO] Shortcuts file      : {shortcuts_path}')
print(f'[INFO] Launch Options      : {launch_opts}')
PYEOF

    # Optionally attempt artwork synchronization if an AppID is available
    if [ -f "$game_dir/steam_appid.txt" ] || [ -f "$game_dir/steam_settings/steam_appid.txt" ]; then
        fetch_steam_artwork "$game_dir" >/dev/null 2>&1 || true
    fi

    return 0
}


# --- [MODULE] src/steam/25_identity.sh ---
# Generate a valid 17-digit SteamID64 for individual accounts (76561197960265728 + 31-bit random int)
generate_steamid64() {
    local base=76561197960265728
    local rand=""
    if [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
        local raw
        raw=$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d ' ')
        if [ -n "$raw" ] && [ "$raw" -gt 0 ] 2>/dev/null; then
            rand=$(( raw % 2000000000 + 100000 ))
        fi
    fi
    if [ -z "$rand" ]; then
        local r1=$(( (RANDOM << 16) | RANDOM ))
        rand=$(( (r1 & 0x7FFFFFFF) % 2000000000 + 100000 ))
    fi
    echo $(( base + rand ))
}

# Hierarchical SteamID64 resolver (Env -> Persona -> Steam client active user -> random SteamID64)
resolve_active_steamid() {
    # Priority 1: Environment override
    if [ -n "${GAMECTL_STEAMID:-}" ] && [[ "$GAMECTL_STEAMID" =~ ^7656119[0-9]{10}$ ]]; then
        echo "$GAMECTL_STEAMID"
        return 0
    fi

    # Priority 2: Global persona configuration
    if [ -f "$HOME/.config/gamectl/persona" ]; then
        local p_id
        p_id=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r[:space:]')
        if [ -n "$p_id" ] && [[ "$p_id" =~ ^7656119[0-9]{10}$ ]]; then
            echo "$p_id"
            return 0
        fi
    fi

    # Priority 3: Active Steam client login
    local s_roots=(
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.steam/root"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
        "$HOME/snap/steam/common/.local/share/Steam"
    )
    for s_root in "${s_roots[@]}"; do
        local vdf="$s_root/config/loginusers.vdf"
        if [ -f "$vdf" ]; then
            local sid
            sid=$(grep -E '^[[:space:]]*"7656119[0-9]{10}"' "$vdf" 2>/dev/null | head -n 1 | tr -dc '0-9')
            if [ -n "$sid" ] && [ ${#sid} -eq 17 ]; then
                echo "$sid"
                return 0
            fi
        fi

        if [ -d "$s_root/userdata" ]; then
            local udir
            for udir in "$s_root/userdata"/*; do
                [ -d "$udir" ] || continue
                local u_id
                u_id=$(basename "$udir")
                if [[ "$u_id" =~ ^[0-9]+$ ]] && [ "$u_id" -gt 0 ] 2>/dev/null; then
                    local sid64=$(( 76561197960265728 + u_id ))
                    if [[ "$sid64" =~ ^7656119[0-9]{10}$ ]]; then
                        echo "$sid64"
                        return 0
                    fi
                fi
            done
        fi
    done

    # Priority 4: Dynamic random SteamID64
    generate_steamid64
}

# Resolve game LAN persona (account_name, account_steamid, language)
get_game_persona() {
    local gdir="$1"
    local p_name=""
    local p_id=""
    local p_lang="english"

    if [ -f "$gdir/steam_settings/configs.user.ini" ]; then
        p_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$gdir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        p_id=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$gdir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
        p_lang=$(grep -E '^[[:space:]]*language[[:space:]]*=' "$gdir/steam_settings/configs.user.ini" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*language[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi

    if [ -z "$p_name" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        p_name=$(grep -E '^[[:space:]]*account_name[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_name[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi
    if [ -z "$p_id" ] && [ -f "$HOME/.config/gamectl/persona" ]; then
        p_id=$(grep -E '^[[:space:]]*account_steamid[[:space:]]*=' "$HOME/.config/gamectl/persona" 2>/dev/null | head -n 1 | sed -E 's/^[[:space:]]*account_steamid[[:space:]]*=[[:space:]]*//' | tr -d '\r')
    fi

    [ -z "$p_name" ] && p_name="${USER:-Player}"
    [ -z "$p_id" ] && p_id=$(resolve_active_steamid)
    [ -z "$p_lang" ] && p_lang="english"

    echo "$p_name|$p_id|$p_lang"
}


# Set LAN Player Name, SteamID, and broadcast IPs for GBE Fork co-op
set_id() {
    local player_name="${1:-}"
    shift || true

    if [ -z "$player_name" ]; then
        echo "Usage: gamectl set-id <player_name> [steamid] [target_dir] [--broadcast <ip>] [--global]" >&2
        return 1
    fi

    local steamid=""
    local target_dir=""
    local broadcast_ips=()
    local save_global=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --global)
                save_global=true
                shift
                ;;
            --broadcast)
                if [ -n "${2:-}" ]; then
                    broadcast_ips+=("$2")
                    shift 2
                else
                    shift
                fi
                ;;
            --broadcast=*)
                broadcast_ips+=("${1#*=}")
                shift
                ;;
            *)
                if [ -z "$steamid" ] && { [[ "$1" =~ ^7656119[0-9]{10}$ ]] || [ "$1" = "auto" ] || [ "$1" = "random" ]; }; then
                    if [ "$1" = "auto" ] || [ "$1" = "random" ]; then
                        steamid=$(generate_steamid64)
                    else
                        steamid="$1"
                    fi
                elif [ -z "$target_dir" ] && [ -d "$1" ]; then
                    target_dir="$1"
                elif [ -z "$steamid" ] && [[ "$1" =~ ^[0-9]+$ ]] && [ ${#1} -eq 17 ]; then
                    steamid="$1"
                else
                    if [ -z "$target_dir" ]; then
                        target_dir="$1"
                    fi
                fi
                shift
                ;;
        esac
    done

    # Generate steamid if still empty
    if [ -z "$steamid" ]; then
        steamid=$(generate_steamid64)
    fi

    # Determine target directory
    if [ -z "$target_dir" ]; then
        if [ -d "./steam_settings" ] || [ -f "./steam_appid.txt" ]; then
            target_dir="."
        else
            save_global=true
        fi
    fi

    # Save to global config if requested or if no game directory identified
    if [ "$save_global" = true ]; then
        mkdir -p "$HOME/.config/gamectl"
        cat <<EOF > "$HOME/.config/gamectl/persona"
# gamectl global persona
account_name=$player_name
account_steamid=$steamid
language=english
EOF
        echo "[INFO] Global persona saved to ~/.config/gamectl/persona ($player_name | $steamid)"
    fi

    if [ -n "$target_dir" ] && [ -d "$target_dir" ]; then
        target_dir="$(cd "$target_dir" && pwd)"
        mkdir -p "$target_dir/steam_settings"

        local ini_file="$target_dir/steam_settings/configs.user.ini"
        if [ -f "$ini_file" ]; then
            atomic_set_kv_file "$ini_file" "account_name" "$player_name" "=" || return 1
            atomic_set_kv_file "$ini_file" "account_steamid" "$steamid" "=" || return 1
        else
            cat <<EOF > "$ini_file"
[user::general]
account_name=$player_name
account_steamid=$steamid
language=english

[user::saves]
local_save_path=./saves
EOF
        fi

        # Handle custom_broadcasts.txt
        local bc_file="$target_dir/steam_settings/custom_broadcasts.txt"
        if [ ! -f "$bc_file" ]; then
            cat <<EOF > "$bc_file"
# GBE Fork LAN Custom Broadcast IP list
# Add peer IPs or broadcast subnets (one IP per line)
127.0.0.1
255.255.255.255
EOF
        fi

        if [ ${#broadcast_ips[@]} -gt 0 ]; then
            for ip in "${broadcast_ips[@]}"; do
                IFS=',' read -ra split_ips <<< "$ip"
                for s_ip in "${split_ips[@]}"; do
                    s_ip=$(echo "$s_ip" | tr -d ' ')
                    [ -z "$s_ip" ] && continue
                    if ! grep -q -F "$s_ip" "$bc_file" 2>/dev/null; then
                        echo "$s_ip" >> "$bc_file"
                        echo "[INFO] Added broadcast IP: $s_ip"
                    fi
                done
            done
        fi

        # Ensure symlinks to subfolders if shim exists in subdirectory
        for shim_candidate in "$target_dir"/*/*.dll "$target_dir"/*/*/*.dll "$target_dir"/*/*.so "$target_dir"/*/*/*.so; do
            if [ -f "$shim_candidate" ]; then
                local s_dir
                s_dir="$(dirname "$shim_candidate")"
                if [ "$s_dir" != "$target_dir" ] && [ -d "$s_dir" ]; then
                    ln -sfn "$target_dir/steam_settings" "$s_dir/steam_settings" 2>/dev/null || true
                fi
            fi
        done

        echo "[VERIFIED] Game LAN identity updated in $target_dir:"
        echo "           Player Name : $player_name"
        echo "           SteamID64   : $steamid"
        echo "           Config File : $ini_file"
        local is_gbe_check=false
        [ "$(resolve_game_drm_status "$target_dir")" = "GBE_FORK" ] && is_gbe_check=true
        if [ "$is_gbe_check" = false ]; then
            echo "           Note        : Game is not injected with GBE Fork yet. Press <CTRL-I> to enable."
        fi
    fi
}

# Interactive TUI configurator for LAN persona & SteamID
set_id_interactive() {
    local target_dir="${1:-}"
    local title="${2:-}"
    if [ -z "$target_dir" ] || [ ! -d "$target_dir" ]; then
        echo "[ERROR] Invalid game directory: $target_dir" >&2
        return 1
    fi
    require_tui "LAN persona" || return $?
    target_dir="$(cd "$target_dir" && pwd)"
    [ -z "$title" ] && title="$(basename "$target_dir")"

    local p_info
    p_info=$(get_game_persona "$target_dir")
    local cur_name cur_id cur_lang
    cur_name=$(echo "$p_info" | cut -d'|' -f1)
    cur_id=$(echo "$p_info" | cut -d'|' -f2)
    cur_lang=$(echo "$p_info" | cut -d'|' -f3)

    local is_gbe=false
    [ "$(resolve_game_drm_status "$target_dir")" = "GBE_FORK" ] && is_gbe=true

    echo
    echo "${UI_BOX}╭─ CONFIGURE LAN IDENTITY & STEAMID (GBE FORK) ───────────────╮${UI_RST}"
    echo "│ ${UI_CYAN}Target Game  ${UI_RST}: ${UI_BOLD}$title${UI_RST}"
    echo "│ ${UI_CYAN}Directory    ${UI_RST}: ${UI_DIM}$target_dir${UI_RST}"
    echo "│ ${UI_CYAN}Player Name  ${UI_RST}: ${UI_BOLD}${cur_name:-[Unset]}${UI_RST}"
    echo "│ ${UI_CYAN}SteamID64    ${UI_RST}: ${UI_BOLD}${cur_id:-[Unset]}${UI_RST}"
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"

    if [ "$is_gbe" = false ]; then
        echo "  ${UI_AMBER}[NOTE] This game is not injected with GBE Fork yet.${UI_RST}"
        echo "         Persona will be saved to steam_settings/configs.user.ini"
        echo "         and activates automatically once injected (<CTRL-I>)."
        echo
    fi

    local in_name rc=0
    in_name=$(tui_prompt_input "LAN Persona :: Player Name" "Enter Player Name (Current: ${cur_name:-Player} │ Enter: Next │ Esc: Cancel)" "" "Player Name > ") || rc=$?
    [ "$rc" -eq 130 ] && return 0
    [ "$rc" -ne 0 ] && return "$rc"
    [ -z "$in_name" ] && in_name="$cur_name"
    [ -z "$in_name" ] && in_name="${USER:-Player}"

    local suggested_id
    suggested_id=$(generate_steamid64)
    local in_id
    rc=0
    in_id=$(tui_prompt_input "LAN Persona :: SteamID64" "Enter SteamID64, 'gen' for random ID, or leave blank (Current: ${cur_id:-$suggested_id})" "" "SteamID64 > ") || rc=$?
    [ "$rc" -eq 130 ] && return 0
    [ "$rc" -ne 0 ] && return "$rc"
    in_id=$(echo "$in_id" | tr -d '[:space:]')
    [ -z "$in_id" ] && in_id="${cur_id:-$suggested_id}"
    if [ "$in_id" = "random" ] || [ "$in_id" = "auto" ] || [ "$in_id" = "gen" ]; then
        in_id=$(generate_steamid64)
    fi

    local in_bc
    rc=0
    in_bc=$(tui_prompt_input "LAN Custom Broadcast Peer IP (Optional)" "Enter friend's LAN IP (e.g. 192.168.1.50) or leave blank (Enter: Next │ Esc: Skip)" "" "Peer IP > ") || rc=$?
    [ "$rc" -eq 130 ] && in_bc=""
    [ "$rc" -ne 0 ] && [ "$rc" -ne 130 ] && return "$rc"
    in_bc=$(echo "$in_bc" | tr -d '[:space:]')

    local glob_entries
    glob_entries=$(cat <<EOF
no	No, apply to this game only	Keep global defaults untouched
yes	Yes, also save as global persona	Update ~/.config/gamectl/persona
EOF
)
    local glob_sel
    rc=0
    glob_sel=$(tui_action_palette "Global Persona Sync" "Also save this persona as global default for future games?" "$glob_entries" "" "Save Global > ") || rc=$?
    [ "$rc" -eq 130 ] && return 0
    [ "$rc" -ne 0 ] && return "$rc"

    local extra_args=()
    [ -n "$in_bc" ] && extra_args+=(--broadcast "$in_bc")
    if echo "$glob_sel" | grep -q '^yes'; then
        extra_args+=(--global)
    fi

    set_id "$in_name" "$in_id" "$target_dir" "${extra_args[@]}"
    log_msg "INFO" "PERSONA" "Configured LAN identity for $title: $in_name ($in_id)"
}


# --- [MODULE] src/steam/30_downloader.sh ---
# Standalone-source bootstrap: load canonical SSoT helpers when sourced outside bin/gamectl
if ! declare -F get_runtime_dir >/dev/null 2>&1 || ! declare -F audit_zip_safety >/dev/null 2>&1 || ! declare -F atomic_prepend_line >/dev/null 2>&1; then
    _dl_core_utils="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)/core/10_utils.sh"
    if [ -f "$_dl_core_utils" ]; then
        # shellcheck source=../core/10_utils.sh
        source "$_dl_core_utils"
    fi
    unset _dl_core_utils
fi

if ! declare -F get_runtime_dir >/dev/null 2>&1; then
    get_runtime_dir() {
        local run_uid="${UID:-$(id -u 2>/dev/null || echo 1000)}"
        local run_dir="${XDG_RUNTIME_DIR:-/tmp/gamectl-$UID}"
        [ -z "${UID:-}" ] && run_dir="${XDG_RUNTIME_DIR:-/tmp/gamectl-$run_uid}"
        mkdir -p -m 700 "$run_dir" 2>/dev/null || true
        echo "$run_dir"
    }
fi

# Resolve path to standalone Steam CDN depot downloader binary (gamectl-depot-dl)
resolve_depot_dl_bin() {
    if [ -n "${GAMECTL_DEPOT_DL_BIN:-}" ] && [ -x "$GAMECTL_DEPOT_DL_BIN" ]; then
        echo "$GAMECTL_DEPOT_DL_BIN"
        return 0
    fi
    local candidate
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd 2>/dev/null || echo "")"
    for candidate in \
        "$script_dir/gamectl-depot-dl" \
        "$script_dir/../../bin/gamectl-depot-dl" \
        "$script_dir/../bin/gamectl-depot-dl" \
        "$script_dir/bin/gamectl-depot-dl" \
        "$HOME/.local/bin/gamectl-depot-dl" \
        "/usr/local/bin/gamectl-depot-dl" \
        "/usr/bin/gamectl-depot-dl"; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    if command -v gamectl-depot-dl >/dev/null 2>&1; then
        command -v gamectl-depot-dl
        return 0
    fi
    return 1
}

# Ensure Steam CDN depot downloader runtime is available
ensure_downloader() {
    if resolve_depot_dl_bin >/dev/null 2>&1; then
        return 0
    fi
    echo "[WARN] Standalone depot downloader binary (gamectl-depot-dl) not found." >&2
    return 1
}

# Resolve optimal destination directory based on configured libraries and available disk space
resolve_target_library_dir() {
    local safe_title="${1:-game}"
    local candidate_dirs=()

    # 0. Primary sovereign library override
    if [ -n "${GAMECTL_LIBRARY_DIR:-}" ]; then
        candidate_dirs+=("$GAMECTL_LIBRARY_DIR")
    elif [ -f "$HOME/.config/gamectl/library_dir" ]; then
        local p_lib
        p_lib=$(head -n 1 "$HOME/.config/gamectl/library_dir" 2>/dev/null | tr -d '\r\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -n "$p_lib" ] && candidate_dirs+=("${p_lib/#\~/$HOME}")
    fi

    # 1. Custom libraries from config
    local cfg_libs="$HOME/.config/gamectl/libraries"
    if [ -f "$cfg_libs" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line#"${line%%[![:space:]]*}"}" # trim leading
            line="${line%"${line##*[![:space:]]}"}" # trim trailing
            [ -z "$line" ] && continue
            [[ "$line" =~ ^# ]] && continue
            candidate_dirs+=("${line/#\~/$HOME}")
        done < "$cfg_libs"
    fi

    # 2. Extra libraries from environment
    if [ -n "${GAMECTL_LIBRARY_DIRS:-}" ]; then
        local extra_dirs=()
        IFS=":" read -r -a extra_dirs <<< "$GAMECTL_LIBRARY_DIRS"
        candidate_dirs+=("${extra_dirs[@]}")
    fi

    # 3. Default fallback directory
    candidate_dirs+=("$HOME/Games")

    local best_dir="$HOME/Games"
    local max_free=0
    declare -A seen_candidates=()

    for d in "${candidate_dirs[@]}"; do
        [ -n "$d" ] || continue
        [[ -v seen_candidates["$d"] ]] && continue
        seen_candidates["$d"]=1

        # If dir doesn't exist yet, probe parent dir
        local probe_target="$d"
        while [ ! -d "$probe_target" ] && [ "$probe_target" != "/" ] && [ "$probe_target" != "." ]; do
            probe_target="$(dirname "$probe_target")"
        done

        if [ -d "$probe_target" ]; then
            local free_space
            free_space=$(df -PB 1M "$probe_target" 2>/dev/null | awk 'NR==2 {print $4}' || echo "0")
            if [[ "$free_space" =~ ^[0-9]+$ ]] && [ "$free_space" -gt "$max_free" ]; then
                max_free="$free_space"
                best_dir="$d"
            fi
        fi
    done

    echo "$best_dir/$safe_title"
}

# Detect primary OS platform for AppID via Steam API (returns "windows" or "linux")
detect_app_platform_os() {
    local appid="${1:-}"
    [ -z "$appid" ] && echo "linux" && return 0

    local det_json
    det_json=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=platforms" "steam_platforms_${appid}" 3600 2>/dev/null || true)
    local is_linux is_win
    is_linux=$(echo "$det_json" | jq -r ".\"${appid}\".data.platforms.linux // false" 2>/dev/null || echo "false")
    is_win=$(echo "$det_json" | jq -r ".\"${appid}\".data.platforms.windows // false" 2>/dev/null || echo "false")
    if [ "$is_linux" != "true" ] && [ "$is_win" = "true" ]; then
        echo "windows"
    else
        echo "linux"
    fi
}

# Parse depot ID to oslist mapping from manifest JSON in staging directory
parse_depot_os_map() {
    local stage_dir="$1"
    [ -d "$stage_dir" ] || return 0

    shopt -s nullglob globstar
    local json_files=("$stage_dir"/**/*.json "$stage_dir"/*.json)
    shopt -u nullglob globstar

    for jf in "${json_files[@]}"; do
        [ -f "$jf" ] || continue
        jq -r '.depot | to_entries[] | select(.value | type == "object") | select(.value.config.oslist != null) | "\(.key)=\(.value.config.oslist)"' "$jf" 2>/dev/null || true
    done
}

# Ensure Linux ELF binaries in target directory have executable permission (+x)
ensure_linux_binaries_executable() {
    local target_dir="$1"
    [ -d "$target_dir" ] || return 0

    local elf_count=0
    while IFS= read -r f_cand; do
        [ -f "$f_cand" ] || continue
        local sig
        sig=$(od -An -tx1 -N4 "$f_cand" 2>/dev/null | tr -d " \n" || true)
        if [ "$sig" = "7f454c46" ] || [[ "$sig" == 2321* ]]; then
            if [ ! -x "$f_cand" ]; then
                chmod +x "$f_cand" 2>/dev/null || true
                elf_count=$((elf_count + 1))
            fi
        fi
    done < <(find "$target_dir" -maxdepth 4 -type f ! -path '*/.*' ! -name '*.pak' ! -name '*.vpk' ! -name '*.dat' ! -name '*.assets' ! -name '*.bundle' ! -name '*.txt' ! -name '*.json' ! -name '*.png' ! -name '*.jpg' ! -name '*.ogg' ! -name '*.wav' ! -name '*.mp3' 2>/dev/null || true)

    if [ "$elf_count" -gt 0 ]; then
        echo "[INFO] Granted executable permission (chmod +x) to $elf_count Linux ELF binary(s)." >&2
    fi
    return 0
}

# Steam Native Game Downloader & Provisioner (Standalone CDN Engine)
download_game() {
    local appid="${1:-}"
    # Strip ANSI escape sequences & non-digits
    appid=$(strip_ansi "$appid" | tr -dc "0-9")
    if [ -z "$appid" ]; then
        echo "Usage: gamectl download <appid> [target_dir] [title] [--source <auto|manifesthub|ryuu|sushi|luatools>] [--os <linux|windows|macos|all>] [--allow-dlc] [--raw|--inject-only|--all|--standalone|--sls]" >&2
        return 1
    fi
    shift

    local target_dir=""
    local title=""
    local target_os=""
    local action="all"          # "all", "inject", "raw"
    local source="auto"         # "auto", "ryuu", "sushi", "luatools"
    local engine="standalone"   # Default to Pure Standalone CDN engine (Zero Steam Client)
    local is_strict_standalone=true
    local allow_dlc=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --allow-dlc)
                allow_dlc=true
                ;;
            --engine)
                shift
                case "${1:-}" in
                    depot)
                        echo "[WARN] DepotDownloader is deprecated and removed. Routing to native Steam CDN engine." >&2
                        ;;
                    steam|sls)
                        engine="sls"
                        is_strict_standalone=false
                        ;;
                    standalone|direct)
                        engine="standalone"
                        is_strict_standalone=true
                        ;;
                esac
                ;;
            --engine=*)
                local eng_val="${1#--engine=}"
                case "$eng_val" in
                    depot)
                        echo "[WARN] DepotDownloader is deprecated and removed. Routing to native Steam CDN engine." >&2
                        ;;
                    steam|sls)
                        engine="sls"
                        is_strict_standalone=false
                        ;;
                    standalone|direct)
                        engine="standalone"
                        is_strict_standalone=true
                        ;;
                esac
                ;;
            --sls|--steam)
                engine="sls"
                is_strict_standalone=false
                ;;
            --direct|--no-steam|--standalone|--headless)
                engine="standalone"
                is_strict_standalone=true
                ;;
            --source)
                shift
                source="${1:-auto}"
                ;;
            --source=*)
                source="${1#--source=}"
                ;;
            --raw|--download-only|--no-inject)
                action="raw"
                ;;
            --inject-only|--no-sync)
                action="inject"
                ;;
            --all)
                action="all"
                ;;
            --foreground|-f|foreground|--background|-b|background)
                # Preserved for CLI flag backwards-compatibility
                ;;
            --os)
                shift
                target_os="${1:-}"
                ;;
            --os=*)
                target_os="${1#--os=}"
                ;;
            *)
                if [ -z "$target_dir" ]; then
                    target_dir="$1"
                elif [ -z "$title" ]; then
                    title="$1"
                fi
                ;;
        esac
        shift
    done

    if [ -n "$target_os" ]; then
        target_os="${target_os,,}"
        case "$target_os" in
            linux|windows|macos|osx|all)
                [ "$target_os" = "osx" ] && target_os="macos"
                ;;
            *)
                echo "[ERROR] Invalid target OS '$target_os'. Valid options: linux, windows, macos, all." >&2
                return 1
                ;;
        esac
    fi

    # Auto-resolve engine preference
    if [ "$engine" = "auto" ]; then
        if [ "$action" = "inject" ]; then
            engine="sls"
        elif resolve_depot_dl_bin >/dev/null 2>&1; then
            engine="standalone"
        else
            engine="sls"
        fi
    fi

    # Verify standalone binary availability with graceful fallback
    if [ "$engine" = "standalone" ]; then
        local dl_bin
        dl_bin="$(resolve_depot_dl_bin 2>/dev/null || true)"
        if [ -z "$dl_bin" ] || [ ! -x "$dl_bin" ]; then
            if [ "$is_strict_standalone" = true ]; then
                echo "[ERROR] Standalone downloader binary (gamectl-depot-dl) not found." >&2
                echo "[ERROR] Compile it via 'make build-depot-dl' or run 'gamectl setup-gbe'." >&2
                log_msg "ERROR" "DOWNLOAD" "Standalone downloader binary not found in strict standalone mode"
                return 1
            fi
            echo "[WARN] Standalone downloader binary (gamectl-depot-dl) not found. Falling back to SLSsteam engine." >&2
            engine="sls"
        fi

        # Fail-fast offline credential preflight for explicit gated sources before metadata HTTP lookups
        if declare -F preflight_manifest_source >/dev/null 2>&1; then
            preflight_manifest_source "$appid" "$source" true || return 1
        fi
    fi

    # Engine-level DLC guard (consistent across CLI and TUI)
    if [ "$allow_dlc" != true ] && declare -F resolve_steam_app_type >/dev/null 2>&1; then
        local app_type_info="" app_type="" parent_appid="" parent_name=""
        app_type_info=$(resolve_steam_app_type "$appid" 2>/dev/null || true)
        IFS=$'\t' read -r app_type parent_appid parent_name <<< "$app_type_info"
        if [ "$app_type" = "DLC" ] && [[ "$parent_appid" =~ ^[0-9]+$ ]]; then
            local dlc_label="${title:+ ($title)}"
            local parent_label="${parent_name:+${parent_name} }($parent_appid)"
            echo "[ERROR] AppID ${appid}${dlc_label} is a DLC for Base Game ${parent_label}." >&2
            echo "[ERROR] Base game downloads already include associated DLC depots. Run: gamectl download $parent_appid" >&2
            echo "[ERROR] To download this DLC AppID explicitly anyway, re-run with --allow-dlc." >&2
            log_msg "WARN" "DOWNLOAD" "Blocked direct DLC download for AppID $appid (base game: $parent_appid)"
            return 1
        fi
    fi

    if [ -z "$title" ]; then
        title=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=basic" "steam_basic_${appid}" 3600 2>/dev/null | jq -r ".\"${appid}\".data.name // empty" 2>/dev/null || true)
        [ -z "$title" ] && title="AppID_${appid}"
    fi

    log_msg "INFO" "DOWNLOAD" "Starting download for $title (AppID: $appid, Action: $action, Source: $source)"

    # Route 1: Standalone Native Steam CDN Engine (Zero Steam Client required)
    if [ "$engine" = "standalone" ]; then
        local manifest_zip
        echo "[INFO] Manifest archive not provided. Attempting automatic harvest (source: $source)..." >&2
        manifest_zip=$(fetch_manifest "$appid" "" "$source" true) || return 1
        if [ -z "$manifest_zip" ] || [ ! -f "$manifest_zip" ]; then
            echo "[ERROR] Manifest archive for AppID $appid could not be acquired across providers." >&2
            return 1
        fi

        if ! validate_manifest_zip "$manifest_zip" "$appid" true; then
            echo "[ERROR] Manifest zip validation failed: $manifest_zip" >&2
            return 1
        fi

        local run_dir
        run_dir="$(get_runtime_dir)"
        local stage_dir="$run_dir/depot_dl_${appid}_${BASHPID:-$$}"
        mkdir -p -m 700 "$stage_dir"
        trap 'rm -rf "$stage_dir" 2>/dev/null || true' RETURN

        if ! unzip -q "$manifest_zip" -d "$stage_dir" 2>/dev/null; then
            echo "[ERROR] Failed to unpack manifest archive: $manifest_zip" >&2
            return 1
        fi

        # Integrate any physical DLC manifest archives
        harvest_dlc_manifests "$appid" "$stage_dir" "$source" 2>/dev/null || true

        declare -A depot_keys=()
        shopt -s nullglob globstar
        local cand_luas=("$stage_dir"/**/*.lua "$stage_dir"/*.lua)
        shopt -u nullglob globstar
        local re_key='addappid\([[:space:]]*([0-9]+)[[:space:]]*,[[:space:]]*[0-9]+[[:space:]]*,[[:space:]]*['\''"]([0-9a-fA-F]{64})['\''"]'
        declare -A seen_lua=()
        for clua in "${cand_luas[@]}"; do
            [ -f "$clua" ] || continue
            [[ -v seen_lua["$clua"] ]] && continue
            seen_lua["$clua"]=1
            while IFS= read -r line || [ -n "$line" ]; do
                if [[ "$line" =~ $re_key ]]; then
                    depot_keys["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
                fi
            done < "$clua"
        done

        # Parse depot OS mappings from manifest JSON
        declare -A depot_os_map=()
        while IFS='=' read -r did osval || [ -n "$did" ]; do
            [ -n "$did" ] && [ -n "$osval" ] && depot_os_map["$did"]="${osval,,}"
        done < <(parse_depot_os_map "$stage_dir")

        # Determine effective target OS if not explicitly supplied
        local effective_os="$target_os"
        if [ -z "$effective_os" ]; then
            if [ "${#depot_os_map[@]}" -eq 0 ]; then
                effective_os="all"
            else
                local has_linux=0
                local has_windows=0
                for d_os in "${depot_os_map[@]}"; do
                    [[ "$d_os" =~ linux ]] && has_linux=1
                    [[ "$d_os" =~ windows ]] && has_windows=1
                done

                local host_os
                host_os="$(uname -s)"
                if [ "$host_os" = "Linux" ]; then
                    if [ "$has_linux" -eq 1 ]; then
                        effective_os="linux"
                        echo "[INFO] Native Linux depot detected. Auto-selecting target OS: linux" >&2
                    elif [ "$has_windows" -eq 1 ]; then
                        effective_os="windows"
                        echo "[INFO] No native Linux depot found. Targeting Windows depot for Proton/Wine runner." >&2
                    else
                        effective_os="all"
                    fi
                else
                    effective_os="all"
                fi
            fi
        fi

        local depot_args=()
        shopt -s nullglob globstar
        local mf_files=("$stage_dir"/**/*.manifest "$stage_dir"/*.manifest)
        declare -A seen_mf=()
        local skipped_os_count=0
        for mf in "${mf_files[@]}"; do
            [ -f "$mf" ] || continue
            local mf_name="$(basename "$mf")"
            [[ -v seen_mf["$mf_name"] ]] && continue
            seen_mf["$mf_name"]=1

            if manifest_has_payload_magic "$mf"; then
                if [[ "$mf_name" =~ ^([0-9]+)_([0-9]+)\.manifest$ ]]; then
                    local did="${BASH_REMATCH[1]}"
                    local key="${depot_keys["$did"]:-}"

                    # OS filter check
                    if [ "$effective_os" != "all" ] && [ -n "${depot_os_map["$did"]:-}" ]; then
                        local d_os="${depot_os_map["$did"]}"
                        local match=0
                        if [ "$effective_os" = "macos" ]; then
                            [[ "$d_os" =~ (macos|osx) ]] && match=1
                        else
                            [[ "$d_os" =~ $effective_os ]] && match=1
                        fi

                        if [ "$match" -eq 0 ]; then
                            echo "[INFO] Skipping depot $did (oslist: $d_os != target: $effective_os)" >&2
                            skipped_os_count=$((skipped_os_count + 1))
                            continue
                        fi
                    fi

                    if [ -n "$key" ]; then
                        depot_args+=(--depot "$mf:$key")
                    else
                        echo "[WARN] No AES decryption key found for depot $did ($mf_name). Skipping." >&2
                    fi
                fi
            fi
        done
        shopt -u nullglob globstar

        if [ "${#depot_args[@]}" -eq 0 ]; then
            if [ "$skipped_os_count" -gt 0 ] && [ "$effective_os" != "all" ]; then
                echo "[ERROR] All candidate depots were filtered out by target OS '$effective_os' ($skipped_os_count skipped)." >&2
                echo "[ERROR] Target AppID $appid may not have depots for '$effective_os'. Try '--os windows' or '--os all'." >&2
                log_msg "ERROR" "DOWNLOAD" "Depot OS filter ($effective_os) rejected all depots for AppID $appid"
                return 1
            fi
            if [ "$is_strict_standalone" = true ]; then
                echo "[ERROR] Strict standalone mode: No encrypted manifests with valid AES keys found for AppID $appid." >&2
                echo "[ERROR] Cannot fallback to Steam Client/SLSsteam in standalone mode (ADR-022)." >&2
                log_msg "ERROR" "DOWNLOAD" "No valid AES depot keys found for AppID $appid in strict standalone mode"
                return 1
            fi
            echo "[WARN] No encrypted manifests with valid AES keys found. Falling back to SLSsteam engine." >&2
            engine="sls"
        else
            if [ -z "$target_dir" ]; then
                target_dir="$(resolve_standalone_library_dir "$title")"
            fi
            mkdir -p "$target_dir"

            echo "=========================================="
            echo " STEAM STANDALONE CDN ENGINE (gamectl-depot-dl)"
            echo "=========================================="
            echo " AppID      : $appid"
            echo " Title      : $title"
            echo " Target Dir : $target_dir"
            echo " Target OS  : $effective_os"
            echo " Depots     : $(( ${#depot_args[@]} / 2 ))"
            echo " Engine     : Native Rust Standalone (Zero Steam Client)"
            echo "=========================================="

            local cur_pid="${BASHPID:-$$}"
            cat <<EOF > "$stage_dir/status.info"
APPID=$appid
TITLE=$title
TARGET_DIR=$target_dir
TARGET_OS=$effective_os
PID=$cur_pid
START_TIME=$(date +%s)
LOG_FILE=$stage_dir/download.log
ENGINE=standalone
STATUS=DOWNLOADING
EOF

            local dl_bin dl_log="$stage_dir/download.log" dl_rc=0
            dl_bin="$(resolve_depot_dl_bin)"
            "$dl_bin" --app "$appid" --dir "$target_dir" "${depot_args[@]}" 2>&1 | tee "$dl_log" || dl_rc=${PIPESTATUS[0]}
            if [ "$dl_rc" -ne 0 ]; then
                echo "STATUS=FAILED" >> "$stage_dir/status.info"
                echo "[ERROR] Standalone CDN download failed (exit code $dl_rc)." >&2
                return 1
            fi

            # Post-download Linux ELF permission hook (Chunk 27.02)
            if [ "$effective_os" = "linux" ] || [ "$effective_os" = "all" ]; then
                ensure_linux_binaries_executable "$target_dir"
            fi

            # Preserve staged lua manifests in target_dir for offline DLC discovery
            shopt -s nullglob globstar
            for l in "$stage_dir"/**/*.lua "$stage_dir"/*.lua; do
                [ -f "$l" ] && cp -f "$l" "$target_dir/" 2>/dev/null || true
            done
            shopt -u nullglob globstar

            if [ "$action" != "raw" ]; then
                fetch_dlc "$target_dir" "$appid" 2>/dev/null || true
                if ! inject_game "$target_dir" "$appid" --no-sync; then
                    echo "STATUS=FAILED" >> "$stage_dir/status.info"
                    echo "[ERROR] Download completed, but standalone GBE provisioning failed." >&2
                    return 1
                fi
            fi

            echo "STATUS=COMPLETED" >> "$stage_dir/status.info"
            invalidate_scan_cache
            echo "[SUCCESS] Standalone download & provisioning complete for $title ($appid) in $target_dir."
            log_msg "INFO" "DOWNLOAD" "Standalone download & provisioning complete for $title ($appid) in $target_dir"
            return 0
        fi
    fi

    # Route 2: Steam Client URI Install (Legacy Content Engine)
    echo "=========================================="
    echo " STEAM NATIVE CONTENT ENGINE"
    echo "=========================================="
    echo " AppID      : $appid"
    echo " Title      : $title"
    echo " Engine     : SLSsteam (Valve High-Speed CDN)"
    echo " Source     : $source"
    echo " Mode       : $action"
    echo "=========================================="

    if deploy_sls_manifest "$appid" "" "$title" "$source"; then
        invalidate_scan_cache
        echo "[SUCCESS] SLSsteam manifests and stplug-in keys provisioned for $title ($appid)."
        log_msg "INFO" "DOWNLOAD" "SLSsteam manifests and stplug-in keys provisioned for $title ($appid)"
        if [ "$action" != "inject" ]; then
            trigger_steam_install "$appid"
        fi
        return 0
    else
        echo "[ERROR] Manifest archive and keys for AppID $appid could not be acquired across providers." >&2
        log_msg "ERROR" "DOWNLOAD" "Manifest archive and keys for AppID $appid could not be acquired across providers"
        return 1
    fi
}

# Standalone-source compatibility: load split steam submodules when sourced directly outside bin/gamectl
if [ -z "${GAMECTL_BUNDLED:-}" ] && [ -n "${BASH_SOURCE[0]:-}" ]; then
    _steam_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    for _steam_sub in 31_manifests.sh 32_steam_bridge.sh 33_download_telemetry.sh 34_download_monitor.sh; do
        if [ -f "$_steam_dir/$_steam_sub" ]; then
            # shellcheck source=/dev/null
            source "$_steam_dir/$_steam_sub"
        fi
    done
    unset _steam_dir _steam_sub
fi

# --- [MODULE] src/steam/31_manifests.sh ---
# Fetch and generate steam_settings/DLC.txt for GBE Fork
fetch_dlc() {
    local target_dir="$1"
    local appid="${2:-}"

    if [ ! -d "$target_dir" ]; then
        echo "[ERROR] Target directory not found: $target_dir" >&2
        return 1
    fi

    target_dir="$(cd "$target_dir" && pwd)"

    # Resolve AppID if not provided
    if [ -z "$appid" ]; then
        appid="$(resolve_game_appid "$target_dir")"
    fi

    if [ -z "$appid" ] || [ "$appid" = "STANDALONE" ]; then
        echo "[WARN] Numeric AppID not found. Skipping DLC.txt generation." >&2
        return 0
    fi

    echo "[INFO] Fetching DLC list for AppID $appid from Steam API..."
    local dlc_file="$target_dir/steam_settings/DLC.txt"
    mkdir -p "$target_dir/steam_settings"

    # Primary: dlcforapp endpoint (names & IDs in single call, disk-cached 3600s)
    local dlc_data=""
    dlc_data=$(fetch_cached_json "https://store.steampowered.com/api/dlcforapp/?appid=${appid}" "steam_dlc_${appid}" 3600 2>/dev/null | jq -r '.dlc[]? | "\(.id)=\(.name)"' 2>/dev/null || true)

    # Fallback: appdetails basic,dlc (disk-cached 3600s)
    if [ -z "$dlc_data" ]; then
        local dlc_ids
        dlc_ids=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=basic,dlc" "steam_basic_dlc_${appid}" 3600 2>/dev/null | jq -r ".\"${appid}\".data.dlc[]?" 2>/dev/null || true)
        if [ -n "$dlc_ids" ]; then
            dlc_data=""
            while read -r did; do
                [ -n "$did" ] && dlc_data+="${did}=DLC_${did}"$'\n'
            done <<< "$dlc_ids"
        fi
    fi

    # Fallback 2: Offline local Lua manifest harvesting
    if [ -z "$dlc_data" ]; then
        local lua_candidates=()
        [ -f "$target_dir/${appid}.lua" ] && lua_candidates+=("$target_dir/${appid}.lua")
        shopt -s nullglob globstar
        for f in "$target_dir"/**/"${appid}.lua" "$target_dir"/**/*.lua "$target_dir"/*.lua; do [ -f "$f" ] && lua_candidates+=("$f"); done
        shopt -u nullglob globstar
        local stplug_dir
        stplug_dir="$(get_steam_stplug_in_dir 2>/dev/null || echo "$HOME/.local/share/Steam/config/stplug-in")"
        [ -f "$stplug_dir/${appid}.lua" ] && lua_candidates+=("$stplug_dir/${appid}.lua")
        [ -f "$HOME/.config/SLSsteam/manifests/${appid}.lua" ] && lua_candidates+=("$HOME/.config/SLSsteam/manifests/${appid}.lua")
        local run_dir
        run_dir="$(get_runtime_dir)"
        [ -f "$run_dir/${appid}.lua" ] && lua_candidates+=("$run_dir/${appid}.lua")

        declare -A seen_dlc=()
        for cand_lua in "${lua_candidates[@]}"; do
            [ -f "$cand_lua" ] || continue
            while read -r parsed_id; do
                [ -n "$parsed_id" ] || continue
                [ "$parsed_id" = "$appid" ] && continue
                [[ -v seen_dlc["$parsed_id"] ]] && continue
                seen_dlc["$parsed_id"]=1
                dlc_data+="${parsed_id}=DLC_${parsed_id}"$'\n'
            done < <(grep -E 'addappid[[:space:]]*\([[:space:]]*[0-9]+' "$cand_lua" 2>/dev/null | sed -E 's/.*addappid[[:space:]]*\([[:space:]]*([0-9]+).*/\1/')
        done
        if [ -n "$dlc_data" ]; then
            echo "[INFO] Offline fallback: Discovered $(( ${#seen_dlc[@]} )) DLC(s) from local Lua manifests."
        fi
    fi

    if [ -n "$dlc_data" ]; then
        echo -n "$dlc_data" > "$dlc_file"
        # Ensure trailing newline
        [ -s "$dlc_file" ] && echo "" >> "$dlc_file"
        local count
        count=$(grep -c "=" "$dlc_file" || echo 0)
        echo "[VERIFIED] Successfully wrote $count DLC(s) to: $dlc_file"
    else
        touch "$dlc_file"
        echo "[INFO] No DLC found in Steam API. Created empty file: $dlc_file"
    fi
}

# Verify Valve manifest payload magic signature (0xd017f671)
manifest_has_payload_magic() {
    local m_file="$1"
    [ -f "$m_file" ] || return 1
    local sig
    sig=$(od -An -tx1 -N4 "$m_file" 2>/dev/null | tr -d " \n")
    [ "$sig" = "d017f671" ]
}

# Validate downloaded manifest ZIP archive for safety and payload contents
validate_manifest_zip() {
    local z_file="$1"
    local appid="${2:-}"
    local require_depots="${3:-false}"
    audit_zip_safety "$z_file" || return 1

    local entries
    entries=$(unzip -Z1 "$z_file" 2>/dev/null) || return 1
    [ -n "$entries" ] || return 1

    # Content check: must contain at least one .manifest or .lua file
    if ! echo "$entries" | grep -Eq '(\.manifest|\.lua)$'; then
        echo "[ERROR] Manifest zip does not contain any .manifest or .lua files." >&2
        return 1
    fi

    # Payload magic audit on contained manifests
    local run_dir
    run_dir="$(get_runtime_dir)"
    local audit_tmp="$run_dir/manifest_audit_$$"
    mkdir -p -m 700 "$audit_tmp"
    local has_valid_manifest=0

    # Extract only .manifest files to temporary audit sandbox
    unzip -q -j "$z_file" "*.manifest" -d "$audit_tmp" 2>/dev/null || true
    for mf in "$audit_tmp"/*.manifest; do
        [ -f "$mf" ] || continue
        if manifest_has_payload_magic "$mf"; then
            has_valid_manifest=1
            break
        fi
    done
    rm -rf "$audit_tmp"

    # Lua-only archives serve the explicit bridge, but cannot supply CDN file lists.
    if [ "$has_valid_manifest" -eq 0 ] && [ "$require_depots" != true ]; then
        if echo "$entries" | grep -Eq '\.lua$'; then
            has_valid_manifest=1
        fi
    fi

    [ "$has_valid_manifest" -eq 1 ]
}

# Check if file is a valid Lua manifest / stplugin payload
is_valid_lua_manifest() {
    local lua_file="$1"
    local appid="${2:-}"
    [ -f "$lua_file" ] || return 1
    local sz
    sz=$(stat -c %s "$lua_file" 2>/dev/null || wc -c < "$lua_file" 2>/dev/null || echo 0)
    [ "$sz" -gt 0 ] && [ "$sz" -le 16777216 ] || return 1

    local clean
    clean=$(sed 's/--.*$//' "$lua_file" 2>/dev/null || true)
    if [ -n "$appid" ]; then
        echo "$clean" | grep -Eq "^[[:space:]]*addappid[[:space:]]*\([[:space:]]*${appid}([[:space:]]*\)|[[:space:]]*,)" || \
        echo "$clean" | grep -Eq "^[[:space:]]*addappid[[:space:]]*\("
    else
        echo "$clean" | grep -Eq "^[[:space:]]*addappid[[:space:]]*\("
    fi
}

# Acquire or auto-refresh LuaTools bearer access token
get_valid_luatools_token() {
    local lumen_auth="${XDG_DATA_HOME:-$HOME/.local/share}/Lumen/luatools/backend/data/lua_tools_auth.json"
    local cfg_auth="$HOME/.config/gamectl/lua_tools_auth.json"
    local target_auth=""

    if [ -f "$cfg_auth" ]; then
        target_auth="$cfg_auth"
    elif [ -f "$lumen_auth" ]; then
        target_auth="$lumen_auth"
        # Seed into ~/.config/gamectl for standalone sovereign operation
        mkdir -p "$HOME/.config/gamectl"
        cp -f "$lumen_auth" "$cfg_auth" 2>/dev/null || true
        chmod 600 "$cfg_auth" 2>/dev/null || true
        target_auth="$cfg_auth"
    fi

    [ -n "$target_auth" ] && [ -f "$target_auth" ] || return 1

    local access_token refresh_token expires_at now
    access_token=$(jq -r '.access_token // empty' "$target_auth" 2>/dev/null || true)
    refresh_token=$(jq -r '.refresh_token // empty' "$target_auth" 2>/dev/null || true)
    expires_at=$(jq -r '.expires_at // 0' "$target_auth" 2>/dev/null || echo 0)
    now=$(date +%s)

    # Return valid cached token if at least 60 seconds remain before expiration
    if [ -n "$access_token" ] && [ "$((expires_at - now))" -gt 60 ]; then
        printf "%s" "$access_token"
        return 0
    fi

    # Trigger token auto-refresh via Supabase auth endpoint
    if [ -n "$refresh_token" ]; then
        local supabase_key="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3NzYwMzkzNzYsImV4cCI6MTg5MzQ1NjAwMCwicm9sZSI6ImFub24iLCJpc3MiOiJzdXBhYmFzZSJ9.f_-K38u3odjltP-g_67FVmG32Vg-_-k-lNBvIaVUVBM"
        local refresh_resp
        refresh_resp=$(curl -sSL --connect-timeout 5 --max-time 15 \
            -X POST "https://db.lua.tools/auth/v1/token?grant_type=refresh_token" \
            -H "Content-Type: application/json" \
            -H "apikey: $supabase_key" \
            -H "User-Agent: discord(dot)gg/luatools" \
            -d "{\"refresh_token\":\"$refresh_token\"}" 2>/dev/null || true)

        local new_token new_expires_in new_refresh
        new_token=$(echo "$refresh_resp" | jq -r '.access_token // empty' 2>/dev/null || true)
        new_expires_in=$(echo "$refresh_resp" | jq -r '.expires_in // 3600' 2>/dev/null || echo 3600)
        new_refresh=$(echo "$refresh_resp" | jq -r '.refresh_token // empty' 2>/dev/null || true)

        if [ -n "$new_token" ]; then
            local new_expires_at=$((now + new_expires_in))
            [ -z "$new_refresh" ] && new_refresh="$refresh_token"

            local tmp_json="${target_auth}.tmp.$$"
            jq --arg at "$new_token" \
               --arg rt "$new_refresh" \
               --argjson exp "$new_expires_at" \
               '.access_token = $at | .refresh_token = $rt | .expires_at = $exp' \
               "$target_auth" > "$tmp_json" 2>/dev/null && mv -f "$tmp_json" "$target_auth"
            chmod 600 "$target_auth" 2>/dev/null || true

            # Also synchronize back to Lumen backend auth file if present
            if [ -f "$lumen_auth" ] && [ "$target_auth" != "$lumen_auth" ]; then
                cp -f "$target_auth" "$lumen_auth" 2>/dev/null || true
                chmod 600 "$lumen_auth" 2>/dev/null || true
            fi

            printf "%s" "$new_token"
            return 0
        fi
    fi

    # Fallback to existing access_token if network refresh fails
    if [ -n "$access_token" ]; then
        printf "%s" "$access_token"
        return 0
    fi

    return 1
}

# Authenticate or import standalone LuaTools session
login_luatools() {
    local input="${1:-}"
    local cfg_auth="$HOME/.config/gamectl/lua_tools_auth.json"
    mkdir -p "$HOME/.config/gamectl"

    if [ -z "$input" ]; then
        echo "Usage: gamectl login-luatools <6-character-code | refresh_token | session.json>"
        echo "Tip: Generate a 6-character code at https://lua.tools/ or Discord bot (/login)"
        return 1
    fi

    local supabase_key="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3NzYwMzkzNzYsImV4cCI6MTg5MzQ1NjAwMCwicm9sZSI6ImFub24iLCJpc3MiOiJzdXBhYmFzZSJ9.f_-K38u3odjltP-g_67FVmG32Vg-_-k-lNBvIaVUVBM"
    local now
    now=$(date +%s)

    # Mode 1: 6-Character Redeem Code (e.g. A1B2C3)
    if [[ "$input" =~ ^[A-Za-z0-9]{6}$ ]]; then
        local code="${input^^}"
        echo "[INFO] Redeeming 6-character code '$code' at lua.tools API..."
        local redeem_resp
        redeem_resp=$(curl -sSL --connect-timeout 5 --max-time 15 \
            -X POST "https://lua.tools/api/auth/code/redeem" \
            -H "Content-Type: application/json" \
            -H "User-Agent: discord(dot)gg/luatools" \
            -d "$(jq -nc --arg code "$code" '{code:$code}')" 2>/dev/null || true)

        local token_hash
        token_hash=$(echo "$redeem_resp" | jq -r '.token // empty' 2>/dev/null || true)
        if [ -z "$token_hash" ]; then
            echo "[ERROR] Failed to redeem code: $(echo "$redeem_resp" | jq -r '.error // "Unknown error"' 2>/dev/null || echo "$redeem_resp")" >&2
            return 1
        fi

        echo "[INFO] Verifying authentication token with Supabase..."
        local verify_resp
        verify_resp=$(curl -sSL --connect-timeout 5 --max-time 15 \
            -X POST "https://db.lua.tools/auth/v1/verify" \
            -H "Content-Type: application/json" \
            -H "apikey: $supabase_key" \
            -H "User-Agent: discord(dot)gg/luatools" \
            -d "$(jq -nc --arg th "$token_hash" '{type:"magiclink",token_hash:$th}')" 2>/dev/null || true)

        local access_token refresh_token expires_in
        access_token=$(echo "$verify_resp" | jq -r '.access_token // empty' 2>/dev/null || true)
        refresh_token=$(echo "$verify_resp" | jq -r '.refresh_token // empty' 2>/dev/null || true)
        expires_in=$(echo "$verify_resp" | jq -r '.expires_in // 3600' 2>/dev/null || echo 3600)

        if [ -n "$access_token" ] && [ -n "$refresh_token" ]; then
            local expires_at=$((now + expires_in))
            echo "$verify_resp" | jq --argjson exp "$expires_at" '.expires_at = $exp' > "$cfg_auth"
            chmod 600 "$cfg_auth"
            local user_name
            user_name=$(echo "$verify_resp" | jq -r '.user.user_metadata.custom_claims.global_name // .user.user_metadata.full_name // .user.email // "User"' 2>/dev/null || echo "User")
            echo "[VERIFIED] Successfully authenticated as $user_name. Sesi disimpan di $cfg_auth"
            return 0
        else
            echo "[ERROR] Verification failed: $(echo "$verify_resp" | jq -r '.error_description // .message // "Invalid session response"')" >&2
            return 1
        fi

    # Mode 2: Existing JSON session file (e.g. from Lumen or backup)
    elif [ -f "$input" ]; then
        if jq -e '.refresh_token' "$input" >/dev/null 2>&1; then
            cp -f "$input" "$cfg_auth"
            chmod 600 "$cfg_auth"
            echo "[VERIFIED] Imported session file from $input -> $cfg_auth"
            get_valid_luatools_token >/dev/null 2>&1 || true
            return 0
        else
            echo "[ERROR] File does not contain a valid .refresh_token JSON field." >&2
            return 1
        fi

    # Mode 3: Raw refresh_token or JWT string
    else
        echo "[INFO] Attempting refresh exchange using provided raw token..."
        local refresh_resp
        refresh_resp=$(curl -sSL --connect-timeout 5 --max-time 15 \
            -X POST "https://db.lua.tools/auth/v1/token?grant_type=refresh_token" \
            -H "Content-Type: application/json" \
            -H "apikey: $supabase_key" \
            -H "User-Agent: discord(dot)gg/luatools" \
            -d "$(jq -nc --arg rt "$input" '{refresh_token:$rt}')" 2>/dev/null || true)

        local access_token new_refresh expires_in
        access_token=$(echo "$refresh_resp" | jq -r '.access_token // empty' 2>/dev/null || true)
        new_refresh=$(echo "$refresh_resp" | jq -r '.refresh_token // empty' 2>/dev/null || echo "$input")
        expires_in=$(echo "$refresh_resp" | jq -r '.expires_in // 3600' 2>/dev/null || echo 3600)

        if [ -n "$access_token" ]; then
            local expires_at=$((now + expires_in))
            echo "$refresh_resp" | jq --argjson exp "$expires_at" --arg rt "$new_refresh" '.expires_at = $exp | .refresh_token = $rt' > "$cfg_auth"
            chmod 600 "$cfg_auth"
            echo "[VERIFIED] Successfully authenticated via token. Sesi disimpan di $cfg_auth"
            return 0
        else
            echo "[ERROR] Token exchange failed: $(echo "$refresh_resp" | jq -r '.error_description // .error // "Invalid token"')" >&2
            return 1
        fi
    fi
}

# Display LuaTools authentication session status
luatools_status() {
    local cfg_auth="$HOME/.config/gamectl/lua_tools_auth.json"
    local lumen_auth="${XDG_DATA_HOME:-$HOME/.local/share}/Lumen/luatools/backend/data/lua_tools_auth.json"
    local target_auth=""

    if [ -f "$cfg_auth" ]; then target_auth="$cfg_auth"; elif [ -f "$lumen_auth" ]; then target_auth="$lumen_auth"; fi

    if [ -n "$target_auth" ] && [ -f "$target_auth" ]; then
        local user_name expires_at now remaining
        user_name=$(jq -r '.user.user_metadata.custom_claims.global_name // .user.user_metadata.full_name // .user.email // "Authenticated User"' "$target_auth" 2>/dev/null || echo "Authenticated User")
        expires_at=$(jq -r '.expires_at // 0' "$target_auth" 2>/dev/null || echo 0)
        now=$(date +%s)
        remaining=$((expires_at - now))
        echo "[STATUS] LuaTools Session: ACTIVE (${target_auth})"
        echo "  • User     : $user_name"
        if [ "$remaining" -gt 0 ]; then
            echo "  • Lifetime : Token valid ($((remaining / 60)) min remaining, auto-refreshed by gamectl)"
        else
            echo "  • Lifetime : Expired (will auto-refresh on next download)"
        fi
    else
        echo "[STATUS] LuaTools Session: NOT CONFIGURED"
        echo "  • Public providers (ManifestHub, Ryuu, Sushi) are ACTIVE (Zero login required)."
        echo "  • To unlock LuaTools provider: gamectl login-luatools <6-character-code | token>"
    fi
}

# Interactive TUI Wizard for LuaTools Authentication
login_luatools_interactive() {
    require_tui "LuaTools Authentication" || return $?

    local cfg_auth="$HOME/.config/gamectl/lua_tools_auth.json"
    mkdir -p "$HOME/.config/gamectl"

    while true; do
        local status_desc="Not Configured"
        local user_name=""
        if [ -f "$cfg_auth" ]; then
            user_name=$(jq -r '.user.user_metadata.custom_claims.global_name // .user.user_metadata.full_name // .user.email // "Authenticated"' "$cfg_auth" 2>/dev/null || echo "Authenticated")
            status_desc="ACTIVE ($user_name)"
        fi

        local lt_menu
        lt_menu=$(cat <<EOF
1	Login via Discord (/login)	Join discord.gg/luatools -> type /login in bot chat -> enter 6-char code
2	Auto-Detect & Sync from Lumen	Import active session from Lumen client directory (~/.local/share/Lumen)
3	Open Discord Server in Browser	Launch https://discord.gg/luatools in default browser
4	Advanced: Manual Token / File	Paste refresh token or import custom JSON session file
5	Clear Session / Logout	Remove active session and deactivate provider
6	Check Session Status	View identity, token lifetime & provider health
7	Return / Back	Back
EOF
)

        flush_tty_input
        local sel rc=0
        sel=$(echo "$lt_menu" | fzf \
            --delimiter=$'\t' \
            --with-nth=2,3 \
            --border-label="  ╢ LuaTools Session Auth :: $status_desc ╟  " \
            --border-label-pos=2 \
            --header="LUATOOLS DISCORD AUTH (Enter: Select │ Esc: Return)" \
            --prompt="LuaTools > " \
            --reverse 2>/dev/null) || rc=$?

        check_fzf_status "$rc" || return $?
        [ "$rc" -eq 130 ] && break
        [ -z "$sel" ] && continue

        local opt
        opt=$(echo "$sel" | cut -f1 | tr -d '[:space:]')

        case "$opt" in
            1)
                local code rc=0
                code=$(tui_prompt_input "Discord Bot Login (/login)" $'1. Di server Discord (discord.gg/luatools), ketik: /login di #bot-spam\n2. Masukkan 6-karakter kode bot di bawah (atau ketik "open" untuk buka Discord):' "" "Code > ") || rc=$?
                [ "$rc" -eq 130 ] && continue
                [ "$rc" -ne 0 ] && return "$rc"
                code=$(echo "$code" | tr -d '[:space:]')
                if [ "${code,,}" = "open" ]; then
                    xdg-open "https://discord.gg/luatools" 2>/dev/null || sensible-browser "https://discord.gg/luatools" 2>/dev/null || true
                    continue
                fi
                if [ -n "$code" ]; then
                    tui_exec_action "LuaTools Discord Code Redeem" login_luatools "$code"
                fi
                ;;
            2)
                local lumen_candidates=(
                    "${XDG_DATA_HOME:-$HOME/.local/share}/Lumen/luatools/backend/data/lua_tools_auth.json"
                    "$HOME/.config/Lumen/luatools/backend/data/lua_tools_auth.json"
                    "$HOME/.local/share/Lumen/backend/data/lua_tools_auth.json"
                    "$HOME/.config/Lumen/backend/data/lua_tools_auth.json"
                )
                local found_lumen=""
                for cand in "${lumen_candidates[@]}"; do
                    if [ -f "$cand" ]; then
                        found_lumen="$cand"
                        break
                    fi
                done
                if [ -n "$found_lumen" ]; then
                    tui_exec_action "Import Lumen Session" login_luatools "$found_lumen"
                else
                    tui_modal_notice "Lumen Auto-Sync" "No Lumen session file found on this system.\nUse Option 1 to login with Discord /login code."
                fi
                ;;
            3)
                xdg-open "https://discord.gg/luatools" 2>/dev/null || sensible-browser "https://discord.gg/luatools" 2>/dev/null || true
                tui_modal_notice "Discord Server" "Opened https://discord.gg/luatools in your default browser.\nType /login in #bot-spam or any bot channel to get your 6-character code."
                ;;
            4)
                local adv_menu
                adv_menu=$(cat <<EOF
1	Login with Refresh Token	Paste raw refresh token / JWT string
2	Import session.json File	Specify custom filesystem path to session.json
3	Back	Return
EOF
)
                flush_tty_input
                local a_sel a_rc=0
                a_sel=$(echo "$adv_menu" | fzf \
                    --delimiter=$'\t' \
                    --with-nth=2 \
                    --border-label="  ╢ Advanced Authentication ╟  " \
                    --border-label-pos=2 \
                    --header="MANUAL AUTH (Enter: Select │ Esc: Return)" \
                    --prompt="Manual > " \
                    --reverse 2>/dev/null) || a_rc=$?
                check_fzf_status "$a_rc" || return $?
                [ "$a_rc" -eq 130 ] && continue
                local a_opt
                a_opt=$(echo "$a_sel" | cut -f1 | tr -d '[:space:]')
                if [ "$a_opt" = "1" ]; then
                    local tok rc=0
                    tok=$(tui_prompt_input "LuaTools Refresh Token" "Paste refresh token string (Enter: Submit │ Esc: Cancel)" "" "Token > ") || rc=$?
                    [ "$rc" -eq 130 ] && continue
                    [ "$rc" -ne 0 ] && return "$rc"
                    tok=$(echo "$tok" | tr -d '[:space:]')
                    [ -n "$tok" ] && tui_exec_action "LuaTools Token Exchange" login_luatools "$tok"
                elif [ "$a_opt" = "2" ]; then
                    local fpath rc=0
                    fpath=$(tui_prompt_input "Import session.json File" "Enter filesystem path to session.json (Enter: Import │ Esc: Cancel)" "" "File Path > ") || rc=$?
                    [ "$rc" -eq 130 ] && continue
                    [ "$rc" -ne 0 ] && return "$rc"
                    fpath=$(echo "$fpath" | tr -d '[:space:]')
                    [ -n "$fpath" ] && tui_exec_action "Import LuaTools Session" login_luatools "$fpath"
                fi
                ;;
            5)
                if [ -f "$cfg_auth" ]; then
                    rm -f "$cfg_auth"
                    tui_modal_notice "LuaTools Session" "Session file removed from ~/.config/gamectl/lua_tools_auth.json.\nLuaTools provider is now deactivated."
                else
                    tui_modal_notice "LuaTools Session" "No active session file found in ~/.config/gamectl/lua_tools_auth.json."
                fi
                ;;
            6)
                tui_exec_action "LuaTools Session Status" luatools_status
                ;;
            7|*)
                break
                ;;
        esac
    done
}

# Fail-fast offline credential preflight for explicit gated manifest providers
# when no valid local cached/stashed manifest archive exists.
preflight_manifest_source() {
    local appid="${1:-}"
    local pref_source="${2:-auto}"
    local require_depots="${3:-false}"
    local src_lc="${pref_source,,}"

    case "$src_lc" in
        luatools|hubcap) ;;
        *) return 0 ;;
    esac

    appid=$(strip_ansi "$appid" | tr -dc "0-9")
    if [ -n "$appid" ]; then
        local cache_zip="${XDG_CACHE_HOME:-$HOME/.cache}/gamectl/manifests/${appid}.zip"
        local stash_zip="$HOME/.local/share/gamectl/manifests/${appid}.zip"
        if [ -f "$cache_zip" ] && validate_manifest_zip "$cache_zip" "$appid" "$require_depots" >/dev/null 2>&1; then
            return 0
        fi
        if [ -f "$stash_zip" ] && validate_manifest_zip "$stash_zip" "$appid" "$require_depots" >/dev/null 2>&1; then
            return 0
        fi
    fi

    if [ "$src_lc" = "luatools" ] && ! get_valid_luatools_token >/dev/null 2>&1; then
        echo "[ERROR] LuaTools session unavailable. Authenticate with 'gamectl login-luatools <code | session.json>' and retry." >&2
        return 1
    elif [ "$src_lc" = "hubcap" ] && [ -z "$(get_hubcap_api_key 2>/dev/null || true)" ]; then
        echo "[ERROR] Hubcap API key is not configured. Run 'gamectl config set hubcap_key <smm_key>' and retry." >&2
        return 1
    fi
    return 0
}

# Multi-Provider Manifest & Key Harvester
fetch_manifest() {
    local appid="$1"
    local dest_file="${2:-}"
    local pref_source="${3:-auto}"
    local require_depots="${4:-false}"

    # Strip any ANSI escape sequences
    appid=$(strip_ansi "$appid" | tr -dc "0-9")
    if [ -z "$appid" ]; then
        echo "[ERROR] fetch_manifest: Invalid numeric AppID." >&2
        return 1
    fi

    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gamectl/manifests"
    mkdir -p -m 700 "$cache_dir"
    local cached_zip="$cache_dir/${appid}.zip"

    # 1. Check valid persistent cache
    if [ -f "$cached_zip" ] && validate_manifest_zip "$cached_zip" "$appid" "$require_depots"; then
        echo "[INFO] Using cached manifest archive: $cached_zip" >&2
        if [ -n "$dest_file" ]; then
            cp -f "$cached_zip" "$dest_file"
            echo "$dest_file"
        else
            echo "$cached_zip"
        fi
        return 0
    fi

    # 2. Check local repository stash (~/.local/share/gamectl/manifests/)
    local stash_zip="$HOME/.local/share/gamectl/manifests/${appid}.zip"
    if [ -f "$stash_zip" ] && validate_manifest_zip "$stash_zip" "$appid" "$require_depots"; then
        echo "[INFO] Using local stash manifest archive: $stash_zip" >&2
        cp -f "$stash_zip" "$cached_zip"
        if [ -n "$dest_file" ]; then
            cp -f "$stash_zip" "$dest_file"
            echo "$dest_file"
        else
            echo "$stash_zip"
        fi
        return 0
    fi

    preflight_manifest_source "$appid" "$pref_source" "$require_depots" || return 1

    echo "[INFO] Harvesting manifest archive for AppID $appid across multi-provider network..." >&2

    local run_dir
    run_dir="$(get_runtime_dir)"
    local dl_tmp="$run_dir/fetch_manifest_${appid}_$$.zip"
    rm -f "$dl_tmp"

    declare -a src_names src_urls src_headers
    local src_count=0

    # Source 1: ManifestHub (Official GitHub archive per AppID branch)
    src_names[src_count]="ManifestHub"
    src_urls[src_count]="https://codeload.github.com/steamtoolsapp/ManifestHub/zip/refs/heads/${appid}"
    src_headers[src_count]=""
    src_count=$((src_count + 1))

    # Source 2: Hubcap Manifest REST API (Community Discord key-gated database)
    local hubcap_key
    hubcap_key=$(get_hubcap_api_key 2>/dev/null || true)
    if [ -n "$hubcap_key" ]; then
        src_names[src_count]="Hubcap"
        src_urls[src_count]="https://hubcapmanifest.com/api/v1/manifest/${appid}"
        src_headers[src_count]="Authorization: Bearer $hubcap_key"
        src_count=$((src_count + 1))
    fi

    # Source 3: Ryuu direct mirror
    src_names[src_count]="Ryuu"
    src_urls[src_count]="http://167.235.229.108/${appid}"
    src_headers[src_count]=""
    src_count=$((src_count + 1))

    # Source 3: Sushi GitHub repository (alt)
    src_names[src_count]="Sushi"
    src_urls[src_count]="https://raw.githubusercontent.com/sushi-dev55-alt/sushitools-games-repo-alt/refs/heads/main/${appid}.zip"
    src_headers[src_count]=""
    src_count=$((src_count + 1))

    # Source 4: Sushi GitHub repository (main)
    src_names[src_count]="SushiMain"
    src_urls[src_count]="https://raw.githubusercontent.com/sushi-dev55/sushitools-games-repo/main/${appid}.zip"
    src_headers[src_count]=""
    src_count=$((src_count + 1))

    # Source 5: Lua.tools managed API (if auth session exists)
    local token
    token=$(get_valid_luatools_token 2>/dev/null || true)
    if [ -n "$token" ]; then
        src_names[src_count]="LuaTools"
        src_urls[src_count]="https://lua.tools/api/manifest/download?appid=${appid}&source=Luie"
        src_headers[src_count]="Authorization: Bearer $token"
        src_count=$((src_count + 1))
    fi

    local found=0
    for ((i=0; i<src_count; i++)); do
        local name="${src_names[i]}"
        local url="${src_urls[i]}"
        local hdr="${src_headers[i]}"

        if [ "$pref_source" != "auto" ] && [ "${pref_source,,}" != "${name,,}" ]; then
            continue
        fi

        echo "[INFO] Querying provider: $name ($url)..." >&2
        local curl_args=("-sSL" "--connect-timeout" "5" "--max-time" "25" "-A" "discord(dot)gg/luatools" "-o" "$dl_tmp" "-w" "%{http_code}")
        if [ -n "$hdr" ]; then
            curl_args+=("-H" "$hdr")
        fi

        local http_code
        http_code=$(curl "${curl_args[@]}" "$url" 2>/dev/null || echo "000")

        if [ "$http_code" = "200" ] && [ -s "$dl_tmp" ]; then
            # Format adaptation: If payload is a raw Lua script, encapsulate into standardized ZIP
            if ! unzip -tq "$dl_tmp" >/dev/null 2>&1 && is_valid_lua_manifest "$dl_tmp" "$appid"; then
                local stage_lua="$run_dir/${appid}.lua"
                cp -f "$dl_tmp" "$stage_lua"
                local zip_tmp="$run_dir/wrap_${appid}_$$.zip"
                (cd "$run_dir" && zip -q -0 "$zip_tmp" "${appid}.lua") 2>/dev/null || true
                rm -f "$stage_lua"
                if [ -f "$zip_tmp" ]; then
                    mv -f "$zip_tmp" "$dl_tmp"
                fi
            fi

            if validate_manifest_zip "$dl_tmp" "$appid" "$require_depots"; then
                echo "[VERIFIED] Manifest archive acquired from $name." >&2
                cp -f "$dl_tmp" "$cached_zip"
                if [ -n "$dest_file" ]; then
                    cp -f "$dl_tmp" "$dest_file"
                    echo "$dest_file"
                else
                    echo "$cached_zip"
                fi
                found=1
                rm -f "$dl_tmp"
                break
            else
                echo "[WARN] Provider $name returned an invalid archive or lacks the required depot manifests." >&2
                rm -f "$dl_tmp"
            fi
        else
            echo "[INFO] Provider $name returned HTTP $http_code." >&2
            rm -f "$dl_tmp"
        fi
    done

    if [ "$found" -eq 1 ]; then
        return 0
    else
        echo "[ERROR] Manifest archive for AppID $appid not found across available providers." >&2
        if [ -z "$hubcap_key" ]; then
            echo "[NOTE] Hubcap provider was skipped (no API key configured)." >&2
            echo "[NOTE] To configure Hubcap key: run 'gamectl config set hubcap_key smm_...' or open Master Dashboard -> Global Settings." >&2
        fi
        local token
        token=$(get_valid_luatools_token 2>/dev/null || true)
        if [ -z "$token" ]; then
            echo "[NOTE] LuaTools extended catalog was skipped (no active session)." >&2
            echo "[NOTE] To authenticate with LuaTools: run 'gamectl login-luatools' or open Master Dashboard -> Global Settings -> LuaTools Session." >&2
        fi
        return 1
    fi
}

# Harvest and integrate additional DLC manifest archives for an AppID into stage directory
harvest_dlc_manifests() {
    local base_appid="$1"
    local stage_dir="$2"
    local source="${3:-auto}"
    [ -d "$stage_dir" ] || return 0

    local lua_file="$stage_dir/${base_appid}.lua"
    if [ ! -f "$lua_file" ]; then
        shopt -s nullglob globstar
        local found_luas=("$stage_dir"/**/"${base_appid}.lua" "$stage_dir"/**/*.lua "$stage_dir"/*.lua)
        shopt -u nullglob globstar
        [ ${#found_luas[@]} -gt 0 ] && lua_file="${found_luas[0]}"
    fi
    [ -f "$lua_file" ] || return 0

    # Discover candidate DLC AppIDs from addappid(<id>)
    local dlc_appids=()
    while read -r cand_id; do
        [ -n "$cand_id" ] || continue
        [ "$cand_id" = "$base_appid" ] && continue
        dlc_appids+=("$cand_id")
    done < <(grep -E '^[[:space:]]*addappid\([[:space:]]*[0-9]+[[:space:]]*\)' "$lua_file" 2>/dev/null | sed -E 's/.*addappid\([[:space:]]*([0-9]+).*/\1/')

    if [ ${#dlc_appids[@]} -eq 0 ]; then
        return 0
    fi

    echo "[INFO] Discovered ${#dlc_appids[@]} candidate DLC AppID(s) in Lua manifest: ${dlc_appids[*]}" >&2

    local harvested=0
    for dlc_id in "${dlc_appids[@]}"; do
        # Avoid re-harvesting if already staged
        shopt -s nullglob globstar
        local existing_dlc_lua=("$stage_dir"/**/"${dlc_id}.lua" "$stage_dir"/*"${dlc_id}.lua")
        shopt -u nullglob globstar
        if [ ${#existing_dlc_lua[@]} -gt 0 ]; then
            continue
        fi

        local dlc_zip
        dlc_zip=$(fetch_manifest "$dlc_id" "" "$source" 2>/dev/null || true)
        if [ -n "$dlc_zip" ] && [ -f "$dlc_zip" ] && validate_manifest_zip "$dlc_zip" "$dlc_id"; then
            if unzip -qo "$dlc_zip" -d "$stage_dir" 2>/dev/null; then
                echo "  [INFO] Successfully integrated DLC manifest archive: AppID $dlc_id" >&2
                harvested=$((harvested + 1))
            fi
        fi
    done

    if [ "$harvested" -gt 0 ]; then
        echo "[VERIFIED] Integrated $harvested additional DLC manifest archive(s) into stage directory." >&2
    fi
    return 0
}

# Normalize Steam app type values (IStoreBrowseService integer enum or appdetails string)
# into closed 7-token canonical vocabulary: GAME, DLC, DEMO, MOD, SOUNDTRACK, TOOL, APP.
normalize_steam_app_type() {
    local raw="${1:-}"
    raw="${raw,,}"
    raw="${raw//[[:space:]]/}"
    case "$raw" in
        0|game)
            printf 'GAME\n'
            ;;
        4|dlc)
            printf 'DLC\n'
            ;;
        1|demo)
            printf 'DEMO\n'
            ;;
        2|mod)
            printf 'MOD\n'
            ;;
        11|music|soundtrack|ost)
            printf 'SOUNDTRACK\n'
            ;;
        3|10|tool|application|software)
            printf 'TOOL\n'
            ;;
        *)
            printf 'APP\n'
            ;;
    esac
}

# Render standardized ANSI badge from canonical Steam app type token.
format_app_type_badge() {
    local norm_type
    norm_type="$(normalize_steam_app_type "${1:-APP}")"
    case "$norm_type" in
        GAME)       printf '%s\n' "${UI_GREEN:-}[GAME]${UI_RST:-}" ;;
        DLC)        printf '%s\n' "${UI_AMBER:-}[DLC]${UI_RST:-}" ;;
        DEMO)       printf '%s\n' "${UI_CYAN:-}[DEMO]${UI_RST:-}" ;;
        MOD)        printf '%s\n' "${UI_PURPLE:-}[MOD]${UI_RST:-}" ;;
        SOUNDTRACK) printf '%s\n' "${UI_ICE:-}[OST]${UI_RST:-}" ;;
        TOOL)       printf '%s\n' "${UI_DIM:-}[TOOL]${UI_RST:-}" ;;
        *)          printf '%s\n' "${UI_DIM:-}[APP]${UI_RST:-}" ;;
    esac
}

# Batch-classify Steam AppIDs via IStoreBrowseService/GetItems/v1 (single HTTP call).
# Emits sanitized TSV rows: <APPID><TAB><TYPE><TAB><PARENT_APPID> (offline fallback: APP).
classify_steam_app_types() {
    local -a unique_ids=()
    declare -A seen_ids=()
    local arg
    for arg in "$@"; do
        arg="${arg//[[:space:]]/}"
        [[ "$arg" =~ ^[0-9]+$ ]] || continue
        [[ -v seen_ids["$arg"] ]] && continue
        seen_ids["$arg"]=1
        unique_ids+=("$arg")
    done

    [ "${#unique_ids[@]}" -eq 0 ] && return 0

    declare -A type_map=()
    declare -A parent_map=()

    local ids_json req_json resp parsed_rows
    ids_json=$(printf '%s\n' "${unique_ids[@]}" | jq -Rc '{appid: tonumber}' | jq -sc '.') || ids_json=""
    if [ -n "$ids_json" ] && [ "$ids_json" != "[]" ]; then
        req_json=$(jq -nc --argjson ids "$ids_json" \
            '{ids:$ids, context:{language:"english",country_code:"US"}, data_request:{include_basic_info:true}}')
        resp=$(curl -s --connect-timeout 5 --max-time 10 --get \
            --data-urlencode "input_json=${req_json}" \
            "https://api.steampowered.com/IStoreBrowseService/GetItems/v1/" 2>/dev/null || true)

        if [ -n "$resp" ]; then
            parsed_rows=$(printf '%s' "$resp" | jq -r '
                .response.store_items[]? |
                [
                    (.appid // "-" | tostring),
                    ((.type // "-") | tostring | if length == 0 then "-" else . end),
                    ((.related_items.parent_appid // "-") | tostring | if length == 0 then "-" else . end)
                ] |
                if any(.[]; test("[\\t\\r\\n]")) then empty else @tsv end
            ' 2>/dev/null || true)

            local r_id r_raw_type r_parent
            while IFS=$'\t' read -r r_id r_raw_type r_parent; do
                [[ "$r_id" =~ ^[0-9]+$ ]] || continue
                [ "$r_raw_type" = "-" ] && r_raw_type=""
                [ "$r_parent" = "-" ] && r_parent=""
                type_map["$r_id"]="$(normalize_steam_app_type "$r_raw_type")"
                if [[ "$r_parent" =~ ^[0-9]+$ ]]; then
                    parent_map["$r_id"]="$r_parent"
                else
                    parent_map["$r_id"]=""
                fi
            done <<< "$parsed_rows"
        fi
    fi

    local id out_type out_parent
    for id in "${unique_ids[@]}"; do
        out_type="${type_map[$id]:-APP}"
        out_parent="${parent_map[$id]:-}"
        if declare -F validate_tui_fields >/dev/null 2>&1; then
            validate_tui_fields "$id" "$out_type" "$out_parent" 2>/dev/null || {
                out_type="APP"
                out_parent=""
            }
        elif [[ "$id$out_type$out_parent" == *[$'\t\r\n']* ]]; then
            out_type="APP"
            out_parent=""
        fi
        printf '%s\t%s\t%s\n' "$id" "$out_type" "$out_parent"
    done
    return 0
}

# Fetch and unwrap Steam appdetails data object using canonical cache key steam_details_<appid>.
fetch_steam_app_details() {
    local appid="${1:-}"
    appid="${appid//[[:space:]]/}"
    [[ "$appid" =~ ^[0-9]+$ ]] || return 1

    local raw_json details
    raw_json=$(fetch_cached_json \
        "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=basic,platforms,genres" \
        "steam_details_${appid}" 3600 2>/dev/null || true)
    [ -n "$raw_json" ] || return 1

    details=$(printf '%s' "$raw_json" | jq -ce --arg id "$appid" \
        'if type == "object" and (.[$id] | type == "object") and (.[$id].data | type == "object") then .[$id].data else empty end' \
        2>/dev/null || true)
    [ -n "$details" ] || return 1

    printf '%s\n' "$details"
    return 0
}

# Parse Steam appdetails data JSON into validated 4-column TSV:
# <HAS_TYPE><TAB><TYPE><TAB><PARENT_APPID><TAB><PARENT_NAME>
parse_steam_app_type_json() {
    local details="${1:-}"
    if [ -z "$details" ] || [ "$details" = "null" ]; then
        printf '0\tAPP\t\t\n'
        return 0
    fi

    local parsed raw_type="" parent_id="" parent_name=""
    parsed=$(printf '%s' "$details" | jq -r '
        [
            (.type // "-" | tostring | gsub("[\\t\\r\\n]"; "") | if length == 0 then "-" else . end),
            (.fullgame.appid // "-" | tostring | gsub("[^0-9]"; "") | if length == 0 then "-" else . end),
            (.fullgame.name // "" | tostring | gsub("[\\t\\r\\n]"; " "))
        ] | @tsv
    ' 2>/dev/null || true)
    if [ -z "$parsed" ]; then
        printf '0\tAPP\t\t\n'
        return 0
    fi

    IFS=$'\t' read -r raw_type parent_id parent_name <<< "$parsed"
    local has_type="1"
    if [ -z "$raw_type" ] || [ "$raw_type" = "-" ]; then
        raw_type=""
        has_type="0"
    fi
    [ "$parent_id" = "-" ] && parent_id=""

    local norm_type
    norm_type="$(normalize_steam_app_type "$raw_type")"
    if ! [[ "$parent_id" =~ ^[0-9]+$ ]]; then
        parent_id=""
        parent_name=""
    fi

    if declare -F validate_tui_fields >/dev/null 2>&1; then
        validate_tui_fields "$has_type" "$norm_type" "$parent_id" "$parent_name" 2>/dev/null || {
            has_type="0"
            norm_type="APP"
            parent_id=""
            parent_name=""
        }
    fi

    printf '%s\t%s\t%s\t%s\n' "$has_type" "$norm_type" "$parent_id" "$parent_name"
    return 0
}

# Resolve canonical type and parent base game metadata for a single AppID.
# Emits sanitized TSV: <TYPE><TAB><PARENT_APPID><TAB><PARENT_NAME>
resolve_steam_app_type() {
    local appid="${1:-}"
    appid="${appid//[[:space:]]/}"
    if ! [[ "$appid" =~ ^[0-9]+$ ]]; then
        printf 'APP\t\t\n'
        return 0
    fi

    local details
    details=$(fetch_steam_app_details "$appid" 2>/dev/null || true)
    if [ -z "$details" ]; then
        printf 'APP\t\t\n'
        return 0
    fi

    local parsed has_type="" norm_type="APP" parent_id="" parent_name=""
    parsed=$(parse_steam_app_type_json "$details")
    IFS=$'\t' read -r has_type norm_type parent_id parent_name <<< "$parsed"
    if ! [[ "$parent_id" =~ ^[0-9]+$ ]]; then
        parent_id=""
        parent_name=""
    fi
    printf '%s\t%s\t%s\n' "${norm_type:-APP}" "$parent_id" "$parent_name"
    return 0
}


# --- [MODULE] src/steam/32_steam_bridge.sh ---
# Deploy manifest archive into SLSsteam manifests, stplug-in Lua, and config.yaml
deploy_sls_manifest() {
    local appid="$1"
    local manifest_zip="${2:-}"
    local title="${3:-}"
    local source="${4:-auto}"

    # Strip ANSI escape sequences
    appid=$(strip_ansi "$appid" | tr -dc "0-9")
    title=$(strip_ansi "$title")

    if [ -z "$appid" ]; then
        echo "[ERROR] deploy_sls_manifest: Invalid numeric AppID." >&2
        return 1
    fi

    # 1. Acquire manifest archive if not provided
    if [ -z "$manifest_zip" ] || [ ! -f "$manifest_zip" ]; then
        echo "[INFO] Manifest archive not provided. Attempting automatic harvest (source: $source)..." >&2
        manifest_zip=$(fetch_manifest "$appid" "" "$source" 2>/dev/null || true)
        if [ -z "$manifest_zip" ] || [ ! -f "$manifest_zip" ]; then
            echo "[ERROR] Could not acquire manifest archive for AppID $appid." >&2
            return 1
        fi
    fi

    if ! validate_manifest_zip "$manifest_zip" "$appid"; then
        echo "[ERROR] Manifest zip validation failed: $manifest_zip" >&2
        return 1
    fi

    local run_dir
    run_dir="$(get_runtime_dir)"
    local stage_dir="$run_dir/sls_deploy_${appid}_$$"
    mkdir -p -m 700 "$stage_dir"
    trap 'rm -rf "$stage_dir" 2>/dev/null || true' RETURN

    if ! unzip -q "$manifest_zip" -d "$stage_dir" 2>/dev/null; then
        echo "[ERROR] Failed to unpack manifest archive: $manifest_zip" >&2
        return 1
    fi

    local sls_mf_dir
    sls_mf_dir="$(get_sls_manifests_dir 2>/dev/null || echo "$HOME/.config/SLSsteam/manifests")"
    local steam_depot_dir
    steam_depot_dir="$(get_steam_depotcache_dir 2>/dev/null || echo "$HOME/.local/share/Steam/depotcache")"
    local stplug_dir
    stplug_dir="$(get_steam_stplug_in_dir 2>/dev/null || echo "$HOME/.local/share/Steam/config/stplug-in")"

    mkdir -p -m 700 "$sls_mf_dir" "$steam_depot_dir" "$stplug_dir"

    local manifest_count=0
    declare -A pinned_depots=()

    # 2. Process and deploy binary manifests
    shopt -s nullglob globstar
    local mf_files=("$stage_dir"/**/*.manifest "$stage_dir"/*.manifest)
    declare -A seen_mf=()
    for mf in "${mf_files[@]}"; do
        [ -f "$mf" ] || continue
        local mf_name
        mf_name="$(basename "$mf")"
        [[ -v seen_mf["$mf_name"] ]] && continue
        seen_mf["$mf_name"]=1

        if manifest_has_payload_magic "$mf"; then
            cp -f "$mf" "$sls_mf_dir/$mf_name"
            chmod 600 "$sls_mf_dir/$mf_name"

            # Mirror to Steam internal depotcache
            cp -f "$mf" "$steam_depot_dir/$mf_name"
            chmod 600 "$steam_depot_dir/$mf_name"

            # Parse depot and GID from <depot>_<gid>.manifest
            if [[ "$mf_name" =~ ^([0-9]+)_([0-9]+)\.manifest$ ]]; then
                local depot_id="${BASH_REMATCH[1]}"
                local gid="${BASH_REMATCH[2]}"
                echo "$gid" > "$sls_mf_dir/.preferred_${depot_id}"
                chmod 600 "$sls_mf_dir/.preferred_${depot_id}"
                pinned_depots["$depot_id"]="$gid"
            fi
            manifest_count=$((manifest_count + 1))
        fi
    done
    shopt -u nullglob globstar

    # 3. Extract or synthesize stplug-in Lua script
    local target_lua="$stplug_dir/${appid}.lua"
    local staged_lua=""
    if [ -f "$stage_dir/${appid}.lua" ]; then
        staged_lua="$stage_dir/${appid}.lua"
    else
        shopt -s nullglob globstar
        local app_luas=("$stage_dir"/**/"${appid}.lua")
        if [ "${#app_luas[@]}" -gt 0 ]; then
            staged_lua="${app_luas[0]}"
        else
            local candidate_luas=("$stage_dir"/**/*.lua "$stage_dir"/*.lua)
            if [ "${#candidate_luas[@]}" -eq 1 ]; then
                staged_lua="${candidate_luas[0]}"
            fi
        fi
        shopt -u nullglob globstar
    fi

    if [ -n "$staged_lua" ] && [ -f "$staged_lua" ]; then
        cp -f "$staged_lua" "$target_lua"
        if ! grep -Eq "^[[:space:]]*addappid[[:space:]]*\([[:space:]]*${appid}[[:space:]]*\)" "$target_lua"; then
            atomic_prepend_line "$target_lua" "addappid(${appid})" || return 1
        fi
        chmod 600 "$target_lua"
        echo "[VERIFIED] Stplug-in Lua deployed from archive: $target_lua" >&2
    else
        echo "[INFO] Synthesizing stplug-in Lua script for AppID $appid..." >&2
        local synth_lua="addappid($appid)\n"
        for d_id in "${!pinned_depots[@]}"; do
            synth_lua+="addappid($d_id)\n"
        done
        printf "%b" "$synth_lua" > "$target_lua"
        chmod 600 "$target_lua"
        echo "[VERIFIED] Synthesized stplug-in Lua: $target_lua" >&2
    fi

    # 4. Synchronize entitlement in SLSsteam config.yaml (skipping ACF creation)
    sync_steam "$appid" "$title" "--no-acf"

    echo "[VERIFIED] SLSsteam deployment complete for AppID $appid ($manifest_count manifest(s) linked)." >&2
    return 0
}

# Trigger Steam client native installation for AppID via URI protocol
trigger_steam_install() {
    local appid="$1"
    local uri="steam://install/${appid}"

    if [ -n "${GAMECTL_MOCK_STEAM_TRIGGER:-}" ]; then
        echo "[VERIFIED] Triggered Steam installation for AppID $appid (Mocked URI: $uri)."
        return 0
    fi

    if command -v steam >/dev/null 2>&1; then
        if pgrep -x steam >/dev/null 2>&1; then
            echo "[INFO] Steam client is running. Dispatching install command..."
            steam "$uri" >/dev/null 2>&1 &
            echo "[VERIFIED] Dispatched '$uri' to running Steam client."
        else
            echo "[INFO] Steam client is not running. Starting Steam client in background..."
            steam -silent "$uri" >/dev/null 2>&1 &
            echo "[VERIFIED] Launched Steam silently with install intent ($uri)."
        fi
    elif command -v flatpak >/dev/null 2>&1 && flatpak info com.valvesoftware.Steam >/dev/null 2>&1; then
        if pgrep -f com.valvesoftware.Steam >/dev/null 2>&1 || pgrep -x steam >/dev/null 2>&1; then
            echo "[INFO] Steam (Flatpak) is running. Dispatching install command..."
            flatpak run com.valvesoftware.Steam "$uri" >/dev/null 2>&1 &
            echo "[VERIFIED] Dispatched '$uri' to running Steam Flatpak client."
        else
            echo "[INFO] Steam (Flatpak) is not running. Starting Flatpak Steam in background..."
            flatpak run com.valvesoftware.Steam -silent "$uri" >/dev/null 2>&1 &
            echo "[VERIFIED] Launched Steam Flatpak silently with install intent ($uri)."
        fi
    else
        echo "[WARN] Steam executable not found on system PATH." >&2
        echo "[INFO] You can start the download manually by opening: $uri" >&2
    fi
    echo "[INFO] Monitor download progress with: gamectl downloads"
    return 0
}

# Dual-Mode Steam Client & SLSsteam Full DLC Sync
sync_steam() {
    local appid="$1"
    local title="${2:-}"
    local game_dir="${3:-}"

    # Strip ANSI escape sequences
    appid=$(strip_ansi "$appid" | tr -dc '0-9')
    title=$(strip_ansi "$title")

    if [ -z "$appid" ] || [ "$appid" = "STANDALONE" ]; then
        echo "[WARN] Invalid numeric AppID. Skipping Steam synchronization." >&2
        return 0
    fi

    if [ -z "$title" ]; then
        title="AppID_${appid}"
    fi

    local safe_title
    safe_title=$(echo "$title" | tr -cd '[:alnum:] _-')
    [ -z "$safe_title" ] && safe_title="$appid"

    echo "[INFO] Synchronizing Steam Client & SLSsteam for: $title ($appid)..."

    # 1. Fetch DLC mapping via Steam API (disk-cached 3600s)
    local dlc_json
    dlc_json=$(fetch_cached_json "https://store.steampowered.com/api/dlcforapp/?appid=${appid}" "steam_dlc_${appid}" 3600 2>/dev/null || echo "{}")
    [ -z "$dlc_json" ] && dlc_json="{}"

    # 2. Update ~/.config/SLSsteam/config.yaml using ruamel.yaml
    local sls_cfg="$(get_sls_root 2>/dev/null || echo "$HOME/.config/SLSsteam")/config.yaml"
    if [ -f "$sls_cfg" ]; then
        python3 -c "
import sys, json

cfg_path = sys.argv[1]
appid = int(sys.argv[2])
dlc_raw = sys.argv[3]

has_ruamel = False
try:
    from ruamel.yaml import YAML
    yaml_engine = YAML()
    yaml_engine.preserve_quotes = True
    has_ruamel = True
except Exception:
    try:
        import yaml as pyyaml
    except Exception:
        print('[ERROR] No YAML library found in Python (ruamel.yaml or pyyaml)', file=sys.stderr)
        sys.exit(1)

try:
    with open(cfg_path, 'r') as f:
        if has_ruamel:
            data = yaml_engine.load(f) or {}
        else:
            data = pyyaml.safe_load(f) or {}

    if 'AppIds' not in data or data['AppIds'] is None:
        data['AppIds'] = []
    if appid not in data['AppIds']:
        data['AppIds'].append(appid)

    if 'AdditionalApps' not in data or data['AdditionalApps'] is None:
        data['AdditionalApps'] = []
    if appid not in data['AdditionalApps']:
        data['AdditionalApps'].append(appid)

    dlc_obj = json.loads(dlc_raw)
    dlc_list = dlc_obj.get('dlc', [])
    if dlc_list:
        if 'DlcData' not in data or data['DlcData'] is None:
            data['DlcData'] = {}
        if appid not in data['DlcData'] or data['DlcData'][appid] is None:
            data['DlcData'][appid] = {}
        for item in dlc_list:
            d_id = int(item['id'])
            d_name = item.get('name', f'DLC {d_id}')
            data['DlcData'][appid][d_id] = d_name

    with open(cfg_path, 'w') as f:
        if has_ruamel:
            yaml_engine.dump(data, f)
        else:
            pyyaml.dump(data, f, default_flow_style=False, sort_keys=False)
    engine_name = 'ruamel.yaml' if has_ruamel else 'pyyaml (fallback)'
    print(f'[VERIFIED] SLSsteam config.yaml: AppID {appid} and {len(dlc_list)} DLC(s) registered ({engine_name}).')
except Exception as e:
    print(f'[WARN] SLSsteam config sync notice: {e}', file=sys.stderr)
" "$sls_cfg" "$appid" "$dlc_json" 2>/dev/null || true
    fi

    # 2b. Guarantee stplug-in Lua script has addappid($appid) entitlement
    local stplug_dir
    stplug_dir="$(get_steam_stplug_in_dir 2>/dev/null || echo "$HOME/.local/share/Steam/config/stplug-in")"
    if [ -d "$stplug_dir" ]; then
        local target_lua="$stplug_dir/${appid}.lua"
        if [ -f "$target_lua" ]; then
            if ! grep -Eq "^[[:space:]]*addappid[[:space:]]*\([[:space:]]*${appid}[[:space:]]*\)" "$target_lua"; then
                atomic_prepend_line "$target_lua" "addappid(${appid})" || echo "[WARN] Failed to update entitlement in $target_lua" >&2
            fi
        else
            printf "addappid(%s)\n" "$appid" > "$target_lua"
            chmod 600 "$target_lua"
        fi
    fi

    # 3. Create appmanifest_<appid>.acf in Steam steamapps (unless --no-acf requested)
    if [ "${game_dir:-}" = "--no-acf" ] || [ "${4:-}" = "--no-acf" ]; then
        return 0
    fi

    local steam_apps
    steam_apps="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"
    if [ ! -d "$steam_apps" ]; then
        echo "  ${UI_AMBER}[NOTE] Steam steamapps directory not found at $steam_apps.${UI_RST}"
        echo "  ${UI_DIM}Physical ACF manifest deferred.${UI_RST}"
        log_msg "INFO" "STEAM" "Steam steamapps directory not found at $steam_apps; ACF creation deferred"
        invalidate_scan_cache
        return 2
    fi

    # Guard against concurrent Steam client memory lock on manifests
    check_steam_active "Writing appmanifest_${appid}.acf" || true

    local resolved_dir="$game_dir"
    if [ -z "$resolved_dir" ]; then
        if [ -d "$steam_apps/common/$safe_title" ] && [ -n "$(find "$steam_apps/common/$safe_title" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
            resolved_dir="$steam_apps/common/$safe_title"
        elif [ -d "$steam_apps/common/$title" ] && [ -n "$(find "$steam_apps/common/$title" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
            resolved_dir="$steam_apps/common/$title"
        fi
    fi

    # Cross-Library physical file discovery across all active game libraries
    if [ -z "$resolved_dir" ]; then
        local sc_id sc_name sc_st sc_dir sc_bin
        local clean_target="${title,,}"
        while IFS=$'\t' read -r sc_id sc_name sc_st sc_dir sc_bin; do
            sc_id="${sc_id//[[:space:]]/}"
            sc_dir="${sc_dir//$'\r'/}"
            if [ -n "$sc_id" ] && [ "$sc_id" = "$appid" ] && [ -d "$sc_dir" ] && [ -n "$(find "$sc_dir" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
                resolved_dir="$sc_dir"
                break
            fi
            local cur_clean="${sc_name,,}"
            cur_clean="${cur_clean#"${cur_clean%%[![:space:]]*}"}"
            cur_clean="${cur_clean%"${cur_clean##*[![:space:]]}"}"
            if [ -n "$cur_clean" ] && [ "$cur_clean" = "$clean_target" ] && [ -d "$sc_dir" ] && [ -n "$(find "$sc_dir" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
                resolved_dir="$sc_dir"
                break
            fi
        done < <(scan_installed_games 2>/dev/null || true)
    fi

    # Ghost ACF Defense: do not generate empty 1GB dummy ACF if files do not exist physically
    if [ -n "$resolved_dir" ] && [ -d "$resolved_dir" ]; then
        local acf_file="$steam_apps/appmanifest_${appid}.acf"
        local install_name="$(basename "$resolved_dir")"
        local size_bytes
        size_bytes=$(du -sb "$resolved_dir" 2>/dev/null | awk '{print $1}')
        [ -z "$size_bytes" ] || [ "$size_bytes" -le 0 ] && size_bytes=1000000000
        local steamid
        steamid=$(resolve_active_steamid)

        cat <<ACF > "$acf_file"
"AppState"
{
	"appid"		"$appid"
	"Universe"		"1"
	"name"		"$safe_title"
	"StateFlags"		"4"
	"installdir"		"$install_name"
	"LastUpdated"		"$(date +%s)"
	"SizeOnDisk"		"$size_bytes"
	"buildid"		"1"
	"LastOwner"		"$steamid"
	"UserConfig"
	{
		"language"		"english"
	}
	"MountedConfig"
	{
		"language"		"english"
	}
}
ACF
        mkdir -p "$steam_apps/common"
        local common_target="$steam_apps/common/$install_name"
        if [ "$resolved_dir" != "$common_target" ] && [ ! -e "$common_target" ]; then
            ln -sf "$resolved_dir" "$common_target"
            echo "[INFO] Created common symlink: $common_target -> $resolved_dir"
        fi
        echo "[VERIFIED] appmanifest_${appid}.acf registered (Status: Installed in Steam, Size: $size_bytes bytes)."
        log_msg "INFO" "STEAM" "Registered physical ACF manifest for $title ($appid) in $common_target"
        invalidate_scan_cache
        return 0
    else
        echo "  ${UI_AMBER}[NOTE] No physical game files detected across libraries for AppID $appid.${UI_RST}"
        echo "  ${UI_DIM}Entitlement registered in SLSsteam. Physical ACF manifest deferred (game files not installed).${UI_RST}"
        log_msg "INFO" "STEAM" "SLSsteam entitlement registered for $title ($appid); ACF creation deferred"
        invalidate_scan_cache
        return 2
    fi
    invalidate_scan_cache
}

# Entitle game and adopt assets in official Steam client without downloading
unlock_game() {
    local appid="${1:-}"
    local title="${2:-}"
    local game_dir="${3:-}"

    if [ -z "$appid" ]; then
        echo "Usage: gamectl entitle <appid> [title] [game_dir] (aliases: unlock, adopt-steam)" >&2
        return 1
    fi

    if [ -z "$title" ]; then
        echo "[INFO] Fetching game title for AppID $appid from Steam Store API..."
        title=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${appid}&filters=basic" "steam_basic_${appid}" 3600 2>/dev/null | jq -r ".\"${appid}\".data.name // empty" 2>/dev/null || true)
        [ -z "$title" ] && title="AppID_${appid}"
    fi

    echo "${UI_BOX}╭─ STEAM ENTITLEMENT & ACF ADOPTION ENGINE ───────────────────╮${UI_RST}"
    echo "│ ${UI_CYAN}Target Game${UI_RST}: ${UI_BOLD}$title${UI_RST} ${UI_DIM}(AppID: $appid)${UI_RST}"
    echo "│ ${UI_DIM}Adopts local files across libraries, Steam Input & Vulkan shaders${UI_RST}"
    echo "${UI_BOX}╰─────────────────────────────────────────────────────────────╯${UI_RST}"

    local sync_rc=0
    sync_steam "$appid" "$title" "$game_dir" || sync_rc=$?
    invalidate_scan_cache

    if [ "$sync_rc" -eq 0 ]; then
        echo "  ${UI_GREEN}[SUCCESS] Game '$title' ($appid) entitled in Steam Client with Full DLC & ACF manifest.${UI_RST}"
        return 0
    elif [ "$sync_rc" -eq 2 ]; then
        echo "  ${UI_AMBER}[DEFERRED] Entitlement registered in SLSsteam. Physical ACF manifest deferred (game files not installed).${UI_RST}"
        return 0
    else
        echo "  ${UI_RED}[WARN] Steam synchronization encountered a notice (Exit: $sync_rc).${UI_RST}"
        return "$sync_rc"
    fi
}

# Preview pane generator for Steam ACF Adoption candidate (physical directory auto-detection)
preview_adopt_candidate() {
    local appid="$1"
    local title="$2"
    [ -z "$appid" ] && return 0

    local found_dir=""
    local found_source=""
    local has_acf=""

    # 1. Check scancache if available
    local cache_file
    cache_file="$(get_runtime_dir)/scancache.tab"
    if [ -f "$cache_file" ]; then
        local sc_id sc_name sc_st sc_dir sc_bin
        while IFS=$'\t' read -r sc_id sc_name sc_st sc_dir sc_bin; do
            sc_id="${sc_id//[[:space:]]/}"
            if [ "$sc_id" = "$appid" ] && [ -d "$sc_dir" ]; then
                found_dir="$sc_dir"
                found_source="Library Cache ($sc_st)"
                break
            fi
        done < "$cache_file"
    fi

    # 2. Check ~/Games directly
    if [ -z "$found_dir" ] && [ -d "$HOME/Games" ]; then
        for cand in "$HOME/Games"/*; do
            [ -d "$cand" ] || continue
            local c_aid
            c_aid="$(resolve_game_appid "$cand")"
            if [ -n "$c_aid" ] && [ "$c_aid" = "$appid" ]; then
                found_dir="$cand"
                found_source="Physical ~/Games (AppID match)"
                break
            fi
            local c_base="${cand##*/}"
            if [ "${c_base,,}" = "${title,,}" ]; then
                found_dir="$cand"
                found_source="Physical ~/Games (Title match)"
                break
            fi
        done
    fi

    # 3. Check Steam Libraries
    if [ -z "$found_dir" ]; then
        while read -r steam_lib; do
            [ -d "$steam_lib" ] || continue
            if [ -d "$steam_lib/common/$title" ]; then
                found_dir="$steam_lib/common/$title"
                found_source="Steam Primary Library"
                break
            fi
        done < <(get_steam_libraries 2>/dev/null || true)
    fi

    # Check ACF status
    local acf_file
    acf_file=$(find_app_acf "$appid" 2>/dev/null || true)
    if [ -n "$acf_file" ] && [ -f "$acf_file" ]; then
        has_acf="${UI_GREEN}[EXISTS] $(basename "$acf_file")${UI_RST}"
    else
        has_acf="${UI_AMBER}[MISSING] Not yet registered${UI_RST}"
    fi

    echo "${UI_BOX}╭─ TARGET STORE GAME & PHYSICAL DISCOVERY AUDIT ──────╮${UI_RST}"
    echo "  ${UI_CYAN}Store AppID ${UI_RST}: ${UI_BOLD}$appid${UI_RST}"
    echo "  ${UI_CYAN}Store Title ${UI_RST}: ${UI_BOLD}$title${UI_RST}"
    echo "  ${UI_CYAN}ACF Manifest${UI_RST}: $has_acf"
    echo
    if [ -n "$found_dir" ]; then
        local dir_size="N/A"
        dir_size=$(du -sh "$found_dir" 2>/dev/null | awk '{print $1}' || echo "N/A")
        echo "  ${UI_CYAN}Physical Dir${UI_RST}: ${UI_GREEN}${UI_BOLD}[FOUND]${UI_RST} $found_dir"
        echo "  ${UI_CYAN}Detection   ${UI_RST}: ${UI_DIM}$found_source • $dir_size on disk${UI_RST}"
        echo "  ${UI_CYAN}Adoption Act${UI_RST}: ${UI_GREEN}Instant Linking Ready (StateFlags=4)${UI_RST}"
    else
        echo "  ${UI_CYAN}Physical Dir${UI_RST}: ${UI_AMBER}[NOT FOUND]${UI_RST} No existing local installation"
        echo "  ${UI_CYAN}Adoption Act${UI_RST}: ${UI_PURPLE}Triggers Auto-Download Bridge${UI_RST} ${UI_DIM}(Standalone CDN / Steam)${UI_RST}"
    fi
    echo "${UI_BOX}╰─────────────────────────────────────────────────────╯${UI_RST}"
}

# Aliases for entitlement engine
entitle_game() { unlock_game "$@"; }
adopt_steam() { unlock_game "$@"; }

# Interactive Steam ACF Adoption & Asset Manager Wizard (Dual Input: Title or AppID)
unlock_interactive() {
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "[ERROR] Interactive ACF adoption requires a terminal (TTY)." >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for interactive mode but was not found in PATH." >&2
        return 127
    fi

    local u_input fzf_rc=0
    # Input primitive canonicalized via tui_prompt_input (: | fzf wrapper)
    u_input=$(tui_prompt_input "Steam ACF Adoption & Asset Manager" "Enter game title or numeric AppID (Enter: Adopt │ Esc: Cancel)" "" "Game Title or ID > ") || fzf_rc=$?
    [ "$fzf_rc" -eq 130 ] && return 0
    [ "$fzf_rc" -ne 0 ] && return "$fzf_rc"
    u_input=$(echo "$u_input" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ -z "$u_input" ] && return 0

    local u_appid=""
    local u_title=""

    if [[ "$u_input" =~ ^[0-9]+$ ]]; then
        u_appid="$u_input"
        log_msg "INFO" "ADOPT" "Fetching title from Steam Store API for AppID $u_appid..."
        u_title=$(fetch_cached_json "https://store.steampowered.com/api/appdetails?appids=${u_appid}&filters=basic" "steam_basic_${u_appid}" 3600 2>/dev/null | jq -r ".\"${u_appid}\".data.name // empty" 2>/dev/null || true)
        [ -z "$u_title" ] && u_title="AppID_${u_appid}"
    else
        log_msg "INFO" "ADOPT" "Searching Steam Store API for title: '$u_input'..."
        local encoded_query
        encoded_query=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$u_input" 2>/dev/null || echo "$u_input")
        local raw_results
        raw_results=$(curl -s --connect-timeout 5 --max-time 15 "https://store.steampowered.com/api/storesearch/?term=${encoded_query}&l=english&cc=US" 2>/dev/null)
        local search_items
        search_items=$(printf '%s' "$raw_results" | store_search_items) || {
            echo "[ERROR] Invalid Steam search catalog." >&2
            return 1
        }

        if [ -z "$search_items" ]; then
            log_msg "WARN" "ADOPT" "Game title '$u_input' not found on Steam Store API"
            tui_modal_notice "Game Not Found" "Game title '$u_input' was not found on Steam Store.\nPlease verify title or provide numeric AppID." || return $?
            return 1
        fi

        local -a adopt_ids=()
        local aid aname
        while IFS=$'\t' read -r aid aname; do
            aid="${aid//[[:space:]]/}"
            [[ "$aid" =~ ^[0-9]+$ ]] && adopt_ids+=("$aid")
        done <<< "$search_items"

        declare -A adopt_type_map=() adopt_parent_map=()
        if [ "${#adopt_ids[@]}" -gt 0 ] && declare -F classify_steam_app_types >/dev/null 2>&1; then
            local c_out c_id c_type c_parent
            c_out=$(classify_steam_app_types "${adopt_ids[@]}" 2>/dev/null || true)
            while IFS=$'\t' read -r c_id c_type c_parent; do
                [ -n "$c_id" ] || continue
                adopt_type_map["$c_id"]="${c_type:-APP}"
                adopt_parent_map["$c_id"]="${c_parent:-}"
            done <<< "$c_out"
        fi

        local adopt_items=""
        while IFS=$'\t' read -r aid aname; do
            [ -n "$aid" ] || continue
            local raw_type="${adopt_type_map[$aid]:-APP}"
            local parent_id="${adopt_parent_map[$aid]:-}"
            local type_badge="[$raw_type]"
            if declare -F format_app_type_badge >/dev/null 2>&1; then
                type_badge="$(format_app_type_badge "$raw_type")"
            fi
            validate_tui_fields "$aid" "$aname" "$raw_type" "$parent_id" || continue
            adopt_items+="${aid}"$'\t'"${type_badge}"$'\t'"${aname}"$'\t'"${raw_type}"$'\t'"${parent_id}"$'\n'
        done <<< "$search_items"

        local sel_item fzf_sel_rc=0
        export GAMECTL_PREVIEW_BIN="$SELF_BIN"
        sel_item=$(printf '%s' "$adopt_items" | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2,3 \
            --border-label="  ╢ Steam Store Search :: Pick Target Game ╟  " \
            --border-label-pos=2 \
            --header="SELECT GAME FOR ACF ADOPTION (Enter: Select │ Esc: Cancel)" \
            --prompt="Adopt Game > " \
            --preview='"$GAMECTL_PREVIEW_BIN" --preview-adopt {1} {3}' \
            --preview-window=down:45%:border-rounded \
            --reverse 2>/dev/null) || fzf_sel_rc=$?

        if [ "$fzf_sel_rc" -eq 130 ]; then
            return 0
        fi
        if [ "$fzf_sel_rc" -ne 0 ] && [ "$fzf_sel_rc" -ne 1 ]; then
            echo "[ERROR] Game adoption picker failed (fzf exit code $fzf_sel_rc)." >&2
            return "$fzf_sel_rc"
        fi
        [ -z "$sel_item" ] && return 0

        local _a1="" _a2="" _a3=""
        IFS=$'\t' read -r _a1 _a2 _a3 _ <<< "$sel_item"
        if [ -n "$_a3" ]; then
            u_appid="$_a1"
            u_title="$_a3"
        else
            u_appid="$_a1"
            u_title="$_a2"
        fi
    fi

    [ -z "$u_appid" ] && return 0

    # Check for physical game files across all active libraries
    local existing_dir=""
    local sc_id sc_name sc_st sc_dir sc_bin
    local clean_target="${u_title,,}"
    while IFS=$'\t' read -r sc_id sc_name sc_st sc_dir sc_bin; do
        sc_id="${sc_id//[[:space:]]/}"
        sc_dir="${sc_dir//$'\r'/}"
        if [ -n "$sc_id" ] && [ "$sc_id" = "$u_appid" ] && [ -d "$sc_dir" ] && [ -n "$(find "$sc_dir" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
            existing_dir="$sc_dir"
            break
        fi
        local cur_clean="${sc_name,,}"
        cur_clean="${cur_clean#"${cur_clean%%[![:space:]]*}"}"
        cur_clean="${cur_clean%"${cur_clean##*[![:space:]]}"}"
        if [ -n "$cur_clean" ] && [ "$cur_clean" = "$clean_target" ] && [ -d "$sc_dir" ] && [ -n "$(find "$sc_dir" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]; then
            existing_dir="$sc_dir"
            break
        fi
    done < <(scan_installed_games 2>/dev/null || true)

    if [ -n "$existing_dir" ]; then
        log_msg "INFO" "ADOPT" "Discovered physical install across libraries: $existing_dir"
        local adopt_out
        adopt_out=$(unlock_game "$u_appid" "$u_title" "$existing_dir")
        local clean_notice
        clean_notice=$(echo "$adopt_out" | grep -E '\[SUCCESS\]|\[DEFERRED\]|\[WARN\]' | sed 's/\x1b\[[0-9;]*m//g' | sed 's/^[[:space:]]*//')
        [ -z "$clean_notice" ] && clean_notice="Physical ACF adoption complete for $u_title ($u_appid)."
        tui_modal_notice "Steam ACF Adoption" "$clean_notice\n\nGame Location: $existing_dir" "30%" || return $?
        return 0
    fi

    # Auto-Download Bridge: files are not installed in any active library
    local bridge_options
    bridge_options=$(cat <<EOF
1	[Download Standalone] Unduh via Standalone CDN (gamectl-depot-dl) & Auto-provision ACF + GBE
2	[Steam Native Install] Daftarkan SLSsteam entitlement & picu Steam Client (steam://install/$u_appid)
3	[Cancel] Batalkan dan kembali ke Dashboard
EOF
)
    local bridge_sel="" b_rc=0
    bridge_sel=$(echo "$bridge_options" | fzf \
        --delimiter=$'\t' \
        --with-nth=2 \
        --border-label="  ╢ Physical Game Files Absent: $u_title ($u_appid) ╟  " \
        --border-label-pos=2 \
        --header="PHYSICAL FILES NOT FOUND (Enter: Select │ Esc: Return)" \
        --prompt="Action > " \
        --reverse 2>/dev/null) || b_rc=$?

    check_fzf_status "$b_rc" || return $?
    [ "$b_rc" -eq 130 ] && return 0
    local b_opt
    b_opt=$(echo "$bridge_sel" | awk -F'\t' '{print $1}')

    case "$b_opt" in
        1)
            local dest_dir target_os
            dest_dir="$(resolve_target_library_dir "$u_title")"
            target_os="$(detect_app_platform_os "$u_appid")"
            log_msg "INFO" "ADOPT" "Bridging uninstalled AppID $u_appid to standalone depot download"
            download_game "$u_appid" "$dest_dir" "$u_title" --all --os "$target_os"
            ;;
        2)
            sync_steam "$u_appid" "$u_title" "--no-acf"
            if command -v steam >/dev/null 2>&1; then
                steam "steam://install/$u_appid" >/dev/null 2>&1 &
                log_msg "INFO" "ADOPT" "Triggered steam://install/$u_appid native install intent"
                tui_modal_notice "Steam Client Intent" "Entitlement registered in SLSsteam.\nPushed steam://install/$u_appid to Steam Client." "25%" || return $?
            else
                tui_modal_notice "Steam Entitlement Registered" "Entitlement registered in SLSsteam.\nSteam Client executable not found in PATH." "25%" || return $?
            fi
            ;;
        *)
            return 0
            ;;
    esac
}

entitle_interactive() { unlock_interactive "$@"; }


# --- [MODULE] src/steam/33_download_telemetry.sh ---
# ==============================================================================
# Steam Download Telemetry, ACF State & Depot Progress (Split from 30_downloader.sh)
# ==============================================================================

# Locate appmanifest_<appid>.acf across primary and secondary libraries
find_app_acf() {
    local appid="$1"
    [ -z "$appid" ] && return 1

    local primary_apps
    primary_apps="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"
    if [ -f "$primary_apps/appmanifest_${appid}.acf" ]; then
        echo "$primary_apps/appmanifest_${appid}.acf"
        return 0
    fi

    local lib
    while IFS= read -r lib; do
        [ -d "$lib" ] || continue
        if [ -f "$lib/appmanifest_${appid}.acf" ]; then
            echo "$lib/appmanifest_${appid}.acf"
            return 0
        fi
        if [ -f "$lib/steamapps/appmanifest_${appid}.acf" ]; then
            echo "$lib/steamapps/appmanifest_${appid}.acf"
            return 0
        fi
    done < <(get_steam_libraries 2>/dev/null || true)

    return 1
}

# Format byte integer into readable B, KB, MB, GB representation
format_bytes() {
    local b="${1:-0}"
    if [ "$b" -ge 1073741824 ] 2>/dev/null; then
        local gb=$(( b / 1073741824 ))
        local rem=$(( (b % 1073741824) / 104857600 ))
        echo "${gb}.${rem} GB"
    elif [ "$b" -ge 1048576 ] 2>/dev/null; then
        local mb=$(( b / 1048576 ))
        echo "${mb} MB"
    elif [ "$b" -ge 1024 ] 2>/dev/null; then
        local kb=$(( b / 1024 ))
        echo "${kb} KB"
    else
        echo "${b} B"
    fi
}

# Parse Steam appmanifest ACF file for download progress, state, and byte metrics
parse_acf_download_state() {
    local target="$1"
    local acf_file=""
    local appid=""

    if [ -f "$target" ]; then
        acf_file="$target"
    else
        appid=$(strip_ansi "$target" | tr -dc "0-9")
        [ -z "$appid" ] && return 1
        acf_file=$(find_app_acf "$appid" 2>/dev/null || true)
    fi

    if [ -z "$acf_file" ] || [ ! -f "$acf_file" ]; then
        return 1
    fi

    local name="" state_flags="0" bytes_dl="0" bytes_total="0" installdir=""
    local re_appid='^[[:space:]]*"appid"[[:space:]]+"([0-9]+)"'
    local re_name='^[[:space:]]*"name"[[:space:]]+"([^"]+)"'
    local re_flags='^[[:space:]]*"StateFlags"[[:space:]]+"([0-9]+)"'
    local re_bytes_dl='^[[:space:]]*"BytesDownloaded"[[:space:]]+"([0-9]+)"'
    local re_bytes_total='^[[:space:]]*"BytesToDownload"[[:space:]]+"([0-9]+)"'
    local re_installdir='^[[:space:]]*"installdir"[[:space:]]+"([^"]+)"'

    while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" =~ $re_appid ]] && [ -z "$appid" ]; then
            appid="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ $re_name ]] && [ -z "$name" ]; then
            name="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ $re_flags ]]; then
            state_flags="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ $re_bytes_dl ]]; then
            bytes_dl="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ $re_bytes_total ]]; then
            bytes_total="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ $re_installdir ]] && [ -z "$installdir" ]; then
            installdir="${BASH_REMATCH[1]}"
        fi
    done < "$acf_file"

    [ -z "$appid" ] && return 1

    local status_str="[UNKNOWN]"
    if [ "$state_flags" -eq 4 ]; then
        status_str="[INSTALLED]"
    elif [ "$state_flags" -eq 512 ] || [ "$state_flags" -eq 514 ] || (( (state_flags & 512) != 0 )); then
        status_str="[PAUSED]"
    elif [ "$state_flags" -eq 1024 ] || [ "$state_flags" -eq 1026 ] || (( (state_flags & 1024) != 0 )); then
        status_str="[DOWNLOADING]"
    elif [ "$state_flags" -eq 2 ] || (( (state_flags & 2) != 0 )); then
        status_str="[UPDATE REQUIRED]"
    fi

    local pct="0%"
    if [ "$bytes_total" -gt 0 ] 2>/dev/null; then
        local calc_pct=$(( (bytes_dl * 100) / bytes_total ))
        [ "$calc_pct" -gt 100 ] && calc_pct=100
        pct="${calc_pct}%"
    elif [ "$state_flags" -eq 4 ]; then
        pct="100%"
    fi

    if [[ "$name$installdir$acf_file" == *[$'\t\r\n']* ]]; then
        echo "[ERROR] ACF fields cannot contain TAB, CR or newline." >&2
        return 1
    fi
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
        "$appid" "$name" "$status_str" "$pct" "$bytes_dl" "$bytes_total" "$state_flags" "$installdir" "$acf_file"
}

# List active and recent downloads
list_downloads() {
    echo "=========================================="
    echo " GAMECTL DOWNLOAD STATUS (Unified Engine)"
    echo "=========================================="
    local count=0

    # Inspect Steam Native ACF downloads
    local steam_apps
    steam_apps="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"
    shopt -s nullglob
    local acf_files=("$steam_apps"/appmanifest_*.acf)
    shopt -u nullglob

    for acf in "${acf_files[@]}"; do
        local state_data
        state_data=$(parse_acf_download_state "$acf" 2>/dev/null || true)
        [ -z "$state_data" ] && continue

        local a_id a_title a_status a_pct a_dl a_total a_flags a_dir a_path
        IFS=$'\t' read -r a_id a_title a_status a_pct a_dl a_total a_flags a_dir a_path <<< "$state_data"

        # Only display active downloads or paused/updating apps in download status
        if [ "$a_status" = "[DOWNLOADING]" ] || [ "$a_status" = "[PAUSED]" ] || [ "$a_status" = "[UPDATE REQUIRED]" ]; then
            count=$((count + 1))
            local dl_fmt tot_fmt
            dl_fmt=$(format_bytes "$a_dl")
            tot_fmt=$(format_bytes "$a_total")
            echo "$a_status AppID: $a_id | $a_title | Progress: $a_pct ($dl_fmt / $tot_fmt) [Steam Engine]"
            echo "------------------------------------------"
        fi
    done

    # Inspect Standalone CDN downloads
    local run_dir
    run_dir="$(get_runtime_dir)"
    shopt -s nullglob
    for st_dir in "$run_dir"/depot_dl_*; do
        [ -d "$st_dir" ] || continue
        local base_st="${st_dir##*/}"
        local st_pid="${base_st##*_}"
        local rest_st="${base_st#depot_dl_}"
        local st_appid="${rest_st%_*}"
        [ -z "$st_appid" ] || [ -z "$st_pid" ] && continue

        # Self-healing: purge orphaned staging dir if downloader process is dead
        if ! [[ "$st_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$st_pid" 2>/dev/null; then
            rm -rf "$st_dir" 2>/dev/null || true
            continue
        fi

        local st_info="$st_dir/status.info"
        local st_title="Native CDN Download"
        local st_log="$st_dir/download.log"
        if [ -f "$st_info" ]; then
            local info_title info_log
            info_title=$(grep -E '^TITLE=' "$st_info" | cut -d= -f2- || true)
            info_log=$(grep -E '^LOG_FILE=' "$st_info" | cut -d= -f2- || true)
            [ -n "$info_title" ] && st_title="$info_title"
            [ -n "$info_log" ] && [ -f "$info_log" ] && st_log="$info_log"
        fi

        local prog_data st_pct st_bytes st_state
        prog_data=$(get_depot_dl_progress "$st_log" "$st_pid")
        IFS=$'\t' read -r st_pct st_bytes st_state <<< "$prog_data"

        count=$((count + 1))
        local dl_label="Engine: Standalone CDN"
        if [ -n "$st_bytes" ] && [ "$st_bytes" != "0 MB / 0 MB" ]; then
            echo "$st_state AppID: $st_appid | $st_title | Progress: $st_pct ($st_bytes) | $dl_label"
        else
            echo "$st_state AppID: $st_appid | $st_title | Progress: $st_pct | $dl_label"
        fi
        echo "------------------------------------------"
    done
    shopt -u nullglob

    if [ $count -eq 0 ]; then
        echo "[INFO] No active download tasks in Steam or Standalone engine."
    fi
}

# Helper: Parse structured download telemetry from depot-dl logs
get_depot_dl_progress() {
    local log_file="$1"
    local pid="${2:-}"

    if [ ! -f "$log_file" ]; then
        printf "0%%\t0 MB / 0 MB\t[STARTING]\n"
        return 0
    fi

    local parsed
    parsed=$(awk '
    /^\[DEPOT_START\]/ {
        for (i=1; i<=NF; i++) {
            if ($i ~ /^\([0-9.]+$/) {
                tot += substr($i, 2);
            }
        }
    }
    /^\[PROGRESS\] Transferred:/ {
        dl = $3;
    }
    /^\[SUCCESS\]/ {
        done = 1;
    }
    /^\[ERROR\]/ {
        err = 1;
    }
    END {
        if (done) {
            printf "100%%\t%.2f MB / %.2f MB\t[COMPLETED]\n", dl ? dl : tot, tot ? tot : dl;
        } else if (err && !dl) {
            printf "0%%\t0 MB / 0 MB\t[FAILED]\n";
        } else if (tot > 0 && dl > 0) {
            pct = int((dl / tot) * 100);
            if (pct > 100) pct = 100;
            printf "%d%%\t%.2f MB / %.2f MB\t[DOWNLOADING]\n", pct, dl, tot;
        } else if (tot > 0) {
            printf "0%%\t0 MB / %.2f MB\t[STARTING]\n", tot;
        } else if (dl > 0) {
            printf "0%%\t%.2f MB transferred\t[DOWNLOADING]\n", dl;
        } else {
            printf "0%%\t0 MB / 0 MB\t[STARTING]\n";
        }
    }' "$log_file")

    local pct bytes_info state_label
    IFS=$'\t' read -r pct bytes_info state_label <<< "$parsed"

    # Check process state for SIGSTOP pause
    if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
        local proc_state
        proc_state=$(awk '/^State:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true)
        if [[ "$proc_state" =~ ^[Tt] ]]; then
            state_label="[PAUSED]"
        fi
    fi

    printf "%s\t%s\t%s\n" "$pct" "$bytes_info" "$state_label"
}

# --- [MODULE] src/steam/34_download_monitor.sh ---
# ==============================================================================
# Interactive Download Monitor TUI & Preview (Split from 30_downloader.sh)
# ==============================================================================

# Dedicated Download Telemetry & ACF Preview Handler
preview_download() {
    local appid="${1:-}"
    local engine="${2:-}"
    local ref_path="${3:-}"

    appid=$(strip_ansi "$appid" | tr -d '[:space:]')
    engine=$(strip_ansi "$engine" | tr -d '[:space:]')
    ref_path=$(strip_ansi "$ref_path" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    if [ -z "$appid" ] || [ "$appid" = "0" ] || [ -z "$ref_path" ]; then
        printf "%s╭─ DOWNLOAD TELEMETRY MONITOR ────────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        printf "│ %sNo Active Download Selected%s\n" "${UI_DIM}" "${UI_RST}"
        printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
        printf "  %sNo active download telemetry or reference available in queue.%s\n" "${UI_DIM}" "${UI_RST}"
        return 0
    fi

    if [ -d "$ref_path" ]; then
        # Standalone Staging Directory
        local title="Unknown Title" target_dir="Not configured" pid="Unknown" start_time="" log_file="$ref_path/download.log" status="DOWNLOADING"
        if [ -f "$ref_path/status.info" ]; then
            local k v
            while IFS='=' read -r k v || [ -n "$k" ]; do
                case "$k" in
                    TITLE) title="$v" ;;
                    TARGET_DIR) target_dir="$v" ;;
                    PID) pid="$v" ;;
                    START_TIME) start_time="$v" ;;
                    LOG_FILE) [ -n "$v" ] && log_file="$v" ;;
                    STATUS) status="$v" ;;
                esac
            done < "$ref_path/status.info"
        fi

        local pid_status="${UI_RED}[TERMINATED]${UI_RST}"
        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
            local p_stat
            p_stat=$(awk '/^State:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true)
            if [[ "$p_stat" =~ ^[Tt] ]]; then
                pid_status="${UI_PURPLE}[PAUSED (SIGSTOP)]${UI_RST}"
            else
                pid_status="${UI_GREEN}[RUNNING (PID $pid)]${UI_RST}"
            fi
        fi

        local elapsed_str="N/A"
        if [ -n "$start_time" ] && [[ "$start_time" =~ ^[0-9]+$ ]]; then
            local now_ts elapsed
            now_ts=$(date +%s)
            elapsed=$(( now_ts - start_time ))
            if [ "$elapsed" -ge 0 ]; then
                local mins=$(( elapsed / 60 ))
                local secs=$(( elapsed % 60 ))
                elapsed_str="${mins}m ${secs}s"
            fi
        fi

        local prog_data st_pct st_bytes st_state
        prog_data=$(get_depot_dl_progress "$log_file" "$pid")
        IFS=$'\t' read -r st_pct st_bytes st_state <<< "$prog_data"

        printf "%s╭─ STANDALONE CDN DOWNLOAD TELEMETRY ────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        printf "│ %s%s%s %s(AppID: %s)%s\n" "${UI_BOLD}" "$title" "${UI_RST}" "${UI_DIM}" "$appid" "${UI_RST}"
        printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
        printf "  %sEngine%s        : %s\n" "${UI_CYAN}" "${UI_RST}" "Native Rust gamectl-depot-dl (Valve CDN)"
        printf "  %sProcess State%s : %s\n" "${UI_CYAN}" "${UI_RST}" "$pid_status"
        printf "  %sProgress%s      : %s%s%s (%s)\n" "${UI_CYAN}" "${UI_RST}" "${UI_BOLD}" "$st_pct" "${UI_RST}" "$st_bytes"
        printf "  %sElapsed Time%s  : %s\n" "${UI_CYAN}" "${UI_RST}" "$elapsed_str"
        printf "  %sTarget Dir%s    : %s\n" "${UI_CYAN}" "${UI_RST}" "$target_dir"
        printf "  %sStaging Dir%s   : %s\n" "${UI_CYAN}" "${UI_RST}" "$ref_path"
        printf "\n"
        printf "%s╭─ RECENT DOWNLOAD LOG (tail -n 12) ──────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        if [ -f "$log_file" ]; then
            tail -n 12 "$log_file"
        else
            printf "%s(No log file generated yet)%s\n" "${UI_DIM}" "${UI_RST}"
        fi
        return 0
    fi

    if [ -f "$ref_path" ]; then
        # Steam ACF Manifest
        local state_data
        state_data=$(parse_acf_download_state "$ref_path" 2>/dev/null || true)
        if [ -n "$state_data" ]; then
            local a_id a_name a_status a_pct a_dl a_tot a_flags a_dir a_path
            IFS=$'\t' read -r a_id a_name a_status a_pct a_dl a_tot a_flags a_dir a_path <<< "$state_data"
            local dl_fmt tot_fmt
            dl_fmt=$(format_bytes "$a_dl")
            tot_fmt=$(format_bytes "$a_tot")
            local install_path="$(dirname "$ref_path")/common/$a_dir"

            printf "%s╭─ STEAM CLIENT DOWNLOAD TELEMETRY ───────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
            printf "│ %s%s%s %s(AppID: %s)%s\n" "${UI_BOLD}" "$a_name" "${UI_RST}" "${UI_DIM}" "$a_id" "${UI_RST}"
            printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
            printf "  %sEngine%s        : %s\n" "${UI_CYAN}" "${UI_RST}" "Steam Client (ACF Manifest Engine)"
            printf "  %sStatus%s        : %s\n" "${UI_CYAN}" "${UI_RST}" "$a_status"
            printf "  %sProgress%s      : %s%s%s (%s / %s)\n" "${UI_CYAN}" "${UI_RST}" "${UI_BOLD}" "$a_pct" "${UI_RST}" "$dl_fmt" "$tot_fmt"
            printf "  %sStateFlags%s    : %s\n" "${UI_CYAN}" "${UI_RST}" "$a_flags"
            printf "  %sInstall Dir%s   : %s\n" "${UI_CYAN}" "${UI_RST}" "$install_path"
            printf "  %sManifest File%s : %s\n" "${UI_CYAN}" "${UI_RST}" "$ref_path"
            printf "\n"
            printf "%s╭─ MANIFEST CONFIGURATION (VDF) ──────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
            grep -E '"(appid|name|StateFlags|BytesDownloaded|BytesToDownload|installdir|buildid|LastOwner)"' "$ref_path" 2>/dev/null || true
            return 0
        fi
    fi

    printf "%s╭─ DOWNLOAD TELEMETRY MONITOR ────────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
    printf "│ %sReference: %s%s\n" "${UI_DIM}" "$ref_path" "${UI_RST}"
    printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
    printf "  No active download telemetry or reference available for this target.\n"
}

# Interactive Download Monitor TUI
list_downloads_interactive() {
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "[ERROR] Interactive download monitor requires a terminal (TTY)." >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for interactive mode but was not found in PATH." >&2
        return 127
    fi

    local run_dir
    run_dir="$(get_runtime_dir)"
    while true; do
        local entries=""
        local total_items=0

        # Scan Steam ACF entries
        local steam_apps
        steam_apps="$(get_steam_primary_apps 2>/dev/null || echo "$HOME/.local/share/Steam/steamapps")"
        shopt -s nullglob
        local acf_files=("$steam_apps"/appmanifest_*.acf)
        shopt -u nullglob

        for acf in "${acf_files[@]}"; do
            local state_data
            state_data=$(parse_acf_download_state "$acf" 2>/dev/null || true)
            [ -z "$state_data" ] && continue

            local a_id a_title a_status a_pct a_dl a_total a_flags a_dir a_path
            IFS=$'\t' read -r a_id a_title a_status a_pct a_dl a_total a_flags a_dir a_path <<< "$state_data"

            if [ "$a_status" = "[DOWNLOADING]" ] || [ "$a_status" = "[PAUSED]" ] || [ "$a_status" = "[UPDATE REQUIRED]" ] || [ "$a_status" = "[INSTALLED]" ]; then
                local ui_status="${UI_ICE}${a_status}${UI_RST}"
                [ "$a_status" = "[DOWNLOADING]" ] && ui_status="${UI_GREEN}[DOWNLOADING ${a_pct}]${UI_RST}"
                [ "$a_status" = "[PAUSED]" ] && ui_status="${UI_PURPLE}[PAUSED ${a_pct}]${UI_RST}"
                [ "$a_status" = "[INSTALLED]" ] && ui_status="${UI_CYAN}[INSTALLED]${UI_RST}"

                local dl_fmt tot_fmt
                dl_fmt=$(format_bytes "$a_dl")
                tot_fmt=$(format_bytes "$a_total")
                local detail="${a_title} (${dl_fmt}/${tot_fmt})"
                validate_tui_fields "$a_id" "$detail" "$a_path" || continue
                entries+="${a_id}"$'\t'"Steam"$'\t'"${ui_status}"$'\t'"${a_pct}"$'\t'"${detail}"$'\t'"${a_path}"$'\n'
                total_items=$((total_items + 1))
            fi
        done

        shopt -s nullglob
        for st_dir in "$run_dir"/depot_dl_*; do
            [ -d "$st_dir" ] || continue
            local base_st="${st_dir##*/}"
            local st_pid="${base_st##*_}"
            local rest_st="${base_st#depot_dl_}"
            local st_appid="${rest_st%_*}"
            [ -z "$st_appid" ] || [ -z "$st_pid" ] && continue

            # Self-healing: purge orphaned staging dir if downloader process is dead
            if ! [[ "$st_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$st_pid" 2>/dev/null; then
                rm -rf "$st_dir" 2>/dev/null || true
                continue
            fi

            local st_info="$st_dir/status.info"
            local st_title="Native CDN Download"
            local st_log="$st_dir/download.log"
            if [ -f "$st_info" ]; then
                local info_title info_log
                info_title=$(grep -E '^TITLE=' "$st_info" | cut -d= -f2- || true)
                info_log=$(grep -E '^LOG_FILE=' "$st_info" | cut -d= -f2- || true)
                [ -n "$info_title" ] && st_title="$info_title"
                [ -n "$info_log" ] && [ -f "$info_log" ] && st_log="$info_log"
            fi

            local prog_data st_pct st_bytes st_state
            prog_data=$(get_depot_dl_progress "$st_log" "$st_pid")
            IFS=$'\t' read -r st_pct st_bytes st_state <<< "$prog_data"

            local st_ui="${UI_GREEN}[DOWNLOADING ${st_pct}]${UI_RST}"
            if [ "$st_state" = "[PAUSED]" ]; then
                st_ui="${UI_PURPLE}[PAUSED ${st_pct}]${UI_RST}"
            elif [ "$st_state" = "[COMPLETED]" ]; then
                st_ui="${UI_CYAN}[COMPLETED]${UI_RST}"
            elif [ "$st_state" = "[FAILED]" ]; then
                st_ui="${UI_RED}[FAILED]${UI_RST}"
            elif [ "$st_state" = "[STARTING]" ]; then
                st_ui="${UI_ICE}[STARTING]${UI_RST}"
            fi

            local st_detail="${st_title} (${st_bytes}, PID: ${st_pid})"
            validate_tui_fields "$st_appid" "$st_detail" "$st_dir" || continue
            entries+="${st_appid}"$'\t'"Standalone"$'\t'"${st_ui}"$'\t'"${st_pct}"$'\t'"${st_detail}"$'\t'"${st_dir}"$'\n'
            total_items=$((total_items + 1))
        done
        shopt -u nullglob

        if [ "$total_items" -eq 0 ]; then
            entries+="0"$'\t'"Info"$'\t'"${UI_DIM}[NO ACTIVE DOWNLOADS]${UI_RST}"$'\t'"0%"$'\t'"No active downloads found in Steam or Standalone engine. Press Esc to return."$'\t\n'
        fi

        flush_tty_input
        local fzf_out fzf_rc=0
        export GAMECTL_PREVIEW_BIN="$SELF_BIN"
        fzf_out=$(printf "%s" "$entries" | fzf \
            --delimiter=$'\t' \
            --with-nth=1,2,3,5 \
            --expect=ctrl-k \
            --border-label="  ╢ gamectl :: Download Manager ╟  " \
            --border-label-pos=2 \
            --header="Enter: Actions │ Ctrl-K: Pause │ Esc: Back" \
            --prompt="Downloads > " \
            --preview='"$GAMECTL_PREVIEW_BIN" --preview-download {1} {2} {6}' \
            --preview-window=right:60%:border-rounded:wrap \
        ) || fzf_rc=$?

        [ "$fzf_rc" -eq 130 ] && break
        if [ "$fzf_rc" -ne 0 ] && [ "$fzf_rc" -ne 1 ]; then
            echo "[ERROR] Download monitor failed (fzf exit code $fzf_rc)." >&2
            return "$fzf_rc"
        fi
        [ -z "$fzf_out" ] && continue

        local trigger_key selection
        trigger_key=$(echo "$fzf_out" | head -n 1)
        selection=$(echo "$fzf_out" | sed -n '2p')

        [ -z "$selection" ] && continue

        local sel_appid sel_engine sel_status sel_pct sel_title sel_ref
        sel_appid=$(echo "$selection" | awk -F'\t' '{print $1}')
        sel_engine=$(echo "$selection" | awk -F'\t' '{print $2}')
        sel_status=$(echo "$selection" | awk -F'\t' '{print $3}')
        sel_pct=$(echo "$selection" | awk -F'\t' '{print $4}')
        sel_title=$(echo "$selection" | awk -F'\t' '{print $5}')
        sel_ref=$(echo "$selection" | awk -F'\t' '{print $6}')

        [ "$sel_appid" = "0" ] && break

        if [ "$trigger_key" = "ctrl-k" ]; then
            if [ "$sel_engine" = "Standalone" ]; then
                local t_pid="${sel_ref##*_}"
                if [[ "$t_pid" =~ ^[0-9]+$ ]] && kill -0 "$t_pid" 2>/dev/null; then
                    kill -STOP "$t_pid" 2>/dev/null || true
                    log_msg "INFO" "DOWNLOAD" "Paused standalone download PID $t_pid (AppID: $sel_appid) via SIGSTOP"
                    tui_modal_notice "Standalone Download Paused" "Dispatched SIGSTOP to process PID: $t_pid (AppID: $sel_appid).\nUse Action Menu to resume or terminate." || return $?
                else
                    tui_modal_notice "Pause Standalone" "Downloader process (PID: $t_pid) is no longer active." || return $?
                fi
            elif command -v steam >/dev/null 2>&1; then
                steam "steam://pause/$sel_appid" >/dev/null 2>&1 &
                log_msg "INFO" "DOWNLOAD" "Paused download for AppID $sel_appid"
                tui_modal_notice "Download Paused" "Dispatched pause signal to Steam Client for AppID: $sel_appid" || return $?
            else
                tui_modal_notice "Pause Unsupported" "Steam client CLI is not available in PATH." || return $?
            fi
            continue
        fi

        local action_entries
        if [ "$sel_engine" = "Standalone" ]; then
            local t_pid="${sel_ref##*_}"
            action_entries=$(cat <<EOF
1	Pause Standalone Download (SIGSTOP)	Suspend process PID $t_pid
2	Resume Standalone Download (SIGCONT)	Continue process PID $t_pid
3	Terminate Standalone Download (SIGTERM)	Kill process PID $t_pid
4	Inject Standalone GBE Fork LAN Runtime	Deploy Goldberg emulator
5	Return to Download List	Back
EOF
)
        else
            action_entries=$(cat <<EOF
1	Pause Steam Client Download	steam://pause/$sel_appid
2	Resume Steam Client Download	steam://resume/$sel_appid
3	Inject Standalone GBE Fork LAN Runtime	Deploy Goldberg emulator
4	Return to Download List	Back
EOF
)
        fi
        flush_tty_input
        local act_sel act_rc=0
        act_sel=$(echo "$action_entries" | fzf \
            --delimiter=$'\t' \
            --with-nth=2,3 \
            --border-label="  ╢ Actions: AppID $sel_appid ($sel_engine) ╟  " \
            --border-label-pos=2 \
            --header="DOWNLOAD ACTIONS (Enter: Execute │ Esc: Return)" \
            --prompt="Action > " \
            --reverse 2>/dev/null) || act_rc=$?

        check_fzf_status "$act_rc" || return $?
        [ "$act_rc" -eq 130 ] && continue
        [ -z "$act_sel" ] && continue

        local dl_opt
        dl_opt=$(echo "$act_sel" | cut -f1 | tr -d '[:space:]')

        case "$dl_opt" in
            1)
                if [ "$sel_engine" = "Standalone" ]; then
                    local t_pid="${sel_ref##*_}"
                    if [[ "$t_pid" =~ ^[0-9]+$ ]] && kill -0 "$t_pid" 2>/dev/null; then
                        kill -STOP "$t_pid" 2>/dev/null || true
                        log_msg "INFO" "DOWNLOAD" "Paused standalone download PID $t_pid (AppID: $sel_appid) via SIGSTOP"
                        tui_modal_notice "Download Paused" "Sent SIGSTOP to standalone downloader PID $t_pid." || return $?
                    fi
                elif command -v steam >/dev/null 2>&1; then
                    steam "steam://pause/$sel_appid" >/dev/null 2>&1 &
                    log_msg "INFO" "DOWNLOAD" "Paused download for AppID $sel_appid"
                fi
                ;;
            2)
                if [ "$sel_engine" = "Standalone" ]; then
                    local t_pid="${sel_ref##*_}"
                    if [[ "$t_pid" =~ ^[0-9]+$ ]] && kill -0 "$t_pid" 2>/dev/null; then
                        kill -CONT "$t_pid" 2>/dev/null || true
                        log_msg "INFO" "DOWNLOAD" "Resumed standalone download PID $t_pid (AppID: $sel_appid) via SIGCONT"
                        tui_modal_notice "Download Resumed" "Sent SIGCONT to standalone downloader PID $t_pid." || return $?
                    fi
                elif command -v steam >/dev/null 2>&1; then
                    steam "steam://resume/$sel_appid" >/dev/null 2>&1 &
                    log_msg "INFO" "DOWNLOAD" "Resumed download for AppID $sel_appid"
                fi
                ;;
            3)
                if [ "$sel_engine" = "Standalone" ]; then
                    local t_pid="${sel_ref##*_}"
                    if [[ "$t_pid" =~ ^[0-9]+$ ]] && kill -0 "$t_pid" 2>/dev/null; then
                        kill -TERM "$t_pid" 2>/dev/null || true
                        rm -rf "$sel_ref" 2>/dev/null || true
                        log_msg "WARN" "DOWNLOAD" "Terminated standalone download PID $t_pid (AppID: $sel_appid) via SIGTERM"
                        tui_modal_notice "Download Terminated" "Sent SIGTERM to standalone downloader PID $t_pid and purged staging." || return $?
                    fi
                else
                    local g_dir=""
                    if [ -f "$sel_ref" ]; then
                        local i_dir
                        i_dir=$(grep -m1 '"installdir"' "$sel_ref" 2>/dev/null | awk -F'"' '{print $4}')
                        if [ -n "$i_dir" ]; then
                            g_dir="$(dirname "$sel_ref")/common/$i_dir"
                        fi
                    fi
                    if [ -n "$g_dir" ] && [ -d "$g_dir" ]; then
                        log_msg "INFO" "DOWNLOAD" "Injecting GBE Fork LAN runtime into: $g_dir"
                        "$SELF_BIN" inject "$g_dir" "$sel_appid"
                        tui_modal_notice "GBE Runtime Injected" "Goldberg emulator LAN runtime successfully injected into:\n$g_dir" || return $?
                    else
                        tui_modal_notice "Target Not Found" "Steam common game directory not found:\n$g_dir" || return $?
                    fi
                fi
                ;;
            4)
                if [ "$sel_engine" = "Standalone" ]; then
                    local g_dir=""
                    if [ -f "$sel_ref/status.info" ]; then
                        g_dir=$(grep -E '^TARGET_DIR=' "$sel_ref/status.info" | cut -d= -f2-)
                    fi
                    if [ -z "$g_dir" ] || [ ! -d "$g_dir" ]; then
                        local st_title=""
                        [ -f "$sel_ref/status.info" ] && st_title=$(grep -E '^TITLE=' "$sel_ref/status.info" | cut -d= -f2-)
                        if [ -n "$st_title" ]; then
                            g_dir="$(resolve_standalone_library_dir "$st_title")"
                        fi
                    fi
                    if [ -n "$g_dir" ] && [ -d "$g_dir" ]; then
                        log_msg "INFO" "DOWNLOAD" "Injecting GBE Fork LAN runtime into target dir: $g_dir"
                        "$SELF_BIN" inject "$g_dir" "$sel_appid"
                        tui_modal_notice "GBE Runtime Injected" "Goldberg emulator LAN runtime successfully injected into:\n$g_dir" || return $?
                    else
                        tui_modal_notice "Target Not Found" "Target installation directory not found or not yet created:\n$g_dir" || return $?
                    fi
                else
                    continue
                fi
                ;;
            *)
                continue
                ;;
        esac
    done
}

# --- [MODULE] src/steam/35_fixes.sh ---
# ==============================================================================
# gamectl - Automated Game Fix & Online-Fix Harvester & Steam Lifecycle Engine
# Integrates LuaTools Fix API, Cloudflare R2 Presigned Downloads, Safe Extraction,
# Atomic Revert Snapshots, Proton Compatibility Guards, & Graceful Steam Reload.
# ==============================================================================

# Query community & Online-Fix bypasses for a given AppID
# Public unauthenticated endpoint: https://lua.tools/api/denuvo/fixes?appid=<appid>
check_game_fixes() {
    local appid="${1:-}"
    if [ -z "$appid" ] || ! [[ "$appid" =~ ^[0-9]+$ ]]; then
        echo "[ERROR] Invalid or missing Steam AppID: '$appid'" >&2
        echo "Usage: gamectl fix-check <appid>" >&2
        return 1
    fi

    echo "[INFO] Querying available fixes and bypasses for AppID: $appid..."

    local api_url="https://lua.tools/api/denuvo/fixes?appid=${appid}"
    local json_out
    json_out=$(curl -sSL --connect-timeout 5 --max-time 15 -A "discord(dot)gg/luatools" "$api_url" 2>/dev/null || true)

    if [ -z "$json_out" ]; then
        echo "[WARN] Could not reach LuaTools fix catalog for AppID $appid." >&2
        return 1
    fi

    # Check for empty response or 'No fixes found'
    if echo "$json_out" | grep -q '"No fixes found"'; then
        echo "[INFO] No community fixes or bypasses registered for AppID: $appid."
        return 0
    fi

    python3 -c '
import sys, json

try:
    data = json.loads(sys.argv[1])
except Exception as e:
    print("[ERROR] Failed to parse API response JSON:", e)
    sys.exit(1)

app_name = data.get("name", "Unknown Game")
appid = data.get("appid", sys.argv[2])
fixes = data.get("fixes", [])

if not fixes:
    print("[INFO] No community fixes or bypasses found for:", app_name, f"(AppID: {appid})")
    sys.exit(0)

print("==============================================================================")
print(f" GAMECTL FIX CATALOG: {app_name} (AppID: {appid})")
print(f" Available Fixes: {len(fixes)}")
print("==============================================================================")

for idx, fix in enumerate(fixes, 1):
    fix_id = fix.get("id", "unknown")
    title = fix.get("title", "Fix")
    filename = fix.get("fixFilename", "N/A")
    tags = [t.get("name", "") for t in fix.get("tags", []) if isinstance(t, dict)]
    tag_str = ", ".join(tags) if tags else "generic"
    has_fix = "[READY]" if fix.get("hasFix") else "[PENDING]"
    
    print(f" [{idx}] {has_fix} Title: {title}")
    print(f"     • Fix ID  : {fix_id}")
    print(f"     • Archive : {filename}")
    print(f"     • Tags    : {tag_str}")
    desc = fix.get("description", "").strip()
    if desc:
        print(f"     • Notes   : {desc}")
print("==============================================================================")
' "$json_out" "$appid"
}

# Resolve target game directory from AppID or path argument
resolve_game_install_dir() {
    local target="${1:-}"
    [ -z "$target" ] && return 1

    # If it is already an existing directory, resolve absolute path
    if [ -d "$target" ]; then
        (cd "$target" && pwd)
        return 0
    fi

    # If it is numeric AppID, inspect Steam libraries via appmanifest_<appid>.acf
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        local acf_file
        acf_file=$(find_app_acf "$target" 2>/dev/null || true)
        if [ -n "$acf_file" ] && [ -f "$acf_file" ]; then
            local state_data
            state_data=$(parse_acf_download_state "$acf_file" 2>/dev/null || true)
            if [ -n "$state_data" ]; then
                local installdir
                installdir=$(echo "$state_data" | cut -f 8)
                if [ -n "$installdir" ]; then
                    local cand_dir="$(dirname "$acf_file")/common/$installdir"
                    if [ -d "$cand_dir" ]; then
                        echo "$cand_dir"
                        return 0
                    fi
                fi
            fi
        fi

        # Fallback: Search inside all known library common directories
        local lib
        while IFS= read -r lib; do
            [ -d "$lib" ] || continue
            local common_dir="$lib"
            [ "$(basename "$lib")" != "common" ] && common_dir="$lib/common"
            [ -d "$common_dir" ] || common_dir="$(dirname "$lib")/common"
            [ -d "$common_dir" ] || continue

            # Search directory with matching appid or title
            local match
            match=$(find "$common_dir" -maxdepth 2 -type f \( -name "steam_appid.txt" -o -name "OnlineFix.ini" \) -exec grep -l "^$target$" {} + 2>/dev/null | head -n 1)
            if [ -n "$match" ]; then
                dirname "$match"
                return 0
            fi
        done < <(get_steam_libraries 2>/dev/null || true)
    fi

    return 1
}

# Audit Proton compatibility in config.vdf for Windows DLL fixes
audit_proton_compatibility() {
    local appid="$1"
    [ -z "$appid" ] && return 0

    local config_vdf=""
    for cand in "$HOME/.local/share/Steam/config/config.vdf" "$HOME/.steam/steam/config/config.vdf"; do
        if [ -f "$cand" ]; then
            config_vdf="$cand"
            break
        fi
    done

    [ -z "$config_vdf" ] && return 0

    local has_mapping=0
    if grep -E -A 5 "\"${appid}\"[[:space:]]*\{" "$config_vdf" 2>/dev/null | grep -q -E '"[Nn]ame"'; then
        has_mapping=1
    fi

    if [ "$has_mapping" -eq 0 ]; then
        echo "  [WARN] AppID $appid does not have an explicit Steam Play (Proton) compatibility tool set."
        echo "         If this game has native Linux binaries, Windows DLL fixes will NOT load."
        echo "         -> In Steam: Game Properties -> Compatibility -> Check 'Force the use of a specific Steam Play compatibility tool'."
    fi
}

# Detect custom crack launcher executable shipped by fix payload
detect_fix_custom_launcher() {
    local gdir="$1"
    [ -z "$gdir" ] || [ ! -d "$gdir" ] && return 0

    local custom_launcher
    custom_launcher=$(find "$gdir" -maxdepth 2 -type f \( \
        -iname "Launcher.exe" -o -iname "*_launcher.exe" -o -iname "launcher_*.exe" \
    \) ! -iname "UnityCrashHandler*.exe" ! -iname "crash*.exe" 2>/dev/null | head -n 1)

    if [ -n "$custom_launcher" ]; then
        local rel_launcher
        rel_launcher="$(basename "$custom_launcher")"
        echo "  [INFO] Custom crack launcher detected: $rel_launcher"
        echo "         If launching via Steam Client, set Launch Options in Steam Properties:"
        echo "         bash -c 'cmd=(%command%); cmd[-1]=\"\$PWD/$rel_launcher\"; \"\${cmd[@]}\"'"
    fi
}

# Download, verify, and safely extract game fix
install_game_fix() {
    local appid=""
    local target_dir=""
    local fix_type="online"
    local explicit_fix_id=""
    local auto_yes=false
    local should_restart=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --type)
                fix_type="${2:-online}"
                shift 2 || true
                ;;
            --fix-id)
                explicit_fix_id="${2:-}"
                shift 2 || true
                ;;
            -y|--yes)
                auto_yes=true
                shift
                ;;
            --restart)
                should_restart=true
                shift
                ;;
            *)
                if [ -z "$appid" ]; then
                    appid="$1"
                elif [ -z "$target_dir" ]; then
                    target_dir="$1"
                fi
                shift
                ;;
        esac
    done

    if [ -z "$appid" ] || ! [[ "$appid" =~ ^[0-9]+$ ]]; then
        echo "[ERROR] Invalid or missing Steam AppID: '$appid'" >&2
        echo "Usage: gamectl fix-install <appid> [game_dir] [--type online|generic|voices38|all] [--fix-id <id>] [--yes|-y] [--restart]" >&2
        return 1
    fi

    # 1. Resolve Target Game Directory
    local resolved_dir=""
    if [ -n "$target_dir" ] && [ -d "$target_dir" ]; then
        resolved_dir="$(cd "$target_dir" && pwd)"
    else
        resolved_dir=$(resolve_game_install_dir "$appid" 2>/dev/null || true)
    fi

    if [ -z "$resolved_dir" ] || [ ! -d "$resolved_dir" ]; then
        echo "[ERROR] Could not resolve game installation directory for AppID $appid." >&2
        echo "       Please provide the target directory explicitly:" >&2
        echo "       gamectl fix-install $appid /path/to/game_directory" >&2
        return 1
    fi
    echo "[INFO] Target installation directory: $resolved_dir"

    # 2. Query available fixes
    local api_url="https://lua.tools/api/denuvo/fixes?appid=${appid}"
    local json_out
    json_out=$(curl -sSL --connect-timeout 5 --max-time 15 -A "discord(dot)gg/luatools" "$api_url" 2>/dev/null || true)

    if [ -z "$json_out" ] || echo "$json_out" | grep -q '"No fixes found"'; then
        echo "[ERROR] No fixes available in catalog for AppID: $appid." >&2
        return 1
    fi

    # 3. Select target fix ID using Python selector
    local chosen_fix_json
    chosen_fix_json=$(python3 -c '
import sys, json

try:
    data = json.loads(sys.argv[1])
except Exception:
    sys.exit(1)

fixes = data.get("fixes", [])
if not fixes:
    sys.exit(1)

explicit_id = sys.argv[2]
pref_type = sys.argv[3].lower()

chosen = None

if explicit_id:
    for f in fixes:
        if f.get("id") == explicit_id:
            chosen = f
            break

if not chosen:
    ranked = []
    for f in fixes:
        if not f.get("hasFix"):
            continue
        tags = [t.get("slug", "").lower() for t in f.get("tags", []) if isinstance(t, dict)]
        title = f.get("title", "").lower()
        score = 100
        if "online-fix" in tags or "online fix" in title or "onlinefix" in title:
            score = 10 if pref_type == "online" else 50
        elif "voices38-crack" in tags or "voices38" in title:
            score = 20 if pref_type == "voices38" else 60
        elif "generic" in tags or "bypass" in title:
            score = 30 if pref_type == "generic" else 70
        ranked.append((score, f))
    
    if ranked:
        ranked.sort(key=lambda x: x[0])
        chosen = ranked[0][1]
    elif fixes:
        chosen = fixes[0]

if chosen:
    print(json.dumps(chosen))
' "$json_out" "$explicit_fix_id" "$fix_type")

    if [ -z "$chosen_fix_json" ]; then
        echo "[ERROR] Could not select a valid fix for AppID $appid." >&2
        return 1
    fi

    local fix_id fix_title fix_filename
    fix_id=$(echo "$chosen_fix_json" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("id", ""))')
    fix_title=$(echo "$chosen_fix_json" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("title", ""))')
    fix_filename=$(echo "$chosen_fix_json" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("fixFilename", ""))')

    echo "[INFO] Selected Fix:"
    echo "  • Fix ID   : $fix_id"
    echo "  • Title    : $fix_title"
    echo "  • Filename : $fix_filename"

    # 4. Authenticate via LuaTools token resolver
    local token
    token=$(get_valid_luatools_token 2>/dev/null || true)
    if [ -z "$token" ]; then
        echo "[ERROR] Downloading fix archives requires an active LuaTools account session." >&2
        echo "       Run: gamectl login-luatools <6-character-code | refresh_token | session.json>" >&2
        return 1
    fi

    # 5. Resolve presigned Cloudflare R2 download URL
    echo "[INFO] Resolving secure presigned download link..."
    local encoded_fix_id
    encoded_fix_id=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$fix_id")
    local dl_api="https://lua.tools/api/denuvo/download?fix=${encoded_fix_id}&slot=fix"
    local dl_resp
    dl_resp=$(curl -sSL --connect-timeout 8 --max-time 20 \
        -H "Authorization: Bearer $token" \
        -H "User-Agent: discord(dot)gg/luatools" \
        "$dl_api" 2>/dev/null || true)

    local signed_url
    signed_url=$(echo "$dl_resp" | python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    print(data.get("url", ""))
except Exception:
    pass
')

    if [ -z "$signed_url" ] || ! [[ "$signed_url" =~ ^https:// ]]; then
        echo "[ERROR] Failed to obtain presigned download link from LuaTools API." >&2
        echo "       Response: $dl_resp" >&2
        return 1
    fi

    # 6. Download archive to temporary file
    local tmp_zip
    tmp_zip=$(mktemp "${TMPDIR:-/tmp}/gamectl_fix_${appid}_XXXXXX.zip")
    echo "[INFO] Downloading fix archive payload..."
    if ! curl -sSL --connect-timeout 10 --max-time 180 \
        -A "discord(dot)gg/luatools" \
        -o "$tmp_zip" "$signed_url"; then
        rm -f "$tmp_zip"
        echo "[ERROR] Download failed from storage backend." >&2
        return 1
    fi

    if ! audit_zip_safety "$tmp_zip"; then
        rm -f "$tmp_zip"
        echo "[ERROR] Downloaded archive failed integrity or security audit." >&2
        return 1
    fi
    echo "[VERIFIED] Archive payload integrity & security audit passed."

    # 8. Create Atomic Backup Snapshot Before Overwriting
    local ts
    ts="$(date +%Y%m%d_%H%M%S)"
    local backup_dir="$resolved_dir/.gamectl_fix_backup/$ts"
    local backup_files_dir="$backup_dir/backup_files"
    mkdir -p "$backup_files_dir"

    local zip_files
    zip_files=$(unzip -Z1 "$tmp_zip" 2>/dev/null || true)
    local backed_up_count=0

    # Save list of all files extracted by this fix
    echo "$zip_files" > "$backup_dir/installed_files.txt"

    while IFS= read -r f; do
        [ -z "$f" ] && continue
        if [ -f "$resolved_dir/$f" ]; then
            mkdir -p "$(dirname "$backup_files_dir/$f")"
            cp -p "$resolved_dir/$f" "$backup_files_dir/$f"
            backed_up_count=$((backed_up_count + 1))
        fi
    done <<< "$zip_files"

    local meta_file="$resolved_dir/.gamectl_fix_backup/latest.json"
    local meta_tmp
    meta_tmp=$(mktemp "${meta_file}.gamectl.XXXXXX") || return 1
    if ! jq -n \
        --arg timestamp "$ts" \
        --arg appid "$appid" \
        --arg fix_id "$fix_id" \
        --arg fix_title "$fix_title" \
        --argjson backed_up_count "${backed_up_count:-0}" \
        '{timestamp: $timestamp, appid: $appid, fix_id: $fix_id, fix_title: $fix_title, backed_up_count: $backed_up_count}' \
        > "$meta_tmp" || ! mv -f "$meta_tmp" "$meta_file"; then
        rm -f "$meta_tmp"
        echo "[ERROR] Failed to write fix snapshot metadata: $meta_file" >&2
        return 1
    fi
    echo "[VERIFIED] Created pre-install snapshot: $backed_up_count original file(s) saved to .gamectl_fix_backup/$ts"

    # 9. Extract Payload into Target Game Directory
    echo "[INFO] Extracting fix payload into: $resolved_dir..."
    unzip -q -o "$tmp_zip" -d "$resolved_dir"
    rm -f "$tmp_zip"

    # 10. Audit Proton Compatibility & Custom Launcher Redirection
    audit_proton_compatibility "$appid"
    detect_fix_custom_launcher "$resolved_dir"

    # 11. Configure local OnlineFix files without registering Steam entitlements.
    echo "[INFO] Running local P2P compatibility setup..."
    setup_onlinefix "$resolved_dir" --yes || true

    echo "=============================================================================="
    invalidate_scan_cache
    echo " [SUCCESS] Fix successfully deployed for: $(basename "$resolved_dir")"
    echo "           To revert changes at any time: gamectl fix-revert \"$resolved_dir\""
    echo "=============================================================================="

    # 12. Optional Graceful Steam Restart
    if [ "$should_restart" = true ]; then
        restart_steam_client
    fi

    return 0
}

# Revert deployed game fix and restore original files from backup snapshot
revert_game_fix() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo "Usage: gamectl fix-revert <game_dir|appid> [--dry-run]" >&2
        return 1
    fi

    local is_dry_run=false
    for arg in "$@"; do
        if [ "$arg" = "--dry-run" ] || [ "$arg" = "-n" ]; then
            is_dry_run=true
        fi
    done

    local resolved_dir
    resolved_dir=$(resolve_game_install_dir "$target" 2>/dev/null || true)
    if [ -z "$resolved_dir" ] || [ ! -d "$resolved_dir" ]; then
        echo "[ERROR] Game directory not found for: '$target'" >&2
        return 1
    fi

    local backup_root="$resolved_dir/.gamectl_fix_backup"
    if [ ! -d "$backup_root" ]; then
        echo "[ERROR] No backup snapshots found in: $backup_root" >&2
        return 1
    fi

    # Find the most recent timestamp directory
    local latest_snap
    latest_snap=$(find "$backup_root" -mindepth 1 -maxdepth 1 -type d ! -name "latest.json" | sort -r | head -n 1)

    if [ -z "$latest_snap" ] || [ ! -d "$latest_snap" ]; then
        echo "[ERROR] No valid snapshot directory found in $backup_root." >&2
        return 1
    fi

    local backup_files_dir="$latest_snap/backup_files"
    local installed_list="$latest_snap/installed_files.txt"

    if [ "$is_dry_run" = true ]; then
        echo "[INFO] [DRY-RUN] Simulating game fix revert using snapshot: $(basename "$latest_snap")"
        if [ -f "$installed_list" ]; then
            while IFS= read -r f; do
                [ -z "$f" ] && continue
                [ "${f: -1}" = "/" ] && continue
                if [ -f "$backup_files_dir/$f" ]; then
                    echo "  • [RESTORE] $f (original file from backup)"
                elif [ -f "$resolved_dir/$f" ]; then
                    echo "  • [PURGE] $f (fix-introduced artifact)"
                fi
            done < "$installed_list"
        elif [ -d "$backup_files_dir" ]; then
            (
                cd "$backup_files_dir" || exit 1
                find . -type f | while read -r f; do
                    echo "  • [RESTORE] ${f#./} (original file from backup)"
                done
            )
        fi
        echo "[INFO] [DRY-RUN] Game fix revert simulated successfully (no files modified)."
        return 0
    fi

    echo "[INFO] Reverting game fix using snapshot: $(basename "$latest_snap")..."

    if [ -f "$installed_list" ]; then
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            # If the path was a directory entry in zip, skip file removal
            [ "${f: -1}" = "/" ] && continue

            if [ -f "$backup_files_dir/$f" ]; then
                # Restore original file that was replaced
                mkdir -p "$(dirname "$resolved_dir/$f")"
                cp -p "$backup_files_dir/$f" "$resolved_dir/$f"
            elif [ -f "$resolved_dir/$f" ]; then
                # File was newly introduced by the fix, remove it
                rm -f "$resolved_dir/$f"
            fi
        done < "$installed_list"
    elif [ -d "$backup_files_dir" ]; then
        (
            cd "$backup_files_dir" || exit 1
            find . -type f -exec cp -pv {} "$resolved_dir/{}" \;
        ) || return 1
    fi

    invalidate_scan_cache
    echo "[VERIFIED] Game fix reverted. Pristine files restored and fix artifacts purged."
    return 0
}

# Graceful Steam Client restart engine with SLSsteam wrapper preservation
restart_steam_client() {
    echo "[INFO] Initiating graceful Steam Client reload..."

    # Check if Steam process is active
    if ! pgrep -x steam >/dev/null 2>&1; then
        echo "[INFO] Steam Client is not currently running. No restart needed."
        return 0
    fi

    # Check for Game Mode supervisor (Steam Deck)
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl --user is-active --quiet steam-launcher.service 2>/dev/null; then
            echo "[INFO] Detected Game Mode systemd unit: steam-launcher.service. Restarting..."
            systemctl --user restart steam-launcher.service
            echo "[VERIFIED] Steam launcher service restarted."
            return 0
        fi
        local gs_unit
        gs_unit="$(systemctl --user list-units --type=service --state=active --plain --no-legend 'gamescope-session*' 2>/dev/null | awk '{print $1}' | head -n 1)"
        if [ -n "$gs_unit" ]; then
            echo "[INFO] Detected Game Mode gamescope session unit: $gs_unit. Restarting..."
            systemctl --user restart "$gs_unit"
            echo "[VERIFIED] Gamescope session unit restarted."
            return 0
        fi
    fi

    # Desktop Session: Resolve SLSsteam launcher wrapper
    local launcher="$HOME/.local/share/SLSsteam/path/steam"
    if [ ! -x "$launcher" ]; then
        launcher="$(command -v steam 2>/dev/null || echo "")"
    fi

    # Flush disk writes
    sync

    # Request graceful shutdown via SIGTERM
    pkill -TERM -x steam >/dev/null 2>&1 || true

    # Wait up to 10 seconds for clean exit
    local terminated=false
    for _ in {1..50}; do
        if ! pgrep -x steam >/dev/null 2>&1; then
            terminated=true
            break
        fi
        sleep 0.2
    done

    # Escalate to SIGKILL if still hanging
    if [ "$terminated" = false ]; then
        echo "[WARN] Steam did not exit within grace period. Escalating to SIGKILL..." >&2
        pkill -KILL -x steam >/dev/null 2>&1 || true
    fi

    # Clean residual child processes
    pkill -KILL -f 'steamwebhelper' >/dev/null 2>&1 || true
    sleep 1

    # Relaunch launcher in detached background session
    if [ -n "$launcher" ] && [ -x "$launcher" ]; then
        echo "[INFO] Relaunching Steam via: $launcher"
        nohup "$launcher" </dev/null >/dev/null 2>&1 &
        echo "[VERIFIED] Steam client successfully restarted."
    else
        echo "[WARN] Could not find executable Steam launcher binary to relaunch." >&2
    fi

    return 0
}

# Preview pane generator for Community Fixes and OnlineFix catalog
preview_fix_entry() {
    local fix_id="${1:-}"
    local appid="${2:-${GAMECTL_PREVIEW_APPID:-}}"
    local fix_title="${3:-}"
    local fix_file="${4:-}"
    local fix_tags="${5:-}"
    local gdir="${6:-${GAMECTL_PREVIEW_GDIR:-}}"
    local fix_desc="${7:-}"

    fix_id=$(strip_ansi "$fix_id" | tr -d '[:space:]')
    appid=$(strip_ansi "$appid" | tr -d '[:space:]')
    fix_title=$(strip_ansi "$fix_title" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    fix_file=$(strip_ansi "$fix_file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    fix_tags=$(strip_ansi "$fix_tags" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    gdir=$(strip_ansi "$gdir" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    printf "%s╭─ COMMUNITY FIX & ONLINEFIX HARVESTER ───────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
    printf "│ %s%s%s %s(AppID: %s)%s\n" "${UI_BOLD}" "${fix_title:-Community Fix}" "${UI_RST}" "${UI_DIM}" "${appid:-N/A}" "${UI_RST}"
    printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"

    if [ "$fix_id" = "[RESTORE]" ] || [ "$fix_id" = "[SIMULATE]" ]; then
        local snap_dir="$gdir/.gamectl_fix_backup"
        local latest_snap=""
        if [ -d "$snap_dir" ]; then
            latest_snap=$(find "$snap_dir" -mindepth 1 -maxdepth 1 -type d ! -name "latest.json" 2>/dev/null | sort -r | head -n 1)
        fi

        local snap_meta="$snap_dir/latest.json"
        local snap_ts="Unknown" orig_title="Unknown" backed_cnt="0"
        if [ -f "$snap_meta" ]; then
            snap_ts=$(jq -r '.timestamp // "Unknown"' "$snap_meta" 2>/dev/null || echo "Unknown")
            orig_title=$(jq -r '.fix_title // "Unknown"' "$snap_meta" 2>/dev/null || echo "Unknown")
            backed_cnt=$(jq -r '.backed_up_count // 0' "$snap_meta" 2>/dev/null || echo "0")
        fi

        if [ "$fix_id" = "[RESTORE]" ]; then
            printf "  %sOperation  %s: %s[RESTORE ROLLBACK]%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_AMBER}" "${UI_RST}"
            printf "  %sTarget Dir %s: %s%s%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "${gdir:-N/A}" "${UI_RST}"
            printf "\n%s╭─ SNAPSHOT RESTORATION DETAILS ──────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
            printf "  %sActive Snapshot%s : %s%s%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_BOLD}" "$(basename "${latest_snap:-None}")" "${UI_RST}"
            printf "  %sTimestamp      %s : %s\n" "${UI_CYAN}" "${UI_RST}" "$snap_ts"
            printf "  %sPatched Fix    %s : %s\n" "${UI_CYAN}" "${UI_RST}" "$orig_title"
            printf "  %sOriginal Files %s : %s%s files preserved%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_GREEN}" "$backed_cnt" "${UI_RST}"
            printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
            printf "\n%s╭─ SAFETY & INTEGRITY GUARANTEES ─────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
            printf "  • Overwrites all patched files with original untouched binaries\n"
            printf "  • Purges newly introduced DLLs, wrappers, and OnlineFix hooks\n"
            printf "  • Restores pristine state without requiring complete re-download\n"
            printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
        else
            printf "  %sOperation  %s: %s[DRY-RUN SIMULATION]%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_ICE}" "${UI_RST}"
            printf "  %sTarget Dir %s: %s%s%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "${gdir:-N/A}" "${UI_RST}"
            printf "\n%s╭─ DRY-RUN AUDIT PREVIEW ─────────────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
            if [ -n "$gdir" ] && [ -d "$gdir" ]; then
                local sim_lines
                sim_lines=$(revert_game_fix "$gdir" --dry-run 2>&1 | grep -E '• \[(RESTORE|PURGE)\]' | head -n 10 || true)
                if [ -n "$sim_lines" ]; then
                    printf "%s\n" "$sim_lines"
                else
                    printf "  %sNo file differences or uncommitted artifacts detected.%s\n" "${UI_DIM}" "${UI_RST}"
                fi
            else
                printf "  %sNo local game directory available for simulation.%s\n" "${UI_DIM}" "${UI_RST}"
            fi
            printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
        fi
        return 0
    fi

    # Check cached metadata JSON if available to get rich description
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gamectl"
    local cache_file="$cache_dir/luatools_fixes_${appid}.json"
    if [ -f "$cache_file" ]; then
        local json_details
        json_details=$(python3 -c '
import sys, json
try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        data = json.load(f)
    target_id = sys.argv[2]
    for fix in data.get("fixes", []):
        if str(fix.get("id")) == target_id:
            tags = [t.get("name", "") for t in fix.get("tags", []) if isinstance(t, dict)]
            print(fix.get("title", ""))
            print(fix.get("fixFilename", ""))
            print(", ".join(tags) if tags else "Community Fix")
            print(fix.get("description", "").strip())
            sys.exit(0)
except Exception:
    pass
sys.exit(1)
' "$cache_file" "$fix_id" 2>/dev/null || true)
        if [ -n "$json_details" ]; then
            fix_title=$(echo "$json_details" | sed -n '1p')
            fix_file=$(echo "$json_details" | sed -n '2p')
            fix_tags=$(echo "$json_details" | sed -n '3p')
            fix_desc=$(echo "$json_details" | sed -n '4,$p')
        fi
    fi

    # Community Fix / OnlineFix metadata
    printf "  %sFix ID     %s: %s%s%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "$fix_id" "${UI_RST}"
    printf "  %sCategory   %s: %s%s%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_GREEN}" "${fix_tags:-Community Fix}" "${UI_RST}"
    [ -n "$fix_file" ] && printf "  %sPayload    %s: %s%s%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_BOLD}" "$fix_file" "${UI_RST}"

    printf "\n%s╭─ FIX CAPABILITIES & MULTIPLAYER ────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
    if [[ "$fix_tags" =~ [Oo]nline|[Ff]ix|P2P|Co-?op ]] || [[ "$fix_title" =~ [Oo]nline|P2P|Co-?op ]]; then
        printf "  %sOnline P2P %s: %s[SUPPORTED] Steamworks Spacewar Overlay (AppID 480)%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_GREEN}" "${UI_RST}"
        printf "  %sOverrides  %s: %sAutomatic WINEDLLOVERRIDES injection (wsock32, etc.)%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "${UI_RST}"
    else
        printf "  %sFix Scope  %s: %sGeneral compatibility / DLC unlock patch%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "${UI_RST}"
    fi

    local token_status="${UI_RED}[MISSING] Login required (gamectl login-luatools)${UI_RST}"
    if get_valid_luatools_token >/dev/null 2>&1; then
        token_status="${UI_GREEN}[ACTIVE] Authorized session ready${UI_RST}"
    fi
    printf "  %sLuaTools   %s: %s\n" "${UI_CYAN}" "${UI_RST}" "$token_status"

    if [ -n "$gdir" ] && [ -d "$gdir" ]; then
        printf "  %sTarget Dir %s: %s%s%s %s[READY]%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_DIM}" "$gdir" "${UI_RST}" "${UI_GREEN}" "${UI_RST}"
    else
        printf "  %sTarget Dir %s: %sCatalog Browsing Mode (Not installed locally)%s\n" "${UI_CYAN}" "${UI_RST}" "${UI_AMBER}" "${UI_RST}"
    fi
    printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"

    if [ -n "$fix_desc" ]; then
        printf "\n%s╭─ RELEASE NOTES & INSTRUCTIONS ──────────────────────╮%s\n" "${UI_BOX}" "${UI_RST}"
        printf "  %s%s%s\n" "${UI_DIM}" "$fix_desc" "${UI_RST}"
        printf "%s╰─────────────────────────────────────────────────────╯%s\n" "${UI_BOX}" "${UI_RST}"
    fi
}

# Interactive TUI modal for inspecting, installing, and reverting community fixes
manage_game_fixes_interactive() {
    local appid="${1:-}"
    local title="${2:-}"
    local gdir="${3:-}"

    # 1. Resolve numeric Steam AppID if not directly provided
    if [ -z "$appid" ] || ! [[ "$appid" =~ ^[0-9]+$ ]]; then
        if [ -n "$gdir" ] && [ -d "$gdir" ]; then
            local detected_id
            detected_id="$(resolve_game_appid "$gdir")"
            [ -n "$detected_id" ] && appid="$detected_id"
        fi
    fi

    if [ -z "$appid" ] || ! [[ "$appid" =~ ^[0-9]+$ ]]; then
        tui_modal_notice "Fix Catalog" "Numeric Steam AppID could not be determined for:\n${title:-$gdir}\nCommunity fixes catalog requires a valid Steam AppID." || return $?
        return 1
    fi

    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "[ERROR] Interactive fixes manager requires a terminal (TTY)." >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[ERROR] fzf is required for interactive mode but was not found in PATH." >&2
        return 127
    fi

    # 2. Resolve target installation directory if missing
    if [ -z "$gdir" ] || [ ! -d "$gdir" ]; then
        gdir=$(resolve_game_install_dir "$appid" 2>/dev/null || true)
    fi

    # 3. Query LuaTools API (with caching)
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gamectl"
    mkdir -p "$cache_dir" 2>/dev/null || true
    local cache_file="$cache_dir/luatools_fixes_${appid}.json"
    local json_out=""
    local now
    now=$(date +%s)
    if [ -f "$cache_file" ]; then
        local mtime
        mtime=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0)
        if [ $(( now - mtime )) -lt 3600 ] && [ -s "$cache_file" ]; then
            json_out=$(cat "$cache_file")
        fi
    fi

    if [ -z "$json_out" ]; then
        local api_url="https://lua.tools/api/denuvo/fixes?appid=${appid}"
        json_out=$(curl -sSL --connect-timeout 5 --max-time 15 -A "discord(dot)gg/luatools" "$api_url" 2>/dev/null || true)
        if [ -n "$json_out" ] && echo "$json_out" | jq . >/dev/null 2>&1; then
            echo "$json_out" > "$cache_file" 2>/dev/null || true
        fi
    fi

    # 4. Interactive selection loop
    while true; do
        flush_tty_input

        # Check for backup snapshot in target directory
        local has_backup=false
        local backup_root=""
        if [ -n "$gdir" ] && [ -d "$gdir/.gamectl_fix_backup" ]; then
            backup_root="$gdir/.gamectl_fix_backup"
            if find "$backup_root" -mindepth 1 -maxdepth 1 -type d ! -name "latest.json" 2>/dev/null | grep -q .; then
                has_backup=true
            fi
        fi

        # Parse available fixes from JSON
        local fix_tsv=""
        if [ -n "$json_out" ]; then
            fix_tsv=$(python3 -c '
import sys, json

try:
    data = json.loads(sys.argv[1])
except Exception:
    print("[ERROR] Invalid fixes catalog JSON", file=sys.stderr)
    sys.exit(1)

fixes = data.get("fixes", [])
rows = []
for f in fixes:
    fid = f.get("id", "")
    title = f.get("title", "Fix")
    filename = f.get("fixFilename", "")
    tags = [t.get("name", "") for t in f.get("tags", []) if isinstance(t, dict)]
    tag_str = ", ".join(tags) if tags else "Community Fix"
    desc = f.get("description", "").strip().replace("\n", " ").replace("\t", " ").replace("\r", " ")
    has_fix = "[READY]" if f.get("hasFix") else "[PENDING]"
    fields = [str(fid), title, f"{has_fix} [{tag_str}]", filename, desc]
    if any(any(c in field for c in "\t\r\n") for field in fields):
        print("[ERROR] Fix catalog fields contain TAB, CR or newline", file=sys.stderr)
        sys.exit(1)
    rows.append("\t".join(fields))
print("\n".join(rows))
' "$json_out") || return 1
        fi

        # If both fixes and backups are empty, notify and return
        if [ -z "$fix_tsv" ] && [ "$has_backup" = false ]; then
            tui_modal_notice "Community Fix Catalog" "No community fixes, OnlineFixes, or backup snapshots found for:\n${title:-AppID $appid}" || return $?
            return 0
        fi

        # Build list for FZF
        local menu_list=""
        if [ "$has_backup" = true ]; then
            menu_list+=$'[RESTORE]\tRestore Pristine Game Binaries\t[ROLLBACK]\tpre-patch backup\tRestore original untouched files\n'
            menu_list+=$'[SIMULATE]\tSimulate Revert (--dry-run)\t[DRY-RUN]\tdry-run audit\tAudit files that would be restored or purged\n'
        fi
        if [ -n "$fix_tsv" ]; then
            menu_list+="$fix_tsv"
        fi

        local fzf_out="" fzf_rc=0
        export GAMECTL_PREVIEW_BIN="$SELF_BIN"
        export GAMECTL_PREVIEW_APPID="$appid"
        export GAMECTL_PREVIEW_GDIR="$gdir"
        fzf_out=$(printf '%s' "$menu_list" | fzf \
            --delimiter=$'\t' \
            --with-nth=2,3 \
            --border-label="  ╢ Community Fixes & OnlineFix :: ${title:-AppID $appid} ╟  " \
            --border-label-pos=2 \
            --header="SELECT FIX OR ACTION (Enter: Select / Execute │ Esc: Return)" \
            --prompt="Fix > " \
            --preview='"$GAMECTL_PREVIEW_BIN" --preview-fix {1} "$GAMECTL_PREVIEW_APPID" {2} {4} {3} "$GAMECTL_PREVIEW_GDIR"' \
            --preview-window=right:55%:border-rounded:wrap 2>/dev/null) || fzf_rc=$?

        if [ "$fzf_rc" -eq 130 ]; then
            break
        fi
        if [ "$fzf_rc" -ne 0 ] && [ "$fzf_rc" -ne 1 ]; then
            echo "[ERROR] Community fixes menu failed (fzf exit code $fzf_rc)." >&2
            return "$fzf_rc"
        fi
        [ -z "$fzf_out" ] && continue

        local sel_fix_id sel_fix_title sel_fix_tags sel_fix_file
        sel_fix_id=$(echo "$fzf_out" | awk -F'\t' '{print $1}')
        sel_fix_title=$(echo "$fzf_out" | awk -F'\t' '{print $2}')
        sel_fix_tags=$(echo "$fzf_out" | awk -F'\t' '{print $3}')
        sel_fix_file=$(echo "$fzf_out" | awk -F'\t' '{print $4}')

        if [ "$sel_fix_id" = "[RESTORE]" ]; then
            if [ -z "$gdir" ] || [ ! -d "$gdir" ]; then
                tui_modal_notice "Revert Error" "Game directory is missing or invalid: $gdir" || return $?
                continue
            fi
            local restore_palette
            restore_palette=$(cat <<EOF
1	Confirm & Restore Pristine Binaries from Snapshot
2	Cancel / Return
EOF
)
            local r_sel fzf_r_rc=0
            r_sel=$(echo "$restore_palette" | fzf \
                --delimiter=$'\t' \
                --with-nth=2 \
                --border-label="  ╢ Confirm Snapshot Restore ╟  " \
                --border-label-pos=2 \
                --header="RESTORE CONFIRMATION (Enter: Execute │ Esc: Cancel)" \
                --prompt="Confirm > " \
                --reverse 2>/dev/null) || fzf_r_rc=$?

            if [ "$fzf_r_rc" -eq 130 ]; then
                continue
            fi
            if [ "$fzf_r_rc" -ne 0 ] && [ "$fzf_r_rc" -ne 1 ]; then
                echo "[ERROR] Snapshot restore confirmation failed (fzf exit code $fzf_r_rc)." >&2
                return "$fzf_r_rc"
            fi

            if [ "$(echo "$r_sel" | cut -f1)" = "1" ]; then
                if tui_run_engine --fail-title "Revert Error" "Revert Community Fix (${title:-$gdir})" revert_game_fix "$gdir"; then
                    tui_modal_notice "Revert Successful" "Community fix reverted. Pristine files restored for:\n${title:-$gdir}" || return $?
                    invalidate_scan_cache
                fi
            fi
            continue
        elif [ "$sel_fix_id" = "[SIMULATE]" ]; then
            if [ -z "$gdir" ] || [ ! -d "$gdir" ]; then
                tui_modal_notice "Dry-Run Error" "Game directory is missing or invalid: $gdir" || return $?
                continue
            fi
            local dry_output
            dry_output=$(revert_game_fix "$gdir" --dry-run 2>&1 || true)
            tui_modal_notice "Dry-Run Simulation" "$dry_output" || return $?
            continue
        else
            # Fix selected
            if [ -z "$gdir" ] || [ ! -d "$gdir" ]; then
                tui_modal_notice "Installation Target Missing" "Game installation directory not found for AppID $appid.\n\nTo install community fixes, the game must be installed locally." || return $?
                continue
            fi

            local fix_palette
            fix_palette=$(cat <<EOF
1	Deploy Fix & Auto-Configure P2P (Backup & Apply)
2	Simulate Deployment (--dry-run check)
3	Cancel / Return
EOF
)
            local f_sel fzf_f_rc=0
            f_sel=$(echo "$fix_palette" | fzf \
                --delimiter=$'\t' \
                --with-nth=2 \
                --border-label="  ╢ Fix Action: $sel_fix_title ╟  " \
                --border-label-pos=2 \
                --header="FIX DEPLOYMENT (Enter: Select │ Esc: Return)" \
                --prompt="Action > " \
                --reverse 2>/dev/null) || fzf_f_rc=$?

            if [ "$fzf_f_rc" -eq 130 ]; then
                continue
            fi
            if [ "$fzf_f_rc" -ne 0 ] && [ "$fzf_f_rc" -ne 1 ]; then
                echo "[ERROR] Fix deployment prompt failed (fzf exit code $fzf_f_rc)." >&2
                return "$fzf_f_rc"
            fi

            local f_opt
            f_opt=$(echo "$f_sel" | cut -f1)
            case "$f_opt" in
                1)
                    if ! get_valid_luatools_token >/dev/null 2>&1; then
                        tui_modal_notice "LuaTools Authentication Required" "Downloading community fixes requires an active LuaTools account session.\n\nPlease authenticate in terminal via:\n  gamectl login-luatools <token|session.json>" || return $?
                        continue
                    fi
                    log_msg "INFO" "FIX" "Installing community fix '$sel_fix_title' ($sel_fix_id) for ${title:-AppID $appid}..."
                    if tui_run_engine --fail-title "Fix Error" "Install Community Fix ($sel_fix_title)" install_game_fix "$appid" "$gdir" --fix-id "$sel_fix_id" --yes; then
                        tui_modal_notice "Fix Deployed" "Successfully installed community fix: $sel_fix_title\nBackup snapshot created in: .gamectl_fix_backup/" || return $?
                        invalidate_scan_cache
                    fi
                    ;;
                2)
                    tui_modal_notice "Simulation Audit" "Target Directory : $gdir\nFix ID           : $sel_fix_id\nPayload Archive  : $sel_fix_file\nOnline P2P       : Automatic AppID 480 & DLL Overrides\nRollback         : Pre-install snapshot will be saved to .gamectl_fix_backup/" || return $?
                    ;;
                *)
                    continue
                    ;;
            esac
        fi
    done

    flush_tty_input
    return 0
}

# --- [MODULE] src/stores/00_store_interface.sh ---
# ==============================================================================
# Unified Store Interface & Adapter Registry (Multi-Store Phase 1)
# ==============================================================================

# Print registered store adapter identifiers, one per line.
store_list_registered() {
    printf '%s\n' "steam" "gog" "epic" "amazon"
}

# Print store adapters that are offline-ready on this host.
store_list_available() {
    local store_name=""
    while IFS= read -r store_name; do
        [ -n "$store_name" ] || continue
        if declare -F "store_${store_name}_available" >/dev/null 2>&1; then
            if "store_${store_name}_available" >/dev/null 2>&1; then
                printf '%s\n' "$store_name"
            fi
        fi
    done < <(store_list_registered)
}

# Validate and dispatch an operation to a registered store adapter.
store_dispatch() {
    local store="${1:-}"
    local op="${2:-}"
    if [ -z "$store" ] || [ -z "$op" ]; then
        echo "Usage: store_dispatch <store> <op> [args...]" >&2
        return 1
    fi
    shift 2

    if [[ ! "$store" =~ ^[a-z0-9_]+$ ]]; then
        echo "[ERROR] Invalid store identifier: $store" >&2
        return 1
    fi

    if ! store_list_registered | grep -Fxq "$store"; then
        echo "[ERROR] Unsupported or unregistered store: $store" >&2
        return 1
    fi

    case "$op" in
        available|status|search|list_installed|download|sync)
            ;;
        *)
            echo "[ERROR] Unsupported store operation: $op (supported: available, status, search, list_installed, download, sync)" >&2
            return 1
            ;;
    esac

    local handler="store_${store}_${op}"
    if ! declare -F "$handler" >/dev/null 2>&1; then
        echo "[ERROR] Store adapter '$store' does not implement '$op' ($handler)" >&2
        return 1
    fi

    "$handler" "$@"
}

# CLI entrypoint for `gamectl stores [list|status]`
stores_cli() {
    local action="${1:-status}"
    local store_name=""
    case "$action" in
        list)
            while IFS= read -r store_name; do
                [ -n "$store_name" ] || continue
                if store_dispatch "$store_name" available >/dev/null 2>&1; then
                    printf '%-12s\t[AVAILABLE]\n' "$store_name"
                else
                    printf '%-12s\t[UNAVAILABLE]\n' "$store_name"
                fi
            done < <(store_list_registered)
            ;;
        status)
            while IFS= read -r store_name; do
                [ -n "$store_name" ] || continue
                store_dispatch "$store_name" status
            done < <(store_list_registered)
            ;;
        *)
            echo "Usage: gamectl stores [list|status]" >&2
            return 1
            ;;
    esac
}

# Unified headless authentication hub across all stores (never stores plaintext secrets).
auth_hub_cli() {
    local action="${1:-status}"
    [ $# -gt 0 ] && shift
    case "$action" in
        status)
            local lua_status="unconfigured"
            local lumen_auth="${XDG_DATA_HOME:-$HOME/.local/share}/Lumen/luatools/backend/data/lua_tools_auth.json"
            if [ -s "$HOME/.config/gamectl/lua_tools_auth.json" ] || [ -s "$lumen_auth" ]; then
                lua_status="session present"
            fi
            local hubcap_status="unconfigured"
            if declare -F get_hubcap_api_key >/dev/null 2>&1 && [ -n "$(get_hubcap_api_key 2>/dev/null || true)" ]; then
                hubcap_status="configured"
            fi
            printf 'store=steam\n  luatools : %s\n  hubcap   : %s\n' "$lua_status" "$hubcap_status"
            local s
            for s in gog epic amazon; do
                store_dispatch "$s" status
            done
            ;;
        gog)    gog_cli auth "$@" ;;
        epic)   epic_cli auth "$@" ;;
        amazon) amazon_cli auth "$@" ;;
        luatools)
            if [ $# -gt 0 ]; then
                login_luatools "$@"
            elif [ -t 0 ] && [ -t 1 ] && declare -F login_luatools_interactive >/dev/null 2>&1; then
                login_luatools_interactive
            else
                echo "Usage: gamectl auth luatools <code|token|session.json>" >&2
                return 1
            fi
            ;;
        --help|-h|help)
            echo "Usage: gamectl auth [status|gog|epic|amazon|luatools] [args...]"
            ;;
        *)
            echo "[ERROR] Unknown auth target '$action'. Usage: gamectl auth [status|gog|epic|amazon|luatools] [args...]" >&2
            return 1
            ;;
    esac
}

# Cross-store search aggregator returning validated 7-col TSV:
# STORE<TAB>APP_ID<TAB>TITLE<TAB>PLATFORMS<TAB>STATUS<TAB>ITEM_TYPE<TAB>PARENT_APPID
store_search_all() {
    local query="" target="all"
    while [ $# -gt 0 ]; do
        case "$1" in
            --store)
                [ -n "${2:-}" ] || { echo "[ERROR] --store requires a store name." >&2; return 1; }
                target="${2,,}"; shift 2 ;;
            --store=*)
                target="${1#*=}"; target="${target,,}"; shift ;;
            --help|-h)
                echo "Usage: gamectl search-stores <query> [--store <all|steam|gog|epic|amazon>]"
                return 0 ;;
            *)
                [ -z "$query" ] && query="$1" || query="$query $1"
                shift ;;
        esac
    done
    [ -n "$query" ] || { echo "[ERROR] Usage: gamectl search-stores <query> [--store <all|steam|gog|epic|amazon>]" >&2; return 1; }

    local -a targets=()
    if [ "$target" = "all" ]; then
        local avail_s
        while IFS= read -r avail_s; do
            [ -n "$avail_s" ] && targets+=("$avail_s")
        done < <(store_list_available)
    else
        store_list_registered | grep -Fxq "$target" || { echo "[ERROR] Unsupported store '$target'." >&2; return 1; }
        store_dispatch "$target" available >/dev/null 2>&1 || { echo "[ERROR] Store '$target' is unavailable on this host." >&2; return 1; }
        targets=("$target")
    fi

    local -a raw_rows=() steam_ids=()
    local st out line r_store r_id r_title r_plats r_status
    for st in "${targets[@]}"; do
        out=$(store_dispatch "$st" search "$query" 2>/dev/null || true)
        [ -n "$out" ] || continue
        while IFS=$'\t' read -r r_store r_id r_title r_plats r_status; do
            [ -n "$r_store" ] && [ -n "$r_id" ] || continue
            raw_rows+=("${r_store}"$'\t'"${r_id}"$'\t'"${r_title}"$'\t'"${r_plats}"$'\t'"${r_status}")
            [ "$r_store" = "STEAM" ] && [[ "$r_id" =~ ^[0-9]+$ ]] && steam_ids+=("$r_id")
        done <<< "$out"
    done
    [ "${#raw_rows[@]}" -gt 0 ] || { echo "[ERROR] Cross-store search returned no results for '$query'." >&2; return 1; }

    declare -A st_type=() st_parent=()
    if [ "${#steam_ids[@]}" -gt 0 ] && declare -F classify_steam_app_types >/dev/null 2>&1; then
        local c_out c_id c_type c_parent
        c_out=$(classify_steam_app_types "${steam_ids[@]}" 2>/dev/null || true)
        while IFS=$'\t' read -r c_id c_type c_parent; do
            [ -n "$c_id" ] || continue
            st_type["$c_id"]="${c_type:-APP}"
            st_parent["$c_id"]="${c_parent:-}"
        done <<< "$c_out"
    fi

    local emitted=0 item_type parent_id row
    for row in "${raw_rows[@]}"; do
        IFS=$'\t' read -r r_store r_id r_title r_plats r_status <<< "$row"
        if [ "$r_store" = "STEAM" ]; then
            item_type="${st_type[$r_id]:-APP}"
            parent_id="${st_parent[$r_id]:-}"
        else
            item_type="GAME"
            parent_id=""
        fi
        if declare -F validate_tui_fields >/dev/null 2>&1; then
            validate_tui_fields "$r_store" "$r_id" "$r_title" "$r_plats" "$r_status" "$item_type" "$parent_id" || continue
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$r_store" "$r_id" "$r_title" "$r_plats" "$r_status" "$item_type" "$parent_id"
        emitted=$((emitted + 1))
    done
    [ "$emitted" -gt 0 ]
}

# Standalone-source compatibility: load split store adapters when sourced directly outside bin/gamectl
if [ -z "${GAMECTL_BUNDLED:-}" ] && [ -n "${BASH_SOURCE[0]:-}" ]; then
    _stores_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    for _stores_sub in 10_store_steam.sh 20_store_gog.sh 30_store_epic.sh 40_store_amazon.sh; do
        if [ -f "$_stores_dir/$_stores_sub" ]; then
            # shellcheck source=/dev/null
            source "$_stores_dir/$_stores_sub"
        fi
    done
    unset _stores_dir _stores_sub
fi

# --- [MODULE] src/stores/10_store_steam.sh ---
# ==============================================================================
# Built-in Steam Store Adapter (Standalone CDN + GBE Fork + Offline Metadata)
# ==============================================================================

# Offline availability probe for built-in Steam standalone adapter.
store_steam_available() {
    if declare -F resolve_depot_dl_bin >/dev/null 2>&1 && resolve_depot_dl_bin >/dev/null 2>&1; then
        return 0
    fi
    if command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

# Report offline-safe capability status for built-in Steam adapter.
store_steam_status() {
    local dl_bin="" dl_status="missing"
    if declare -F resolve_depot_dl_bin >/dev/null 2>&1; then
        dl_bin="$(resolve_depot_dl_bin 2>/dev/null || true)"
    fi
    if [ -n "$dl_bin" ]; then
        dl_status="ready ($dl_bin)"
    fi

    local gbe_linux="" gbe_win="" gbe_status="missing"
    if declare -F get_gbe_template >/dev/null 2>&1; then
        gbe_linux="$(get_gbe_template linux x64 2>/dev/null || true)"
        gbe_win="$(get_gbe_template windows x64 2>/dev/null || true)"
    fi
    if [ -n "$gbe_linux" ] && [ -n "$gbe_win" ]; then
        gbe_status="ready (linux+windows)"
    elif [ -n "$gbe_linux" ] || [ -n "$gbe_win" ]; then
        gbe_status="partial"
    fi

    local lua_status="unconfigured"
    if [ -s "$HOME/.config/gamectl/lua_tools_auth.json" ]; then
        lua_status="session present"
    fi

    local hubcap_key="" hubcap_status="unconfigured"
    if declare -F get_hubcap_api_key >/dev/null 2>&1; then
        hubcap_key="$(get_hubcap_api_key 2>/dev/null || true)"
    fi
    [ -n "$hubcap_key" ] && hubcap_status="configured"

    echo "store=steam"
    echo "  depot_dl : $dl_status"
    echo "  gbe_fork : $gbe_status"
    echo "  luatools : $lua_status"
    echo "  hubcap   : $hubcap_status"
    return 0
}

# Search Steam Store catalog and emit sanitized TSV:
#   STEAM<TAB>APP_ID<TAB>TITLE<TAB>PLATFORMS<TAB>STATUS
store_steam_search() {
    local query="${1:-}"
    if [ -z "$query" ]; then
        echo "[ERROR] Usage: store_steam_search <query>" >&2
        return 1
    fi

    local encoded_query raw_results parsed_rows
    encoded_query=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
    raw_results=$(curl -s --connect-timeout 5 --max-time 15 \
        "https://store.steampowered.com/api/storesearch/?term=${encoded_query}&l=english&cc=US" 2>/dev/null || true)

    if [ -z "$raw_results" ]; then
        echo "[ERROR] Steam Store search failed or returned an empty response." >&2
        return 1
    fi

    if ! parsed_rows=$(printf '%s' "$raw_results" | jq -r '
        if (.items | type) != "array" then
            error("Invalid Steam search payload")
        elif any(.items[]?; (.id | tostring | test("[\\t\\r\\n]")) or (.name | tostring | test("[\\t\\r\\n]"))) then
            error("TUI catalog contains TAB, CR or newline")
        else
            .items[] |
            [
                (.id | tostring),
                (.name | tostring),
                (
                    [
                        (if (.platforms.linux // false) then "linux" else empty end),
                        (if (.platforms.windows // false) then "windows" else empty end),
                        (if (.platforms.mac // false) then "mac" else empty end)
                    ] | join(",") | if length == 0 then "unknown" else . end
                )
            ] | @tsv
        end
    ' 2>/dev/null); then
        echo "[ERROR] Invalid Steam search catalog." >&2
        return 1
    fi

    declare -A installed_ids=()
    if declare -F scan_installed_games >/dev/null 2>&1; then
        local ins_id
        while IFS=$'\t' read -r ins_id _; do
            ins_id="${ins_id//[[:space:]]/}"
            [ -n "$ins_id" ] && installed_ids["$ins_id"]=1
        done < <(scan_installed_games 2>/dev/null || true)
    fi

    local app_id title platforms row_status
    while IFS=$'\t' read -r app_id title platforms; do
        [ -n "$app_id" ] || continue
        if declare -F validate_tui_fields >/dev/null 2>&1; then
            validate_tui_fields "$app_id" "$title" "$platforms" || return 1
        fi
        row_status="AVAILABLE"
        [ -n "${installed_ids["$app_id"]:-}" ] && row_status="INSTALLED"
        printf 'STEAM\t%s\t%s\t%s\t%s\n' "$app_id" "$title" "$platforms" "$row_status"
    done <<< "$parsed_rows"
    return 0
}

# List installed games belonging to Steam or Standalone libraries (v3 6-col TSV).
store_steam_list_installed() {
    if ! declare -F scan_installed_games >/dev/null 2>&1; then
        echo "[ERROR] scan_installed_games is unavailable." >&2
        return 1
    fi
    scan_installed_games "$@" | awk -F'\t' '{ st = ($6 == "" ? "STANDALONE" : $6); if (st == "STEAM" || st == "STANDALONE") print }'
}

# Delegate Steam/Standalone download to headless downloader engine.
store_steam_download() {
    local app_id="${1:-}"
    if [ -z "$app_id" ]; then
        echo "Usage: store_steam_download <appid> [target_dir] [title] [options...]" >&2
        return 1
    fi
    download_game "$@"
}

# Synchronize offline DLC manifest metadata without invoking Steam Client.
store_steam_sync() {
    local app_id="${1:-}"
    local game_dir="${2:-}"
    if [ -z "$app_id" ] || [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        echo "[ERROR] Usage: store_steam_sync <appid> <existing_game_dir>" >&2
        return 1
    fi
    fetch_dlc "$game_dir" "$app_id"
}

# --- [MODULE] src/stores/20_store_gog.sh ---
# ==============================================================================
# Optional DRM-Free GOG Store Adapter (gogdl / lgogdownloader)
# ==============================================================================

_gog_resolve_cli() {
    command -v gogdl >/dev/null 2>&1 && { echo "gogdl"; return 0; }
    command -v lgogdownloader >/dev/null 2>&1 && { echo "lgogdownloader"; return 0; }
    return 1
}

_gog_auth_session_present() {
    local xdg_cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
    [ -s "${GAMECTL_GOGDL_AUTH_FILE:-$xdg_cfg/gogdl/auth.json}" ] || [ -s "$xdg_cfg/lgogdownloader/cookies.txt" ]
}

store_gog_available() { _gog_resolve_cli >/dev/null 2>&1; }

store_gog_status() {
    local cli_name="" cli_path="" cli_status="missing (optional: install gogdl or lgogdownloader)"
    cli_name="$(_gog_resolve_cli 2>/dev/null || true)"
    if [ -n "$cli_name" ]; then
        cli_path="$(command -v "$cli_name" 2>/dev/null || echo "$cli_name")"
        cli_status="ready ($cli_name: $cli_path)"
    fi
    local auth_status="unconfigured (run 'gamectl gog auth')"
    _gog_auth_session_present && auth_status="session present (external tool-managed)"
    printf 'store=gog\n  cli      : %s\n  auth     : %s\n' "$cli_status" "$auth_status"
    return 0
}

_gog_parse_catalog_json() {
    jq -r '
        (if type == "array" then . elif (.products | type) == "array" then .products else error("invalid") end) as $items |
        if any($items[]?; ((.id // "") | tostring | test("[\\t\\r\\n]")) or ((.title // .name // "") | tostring | test("[\\t\\r\\n]"))) then
            error("TUI catalog contains TAB, CR or newline")
        else
            $items[] | [
                ((.id // "") | tostring), ((.title // .name // "") | tostring),
                (if (.platforms | type) == "string" then .platforms else
                    ([ (if (.worksOn.Linux // .worksOn.linux // false) then "linux" else empty end),
                       (if (.worksOn.Windows // .worksOn.windows // false) then "windows" else empty end),
                       (if (.worksOn.Mac // .worksOn.mac // false) then "mac" else empty end)
                     ] | join(",") | if length == 0 then "unknown" else . end)
                end)
            ] | @tsv
        end' 2>/dev/null
}

store_gog_search() {
    local query="${1:-}" cli_name="" raw_out="" parsed_rows=""
    [ -n "$query" ] || { echo "[ERROR] Usage: store_gog_search <query>" >&2; return 1; }
    cli_name="$(_gog_resolve_cli 2>/dev/null || true)"
    [ -n "$cli_name" ] || { echo "[ERROR] GOG CLI not installed (optional: install gogdl or lgogdownloader)." >&2; return 1; }

    if [ "$cli_name" = "gogdl" ]; then
        raw_out=$(gogdl search "$query" 2>/dev/null || true)
    else
        raw_out=$(lgogdownloader --list-details --game "$query" 2>/dev/null || true)
    fi

    local trimmed_out="${raw_out#"${raw_out%%[![:space:]]*}"}"
    if [ -n "$trimmed_out" ] && { [[ "$trimmed_out" == "{"* ]] || [[ "$trimmed_out" == "["* ]]; }; then
        parsed_rows=$(printf '%s' "$raw_out" | _gog_parse_catalog_json) || { echo "[ERROR] Invalid GOG search catalog." >&2; return 1; }
    elif [ -n "$raw_out" ] && [[ "$raw_out" == *$'\t'* ]]; then
        parsed_rows="$raw_out"
    elif command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        local enc_q api_raw
        enc_q=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
        api_raw=$(curl -fsS --connect-timeout 5 --max-time 15 "https://embed.gog.com/games/ajax/filtered?mediaType=game&search=${enc_q}" 2>/dev/null || true)
        [ -n "$api_raw" ] && { parsed_rows=$(printf '%s' "$api_raw" | _gog_parse_catalog_json) || { echo "[ERROR] Invalid GOG search catalog." >&2; return 1; }; }
    fi
    [ -n "$parsed_rows" ] || { echo "[ERROR] GOG catalog search failed or returned no results." >&2; return 1; }

    declare -A installed_ids=()
    if declare -F scan_installed_games >/dev/null 2>&1; then
        local ins_id
        while IFS=$'\t' read -r ins_id _; do
            ins_id="${ins_id//[[:space:]]/}"
            [ -n "$ins_id" ] && installed_ids["$ins_id"]=1
        done < <(scan_installed_games --store GOG 2>/dev/null || true)
    fi

    local prod_id title platforms row_status
    while IFS=$'\t' read -r prod_id title platforms; do
        [ -n "$prod_id" ] || continue
        declare -F validate_tui_fields >/dev/null 2>&1 && { validate_tui_fields "$prod_id" "$title" "$platforms" || return 1; }
        row_status="AVAILABLE"
        [ -n "${installed_ids["$prod_id"]:-}" ] && row_status="INSTALLED"
        printf 'GOG\t%s\t%s\t%s\t%s\n' "$prod_id" "$title" "${platforms:-unknown}" "$row_status"
    done <<< "$parsed_rows"
}

store_gog_list_installed() {
    declare -F scan_installed_games >/dev/null 2>&1 || { echo "[ERROR] scan_installed_games is unavailable." >&2; return 1; }
    scan_installed_games --store GOG "$@"
}

store_gog_download() {
    local product_id="${1:-}" cli_name=""
    if [ -z "$product_id" ] || [[ ! "$product_id" =~ ^[0-9A-Za-z_-]+$ ]]; then
        echo "[ERROR] Usage: store_gog_download <product_id> [target_dir] [options...]" >&2
        return 1
    fi
    cli_name="$(_gog_resolve_cli 2>/dev/null || true)"
    [ -n "$cli_name" ] || { echo "[ERROR] GOG CLI not installed (optional: install gogdl or lgogdownloader)." >&2; return 1; }
    local target_dir="${GAMECTL_LIBRARY_DIR:-$HOME/GOG Games}/gog_${product_id}"
    if [ -n "${2:-}" ] && [[ "${2:-}" != -* ]]; then target_dir="$2"; shift 2; else shift; fi
    mkdir -p "$target_dir" || return 1
    if [ "$cli_name" = "gogdl" ]; then
        gogdl download "$product_id" --path "$target_dir" "$@" || return $?
    else
        lgogdownloader --download --game "$product_id" --directory "$target_dir" "$@" || return $?
    fi
    declare -F invalidate_scan_cache >/dev/null 2>&1 && invalidate_scan_cache || true
}

store_gog_sync() {
    local product_id="${1:-}" game_dir="${2:-}"
    if [ -z "$product_id" ] || [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        echo "[ERROR] Usage: store_gog_sync <product_id> <existing_game_dir> [options...]" >&2
        return 1
    fi
    shift 2
    command -v gogdl >/dev/null 2>&1 || { echo "[ERROR] GOG cloud save sync requires gogdl." >&2; return 1; }
    declare -F backup_save >/dev/null 2>&1 && { backup_save "$game_dir" true || return $?; }
    gogdl save-sync "$game_dir" "$product_id" "$@"
}

gog_cli() {
    local action="${1:-status}" cli_name=""
    [ $# -gt 0 ] && shift
    case "$action" in
        status) store_dispatch gog status ;;
        auth)
            cli_name="$(_gog_resolve_cli 2>/dev/null || true)"
            if [ "$cli_name" = "gogdl" ]; then gogdl auth "$@"
            elif [ "$cli_name" = "lgogdownloader" ]; then lgogdownloader --login "$@"
            else echo "[ERROR] GOG auth requires gogdl or lgogdownloader." >&2; return 1; fi ;;
        search) store_dispatch gog search "$@" ;;
        download) store_dispatch gog download "$@" ;;
        sync) store_dispatch gog sync "$@" ;;
        --help|-h|help) echo "Usage: gamectl gog <status|auth|search|download|sync> [args...]" ;;
        *) echo "[ERROR] Unknown gog subcommand '$action'. Usage: gamectl gog <status|auth|search|download|sync> [args...]" >&2; return 1 ;;
    esac
}

# --- [MODULE] src/stores/30_store_epic.sh ---
# ==============================================================================
# Optional Epic Games Store Adapter (legendary)
# ==============================================================================

_epic_config_dir() {
    printf '%s\n' "${LEGENDARY_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/legendary}"
}

_epic_resolve_cli() {
    command -v legendary >/dev/null 2>&1 && { echo "legendary"; return 0; }
    return 1
}

_epic_auth_session_present() {
    [ -s "$(_epic_config_dir)/user.json" ]
}

store_epic_available() { _epic_resolve_cli >/dev/null 2>&1; }

store_epic_status() {
    local cli_path="" cli_status="missing (optional: install legendary)"
    if _epic_resolve_cli >/dev/null 2>&1; then
        cli_path="$(command -v legendary 2>/dev/null || echo "legendary")"
        cli_status="ready (legendary: $cli_path)"
    fi
    local auth_status="unconfigured (run 'gamectl epic auth')"
    _epic_auth_session_present && auth_status="session present (external tool-managed)"
    printf 'store=epic\n  cli      : %s\n  auth     : %s\n' "$cli_status" "$auth_status"
    return 0
}

_epic_parse_catalog_json() {
    local query="${1:-}"
    jq -r --arg q "$query" '
        (if type == "array" then . else error("invalid") end) as $items |
        ($q | ascii_downcase) as $ql |
        $items[] |
        ((.app_name // "") | tostring) as $id |
        ((.app_title // .title // $id) | tostring) as $title |
        (if (.asset_infos | type) == "object" then
            ([(.asset_infos | keys[] | ascii_downcase |
                if . == "windows" then "windows"
                elif . == "linux" then "linux"
                elif . == "mac" or . == "macos" then "mac"
                else empty end)] | unique | join(","))
         elif (.platforms | type) == "string" then .platforms
         else "windows" end | if length == 0 then "windows" else . end) as $plats |
        if ($id | test("[\\t\\r\\n]")) or ($title | test("[\\t\\r\\n]")) or ($plats | test("[\\t\\r\\n]")) then
            error("TUI catalog contains TAB, CR or newline")
        else
            select(($id | ascii_downcase | contains($ql)) or ($title | ascii_downcase | contains($ql))) |
            [$id, $title, $plats] | @tsv
        end' 2>/dev/null
}

store_epic_search() {
    local query="${1:-}" raw_out="" parsed_rows=""
    [ -n "$query" ] || { echo "[ERROR] Usage: store_epic_search <query>" >&2; return 1; }
    _epic_resolve_cli >/dev/null 2>&1 || { echo "[ERROR] Epic CLI not installed (optional: install legendary)." >&2; return 1; }

    raw_out=$(legendary list --json 2>/dev/null) || { echo "[ERROR] Epic catalog query failed (legendary list --json)." >&2; return 1; }
    local trimmed="${raw_out#"${raw_out%%[![:space:]]*}"}"
    if [ -z "$trimmed" ] || [[ "$trimmed" != "["* ]]; then
        echo "[ERROR] Invalid Epic search catalog JSON." >&2
        return 1
    fi
    parsed_rows=$(printf '%s' "$raw_out" | _epic_parse_catalog_json "$query") || {
        echo "[ERROR] Invalid Epic search catalog JSON." >&2
        return 1
    }
    [ -n "$parsed_rows" ] || { echo "[ERROR] Epic catalog search returned no matches for '$query'." >&2; return 1; }

    declare -A installed_ids=()
    if declare -F scan_installed_games >/dev/null 2>&1; then
        local ins_id
        while IFS=$'\t' read -r ins_id _; do
            ins_id="${ins_id//[[:space:]]/}"
            [ -n "$ins_id" ] && installed_ids["$ins_id"]=1
        done < <(scan_installed_games --store EPIC 2>/dev/null || true)
    fi

    local app_name title platforms row_status
    while IFS=$'\t' read -r app_name title platforms; do
        [ -n "$app_name" ] || continue
        declare -F validate_tui_fields >/dev/null 2>&1 && { validate_tui_fields "$app_name" "$title" "$platforms" || return 1; }
        row_status="AVAILABLE"
        [ -n "${installed_ids["$app_name"]:-}" ] && row_status="INSTALLED"
        printf 'EPIC\t%s\t%s\t%s\t%s\n' "$app_name" "$title" "${platforms:-windows}" "$row_status"
    done <<< "$parsed_rows"
}

store_epic_list_installed() {
    declare -F scan_installed_games >/dev/null 2>&1 || { echo "[ERROR] scan_installed_games is unavailable." >&2; return 1; }
    scan_installed_games --store EPIC "$@"
}

store_epic_download() {
    local app_name="${1:-}"
    if [ -z "$app_name" ] || [[ ! "$app_name" =~ ^[0-9A-Za-z._-]+$ ]] || [[ "$app_name" == *".."* ]]; then
        echo "[ERROR] Usage: store_epic_download <app_name> [target_dir] [options...]" >&2
        return 1
    fi
    _epic_resolve_cli >/dev/null 2>&1 || { echo "[ERROR] Epic CLI not installed (optional: install legendary)." >&2; return 1; }
    local target_dir="${GAMECTL_LIBRARY_DIR:-$HOME/Games}/$app_name"
    if [ -n "${2:-}" ] && [[ "${2:-}" != -* ]]; then target_dir="$2"; shift 2; else shift; fi
    mkdir -p "$target_dir" || return 1
    legendary install "$app_name" --game-folder "$target_dir" -y "$@" || return $?
    declare -F invalidate_scan_cache >/dev/null 2>&1 && invalidate_scan_cache || true
}

store_epic_sync() {
    local app_name="${1:-}" game_dir="${2:-}"
    if [ -z "$app_name" ] || [[ ! "$app_name" =~ ^[0-9A-Za-z._-]+$ ]] || [[ "$app_name" == *".."* ]] || [ -z "$game_dir" ] || [ ! -d "$game_dir" ]; then
        echo "[ERROR] Usage: store_epic_sync <app_name> <existing_game_dir> [options...]" >&2
        return 1
    fi
    shift 2
    _epic_resolve_cli >/dev/null 2>&1 || { echo "[ERROR] Epic CLI not installed (optional: install legendary)." >&2; return 1; }
    declare -F backup_save >/dev/null 2>&1 && { backup_save "$game_dir" true || return $?; }
    legendary sync-saves "$app_name" --save-path "$game_dir/saves" "$@"
}

epic_cli() {
    local action="${1:-status}"
    [ $# -gt 0 ] && shift
    case "$action" in
        status) store_dispatch epic status ;;
        auth)
            _epic_resolve_cli >/dev/null 2>&1 || { echo "[ERROR] Epic auth requires legendary." >&2; return 1; }
            legendary auth "$@" ;;
        search) store_dispatch epic search "$@" ;;
        download) store_dispatch epic download "$@" ;;
        sync) store_dispatch epic sync "$@" ;;
        launch)
            _epic_resolve_cli >/dev/null 2>&1 || { echo "[ERROR] Epic launch requires legendary." >&2; return 1; }
            [ -n "${1:-}" ] || { echo "[ERROR] Usage: gamectl epic launch <app_name> [args...]" >&2; return 1; }
            legendary launch "$@" ;;
        --help|-h|help) echo "Usage: gamectl epic <status|auth|search|download|sync|launch> [args...]" ;;
        *) echo "[ERROR] Unknown epic subcommand '$action'. Usage: gamectl epic <status|auth|search|download|sync|launch> [args...]" >&2; return 1 ;;
    esac
}

# --- [MODULE] src/stores/40_store_amazon.sh ---
# ==============================================================================
# Optional Amazon Prime Gaming Store Adapter (nile)
# ==============================================================================

_amazon_config_dir() {
    printf '%s\n' "${NILE_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/nile}"
}

_amazon_resolve_cli() {
    command -v nile >/dev/null 2>&1 && { echo "nile"; return 0; }
    return 1
}

_amazon_auth_session_present() {
    [ -s "$(_amazon_config_dir)/user.json" ]
}

store_amazon_available() { _amazon_resolve_cli >/dev/null 2>&1; }

store_amazon_status() {
    local cli_path="" cli_status="missing (optional: install nile)"
    if _amazon_resolve_cli >/dev/null 2>&1; then
        cli_path="$(command -v nile 2>/dev/null || echo "nile")"
        cli_status="ready (nile: $cli_path)"
    fi
    local auth_status="unconfigured (run 'gamectl amazon auth')"
    _amazon_auth_session_present && auth_status="session present (external tool-managed)"
    printf 'store=amazon\n  cli      : %s\n  auth     : %s\n' "$cli_status" "$auth_status"
    return 0
}

_amazon_parse_catalog_json() {
    local query="${1:-}"
    jq -r --arg q "$query" '
        (if type == "array" then . else error("invalid") end) as $items |
        ($q | ascii_downcase) as $ql |
        $items[] |
        ((.product.id // .id // "") | tostring) as $id |
        ((.product.title // .title // $id) | tostring) as $title |
        (if (.platforms | type) == "string" then .platforms
         elif (.platforms | type) == "array" then ([.platforms[] | tostring | ascii_downcase] | join(","))
         else "windows" end | if length == 0 then "windows" else . end) as $plats |
        if ($id == "") or ($id | test("[\\t\\r\\n]")) or ($title | test("[\\t\\r\\n]")) or ($plats | test("[\\t\\r\\n]")) then
            error("TUI catalog contains TAB, CR or newline")
        else
            select(($id | ascii_downcase | contains($ql)) or ($title | ascii_downcase | contains($ql))) |
            [$id, $title, $plats] | @tsv
        end' 2>/dev/null
}

store_amazon_search() {
    local query="${1:-}" raw_out="" parsed_rows=""
    [ -n "$query" ] || { echo "[ERROR] Usage: store_amazon_search <query>" >&2; return 1; }
    _amazon_resolve_cli >/dev/null 2>&1 || { echo "[ERROR] Amazon CLI not installed (optional: install nile)." >&2; return 1; }

    raw_out=$(nile library list --json 2>/dev/null || nile list-games --json 2>/dev/null || true)
    local trimmed="${raw_out#"${raw_out%%[![:space:]]*}"}"
    if [ -z "$trimmed" ] || [[ "$trimmed" != "["* ]]; then
        echo "[ERROR] Invalid Amazon search catalog JSON." >&2
        return 1
    fi
    parsed_rows=$(printf '%s' "$raw_out" | _amazon_parse_catalog_json "$query") || {
        echo "[ERROR] Invalid Amazon search catalog JSON." >&2
        return 1
    }
    [ -n "$parsed_rows" ] || { echo "[ERROR] Amazon catalog search returned no matches for '$query'." >&2; return 1; }

    declare -A installed_ids=()
    if declare -F scan_installed_games >/dev/null 2>&1; then
        local ins_id
        while IFS=$'\t' read -r ins_id _; do
            ins_id="${ins_id//[[:space:]]/}"
            [ -n "$ins_id" ] && installed_ids["$ins_id"]=1
        done < <(scan_installed_games --store AMAZON 2>/dev/null || true)
    fi

    local app_id title platforms row_status
    while IFS=$'\t' read -r app_id title platforms; do
        [ -n "$app_id" ] || continue
        declare -F validate_tui_fields >/dev/null 2>&1 && { validate_tui_fields "$app_id" "$title" "$platforms" || return 1; }
        row_status="AVAILABLE"
        [ -n "${installed_ids["$app_id"]:-}" ] && row_status="INSTALLED"
        printf 'AMAZON\t%s\t%s\t%s\t%s\n' "$app_id" "$title" "${platforms:-windows}" "$row_status"
    done <<< "$parsed_rows"
}

